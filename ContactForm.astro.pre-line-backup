---
/**
 * The contact body: a heading, the direct lines, and a set of questions a
 * visitor answers by tapping. The answers compose the email — nobody has to
 * work out how to open a message to a stranger.
 *
 * Question numbering is derived from position, so the short and long sets
 * both read 01, 02, 03 without anything being renumbered by hand.
 */
import { EMAIL, PHONE, CALL_URL, CALL_LABEL, WHATSAPP, FIELDS, ELSEWHERE, asked, type Question } from '../data/contact';
import { total } from '../data/composition';

interface Props {
  questions?: Question[];
  /** Preview only: show the call line before a real link exists. */
  callUrl?: string;
}
const { questions = asked(), callUrl = CALL_URL } = Astro.props;

const year = new Date().getFullYear();
const link = (label: string) => ELSEWHERE.find((e) => e.label === label)!.href;

const lines = questions.map((q) => [q.key, q.line]);
---

<div class="ct__page">
  <header class="ct__head">
    <div class="ct__top">
      <h1 class="ct__statement display">Let’s talk.</h1>

      <p class="ct__lede">Tap the answers. The message writes itself.</p>

      <ul class="ct__direct">
        <li>
          <span class="mono mono--dim">Email</span>
          <a href={`mailto:${EMAIL}?subject=${encodeURIComponent('Project enquiry')}`}>{EMAIL}</a>
        </li>
        <li>
          <span class="mono mono--dim">Phone</span>
          <a href={PHONE.href}>{PHONE.value}</a>
        </li>
        {
          callUrl && (
            <li>
              <span class="mono mono--dim">Rather talk</span>
              <a href={callUrl} target="_blank" rel="noopener">{CALL_LABEL}</a>
            </li>
          )
        }
      </ul>
    </header>

    <form class="ct__form" id="form">
      <h2 class="mono ct__grouphead">Project details</h2>

      {
        questions.map((qu, i) => (
          <fieldset class="q">
            <legend class="q__legend">
              <span class="mono q__n">{String(i + 1).padStart(2, '0')}</span>
              <span class="q__q">{qu.q}</span>
              {qu.hint && <span class="mono q__hint">{qu.hint}</span>}
            </legend>
            <div class="q__opts">
              {qu.options.map((o) => (
                <label class="opt">
                  <input type={qu.multi ? 'checkbox' : 'radio'} name={qu.key} value={o} />
                  <span>{o}</span>
                </label>
              ))}
            </div>
          </fieldset>
        ))
      }

      <h2 class="mono ct__grouphead ct__grouphead--2">Your details</h2>

      {/* The option chips' shape carried into the details: same 999px pill,
          same border, same accent once answered — so everything the visitor has
          given reads as one kind of thing whether they tapped it or typed it.
          The prompt lives inside, and the field grows to fit what is typed.

          Nothing says "optional". The three that can be skipped are simply
          quieter — faded to 38%, far enough that the row reads as two things
          that matter and three that are there if you want them. Their prompts
          are set in full bone rather than bone-dim to buy back some of what the
          fade takes, and hovering, focusing or filling one clears the fade
          entirely, so nobody ever reads a pill they are trying to use at 38%.
          Assistive tech is told properly regardless: the two that matter carry
          the `required` attribute. */}
      <div class="pills">
        {
          FIELDS.filter((f) => f.required).map((f) => (
            <span class="pill">
              <label class="visually-hidden" for={f.key}>{f.label}</label>
              <input
                class="pill__in"
                id={f.key}
                name={f.key}
                type={f.type}
                required
                placeholder={f.placeholder}
                autocomplete={f.autocomplete ?? 'off'}
                data-grow
              />
            </span>
          ))
        }


        {
          FIELDS.filter((f) => !f.required).map((f) => (
            <span class="pill pill--opt">
              <label class="visually-hidden" for={f.key}>{f.label}</label>
              <input
                class="pill__in"
                id={f.key}
                name={f.key}
                type={f.type}
                placeholder={f.placeholder}
                autocomplete={f.autocomplete ?? 'off'}
                data-grow
              />
            </span>
          ))
        }

        <span class="pill pill--opt pill--area">
          <label class="visually-hidden" for="more">Notes</label>
          <textarea
            class="pill__in"
            id="more"
            name="more"
            rows="2"
            placeholder="Anything the answers above didn’t cover"></textarea>
        </span>
      </div>

      {/* One hairline over the pair rather than a band around it — the same move
          the section headings make, so this reads as the last section of the page
          and not as a control panel. No underline anywhere. */}
      <div class="send" data-send>
        <div class="send__band">
          <a class="send__act" id="send" href={`mailto:${EMAIL}`} aria-disabled="true">
            Send this enquiry <span class="send__arrow" aria-hidden="true">→</span>
          </a>
          <p class="mono send__note" id="note"></p>
        </div>

        <details class="peek">
          <summary class="mono">See your message</summary>
          <pre class="peek__body" id="peek"></pre>
        </details>
      </div>
    </form>

    {/* The footer reads as writing, not as a directory — three sentences
        carrying every link. The Next above it is the mono eyebrow and the
        display title, at a larger size than the send action so the two are told
        apart by scale rather than by treatment. */}
    {/* Two columns, so the right half is not left empty beside the
        sentences: the writing on the left, the way out and the address
        stacked on the right. */}
</div>

  <footer class="ft">
    <hr class="ft__rule" />

    <p class="ft__prose">
      Listen on <a href={link('Spotify')} target="_blank" rel="noopener">Spotify</a> or
      <a href={link('Apple Music')} target="_blank" rel="noopener">Apple Music</a>.
      Follow on <a href={link('Instagram')} target="_blank" rel="noopener">Instagram</a> or
      <a href={link('Behance')} target="_blank" rel="noopener">Behance</a>.<br />
      Connect via <a href={`mailto:${EMAIL}?subject=${encodeURIComponent('Project enquiry')}`}>email</a>,
      <a href={WHATSAPP} target="_blank" rel="noopener">WhatsApp</a> or
      <a href={PHONE.href}>phone</a>.
    </p>

    {/* The standing line and the way out share a row, aligned on their
        bottom edge so the sentence and "The work" sit on one line. */}
    <div class="ft__band">
      <p class="ft__prose ft__prose--quiet">
        Based in Mumbai, working across time zones. <a class="ft__count" href="/">{total} works</a>.
      </p>

      <a class="ft__next" href="/">
        <span class="mono ft__nextlbl">Next page</span>
        <span class="ft__nexttitle display">The work <span class="ft__arrow" aria-hidden="true">→</span></span>
      </a>
    </div>

    <div class="ft__row">
      <span class="mono mono--dim">© {year} Ugam Khetani</span>
      <a class="mono ft__mail" href={`mailto:${EMAIL}`}>{EMAIL}</a>
    </div>
  </footer>

<script define:vars={{ EMAIL, lines }}>
  function initContact() {
  const form = document.getElementById('form');
  if (!form || form.dataset.bound) return;
  form.dataset.bound = '1';
  const send = document.getElementById('send');
  const peek = document.getElementById('peek');
  const note = document.getElementById('note');

  /* The note is written one character at a time so a wave can travel through
     it. The sentence is also written once, visually hidden, and the
     characters are hidden from assistive tech — otherwise a screen reader
     reads twenty-three letters instead of four words. The per-character
     delay rides on --i, so the length of the sentence costs no CSS. */
  /* Astro scopes component CSS by stamping a data-astro-cid-* attribute on
     every element in the template, and compiling `.send__ink` to
     `.send__ink[data-astro-cid-…]`. Elements built here are not in the
     template, so they never get stamped and the scoped rules would never
     match them. Copying the attribute off the note itself fixes that and
     keeps the stylesheet ordinary — no :global, no inline styles. */
  const scope = Array.from(note.attributes).map((a) => a.name)
    .find((n) => n.startsWith('data-astro-cid-'));
  const stamp = (el) => { if (scope) el.setAttribute(scope, ''); return el; };

  function setNote(text) {
    note.textContent = '';
    const said = stamp(document.createElement('span'));
    said.className = 'visually-hidden';
    said.textContent = text;
    const ink = stamp(document.createElement('span'));
    ink.className = 'send__ink';
    ink.setAttribute('aria-hidden', 'true');
    for (let i = 0; i < text.length; i++) {
      const ch = stamp(document.createElement('i'));
      ch.style.setProperty('--i', String(i));
      ch.textContent = text[i];
      ink.appendChild(ch);
    }
    note.append(said, ink);
  }

  function compose() {
    const d = new FormData(form);
    const get = (k) => (d.get(k) || '').trim();
    const name = get('name'), email = get('email'), phone = get('phone');
    const title = get('title'), link = get('link'), more = get('more');

    const body = ['Hi Ugam,', ''];
    const answered = [];
    for (const [key, label] of lines) {
      const vals = d.getAll(key).filter(Boolean);
      if (vals.length) answered.push(`${label}: ${vals.join(', ')}`);
    }
    body.push(answered.length ? answered.join('\n') : 'I would like to talk about a project.');
    if (title) body.push('', `Title: ${title}`);
    if (link) body.push(title ? `Link: ${link}` : '', title ? '' : `Link: ${link}`);
    if (more) body.push('', more);
    body.push('', '—', name || 'Your name', email || 'your@email');
    if (phone) body.push(phone);

    const subject = title ? `Project enquiry — ${title}` : 'Project enquiry';
    return { subject, text: body.filter((l, i, a) => !(l === '' && a[i - 1] === '')).join('\n'), ready: !!(name && email) };
  }

  function render() {
    const { subject, text, ready } = compose();
    peek.textContent = `To: ${EMAIL}\nSubject: ${subject}\n\n${text}`;
    send.href = `mailto:${EMAIL}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(text)}`;
    send.classList.toggle('is-ready', ready);
    send.setAttribute('aria-disabled', String(!ready));
    if (ready) shell.classList.remove('is-asking');
    setNote(ready
      ? 'Opens as a draft. Send it when you’re ready.'
      : 'Name and email required');
  }

  // Declared before render() runs — render() clears the refused state, so the
  // binding has to exist by its first call.
  const shell = form.querySelector('[data-send]');

  form.addEventListener('input', render);
  form.addEventListener('change', render);
  render();

  // Refusal: pointing at the action before it can be used steps it back and
  // makes it answer. Bound to focus as well as hover so a keyboard reaches it.
  const asking = (on) => {
    const want = on && !send.classList.contains('is-ready');
    // Removed and re-added rather than toggled, so the wave restarts on a
    // second visit instead of firing once and never again.
    shell.classList.remove('is-asking');
    if (want) { void shell.offsetWidth; shell.classList.add('is-asking'); }
  };
  send.addEventListener('pointerenter', () => asking(true));
  send.addEventListener('pointerleave', () => asking(false));
  send.addEventListener('focus', () => asking(true));
  send.addEventListener('blur', () => asking(false));
  send.addEventListener('click', (e) => {
    if (send.classList.contains('is-ready')) return;
    e.preventDefault();
    asking(true);
  });

  // An answered field is styled exactly like a selected option. Driven by a
  // class rather than :has(:not(:placeholder-shown)) alone: that selector
  // matches correctly, but browsers do not reliably recompute the ANCESTOR's
  // style when a descendant's placeholder state flips — it was verified
  // failing. The :has() rule stays for first paint and for no-JS; this
  // guarantees every change after.
  form.querySelectorAll('.pill__in').forEach((el) => {
    const shell = el.closest('.pill');
    const sync = () => shell.classList.toggle('is-filled', el.value.trim() !== '');
    el.addEventListener('input', sync);
    sync();
  });

  // Each pill sizes to its own content, the way an option chip is sized to
  // its words. Measured against a hidden span carrying the same type, and
  // capped so one long URL cannot push a pill out of the row.
  form.querySelectorAll('input[data-grow]').forEach((inp) => {
    const mirror = document.createElement('span');
    inp.after(mirror);
    // Styled here rather than in the stylesheet on purpose: this element is
    // created at runtime, so it never receives Astro's scoping attribute and
    // a scoped .pill__mirror rule would silently miss it — which is exactly
    // how it once rendered visible, repeating every prompt on screen.
    Object.assign(mirror.style, {
      position: 'absolute', left: '0', top: '0',
      visibility: 'hidden', whiteSpace: 'pre', pointerEvents: 'none',
    });
    mirror.setAttribute('aria-hidden', 'true');
    const cs = getComputedStyle(inp);
    for (const k of ['fontFamily', 'fontSize', 'fontWeight', 'letterSpacing']) mirror.style[k] = cs[k];
    const sync = () => {
      mirror.textContent = inp.value || inp.placeholder || '';
      inp.style.width = Math.min(Math.max(mirror.getBoundingClientRect().width + 6, 48), 360) + 'px';
    };
    inp.addEventListener('input', sync);
    requestAnimationFrame(sync);
    sync();
  });
  }

  initContact();
  // The site navigates client-side, so this has to run again after a swap.
  document.addEventListener('astro:page-load', initContact);
</script>

<style>
  /* Two columns: the masthead holds the left and stays there, so a visitor
     three questions deep can still see who they are writing to and that two
     direct lines exist. The form runs down the right. The footer spans both,
     because it belongs to the page rather than to either half. */
  /* Equal halves and a 3.4em gutter, matching the reference exactly. */
  .ct__page {
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: 3.4em;
  }
  /* The reference's real trick, and the reason its left half reads as
     composed rather than as a short block adrift: the column is 80vh tall
     and its contents are pushed apart, so the heading sits at the top and
     the two lines are anchored at the foot. */
  .ct__head {
    grid-column: 1;
    position: sticky;
    /* Clears the fixed running head, which is the one thing that would
       otherwise overlap it. */
    top: calc(var(--head-h) + clamp(24px, 4vh, 48px));
    align-self: start;
    min-height: 80vh;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: space-between;
  }
  .ct__form { grid-column: 2; min-width: 0; }
  /* The footer is deliberately OUTSIDE .ct__page. A sticky item is bounded by
     its container, not by its grid row — with the footer inside the grid the
     masthead could slide the whole height of the page and sit invisibly on
     top of it, swallowing clicks and text selection. */
  .ft { position: relative; z-index: 1; }

  .ct__statement {
    font-family: var(--display); font-weight: 500;
    /* A shade above --t-2xl (2.5–5.5rem). Local rather than a token change,
       so work-page titles keep the size they were designed at. */
    font-size: clamp(2.75rem, 7.6vw, 6rem); letter-spacing: var(--track-tight);
    line-height: 1;
    /* 8px. The sentence is a standfirst to the heading, not a paragraph
       after it — close enough to be read as one unit, far enough that two
       lines of type do not crowd. */
    margin: 0 0 var(--s-1);
  }
  .ct__lede { color: var(--bone-dim); max-width: 48ch; margin: 0; font-size: var(--t-md); }

  /* One line, pushed to the right margin: label and value side by side on a
     shared baseline rather than stacked, so the whole block is one row deep
     instead of four and reads as a strip rather than a list. */
  /* Still one line where the column allows it — label and value side by
     side — but left-aligned to the masthead now, and free to wrap onto two
     lines when the left column is too narrow to hold both pairs. */
  .ct__direct {
    list-style: none; padding: 0; margin: 0;
    display: flex; flex-wrap: wrap; gap: var(--s-3) var(--s-5);
  }
  .ct__direct li { display: flex; align-items: baseline; gap: 10px; }
  .ct__direct .mono { font-size: var(--t-xs); }
  /* No border. The underline came off the send block; it comes off here too. */
  .ct__direct a {
    font-family: var(--display); font-size: 1.25rem; font-weight: 500;
    letter-spacing: -0.02em; color: var(--bone); text-decoration: none;
    transition: color var(--d-micro) var(--ease);
  }
  .ct__direct a:hover { color: var(--accent); }

  .ct__grouphead {
    margin: clamp(64px, 11vh, 120px) 0 var(--s-4);
    padding-bottom: 12px; border-bottom: 1px solid var(--rule);
    color: var(--muted); font-size: var(--t-xs);
  }
  .ct__grouphead--2 { margin-top: clamp(56px, 9vh, 96px); }

  .q { border: 0; padding: 0; margin: 0 0 var(--s-5); }
  .q__legend { display: flex; align-items: baseline; flex-wrap: wrap; gap: var(--s-2); margin-bottom: 14px; padding: 0; }
  .q__n { color: var(--dim); font-size: var(--t-xs); }
  /* 20px. There is no token between --t-md (18) and --t-lg (22–30), and
     --t-lg turns a question into a headline. */
  .q__q { font-family: var(--display); font-weight: 500; font-size: 1.25rem; letter-spacing: -0.02em; }
  .q__hint { color: var(--dim); font-size: var(--t-xs); }

  .q__opts { display: flex; flex-wrap: wrap; gap: 8px; }
  .opt { cursor: pointer; }
  .opt input { position: absolute; opacity: 0; width: 0; height: 0; }
  .opt span {
    display: inline-block; padding: 10px 17px;
    border: 1px solid var(--rule); border-radius: 999px;
    font-size: var(--t-base); color: var(--bone-dim);
    transition: color var(--d-micro) var(--ease), border-color var(--d-micro) var(--ease),
                background-color var(--d-micro) var(--ease);
  }
  /* The ring reaches full accent; the words stay white. Previously the ring
     was a 40% accent used nowhere else on the site, which barely separated
     from the resting hairline — this is the same one pixel at full strength,
     so it is unmistakably orange without the chip gaining any weight or the
     label changing colour. Chosen still adds accent words and the wash. */
  .opt:hover span { border-color: var(--accent); color: var(--bone); }
  .opt input:checked + span { color: var(--accent); border-color: var(--accent); background: var(--accent-glow); }
  .opt input:focus-visible + span { outline: 1px solid var(--accent); outline-offset: 3px; }

  /* Identical geometry to .opt span above — 999px, 9px 15px, same border —
     so the details and the answers are visibly the same system. */
  .pills { display: flex; flex-wrap: wrap; gap: 8px; }
  .pill {
    display: inline-flex;
    align-items: center;
    /* Anchors the measuring span the script inserts, so it cannot stretch
       the page from some distant positioned ancestor. */
    position: relative;
    padding: 10px 17px;
    border: 1px solid var(--rule);
    border-radius: 999px;
    transition: border-color var(--d-micro) var(--ease),
                background-color var(--d-micro) var(--ease),
                opacity var(--d-micro) var(--ease);
  }

  /* The fade sits on .pill--opt itself, one class deep, so every state rule
     below outranks it. Declared the other way round — a descendant selector
     per group — it beat them all and left an answered field looking
     switched off. */
  .pill--opt { --fade: 0.38; opacity: var(--fade); }
  /* The prompt starts brighter than the others so the composite lands where
     a readable prompt lands; without this the words fade with the box. */
  .pill--opt .pill__in::placeholder { color: var(--bone); }

  .pill:hover { opacity: 1; border-color: var(--rule-accent); }
  .pill:focus-within { opacity: 1; border-color: var(--accent); }
  /* Answered reads exactly as selected does — and at full strength, whether
     it had to be filled in or not. Both rules, deliberately: see the note in
     the script. */
  .pill:has(.pill__in:not(:placeholder-shown)),
  .pill.is-filled { opacity: 1; border-color: var(--accent); background: var(--accent-glow); }

  .pill__in {
    background: none; border: 0; padding: 0;
    color: var(--bone);
    font-family: var(--body); font-size: var(--t-base); line-height: 1.4;
    min-width: 48px; resize: none;
  }
  .pill__in:focus { outline: none; }
  .pill__in::placeholder { color: var(--bone-dim); }
  .pill__in:not(:placeholder-shown) { color: var(--accent); }

  .pill--area {
    display: flex; width: 100%;
    border-radius: 22px; padding: 12px 18px; align-items: stretch;
  }
  .pill--area .pill__in { width: 100%; resize: vertical; line-height: 1.7; }

  /* ── The send action ──────────────────────────────────────────── */
  .send { margin-top: clamp(48px, 8vh, 88px); }
  .send__band {
    display: flex; align-items: baseline; gap: var(--s-5);
    border-top: 1px solid var(--rule); padding-top: 26px;
  }
  .send__act {
    font-family: var(--display); font-weight: 500; font-size: var(--t-xl);
    letter-spacing: -0.035em; line-height: 1;
    /* Bone at rest whether or not the form is complete. The action only goes
       quiet when it is pointed at and cannot be used — see .is-asking. */
    color: var(--bone);
    text-decoration: none; white-space: nowrap;
    display: inline-flex; align-items: baseline; gap: 0.3em;
    /* Deliberately NOT pointer-events: none. A control that cannot be
       pointed at cannot explain itself, and it disappears from assistive
       tech entirely. It stays reachable, says why, and swallows the click. */
    cursor: not-allowed;
    transition: color var(--d-micro) var(--ease), transform var(--d-micro) var(--ease);
  }
  .send__act.is-ready { cursor: pointer; }
  .send__act.is-ready:hover { color: var(--accent); }
  .send__arrow { display: inline-block; transition: transform var(--d-micro) var(--ease); }
  .send__act.is-ready:hover .send__arrow { transform: translateX(0.28em); }

  /* Refused: the action steps back and goes quiet, and the note it was
     already showing lights up. Same words either way — only the colour
     answers, which is why there is one span here and not two. */
  .send.is-asking .send__act { transform: translateX(-4px); color: var(--dim); }

  /* The handover: the action gives up its white immediately, the note takes
     it 90ms later, so the brightness reads as moving from one to the other
     rather than as two things changing at once. */
  .send__ink {
    display: inline-block; white-space: pre;
    /* Grows toward the action, not away from it. */
    transform-origin: right center;
    transition: color var(--d-micro) var(--ease) 90ms,
                transform var(--d-micro) var(--ease) 90ms;
  }
  .send__ink i { display: inline-block; font-style: normal; }
  .send.is-asking .send__ink { color: var(--bone); transform: scale(1.08); }

  /* And a wave through the letters. Mono holds a fixed advance width, so the
     stroke thickens inside a box that never changes size — the line gains
     motion without gaining movement. */
  @keyframes send-swell { 0%, 100% { font-weight: 400 } 45% { font-weight: 700 } }
  .send.is-asking .send__ink i {
    animation: send-swell 520ms var(--ease) both;
    animation-delay: calc(var(--i) * 25ms);
  }

  .send__note {
    margin: 0 0 0 auto; text-align: right;
    color: var(--dim); font-size: var(--t-xs); line-height: 1.8; max-width: 30ch;
    transition: color var(--d-micro) var(--ease);
  }

  /* Still a <details>, so it works with no JavaScript at all. The marker is
     replaced rather than removed — list-style covers Firefox, the -webkit
     pseudo covers Safari. */
  .peek { margin-top: var(--s-4); }
  .peek summary {
    display: inline-flex; align-items: baseline; gap: 8px;
    list-style: none; cursor: pointer;
    color: var(--dim); font-size: var(--t-xs);
    transition: color var(--d-micro) var(--ease);
  }
  .peek summary::-webkit-details-marker { display: none; }
  .peek summary::before { content: '+'; color: var(--accent); font-size: 12px; line-height: 1; }
  .peek[open] summary::before { content: '–'; }
  .peek summary:hover, .peek[open] summary { color: var(--bone); }
  .peek__body {
    margin: var(--s-3) 0 0; padding: var(--s-3);
