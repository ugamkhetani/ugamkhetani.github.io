---
import { Image } from 'astro:assets';
import { framesFor, sizesFor } from '../lib/frames';
import { RATIO, numberFor } from '../data/composition';

interface Props {
  slug: string;
  title: string;
  year: number;
  category: string;
  ratio: string;
  frames: string[];
  alt: string;
  span: number;
  eager?: boolean;
}

const { slug, title, year, category, ratio, frames, alt, span, eager = false } = Astro.props;

const number = numberFor(slug);
const images = framesFor(slug, frames);
const count = images.length;
const sizes = sizesFor(span);
---

<a
  class="frame"
  class:list={[{ 'frame--single': count === 1 }]}
  href={`/work/${slug}`}
  data-frame
  data-count={count}
  style={`--ar:${RATIO[ratio]}`}
  aria-label={`${title}, ${year}, ${category}`}
>
  <span class="frame__window">
    {
      images.map((img, i) => (
        <span class="frame__layer" data-layer={i}>
          <Image
            src={img}
            alt={i === 0 ? alt : ''}
            widths={[480, 800, 1200, 1800]}
            sizes={sizes}
            loading={eager && i === 0 ? 'eager' : 'lazy'}
            decoding="async"
            aria-hidden={i === 0 ? undefined : 'true'}
          />
        </span>
      ))
    }
  </span>

  {
    count > 1 && (
      <span class="frame__scrub" aria-hidden="true">
        {images.map((_, i) => (
          <span class="frame__seg" data-seg={i} />
        ))}
      </span>
    )
  }

  <span class="frame__meta">
    <span class="mono frame__no">{number}</span>
    <h2 class="frame__title">{title}</h2>
    <span class="mono frame__year">{year}</span>
  </span>
</a>

<style>
  .frame {
    display: block;
    position: relative;
    color: var(--bone);
    -webkit-tap-highlight-color: transparent;
  }

  /* ── The window. Aspect ratio is the work's real format. ───────── */
  .frame__window {
    display: block;
    position: relative;
    aspect-ratio: var(--ar);
    overflow: hidden;
    background: var(--ground-lift);
    isolation: isolate;
  }

  .frame__layer {
    position: absolute;
    inset: 0;
    /* Every layer above the base starts wiped away. */
    clip-path: inset(100% 0 0 0);
    will-change: clip-path;
    transition: clip-path 180ms var(--ease);
  }
  .frame__layer[data-layer='0'] {
    clip-path: inset(0 0 0 0);
    transition: none;
  }
  .frame__layer.is-cut {
    clip-path: inset(0 0 0 0);
  }

  .frame__layer :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.94) contrast(1.02);
    transition: filter var(--d-micro) var(--ease), transform var(--d-reveal) var(--ease);
    transform: scale(1.001); /* kills sub-pixel edge seams during the wipe */
  }

  .frame:hover .frame__layer :global(img),
  .frame:focus-visible .frame__layer :global(img),
  .frame.is-active .frame__layer :global(img) {
    filter: saturate(1) contrast(1.06) brightness(1.04);
  }

  /* A single still doesn't switch. It breathes instead. */
  .frame--single:hover .frame__layer :global(img),
  .frame--single:focus-visible .frame__layer :global(img),
  .frame--single.is-active .frame__layer :global(img) {
    transform: scale(1.04);
  }

  /* ── The scrub rule. Segments = how much material exists. ───────── */
  .frame__scrub {
    display: flex;
    gap: 3px;
    margin-top: 10px;
    opacity: 0;
    transition: opacity var(--d-micro) var(--ease);
  }
  .frame:hover .frame__scrub,
  .frame:focus-visible .frame__scrub,
  .frame.is-active .frame__scrub {
    opacity: 1;
  }
  .frame__seg {
    flex: 1;
    height: 1px;
    background: var(--rule);
    transition: background var(--d-micro) var(--ease);
  }
  /* Passed segments dim, the current one lit — position and progress,
     without the rule ever becoming a solid orange bar. */
  .frame__seg.is-lit { background: rgba(232, 93, 44, 0.32); }
  .frame__seg.is-now { background: var(--accent); }

  /* ── Metadata. Number and year hold; the title arrives. ─────────── */
  .frame__meta {
    display: flex;
    align-items: baseline;
    gap: var(--s-2);
    margin-top: 12px;
  }
  .frame__no { color: var(--dim); font-variant-numeric: tabular-nums; }
  .frame__year {
    color: var(--dim);
    margin-left: auto;
    font-variant-numeric: tabular-nums;
  }
  .frame__title {
    margin: 0;
    font-family: var(--display);
    font-weight: 500;
    font-size: var(--t-md);
    letter-spacing: -0.02em;
    line-height: 1.1;
    opacity: 0;
    transform: translateY(4px);
    transition:
      opacity var(--d-micro) var(--ease),
      transform var(--d-micro) var(--ease);
  }
  .frame:hover .frame__title,
  .frame:focus-visible .frame__title,
  .frame.is-active .frame__title {
    opacity: 1;
    transform: none;
  }

  .frame:focus-visible {
    outline: none;
  }
  .frame:focus-visible .frame__window {
    outline: 1px solid var(--accent);
    outline-offset: -1px;
  }

  /* ── Touch and small screens: the title never hides. ────────────── */
  @media (hover: none), (max-width: 640px) {
    .frame__title { opacity: 1; transform: none; }
    .frame__scrub { opacity: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .frame__title { opacity: 1; transform: none; }
    .frame__scrub { opacity: 1; }
    .frame__layer { transition: none; }
    .frame--single:hover .frame__layer :global(img) { transform: none; }
  }
</style>
