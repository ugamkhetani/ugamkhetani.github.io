---
/**
 * PREVIEW ONLY — part of the one-page drafts under src/pages/preview/.
 *
 * The top menu and the story rail.
 *
 * The menu keeps RunHead's voice exactly — display face, weight 500, -0.02em,
 * mix-blend-mode: difference, and the letter roll on hover — because on a
 * single page the menu is the only piece of furniture that persists, and it
 * has to read as the same site. What changes is what it points at: four
 * anchors on one page instead of four addresses.
 *
 * THERE IS NO SEPARATE PROGRESS RAIL. An earlier version of this drew its own
 * marks down the left margin; /about already has `.gauge` in exactly that
 * position doing exactly that job, so the invented one was removed rather
 * than sat beside it. The Register page's own furniture is the furniture.
 *
 * MARKED BY POSITION, NOT BY OBSERVER. IntersectionObserver reports crossings,
 * not "which section am I in", and with a pinned section several screens tall
 * it fires once and then says nothing for the next four thousand pixels. The
 * rail reads scroll position against each section's own box every frame
 * instead, so it is right at every point rather than only at the edges.
 */
interface Props {
  /** Which works theme this draft is showing — named in the rail's foot. */
  theme: string;
}
const { theme } = Astro.props;

const SECTIONS = [
  { id: 'about', n: '01', label: 'About' },
  { id: 'works', n: '02', label: 'Works' },
  { id: 'philosophy', n: '03', label: 'Philosophy' },
  { id: 'contact', n: '04', label: 'Contact' },
];
---

<header class="opnav" data-opnav>
  <nav class="opnav__nav" aria-label="Sections">
    {
      SECTIONS.map((s) => {
        const chars = `(${s.label})`.split('');
        return (
          <a class="itm" href={`#${s.id}`} data-jump={s.id} aria-label={s.label}>
            <span class="roll" aria-hidden="true">
              {chars.map((c) => (<i data-l={c}>{c}</i>))}
            </span>
          </a>
        );
      })
    }
  </nav>
</header>


<style>
  /* ── the menu: RunHead's voice, pointing at anchors ─────────── */
  .opnav {
    position: fixed; inset: 0 0 auto 0; z-index: 140;
    padding: 20px var(--margin);
    mix-blend-mode: difference;
    isolation: isolate;
    pointer-events: none;
  }
  .opnav__nav { display: flex; justify-content: space-between; align-items: baseline; gap: var(--s-2); }
  .opnav__nav > * { pointer-events: auto; }

  .itm {
    font-family: var(--display); font-weight: 500;
    font-size: clamp(11px, 1.1vw, 14px);
    letter-spacing: -0.02em; line-height: 1.1;
    color: #fff; text-decoration: none;
    white-space: nowrap; cursor: pointer;
    transition: opacity var(--d-micro) var(--ease);
  }
  .itm:not(.is-current) { opacity: 0.5; }
  @media (hover: hover) {
    .opnav__nav:has(.itm:hover) .itm { opacity: 0.5; }
    .opnav__nav:has(.itm:hover) .itm:hover { opacity: 1; }
  }
  .itm:focus-visible { outline: 1px solid var(--accent); outline-offset: 4px; }

  .roll { display: inline-block; overflow: hidden; height: 1.15em; line-height: 1.15em; vertical-align: bottom; }
  .roll i { display: inline-block; position: relative; font-style: normal; transition: transform 0.55s var(--ease); }
  .roll i::before { content: attr(data-l); position: absolute; top: 100%; left: 0; }
  .itm:hover .roll i, .itm:focus-visible .roll i { transform: translateY(-100%); }
  .roll i:nth-child(1) { transition-delay: 0s }
  .roll i:nth-child(2) { transition-delay: 0.015s }
  .roll i:nth-child(3) { transition-delay: 0.03s }
  .roll i:nth-child(4) { transition-delay: 0.045s }
  .roll i:nth-child(5) { transition-delay: 0.06s }
  .roll i:nth-child(6) { transition-delay: 0.075s }
  .roll i:nth-child(7) { transition-delay: 0.09s }
  .roll i:nth-child(8) { transition-delay: 0.105s }
  .roll i:nth-child(9) { transition-delay: 0.12s }
  .roll i:nth-child(10) { transition-delay: 0.135s }
  .roll i:nth-child(11) { transition-delay: 0.15s }
  .roll i:nth-child(12) { transition-delay: 0.165s }

</style>

<script>
  function initOpNav() {
    const nav = document.querySelector('[data-opnav]') as HTMLElement | null;
    if (!nav || nav.dataset.bound) return;
    nav.dataset.bound = '1';

    const items = Array.from(nav.querySelectorAll('[data-jump]')) as HTMLElement[];
    const ids = items.map((a) => a.dataset.jump!);
    const sections = ids.map((id) => document.getElementById(id));

    /* Anchors are handled by hand rather than left to the browser. The site
       runs Lenis, and a native hash jump lands instantly while Lenis is still
       easing, so the page arrives twice. One smooth scroll, one arrival. */
    items.forEach((a) => {
      a.addEventListener('click', (e) => {
        const el = document.getElementById(a.dataset.jump!);
        if (!el) return;
        e.preventDefault();
        el.scrollIntoView({ behavior: 'smooth', block: 'start' });
        history.replaceState(null, '', `#${a.dataset.jump}`);
      });
    });

    let raf = 0;
    let last = -1;
    const paint = () => {
      raf = 0;
      const y = scrollY + innerHeight * 0.35;

      /* Which section the reading line is inside — measured against each
         section's own box. An IntersectionObserver reports crossings, and a
         pinned works section several screens tall would fire once and then
         say nothing for thousands of pixels. */
      let now = 0;
      for (let i = 0; i < sections.length; i++) {
        const s = sections[i];
        if (!s) continue;
        const top = s.offsetTop;
        if (y >= top) now = i;
      }

      if (now === last) return;
      last = now;
      items.forEach((a, i) => a.classList.toggle('is-current', i === now));
    };

    addEventListener('scroll', () => { if (!raf) raf = requestAnimationFrame(paint); }, { passive: true });
    addEventListener('resize', () => { if (!raf) raf = requestAnimationFrame(paint); }, { passive: true });
    if (document.fonts && document.fonts.ready) document.fonts.ready.then(paint);
    paint();
  }

  initOpNav();
  document.addEventListener('astro:page-load', initOpNav);
</script>
