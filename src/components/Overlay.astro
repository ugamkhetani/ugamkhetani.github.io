---
interface Props {
  id: string;
  label: string;
}
const { id, label } = Astro.props;
---

<!-- tabindex is load-bearing, not decoration: with the head bar gone there
     is no button to hand focus to on open, and the Escape handler is bound
     to this element — so it must be able to hold focus itself or the
     overlay becomes uncloseable by keyboard. -->
<div
  class="overlay"
  data-overlay
  data-lenis-prevent
  id={id}
  role="dialog"
  aria-modal="true"
  aria-label={label}
  tabindex="-1"
  hidden
>
  <div class="overlay__body shell">
    <slot />
  </div>
</div>

<style>
  /* `display` must respect the hidden attribute — a fixed, inset-0 layer
     at opacity 0 is invisible but still swallows every click on the page. */
  .overlay { display: none; }

  .overlay:not([hidden]) {
    position: fixed;
    inset: 0;
    z-index: 120;
    background: var(--ground);
    display: flex;
    flex-direction: column;
    overflow-y: auto;
    overscroll-behavior: contain;
    opacity: 0;
    transition: opacity var(--d-micro) var(--ease);
  }
  .overlay.is-open { opacity: 1; }

  .overlay:focus-visible { outline: none; }

  .overlay__body {
    flex: 1;
    /* The head bar used to clear the fixed nav; this now carries that job
       and the opening interval together. Same value as the homepage, so
       all four views begin on the same line — the only thing that moves
       when you switch between them is the content. */
    padding-block: clamp(160px, 21vh, 240px) var(--s-7);
  }
</style>
