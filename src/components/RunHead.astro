---
/**
 * Four items, spread edge to edge, no wordmark — the reference's structure.
 *
 * The type is the frame title's: display face, weight 500, sentence case,
 * -0.02em. The same voice that names a work on hover now names the sections,
 * so the header and the catalogue speak alike.
 *
 * Each character is its own element so it can roll to a copy of itself on
 * hover. The rolled duplicate is drawn by ::before from data-l, which costs
 * no extra markup. The whole set is hidden from assistive tech and the real
 * label lives on the control's aria-label, so nothing is read out letter
 * by letter.
 */
/* All four are pages now. Contents was the last overlay in the site and
   outgrew it the same way About and Contact did: at title scale over sixteen
   works it wants the height of a document and a URL you can send someone.
   The `overlay` branch below is kept — it costs one ternary and it is the
   only thing that would have to be rewritten to put a view back in an
   overlay — but nothing uses it today. */
const ITEMS: { label: string; href?: string; overlay?: string; home?: boolean }[] = [
  { label: 'Works', href: '/', home: true },
  // Was an overlay until the roll; see src/pages/contents.astro.
  { label: 'Contents', href: '/contents' },
  // A page too — the About outgrew an overlay.
  { label: 'About', href: '/about' },
  // A page, not an overlay — it holds a form, so it needs a URL of its own.
  { label: 'Contact', href: '/contact' },
];
---

<header class="runhead">
  <nav class="runhead__nav" aria-label="Primary">
    {
      ITEMS.map((item) => {
        const chars = `(${item.label})`.split('');
        const roll = (
          <span class="roll" aria-hidden="true">
            {chars.map((c) => (
              <i data-l={c}>{c}</i>
            ))}
          </span>
        );
        return item.href ? (
          <a
            class="itm"
            href={item.href}
            aria-label={item.label}
            data-path={item.href}
            data-home={item.home ? '' : undefined}
          >
            {roll}
          </a>
        ) : (
          <button class="itm" type="button" aria-label={item.label} data-overlay-open={item.overlay}>
            {roll}
          </button>
        );
      })
    }
  </nav>
</header>

<style>
  .runhead {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 140; /* above the overlays, so the nav never disappears */
    padding: 20px var(--margin);
    /* Stays legible over any image without a scrim behind it —
       exactly how the running head behaves in the decks. */
    mix-blend-mode: difference;
    isolation: isolate;
    pointer-events: none;
    transition: transform var(--d-micro) var(--ease), opacity var(--d-micro) var(--ease);
  }

  /* Retreats while you read downward, returns the moment you look back. */
  .runhead.is-hidden {
    transform: translateY(-120%);
    opacity: 0;
  }

  .runhead__nav {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--s-2);
  }
  .runhead__nav > * { pointer-events: auto; }

  /* The frame title's voice, at the frame title's size. */
  .itm {
    font-family: var(--display);
    font-weight: 500;
    /* The reference sets its nav at 14px. Same face and weight as the frame
       title — the voice is shared — but small enough that the header reads as
       furniture rather than as a second headline competing with the work. */
    font-size: clamp(11px, 1.1vw, 14px);
    letter-spacing: -0.02em;
    line-height: 1.1;
    color: #fff; /* difference-blended: bone on dark, ink on light */
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    white-space: nowrap;
  }

  /* ── Letter roll ──────────────────────────────────────────────── */
  .roll {
    display: inline-block;
    overflow: hidden;
    height: 1.15em;
    line-height: 1.15em;
    vertical-align: bottom;
  }
  .roll i {
    display: inline-block;
    position: relative;
    font-style: normal;
    transition: transform 0.55s var(--ease);
  }
  .roll i::before {
    content: attr(data-l);
    position: absolute;
    top: 100%;
    left: 0;
  }
  .itm:hover .roll i,
  .itm:focus-visible .roll i { transform: translateY(-100%); }

  .roll i:nth-child(1)  { transition-delay: 0s }
  .roll i:nth-child(2)  { transition-delay: 0.015s }
  .roll i:nth-child(3)  { transition-delay: 0.03s }
  .roll i:nth-child(4)  { transition-delay: 0.045s }
  .roll i:nth-child(5)  { transition-delay: 0.06s }
  .roll i:nth-child(6)  { transition-delay: 0.075s }
  .roll i:nth-child(7)  { transition-delay: 0.09s }
  .roll i:nth-child(8)  { transition-delay: 0.105s }
  .roll i:nth-child(9)  { transition-delay: 0.12s }
  .roll i:nth-child(10) { transition-delay: 0.135s }
  .roll i:nth-child(11) { transition-delay: 0.15s }
  .roll i:nth-child(12) { transition-delay: 0.165s }

  .itm:focus-visible { outline: 1px solid var(--accent); outline-offset: 4px; }

  /* ── Which of the four you are looking at ───────────────────────
     The current label holds full strength; the other three step back.

     Chosen with its trade-off known, not by default. mix-blend-mode
     measures the label's distance FROM the backdrop, so lowering opacity
     pushes a label toward whatever is behind it. Over the flat overlay
     ground and over dark stills that dims it correctly (18.4:1 -> 3.9:1).
     Over a bright still it darkens past full white and reads STRONGER,
     not weaker (14.6:1 -> 16.2:1), so the hierarchy inverts on the
     homepage above pale frames. Compared against three blend-proof
     alternatives before landing here; see HANDOFF.md. */
  .itm { transition: opacity var(--d-micro) var(--ease); }
  .itm:not(.is-current) { opacity: 0.5; }

  /* Pointing at the nav isolates whatever you are pointing at: that label
     holds full strength and every other steps back, the current one
     included — so hover answers "this one" rather than competing with
     "you are here".

     :has() rather than .runhead__nav:hover because the header sets
     pointer-events: none and hands it back only to the items themselves;
     :has() reads the item's own hover state and is unaffected by that.
     Gated to real pointers so a tap cannot strand a label at full
     strength while the page you are on sits dimmed behind it. */
  @media (hover: hover) {
    .runhead__nav:has(.itm:hover) .itm { opacity: 0.5; }
    .runhead__nav:has(.itm:hover) .itm:hover { opacity: 1; }
  }


  @media (max-width: 520px) {
    .runhead { padding-block: 15px; }
    .itm { font-size: 12px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .roll i { transition: none; }
    .itm:hover .roll i, .itm:focus-visible .roll i { transform: none; }
    .itm:hover { color: var(--accent); }
  }
</style>
