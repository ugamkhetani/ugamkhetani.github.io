---
import { Image } from 'astro:assets';
import { framesFor, sizesFor, cropFor } from '../lib/frames';
import { RATIO, numberFor } from '../data/composition';
import { href } from '../lib/href';

interface Props {
  slug: string;
  title: string;
  year: number;
  category: string;
  ratio: string;
  frames: string[];
  alt: string;
  span: number;
  eager?: boolean;
}

const { slug, title, year, category, ratio, frames, alt, span, eager = false } = Astro.props;

const number = numberFor(slug);
const images = framesFor(slug, frames);
const count = images.length;
const sizes = sizesFor(span);
---

<a
  class="frame"
  class:list={[{ 'frame--single': count === 1 }]}
  href={href(`work/${slug}`)}
  data-frame
  data-count={count}
  style={[`--ar:${RATIO[ratio]}`, cropFor(slug)].filter(Boolean).join(';')}
  aria-label={`${title}, ${year}, ${category}`}
>
  <span class="frame__window">
    {
      images.map((img, i) => (
        <span class="frame__layer" data-layer={i}>
          <Image
            src={img}
            alt={i === 0 ? alt : ''}
            widths={[480, 800, 1200, 1800]}
            sizes={sizes}
            loading={eager && i === 0 ? 'eager' : 'lazy'}
            decoding="async"
            aria-hidden={i === 0 ? undefined : 'true'}
          />
        </span>
      ))
    }
  </span>

  <span class="frame__meta">
    <span class="mono frame__no">{number}</span>
    <h2 class="frame__title">{title}</h2>
    <span class="mono frame__year">{year}</span>
  </span>
</a>

<style>
  .frame {
    display: block;
    position: relative;
    color: var(--bone);
    -webkit-tap-highlight-color: transparent;
  }

  /* ── The window. Aspect ratio is the work's real format. ───────── */
  .frame__window {
    display: block;
    position: relative;
    aspect-ratio: var(--ar);
    overflow: hidden;
    background: var(--ground-lift);
    isolation: isolate;
  }

  /* Ported from Draft 2: the reveal is a crossfade on a soft landing curve,
     not a hard cut. --ease-soft is scoped here so the sharper global --ease
     still governs everything else in the site.

     --d-fade is the single switch for this: 500ms crossfades, 0ms gives
     instant jump cuts. --d-drift is the slow scale on hover, independent
     of it. If you set --d-fade to 0ms, also drop `will-change: opacity`
     below — promoting ~36 layers costs GPU memory and buys nothing when
     nothing animates. */
  .frame {
    --ease-soft: cubic-bezier(0.22, 1, 0.36, 1);
    --d-fade: 500ms;
    --d-drift: 1100ms;
  }

  .frame__layer {
    position: absolute;
    inset: 0;
    /* Every layer above the base starts invisible. */
    opacity: 0;
    transition: opacity var(--d-fade) var(--ease-soft);
  }
  /* Promised only while a cut is possible, for the reason written out at
     the same rule in src/components/Still.astro. */
  .frame:hover .frame__layer,
  .frame:focus-visible .frame__layer,
  .frame.is-active .frame__layer { will-change: opacity; }
  .frame__layer[data-layer='0'] {
    opacity: 1;
    transition: none;
  }
  .frame__layer.is-cut {
    opacity: 1;
  }

  .frame__layer :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Re-centres the crop on the PICTURE for frames whose file carries
       burned-in letterbox. Framing, not motion — see FRAME_CROP in
       src/lib/frames.ts for why it is here and not in the transform. */
    object-position: 50% var(--fcy, 50%);
    filter: saturate(0.94) contrast(1.02);
    transition:
      filter var(--d-micro) var(--ease-soft),
      transform var(--d-drift) var(--ease-soft);
    transform: scale(1.001); /* kills sub-pixel edge seams */
  }

  .frame:hover .frame__layer :global(img),
  .frame:focus-visible .frame__layer :global(img),
  .frame.is-active .frame__layer :global(img) {
    filter: saturate(1) contrast(1.06) brightness(1.04);
  }

  /* Draft 2's slow drift: the whole window eases in over 1.1s while the
     stills crossfade, so the change reads as one movement rather than a
     switch. 3.5% — enough to feel, not enough to notice as an effect.

     Bound to hover, not to a particular still, on purpose. Scoping it to
     the first cut was tried and reverted: it made image 03 arrive at a
     different size from image 02, and the frame stopped feeling like one
     continuous object. Uniform beats clever here. The consequence is that
     image 01 is seen at rest at true scale and everything reached by
     hovering is seen 3.5% larger — which is the intended reading. */
  .frame:hover .frame__layer :global(img),
  .frame:focus-visible .frame__layer :global(img),
  .frame.is-active .frame__layer :global(img) {
    transform: scale(1.035);
  }

  /* ── Metadata. Number and year hold; the title arrives. ───────── */
  .frame__meta {
    display: flex;
    align-items: baseline;
    gap: var(--s-2);
    /* Nothing sits between the image and this line now, so it carries
       the whole gap itself. */
    margin-top: 15px;
  }
  .frame__no { color: var(--dim); font-variant-numeric: tabular-nums; }
  .frame__year {
    color: var(--dim);
    margin-left: auto;
    font-variant-numeric: tabular-nums;
  }
  .frame__title {
    margin: 0;
    font-family: var(--display);
    font-weight: 500;
    font-size: var(--t-md);
    letter-spacing: -0.02em;
    line-height: 1.1;
    opacity: 0;
    transform: translateY(4px);
    transition:
      opacity var(--d-micro) var(--ease),
      transform var(--d-micro) var(--ease);
  }
  .frame:hover .frame__title,
  .frame:focus-visible .frame__title,
  .frame.is-active .frame__title {
    opacity: 1;
    transform: none;
  }

  .frame:focus-visible {
    outline: none;
  }
  .frame:focus-visible .frame__window {
    outline: 1px solid var(--accent);
    outline-offset: -1px;
  }

  /* ── Touch and small screens: the title never hides. ────────────── */
  @media (hover: none), (max-width: 640px) {
    .frame__title { opacity: 1; transform: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .frame__title { opacity: 1; transform: none; }
    .frame__layer { transition: none; }
    .frame:hover .frame__layer :global(img) { transform: none; }
  }
</style>
