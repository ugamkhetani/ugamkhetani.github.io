---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/**
 * PREVIEW LOADER F · "SCOPE".
 *
 * THE ASPECT RATIO IS THE ANIMATION. The screen starts shut — two black bars
 * meeting in the middle — and they draw apart to exactly 2.39:1, the scope
 * frame, with a still and the name inside the slot. Nothing moves except the
 * shape of the frame itself. It is the quietest gesture here and the most
 * unmistakably cinema: a projector opening its mattes.
 *
 * TWO TRANSFORMS, NO LAYOUT. Each bar is half the screen tall and slides on
 * translateY. Animating a height or an inset would relayout and repaint the
 * full viewport sixty times a second for a second; two composited layers
 * sliding over a static still costs almost nothing, which is the point on a
 * screen whose entire job is to be there while the page is still arriving.
 *
 * THE RATIO IS EXACT AT EVERY WINDOW, and holding it took restructuring rather
 * than a clamp. With the mattes running the full width, the slot's width is
 * fixed, so any ceiling on its height changes the aspect — measured at
 * 1280x800, the ceiling this started with produced 2.581:1, which is a
 * letterbox but is not scope. The stage narrows instead: capped at 88vh x 2.39
 * wide with the slot capped at 88vh, so whichever term binds, the slot is the
 * stage width over 2.39. On a short window there is ground either side, which
 * is what a projected scope image actually looks like.
 *
 * IT ENDS SHUT, WHICH IS THE JOKE. The bars never open past scope; the lift
 * takes the whole frame away instead, so the opening reads as a piece of film
 * ending rather than as a curtain being cleared out of the way.
 *
 * IT IS DROP-IN. Same props, same html.intro-on gate, same 1560ms budget as
 * Opening.astro — one import swapped in index.astro.
 */
interface Props {
  /** One frame from each of eight works. The first is the one in the slot. */
  stills: { img: ImageMetadata; alt: string }[];
}
const { stills } = Astro.props;
const first = stills[0];
---

<div class="intro" data-intro aria-hidden="true">
  <div class="sc">
    <div class="sc__stage">
      {first && (
        <span class="sc__still">
          <Image src={first.img} alt="" widths={[1200, 1800, 2400]} sizes="100vw" loading="eager" decoding="sync" />
        </span>
      )}
      <span class="sc__veil" aria-hidden="true"></span>
      <span class="sc__name display">Ugam Khetani</span>

      {/* The mattes. Half the stage each, meeting at the centre line. */}
      <span class="sc__bar sc__bar--t" aria-hidden="true"></span>
      <span class="sc__bar sc__bar--b" aria-hidden="true"></span>
    </div>
  </div>
</div>

<style>
  .intro { display: none; }

  :global(html.intro-on) .intro {
    display: block;
    position: fixed;
    inset: 0;
    z-index: 300;
    background: var(--ground);
    animation: sc-lift 0.38s var(--ease) forwards;
    animation-delay: 1.16s;
  }
  :global(html.intro-on) body { overflow: hidden; }

  .sc { position: absolute; inset: 0; overflow: hidden; }

  /* THE STAGE IS SCOPE-SHAPED, WHICH IS WHY THE SLOT ALWAYS IS.
     A single clamp on the slot height cannot hold the ratio: with the mattes
     running the full width of the screen, the slot's width is fixed and any
     ceiling on its height changes the aspect. Measured at 1280x800, a 62vh
     ceiling gave 2.581:1 — a letterbox, but not scope.

     So the stage narrows instead of the frame flattening. Its width is capped
     at 88vh x 2.39, and the slot is capped at 88vh, so whichever term binds,
     slot = stage width / 2.39 exactly:
       wide window  -> stage 100vw,     slot 41.84vw = 100vw / 2.39
       short window -> stage 210.32vh,  slot 88vh    = 210.32vh / 2.39
     On a short window there is ground either side, which is what a projected
     scope image actually looks like. */
  .sc__stage {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: min(100vw, 210.32vh);
    transform: translateX(-50%);
    overflow: hidden;
    --slot: min(41.84vw, 88vh);
  }

  .sc__still { position: absolute; inset: 0; }
  .sc__still :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.94) contrast(1.02) brightness(0.6);
    /* A slow push, so the frame is alive while the mattes are moving. Ends
       at 1, not at 1.04, so the still is at its native scale when it lifts. */
    transform: scale(1.05);
    will-change: transform;
    animation: sc-push 1.34s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }

  /* Flat scrim, so the name has one consistent ground rather than whatever
     the photograph happens to be doing under it. */
  .sc__veil {
    position: absolute;
    inset: 0;
    background: var(--ground);
    opacity: 0.26;
  }

  .sc__name {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    font-size: clamp(13px, 1.5vw, 19px);
    font-weight: 500;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--bone);
    opacity: 0;
    animation: sc-name 0.42s var(--ease) forwards;
    animation-delay: 0.58s;
    pointer-events: none;
  }

  .sc__bar {
    position: absolute;
    left: 0;
    right: 0;
    height: 50%;
    background: var(--ground);
    will-change: transform;
    animation-duration: 0.72s;
    animation-timing-function: cubic-bezier(0.22, 1, 0.36, 1);
    animation-fill-mode: forwards;
    animation-delay: 0.1s;
  }
  .sc__bar--t { top: 0; animation-name: sc-open-t; }
  .sc__bar--b { bottom: 0; animation-name: sc-open-b; }

  /* Shut, then back by half the slot — which puts each bar's inner edge
     exactly on the scope line. */
  @keyframes sc-open-t {
    from { transform: translate3d(0, 0, 0); }
    to { transform: translate3d(0, calc(var(--slot) / -2), 0); }
  }
  @keyframes sc-open-b {
    from { transform: translate3d(0, 0, 0); }
    to { transform: translate3d(0, calc(var(--slot) / 2), 0); }
  }
  @keyframes sc-push {
    to { transform: scale(1); }
  }
  @keyframes sc-name {
    from { opacity: 0; transform: translate3d(0, 4px, 0); }
    to { opacity: 1; transform: none; }
  }
  @keyframes sc-lift {
    to { clip-path: inset(0 0 100% 0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .intro { display: none !important; }
  }
</style>
