---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import WatchMark from './WatchMark.astro';

interface Props {
  /** One of these two. YouTube stays first and required-by-convention so
   *  every existing caller keeps working unchanged. */
  youtube?: string;
  /** Vimeo, as "<id>/<privacy-hash>" or just "<id>". */
  vimeo?: string;
  /** An Instagram post short code. */
  instagram?: string;
  title: string;
  poster: ImageMetadata;
  alt: string;
  /** Full-bleed openings load their poster immediately. */
  eager?: boolean;
  /** The work's own `cta`. Falls back to what this always said. */
  cta?: string;
}
const { youtube, vimeo, instagram, title, poster, alt, eager = false, cta } = Astro.props;

/* AN INSTAGRAM EMBED IS PORTRAIT AND CARRIES ITS OWN CHROME — a header, a
   caption and a row of controls — so it will not sit in the 16:9 box the
   other two use. 400 x 700 is the shape their own embed code ships with, and
   the facade matches it so the poster and the mounted player are the same
   size and nothing jumps on press.

   SET INLINE RATHER THAN AS A MODIFIER CLASS, so the shape travels with the
   element that decides it and the CSS below needs only one rule with a
   default. A modifier class works here too — an earlier version used one, and
   it appeared not to, which was the dev server serving a stale stylesheet
   rather than anything wrong with the class. Worth recording because the
   symptom is convincing: the element carries the class, the rule is in the
   source, and the computed style shows neither. */
const isIG = !!instagram;
const SHAPE = isIG ? '400 / 700' : '16 / 9';
const MAXW = isIG ? '400px' : 'none';
---

<div class="facade" style={`--facade-ar:${SHAPE};--facade-max:${MAXW}`} data-facade data-youtube={youtube} data-vimeo={vimeo} data-instagram={instagram} data-title={title}>
  <div class="facade__stage">
    <Image
      src={poster}
      alt={alt}
      widths={[800, 1400, 2000]}
      sizes="100vw"
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
      class="facade__poster"
    />
  </div>

  {/* ab-zw12 FROM 2026-10-06. The pill — border, 35% ground, 6px blur, 10px
      mono — is replaced by the same control the still openings carry, so one
      treatment covers the whole route.

      NO ARROW HERE, AND THAT IS THE POINT OF THE PROP. This press mounts the
      player IN THE PAGE; the arrow is the site's mark for leaving and would
      be a lie on it. The still openings keep theirs because nothing on those
      pages plays.

      IT IS STILL A <button>, and the click is still handled on [data-facade]
      by main.ts rather than here, so nothing about the behaviour moves. */}
  <WatchMark tag="button" label={cta ?? 'Watch'} arrow={false} title={title} />
</div>

<style>
  .facade {
    position: relative;
    background: var(--ground-deep);
    /* Written inline by the component — see the note there on why this is not
       a modifier class. The defaults keep every existing caller at 16:9. */
    aspect-ratio: var(--facade-ar, 16 / 9);
    max-width: var(--facade-max, none);
    margin-inline: auto;
    overflow: hidden;
  }

  .facade__stage { position: absolute; inset: 0; }
  .facade__stage :global(img),
  .facade__stage :global(iframe) {
    width: 100%;
    height: 100%;
    border: 0;
    object-fit: cover;
  }
  .facade__poster {
    transition: transform var(--d-page) var(--ease), filter var(--d-micro) var(--ease);
  }
  .facade:hover .facade__poster { transform: scale(1.02); filter: brightness(1.05); }

  /* The control itself is WatchMark.astro, which carries its own placement.
     `:global()` reaches it because that component's elements wear their own
     scope attribute — and this is a SCOPED block, where :global() compiles;
     in an `is:global` one it would ship as a literal string and be dropped
     with no error at all (§6). */
  .facade.is-playing :global(.wm),
  .facade.is-playing .facade__poster { display: none; }

  .visually-hidden {
    position: absolute;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  /* The control's own breakpoint lives with it now. */
</style>
