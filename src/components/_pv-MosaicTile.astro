---
import { getImage } from 'astro:assets';
import { framesFor } from '../lib/frames';

/**
 * PREVIEW ONLY — one tile of a mosaic-bed draft.
 *
 * IT CARRIES TWO FRAMES AND SHOWS THE LIVE ONE BY DEFAULT. The bed renders with
 * max={1}, so today every work shows the FIRST frame in its folder. Measured
 * under the bed's own filter, five of the twelve chosen works are darker on
 * frame 1 than the ground behind them — they are black rectangles wherever they
 * are placed (the table is in src/lib/_pv-mosaic.ts). That is a separate
 * decision from placement, so it is not baked in: the tile emits both the
 * live frame and the brightest one, and the stage's third button swaps between
 * them. What loads first, and what these drafts are judged on unless the button
 * is pressed, is exactly what the site shows today.
 *
 * Still.astro is untouched. If a placement is approved and the brighter frames
 * are wanted too, the cheapest route needs no code at all: list the wanted
 * frame first in each work's markdown.
 */
interface Props {
  slug: string;
  frames: string[];
  alt: string;
  /** 1-indexed brightest frame, from the measured table. */
  pick?: number;
  /**
   * Crop past letterbox bars burned into the source frame. The scale pushes
   * them past the tile edge; the shift re-centres a frame whose bars are
   * uneven. Both measured — see CROP in src/lib/_pv-mosaic.ts.
   */
  crop?: { scale: number; shiftY: number };
}
const { slug, frames, alt, pick = 1, crop } = Astro.props;

const all = framesFor(slug, frames);
const live = all[0];
const bright = all[Math.min(Math.max(1, pick), all.length) - 1];

/* Resolved at build so both are plain optimised urls and the swap is instant. */
const liveSrc = await getImage({ src: live, width: 600 });
const brightSrc = await getImage({ src: bright, width: 600 });
---

<img
  src={liveSrc.src}
  data-live={liveSrc.src}
  data-bright={brightSrc.src}
  alt={alt}
  width={liveSrc.attributes?.width}
  height={liveSrc.attributes?.height}
  loading="eager"
  decoding="async"
  class:list={[{ 'is-cropped': !!crop }]}
  style={crop ? `--crop-s:${crop.scale};--crop-y:${crop.shiftY}%` : undefined}
/>

<style>
  img { display: block; width: 100%; height: 100%; object-fit: cover; }
  /* Scale first, then shift — the translate is a percentage of the tile's own
     height, which is the frame the offset was solved in. */
  img.is-cropped { transform: translateY(var(--crop-y, 0)) scale(var(--crop-s, 1)); }
</style>
