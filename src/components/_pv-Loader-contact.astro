---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/**
 * PREVIEW LOADER E · "CONTACT".
 *
 * THE CONTACT SHEET. The whole catalogue lands as a grid of small frames, each
 * one cut in a beat after the last, numbered in the margin the way a real sheet
 * is — and then the sheet drifts toward the camera and the page is behind it.
 * It is the only opening here that shows you EVERYTHING before it shows you
 * anything: a second of it and you already know the shape of the body of work.
 *
 * THE STAGGER IS THE WHOLE IDEA, and it is 42ms. Slower and the grid assembles
 * politely, which is the opposite of the snap a sheet has when it is laid down;
 * faster and eight frames arrive as one and the stagger is wasted. Eight at
 * 42ms is 294ms of cascade inside a 380ms cell — they overlap, so it reads as
 * one gesture with texture rather than as eight separate arrivals.
 *
 * IT SCALES, IT DOES NOT RE-LAY-OUT. The drift at the end is one transform on
 * the sheet — eight frames, one composited layer, one property. Animating the
 * grid's own track sizes would relayout the whole thing every frame.
 *
 * THE NUMBERS ARE REAL. 01..08 are the sheet's own positions, and they are set
 * in the site's mono at the site's micro size, so the sheet is furniture from
 * this page rather than a photograph of someone else's darkroom.
 *
 * IT IS DROP-IN. Same props, same html.intro-on gate, same 1560ms budget as
 * Opening.astro — one import swapped in index.astro.
 */
interface Props {
  /** One frame from each of eight works. The sheet is the catalogue. */
  stills: { img: ImageMetadata; alt: string }[];
}
const { stills } = Astro.props;

/* 42ms apart. See the note above — the number is the design, not a default. */
const STEP = 0.042;
---

<div class="intro" data-intro aria-hidden="true">
  <div class="ct">
    <div class="ct__sheet">
      {stills.map((s, i) => (
        <span class="ct__cell" style={`--d:${(i * STEP).toFixed(3)}s`}>
          <span class="ct__win">
            <Image src={s.img} alt="" widths={[400, 800]} sizes="24vw" loading="eager" decoding="sync" />
          </span>
          <span class="mono ct__n">{String(i + 1).padStart(2, '0')}</span>
        </span>
      ))}
    </div>
    <span class="ct__name display">Ugam Khetani</span>
  </div>
</div>

<style>
  .intro { display: none; }

  :global(html.intro-on) .intro {
    display: grid;
    place-items: center;
    position: fixed;
    inset: 0;
    z-index: 300;
    background: var(--ground);
    animation: ct-lift 0.38s var(--ease) forwards;
    animation-delay: 1.16s;
  }
  :global(html.intro-on) body { overflow: hidden; }

  .ct {
    width: min(84vw, 900px);
    display: grid;
    justify-items: center;
    gap: clamp(18px, 3vh, 34px);
  }

  /* Four across, two down. The drift is one transform on this element. */
  .ct__sheet {
    width: 100%;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(6px, 1vw, 12px);
    will-change: transform;
    animation: ct-drift 1.16s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }

  .ct__cell {
    display: grid;
    gap: 5px;
    opacity: 0;
    will-change: transform, opacity;
    animation: ct-lay 0.38s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    animation-delay: var(--d);
  }
  .ct__win {
    display: block;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    background: var(--ground-deep);
  }
  .ct__win :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.94) contrast(1.02) brightness(0.86);
  }
  .ct__n {
    font-size: var(--t-micro);
    letter-spacing: var(--track-mono);
    color: var(--dim);
    font-variant-numeric: tabular-nums;
  }

  .ct__name {
    font-size: clamp(13px, 1.5vw, 19px);
    font-weight: 500;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--bone);
    opacity: 0;
    animation: ct-name 0.44s var(--ease) forwards;
    animation-delay: 0.52s;
  }

  /* Cut in and settle. The 6px rise is what keeps it from reading as a fade. */
  @keyframes ct-lay {
    from { opacity: 0; transform: translate3d(0, 6px, 0) scale(0.965); }
    to { opacity: 1; transform: none; }
  }
  /* Toward the camera, barely — 1.06 over the whole run. The sheet should feel
     like it is being leaned into, not zoomed. */
  @keyframes ct-drift {
    from { transform: scale(1); }
    to { transform: scale(1.06); }
  }
  @keyframes ct-name {
    from { opacity: 0; transform: translate3d(0, 4px, 0); }
    to { opacity: 1; transform: none; }
  }
  @keyframes ct-lift {
    to { clip-path: inset(0 0 100% 0); }
  }

  /* Six across would put the frames below thumbnail size on a phone; two
     across keeps each one readable and the sheet still reads as a sheet. */
  @media (max-width: 640px) {
    .ct__sheet { grid-template-columns: repeat(2, 1fr); }
  }

  @media (prefers-reduced-motion: reduce) {
    .intro { display: none !important; }
  }
</style>
