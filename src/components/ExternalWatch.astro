---
interface Props {
  platform: string;
  label: string;
  url: string;
  /** One line of context, so the block isn't only a button. */
  note?: string;
}
const { platform, label, url, note } = Astro.props;
---

<aside class="ext">
  <div class="ext__inner">
    <div class="ext__meta">
      <span class="mono mono--dim">Available on</span>
      <span class="ext__platform">{platform}</span>
      {note && <p class="ext__note">{note}</p>}
    </div>

    <a class="ext__link" href={url} target="_blank" rel="noopener noreferrer">
      <span class="mono">{label}</span>
      <span class="ext__arrow" aria-hidden="true">↗</span>
    </a>
  </div>
</aside>

<style>
  /* Platforms that cannot be embedded get an honest treatment:
     no dead player, no play button that isn't one. */
  .ext { margin-block: var(--s-5); }

  .ext__inner {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--s-4);
    flex-wrap: wrap;
    padding-top: var(--s-3);
    border-top: 1px solid var(--rule);
  }

  .ext__platform {
    display: block;
    font-family: var(--display);
    font-weight: 500;
    font-size: var(--t-lg);
    letter-spacing: -0.02em;
    margin-top: 6px;
  }

  .ext__note {
    color: var(--muted);
    font-size: var(--t-sm);
    max-width: 42ch;
    margin: 10px 0 0;
  }

  .ext__link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 12px 18px;
    border: 1px solid var(--rule);
    color: var(--bone);
    transition: border-color var(--d-micro) var(--ease), color var(--d-micro) var(--ease);
  }
  .ext__link .mono { color: inherit; }
  .ext__link:hover { border-color: var(--accent); color: var(--accent); }
  .ext__arrow { color: var(--accent); font-size: 12px; }
</style>
