---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { filmPath, posterPath } from '../lib/assets';
import WatchMark from './WatchMark.astro';

interface Props {
  slug: string;
  src: string;
  label: string;
  href?: string;
  poster?: string;
  ratio: '16:9' | '9:16' | '1:1';
  /** Used as the poster until a dedicated one is supplied. */
  fallbackPoster: ImageMetadata;
  alt: string;
  /** The work's own `cta`, used in place of the derived "View on <origin>". */
  cta?: string;
}
const { slug, src, label, href, poster, ratio, fallbackPoster, alt, cta } = Astro.props;

const film = filmPath(slug, src);
/* An explicit `poster:` in the markdown wins; otherwise the cover (or the
   still) the page already chose serves the video too, so one file covers
   both states and nothing has to be duplicated into /public when the .mp4
   finally arrives. */
const posterUrl = posterPath(slug, poster) ?? fallbackPoster.src;
const AR = { '16:9': '16 / 9', '9:16': '9 / 16', '1:1': '1 / 1' }[ratio];

// Host of the original post, shown when the film itself isn't here yet.
const origin = href ? (href.includes('instagram') ? 'Instagram' : href.includes('drive.google') ? 'Drive' : 'Original') : null;
---

<figure class="film" style={`--ar:${AR}`}>
  {
    film.exists ? (
      <video class="film__video" controls preload="none" playsinline poster={posterUrl}>
        <source src={film.url} type="video/mp4" />
        Your browser cannot play this video.
      </video>
    ) : (
      <Fragment>
        {/* No file yet. With a link back to the original we send people there;
            without one, the still stands on its own rather than pretending. */}
        {href ? (
          <a
            class="film__await"
            href={href}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`${label} — opens on ${origin}`}
          >
            <Image
              src={fallbackPoster}
              alt={alt}
              widths={[400, 700, 1000]}
              sizes="(max-width: 640px) 100vw, 33vw"
              loading="lazy"
              decoding="async"
            />
            {/* ab-zw12 FROM 2026-10-06, stepped down for a grid cell. The
                work's own `cta` wins; without one this still derives
                "View on <origin>" as it always did. Aladdin is why the
                override exists — its films sit on Google Drive, and "View on
                Drive" is a storage bucket, not a destination to offer a
                reader. Ugam set it to "View".

                1.45rem, NOT the route's clamp(2rem, 4.4vw, 3.2rem): a film
                cell is about a third of the measure, and the full size runs
                straight out of it. The arrow STAYS — unlike a facade, this
                does leave the site, because the .mp4 is not here yet. */}
            <WatchMark tag="span" label={cta ?? `View on ${origin}`} size="1.45rem" />
          </a>
        ) : (
          <div class="film__await film__await--quiet">
            <Image
              src={fallbackPoster}
              alt={alt}
              widths={[400, 700, 1000]}
              sizes="(max-width: 640px) 100vw, 33vw"
              loading="lazy"
              decoding="async"
            />
          </div>
        )}
      </Fragment>
    )
  }

  <figcaption class="film__cap">
    <span class="mono">{label}</span>
    {
      film.exists && href && (
        <a class="mono film__src" href={href} target="_blank" rel="noopener noreferrer">
          Original <span aria-hidden="true">↗</span>
        </a>
      )
    }
  </figcaption>
</figure>

<style>
  .film { margin: 0; }

  .film__video,
  .film__await {
    display: block;
    position: relative;
    width: 100%;
    aspect-ratio: var(--ar);
    background: var(--ground-deep);
    object-fit: cover;
  }

  .film__await :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.9) brightness(0.72);
    transition: filter var(--d-micro) var(--ease);
  }
  .film__await:hover :global(img) { filter: saturate(1) brightness(0.92); }
  .film__await--quiet :global(img) { filter: saturate(0.9) brightness(0.82); }

  /* The mark is WatchMark.astro and carries its own placement; only the inset
     is this component's business, because a grid cell is not a frame. */
  .film__await :global(.wm) { left: 14px; bottom: 14px; }

  .film__cap {
    display: flex;
    justify-content: space-between;
    gap: var(--s-2);
    align-items: baseline;
    margin-top: 11px;
    padding-top: 9px;
    border-top: 1px solid var(--rule-soft);
  }
  .film__src {
    color: var(--dim);
    transition: color var(--d-micro) var(--ease);
  }
  .film__src:hover { color: var(--accent); }
</style>
