---
/**
 * ABOUT — five movements, built to be read by scrolling.
 *
 * THE RULED PAGE. The twelve-column grid the whole site composes on stops
 * being invisible: every movement draws its own column rules as hairlines
 * down the full height of the section, staggered as it arrives, and the
 * type is then placed against them deliberately off-centre. A page that
 * shows its own measure reads as designed rather than as arranged.
 *
 * TWO VOICES. Sans states a fact; Fraunces italic turns it over. Where a
 * sentence does both it changes face at its own comma — see `cut()` below,
 * which splits on punctuation the copy already has and never invents a
 * break. The hero does it on a single word: "film" set in serif italic
 * accent inside a sans line.
 *
 * THE OTHER DEVICES, each doing real work rather than decoration:
 *   · a hanging indent — the first line of every statement outdents past
 *     the edge the rest of the page aligns to;
 *   · a tone band — the pull quote full bleed on --ground-lift, the one
 *     place in the site where the ground changes;
 *   · folios at the foot of each spine, and the movement's name running
 *     bottom-to-top up the first column, the way a title runs up a spine;
 *   · the stair — movement 01's five paragraphs each begin one column
 *     further right than the last, landing on consecutive ledger rules;
 *   · the questions — movement 02's clauses each take their own line, and
 *     the ones that ask take the serif, split on punctuation the copy
 *     already has;
 *   · reading light — prose sits at --bone-dim and brightens to --bone
 *     word by word as the reading line passes it;
 *   · the lit segment — the ledger answers the pointer as ONE system,
 *     a short glowing length of line held against the grid at the
 *     cursor's own height.
 *
 * AND THE RULE THAT GOVERNS ALL OF IT: nothing here is hidden by a base
 * style. The reading-light floor is --bone-dim, the site's own body-copy
 * colour at 14:1, so unlit prose is exactly as readable as prose anywhere
 * else. Masked entrances, drawn rules and the ledger all live inside
 * keyframes applied by .is-in, so a stalled observer, a backgrounded tab
 * or a script that never ran leaves every rule drawn and every word
 * readable. base.css carries the same rule and HANDOFF.md §5 records why —
 * it has bitten this project three times, once on this very page.
 *
 * THREE TRAPS THIS FILE IS BUILT AROUND, all of them recorded in
 * HANDOFF.md §6 because each cost real time:
 *   · grid children are placed BY NAME, never with a `> *` blanket —
 *     Astro scopes `.bay > *` with its cid on both compounds, which
 *     outranks a scoped single class and silently flattens every
 *     placement below it to full width;
 *   · `text-indent` is reset on .line and .line__in — it inherits, and
 *     every inline-block re-applies it to its own first line, which
 *     pushed each masked word out of its own overflow:hidden box;
 *   · the line masks carry bottom padding — a line box set tighter than
 *     1em is shorter than the glyphs it holds, and the descenders were
 *     being shaved off.
 */
import Base from '../layouts/Base.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { HERO, PORTRAIT, WHO, PROCESS, ACROSS, PROOF, CLOSING } from '../data/about';
import { EMAIL, PHONE, WHATSAPP } from '../data/contact';
import { framesFor } from '../lib/frames';

const works = await getCollection('works');
const bySlug = new Map(works.map((w) => [w.id, w]));
const proof = PROOF.works.map((w) => {
  const rec = bySlug.get(w.slug);
  return { ...w, poster: rec ? framesFor(w.slug, rec.data.frames)[0] : null };
});

const words = (s: string) => s.split(' ');

/** Re-set, not rewritten: broken at the sentence's own comma so each
 *  clause can take a different voice. Both halves verbatim. */
const cut = (s: string): [string, string] => {
  const i = s.indexOf(',');
  return i < 0 ? [s, ''] : [s.slice(0, i + 1), s.slice(i + 1).trim()];
};
const [whoSans, whoSerif] = cut(WHO.head);

/** Twelve rules, matching --cols at the desktop breakpoint. The overlay is
 *  hidden below 901px, where --cols drops to six and then one. */
const LEDGER = Array.from({ length: 12 }, (_, i) => i);

/** The process copy already contains questions — three of them packed into
 *  one line. Splitting on the question mark lets each stand on its own and
 *  take the serif, which is the page's voice for turning something over
 *  rather than stating it. Nothing is added, removed or reordered; a line
 *  with no question mark simply comes back whole. */
const clauses = (l: string) => l.split(/(?<=\?)\s+/).filter(Boolean);
const asks = (c: string) => c.trim().endsWith('?');
---

<Base
  title="About — Ugam Khetani"
  description="Composer, producer and sound designer based in Mumbai."
>
  <div class="rg" data-rg>
    <div class="gauge" aria-hidden="true"><span class="gauge__in" data-progress></span></div>

    {/* ── Opening ───────────────────────────────────────────── */}
    <header class="open">
      <div class="ledger" aria-hidden="true" data-reveal>
        {LEDGER.map((i) => (<i style={`--i:${i}`}></i>))}
      </div>

      <p class="mono open__eyebrow" data-reveal>{HERO.eyebrow}</p>

      <h1 class="open__h">
        {HERO.statement.map((line, li) => (
          <span class="line" data-reveal style={`--i:${li + 1}`}>
            <span class="line__in">
              {line.map((part) => (part.accent ? <em class="hot serif">{part.t}</em> : part.t))}
            </span>
          </span>
        ))}
      </h1>

      <div class="open__foot" data-reveal style="--i:3">
        <ul class="tags">{HERO.role.map((r) => <li class="mono">{r}</li>)}</ul>
        <ul class="tags tags--dim">{HERO.place.map((r) => <li class="mono">{r}</li>)}</ul>
      </div>

      {PORTRAIT && (
        <div class="open__portrait" data-reveal style="--i:2">
          <img src={PORTRAIT} alt="Ugam Khetani" loading="eager" decoding="async" />
        </div>
      )}

      <span class="cue" aria-hidden="true">&darr;</span>
    </header>

    {/* ── 01 · Who I am ─────────────────────────────────────── */}
    <section class="sec" aria-labelledby="r-who">
      <div class="ledger" aria-hidden="true" data-reveal>
        {LEDGER.map((i) => (<i style={`--i:${i}`}></i>))}
      </div>

      <div class="spine">
        <div class="spine__top">
          <span class="mono spine__n">01</span>
          <h2 class="mono spine__t" id="r-who">Who I am</h2>
        </div>
        <span class="mono spine__folio">01/05</span>
      </div>

      <h3 class="stmt">
        <span class="stmt__a">
          {words(whoSans).map((w, i) => (
            <span class="line" data-reveal style={`--i:${i}`}><span class="line__in">{w}&nbsp;</span></span>
          ))}
        </span>
        {whoSerif && (
          <span class="stmt__b serif">
            {words(whoSerif).map((w, i) => (
              <span class="line" data-reveal style={`--i:${i + 4}`}><span class="line__in">{w}&nbsp;</span></span>
            ))}
          </span>
        )}
      </h3>

      {/* `read` is not decoration on the paragraphs below: it is what puts
          them on the --bone-dim floor. Without it they inherit the page's
          white and the reading light lights white onto white. Measured lit
          and unlit both rgb(255,255,255) — an effect doing nothing at all
          while looking perfectly fine, which is the hardest kind to catch. */}
      <div class="well stair">
        {WHO.body.map((p, i) => (
          <div class="stair__p read" data-read style={`--s:${i}`}>
            <p>{words(p).map((w) => <span class="w">{w + ' '}</span>)}</p>
          </div>
        ))}
      </div>
    </section>

    {/* ── 02 · How I work ───────────────────────────────────── */}
    <section class="sec" aria-labelledby="r-how">
      <div class="ledger" aria-hidden="true" data-reveal>
        {LEDGER.map((i) => (<i style={`--i:${i}`}></i>))}
      </div>

      <div class="spine">
        <div class="spine__top">
          <span class="mono spine__n">02</span>
          <h2 class="mono spine__t" id="r-how">How I work</h2>
        </div>
        <span class="mono spine__folio">02/05</span>
      </div>

      <ol class="steps">
        {PROCESS.map((s) => (
          <li class="step">
            <hr class="draw" data-reveal />
            <span class="mono step__n">{s.n}</span>
            <h3 class="step__title" data-reveal>{s.title}</h3>
            <div class="read step__lines" data-read>
              {s.lines.flatMap((l) => clauses(l)).map((c) => (
                <p class={asks(c) ? 'asks serif' : undefined}>
                  {words(c).map((w) => <span class="w">{w + ' '}</span>)}
                </p>
              ))}
            </div>
          </li>
        ))}
      </ol>
    </section>

    {/* ── The tone band ─────────────────────────────────────────
        A sibling of the sections, not a child of one: a grid item with
        negative inline margins would be wider than its own track. Out
        here the margins cancel the page's padding exactly, so the band
        is the viewport's width and not a pixel more. */}
    <figure class="band">
      <blockquote class="serif band__q">
        {words(PROCESS[2].pull!).map((w, i) => (
          <span class="line" data-reveal style={`--i:${i}`}><span class="line__in">{w}&nbsp;</span></span>
        ))}
      </blockquote>
      <figcaption class="mono band__cap">{PROCESS[2].title}</figcaption>
    </figure>

    {/* ── 03 · What I work across — Movement's grid ──────────── */}
    <section class="sec" aria-labelledby="r-across">
      <div class="ledger" aria-hidden="true" data-reveal>
        {LEDGER.map((i) => (<i style={`--i:${i}`}></i>))}
      </div>

      <div class="spine">
        <div class="spine__top">
          <span class="mono spine__n">03</span>
          <h2 class="mono spine__t" id="r-across">What I work across</h2>
        </div>
        <span class="mono spine__folio">03/05</span>
      </div>

      <h3 class="stmt stmt--stack">
        <span class="stmt__a">
          <span class="line" data-reveal><span class="line__in">{ACROSS.head[0]}</span></span>
        </span>
        <span class="stmt__b serif">
          <span class="line" data-reveal style="--i:1"><span class="line__in">{ACROSS.head[1]}</span></span>
        </span>
      </h3>

      <div class="well">
        <div class="read lede" data-read>
          <p>{words(ACROSS.lede).map((w) => <span class="w">{w + ' '}</span>)}</p>
        </div>

        <div class="cols">
          {ACROSS.columns.map((c, ci) => (
            <div class="col" data-reveal style={`--i:${ci}`}>
              <h4 class="mono col__lab">{c.label}</h4>
              <ul>
                {c.items.map((it, i) => (
                  <li><span class="mono col__n">{String(i + 1).padStart(2, '0')}</span>{it}</li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* ── 04 · Selected proof ───────────────────────────────── */}
    <section class="sec" aria-labelledby="r-proof">
      <div class="ledger" aria-hidden="true" data-reveal>
        {LEDGER.map((i) => (<i style={`--i:${i}`}></i>))}
      </div>

      <div class="spine">
        <div class="spine__top">
          <span class="mono spine__n">04</span>
          <h2 class="mono spine__t" id="r-proof">Selected proof</h2>
        </div>
        <span class="mono spine__folio">04/05</span>
      </div>

      <div class="well">
        <div class="stats">
          {PROOF.stats.map((s, i) => (
            <div class="stat" data-reveal style={`--i:${i}`}>
              <span
                class="stat__figure"
                data-count={s.count ?? undefined}
                data-pad={s.pad ?? undefined}
                data-suffix={s.suffix ?? undefined}
              >{s.figure}</span>
              <span class="mono stat__lab">{s.label}</span>
            </div>
          ))}
        </div>

        <ul class="works" data-works>
          {proof.map((w, i) => (
            <li data-reveal style={`--i:${i}`}>
              <a class="work" href={`/work/${w.slug}`}>
                <span class="work__title">{w.title}</span>
                <span class="mono work__role">{w.role}</span>
                <span class="work__arrow" aria-hidden="true">&rarr;</span>
              </a>
              {w.poster && (
                <span class="work__peek" aria-hidden="true">
                  <Image src={w.poster} alt="" widths={[420]} sizes="320px" loading="lazy" decoding="async" />
                </span>
              )}
            </li>
          ))}
        </ul>
      </div>
    </section>

    {/* ── 05 · Closing ──────────────────────────────────────── */}
    <section class="sec sec--close" aria-labelledby="r-close">
      <div class="ledger" aria-hidden="true" data-reveal>
        {LEDGER.map((i) => (<i style={`--i:${i}`}></i>))}
      </div>

      <div class="spine">
        <div class="spine__top">
          <span class="mono spine__n">05</span>
          <h2 class="mono spine__t" id="r-close">Closing</h2>
        </div>
        <span class="mono spine__folio">05/05</span>
      </div>

      <h3 class="stmt stmt--serif serif">
        {words(CLOSING.head).map((w, i) => (
          <span class="line" data-reveal style={`--i:${i}`}><span class="line__in">{w}&nbsp;</span></span>
        ))}
      </h3>

      <div class="well">
        <div class="read lede" data-read>
          <p>{words(CLOSING.body).map((w) => <span class="w">{w + ' '}</span>)}</p>
        </div>

        <hr class="draw" data-reveal />

        <a class="call" href="/contact">
          <span class="call__big">
            {words(CLOSING.call).map((w, i) => (
              <span class="line" data-reveal style={`--i:${i}`}><span class="line__in">{w}&nbsp;</span></span>
            ))}
          </span>
          <span class="mono call__tail">{CLOSING.tail}</span>
        </a>

        <ul class="direct" data-reveal>
          <li><span class="mono mono--dim">Email</span> <a href={`mailto:${EMAIL}?subject=${encodeURIComponent('Project enquiry')}`}>{EMAIL}</a></li>
          <li><span class="mono mono--dim">WhatsApp</span> <a href={WHATSAPP} target="_blank" rel="noopener">Message</a></li>
          <li><span class="mono mono--dim">Phone</span> <a href={PHONE.href}>{PHONE.value}</a></li>
        </ul>
      </div>
    </section>
  </div>
</Base>

<script>
  function initRegister() {
    const page = document.querySelector<HTMLElement>('[data-rg]');
    if (!page || page.dataset.bound) return;
    page.dataset.bound = '1';

    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const fine = matchMedia('(hover: hover) and (pointer: fine)').matches;
    const bar = page.querySelector<HTMLElement>('[data-progress]');

    type Block = { words: HTMLElement[]; el: HTMLElement; lit: number };
    const blocks: Block[] = Array.from(page.querySelectorAll<HTMLElement>('[data-read]')).map((el) => ({
      el, words: Array.from(el.querySelectorAll<HTMLElement>('.w')), lit: 0,
    }));
    if (still) for (const b of blocks) { b.words.forEach((w) => w.classList.add('is-lit')); b.lit = b.words.length; }

    let ticking = false;
    const measure = () => {
      ticking = false;
      const vh = innerHeight;
      const max = document.documentElement.scrollHeight - vh;
      if (bar) bar.style.transform = `scaleY(${max > 0 ? Math.min(scrollY / max, 1) : 0})`;
      if (still) return;
      const line = vh * 0.68;
      for (const b of blocks) {
        const r = b.el.getBoundingClientRect();
        const span = r.height + vh * 0.16;
        const p = span > 0 ? (line - r.top) / span : 0;
        const want = Math.max(0, Math.min(b.words.length, Math.ceil(p * b.words.length)));
        if (want === b.lit) continue;
        if (want > b.lit) for (let i = b.lit; i < want; i++) b.words[i].classList.add('is-lit');
        else for (let i = want; i < b.lit; i++) b.words[i].classList.remove('is-lit');
        b.lit = want;
      }
    };
    const onScroll = () => { if (!ticking) { ticking = true; requestAnimationFrame(measure); } };
    addEventListener('scroll', onScroll, { passive: true });
    addEventListener('resize', onScroll, { passive: true });
    measure();

    /* ── the ledger answers the pointer, as ONE system ────────────
       Rule i in EVERY ledger sits at the same x: they are all laid out
       inside the same page padding, on the same twelve columns. Column i
       is therefore not seven separate hairlines but ONE line running the
       height of the document, drawn in pieces.

       That is why this is bound once on the page and drives every ledger
       together. Bound per section — which is how it was — each section
       ran its own loop, so crossing a seam fired one pointerleave while
       the next fired pointermove, and the light died and was reborn at
       every boundary. Nothing was wrong with the drawing; the system was
       simply cut into pieces that could not see each other.

       Vertical offsets are stored DOCUMENT-relative (rect.top + scrollY).
       Cached viewport offsets are only correct at scroll position zero,
       which is exactly why the segment effect used to work in the first
       movement and nowhere below it.

       Eased, frame-driven, sleeps when settled, real pointers only. */
    if (fine && !still) {
      const ruled = matchMedia('(min-width: 901px)');
      const ledgers = Array.from(page.querySelectorAll<HTMLElement>('.ledger'));
      const perLedger = ledgers.map((l) => Array.from(l.querySelectorAll<HTMLElement>('i')));
      const cols = perLedger.length ? perLedger[0].length : 0;

      if (cols) {
        const groups: HTMLElement[][] = [];
        for (let i = 0; i < cols; i++) groups.push(perLedger.map((rs) => rs[i]).filter(Boolean));

        let lefts: number[] = [];
        let tops: number[] = [];
        let span = 0;
        const cache = () => {
          lefts = groups.map((g) => g[0].getBoundingClientRect().left);
          tops = ledgers.map((l) => l.getBoundingClientRect().top + scrollY);
          span = lefts.length > 1 ? lefts[1] - lefts[0] : 0;
        };
        cache();
        addEventListener('resize', cache, { passive: true });
        // Rules move vertically as images settle, so refresh once things load.
        addEventListener('load', cache);

        const val = new Float32Array(cols);
        const shown = new Float32Array(cols).fill(-1);
        let px = -1e5, py = 0, inside = false, raf = 0;

        const frame = () => {
          raf = 0;
          let busy = false;
          const docY = py + scrollY;
          for (let k = 0; k < ledgers.length; k++) {
            ledgers[k].style.setProperty('--py', (docY - tops[k]).toFixed(1) + 'px');
          }
          for (let i = 0; i < cols; i++) {
            const d = Math.abs(lefts[i] - px);
            const t = inside ? Math.max(0, 1 - d / 200) : 0;
            val[i] += (t * t - val[i]) * 0.2;
            if (val[i] < 0.002) val[i] = 0;
            // The delta test alone never writes the last step home: a value
            // that lands on 0 from 0.002 differs by less than the threshold,
            // so the DOM kept a stale 0.002 for ever while the state said 0.
            // Invisible at 1px — 0.0019 of alpha — but the resting state
            // should be the resting state. Force the final write.
            if (Math.abs(val[i] - shown[i]) > 0.003 || (val[i] === 0 && shown[i] !== 0)) {
              for (const el of groups[i]) {
                el.style.setProperty('--lit', val[i].toFixed(3));
              }
              shown[i] = val[i];
            }
            if (val[i] > 0) busy = true;
          }
          if (inside || busy) raf = requestAnimationFrame(frame);
        };
        const kick = () => { if (!raf) raf = requestAnimationFrame(frame); };

        page.addEventListener('pointermove', (e) => {
          const pe = e as PointerEvent;
          if (pe.pointerType !== 'mouse' || !ruled.matches) return;
          px = pe.clientX; py = pe.clientY; inside = true; kick();
        }, { passive: true });
        page.addEventListener('pointerleave', () => { inside = false; kick(); });
      }
    }

    const counters = Array.from(page.querySelectorAll<HTMLElement>('[data-count]'));
    if (counters.length && !still) {
      const io = new IntersectionObserver((entries, obs) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          const el = e.target as HTMLElement;
          obs.unobserve(el);
          const to = Number(el.dataset.count);
          const pad = Number(el.dataset.pad ?? 0);
          const suffix = el.dataset.suffix ?? '';
          const final = String(to).padStart(pad, '0') + suffix;
          /* The count is decoration; the figure is information. Belt and
             braces so the true figure lands whatever the frame loop does. */
          const settle = setTimeout(() => { el.textContent = final; }, 1500);
          const t0 = performance.now();
          const tick = (now: number) => {
            const p = Math.min((now - t0) / 900, 1);
            const v = Math.round(to * (1 - Math.pow(1 - p, 3)));
            el.textContent = p < 1 ? String(v).padStart(pad, '0') + suffix : final;
            if (p < 1) requestAnimationFrame(tick); else clearTimeout(settle);
          };
          requestAnimationFrame(tick);
        }
      }, { threshold: 0.6 });
      counters.forEach((c) => io.observe(c));
    }

    if (fine && !still) {
      page.querySelector<HTMLElement>('[data-works]')?.querySelectorAll<HTMLElement>('li').forEach((li) => {
        const peek = li.querySelector<HTMLElement>('.work__peek');
        if (!peek) return;
        const move = (e: PointerEvent) => {
          const r = li.getBoundingClientRect();
          peek.style.setProperty('--x', `${e.clientX - r.left}px`);
          peek.style.setProperty('--y', `${e.clientY - r.top}px`);
        };
        li.addEventListener('pointerenter', (e) => { move(e as PointerEvent); li.classList.add('is-peek'); });
        li.addEventListener('pointermove', move, { passive: true });
        li.addEventListener('pointerleave', () => li.classList.remove('is-peek'));
      });
    }
  }

  initRegister();
  document.addEventListener('astro:page-load', initRegister);
</script>

<style>
  .rg {
    --tier-0: clamp(2.75rem, 10vw, 9rem);
    --tier-1: clamp(2.5rem, 8vw, 7.5rem);
    --tier-2: clamp(1.75rem, 5vw, 4.25rem);
    --tier-3: clamp(1.5rem, 2.8vw, 2.5rem);
    --tier-4: clamp(1.0625rem, 1.35vw, 1.375rem);

    padding-inline: var(--margin);
    padding-bottom: 20vh;
  }

  .rg [data-reveal] { --i: 0; }
  @media (prefers-reduced-motion: no-preference) {
    .rg [data-reveal].is-in { animation-delay: calc(var(--i) * 70ms); }
  }

  .line {
    display: inline-block; overflow: hidden; vertical-align: bottom;
    padding-bottom: 0.24em; margin-bottom: -0.24em;
    padding-right: 0.06em; margin-right: -0.06em;
  }
  .line__in { display: inline-block; }
  /* text-indent INHERITS, and every inline-block is a block container that
     applies it to its own first line. The hanging indent on .stmt below was
     therefore re-applied inside each masked word, pushing the word out of
     its own overflow:hidden box — measured: .line boxes collapsed from full
     word width to 4px, exactly the padding, and the statement rendered as
     fragments. The hang has to happen once, on the statement, and stop. */
  .line, .line__in { text-indent: 0; }
  @media (prefers-reduced-motion: no-preference) {
    .line[data-reveal].is-in .line__in {
      animation: line-up 900ms var(--ease) both;
      animation-delay: calc(var(--i) * 70ms);
    }
  }
  @keyframes line-up { from { transform: translateY(135%); } to { transform: none; } }

  .draw { display: block; height: 1px; border: 0; margin: 0; background: var(--rule); transform-origin: left; }
  @media (prefers-reduced-motion: no-preference) {
    .draw[data-reveal].is-in { animation: draw 1000ms var(--ease) both; }
  }
  @keyframes draw { from { transform: scaleX(0); } to { transform: none; } }

  .read p { color: var(--bone-dim); margin: 0 0 var(--s-3); }
  .read p:last-child { margin-bottom: 0; }
  .w { transition: color var(--d-reveal) var(--ease); }
  .w.is-lit { color: var(--bone); }

  .gauge {
    position: fixed; z-index: 120; pointer-events: none;
    left: calc(var(--margin) * 0.42); width: 1px;
    top: calc(var(--head-h) + 24px); bottom: 24px;
    background: var(--rule-soft);
  }
  .gauge__in { display: block; width: 100%; height: 100%; background: var(--accent); transform-origin: top; transform: scaleY(0); }
  @media (max-width: 900px) { .gauge { display: none; } }

  /* ── the ledger ────────────────────────────────────────────────
     Twelve hairlines on the site's own column boundaries. Decoration,
     aria-hidden, pointer-events: none — it lies over the whole section
     and would otherwise take every hit in it. Drawn only above 901px,
     where --cols is still twelve; below that it would spill into
     implicit columns, so it is simply not rendered. */
  .ledger { display: none; }
  @media (min-width: 901px) {
    .ledger {
      position: absolute; inset: 0; z-index: 0; pointer-events: none;
      display: grid;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--gutter);
    }
  }
  /* ── C · THE LIT SEGMENT ───────────────────────────────────────
     Light localised in BOTH axes: falloff across x chooses which lines
     answer, a gradient centred on the cursor's own height chooses how
     much of each one lights. What travels is a short glowing length of
     line — a lamp held against the grid rather than a switch thrown.

     Each ledger carries its own --py measured from its own document top,
     so when the cursor sits near a seam the ledger below already has a
     small negative --py and its share of the glow is drawn too. The
     segment crosses the boundary instead of stopping at it.

     The line moves to a pseudo-element because a border cannot carry a
     gradient. It sits at left: 0, exactly where the border was. */
  .ledger i { display: block; position: relative; transform-origin: top; }
  .ledger i::before {
    content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 1px;
    background:
      linear-gradient(to bottom,
        transparent calc(var(--py, -9999px) - 130px),
        rgba(255, 255, 255, var(--lit, 0)) calc(var(--py, -9999px) - 24px),
        rgba(255, 255, 255, var(--lit, 0)) calc(var(--py, -9999px) + 24px),
        transparent calc(var(--py, -9999px) + 130px)),
      var(--rule-soft);
  }
  @media (prefers-reduced-motion: no-preference) {
    /* The base reveal would nudge the whole overlay 14px down; the rules
       do their own entrance instead. Hidden state lives only here, and
       the overlay carries no content. */
    .ledger[data-reveal].is-in { animation: none; }
    .ledger[data-reveal].is-in i {
      animation: rule-down 1100ms var(--ease) both;
      animation-delay: calc(var(--i) * 45ms);
    }
  }
  @keyframes rule-down { from { transform: scaleY(0); } to { transform: none; } }

  /* ── Opening ───────────────────────────────────────────────────── */
  .open {
    position: relative;
    min-height: calc(100vh - var(--head-h));
    display: flex; flex-direction: column; justify-content: center;
    padding: clamp(120px, 17vh, 210px) 0 clamp(36px, 6vh, 72px);
  }
  .open > :not(.ledger) { position: relative; z-index: 1; }
  .open__eyebrow { color: var(--muted); font-size: var(--t-xs); margin: 0 0 clamp(28px, 5vh, 60px); }
  .open__h {
    font-family: var(--display); font-weight: 500;
    font-size: var(--tier-1); line-height: 0.98;
    letter-spacing: -0.045em; margin: 0;
  }
  .open__h .line { display: block; }
  .serif { font-family: var(--serif); font-style: italic; font-weight: 400; letter-spacing: -0.015em; }
  /* Fraunces sets optically smaller than the grotesk at the same size. */
  .open__h .serif { font-size: 1.07em; letter-spacing: -0.02em; }
  .hot { color: var(--accent); }

  .open__foot {
    display: flex; flex-wrap: wrap; align-items: baseline;
    justify-content: space-between; gap: var(--s-3);
    margin-top: clamp(36px, 6vh, 72px);
    padding-top: 16px; border-top: 1px solid var(--rule);
  }
  .tags { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--s-3); }
  .tags li { font-size: var(--t-xs); color: var(--muted); }
  .tags li + li::before { content: '·'; color: var(--rule); margin-right: var(--s-3); }
  .tags--dim li { color: var(--dim); }
  .open__portrait { max-width: 340px; margin-top: var(--s-4); }
  .open__portrait img { display: block; width: 100%; height: auto; }

  .cue { display: block; color: var(--dim); font-size: var(--t-md); margin-top: clamp(24px, 4vh, 48px); }
  @media (prefers-reduced-motion: no-preference) {
    .cue { animation: cue-drift 2.4s var(--ease) infinite; }
  }
  @keyframes cue-drift { 0%, 100% { transform: translateY(0); opacity: 0.5; } 50% { transform: translateY(6px); opacity: 1; } }

  /* ── section grid ──────────────────────────────────────────────
     Placed child by child. A `> *` blanket compiles with the scoping
     attribute on both compounds and outranks a single scoped class,
     silently flattening every placement below it to full width. */
  .sec {
    position: relative;
    display: grid;
    grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
    column-gap: var(--gutter);
    padding-top: clamp(56px, 10vh, 130px);
    padding-bottom: clamp(56px, 10vh, 130px);
  }
  .sec--close { padding-bottom: 0; }
  .sec > .spine { grid-column: 1 / span 1; z-index: 1; }
  .sec > .stmt  { grid-column: 2 / -2; z-index: 1; }
  .sec > .well  { grid-column: 4 / -1; z-index: 1; }
  .sec > .steps { grid-column: 4 / -1; z-index: 1; }

  /* The spine holds its name at the head and its folio at the foot, the
     way a book page carries them. */
  .spine {
    align-self: stretch;
    display: flex; flex-direction: column; justify-content: space-between;
    align-items: flex-start; gap: var(--s-4);
  }
  .spine__top { display: flex; flex-direction: column; align-items: flex-start; gap: var(--s-3); }
  .spine__n { color: var(--accent); font-size: var(--t-xs); font-variant-numeric: tabular-nums; }
  .spine__folio { color: var(--dim); font-size: var(--t-xs); font-variant-numeric: tabular-nums; }
  /* vertical-rl reads top-to-bottom; the half turn sends it up the spine. */
  .spine__t {
    writing-mode: vertical-rl; transform: rotate(180deg);
    margin: 0; color: var(--bone); font-size: var(--t-xs); white-space: nowrap;
  }

  /* ── statements, with the first line hung ──────────────────────
     The outdent is smaller than the page margin at every width the
     clamp can reach, so the line can never leave the page. */
  .stmt {
    font-family: var(--display); font-weight: 500;
    font-size: var(--tier-2); line-height: 1.06; letter-spacing: -0.042em;
    margin: 0 0 clamp(40px, 8vh, 88px);
    text-indent: clamp(-84px, -5.4vw, 0px);
  }
  .stmt__a, .stmt__b { display: inline; }
  .stmt__b { letter-spacing: -0.02em; }
  .stmt--stack .stmt__a, .stmt--stack .stmt__b { display: block; }
  /* Only the first line hangs; the second returns to the measure, which
     is what makes the indent read as a hang rather than as a shift. */
  .stmt--stack .stmt__b { text-indent: 0; padding-left: clamp(0px, 5vw, 80px); }
  .stmt--serif { letter-spacing: -0.018em; line-height: 1.1; max-width: 20ch; }

  .lede { font-size: var(--tier-4); line-height: 1.72; max-width: 46ch; margin: 0 0 clamp(44px, 8vh, 88px); }
  .well { display: block; }
  /* ── the stair ─────────────────────────────────────────────────
     Each paragraph starts one column further right than the last. The
     well spans section columns 4–12, so its own column 1+i lands on
     section column 4+i — which is exactly where a ledger hairline is
     drawn. Measured at 1440: the five paragraphs begin at 409, 516,
     624, 732 and 839, every one of them a rule position, off by zero.
     That is the whole point of it. The prose steps down the page ON the
     structure, which is what turns the ledger from something drawn over
     the page into something the page is built on.

     The measure is held constant at 44ch and only the start moves, so
     the fifth paragraph reads no harder than the first. */
  .stair {
    display: grid;
    grid-template-columns: repeat(9, minmax(0, 1fr));
    column-gap: var(--gutter);
    row-gap: clamp(20px, 3.4vh, 38px);
  }
  .stair__p { grid-column: calc(1 + var(--s)) / -1; }
  .stair__p p { font-size: var(--tier-4); line-height: 1.82; max-width: 44ch; margin: 0; }

  /* ── 02 · C · THE QUESTIONS ────────────────────────────────────
     Every clause takes its own line, and the ones that ask take the
     serif. Movement 01 already uses Fraunces italic for the half of a
     sentence that turns something over rather than states it; a question
     is that same move, so it gets the same voice. Three questions were
     packed into a single line and read as one long sentence — they are
     three now, and each is legible as a question at a glance.

     Set at 19px, matching movement 01, which is the same kind of writing
     and was set larger than this section for no reason. */
  .steps { list-style: none; margin: 0; padding: 0; }
  .step {
    display: grid; grid-template-columns: 3rem minmax(0, 4fr) minmax(0, 5fr);
    column-gap: var(--gutter); align-items: baseline;
    padding: clamp(24px, 4vh, 46px) 0;
  }
  .step .draw { grid-column: 1 / -1; margin-bottom: clamp(24px, 4vh, 46px); }
  .step__n { color: var(--accent); font-size: var(--t-xs); }
  .step__title {
    font-family: var(--display); font-weight: 500;
    font-size: var(--tier-3); line-height: 1.08; letter-spacing: -0.032em;
    margin: 0; max-width: 11ch;
  }
  .step__lines { font-size: var(--tier-4); line-height: 1.66; max-width: 46ch; }
  .step__lines p { margin: 0 0 clamp(10px, 1.5vh, 15px); }
  .step__lines p:last-child { margin-bottom: 0; }
  .asks {
    font-family: var(--serif); font-style: italic; font-weight: 400;
    letter-spacing: -0.012em; font-size: 1.06em;
    padding-left: clamp(0px, 2vw, 28px);
  }
  /* ── the tone band ─────────────────────────────────────────────
     The margins cancel the page's own padding exactly, so this is the
     viewport's width and not a pixel more. */
  .band {
    margin: clamp(24px, 5vh, 64px) calc(var(--margin) * -1);
    padding: clamp(72px, 14vh, 180px) var(--margin);
    background: var(--ground-lift);
    border-top: 1px solid var(--rule-soft);
    border-bottom: 1px solid var(--rule-soft);
  }
  .band__q {
    font-size: var(--tier-0); line-height: 0.98; letter-spacing: -0.03em;
    color: var(--bone); margin: 0; max-width: 13ch;
    padding-left: clamp(0px, 16vw, 240px);
  }
  /* The caption was anchored by an accent em dash. It is anchored by an
     accent rule instead — same job, same colour, no dash. The indent moves
     to margin-left so padding-left can hold the rule off the text. */
  .band__cap {
    display: block; color: var(--dim); font-size: var(--t-xs);
    margin-top: var(--s-4);
    margin-left: clamp(0px, 16vw, 240px);
    padding-left: 12px;
    border-left: 1px solid var(--accent);
  }

  /* ── 03 · Movement's grid, as asked ────────────────────────────── */
  .cols { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(28px, 4vw, 72px); align-items: start; }
  .col__lab { color: var(--accent); font-size: var(--t-xs); padding-bottom: 12px; border-bottom: 1px solid var(--rule); margin: 0 0 var(--s-3); }
  .col ul { list-style: none; margin: 0; padding: 0; }
  .col li {
    display: flex; align-items: baseline; gap: 12px;
    /* 21px at 1440, up from a flat 18px. The floor stays at 18px rather
       than dropping to 1rem: a clamp that bottoms out at 16px would have
       made these SMALLER on a phone than they were before, which is not
       what "slightly bigger" means. */
    color: var(--bone-dim); font-size: clamp(1.125rem, 1.5vw, 1.3125rem); padding: 10px 0;
    border-bottom: 1px solid var(--rule-soft);
    transition: color var(--d-micro) var(--ease), padding-left var(--d-micro) var(--ease);
  }
  .col__n { color: transparent; font-size: var(--t-xs); transition: color var(--d-micro) var(--ease); }
  .col li:hover { color: var(--bone); padding-left: 8px; }
  .col li:hover .col__n { color: var(--accent); }
  .col li:last-child { border-bottom: 0; }

  /* ── 04 ────────────────────────────────────────────────────────── */
  .stats { display: flex; flex-wrap: wrap; gap: clamp(28px, 5vw, 88px); padding-bottom: clamp(48px, 9vh, 104px); }
  .stat { display: flex; flex-direction: column; gap: 10px; }
  .stat__figure {
    font-family: var(--display); font-weight: 500;
    font-size: clamp(1.75rem, 3.4vw, 2.875rem); letter-spacing: -0.04em; line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .stat__lab { color: var(--dim); font-size: var(--t-xs); }

  .works { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--rule); }
  .works li { position: relative; }
  .work {
    display: grid; grid-template-columns: minmax(0, 1fr) auto 2rem;
    align-items: baseline; gap: var(--s-3);
    padding: clamp(18px, 2.8vh, 30px) 0; border-bottom: 1px solid var(--rule-soft);
    color: var(--bone); transition: padding-left var(--d-micro) var(--ease);
  }
  .work__title { font-family: var(--display); font-weight: 500; font-size: var(--tier-3); letter-spacing: -0.03em; line-height: 1.1; }
  .work__role { color: var(--dim); font-size: var(--t-xs); text-align: right; }
  .work__arrow { color: var(--dim); text-align: right; transition: transform var(--d-micro) var(--ease), color var(--d-micro) var(--ease); }
  .works li:hover .work { padding-left: 12px; }
  .works li:hover .work__arrow { color: var(--accent); transform: translateX(0.3em); }

  .work__peek {
    position: absolute; top: var(--y, 50%); left: var(--x, 50%);
    width: 320px; margin: -110px 0 0 -160px;
    pointer-events: none; z-index: 3;
    opacity: 0; transform: scale(0.96);
    transition: opacity var(--d-micro) var(--ease), transform var(--d-micro) var(--ease);
  }
  .work__peek :global(img) { display: block; width: 100%; height: auto; }
  .works li.is-peek .work__peek { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: reduce) { .work__peek { display: none; } }

  /* ── 05 ────────────────────────────────────────────────────────── */
  .call { display: block; padding-top: clamp(40px, 7vh, 80px); margin-bottom: clamp(40px, 7vh, 76px); }
  .call__big {
    display: block; font-family: var(--display); font-weight: 500;
    font-size: var(--tier-0); line-height: 0.94; letter-spacing: -0.05em;
    color: var(--bone); max-width: 13ch;
    transition: color var(--d-micro) var(--ease);
  }
  .call:hover .call__big { color: var(--accent); }
  .call__tail { display: block; color: var(--dim); font-size: var(--t-xs); margin-top: var(--s-3); }

  .direct { list-style: none; margin: 0; padding: var(--s-4) 0 0; border-top: 1px solid var(--rule); display: flex; flex-wrap: wrap; gap: var(--s-3) var(--s-5); }
  .direct li { display: flex; align-items: baseline; gap: 10px; }
  .direct .mono { font-size: var(--t-xs); }
  .direct a { font-family: var(--display); font-weight: 500; font-size: var(--t-md); letter-spacing: -0.02em; color: var(--bone); transition: color var(--d-micro) var(--ease); }
  .direct a:hover { color: var(--accent); }

  @media (max-width: 900px) {
    .sec { grid-template-columns: 1fr; row-gap: var(--s-4); }
    /* Answering the by-name rules above at equal specificity — a bare class
       would lose, and `2 / -2` on a one-column grid conjures a phantom. */
    .sec > .spine, .sec > .stmt, .sec > .well, .sec > .steps { grid-column: 1 / -1; }
    .spine { flex-direction: row; align-items: baseline; justify-content: flex-start; gap: var(--s-3); }
    .spine__top { flex-direction: row; align-items: baseline; gap: var(--s-3); }
    .spine__t { writing-mode: horizontal-tb; transform: none; }
    .stmt { text-indent: 0; }
    .stmt--stack .stmt__b { padding-left: 0; }
    .stair { grid-template-columns: 1fr; }
    .stair__p { grid-column: 1 / -1; }
    .step { grid-template-columns: 2.5rem minmax(0, 1fr); row-gap: 12px; }
    .step__lines { grid-column: 2; }
    .asks { padding-left: 0; }
    .cols { grid-template-columns: 1fr; }
    .band__q { padding-left: 0; }
    .band__cap { margin-left: 0; }
  }
  @media (max-width: 640px) {
    .work { grid-template-columns: minmax(0, 1fr) 1.5rem; }
    .work__role { grid-column: 1; text-align: left; }
  }

  /* The band carries NO ledger, deliberately. It is the one place in the
     site where the ground changes, and it is left clean so the change of
     tone is the only thing happening there.

     The cost is stated rather than hidden: the ledger runs the height of
     the document everywhere else, and this is the one interval where it
     does not. The pointer's lit segment therefore fades out as it enters
     the band and returns below it. If that break ever reads as a fault
     rather than as a rest, the fix is a ledger on the band inset to
     `0 var(--margin)` and pulled out vertically by the band's own margin,
     `calc(clamp(24px, 5vh, 64px) * -1)`, which is what used to be here. */
  .band { position: relative; }
</style>
