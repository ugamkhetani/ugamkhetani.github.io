---
/**
 * XP8 · THE BATH — latent until it crosses the surface.
 *
 * THE IDEA: a photograph does not exist until it is developed. So the eight
 * frames arrive as NEGATIVES, and a single fixed line across the viewport —
 * the surface of the developer — converts them as they pass through it. The
 * waterline sweeps down each frame as you scroll, so you watch the positive
 * come up out of the negative exactly the way it does in a tray.
 *
 * THE LINE IS THE INTERFACE AND THERE IS NOTHING ELSE. No buttons on the
 * images, no captions over them, no hover. One rule across the screen, and
 * the position of each frame relative to it is the entire state of the
 * section. An interface made of a single horizontal line is about as
 * restrained as an interactive idea can get, which is what keeps it from
 * being a filter demo.
 *
 * WHY THE NEGATIVE IS NOT A TRICK HERE: this film is shot very dark. Inverted,
 * the shadow detail that the positive buries comes forward and the highlights
 * go to ink — so the negative genuinely shows you a different photograph
 * rather than the same one with its colours flipped. You see more of the set
 * this way, not less, which is why HOLD UNDER exists as a state you can stay
 * in rather than a transition you pass through.
 *
 * THREE STATES, ALL LEGITIMATE. LIVE is scroll-driven. UNDER holds everything
 * latent, which is the best way to read the set as negatives. FIXED holds
 * everything developed, which is the ordinary stills section — the
 * experiment's own control condition, one click away.
 *
 * IT IS POSITION, NOT ANIMATION. Nothing here is a transition or a keyframe:
 * every frame's state is a pure function of where it is on screen, so
 * scrolling back up un-develops it, which a tray would also do and a CSS
 * animation would not.
 */
import Base from '../../layouts/Base.astro';
import OpNav from '../../components/OpNav.astro';
import { Image, getImage } from 'astro:assets';
import { getCollection } from 'astro:content';
import { framesFor } from '../../lib/frames';
import { href } from '../../lib/href';

/* THE REAL WORK AND THE REAL STILLS. The collection is the same one
   /work/aasha renders from, so the frames, title, roles, statement and
   standfirst are the page's own, and the harness around the experiment is the
   work page's own type and rhythm. The ONLY variable between ab-xp1 and
   ab-xp8 is the section below the "03 · Stills" rule.

   THE PRODUCTION PAGE IS NOT TOUCHED. src/pages/work/[slug].astro is
   untouched by all eight, and `withoutPreview()` keeps these routes out of
   the built site. */
const works = await getCollection('works');
const work = works.find((w) => w.id === 'aasha')!;
const d = work.data;
const images = framesFor('aasha', d.frames);
const LEDE = (d.description.trim().match(/^[^.!?]+[.!?]/) ?? [d.description.trim()])[0];
const ROLES = d.role.split('·').map((r) => r.trim());
const nn = (i: number) => String(i + 1).padStart(2, '0');
/* `awards` is {text, star?}[], not a string — interpolating the array
   itself renders "[object Object]" in the colophon. */
const AWARDS = (d.awards ?? []).map((a: { text: string }) => a.text).join(' · ');

/* Optimised URLs for the drafts that need the frame inside a CSS property —
   a mask, a background, a band — where <Image> cannot reach. Astro emits
   these into the same /_astro/ directory as everything else. */
const WEB = await Promise.all(
  images.map((src) => getImage({ src, width: 1200, format: 'webp', quality: 78 })),
);

const DRAFTS: [string, string, string][] = [
  ['xp1', 'The score', 'The film’s light, measured and scrubbed'],
  ['xp2', 'The splice', 'You author the cut — 64 of them'],
  ['xp3', 'The sentence', 'The words are the apertures'],
  ['xp4', 'The field', 'A space larger than the window'],
  ['xp5', 'The persistence', 'It coheres only when you stop'],
  ['xp6', 'The attention', 'The band divides by how you looked'],
  ['xp7', 'The sort', 'Sequence against what the light implies'],
  ['xp8', 'The bath', 'Latent until it crosses the surface'],
];
const ME = 'xp8';
const MINE = DRAFTS.find(([id]) => id === ME)!;

---

<Base title={`${d.title} · ${MINE[1]} — stills ${ME.toUpperCase()}`} description={`An experimental direction for the stills section of the Aasha project page: ${MINE[2]}.`}>
  <OpNav variant="bracket" base={href()} />

  <nav class="sw" aria-label="Stills experiments">
    <span class="sw__id">{ME.toUpperCase()}</span>
    <span class="sw__nm">{MINE[1]}</span>
    <span class="sw__su">{MINE[2]}</span>
    <span class="sw__set">
      {DRAFTS.map(([id, name, sub]) => (
        <a class:list={['sw__i', { 'is-here': id === ME }]} href={href(`preview/ab-${id}`)}
          title={`${name} — ${sub}`} aria-current={id === ME ? 'page' : undefined}>{id.slice(2)}</a>
      ))}
      <a class="sw__prev" href={href('preview/ab-st1')} title="The first eight directions">ST1–8</a>
    </span>
  </nav>

  <article class="sc" style={`--ar:${d.ratio.replace(':', ' / ')}`}>
    <header class="hd">
      <p class="mono hd__over">{d.category} · {d.year}</p>
      <h1 class="hd__t">{d.title}</h1>
      <p class="mono hd__meta"><span class="hd__roles">{ROLES.map((r) => <span>{r}</span>)}</span></p>
    </header>

    {d.quote && (
      <section class="q" aria-label="Statement">
        <p class="q__t">{d.quote}</p>
      </section>
    )}

    <section class="blk body" aria-label="About">
      <p class="body__lede" style={`--n:${LEDE.length}`}>{LEDE}</p>
    </section>

    <!-- ══ 03 · STILLS — THE EXPERIMENT ══════════════════════════════ -->
    <section class="blk st" aria-label="Stills">
      <p class="mono st__lbl"><span>03</span><i aria-hidden="true"></i><span>Stills · {MINE[1]}</span></p>
      <div class="ba" data-ba>
        <div class="ba__ctl mono" role="group" aria-label="The bath">
          <button class="ba__s is-on" type="button" data-ba-s="live" aria-pressed="true">Live</button>
          <button class="ba__s" type="button" data-ba-s="under" aria-pressed="false">Hold under</button>
          <button class="ba__s" type="button" data-ba-s="fixed" aria-pressed="false">Fixed</button>
          <span class="ba__st" data-ba-st>the line develops them as they pass</span>
        </div>

        {images.map((img, i) => (
          <figure class="ba__f" data-ba-f={i} style="--cut:0px">
            <div class="ba__win">
              <Image class="ba__pos" src={img} alt={i === 0 ? d.alt : ''} aria-hidden={i === 0 ? undefined : 'true'}
                widths={[760, 1140, 1520]} sizes="(max-width: 900px) 94vw, 820px"
                loading={i < 3 ? 'eager' : 'lazy'} decoding="async" />
              <span class="ba__neg" style={`--src:url(${WEB[i].src})`} aria-hidden="true"></span>
            </div>
            <figcaption class="mono ba__cap">
              <b>{nn(i)}</b><i aria-hidden="true"></i><em data-ba-d={i}>latent</em>
            </figcaption>
          </figure>
        ))}

        <p class="mono hint">
          <em>Scroll · the surface converts them</em>
          <i aria-hidden="true"></i>
          <span><b data-ba-n>0</b> of {images.length} fixed</span>
        </p>
      </div>

      <div class="ba__line" data-ba-line aria-hidden="true">
        <span class="mono">Surface</span><i></i><span class="mono">Developer</span>
      </div>
    </section>

    <footer class="cl">
      <hr class="rule" />
      <p class="mono cl__p"><span>{MINE[0].toUpperCase()} · {MINE[1]}</span><i aria-hidden="true"></i><span>{AWARDS}</span></p>
    </footer>
  </article>
</Base>

<script>
  /* STATE IS A FUNCTION OF POSITION. No keyframes and no transitions on the
     conversion itself, so scrolling back up genuinely un-develops a frame. */
  const ba = document.querySelector('[data-ba]');
  if (ba) {
    const line = document.querySelector('[data-ba-line]');
    const figs = [...ba.querySelectorAll('[data-ba-f]')];
    const devs = [...ba.querySelectorAll('[data-ba-d]')];
    const nEl = ba.querySelector('[data-ba-n]');
    const btns = [...ba.querySelectorAll('[data-ba-s]')];
    const stEl = ba.querySelector('[data-ba-st]');
    const ST = {
      live: 'the line develops them as they pass',
      under: 'all eight held latent — read them as negatives',
      fixed: 'all eight developed — the ordinary section',
    };
    let mode = 'live', queued = false;

    const read = () => {
      queued = false;
      const surface = innerHeight * (innerWidth <= 620 ? 0.48 : 0.52);
      let fixedCount = 0;
      figs.forEach((f, i) => {
        const b = f.querySelector('.ba__win').getBoundingClientRect();
        let cut;
        if (mode === 'under') cut = 0;
        else if (mode === 'fixed') cut = b.height;
        else cut = Math.min(b.height, Math.max(0, surface - b.top));
        f.style.setProperty('--cut', `${cut.toFixed(1)}px`);
        /* The hairline only shows while the conversion is actually crossing
           this frame — not pinned to its top or bottom edge. */
        f.style.setProperty('--edge', mode === 'live' && cut > 0.5 && cut < b.height - 0.5 ? '1' : '0');
        const p = b.height ? cut / b.height : 0;
        if (p >= 0.999) fixedCount++;
        f.classList.toggle('is-fixed', p >= 0.999);
        if (devs[i]) devs[i].textContent = p <= 0.001 ? 'latent' : p >= 0.999 ? 'fixed' : `${Math.round(p * 100)}%`;
      });
      if (nEl) nEl.textContent = String(fixedCount);
    };
    const tick = () => { if (!queued) { queued = true; requestAnimationFrame(read); } };
    addEventListener('scroll', tick, { passive: true });
    addEventListener('resize', tick);

    const setMode = (m) => {
      mode = m;
      ba.classList.toggle('is-live', m === 'live');
      if (line) line.style.opacity = m === 'live' ? '1' : '0';
      btns.forEach((b) => {
        const on = b.dataset.baS === m;
        b.classList.toggle('is-on', on);
        b.setAttribute('aria-pressed', on ? 'true' : 'false');
      });
      if (stEl) stEl.textContent = ST[m];
      read();
    };
    btns.forEach((b) => b.addEventListener('click', () => setMode(b.dataset.baS)));

    setMode('live');
    /* A reader who asked for less motion gets the developed set outright,
       rather than a sweep they did not ask for. */
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) setMode('fixed');

    window.baRead = read;
    window.baMode = setMode;
    window.baState = () => figs.map((f) => f.style.getPropertyValue('--cut'));
  }
</script>

<style>
  /* ══ THE HARNESS ═══════════════════════════════════════════════════
     The work page's own type and rhythm, shared verbatim by all eight, so
     the only thing being judged below the rule is the stills section. */
  .sw {
    position: fixed; inset: 0 0 auto; z-index: 900;
    display: flex; align-items: baseline; gap: 12px;
    padding: 9px clamp(16px, 4vw, 40px);
    background: color-mix(in srgb, var(--ground) 86%, transparent);
    backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--rule);
    font-family: var(--mono); font-size: var(--t-micro);
    letter-spacing: 0.16em; text-transform: uppercase;
  }
  .sw__id { color: var(--accent); }
  .sw__nm { color: var(--bone); }
  .sw__su { color: var(--dim); margin-right: auto; }
  .sw__set { display: flex; gap: 1px; align-items: baseline; }
  .sw__i {
    color: var(--dim); text-decoration: none; padding: 3px 7px;
    border: 1px solid transparent; font-variant-numeric: tabular-nums;
  }
  .sw__i:hover { color: var(--bone); }
  .sw__i.is-here { color: var(--accent); border-color: var(--rule); }
  .sw__prev { color: color-mix(in srgb, var(--dim) 70%, var(--ground)); text-decoration: none; padding: 3px 0 3px 12px; margin-left: 6px; border-left: 1px solid var(--rule); }
  .sw__prev:hover { color: var(--bone-dim); }
  @media (max-width: 860px) { .sw__su { display: none; } .sw__nm { margin-right: auto; } }
  @media (max-width: 560px) { .sw__nm, .sw__prev { display: none; } }

  .sc { padding: clamp(84px, 13vh, 150px) var(--margin) 0; }
  .hd { text-align: center; margin-bottom: clamp(38px, 6.6vh, 80px); }
  .hd__over { font-size: var(--t-micro); letter-spacing: 0.18em; text-transform: uppercase; color: var(--muted); margin: 0 0 clamp(16px, 2.6vh, 30px); }
  .hd__t { margin: 0; font-family: var(--display); font-weight: 500; font-size: clamp(2.6rem, 7vw, 5.6rem); line-height: 0.94; letter-spacing: -0.04em; color: var(--bone); }
  .hd__meta { margin: clamp(14px, 2.2vh, 26px) 0 0; font-size: var(--t-micro); letter-spacing: 0.18em; text-transform: uppercase; color: var(--bone-dim); }
  .hd__roles { display: inline-flex; flex-wrap: wrap; justify-content: center; gap: 0 14px; }
  .hd__roles span + span::before { content: '·'; margin-right: 14px; color: var(--dim); }
  .q { max-width: 34ch; margin: 0 auto clamp(50px, 8vh, 110px); text-align: center; }
  .q__t { margin: 0; font-family: var(--serif); font-style: italic; font-weight: 300; font-size: clamp(1.25rem, 2.4vw, 1.9rem); line-height: 1.26; letter-spacing: -0.012em; color: var(--bone-dim); }
  .body { max-width: var(--measure); margin-inline: auto; }
  .body__lede { margin: 0 auto; max-width: clamp(20ch, calc(var(--n, 90) / 3 * 1ch), 44ch); font-family: var(--display); font-weight: 500; font-size: clamp(1.2rem, min(calc(2.35rem - (var(--n, 90) - 55) * 0.007rem), calc(1.05rem + 2.1vw)), 2.2rem); line-height: 1.12; letter-spacing: -0.025em; color: var(--bone); text-wrap: balance; }
  .blk { margin: 0 auto clamp(104px, 18vh, 240px); }

  .st { --w: var(--measure); }
  .st__lbl {
    display: flex; align-items: center; gap: 12px;
    width: var(--w); margin: 0 auto clamp(24px, 4vh, 50px);
    font-size: var(--t-micro); letter-spacing: 0.18em; text-transform: uppercase; color: var(--muted);
  }
  .st__lbl i { flex: 1; height: 1px; background: var(--rule); }

  /* The one piece of furniture every experiment shares: a line of mono that
     says what the thing in front of you responds to. An experimental
     interaction that nobody can find is a failed one. */
  .hint {
    display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap;
    width: var(--w); margin: 14px auto 0;
    font-size: var(--t-micro); letter-spacing: 0.16em; text-transform: uppercase; color: var(--dim);
  }
  .hint b { font-weight: 400; color: var(--accent); font-variant-numeric: tabular-nums; }
  .hint em { font-style: normal; color: var(--muted); }
  .hint i { flex: 1; min-width: 20px; height: 1px; background: var(--rule); transform: translateY(-3px); }

  .cl { max-width: var(--measure); margin: 0 auto; padding-bottom: clamp(48px, 9vh, 110px); }
  .rule { border: 0; border-top: 1px solid var(--rule); margin: 0 0 16px; }
  .cl__p { display: flex; align-items: baseline; gap: 14px; margin: 0; font-size: var(--t-micro); letter-spacing: 0.16em; text-transform: uppercase; color: var(--dim); }
  .cl__p i { flex: 1; height: 1px; background: var(--rule); transform: translateY(-3px); }
  .cl__p span:last-child { text-align: right; }
  @media (max-width: 620px) { .cl__p { flex-direction: column; gap: 6px; } .cl__p i { display: none; } .cl__p span:last-child { text-align: left; } }

  /* ── XP8 · THE BATH ────────────────────────────────────────── */
  .st { --w: min(calc(100vw - 2 * var(--margin)), 820px); }
  .ba { width: var(--w); margin-inline: auto; }
  .ba__f { margin: 0; }
  .ba__f + .ba__f { margin-top: clamp(60px, 10vh, 140px); }

  .ba__win { position: relative; display: block; aspect-ratio: var(--ar); overflow: hidden; background: var(--ground-lift); }
  .ba__pos, .ba__neg { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  .ba__pos { object-fit: cover; }
  /* THE LATENT COPY, clipped to whatever is still above the surface. --cut is
     the distance in px from the top of the frame down to the line, so the
     conversion sweeps rather than crossfades. */
  .ba__neg {
    background-image: var(--src); background-size: cover; background-position: 50% 50%;
    filter: invert(1) contrast(1.06);
    clip-path: inset(0 0 calc(100% - var(--cut, 0px)) 0);
  }
  /* A hairline on the conversion itself, so the waterline is visible on the
     picture as well as across the page. */
  .ba__win::after {
    content: ''; position: absolute; left: 0; right: 0; top: var(--cut, 0px); height: 1px;
    background: var(--accent); opacity: var(--edge, 0); pointer-events: none;
  }

  .ba__cap {
    display: flex; align-items: baseline; gap: 12px; margin-top: 10px;
    font-size: var(--t-micro); letter-spacing: 0.16em; text-transform: uppercase; color: var(--dim);
  }
  .ba__cap b { font-weight: 400; color: var(--bone-dim); font-variant-numeric: tabular-nums; }
  .ba__cap i { flex: 1; height: 1px; background: var(--rule); transform: translateY(-3px); }
  .ba__cap em { font-style: normal; }
  .ba__f.is-fixed .ba__cap em { color: var(--muted); }

  .ba__ctl { display: flex; flex-wrap: wrap; align-items: baseline; gap: 1px; margin-bottom: clamp(18px, 2.8vh, 30px); }
  .ba__s {
    border: 1px solid var(--rule); background: none; cursor: pointer; padding: 6px 13px;
    font: inherit; font-size: var(--t-micro); letter-spacing: 0.16em; text-transform: uppercase; color: var(--dim);
  }
  .ba__s:hover { color: var(--bone); }
  .ba__s:focus-visible { outline: 1px solid var(--accent); outline-offset: 2px; }
  .ba__s.is-on { color: var(--accent); border-color: var(--accent); }
  .ba__st { margin-left: 14px; font-size: var(--t-micro); letter-spacing: 0.16em; text-transform: uppercase; color: color-mix(in srgb, var(--dim) 70%, var(--ground)); }

  /* THE SURFACE. One line across the viewport, shown only while the section
     is in view and only in the state where it means anything. */
  .ba__line {
    position: fixed; left: 0; right: 0; top: 52vh; z-index: 3;
    display: flex; align-items: center; gap: 12px;
    padding: 0 var(--margin); pointer-events: none; opacity: 0;
  }
  .ba__line i { flex: 1; height: 1px; background: color-mix(in srgb, var(--accent) 62%, transparent); }
  .ba__line span {
    font-size: var(--t-micro); letter-spacing: 0.2em; text-transform: uppercase; color: var(--accent);
  }
  .ba__line span:last-child { color: color-mix(in srgb, var(--accent) 56%, var(--ground)); }
  .ba.is-live ~ .ba__line, body:has(.ba.is-live) .ba__line { opacity: 1; }
  @media (prefers-reduced-motion: no-preference) { .ba__line { transition: opacity 260ms linear; } }

  @media (max-width: 620px) { .ba__st { display: none; } .ba__line { top: 48vh; } }
</style>
