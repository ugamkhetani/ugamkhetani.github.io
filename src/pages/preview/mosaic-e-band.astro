---
/**
 * PREVIEW — MOSAIC E · "BAND".
 *
 * A RULE YOU CAN SEE, RATHER THAN A MEASUREMENT YOU HAVE TO TRUST. The centre
 * row reads left to right with ranks one to four, the row above takes five to
 * eight, the row below nine to twelve. The whole top of the list sits in one
 * band across the middle of the aperture, in order, and the bed reads as an
 * arrangement instead of a scatter.
 *
 * IT COSTS A LITTLE AGAINST D AND BUYS LEGIBILITY. Ranks 1 and 4 land in the
 * outer columns of the centre row, measured clear 0.29 rather than the 0.47 the
 * inner cells give — so second and third place are better seen than first and
 * fourth. That is the price of the rule being a rule. What it buys is a bed
 * whose logic survives contact with a redesign: move the panels, change the
 * aperture, and "the strongest band across the middle" still means something,
 * where a list of cell indices would have to be measured all over again.
 *
 * THE BED IS THE LIVE ONE, TO THE PIXEL. Six columns, thirty tiles, the same
 * gap, the same inset of -10%, the same brightness(0.30) saturate(0.7)
 * contrast(1.05), the same -8% drift on --prog and the same scale(1.06). Every
 * declaration below is copied from index.astro. Nothing about the geometry is
 * being proposed here — only which of the twelve works stands in which cell.
 *
 * THE EIGHTEEN CELLS THAT ARE NEVER SEEN are filled by repeating the ranking
 * from the top. Measured across the whole scroll, nothing outside the twelve
 * marked cells ever clears both the aperture and the text over it, so what
 * occupies them cannot be seen; repeating the favourites costs nothing and
 * keeps the grid full for the moments the aperture is widest.
 */
import Base from '../../layouts/Base.astro';
import Stage from '../../components/_pv-MosaicStage.astro';
import Tile from '../../components/_pv-MosaicTile.astro';
import { getCollection } from 'astro:content';
import { RANKED, PLACEMENTS, CLEAR_RANK, BEST_FRAME } from '../../lib/_pv-mosaic';

const works = await getCollection('works');
const bySlug = new Map(works.map((w) => [w.id, w]));

const ORDER = PLACEMENTS['band'];
const CLEAR = new Map(CLEAR_RANK.map((c) => [c.cell, c.clear]));

/* Thirty cells. The twelve that are ever clear take the ranking in this
   option's order; the other eighteen repeat from the top of the list. */
const TILES: { w: any; rank: number; cell: number; live: boolean; clear: number }[] =
  Array.from({ length: 30 });
ORDER.forEach((cell, i) => {
  TILES[cell] = { w: bySlug.get(RANKED[i])!, rank: i + 1, cell, live: true, clear: CLEAR.get(cell) ?? 0 };
});
let fill = 0;
for (let cell = 0; cell < 30; cell++) {
  if (TILES[cell]) continue;
  const r = fill++ % RANKED.length;
  TILES[cell] = { w: bySlug.get(RANKED[r])!, rank: r + 1, cell, live: false, clear: 0 };
}
---

<Base title="Mosaic E — Band" description="Preview only.">
  <Stage letter="E" name="Band" note="A rule you can see rather than a measurement you have to trust. The centre row reads left to right with ranks one to four, the row above takes five to eight, the row below nine to twelve. It costs a little — ranks 1 and 4 land in outer cells measured at 0.29 rather than 0.47 — and buys a logic that survives a redesign, where a list of cell indices would have to be measured again.">
    <div class="ms__ground" slot="bed" aria-hidden="true">
      <div class="ms__bed">
        {TILES.map((t) => (
          <span class="ms__tile" class:list={[{ 'is-dead': !t.live }]}>
            <Tile slug={t.w.id} frames={t.w.data.frames} alt="" pick={BEST_FRAME[t.w.id] ?? 1} />
            <span class="ms__mark mono" aria-hidden="true">
              <b>{t.live ? String(t.rank).padStart(2, '0') : '\u2014'}</b>
              {t.w.data.title}
              <i>{t.live ? `cell ${t.cell} · clear ${t.clear}` : `cell ${t.cell} · never seen`}</i>
            </span>
          </span>
        ))}
      </div>
    </div>
  </Stage>
</Base>

<style>
  /* ── index.astro's bed, copied declaration for declaration ─────── */
  .ms__ground { position: fixed; inset: 0; z-index: 0; pointer-events: none; overflow: hidden; }
  .ms__bed {
    position: absolute; inset: -10%;
    display: grid; grid-template-columns: repeat(6, minmax(0, 1fr));
    grid-auto-rows: minmax(0, 1fr); gap: clamp(5px, 0.8vw, 13px);
    filter: brightness(0.30) saturate(0.7) contrast(1.05);
    transform: translate3d(0, calc(var(--prog, 0) * -8%), 0) scale(1.06);
    will-change: transform;
  }
  .ms__tile { position: relative; display: block; overflow: hidden; min-height: 0; border-radius: clamp(6px, 0.7vw, 12px); }
  .ms__tile :global(img) { border-radius: inherit; }

  /* ── the cell map, off unless asked for ───────────────────────── */
  .ms__mark { display: none; }
  :global(.rg.map-on) .ms__bed { filter: brightness(0.62) saturate(0.7) contrast(1.05); }
  :global(.rg.map-on) .ms__tile { outline: 1px solid var(--rule-accent); outline-offset: -1px; }
  :global(.rg.map-on) .ms__tile.is-dead { outline-color: rgba(255, 255, 255, 0.1); }
  :global(.rg.map-on) .ms__mark {
    position: absolute; inset: 0; z-index: 2;
    display: grid; align-content: center; justify-items: center; gap: 3px;
    padding: 6px; text-align: center;
    font-size: 9px; letter-spacing: 0.08em; line-height: 1.25;
    color: var(--bone); background: rgba(6, 6, 5, 0.62);
  }
  :global(.rg.map-on) .ms__mark b { font-size: 15px; letter-spacing: 0; color: var(--accent); }
  :global(.rg.map-on) .ms__tile.is-dead .ms__mark { color: var(--dim); background: rgba(6, 6, 5, 0.85); }
  :global(.rg.map-on) .ms__tile.is-dead .ms__mark b { color: var(--dim); }
  :global(.rg.map-on) .ms__mark i { font-style: normal; font-size: 8px; color: var(--dim); }

  @media (max-width: 900px) {
    .ms__bed { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }
</style>
