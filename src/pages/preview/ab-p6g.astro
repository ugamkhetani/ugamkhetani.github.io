              <svg viewBox="0 0 400 400">
                <circle class="pv-lab" cx="200" cy="200" r="120" />
                <line class="pv-mark" x1="200" y1="96" x2="200" y2="200" />
                <circle class="pv-hole" cx="200" cy="200" r="9" />
              </svg>
              </span>
            </span>
          </span>
        </span>
        <div class="pv-panel pv-panel--end">
          <p class="pv-label"><span class="pv-n">05</span></p>
          <h3 class="pv-state pv-state--end">{stopOf(CLOSING.head)[0]}<span class="pv-stop">{stopOf(CLOSING.head)[1]}</span></h3>
          <p class="pv-lede pv-lede--end">{CLOSING.body}</p>
