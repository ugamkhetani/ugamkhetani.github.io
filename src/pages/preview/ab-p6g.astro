        </span>
        <div class="pv-panel">
          <p class="pv-label"><span class="pv-n">03</span></p>
          <h3 class="pv-state">
            {ACROSS.head.map((l) => <span class="pv-line">{stopOf(l)[0]}<span class="pv-stop">{stopOf(l)[1]}</span></span>)}
          </h3>
          <p class="pv-lede">{ACROSS.lede}</p>
