  }
  .open__h .line { display: block; }
  .serif { font-family: var(--serif); font-style: italic; font-weight: 400; letter-spacing: -0.015em; }
  /* Fraunces sets optically smaller than the grotesk at the same size. */
  .open__h .serif { font-size: 1.07em; letter-spacing: -0.02em; }
  .hot { color: var(--accent); }

  .open__foot {
    display: flex; flex-wrap: wrap; align-items: baseline;
    justify-content: space-between; gap: var(--s-3);
    margin-top: clamp(36px, 6vh, 72px);
    padding-top: 16px; border-top: 1px solid var(--rule);
  }
  .tags { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--s-3); }
  .tags li { font-size: var(--t-xs); color: var(--muted); }
  .tags li + li::before { content: '·'; color: var(--rule); margin-right: var(--s-3); }
  .tags--dim li { color: var(--dim); }
  .open__portrait { max-width: 340px; margin-top: var(--s-4); }
  .open__portrait img { display: block; width: 100%; height: auto; }

  .cue { display: block; color: var(--dim); font-size: var(--t-md); margin-top: clamp(24px, 4vh, 48px); }
  @media (prefers-reduced-motion: no-preference) {
    .cue { animation: cue-drift 2.4s var(--ease) infinite; }
  }
  @keyframes cue-drift { 0%, 100% { transform: translateY(0); opacity: 0.5; } 50% { transform: translateY(6px); opacity: 1; } }

  /* ── section grid ──────────────────────────────────────────────
     Placed child by child. A `> *` blanket compiles with the scoping
     attribute on both compounds and outranks a single scoped class,
     silently flattening every placement below it to full width. */
  .sec {
    position: relative;
    display: grid;
    grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
    column-gap: var(--gutter);
    padding-top: clamp(56px, 10vh, 130px);
    padding-bottom: clamp(56px, 10vh, 130px);
  }
  .sec--close { padding-bottom: 0; }
  .sec > .spine { grid-column: 1 / span 1; z-index: 1; }
  .sec > .stmt  { grid-column: 2 / -2; z-index: 1; }
  .sec > .well  { grid-column: 4 / -1; z-index: 1; }
  .sec > .steps { grid-column: 4 / -1; z-index: 1; }

  /* The spine holds its name at the head and its folio at the foot, the
     way a book page carries them. */
  .spine {
    align-self: stretch;
    display: flex; flex-direction: column; justify-content: space-between;
    align-items: flex-start; gap: var(--s-4);
  }
  .spine__top { display: flex; flex-direction: column; align-items: flex-start; gap: var(--s-3); }
  .spine__n { color: var(--accent); font-size: var(--t-xs); font-variant-numeric: tabular-nums; }
  .spine__folio { color: var(--dim); font-size: var(--t-xs); font-variant-numeric: tabular-nums; }
  /* vertical-rl reads top-to-bottom; the half turn sends it up the spine. */
  .spine__t {
    writing-mode: vertical-rl; transform: rotate(180deg);
    margin: 0; color: var(--bone); font-size: var(--t-xs); white-space: nowrap;
  }

  /* ── statements, with the first line hung ──────────────────────
     The outdent is smaller than the page margin at every width the
     clamp can reach, so the line can never leave the page. */
  .stmt {
    font-family: var(--display); font-weight: 500;
    font-size: var(--tier-2); line-height: 1.06; letter-spacing: -0.042em;
    margin: 0 0 clamp(40px, 8vh, 88px);
    text-indent: clamp(-84px, -5.4vw, 0px);
  }
  .stmt__a, .stmt__b { display: inline; }
  .stmt__b { letter-spacing: -0.02em; }
  .stmt--stack .stmt__a, .stmt--stack .stmt__b { display: block; }
  /* Only the first line hangs; the second returns to the measure, which
     is what makes the indent read as a hang rather than as a shift. */
  .stmt--stack .stmt__b { text-indent: 0; padding-left: clamp(0px, 5vw, 80px); }
  .stmt--serif { letter-spacing: -0.018em; line-height: 1.1; max-width: 20ch; }

  .lede { font-size: var(--tier-4); line-height: 1.72; max-width: 46ch; margin: 0 0 clamp(44px, 8vh, 88px); }
  .well { display: block; }
  /* ── the stair ─────────────────────────────────────────────────
     Each paragraph starts one column further right than the last. The
     well spans section columns 4–12, so its own column 1+i lands on
     section column 4+i — which is exactly where a ledger hairline is
     drawn. Measured at 1440: the five paragraphs begin at 409, 516,
     624, 732 and 839, every one of them a rule position, off by zero.
     That is the whole point of it. The prose steps down the page ON the
     structure, which is what turns the ledger from something drawn over
     the page into something the page is built on.

     The measure is held constant at 44ch and only the start moves, so
     the fifth paragraph reads no harder than the first. */
  .stair {
    display: grid;
    grid-template-columns: repeat(9, minmax(0, 1fr));
    column-gap: var(--gutter);
    row-gap: clamp(20px, 3.4vh, 38px);
  }
  .stair__p { grid-column: calc(1 + var(--s)) / -1; }
  .stair__p p { font-size: var(--tier-4); line-height: 1.82; max-width: 44ch; margin: 0; }

  /* ── 02 · C · THE QUESTIONS ────────────────────────────────────
     Every clause takes its own line, and the ones that ask take the
     serif. Movement 01 already uses Fraunces italic for the half of a
     sentence that turns something over rather than states it; a question
     is that same move, so it gets the same voice. Three questions were
     packed into a single line and read as one long sentence — they are
     three now, and each is legible as a question at a glance.

     Set at 19px, matching movement 01, which is the same kind of writing
     and was set larger than this section for no reason. */
  .steps { list-style: none; margin: 0; padding: 0; }
  .step {
    display: grid; grid-template-columns: 3rem minmax(0, 4fr) minmax(0, 5fr);
    column-gap: var(--gutter); align-items: baseline;
    padding: clamp(24px, 4vh, 46px) 0;
  }
  .step .draw { grid-column: 1 / -1; margin-bottom: clamp(24px, 4vh, 46px); }
  .step__n { color: var(--accent); font-size: var(--t-xs); }
  .step__title {
    font-family: var(--display); font-weight: 500;
    font-size: var(--tier-3); line-height: 1.08; letter-spacing: -0.032em;
    margin: 0; max-width: 11ch;
  }
  .step__lines { font-size: var(--tier-4); line-height: 1.66; max-width: 46ch; }
  .step__lines p { margin: 0 0 clamp(10px, 1.5vh, 15px); }
  .step__lines p:last-child { margin-bottom: 0; }
  .asks {
    font-family: var(--serif); font-style: italic; font-weight: 400;
    letter-spacing: -0.012em; font-size: 1.06em;
    padding-left: clamp(0px, 2vw, 28px);
  }
  /* ── the tone band ─────────────────────────────────────────────
     The margins cancel the page's own padding exactly, so this is the
     viewport's width and not a pixel more. */
  .band {
    margin: clamp(24px, 5vh, 64px) calc(var(--margin) * -1);
    padding: clamp(72px, 14vh, 180px) var(--margin);
    background: var(--ground-lift);
    border-top: 1px solid var(--rule-soft);
    border-bottom: 1px solid var(--rule-soft);
  }
  .band__q {
    font-size: var(--tier-0); line-height: 0.98; letter-spacing: -0.03em;
    color: var(--bone); margin: 0; max-width: 13ch;
    padding-left: clamp(0px, 16vw, 240px);
  }
  /* The caption was anchored by an accent em dash. It is anchored by an
     accent rule instead — same job, same colour, no dash. The indent moves
     to margin-left so padding-left can hold the rule off the text. */
  .band__cap {
    display: block; color: var(--dim); font-size: var(--t-xs);
    margin-top: var(--s-4);
    margin-left: clamp(0px, 16vw, 240px);
    padding-left: 12px;
    border-left: 1px solid var(--accent);
  }

  /* ── 03 · Movement's grid, as asked ────────────────────────────── */
  .cols { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(28px, 4vw, 72px); align-items: start; }
  .col__lab { color: var(--accent); font-size: var(--t-xs); padding-bottom: 12px; border-bottom: 1px solid var(--rule); margin: 0 0 var(--s-3); }
  .col ul { list-style: none; margin: 0; padding: 0; }
  .col li {
    display: flex; align-items: baseline; gap: 12px;
    /* 21px at 1440, up from a flat 18px. The floor stays at 18px rather
       than dropping to 1rem: a clamp that bottoms out at 16px would have
       made these SMALLER on a phone than they were before, which is not
       what "slightly bigger" means. */
    color: var(--bone-dim); font-size: clamp(1.125rem, 1.5vw, 1.3125rem); padding: 10px 0;
    border-bottom: 1px solid var(--rule-soft);
    transition: color var(--d-micro) var(--ease), padding-left var(--d-micro) var(--ease);
  }
  .col__n { color: transparent; font-size: var(--t-xs); transition: color var(--d-micro) var(--ease); }
  .col li:hover { color: var(--bone); padding-left: 8px; }
  .col li:hover .col__n { color: var(--accent); }
  .col li:last-child { border-bottom: 0; }

  /* ── 04 ────────────────────────────────────────────────────────── */
  .stats { display: flex; flex-wrap: wrap; gap: clamp(28px, 5vw, 88px); padding-bottom: clamp(48px, 9vh, 104px); }
  .stat { display: flex; flex-direction: column; gap: 10px; }
  .stat__figure {
    font-family: var(--display); font-weight: 500;
    font-size: clamp(1.75rem, 3.4vw, 2.875rem); letter-spacing: -0.04em; line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .stat__lab { color: var(--dim); font-size: var(--t-xs); }

  .works { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--rule); }
  .works li { position: relative; }
  .work {
    display: grid; grid-template-columns: minmax(0, 1fr) auto 2rem;
    align-items: baseline; gap: var(--s-3);
    padding: clamp(18px, 2.8vh, 30px) 0; border-bottom: 1px solid var(--rule-soft);
    color: var(--bone); transition: padding-left var(--d-micro) var(--ease);
  }
  .work__title { font-family: var(--display); font-weight: 500; font-size: var(--tier-3); letter-spacing: -0.03em; line-height: 1.1; }
  .work__role { color: var(--dim); font-size: var(--t-xs); text-align: right; }
  .work__arrow { color: var(--dim); text-align: right; transition: transform var(--d-micro) var(--ease), color var(--d-micro) var(--ease); }
  .works li:hover .work { padding-left: 12px; }
  .works li:hover .work__arrow { color: var(--accent); transform: translateX(0.3em); }

  .work__peek {
    position: absolute; top: var(--y, 50%); left: var(--x, 50%);
    width: 320px; margin: -110px 0 0 -160px;
    pointer-events: none; z-index: 3;
    opacity: 0; transform: scale(0.96);
    transition: opacity var(--d-micro) var(--ease), transform var(--d-micro) var(--ease);
  }
  .work__peek :global(img) { display: block; width: 100%; height: auto; }
  .works li.is-peek .work__peek { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: reduce) { .work__peek { display: none; } }

  /* ── 05 ────────────────────────────────────────────────────────── */
  .call { display: block; padding-top: clamp(40px, 7vh, 80px); margin-bottom: clamp(40px, 7vh, 76px); }
  .call__big {
    display: block; font-family: var(--display); font-weight: 500;
    font-size: var(--tier-0); line-height: 0.94; letter-spacing: -0.05em;
    color: var(--bone); max-width: 13ch;
    transition: color var(--d-micro) var(--ease);
  }
  .call:hover .call__big { color: var(--accent); }
  .call__tail { display: block; color: var(--dim); font-size: var(--t-xs); margin-top: var(--s-3); }

  .direct { list-style: none; margin: 0; padding: var(--s-4) 0 0; border-top: 1px solid var(--rule); display: flex; flex-wrap: wrap; gap: var(--s-3) var(--s-5); }
  .direct li { display: flex; align-items: baseline; gap: 10px; }
  .direct .mono { font-size: var(--t-xs); }
  .direct a { font-family: var(--display); font-weight: 500; font-size: var(--t-md); letter-spacing: -0.02em; color: var(--bone); transition: color var(--d-micro) var(--ease); }
  .direct a:hover { color: var(--accent); }

  @media (max-width: 900px) {
    .sec { grid-template-columns: 1fr; row-gap: var(--s-4); }
    /* Answering the by-name rules above at equal specificity — a bare class
       would lose, and `2 / -2` on a one-column grid conjures a phantom. */
    .sec > .spine, .sec > .stmt, .sec > .well, .sec > .steps { grid-column: 1 / -1; }
    .spine { flex-direction: row; align-items: baseline; justify-content: flex-start; gap: var(--s-3); }
    .spine__top { flex-direction: row; align-items: baseline; gap: var(--s-3); }
    .spine__t { writing-mode: horizontal-tb; transform: none; }
    .stmt { text-indent: 0; }
    .stmt--stack .stmt__b { padding-left: 0; }
    .stair { grid-template-columns: 1fr; }
    .stair__p { grid-column: 1 / -1; }
    .step { grid-template-columns: 2.5rem minmax(0, 1fr); row-gap: 12px; }
    .step__lines { grid-column: 2; }
    .asks { padding-left: 0; }
    .cols { grid-template-columns: 1fr; }
    .band__q { padding-left: 0; }
    .band__cap { margin-left: 0; }
  }
  @media (max-width: 640px) {
    .work { grid-template-columns: minmax(0, 1fr) 1.5rem; }
    .work__role { grid-column: 1; text-align: left; }
  }

  /* The band carries NO ledger, deliberately. It is the one place in the
     site where the ground changes, and it is left clean so the change of
     tone is the only thing happening there.

     The cost is stated rather than hidden: the ledger runs the height of
     the document everywhere else, and this is the one interval where it
     does not. The pointer's lit segment therefore fades out as it enters
     the band and returns below it. If that break ever reads as a fault
     rather than as a rest, the fix is a ledger on the band inset to
     `0 var(--margin)` and pulled out vertically by the band's own margin,
     `calc(clamp(24px, 5vh, 64px) * -1)`, which is what used to be here. */
  .band { position: relative; }

  /* ══ THE OPENING ══════════════════════════════════════════════ */
  .ov {
    min-height: 100vh;
    display: flex; flex-direction: column;
    padding-block: clamp(120px, 17vh, 190px) clamp(40px, 7vh, 80px);
    position: relative;
  }
  .ov__mast { display: block; }
  .ov__word {
    display: block;
    font-family: var(--display); font-weight: 500;
    letter-spacing: -0.045em; line-height: 0.86;
    color: var(--bone); text-transform: uppercase;
  }
  .ov__roles { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; }
  .ov__roles li {
    font-size: var(--t-sm); letter-spacing: 0.2em;
    text-transform: uppercase; color: var(--bone-dim);
  }
  .ov__stmt {
    font-family: var(--display); font-weight: 500;
    letter-spacing: var(--track-tight); line-height: 1.02; color: var(--bone-dim);
  }
  .ov__stmt .hot { color: var(--accent); }
  .ov__place { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 4px 22px; }
  .ov__place li { font-size: var(--t-xs); letter-spacing: 0.08em; color: var(--dim); }
  .ov__cue { font-size: var(--t-micro); letter-spacing: var(--track-mono); color: var(--dim); }

  /* ── CORNER LABELS ────────────────────────────────────────────
     The small print is pinned to the corners of the opening block and the
     middle is left to the name. Nothing is set between the two scales, which
     is what makes the jump from 12px to 280px read as deliberate rather than
     as a heading that got out of hand. */
  .ov__corner { position: absolute; z-index: 2; }
  .ov__corner--tl { top: clamp(110px, 15vh, 165px); left: 0; }
  .ov__corner--tr { top: clamp(110px, 15vh, 165px); right: 0; text-align: right; }
  .ov__corner--bl { bottom: clamp(34px, 6vh, 66px); left: 0; }
  .ov__corner--br { bottom: clamp(34px, 6vh, 66px); right: 0; text-align: right; }
  /* The left corners are stated explicitly because a centred opening sets
     text-align on the whole block, and the corner labels inherited it — the
     roles came out ragged, each line centred on the one above instead of
     stacking off a shared left edge. */
  .ov__corner--tl, .ov__corner--bl { text-align: left; }
  .ov__corner p {
    font-size: var(--t-micro); letter-spacing: 0.16em;
    text-transform: uppercase; color: var(--dim); margin: 0;
  }
  .ov__range { color: var(--accent); margin-top: 3px !important; }
  .ov__corner--tr .ov__place { flex-direction: column; align-items: flex-end; gap: 3px; }
  .ov__corner--tl .ov__roles { flex-direction: column; gap: 3px; }

  /* ══ RUNNING HEAD ═════════════════════════════════════════════ */
  .rh {
    position: fixed; z-index: 100; left: var(--margin); bottom: 24px;
    display: flex; align-items: baseline; gap: 10px;
    pointer-events: none; font-variant-numeric: tabular-nums;
  }
  .rh__name { font-size: var(--t-micro); letter-spacing: 0.18em; text-transform: uppercase; color: var(--bone-dim); }
  .rh__sep { font-size: var(--t-micro); color: var(--dim); }
  .rh__mv, .rh__folio {
    font-size: var(--t-micro); letter-spacing: 0.14em; color: var(--dim);
    transition: opacity 320ms var(--ease);
  }
  .rh__folio { color: var(--accent); }
  .rh.is-turning .rh__mv, .rh.is-turning .rh__folio { opacity: 0; }
  @media (max-width: 900px) { .rh { display: none; } }

  /* ══ 01 · THE WORKS ═══════════════════════════════════════════ */
  .sec--works { position: relative; margin-inline: calc(var(--margin) * -1); padding-block: 0; }
  .sec--works.is-live { height: calc(var(--count) * 62vh + 100vh); }
  .is-live .wk { height: 100%; }
  .wk__pin {
    position: sticky; top: 0; height: 100vh; overflow: hidden;
    -webkit-mask-image: linear-gradient(to bottom, transparent 0, #000 9%, #000 91%, transparent 100%);
    mask-image: linear-gradient(to bottom, transparent 0, #000 9%, #000 91%, transparent 100%);
  }
  .wk__scene { position: relative; height: 100%; perspective: 1250px; perspective-origin: 50% 50%; }

  .wk__world { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(20px, 3vw, 48px); margin-inline: var(--margin); padding-block: clamp(60px, 12vh, 140px); }
  .is-live .wk__world {
    display: block; position: absolute; top: 50%; left: 50%;
    width: 0; height: 0; margin: 0; padding: 0; transform-style: preserve-3d;
  }
  /* Scale, then position, then centre. The depth is a SCALE rather than a
     translateZ so each work's rendered height is known before it is placed —
     which is what makes a constant edge-to-edge gap possible at all. The
     -50% pair resolves against the unscaled box and is applied last, so the
     card's centre lands on --ty whatever the scale is. */
  /* ── THE SWEEP'S CARDS ────────────────────────────────────────────
     One common height for every work, so the width is what carries the
     aspect ratio and what the edge-to-edge placement stacks. Travel is on X
     only; opacity comes off the same depth the scale does. */
  .is-live .wcard {
    position: absolute; left: 50%; top: 50%;
    /* ONE COMMON HEIGHT, TIMES THE WORK'S OWN SCALE. It was a flat
       min(40vh, 26vw) for every card, which made a work's AREA proportional to
       its ratio and left the four upright works the smallest things in the
       catalogue — a 9:16 covered 32% of what a 16:9 did, which is a hierarchy
       saying the format a piece was shot in decides its importance.

       --card-k comes from the ratio, not from a list of slugs, so it reaches
       anything narrower than a square and is exactly 1 for everything else. A
       fifth upright work needs no edit and no work is named. See cards.ts.

       The placement script needed no change: it measures offsetWidth per card
       and re-measures on resize, load and fonts.ready. */
    height: calc(min(40vh, 26vw) * var(--card-k, 1));
    width: calc(min(40vh, 26vw) * var(--card-k, 1) * var(--arn, 1.7778));
    transform: translate(-50%, -50%) translateX(var(--tx, 0px)) scale(var(--s, 1));
    opacity: var(--op, 1);
    filter: none;
    will-change: transform, opacity;
  }

  /* ── THE READOUT: caption, ruler, date ────────────────────────────
     One tick per work rather than the reference's dense month ruler — its
     ruler is a calendar and its caption a month; ours is a catalogue, so the
     ticks are the sixteen works and the figure under the playhead is the real
     year of the work you are on. */
  .rl {
    position: absolute; left: 50%; transform: translateX(-50%);
    /* CLEARED OF THE MAT, BY THE MAT'S OWN NUMBER. The aperture's window is
       inset 11vh + (1 - lit) x 15vh top and bottom; at a flat 43px the
       readout's date sat 36px BEHIND the mat's bottom edge and could not be
       read at all. Deriving the offset from the same expression the mat uses
       means the two cannot drift apart when the window breathes. */
    bottom: calc(11vh + (1 - var(--lit, 1)) * 15vh + clamp(14px, 2.4vh, 30px));
    z-index: 5;
    /* A FIXED WIDTH, because the block shrink-wraps to its widest child — the
       caption — and the tick row is centred inside it. Left to shrink-wrap,
       the ruler slid sideways every time the title length changed: measured,
       the playhead ran 61, 46.5, 32, 55.5, 69, 72.5, 127px down a scroll that
       should have moved it steadily one way. The ruler is a fixed instrument;
       it cannot be re-scaled by the name of the thing it is measuring. */
    width: min(720px, 72vw);
    text-align: center; pointer-events: none;
  }
  .rl__cap { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .rl__cap, .rl__date {
    margin: 0; font-family: var(--display); font-weight: 500;
    font-size: var(--t-sm); letter-spacing: 0.02em; line-height: 1.06;
    text-transform: uppercase;
  }
  .rl__cap { color: var(--bone); }
  .rl__date { color: var(--dim); }
  @keyframes rl-in { from { opacity: 0 } to { opacity: 1 } }
  .rl.is-turning .rl__cap, .rl.is-turning .rl__date {
    animation: rl-in 190ms ease both;
  }
  @media (prefers-reduced-motion: reduce) {
    .rl.is-turning .rl__cap, .rl.is-turning .rl__date { animation: none; }
  }
  /* ══ THE SCALE IS AN ARC, AND IT TURNS ══════════════════════════
     Promoted from preview draft rng-c "Horizon", chosen from twenty-four
     readout designs. The flat sixteen-tick row is now a shallow curve with
     its centre 340px ABOVE the strip, so the scale bows downward and the
     marks hang from it; the index mark stays fixed at the top while the
     arc turns beneath it, the way a lens barrel moves under its index.

     THE CENTRE IS ABOVE, NOT BELOW, AND THAT IS THE DESIGN. A concave arc
     is a dial you are turning; a convex one is a horizon you are standing
     over, and the wedge of space it opens beneath its middle is exactly
     the shape a line of type wants to sit in — which is where the work's
     name now goes.

     340px AND 54 DEGREES. A convex arc shows its curvature far more
     readily than a concave one, because the marks fan outward rather than
     inward. At the concave radius the outermost marks lie down and the row
     stops reading as a comb.

     THE MASK IS THE HORIZON. Both ends going to nothing is what stops the
     curve reading as an arc with two ends and starts it reading as a
     surface continuing past the frame. It is one declaration and the whole
     illusion rests on it.

     IT TURNS ON A CONTINUOUS NUMBER. --ring is the same phase the conveyor
     itself derives — see initHorizon below — so the ring is wherever the
     scroll is rather than clicking between sixteen resting positions. The
     first version of this draft used the integer index and a 520ms
     transition to hide the steps; measured across the section, that gives
     16 positions against this one's 41 of 41 samples distinct.

     THERE IS NO TRANSITION ON THE ROW, deliberately. With a per-frame
     input a transition is latency rather than smoothing — the ring would
     always be chasing a value it had already been given. The lit mark
     keeps its 220ms fade, because THAT is a discrete change. */
  .rl__ruler {
    position: relative; height: 42px;
    margin: clamp(12px, 2vh, 18px) auto 0;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 19%, #000 81%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 19%, #000 81%, transparent);
  }
  .rl__ticks {
    display: block; height: 100%;
    transform: rotate(calc((7.5 - var(--ring, 0)) * 3.6deg));
    transform-origin: 50% -340px;
    will-change: transform;
  }
  /* Absolutely positioned, all sixteen stacked on the centre line and then
     fanned out by the nth-child rotations below — so the spacing is angular,
     not metric, and the row's own rotation carries every mark with it. */
  .rl__t {
    position: absolute; left: 50%; top: 4px;
    width: 1px; height: 11px; background: var(--dim);
    transform-origin: 50% -344px;
    transition: height 220ms var(--ease), background-color 220ms var(--ease);
  }
  .rl__t.is-on { height: 18px; background: var(--bone); }
  .rl__t:nth-child(1) { transform: translateX(-50%) rotate(-27.00deg); }
  .rl__t:nth-child(2) { transform: translateX(-50%) rotate(-23.40deg); }
  .rl__t:nth-child(3) { transform: translateX(-50%) rotate(-19.80deg); }
  .rl__t:nth-child(4) { transform: translateX(-50%) rotate(-16.20deg); }
  .rl__t:nth-child(5) { transform: translateX(-50%) rotate(-12.60deg); }
  .rl__t:nth-child(6) { transform: translateX(-50%) rotate(-9.00deg); }
  .rl__t:nth-child(7) { transform: translateX(-50%) rotate(-5.40deg); }
  .rl__t:nth-child(8) { transform: translateX(-50%) rotate(-1.80deg); }
  .rl__t:nth-child(9) { transform: translateX(-50%) rotate(1.80deg); }
  .rl__t:nth-child(10) { transform: translateX(-50%) rotate(5.40deg); }
  .rl__t:nth-child(11) { transform: translateX(-50%) rotate(9.00deg); }
  .rl__t:nth-child(12) { transform: translateX(-50%) rotate(12.60deg); }
  .rl__t:nth-child(13) { transform: translateX(-50%) rotate(16.20deg); }
  .rl__t:nth-child(14) { transform: translateX(-50%) rotate(19.80deg); }
  .rl__t:nth-child(15) { transform: translateX(-50%) rotate(23.40deg); }
  .rl__t:nth-child(16) { transform: translateX(-50%) rotate(27.00deg); }
  .rl__head {
    position: absolute; left: 50%; top: 0; bottom: auto;
    width: 1px; height: 24px; background: var(--bone);
    transform: translateX(-50%); z-index: 2;
  }
  /* Rounded again: 5.5% of the card's width, the radius measured off the
     reference. A flat 4px made the pictures read as browser windows. */
  .is-live .wcard :global(.st__win) {
    border-radius: 5.5%;
    box-shadow: 0 40px 90px rgba(0, 0, 0, 0.6);
  }


  /* ══ RHYTHM ═══════════════════════════════════════════════════ */
  .rg .sec { padding-block: clamp(90px, 17vh, 210px); }
  .sec--bare { position: relative; }
  .sec > .enq { grid-column: 1 / -1; z-index: 1; margin-top: clamp(50px, 10vh, 120px); }
  .enq :global(.ct__page) { padding-top: 0; }

  @media (max-width: 900px) {
    .wk__pin { position: static; height: auto; -webkit-mask-image: none; mask-image: none; }
    .wk__world { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .ov__corner { position: static; text-align: left !important; margin-bottom: 18px; }
  }

  /* ── TWO IDEAS, ONE PAGE ─────────────────────────────────────────
     XV Mosaic put the catalogue behind the type. V Corners left the middle
     empty and labelled the four corners, so the frame was drawn before the
     name was read. Put together they answer each other: the mosaic wants
     something to hold it, and the corner frame wants something inside it.

     ONE BED, FIXED BEHIND THE WHOLE DOCUMENT, and a corner-labelled frame on
     every movement with the middle kept for the type. Centre layout
     throughout — every title, every statement, every frame is on the one axis,
     from the opening to the enquiry.

     READABILITY BY ARITHMETIC. The bed is capped at 0.30 brightness, so the
     brightest pixel a photograph can put on screen is #4C4C4C and bone on it
     is 8.4:1 — above AA at any size. Running text then sits on solid ground,
     which takes it to 19:1. Nothing depends on a picture happening to be dark
     in the right place. */
  .rg { position: relative; }
  .ms__ground { position: fixed; inset: 0; z-index: 0; pointer-events: none; overflow: hidden; }
  .ms__bed {
    position: absolute; inset: -10%;
    display: grid; grid-template-columns: repeat(6, minmax(0, 1fr));
    grid-auto-rows: minmax(0, 1fr); gap: clamp(5px, 0.8vw, 13px);
    transform: translate3d(0, calc(var(--prog, 0) * -8%), 0) scale(1.06);
    will-change: transform;
  }
  /* THE GRADE IS ON THE TILE, NOT ON THE BED. It sat on .ms__bed until one
     frame needed a different contrast — see BED_GRADE in src/lib/bed.ts, where
     the reasoning and the measurements are. The tiles do not overlap and the
     filter is per-pixel, so thirty filtered tiles paint identically to one
     filtered grid; what it buys is a tile being able to name its own value.

     BRIGHTNESS IS NOT A VARIABLE HERE, DELIBERATELY. The 0.30 cap is what the
     readability arithmetic above rests on — it is the reason the brightest
     pixel a photograph can put on screen is #4C4C4C — so it is written as a
     constant that no tile can reach. Only the contrast boost is overridable. */
  .ms__tile {
    display: block; overflow: hidden; min-height: 0;
    border-radius: clamp(6px, 0.7vw, 12px);
    filter: brightness(0.30) saturate(0.7) contrast(var(--bed-k, 1.05));
  }
  /* Reaching past Still's own `transform: scale(1.001)` on the image, which is
     (0,2,1); naming .frame__layer as well makes this (0,3,1) so it wins without
     !important — including over Still's reduced-motion reset, which is also
     (0,2,1). The bed is pointer-events: none, so Still's hover scale, which is
     higher again, can never fire here. */
  .ms__tile--crop :global(.frame__layer img) {
    transform: translateY(var(--crop-y, 0)) scale(var(--crop-s, 1));
  }
  .ms__tile :global(.st), .ms__tile :global(.st__win) { border-radius: inherit; height: 100%; }

  .ov, .mvt { position: relative; z-index: 2; background: transparent; }
  .mvt {
    margin-inline: calc(var(--margin) * -1);
    padding-inline: var(--margin);
    padding-block: clamp(70px, 12vh, 156px);
    text-align: center;
  }
  .ov--cm { text-align: center; justify-content: center; }
  /* The conveyor IS the catalogue; it must not have the catalogue behind it. */
  .mvt.sec--works { padding-block: 0; padding-inline: 0; background: var(--ground); }

  /* ── THE FRAME ────────────────────────────────────────────────────
     Four labels, the middle left alone. */
  .fr { position: relative; padding: clamp(30px, 5vh, 66px) clamp(26px, 4vw, 72px); }
  .fr--hero { padding-block: clamp(46px, 8vh, 104px); }
  /* THE CORNER LABELS SIT OVER THE BED, so --dim cannot be used for them.
     #858585 against the brightest ground a photograph can produce (#4C4C4C)
     is 2.4:1 — nowhere near AA, and these are 10px. At --bone-dim the same
     worst case is 5.9:1, which clears AA for small text, and the shadow gives
     the letterforms an edge to sit on over a busy tile. */
  .cn {
    position: absolute; margin: 0; z-index: 3;
    font-size: var(--t-micro); letter-spacing: 0.16em;
    text-transform: uppercase; color: var(--bone-dim); line-height: 1.55;
    text-shadow: 0 1px 3px var(--ground), 0 0 14px rgba(10, 9, 8, 0.95);
  }
  .cn--tl { top: 0; left: 0; text-align: left; }
  .cn--tr { top: 0; right: 0; text-align: right; }
  .cn--bl { bottom: 0; left: 0; text-align: left; }
  .cn--br { bottom: 0; right: 0; text-align: right; }
  .cn--tl { color: var(--bone); }
  .fr--over { position: absolute; z-index: 6; top: clamp(66px, 10vh, 110px); left: var(--margin); right: var(--margin); }

  .fr__mid { position: relative; z-index: 2; }
  .fr__t {
    margin: 0; font-family: var(--display); font-weight: 500;
    font-size: clamp(1.5rem, min(6vw, 8vh), 4.2rem);
    line-height: 0.96; letter-spacing: -0.045em;
    text-transform: uppercase; color: var(--bone);
  }
  .fr__name {
    margin: 0; font-family: var(--display); font-weight: 500;
    font-size: clamp(2rem, min(11vw, 15vh), 8.5rem);
    line-height: 0.86; letter-spacing: -0.055em;
    text-transform: uppercase; color: var(--bone);
  }
  .fr__w { display: block; }
  .fr__cap {
    margin: clamp(14px, 2.4vh, 32px) auto 0; max-width: 28ch;
    font-family: var(--display); font-weight: 500;
    font-size: clamp(1rem, min(3.2vw, 4.4vh), 2.4rem);
    line-height: 1.1; letter-spacing: var(--track-tight);
    text-transform: uppercase; color: var(--bone-dim);
  }
  .fr__cap .line { display: block; }

  /* ── BODY: CENTRED, ON SOLID GROUND ───────────────────────────────
     Lists set left inside centred columns, because a ragged-right list read as
     centred is not readable. That is the one exception on the page. */
  .ms__panel {
    margin: clamp(24px, 4.4vh, 58px) auto 0; max-width: 78ch;
    padding: clamp(22px, 3.6vh, 46px) clamp(20px, 3vw, 44px);
    background: var(--ground);
    border: 1px solid var(--rule-soft);
    border-radius: clamp(10px, 1.2vw, 20px);
  }
  .s__stmt { margin: 0 auto; max-width: 22ch;
    font-family: var(--display); font-weight: 500;
    font-size: clamp(1.25rem, min(3.8vw, 5.2vh), 2.9rem);
    line-height: 1.14; letter-spacing: -0.028em; color: var(--bone); }
  .s__mark { display: block; margin-top: 0.2em; color: var(--bone-dim); font-style: italic; }
  .s__body { margin: clamp(24px, 4.4vh, 56px) auto 0; columns: 2; column-gap: clamp(24px, 4vw, 60px); max-width: 64ch; text-align: left; }
  .s__p { break-inside: avoid; margin-bottom: var(--s-3); }
  .s__p p, .s__lede p { margin: 0; }
  .s__p .s__rn { display: block; margin-bottom: 3px; }
  .s__rn, .s__coln { color: var(--dim); font-size: var(--t-xs); font-variant-numeric: tabular-nums; }
  .s__lede { max-width: 52ch; margin: clamp(20px, 3.6vh, 44px) auto 0; color: var(--bone-dim); }
  .s__cols { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(22px, 3.4vw, 52px); margin-top: clamp(28px, 5vh, 66px); text-align: left; }
  .s__col ul { list-style: none; margin: 0; padding: 0; }
  .s__col li { display: flex; gap: 10px; padding-block: 7px; border-bottom: 1px solid var(--rule-soft); font-size: var(--t-sm); color: var(--bone-dim); }
  .s__collab { color: var(--accent); font-size: var(--t-xs); margin: 0 0 var(--s-3); padding-bottom: 10px; border-bottom: 1px solid var(--rule); }
  .s__steps { list-style: none; margin: clamp(26px, 5vh, 62px) auto 0; padding: 0; display: grid; gap: clamp(26px, 5vh, 56px); max-width: 66ch; text-align: left; }
  .s__stepn { color: var(--accent); font-size: var(--t-xs); }
  .s__steptitle { margin: 6px 0 var(--s-3); font-family: var(--display); font-weight: 500; font-size: clamp(1.1rem, 2.2vw, 1.7rem); letter-spacing: -0.02em; color: var(--bone); }
  .s__steplines p { margin: 0 0 8px; color: var(--bone-dim); }
  .s__steplines .asks { color: var(--dim); }
  .s__step .draw { margin-bottom: clamp(14px, 2.4vh, 26px); }
  .s__links { list-style: none; margin: clamp(24px, 4vh, 52px) auto 0; padding: 0; display: flex; justify-content: center; gap: clamp(20px, 4vw, 54px); flex-wrap: wrap; }
  .s__enq { margin-top: clamp(44px, 8vh, 100px); text-align: left; }
  .s__enq :global(.ct__page) { padding-top: 0; }
  .hot { color: var(--accent); text-transform: none; font-family: var(--serif); font-style: italic; font-weight: 300; font-size: 1.06em; }
  .ov__cue { color: var(--dim); }

  @media (max-width: 900px) {
    .ms__bed { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .cn { position: static; display: inline-block; margin: 0 10px 10px 0; }
    .fr { padding-inline: 0; }
    .s__body { columns: 1; }
    .s__cols { grid-template-columns: 1fr; }
  }

  /* ══ LXIII · APERTURE IV ═════════════════════════════════════════════
     THE CATALOGUE EXISTS ONLY INSIDE THE WINDOW. A mat of solid ground covers
     the whole viewport except one centred rectangle, and the bed shows through
     that and nowhere else. V Corners drew a frame around an empty middle; this
     draws the same frame and puts the work in it.

     THE WINDOW BREATHES. Its inset is driven by --lit — the highest coverage
     any movement currently has — so it opens as a movement takes the window
     and closes at the joins. Between rooms the aperture narrows to a slot and
     the page is almost entirely ground; arriving somewhere, it opens.

     THE MAT IS A BOX-SHADOW, not four positioned rectangles. A spread of
     100vmax paints solid ground outward from the window's edge in every
     direction at once, so there are no seams to keep in register and nothing
     to recompute when the window moves. */
  .ap__mat {
    position: fixed; z-index: 1; pointer-events: none;
    inset: calc(11vh + (1 - var(--lit, 0)) * 15vh) calc(7vw + (1 - var(--lit, 0)) * 13vw);
    box-shadow: 0 0 0 100vmax var(--ground);
    border: 1px solid var(--rule);
    border-radius: 2px;
    /* NO will-change HERE. It said `inset`, and inset is a layout
       property — there is no compositor path for it to be promoted onto,
       so the hint bought nothing and cost a surface. What it changes is
       still a real cost: --lit moves through ten distinct values across
       the document, and each one relays out this box and repaints a
       100vmax shadow. Measured, --lit does NOT move at all inside
       Selected works, so none of that lands on the section that was
       stuttering; it is written down here rather than changed, because
       changing it would change how the aperture opens. */
  }

  /* ══ COMMON GROUND ═══════════════════════════════════════════════
     Aperture IV set its body at 16px in two columns — a 295px measure, about
     36 characters a line. All three of these open the measure and raise the
     size first, because no amount of editorial detailing rescues a line that
     short; the detailing is what they then differ on. */
  .s__lede { color: var(--bone-dim); }
  .s__lede p, .s__p p, .s__steplines p {
    font-size: var(--body-size); line-height: var(--body-lead);
    /* Widow and orphan control. `pretty` costs a little layout time and is
       ignored where unsupported, so it can only improve the rag. */
    text-wrap: pretty;
  }
  /* the two-into-three grid is gone; see the section redesign below */
  .s__col li { font-size: var(--list-size); line-height: 1.45; padding-block: 10px;
               font-variant-numeric: tabular-nums; }
  .s__steptitle { font-size: clamp(1.15rem, 2.4vw, 1.8rem); text-wrap: balance; }
  .fr__t, .s__stmt { text-wrap: balance; }

  /* ══ LXVII · SET AS A BOOK ═══════════════════════════════════════
     THE RUNNING TEXT BECOMES A SERIF. The register already carries Fraunces,
     but the layout only loads its ITALIC cut — every existing use of --serif
     in this codebase pairs it with font-style: italic, and upright Fraunces
     would have fallen through to Georgia without a word of warning. This
     draft imports the roman axes ITSELF, in its own frontmatter, so the real
     site's font payload is untouched.

     AND IT USES THE OPTICAL SIZE AXIS PROPERLY. Fraunces runs opsz 9–144.
     A face cut for 144pt display has thin hairlines and tight spacing that
     fall apart at reading size; opsz 22 on the body and 96 on the initial is
     the axis doing the job it exists for, rather than one drawing scaled up
     and down. */
  .s__p p, .s__lede p, .s__steplines p {
    font-family: 'Fraunces Variable', 'Iowan Old Style', Palatino, Georgia, serif;
    font-weight: 400; font-style: normal;
    font-variation-settings: 'opsz' 22, 'SOFT' 18, 'WONK' 0;
    letter-spacing: 0;
    hanging-punctuation: first last;
  }
  .rg { --body-size: clamp(1.1rem, 1.5vw, 1.36rem); --body-lead: 1.66;
        --list-size: clamp(1rem, 1.2vw, 1.1rem); }
  /* ══ THE WINDOW OPENS TO READ, FROM APERTURE VI ══════════════════
     The aperture is narrow and cinematic over the works and opens out when
     there is something to read — measured on VI, 1101px to 1219px.

     ONE SOURCE FOR THE APERTURE. The mat's inset and the widths of everything
     inside it are the same number, so nothing set on the page can end up
     wider than the window it is being read through. VI proved why that
     matters: with a fixed max-width, the window closes to about 993px at a
     join between movements and a wider panel runs its outer lines straight
     behind the mat.

     AND THE MEASURE IS NOT STRETCHED INTO THE NEW WIDTH. This is the book
     setting: 60ch of Fraunces comes out at 513px, which is 63 characters a
     line, and 63 is where it should stay — a longer line is not a better one.
     The width the window gains goes to the CATALOGUE, which is the point of
     opening it: more of the work is visible around the text block, and the
     text itself is untouched. The caps below are ceilings that the window can
     close down onto, never targets to grow into. */
  .rg {
    --mat-h: calc(7vw + (1 - var(--lit, 0)) * 13vw - var(--read, 0) * 4.6vw);
    --win: calc(100vw - 2 * var(--mat-h));
  }
  .ap__mat { inset: calc(11vh + (1 - var(--lit, 0)) * 15vh) var(--mat-h); }

  .ms__panel { max-width: min(76ch, calc(var(--win) - 90px)); }
  .s__body { columns: 1; max-width: min(60ch, calc(var(--win) - 150px)); }
  .s__lede { max-width: min(56ch, calc(var(--win) - 180px)); }
  .s__steps { max-width: min(60ch, calc(var(--win) - 150px)); }
  .s__stmt { max-width: 26ch; font-size: clamp(1.5rem, min(4.4vw, 5.6vh), 3.1rem); }

  /* THE RAISED INITIAL, cut at display optical size — the one place on the
     page where the 96 end of the axis belongs. */
  .s__body .s__p:first-of-type p::first-letter {
    float: left;
    font-size: 3.3em; line-height: 0.82;
    margin: 0.02em 0.08em 0 0;
    font-variation-settings: 'opsz' 96, 'SOFT' 0, 'WONK' 1;
    font-weight: 500; color: var(--bone);
  }
  /* the paragraph numbers go quiet: a book does not number its paragraphs */
  .s__p .s__rn { font-size: var(--t-xs); color: var(--dim); opacity: 0.6; }

  /* ══ THE LISTING, IN THE BOOK'S OWN HAND ═════════════════════════
     THE OLD LAYOUT WAS THREE GROUPS IN A TWO-COLUMN GRID. Film and Brand took
     the first row and Music was left alone on the second with an empty cell
     beside it — measured at 322px columns, Music sitting at the same x as
     Film, 318px below. Three things in a two-column grid can only ever come
     out lopsided. The data is a clean 3 x 5: three disciplines, five entries
     each, and every one of these three redesigns is built on that.

     And the entries are set in Fraunces like the running text, at the reading
     end of the optical size axis — the section stops looking like a UI
     component parked in a book. */
  .s__col li, .s__collab {
    font-family: 'Fraunces Variable', 'Iowan Old Style', Palatino, Georgia, serif;
    font-variation-settings: 'opsz' 20, 'SOFT' 18, 'WONK' 0;
  }
  .s__col li { font-style: normal; font-weight: 400; letter-spacing: 0; }

  /* THE LISTING SECTION GETS A WIDER PANEL. Setting a width on the listing
     alone did nothing: .ms__panel is 767px and its own padding takes 77 of
     that, so the block stayed pinned at 688px however wide the listing asked
     to be. The panel is widened for this movement only — the statement and
     the lede inside it keep their own narrower limits, so only the listing
     takes the extra width. Still derived from --win, so it closes with the
     aperture at a join like everything else. */
  [data-mv="2"] .ms__panel { max-width: min(940px, calc(var(--win) - 120px)); }

  /* ══ LXXI · INDEX ════════════════════════════════════════════════
     THREE COLUMNS, ONE ROW. The obvious symmetry, and the opened window is
     what finally affords it: at 1219px each column gets about 370px, which is
     room enough to set the entries at reading size instead of the 13px the
     old three-up needed at 230px. */
  .s__cols {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(20px, 3vw, 46px);
    /* An explicit width, not a ch cap. `ch` resolves against the ELEMENT's
       own font-size, and this block inherits the 13px furniture size — so
       96ch came out at 688px, three 204px columns inside a 1219px window.
       The listing runs wider than the 513px reading measure, as an index in a
       book does, without going full bleed. */
    max-width: min(880px, calc(var(--win) - 200px));
    margin-inline: auto;
    border-top: 1px solid var(--rule);
    padding-top: clamp(20px, 3vh, 36px);
  }
  .s__collab {
    color: var(--bone); border-bottom: 0; padding-bottom: 0;
    margin-bottom: clamp(12px, 1.8vh, 20px);
    font-size: clamp(1.05rem, 1.5vw, 1.4rem);
    font-style: italic; font-weight: 300; letter-spacing: 0;
    text-transform: none;
  }
  .s__col li {
    display: grid; grid-template-columns: 2.1em 1fr; align-items: baseline;
    gap: 0.2em; padding-block: 9px;
    border-bottom: 1px solid var(--rule-soft);
    font-size: clamp(1rem, 1.25vw, 1.18rem); line-height: 1.36;
  }
  .s__col li:first-child { border-top: 1px solid var(--rule-soft); }
  .s__coln { font-family: var(--mono); font-size: var(--t-xs); color: var(--dim); }

  /* ══ LXXIV · THE CONTACT SECTION, OPENED OUT ═════════════════════
     THE DIRECT DETAILS WERE ON THE PAGE TWICE. The section carried its own
     Email / WhatsApp / Phone list AND the enquiry form, which prints the same
     three under "Let's talk" — the same addresses set twice, a screen apart.
     The section's own list is gone; the form's stays, and WhatsApp has been
     added to it between email and phone so nothing was lost in the removal.

     AND THE FORM WAS BEING ASKED TO WORK IN 767px. .ct__page is a two-column
     grid, so at that width each column had barely 340px and the whole thing
     read as cramped. The panel opens to 1080px for this movement only —
     derived from --win like everything else here, so it still closes with the
     aperture at a join. */
  [data-mv="5"] .ms__panel { max-width: min(1080px, calc(var(--win) - 110px)); }
  [data-mv="5"] .s__enq { margin-top: clamp(30px, 5.5vh, 72px); }
  .s__enq :global(.ct__page) { column-gap: clamp(40px, 5vw, 88px); }
  /* THE DIRECT LIST, TIGHTER AGAIN. XXXII had already brought this block
     from 141px down to 101px — three even rows, one address per row, on a
     leading set for a list rather than for prose. This takes the same
     structure further: the row gap comes off first, then the address size,
     then the leading, in that order, because gap is the cheapest space to
     lose and type size the most expensive.

     ONE PER ROW SURVIVES THE SQUEEZE. The grid stays, and it is the reason
     the block can be tightened at all: left to the component's flex-wrap the
     three break unevenly the moment they shrink — email alone on one row,
     WhatsApp and phone sharing the next — which is ragged rather than
     compact. Three even rows shrink evenly.

     THE ADDRESSES STAY LARGER THAN THE COMPONENT'S OWN 20px, on purpose.
     These are the two lines a visitor is most likely to want without filling
     in a form, and a compact block is not the same thing as a quiet one. */
  .s__enq :global(.ct__direct) {
    display: grid; grid-auto-flow: row;
    gap: clamp(5px, 0.8vh, 8px);
  }
  .s__enq :global(.ct__direct li) { gap: 9px; align-items: baseline; }
  .s__enq :global(.ct__direct .mono) { font-size: var(--t-xs); letter-spacing: 0.1em; }
  .s__enq :global(.ct__direct a) {
    font-size: clamp(1.02rem, 1.32vw, 1.22rem);
    line-height: 1.2;
    letter-spacing: -0.016em;
  }
  .s__enq :global(.ct__lede) { font-size: clamp(1rem, 1.25vw, 1.15rem); }
  .s__enq :global(.ct__rule) { margin-block: clamp(20px, 3vh, 34px); }

  /* ══ THE WORKS READOUT ═══════════════════════════════════════════
     The playhead goes accent. It is the one live thing in that readout — it
     is the only mark that moves — and it was the same bone as the static
     furniture around it, so nothing said which mark to watch.

     And the work's name goes up: it was set at the 13px furniture size, the
     same as the corner labels, when it is the one piece of copy in the
     section that changes as you scroll. */
  .rl__head { background: var(--accent); }
  /* THE NAME MOVES INTO THE CURVE. With the arc bowing down there is a
     wedge of space beneath its centre that nothing else can use, and a
     single line of type is exactly what fits it — so the caption is pulled
     up into the bowl rather than sitting clear of the scale. */
  .rl__cap {
    margin-top: -6px;
    font-size: clamp(1.05rem, 1.5vw, 1.4rem);
    letter-spacing: -0.015em; line-height: 1.16;
  }
  /* The year goes to the mono face at furniture size. Against a curved
     scale and a display-face name it is the third voice in the readout and
     should read as the smallest — at --t-sm it competed with the title. */
  .rl__date {
    margin-top: 6px;
    font-family: var(--mono); font-size: var(--t-micro);
    letter-spacing: 0.16em; color: var(--dim);
  }

  /* ══ THE BOXES GO BACK TO BLACK ═════════════════════════════════
     XXXIX and XL cut windows into this panel: the panel gave up its fill and
     a masked layer under the form painted it back with one hole per chip, so
     every answer box was an opening onto the catalogue. That is reverted here
     — the panel keeps its own --ground fill, the masked layer and the script
     that built it are gone, and the chips are plain outlined boxes on solid
     ground again, exactly as XXXII draws them.

     Nothing is left behind to do it: no blackout element, no mask, no
     ResizeObserver, no per-chip geometry. What remains of this draft is the
     three things that were never about the windows — the heading removed,
     the enquiry raised into the space it left, and the gutter rule stopping
     clear of the crossing. */

  /* ══ THE ENQUIRY RISES INTO THE HEADING'S PLACE ══════════════════
     With the CONTACT heading gone, .fr stopped being a title block and became
     a bare band of padding with the four corner labels pinned to its edges —
     top pair at its top, bottom pair at its bottom, and nothing between them.
     Measured, that left the panel starting 190px below the section's top
     where the heading used to start at 122px: 68px of the section's opening
     was empty.

     THE PANEL NOW STARTS EXACTLY WHERE THE WORD DID. The space is taken off
     the section's own top padding rather than out of .fr, because .fr's
     padding IS the label band — the corner labels are absolutely positioned
     to its top and bottom edges, so shrinking it does not tighten the band,
     it collapses the two rows onto each other. At 72px they already clear by
     only 10px.

     AND THE NUMBER IS DERIVED, NOT DIALLED IN. The panel's top is the sum of
     three things: this padding, .fr's own height (2 x its 5vh padding), and
     the panel's 4.4vh top margin. The heading's top was the section's 12vh
     padding plus one of .fr's 5vh. Setting this padding to 12vh - 5vh - 4.4vh
     = 2.6vh makes those two equal — so the panel's top edge lands on the
     heading's old top at every viewport height where the three source clamps
     are in their linear range, which is 615px to 1231px. Outside that the
     clamps stop composing and the two drift apart by a few pixels, which is
     why the bounds here are the source bounds subtracted the same way
     (70-30-24 and 156-66-58) rather than a pair of round numbers. */
  [data-mv="5"] { padding-top: clamp(16px, 2.6vh, 32px); }

  /* ══ THE LINE STOPS AT THE CROSSING ══════════════════════════════
     The grey rule down the gutter ends where it meets the footer's rule,
     just under the send action — an intersection, and then nothing.

     The component draws a tail past that crossing on purpose: it measures
     the distance down to the footer's last line of text, adds an overhang,
     and runs the line off the page so the meeting reads as a crossing rather
     than as the line being cut to fit. The cost is that the tail then runs
     straight down through the middle of "Listen on Spotify or Apple
     Music…", which is 60ch wide and starts at the left margin, so a 1px
     rule lands inside the sentence.

     content: none removes the tail's box outright rather than hiding it, so
     there is nothing left to overlap and nothing left to measure. The
     component's own script still writes --tail; with no ::after to read it
     the value is simply unused, which is why this is one line here and no
     change at all to the component the live site shares.

     AND THEN THE LINE STOPS SHORT OF THE CROSSING ALTOGETHER, so the two
     rules clear each other instead of meeting. The clearance is not a chosen
     number: the rule under the standfirst already stops half a gutter shy of
     this line — measured, it ends at x608 against the line at x640, a 32px
     clearance. Half the gutter is what this reuses, so the vertical rule
     leaves the footer's rule exactly what every other rule in the section
     leaves.

     AND IT IS HALF OF THIS DRAFT'S GUTTER, NOT THE COMPONENT'S. ContactForm
     sets column-gap: 3.4em, which at the 16px this page resolves at would be
     54.4px — but the draft overrides the gutter to clamp(40px, 5vw, 88px),
     64px here. Half of the component's figure gave a 27px clearance against
     the standfirst rule's 32px, close enough to look like a mistake rather
     than a system. clamp(20px, 2.5vw, 44px) is half of the gutter actually
     in force, so the two clearances stay equal at every width.

     Written as a subtraction from the footer's own top margin rather than as
     a height, because that margin is what the line was pinned to in the first
     place: if .ft's margin changes, this still lands half a gutter above it.

     The orange fill is measured as a percentage of this line, so it shortens
     with it and still completes at the new foot. The component's arrival
     watcher is unaffected — it fires when the fill passes the send action's
     top, and the foot is still 47px below that. */
  .s__enq :global(.divide)::after { content: none; }
  .s__enq :global(.divide) { bottom: calc(clamp(20px, 2.5vw, 44px) - clamp(64px, 11vh, 120px)); }

  /* ══ THE MASTHEAD, BORROWED FROM V · CORNERS ═════════════════════
     Only the name and the sentence. XL's opening keeps its aperture, its
     catalogue bed, its four corner labels and its frame; what changes is the
     two pieces of type in the middle of them.

     THE NAME COMES OFF TWO LINES ONTO ONE. XL set .fr__w to display:block, so
     UGAM sat above KHETANI at clamp(2rem, min(11vw, 15vh), 8.5rem) on -0.055em.
     Corners runs the mast as a nowrap flex row with a clamp(12px, 1.7vw, 30px)
     column gap and sizes the words at clamp(2.4rem, 9.2vw, 7.6rem) on -0.045em
     — one line, wider tracking, and the size governed by width alone rather
     than by whichever of 11vw and 15vh is smaller. That last difference is the
     real one: XL's name shrinks on a short viewport to protect the vertical
     rhythm of a full-height opening, and Corners' does not, because a single
     line has far less height to protect.

     THE SENTENCE STOPS BEING UPPERCASE. XL's .fr__cap is uppercase at 28ch on
     line-height 1.1, close under the name at clamp(14px, 2.4vh, 32px).
     Corners' .ov__stmt is sentence case at 24ch on 1.02, standing well clear
     at clamp(34px, 6vh, 72px) — so it reads as a line of prose under a
     masthead rather than as a second, smaller deck of display type.

     The base .ov__word and .ov__stmt rules this builds on are already in this
     stylesheet, character for character the same as Corners' — they were
     carried along unused when the aperture drafts moved to .fr__name. Only
     the four .ov--corners overrides were missing, and they are re-scoped to
     .fr--hero rather than applied by adding the ov--corners class: that class
     also sets align-items:center on the .ov itself, which would shrink
     .fr--hero to its content width and take the four corner labels with it. */
  /* ══ THE FRAME KEEPS XL'S BOX, SO THE CORNERS DO NOT MOVE ═══════
     The four corner labels are absolutely positioned to .fr--hero's own
     edges, so anything that changes the frame's height moves them. Dropping
     the name from two lines to one did exactly that: measured at 1280x720,
     the frame went from 389.98px to 355.41px, and because .ov centres it,
     the labels came in by half of that at each end — the top pair 17px down,
     the bottom pair 17px up.

     So the frame is pinned back to the height it has in XL, and .fr--hero
     becomes a centring flex column so the shorter masthead sits at the same
     centre rather than riding at the top of a box that is now taller than
     its contents. The labels are out of flow and do not care.

     THE HEIGHT IS XL'S OWN EXPRESSIONS, NOT A NUMBER. Two pads, the name's
     two lines at its 0.86 leading, the caption's top margin, and the
     caption's two lines at its 1.1 leading — each read straight off the rule
     it comes from, so this tracks XL at every viewport instead of at one.

     THE 2.265 IS MEASURED, NOT DERIVED. A pure flow model gives 2.2 there
     and lands 2.048px short at 720 and 2.496px short at 1024 — the residual
     is the baseline gap under the inline-block inside each masked caption
     line, which no arithmetic over line-height can see. It scales with the
     caption's own size (2.048/31.68 and 2.496/38.4 agree to three places),
     so it folds into that coefficient rather than sitting outside as a
     constant. Checked against XL: 0.011px out at 720 and 0.0005px at 1024. */
  .fr--hero {
    min-height: calc(
      2 * clamp(46px, 8vh, 104px)
      + 1.72 * clamp(2rem, min(11vw, 15vh), 8.5rem)
      + clamp(14px, 2.4vh, 32px)
      + 2.265 * clamp(1rem, min(3.2vw, 4.4vh), 2.4rem)
    );
    display: flex; flex-direction: column; justify-content: center;
  }
  .fr--hero .ov__middle { display: flex; flex-direction: column; align-items: center; }
  .fr--hero .ov__mast { display: flex; flex-wrap: nowrap; justify-content: center; column-gap: clamp(12px, 1.7vw, 30px); }
  .fr--hero .ov__word { font-size: clamp(2.4rem, 9.2vw, 7.6rem); }
  .fr--hero .ov__stmt {
    margin-top: clamp(34px, 6vh, 72px);
    font-size: clamp(1.3rem, 2.7vw, 2.3rem); max-width: 24ch;
  }
  .fr--hero .ov__stmt .line { display: block; }
</style>
<script>
  /* ONE CLOCK FOR THE WHOLE PAGE.
     Per movement:  --e entry · --x exit · --p through · --f window coverage
     On the register: --prog how far down the document · --lit the highest
     coverage any single movement currently has.
     --lit is what opens and closes the aperture: at a join no movement owns
     the window, it dips, and the frame narrows between rooms. */
  function initSpine() {
    const rg = document.querySelector<HTMLElement>('[data-rg]');
    if (!rg || rg.dataset.spineBound) return;
    rg.dataset.spineBound = '1';
    const secs = Array.from(rg.querySelectorAll<HTMLElement>('.ov, .mvt'));
    const rows = Array.from(rg.querySelectorAll<HTMLElement>('[data-row]'));
    /* --prog is written HERE, not on .rg. See @property --prog at the top of
       the stylesheet for why, and note that .ms__bed is the only thing in the
       codebase that reads it. */
    const bed = rg.querySelector<HTMLElement>('.ms__bed');
    if (!secs.length) return;
    let raf = 0;
    const paint = () => {
      raf = 0;
      /* ══ EVERY MEASUREMENT FIRST, THEN EVERY WRITE ═══════════════
         This used to ask for a box, write four custom properties, ask for
         the next box, write four more — thirty-one boxes a frame, each one
         after a write.

         THE WRITES ARE NOT FREE, WHICH IS THE WHOLE PROBLEM. --lit on .rg
         feeds .ap__mat's `inset` and .rl's `bottom`, and both are layout
         properties, so every write dirtied layout and the next
         getBoundingClientRect had to resolve the whole page again before
         it could answer. Thirty-one forced layouts a frame.

         Reordering costs nothing and changes nothing: the numbers written
         are computed from exactly the same boxes as before. Measured at
         1280 while sweeping Selected works, this function alone:

             as it was    median 3.9ms   p90 4.6ms   worst 9.4ms
             reordered    median 0.8ms   p90 1.0ms   worst 4.6ms

         It was the most expensive of the six scroll loops on the page by
         a factor of six, and it is not the conveyor. */
      const vh = innerHeight;
      const span = document.documentElement.scrollHeight - vh;
      const secBoxes = secs.map((el) => el.getBoundingClientRect());
      const rowBoxes = rows.map((el) => el.getBoundingClientRect());

      let lit = 0, read = 0;
      const covers = new Array(secs.length);
      for (let i = 0; i < secs.length; i++) {
        const r = secBoxes[i];
        const cover = Math.min(1, Math.max(0, (Math.min(r.bottom, vh) - Math.max(r.top, 0)) / vh));
        covers[i] = cover;
        if (cover > lit) lit = cover;
        /* Coverage of whatever owns the window, counted only when it is not
           the works — this is what opens the aperture for reading. A coverage
           figure rather than a flag, so the opening rides the scroll instead
           of snapping the moment a section takes over. */
        if (!secs[i].classList.contains('sec--works') && cover > read) read = cover;
      }

      /* --e, --p AND --f ARE GONE. Nothing in src/ reads any of them —
         checked across every stylesheet and component — so they were 21
         writes a frame, on seven sections, feeding nothing. --x is kept: it
         is read, by .work__peek's `left`, and untangling that is a separate
         question. */
      for (let i = 0; i < secs.length; i++) {
        const el = secs[i], r = secBoxes[i];
        const h = Math.max(1, r.height);
        el.style.setProperty('--x', Math.min(1, Math.max(0, -r.top / h)).toFixed(4));
      }
      if (bed) bed.style.setProperty('--prog', (span > 0 ? Math.min(1, Math.max(0, scrollY / span)) : 0).toFixed(4));
      rg.style.setProperty('--lit', lit.toFixed(4));
      rg.style.setProperty('--read', read.toFixed(4));
      const line = vh * 0.42, reach = vh * 0.34;
      for (let i = 0; i < rows.length; i++) {
        const r = rowBoxes[i];
        if (r.bottom < -vh || r.top > vh * 2) continue;
        const d = Math.abs(r.top + r.height / 2 - line);
        rows[i].style.setProperty('--lit', Math.max(0, 1 - d / reach).toFixed(3));
      }
    };
    addEventListener('scroll', () => { if (!raf) raf = requestAnimationFrame(paint); }, { passive: true });
    addEventListener('resize', () => { if (!raf) raf = requestAnimationFrame(paint); }, { passive: true });
    paint();
  }
  initSpine();
  document.addEventListener('astro:page-load', initSpine);
</script>

