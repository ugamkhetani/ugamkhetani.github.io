  /* ── C · THE LIT SEGMENT ───────────────────────────────────────
     Light localised in BOTH axes: falloff across x chooses which lines
     answer, a gradient centred on the cursor's own height chooses how
     much of each one lights. What travels is a short glowing length of
     line — a lamp held against the grid rather than a switch thrown.

     Each ledger carries its own --py measured from its own document top,
     so when the cursor sits near a seam the ledger below already has a
     small negative --py and its share of the glow is drawn too. The
     segment crosses the boundary instead of stopping at it.

     The line moves to a pseudo-element because a border cannot carry a
     gradient. It sits at left: 0, exactly where the border was. */
  .ledger i { display: block; position: relative; transform-origin: top; }
  .ledger i::before {
    content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 1px;
    background:
      linear-gradient(to bottom,
        transparent calc(var(--py, -9999px) - 130px),
        rgba(255, 255, 255, var(--lit, 0)) calc(var(--py, -9999px) - 24px),
        rgba(255, 255, 255, var(--lit, 0)) calc(var(--py, -9999px) + 24px),
        transparent calc(var(--py, -9999px) + 130px)),
