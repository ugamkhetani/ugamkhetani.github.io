    display: inline-block; overflow: hidden; vertical-align: bottom;
    padding-bottom: 0.24em; margin-bottom: -0.24em;
    padding-right: 0.06em; margin-right: -0.06em;
  }
  .line__in { display: inline-block; }
  /* text-indent INHERITS, and every inline-block is a block container that
     applies it to its own first line. The hanging indent on .stmt below was
     therefore re-applied inside each masked word, pushing the word out of
     its own overflow:hidden box — measured: .line boxes collapsed from full
     word width to 4px, exactly the padding, and the statement rendered as
