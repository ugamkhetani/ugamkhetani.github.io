---
/**
 * PREVIEW — MOSAIC B · "ANCHORED".
 *
 * RANK IS AREA. A gives every work the same size tile and lets position carry
 * the ranking; this lets the tiles themselves differ. The first work takes a
 * 2 x 2 block, the second a 1 x 2, and the other ten take one cell each — so
 * the most-wanted work is not merely well placed, it is four times the size of
 * the works at the bottom of the list. It is the only one of the three that
 * reads as a mosaic rather than as a tile field.
 *
 * THE COLUMN COUNT DOES NOT CHANGE, AND THAT WAS A CORRECTION. The first
 * version of this option used a 4 x 4 grid on the theory that a bed built to
 * the aperture's proportions would waste nothing. Measured, that was wrong: the
 * bed is 1628 x 1018 behind an 1101 x 624 window, so four columns makes each one
 * 407px and only two and a half of them fit — 4 tiles of 16 were fully visible
 * instead of all of them. The existing six columns are already the right
 * number: at 271px each, exactly four fill the window. So the grid stays 6 x 5
 * and the anchoring happens inside it.
 *
 * NOTHING IS RENDERED THAT CANNOT BE SEEN. Only the sixteen ever-visible cells
 * are populated; the fourteen dead ones hold no tile and decode no image. That
 * is fourteen fewer image requests than the live bed makes today, for a bed
 * that looks fuller rather than emptier.
 *
 * THE TWO ANCHORS SIT IN THE TWO PANEL-SAFE COLUMNS. Measured, the panels are
 * 767 to 991px wide against an 1101px aperture and cover the middle of it
 * entirely; only the outer edges of the window survive. So the 2 x 2 starts in
 * the leftmost visible column and the 1 x 2 sits in the rightmost — the two
 * places a panel can never reach.
 */
import Base from '../../layouts/Base.astro';
import Stage from '../../components/_pv-MosaicStage.astro';
import Tile from '../../components/_pv-MosaicTile.astro';
import { getCollection } from 'astro:content';
import { RANKED, BEST_FRAME } from '../../lib/_pv-mosaic';

const works = await getCollection('works');
const bySlug = new Map(works.map((w) => [w.id, w]));

/**
 * Explicit placement inside the 6 x 5 grid, 1-indexed, using only the sixteen
 * cells the measurement says are ever visible: columns 2-5, rows 2-5.
 *
 *            col2      col3      col4      col5
 *   row 2    03        04        05        06      in frame, 65% by the end
 *   row 3    ┌ 01 ──────────┐    07        ┌ 02 ┐  always in frame
 *   row 4    └──────────────┘    08        └────┘  always in frame
 *   row 5    09        10        11        12      from ~38% of the scroll
 *
 * 01 takes four cells, 02 takes two, the other ten take one each: sixteen.
 */
const PLACED: { rank: number; col: string; row: string }[] = [
  { rank: 1, col: '2 / 4', row: '3 / 5' }, // the anchor, panel-safe column
  { rank: 2, col: '5 / 6', row: '3 / 5' }, // the other panel-safe column
  { rank: 3, col: '2 / 3', row: '2 / 3' },
  { rank: 4, col: '3 / 4', row: '2 / 3' },
  { rank: 5, col: '4 / 5', row: '2 / 3' },
  { rank: 6, col: '5 / 6', row: '2 / 3' },
  { rank: 7, col: '4 / 5', row: '3 / 4' },
  { rank: 8, col: '4 / 5', row: '4 / 5' },
  { rank: 9, col: '2 / 3', row: '5 / 6' },
  { rank: 10, col: '3 / 4', row: '5 / 6' },
  { rank: 11, col: '4 / 5', row: '5 / 6' },
  { rank: 12, col: '5 / 6', row: '5 / 6' },
];

const TILES = PLACED.map((p) => ({
  ...p,
  w: bySlug.get(RANKED[p.rank - 1])!,
  /* Row 5 only arrives at about 38% of its height, late in the scroll. */
  late: p.row.startsWith('5'),
  big: p.rank <= 2,
}));
---

<Base title="Mosaic B — Anchored" description="Preview only.">
  <Stage
    letter="B"
    name="Anchored"
    note="Rank is area. The first work takes a 2 x 2 block and the second a 1 x 2, both in the outer columns the panels never cover; the other ten take one cell each. The grid stays six columns — measured, that is already the number that puts exactly four across the aperture — but only the sixteen ever-visible cells are populated, so fourteen images that can never be seen are not requested at all."
  >
    <div class="ms__ground" slot="bed" aria-hidden="true">
      <div class="ms__bed">
        {TILES.map((t) => (
          <span class="ms__tile" class:list={[{ 'is-late': t.late, 'is-big': t.big }]}
                style={`grid-column:${t.col};grid-row:${t.row}`}>
            <Tile slug={t.w.id} frames={t.w.data.frames} alt=""
              sizes={t.big ? '40vw' : '20vw'} pick={BEST_FRAME[t.w.id] ?? 1} />
            <span class="ms__mark mono" aria-hidden="true">
              <b>{String(t.rank).padStart(2, '0')}</b>
              {t.w.data.title}
              <i>{t.big ? 'anchor' : t.late ? 'late row' : ''}</i>
            </span>
          </span>
        ))}
      </div>
    </div>
  </Stage>
</Base>

<style>
  .ms__ground { position: fixed; inset: 0; z-index: 0; pointer-events: none; overflow: hidden; }
  /* Six columns, unchanged — see the note above on why four was wrong. */
  .ms__bed {
    position: absolute; inset: -10%;
    display: grid; grid-template-columns: repeat(6, minmax(0, 1fr));
    grid-template-rows: repeat(5, minmax(0, 1fr)); gap: clamp(5px, 0.8vw, 13px);
    filter: brightness(0.30) saturate(0.7) contrast(1.05);
    transform: translate3d(0, calc(var(--prog, 0) * -8%), 0) scale(1.06);
    will-change: transform;
  }
  .ms__tile { position: relative; display: block; overflow: hidden; min-height: 0; border-radius: clamp(6px, 0.7vw, 12px); }
  .ms__tile :global(img) { border-radius: inherit; }

  .ms__mark { display: none; }
  :global(.rg.map-on) .ms__bed { filter: brightness(0.62) saturate(0.7) contrast(1.05); }
  :global(.rg.map-on) .ms__tile { outline: 1px solid var(--rule-accent); outline-offset: -1px; }
  :global(.rg.map-on) .ms__tile.is-late { outline-color: rgba(255, 255, 255, 0.18); }
  :global(.rg.map-on) .ms__tile.is-big { outline-color: var(--accent); }
  :global(.rg.map-on) .ms__mark {
    position: absolute; inset: 0; z-index: 2;
    display: grid; align-content: center; justify-items: center; gap: 3px;
    padding: 6px; text-align: center;
    font-size: 9px; letter-spacing: 0.08em; line-height: 1.25;
    color: var(--bone); background: rgba(6, 6, 5, 0.62);
  }
  :global(.rg.map-on) .ms__mark b { font-size: 15px; letter-spacing: 0; color: var(--accent); }
  :global(.rg.map-on) .ms__tile.is-big .ms__mark b { font-size: 26px; }
  :global(.rg.map-on) .ms__mark i { font-style: normal; font-size: 8px; color: var(--dim); }

  /* Four columns on a phone: the anchor keeps its 2 x 2 and everything else
     reflows around it rather than the whole plan collapsing. */
  @media (max-width: 900px) {
    .ms__bed { grid-template-columns: repeat(4, minmax(0, 1fr)); grid-template-rows: repeat(6, minmax(0, 1fr)); }
    .ms__tile { grid-column: auto !important; grid-row: auto !important; }
    .ms__tile.is-big:first-child { grid-column: span 2 !important; grid-row: span 2 !important; }
  }
</style>
