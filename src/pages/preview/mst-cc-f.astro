---
/**
 * MUMBAI STANDARD TIME · CREDITS, ASSEMBLED — GATHER
 *
 * ONE OF THREE asked for on 2026-09-07: the credits section, given an
 * ASSEMBLING feel — the pairs composing themselves rather than arriving
 * whole. The watch link beside them is the applied A · Ledger. Nothing here is on
 * the live site.
 *
 * The whole colophon collapses toward one corner and expands into place, every word travelling from the same origin rather than its own.
 *
 * THE LAYOUT IS A REPLICA, INCLUDING THE VERTICAL SPACING, and that was the
 * explicit brief. The section structure is the live one exactly — the opening
 * and the writing are TWO `.blk` sections on the live page, not one, and an
 * earlier scaffold of mine merged them and lost a 144px gap. The margins are
 * the live computed values rather than the first declaration in the file:
 * `.blk` is declared at clamp(72px, 12vh, 160px) and then OVERRIDDEN further
 * down at clamp(104px, 18vh, 240px), which is what actually renders.
 *
 * Measured at 1280x800, the live page puts its sections at:
 *
 *   header            120   h 400
 *   statement         632   h 211     gap 112
 *   the work          956   h 590     gap 113
 *   about the work   1690   h 566     gap 144
 *   stills           2400   h 1276    gap 144
 *   watch            3820   h 46      gap 144
 *   credits          3954   h 117     gap 88
 *
 * These drafts reproduce that table. If a change here moves any of those
 * numbers, the draft is wrong and not the page.
 *
 * EVERYTHING ELSE ON THE PAGE IS THE LIVE SITE — A1 on the description and
 * the parallax on recognition, both as applied — so these two sections are
 * judged against the animation they have to sit beside.
 *
 * NOTHING REFLOWS. Every effect is opacity, transform or clip-path.
 */
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import OpNav from '../../components/OpNav.astro';
import VideoFacade from '../../components/VideoFacade.astro';
import NextWork from '../../components/NextWork.astro';
import { framesFor } from '../../lib/frames';
import { parseAwards } from '../../lib/awards';
import { order, RATIO_NUM } from '../../data/composition';

const works = await getCollection('works');
const work = works.find((w) => w.id === 'mumbai-standard-time')!;
const d = work.data;
const images = framesFor(work.id, d.frames);
const poster = images[0];
const AR = d.ratio.replace(':', ' / ');
const ROLES = d.role.split('/').map((r) => r.trim()).filter(Boolean);
const QW = (d.quote ?? '').split(' ').filter(Boolean);

const SENT = d.description.trim().split(/(?<=\.)\s+/).filter(Boolean);
const LEDE = SENT[0] ?? d.description.trim();
const REST = SENT.slice(1).join(' ');
const LW = LEDE.split(/\s+/).filter(Boolean);
const RW = REST ? REST.split(/\s+/).filter(Boolean) : [];
const seed = (i: number) => (((Math.sin(i * 12.9898) * 43758.5453) % 1) + 1) % 1;

const CITES = parseAwards(d.awards);
const dots = (v: string) => v.split('/').map((p) => p.trim()).filter(Boolean).join(' · ');
const CREDIT_ORDER: [keyof typeof d.credits, string][] = [
  ['director', 'Director'], ['client', 'Client'], ['studio', 'Studio'],
  ['production', 'Production'], ['artist', 'Artist'], ['with', 'Collaboration'],
];
const FACTS: { k: string; v: string }[] = [
  { k: 'Role', v: dots(d.role) },
  ...CREDIT_ORDER.filter(([key]) => d.credits[key]).map(([key, label]) => ({ k: label, v: dots(d.credits[key]!) })),
  ...d.meta.map((m) => ({ k: m.label, v: dots(m.value) })),
];

const bySlug = new Map(works.map((w) => [w.id, w]));
const sequence = order.filter((sl) => bySlug.has(sl));
const next = bySlug.get(sequence[(sequence.indexOf(work.id) + 1) % sequence.length])!;
const STILL_TRACK = `${Math.round(Math.min(340, Math.max(160, 300 * (RATIO_NUM[d.ratio] ?? 1.6))))}px`;


/* The unit each draft assembles in. `seed` is already declared above — the
   build-time hash the site has carried since W · Assemble. */
const words = (s: string) => s.split(/\s+/).filter(Boolean);
const chars = (s: string) => [...s];

const FAM = ['a', 'b', 'c', 'd', 'e', 'f'];
const HERE = 'f';
---

<Base title={`${d.title} — credits, Gather`} description={d.description}>
  <OpNav variant="bracket" base="/" />

  <article class="sc" data-sc-pg style={`--ar:${AR}`}>
    <header class="hd">
      <p class="mono hd__over">{d.category} · {d.overline ?? d.year}</p>
      <h1 class="hd__t">{d.title}</h1>
      <p class="mono hd__meta">
        <span class="hd__roles">
          {ROLES.map((r, i) => (<>{i > 0 && <i class="hd__bar" aria-hidden="true"></i>}<span>{r}</span></>))}
        </span>
      </p>
    </header>

    <section class="q" aria-label="Statement">
      <p class="q__t">{QW.map((w, i) => (<><span class="w" data-w>{w}</span>{i < QW.length - 1 ? ' ' : ''}</>))}</p>
    </section>

    {/* ── 01 · THE WORK ─────────────────────────────────────── */}
    <section class="blk" aria-label="The work">
      <VideoFacade youtube={d.media.youtube} title={d.title} poster={poster} alt={d.alt} eager />
    </section>

    {/* ── 02 · THE WRITING ──────────────────────────────────── */}
    <section class="blk" aria-label="About the work">
      <div class="body" data-v>
        <p class="body__lede" style={`--n:${LEDE.length}`}>{LEDE}</p>
        {REST && <p class="body__rest">{REST}</p>}
      </div>

      <div class="rec" aria-label="Recognition">
        <ol class="rec__list">
          {CITES.map((c, i) => (
            <li class="rec__row" data-v>
              <span class="mono rec__n">{String(i + 1).padStart(2, '0')}</span>
              <span class="rec__body">
                <span class="mono rec__cit">
                  {c.star && <span class="rec__star" aria-hidden="true">★</span>}
                  {c.citation}
                </span>
                {c.body && <span class="rec__where display">{c.body}</span>}
              </span>
            </li>
          ))}
        </ol>
      </div>
    </section>

    {/* ── 03 · THE FRAMES ───────────────────────────────────── */}
    <section class="blk" aria-label="Stills">
      <div class="grid" style={`--sw:${STILL_TRACK}`}>
        {images.map((img, i) => (
          <figure class="cel" data-v>
            <span class="cel__win">
              <Image
                src={img}
                alt={i === 0 ? d.alt : ''}
                aria-hidden={i === 0 ? undefined : 'true'}
                widths={[420, 700, 1100]}
                sizes="(max-width: 720px) 46vw, 30vw"
                loading={i < 3 ? 'eager' : 'lazy'}
                decoding="async"
              />
            </span>
            <figcaption class="mono cel__no">{String(i + 1).padStart(2, '0')}</figcaption>
          </figure>
        ))}
      </div>
    </section>

    {/* ── 04 · WATCH ────────────────────────────────────────── */}
    <section class="blk wt" aria-label="Watch">
      {d.links.map((l) => (
        <a class="wt__a" href={l.url} target="_blank" rel="noopener" data-v>
          <span class="wt__t display">{l.label}</span>
          <span class="wt__arw" aria-hidden="true"><span class="wt__arw-i">&nearr;</span></span>
        </a>
      ))}
    </section>

    {/* ── 05 · CREDITS ──────────────────────────────────────── */}
    <section class="blk cr" aria-label="Credits">
      <dl class="cr__list" data-v>
        {FACTS.map((f, fi) => (
          <div class="cr__row">
            <dt class="mono cr__k">{f.k}</dt>
            <dd class="cr__v">
              {words(f.v).map((w, i) => (<><span class="p" style={`--g:${((fi + (i + 1) / (words(f.v).length + 1)) / FACTS.length).toFixed(3)}`}>{w}</span>{i < words(f.v).length - 1 ? ' ' : ''}</>))}
            </dd>
          </div>
        ))}
      </dl>
    </section>

    <nav class="mono flip" aria-label="Drafts">
      {FAM.map((l) => (
        <a class={l === HERE ? 'flip__a is-here' : 'flip__a'} href={`/preview/mst-cc-${l}`}>{l.toUpperCase()}</a>
      ))}
      <a class="flip__all" href="/preview/">All drafts &rarr;</a>
    </nav>
  </article>

  <NextWork
    slug={next.id}
    title={next.data.title}
    year={next.data.year}
    category={next.data.category}
    frames={next.data.frames}
    alt={next.data.alt}
  />
</Base>

<style>
  /* ── THE LIVE PAGE'S TYPE AND SPACING, at the values it actually computes.
     The .blk bottom margin is the OVERRIDE — clamp(104px, 18vh, 240px) — not
     the clamp(72px, 12vh, 160px) declared earlier in that file. */
  .sc { --measure: min(760px, 100%); padding: clamp(96px, 15vh, 190px) var(--margin) 0; }
  .sc { --film: max(var(--measure), calc(100vw - 3 * var(--margin))); }
  .hd, .q, .blk { max-width: var(--measure); }
  .hd { margin-inline: auto; text-align: center; }
  .hd__over {
    margin: 0 0 clamp(24px, 4vh, 48px);
    font-size: var(--t-micro); letter-spacing: 0.16em;
    text-transform: uppercase; color: var(--dim); font-variant-numeric: tabular-nums;
  }
  .hd__t {
    margin: 0; font-family: var(--display); font-weight: 500;
    font-size: clamp(2.6rem, 10vw, 7.25rem);
    line-height: 0.86; letter-spacing: -0.05em;
    text-transform: uppercase; color: var(--bone);
  }
  .hd__meta {
    display: flex; justify-content: center; flex-wrap: wrap;
    margin: clamp(28px, 4.6vh, 50px) 0 0;
    font-family: var(--mono); font-size: var(--t-micro); letter-spacing: 0.16em;
    text-transform: uppercase; color: var(--dim);
  }
  .hd__roles { display: inline-flex; align-items: center; flex-wrap: wrap; justify-content: center; row-gap: 8px; }
  .hd__bar { display: inline-block; width: 1px; height: 7px; margin-inline: clamp(10px, 1.8vw, 16px); background: var(--rule); }
  .q { margin: clamp(80px, 14vh, 180px) auto; text-align: center; }
  .q__t {
    margin: 0 auto; max-width: 20ch;
    font-family: var(--display); font-weight: 500;
    font-size: clamp(1.9rem, 5.4vw, 4.4rem);
    line-height: 1.02; letter-spacing: -0.045em; color: var(--bone);
  }
  .blk { margin: 0 auto clamp(104px, 18vh, 240px); }
  .blk :global(.facade) { width: var(--film); margin-inline: calc((100% - var(--film)) / 2); }

  .body { margin: 0; }
  .body__lede {
    margin: 0 0 clamp(22px, 3.4vh, 40px);
    max-width: clamp(20ch, calc(var(--n, 90) / 3 * 1ch), 44ch);
    font-family: var(--display); font-weight: 500;
    font-size: clamp(1.2rem, min(calc(2.35rem - (var(--n, 90) - 55) * 0.007rem), calc(1.05rem + 2.1vw)), 2.2rem);
    line-height: 1.12; letter-spacing: -0.025em; color: var(--bone); text-wrap: balance;
  }
  .body__rest {
    margin: 0; max-width: 54ch;
    font-size: clamp(1.05rem, 1.6vw, 1.25rem);
    line-height: 1.62; letter-spacing: -0.006em; color: var(--bone-dim); text-wrap: pretty;
  }
  /* The word span survives so the markup is the live markup, but with the
     block animated it carries no motion of its own. */
  /* The statement still assembles word by word; the description does not. */
  .w { display: inline-block; opacity: calc(0.12 + var(--v, 1) * 0.88); transform: translateY(calc((1 - var(--v, 1)) * 0.32em)); }

  .rec { margin: clamp(56px, 9vh, 110px) 0 0; }
  .rec__list { margin: 0; padding: 0; list-style: none; display: grid; gap: clamp(22px, 3.4vh, 40px); }
  .rec__row {
    display: grid;
    grid-template-columns: clamp(44px, 5vw, 68px) minmax(0, 1fr);
    align-items: baseline; gap: clamp(10px, 2vw, 24px);
  }
  .rec__n { font-size: var(--t-micro); letter-spacing: var(--track-mono); color: var(--dim); font-variant-numeric: tabular-nums; }
  .rec__body { display: grid; gap: clamp(6px, 1vh, 11px); }
  .rec__cit { font-size: var(--t-micro); letter-spacing: 0.16em; text-transform: uppercase; color: var(--accent); }
  .rec__star { margin-right: 0.5em; color: var(--accent); }
  .rec__where {
    font-family: var(--display); font-weight: 500;
    font-size: clamp(1.3rem, 3vw, 2.35rem);
    line-height: 1.06; letter-spacing: -0.035em; color: var(--bone); text-wrap: balance;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(var(--sw, 340px), 100%), 1fr));
    gap: clamp(20px, 2.6vw, 46px);
  }
  .cel { margin: 0; }
  .cel__win { display: block; aspect-ratio: var(--ar); overflow: hidden; background: var(--ground-lift); }
  .cel__win :global(img) {
    width: 100%; height: 100%; object-fit: cover;
    object-position: 50% var(--fcy, 50%);
    filter: saturate(0.94) contrast(1.02);
    transition: filter var(--d-micro) var(--ease);
  }
  .cel:hover .cel__win :global(img) { filter: saturate(1) contrast(1.06) brightness(1.04); }
  .cel__no {
    display: block; margin-top: 8px;
    font-size: var(--t-micro); letter-spacing: 0.16em;
    color: var(--dim); font-variant-numeric: tabular-nums;
  }
  @media (max-width: 720px) { .grid { --sw: min(46vw, 220px); } }

  .blk.wt { margin-bottom: clamp(64px, 11vh, 150px); text-align: right; }
  .wt__a { display: inline-flex; align-items: baseline; gap: 14px; text-decoration: none; color: var(--bone); }
  .wt__t { font-size: clamp(1.6rem, 4.2vw, 2.6rem); line-height: 1.05; letter-spacing: -0.02em; }
  .wt__arw { font-size: var(--t-md); color: var(--dim); }

  .blk.cr { margin-top: clamp(40px, 7vh, 90px); }
  .cr__list { margin: 0; display: block; max-width: 62ch; }
  .cr__row { display: inline-block; max-width: 100%; margin-right: clamp(14px, 1.9vw, 26px); }
  .cr__row:last-child { margin-right: 0; }
  .cr__k {
    display: inline; margin: 0; font-size: var(--t-micro); letter-spacing: 0.14em;
    text-transform: uppercase; color: var(--dim);
  }
  .cr__k::after { content: '\00a0'; }
  .cr__v { display: inline; margin: 0; font-size: var(--t-md); color: var(--bone); }

  /* ── WHAT THIS DRAFT ADDS ───────────────────────────────────── */
  /* F · GATHER. Every word starts near the top-left corner of the list and
     travels out to its own place, so the colophon expands from a point rather
     than each part arriving where it already was.

     IT IS THE ONLY DRAFT WHOSE MOTION IS ABOUT THE BLOCK RATHER THAN ITS
     PARTS. Unspool moves the rows along one axis; this moves every word in
     two, by an amount proportional to how far through the list it sits — so
     the last word of the last pair travels furthest and the first barely
     moves, and the whole thing reads as one object opening.

     THE ORIGIN IS APPROXIMATE ON PURPOSE. A true collapse would need each
     word's measured position, which means reading layout for every word on
     every frame — the thing that makes a page stutter only on someone else's
     machine. --i over --n is a proportion known at build time and it is close
     enough: what the eye reads is "further along means further travelled",
     not a precise vanishing point.

     THE VERTICAL IS A THIRD OF THE HORIZONTAL, because the list is far wider
     than it is tall and a square gather would send the last words up out of
     the section. The ratio is roughly the block's own — 626 by 117 at 1280 —
     which is why it looks like this colophon opening rather than a generic
     one. */
  .cr__list { --v2: calc(var(--v, 1) * var(--v, 1)); }
  .cr__k { display: inline-block; opacity: calc(0.2 + var(--v, 1) * 0.8); }
  .cr__w, .p {
    display: inline-block;
    opacity: calc(0.06 + var(--v2, 1) * 0.94);
    transform: translate(
      calc((1 - var(--v2, 1)) * var(--g, 0) * -80px),
      calc((1 - var(--v2, 1)) * var(--g, 0) * -15px)
    );
    will-change: transform, opacity;
  }

  /* A · Ledger on the watch link, as applied to the live site. */
  .wt__a { --v2: calc(var(--v, 1) * var(--v, 1)); }
  .wt__t {
    opacity: calc(0.12 + var(--v, 1) * 0.88);
    transform: translateY(calc((1 - var(--v, 1)) * 0.28em));
  }
  .wt__arw {
    opacity: calc(0.05 + var(--v2, 1) * 0.95);
    transform: translate(calc((1 - var(--v2, 1)) * -14px), calc((1 - var(--v2, 1)) * 14px));
    transition: color var(--d-micro) var(--ease);
  }
  .wt__arw-i { display: inline-block; transition: transform var(--d-micro) var(--ease); }
  .wt__a:hover .wt__arw { color: var(--bone); }
  .wt__a:hover .wt__arw-i { transform: translate(3px, -3px); }

  /* A1 · Lead and lag on the description, as applied to the live site. */
  .body { --v2: calc(var(--v, 1) * var(--v, 1)); }
  .body__lede {
    opacity: calc(0.12 + var(--v, 1) * 0.88);
    transform: translateY(calc((1 - var(--v, 1)) * 0.32em));
  }
  .body__rest {
    opacity: calc(0.1 + var(--v2, 1) * 0.9);
    transform: translateY(calc((1 - var(--v2, 1)) * 0.5em));
  }

  /* B · Parallax on recognition, as applied to the live site. */
  .rec__row { --v2: calc(var(--v, 1) * var(--v, 1)); }
  .rec__n, .rec__cit {
    opacity: calc(0.14 + var(--v, 1) * 0.86);
    transform: translateY(calc((1 - var(--v, 1)) * 0.34em));
  }
  .rec__where {
    opacity: calc(0.08 + var(--v2, 1) * 0.92);
    transform: translateY(calc((1 - var(--v2, 1)) * 0.6em));
  }
  @media (prefers-reduced-motion: reduce) {
    .cel, .cel *, .rec, .rec *, .cr, .cr *, .wt__a, .w {
      transition: none !important; transform: none !important;
      opacity: 1 !important; clip-path: none !important;
    }
  }

  /* ── FLIPPING BETWEEN THE THREE ─────────────────────────────── */
  .flip {
    display: flex; justify-content: center; align-items: center; flex-wrap: wrap; gap: 8px;
    margin: 0 auto clamp(60px, 10vh, 120px);
    font-size: var(--t-micro); letter-spacing: 0.14em; text-transform: uppercase;
  }
  .flip__a {
    display: grid; place-items: center;
    min-width: 30px; height: 30px; padding-inline: 8px;
    border: 1px solid var(--rule); color: var(--dim); text-decoration: none;
  }
  .flip__a:hover { border-color: var(--bone-dim); color: var(--bone); }
  .flip__a.is-here { border-color: var(--accent); color: var(--accent); }
  .flip__all { margin-left: 14px; color: var(--dim); text-decoration: none; }
  .flip__all:hover { color: var(--bone); }
</style>

<script>
  /* The live clock, extended to [data-v] so a row, a still or a credit pair
     can carry its own progress. Reduced motion opts out and leaves every
     default of 1 — the finished state — in place. */
  function initPg() {
    const root = document.querySelector('[data-sc-pg]');
    if (!root || root.dataset.bound) return;
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    root.dataset.bound = '1';
    const items = Array.from(root.querySelectorAll('[data-w], [data-v]'));
    if (!items.length) return;
    const last = new WeakMap();
    let raf = 0;
    const paint = () => {
      raf = 0;
      const line = innerHeight * 0.66, span = innerHeight / 3;
      for (const el of items) {
        const v = Math.min(1, Math.max(0, (line - el.getBoundingClientRect().top) / span));
        const prev = last.get(el);
        if (prev !== undefined && Math.abs(prev - v) < 0.02) continue;
        last.set(el, v);
        el.style.setProperty('--v', v.toFixed(3));
      }
    };
    const tick = () => { if (!raf) raf = requestAnimationFrame(paint); };
    paint();
    addEventListener('scroll', tick, { passive: true });
    addEventListener('resize', tick, { passive: true });
  }
  initPg();
  document.addEventListener('astro:page-load', initPg);
</script>
