---
/**
 * PREVIEW — WORK PAGE IV · "CUE SHEET".  Aasha.
 *
 * THE PAGE AS THE DOCUMENT THE WORK WAS MADE FROM.
 *
 * A composer does not meet a film as a gallery of stills. They meet it as a
 * spotting session and the sheet that comes out of it: a running column with
 * the picture pegged down one side of it and everything the score has to do
 * written against it. This page is that sheet — the eight frames are cues
 * hung off a single rule, each with its own number, and the writing is set
 * against the rule as annotation rather than as a headline.
 *
 * THE RULE FILLS AS YOU READ, in accent, exactly the way the enquiry's gutter
 * rule fills as it is answered. It is the same idiom doing the same job: a
 * measure of how far through a document you are, drawn as the document's own
 * spine rather than as a bar bolted to the top of the window. Nothing else on
 * the page moves.
 *
 * WHY THE CUES ALTERNATE SIDES. A sheet with everything pegged to one edge
 * reads as a list. Alternating across the rule makes the rule a centre rather
 * than a margin, gives every frame a facing page of empty ground, and means
 * the eye crosses the spine eight times on the way down — which is the whole
 * reason a printed spread is more interesting to read than a scroll.
 *
 * THE FILL IS DERIVED, NOT ANIMATED. It is the page's own scroll position
 * mapped onto the rule's box, so it cannot drift out of step with what you
 * are looking at, and it needs no timeline of its own.
 *
 * NOTHING IS INVENTED: every field comes from src/content/works/aasha.md.
 */
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import OpNav from '../../components/OpNav.astro';
import VideoFacade from '../../components/VideoFacade.astro';
import NextWork from '../../components/NextWork.astro';
import Colophon from '../../components/Colophon.astro';
import { Image } from 'astro:assets';
import { framesFor } from '../../lib/frames';
import { order, numberFor, total } from '../../data/composition';

const works = await getCollection('works');
const bySlug = new Map(works.map((w) => [w.id, w]));
const work = bySlug.get('aasha')!;
const d = work.data;

const seq = order.filter((s) => bySlug.has(s));
const next = bySlug.get(seq[(seq.indexOf('aasha') + 1) % seq.length])!;

const images = framesFor('aasha', d.frames);
const poster = images[0];
const num = numberFor('aasha');
const AR = d.ratio.replace(':', ' / ');

const FACTS: { k: string; v: string }[] = [
  { k: 'Role', v: d.role },
  ...(d.credits.director ? [{ k: 'Director', v: d.credits.director }] : []),
  ...d.meta.map((m) => ({ k: m.label, v: m.value })),
];
---

<Base title={`${d.title} — Ugam Khetani`} description={d.description}>
  <OpNav variant="bracket" />

  <article class="cs" data-cs style={`--ar:${AR}`}>
    {/* ── THE HEAD OF THE SHEET ───────────────────────────────── */}
    <header class="hd">
      <p class="mono hd__folio">{num} / {String(total).padStart(2, '0')} &nbsp;·&nbsp; Cue sheet</p>
      <h1 class="hd__t" data-reveal>
        <span class="line"><span class="line__in">{d.title}</span></span>
      </h1>
      <p class="mono hd__meta">
        {d.category} · {d.year} · {d.role}
        {d.credits.director && <> · Dir. {d.credits.director}</>}
      </p>
      {d.quote && (
        <p class="hd__q" data-reveal><em class="serif">{d.quote}</em></p>
      )}
    </header>

    {/* ── THE FILM, AT THE HEAD ───────────────────────────────── */}
    <section class="film" aria-label="Film" data-reveal>
      <p class="mono row__lbl">The film</p>
      <VideoFacade youtube={d.media.youtube!} title={d.title} poster={poster} alt={d.alt} eager />
    </section>

    {/* ── THE SHEET ───────────────────────────────────────────── */}
    <section class="sheet" aria-label="Cues">
      <div class="sheet__rule" aria-hidden="true"><i class="sheet__fill" data-fill></i></div>

      <p class="mono sheet__head">The score</p>
      <p class="sheet__body" data-reveal>{d.description}</p>

      <ol class="cues">
        {images.map((img, i) => (
          <li class="cue" data-reveal>
            <span class="cue__tick" aria-hidden="true"></span>
            <p class="mono cue__no">Cue {String(i + 1).padStart(2, '0')}</p>
            <span class="cue__win">
              <Image
                src={img}
                alt={i === 0 ? d.alt : ''}
                aria-hidden={i === 0 ? undefined : 'true'}
                widths={[480, 800, 1200]}
                sizes="(max-width: 900px) 88vw, 40vw"
                loading={i < 2 ? 'eager' : 'lazy'}
                decoding="async"
              />
            </span>
          </li>
        ))}
      </ol>
    </section>

    {/* ── THE FOOT ────────────────────────────────────────────── */}
    <section class="foot" aria-label="Credits" data-reveal>
      {d.awards.length > 0 && (
        <p class="mono foot__awards">{d.awards.map((a) => a.text).join(' · ')}</p>
      )}
      <dl class="foot__facts">
        {FACTS.map((f) => (
          <div class="foot__row">
            <dt class="mono foot__k">{f.k}</dt>
            <dd class="foot__v">{f.v}</dd>
          </div>
        ))}
      </dl>
      {d.links.length > 0 && (
        <p class="foot__links">
          {d.links.map((l) => (
            <a class="foot__link" href={l.url} target="_blank" rel="noopener">{l.label} &nearr;</a>
          ))}
        </p>
      )}
    </section>
  </article>

  <NextWork
    slug={next.id}
    title={next.data.title}
    year={next.data.year}
    category={next.data.category}
    frames={next.data.frames}
    alt={next.data.alt}
  />
  <Colophon />
</Base>

<style is:global>
  .runhead { display: none !important; }
</style>

<style>
  .cs { padding: clamp(96px, 15vh, 190px) var(--margin) 0; }

  /* ── HEAD ───────────────────────────────────────────────────── */
  .hd { max-width: 1180px; margin-inline: auto; text-align: center; }
  .hd__folio {
    margin: 0 0 clamp(18px, 3vh, 32px);
    font-size: var(--t-micro);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--dim);
    font-variant-numeric: tabular-nums;
  }
  .hd__t {
    margin: 0;
    font-family: var(--display);
    font-weight: 500;
    font-size: clamp(2.4rem, 9vw, 7.2rem);
    line-height: 0.86;
    letter-spacing: -0.05em;
    text-transform: uppercase;
    color: var(--bone);
  }
  .hd__meta {
    margin: clamp(18px, 3vh, 32px) 0 0;
    font-size: var(--t-micro);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .hd__q {
    margin: clamp(28px, 5vh, 56px) auto 0;
    max-width: 20ch;
    font-family: var(--display);
    font-weight: 500;
    font-size: clamp(1.3rem, 2.8vw, 2.2rem);
    line-height: 1.06;
    letter-spacing: var(--track-tight);
    color: var(--accent);
  }

  .film { max-width: 1180px; margin: clamp(64px, 11vh, 150px) auto 0; }
  .row__lbl {
    margin: 0 0 clamp(14px, 2.2vh, 24px);
    padding-bottom: 10px;
    border-bottom: 1px solid var(--rule);
    font-size: var(--t-micro);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--bone-dim);
  }

  /* ── THE SHEET ──────────────────────────────────────────────── */
  .sheet {
    position: relative;
    max-width: 1180px;
    margin: clamp(80px, 13vh, 170px) auto 0;
    padding-top: clamp(40px, 6vh, 80px);
  }

  /* The spine. One rule down the middle, filling in accent as the sheet is
     read — the enquiry's gutter rule doing the same job on a different
     document. */
  .sheet__rule {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 1px;
    background: var(--rule-soft);
    overflow: hidden;
  }
  .sheet__fill {
    display: block;
    width: 100%;
    height: calc(var(--fill, 0) * 100%);
    background: var(--accent);
    /* Masked to nothing over a fixed 90px so the fill has no visible end —
       it brightens downward and loses itself rather than arriving at a mark.
       Fixed rather than proportional: a percentage fade would be invisible at
       the top of the sheet and enormous at the bottom. */
    -webkit-mask-image: linear-gradient(to bottom, #000 calc(100% - 90px), transparent 100%);
    mask-image: linear-gradient(to bottom, #000 calc(100% - 90px), transparent 100%);
  }

  .sheet__head {
    margin: 0 0 clamp(14px, 2.2vh, 24px);
    text-align: center;
    font-size: var(--t-micro);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--bone-dim);
  }
  .sheet__body {
    margin: 0 auto clamp(56px, 9vh, 120px);
    max-width: 54ch;
    text-align: center;
    font-size: clamp(1.1rem, 1.7vw, 1.45rem);
    line-height: 1.44;
    letter-spacing: -0.012em;
    color: var(--bone-dim);
    text-wrap: pretty;
  }

  /* ── THE CUES ───────────────────────────────────────────────── */
  /* Alternating across the spine, so the rule is a centre rather than a
     margin and every frame gets a facing page of empty ground. */
  .cues { list-style: none; margin: 0; padding: 0; }
  .cue {
    position: relative;
    width: calc(50% - clamp(28px, 4vw, 64px));
    margin-bottom: clamp(48px, 8vh, 110px);
  }
  .cue:nth-child(odd) { margin-right: auto; text-align: right; }
  .cue:nth-child(even) { margin-left: auto; text-align: left; }
  /* Every second cue is dropped, so the two files interleave down the spine
     instead of sitting in matched pairs across it. */
  .cue:nth-child(even) { margin-top: clamp(-40px, -5vh, -20px); }

  /* The tick that pegs a cue to the spine. */
  .cue__tick {
    position: absolute;
    top: 12px;
    width: clamp(20px, 3vw, 48px);
    height: 1px;
    background: var(--rule);
  }
  .cue:nth-child(odd) .cue__tick { left: 100%; }
  .cue:nth-child(even) .cue__tick { right: 100%; }

  .cue__no {
    margin: 0 0 10px;
    font-size: var(--t-micro);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--dim);
    font-variant-numeric: tabular-nums;
  }
  .cue__win {
    display: block;
    aspect-ratio: var(--ar);
    overflow: hidden;
    background: var(--ground-lift);
  }
  .cue__win :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.94) contrast(1.02);
    transform: scale(1.001);
    transition:
      filter var(--d-micro) var(--ease),
      transform 1100ms var(--ease);
  }
  .cue:hover .cue__win :global(img) {
    filter: saturate(1) contrast(1.06) brightness(1.04);
    transform: scale(1.035);
  }

  @media (max-width: 760px) {
    .sheet__rule { left: 0; }
    .cue { width: 100%; margin-top: 0 !important; text-align: left !important; padding-left: clamp(20px, 6vw, 44px); }
    .cue__tick { left: 0 !important; right: auto !important; width: clamp(12px, 4vw, 28px); }
  }

  /* ── FOOT ───────────────────────────────────────────────────── */
  .foot { max-width: 1180px; margin: clamp(64px, 11vh, 150px) auto 0; }
  .foot__awards {
    margin: 0 0 clamp(28px, 4.6vh, 52px);
    text-align: center;
    font-size: var(--t-xs);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .foot__facts { margin: 0; }
  .foot__row {
    display: grid;
    grid-template-columns: minmax(0, 12rem) minmax(0, 1fr);
    gap: clamp(20px, 2.5vw, 44px);
    align-items: baseline;
    padding: 14px 0;
    border-bottom: 1px solid var(--rule-soft);
  }
  .foot__k { margin: 0; font-size: var(--t-micro); letter-spacing: 0.16em; text-transform: uppercase; color: var(--muted); }
  .foot__v { margin: 0; font-size: var(--t-md); line-height: 1.3; color: var(--bone-dim); }
  .foot__links { margin: clamp(24px, 4vh, 40px) 0 0; display: flex; flex-wrap: wrap; gap: 24px; }
  .foot__link {
    font-size: var(--t-sm);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--bone);
    text-decoration: none;
    border-bottom: 1px solid var(--rule-accent);
    padding-bottom: 3px;
    transition: color var(--d-micro) var(--ease), border-color var(--d-micro) var(--ease);
  }
  .foot__link:hover { color: var(--accent); border-color: var(--accent); }

  @media (max-width: 640px) {
    .foot__row { grid-template-columns: 1fr; gap: 4px; }
  }
</style>

<script>
  /* THE SPINE FILLS AS THE SHEET IS READ.

     Derived from the sheet's own box rather than from the document: the fill
     is how far the viewport's middle has travelled between the top and the
     bottom of the sheet, clamped. So it reads 0 before you reach the cues and
     1 when you leave them, and it cannot drift out of step with what is on
     screen the way a document-wide progress bar does.

     A rect read on a throttled scroll, not an observer — measured in this
     preview pane, IntersectionObserver delivers no callbacks at all, and the
     homepage's own clock is a scroll pass for the same reason. */
  function initCueSheet() {
    const root = document.querySelector<HTMLElement>('[data-cs]');
    const sheet = root?.querySelector<HTMLElement>('.sheet');
    const fill = root?.querySelector<HTMLElement>('[data-fill]');
    if (!root || !sheet || !fill || root.dataset.bound) return;
    root.dataset.bound = '1';

    let raf = 0;
    const paint = () => {
      raf = 0;
      const r = sheet.getBoundingClientRect();
      const mid = innerHeight / 2;
      const f = Math.min(1, Math.max(0, (mid - r.top) / Math.max(1, r.height)));
      fill.style.setProperty('--fill', f.toFixed(4));
    };
    const tick = () => { if (!raf) raf = requestAnimationFrame(paint); };

    addEventListener('scroll', tick, { passive: true });
    addEventListener('resize', tick, { passive: true });
    paint();
  }
  initCueSheet();
  document.addEventListener('astro:page-load', initCueSheet);
</script>
