---
/**
 * PREVIEW — WORK PAGE XVIII · "PLATE".  Aasha.
 *
 * THE SEQUENCE IS FIXED, and it is the one asked for:
 *   1 the film · 2 the title · 3 the statement · 4 the credits
 *   · 5 the writing · 6 the recognition · 7 the stills
 *
 * Each section is the best-performing treatment from the draft it came from:
 * the statement is IX's, assembling word by word on scroll; the credits are
 * XV's ruled table; the writing and the recognition band are X's. What XVI,
 * XVII and XVIII vary is only the first two — how the film opens the page,
 * and how the title is set against it.
 *
 * XVIII MATS THE FILM AND RANGES THE TITLE LEFT. The film is inset rather
 * than bled — held inside the page's own measure with air around it, the way
 * a plate sits on a page — and the title runs underneath as a two-column
 * head: name on the left, the facts ranged right against it on a rule.
 *
 * WHY INSET RATHER THAN BLED. A bled frame reads as a hero and asks to be
 * looked at before anything else is considered; a matted one reads as a plate
 * inside a document and lets the head beside it carry equal weight. This
 * variation is for the reader who wants the facts as fast as the film.
 *
 * THE TWO COLUMNS MEET ON A BASELINE, not a box: the name and the facts are
 * aligned on their last line rather than their tops, so the rule under them
 * is continuous and the block reads as one head instead of two stacks.
 *
 * CREDITS BEFORE THE WRITING is unusual and deliberate — it answers "who did
 * what on this" while the film is still in mind, and leaves the description
 * and the record to be read by someone who has already decided they are
 * interested.
 *
 * NOTHING IS INVENTED: every field comes from src/content/works/aasha.md.
 */
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import OpNav from '../../components/OpNav.astro';
import VideoFacade from '../../components/VideoFacade.astro';
import NextWork from '../../components/NextWork.astro';
import Colophon from '../../components/Colophon.astro';
import { Image } from 'astro:assets';
import { framesFor } from '../../lib/frames';
import { order, numberFor, total } from '../../data/composition';

const works = await getCollection('works');
const bySlug = new Map(works.map((w) => [w.id, w]));
const work = bySlug.get('aasha')!;
const d = work.data;

const seq = order.filter((s) => bySlug.has(s));
const next = bySlug.get(seq[(seq.indexOf('aasha') + 1) % seq.length])!;

const images = framesFor('aasha', d.frames);
const poster = images[0];
const num = numberFor('aasha');
const AR = d.ratio.replace(':', ' / ');

/* IX's statement, split on spaces so each word can light in reading order.
   One line per map in the markup below — written across several, the fragment
   emits its own indentation and every gap becomes two spaces. */
const QW = (d.quote ?? '').split(' ').filter(Boolean);

/* X's tally: one string in the file, split into figure/label pairs so the
   numbers can be set as numbers. Every part must begin with a figure or the
   whole thing falls back to the raw line. */
const RAW_AWARDS = d.awards.map((a) => a.text).join(' · ');
const AW_PARTS = RAW_AWARDS.split('·').map((p) => p.trim()).filter(Boolean);
const AW_MATCH = AW_PARTS.map((p) => p.match(/^(\d+)\s+(.+)$/));
const TALLY = AW_MATCH.every(Boolean) ? AW_MATCH.map((m) => ({ n: m![1], k: m![2] })) : null;

const SPECS: { k: string; v: string }[] = d.meta.map((m) => ({ k: m.label, v: m.value }));
---

<Base title={`${d.title} — Ugam Khetani`} description={d.description}>
  <OpNav variant="bracket" />

  <article class="wk" data-wk style={`--ar:${AR}`}>
    {/* ── 1 · THE FILM, MATTED ────────────────────────────────── */}
    <section class="open open--plate" aria-label="Film">
      <VideoFacade youtube={d.media.youtube!} title={d.title} poster={poster} alt={d.alt} eager />
    </section>

    {/* ── 2 · THE TITLE, RANGED LEFT ──────────────────────────── */}
    <header class="hd hd--split">
      <div class="hd__name">
        <h1 class="hd__t" data-reveal>
          <span class="line"><span class="line__in">{d.title}</span></span>
        </h1>
      </div>
      <div class="hd__facts">
        <p class="mono hd__folio">{num} / {String(total).padStart(2, '0')}</p>
        <p class="hd__role">{d.role}</p>
        <p class="mono hd__dir">
          {d.category} · {d.year}
          {d.credits.director && <> · Dir. {d.credits.director}</>}
        </p>
      </div>
    </header>

    {/* ── 3 · THE STATEMENT — IX ──────────────────────────────── */}
    {QW.length > 0 && (
      <section class="q" aria-label="Statement">
        <p class="q__t">{QW.map((w, i) => (<><span class="w" data-w>{w}</span>{i < QW.length - 1 ? ' ' : ''}</>))}</p>
      </section>
    )}

    {/* ── 4 · THE CREDITS — XV ────────────────────────────────── */}
    <section class="blk" aria-label="Credits" data-reveal>
      <p class="mono blk__lbl">Credits</p>
      <dl class="tbl tbl--cr">
        <div class="tbl__cell"><dt class="mono tbl__k">Role</dt><dd class="tbl__v">{d.role}</dd></div>
        {d.credits.director && (
          <div class="tbl__cell"><dt class="mono tbl__k">Director</dt><dd class="tbl__v">{d.credits.director}</dd></div>
        )}
        {SPECS.map((s) => (
          <div class="tbl__cell"><dt class="mono tbl__k">{s.k}</dt><dd class="tbl__v">{s.v}</dd></div>
        ))}
      </dl>
      {d.links.length > 0 && (
        <p class="tbl__links">
          {d.links.map((l) => (
            <a class="tbl__link" href={l.url} target="_blank" rel="noopener">{l.label} &nearr;</a>
          ))}
        </p>
      )}
    </section>

    {/* ── 5 · THE WRITING — X ─────────────────────────────────── */}
    <section class="blk" aria-label="About the score" data-reveal>
      <p class="mono blk__lbl">The score</p>
      <p class="body">{d.description.trim()}</p>
    </section>

    {/* ── 6 · THE RECOGNITION — X ─────────────────────────────── */}
    {(TALLY || RAW_AWARDS) && (
      <section class="tally" aria-label="Recognition" data-reveal>
        <p class="mono tally__lbl">Recognition</p>
        {TALLY ? (
          <dl class="tally__row">
            {TALLY.map((t) => (
              <div class="tally__cell">
                <dt class="tally__n">{t.n}</dt>
                <dd class="mono tally__k">{t.k}</dd>
              </div>
            ))}
          </dl>
        ) : (
          <p class="mono tally__raw">{RAW_AWARDS}</p>
        )}
      </section>
    )}

    {/* ── 7 · THE STILLS ──────────────────────────────────────── */}
    <section class="blk" aria-label="Stills" data-reveal>
      <p class="mono blk__lbl">Stills</p>
      <div class="grid">
        {images.map((img, i) => (
          <figure class="cel">
            <span class="cel__win">
              <Image
                src={img}
                alt={i === 0 ? d.alt : ''}
                aria-hidden={i === 0 ? undefined : 'true'}
                widths={[420, 700, 1100]}
                sizes="(max-width: 720px) 46vw, 30vw"
                loading={i < 3 ? 'eager' : 'lazy'}
                decoding="async"
              />
            </span>
            <figcaption class="mono cel__no">{String(i + 1).padStart(2, '0')}</figcaption>
          </figure>
        ))}
      </div>
    </section>
  </article>

  <NextWork
    slug={next.id}
    title={next.data.title}
    year={next.data.year}
    category={next.data.category}
    frames={next.data.frames}
    alt={next.data.alt}
  />
  <Colophon />
</Base>

<style is:global>
  .runhead { display: none !important; }
</style>

<style>
  .wk { padding: 0 var(--margin); }
  .blk { max-width: 1180px; margin: 0 auto clamp(72px, 12vh, 160px); }

  /* ── 1 · THE PLATE ──────────────────────────────────────────── */
  /* Inset, not bled: held inside the page's measure with air around it, so it
     reads as a plate in a document rather than as a hero that must be looked
     at before anything else is considered. */
  .open--plate {
    max-width: 1180px;
    margin: clamp(56px, 9vh, 120px) auto clamp(40px, 6vh, 80px);
  }

  /* ── 2 · THE SPLIT HEAD ─────────────────────────────────────── */
  /* Name left, facts right, meeting on a baseline rather than on a box — the
     two are aligned on their last line, so the rule under them is continuous
     and the block reads as one head instead of two stacks. */
  .hd--split {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, auto);
    gap: clamp(20px, 3vw, 56px);
    align-items: end;
    max-width: 1180px;
    margin: 0 auto clamp(72px, 12vh, 160px);
    padding-bottom: clamp(20px, 3.4vh, 36px);
    border-bottom: 1px solid var(--rule);
    text-align: left;
  }
  .hd__name { min-width: 0; }
  .hd__t {
    margin: 0;
    font-family: var(--display); font-weight: 500;
    font-size: clamp(2.4rem, 9vw, 7rem);
    line-height: 0.86; letter-spacing: -0.05em;
    text-transform: uppercase; color: var(--bone);
  }
  .hd__facts { text-align: right; }
  .hd__folio {
    margin: 0;
    font-size: var(--t-micro); letter-spacing: 0.16em;
    text-transform: uppercase; color: var(--dim);
    font-variant-numeric: tabular-nums;
  }
  .hd__role {
    margin: clamp(10px, 1.8vh, 18px) 0 0;
    font-family: var(--display); font-weight: 500;
    font-size: clamp(1.15rem, 2.4vw, 1.9rem);
    line-height: 1.05; letter-spacing: var(--track-tight);
    color: var(--accent);
  }
  .hd__dir {
    margin: 8px 0 0;
    font-size: var(--t-micro); letter-spacing: 0.16em;
    text-transform: uppercase; color: var(--muted);
  }
  @media (max-width: 720px) {
    .hd--split { grid-template-columns: 1fr; align-items: start; }
    .hd__facts { text-align: left; }
  }

  /* ── 3 · THE STATEMENT — IX's assembling type ───────────────── */
  .q { max-width: 1180px; margin: 0 auto clamp(72px, 12vh, 160px); text-align: center; }
  .q__t {
    margin: 0 auto; max-width: 20ch;
    font-family: var(--display); font-weight: 500;
    font-size: clamp(1.9rem, 5.4vw, 4.4rem);
    line-height: 1.02; letter-spacing: -0.045em;
    color: var(--bone);
  }
  /* Each word carries its own --v, written by the scroll pass. Everything
     visual derives from that one number, so a word cannot be half-lifted and
     fully lit at once. */
  .w {
    display: inline-block;
    opacity: calc(0.12 + var(--v, 1) * 0.88);
    transform: translateY(calc((1 - var(--v, 1)) * 0.32em));
    will-change: opacity, transform;
  }

  /* ── 4 · THE CREDIT TABLE — XV ──────────────────────────────── */
  /* One hairline per edge: the table draws its own left and top, each cell
     draws its right and bottom. Drawn on all four the internal edges double
     and read at 1px on a dark ground as uneven weight, not a heavier rule. */
  .tbl {
    margin: 0; display: grid;
    border-left: 1px solid var(--rule-soft);
    border-top: 1px solid var(--rule-soft);
  }
  .tbl__cell {
    border-right: 1px solid var(--rule-soft);
    border-bottom: 1px solid var(--rule-soft);
    padding: clamp(18px, 3vh, 32px) clamp(16px, 2vw, 28px);
    min-width: 0;
  }
  .tbl--cr { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .tbl__k { margin: 0; font-size: var(--t-micro); letter-spacing: 0.16em; text-transform: uppercase; color: var(--muted); }
  .tbl__v { margin: 10px 0 0; font-size: var(--t-md); line-height: 1.3; color: var(--bone-dim); }
  .tbl__links { margin: clamp(24px, 4vh, 40px) 0 0; display: flex; flex-wrap: wrap; gap: 24px; }
  .tbl__link {
    font-size: var(--t-sm); letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--bone); text-decoration: none;
    border-bottom: 1px solid var(--rule-accent); padding-bottom: 3px;
    transition: color var(--d-micro) var(--ease), border-color var(--d-micro) var(--ease);
  }
  .tbl__link:hover { color: var(--accent); border-color: var(--accent); }
  @media (max-width: 860px) { .tbl--cr { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) { .tbl--cr { grid-template-columns: 1fr; } }

  /* ── 5 · THE WRITING — X ────────────────────────────────────── */
  .blk__lbl {
    margin: 0 0 clamp(16px, 2.6vh, 28px);
    padding-bottom: 10px; border-bottom: 1px solid var(--rule);
    font-size: var(--t-micro); letter-spacing: 0.16em;
    text-transform: uppercase; color: var(--bone-dim);
  }
  .body {
    margin: 0 auto; max-width: 60ch; text-align: center;
    font-size: clamp(1.1rem, 1.8vw, 1.5rem);
    line-height: 1.44; letter-spacing: -0.012em;
    color: var(--bone-dim); text-wrap: pretty;
  }

  /* ── 6 · THE RECOGNITION — X ────────────────────────────────── */
  .tally {
    max-width: 1180px;
    margin: 0 auto clamp(72px, 12vh, 160px);
    padding-block: clamp(30px, 5vh, 60px);
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }
  .tally__lbl {
    margin: 0 0 clamp(24px, 4vh, 44px); text-align: center;
    font-size: var(--t-micro); letter-spacing: 0.16em;
    text-transform: uppercase; color: var(--dim);
  }
  .tally__row { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); margin: 0; }
  .tally__cell { text-align: center; padding-inline: clamp(8px, 2vw, 28px); }
  .tally__cell + .tally__cell { border-left: 1px solid var(--rule-soft); }
  .tally__n {
    margin: 0;
    font-family: var(--display); font-weight: 500;
    font-size: clamp(3rem, 9vw, 7rem);
    line-height: 0.82; letter-spacing: -0.05em;
    color: var(--bone); font-variant-numeric: tabular-nums;
  }
  .tally__k {
    margin: clamp(12px, 2vh, 20px) 0 0;
    font-size: var(--t-micro); letter-spacing: 0.16em;
    text-transform: uppercase; color: var(--accent); line-height: 1.5;
  }
  .tally__raw { margin: 0; text-align: center; font-size: var(--t-sm); letter-spacing: 0.14em; text-transform: uppercase; color: var(--accent); }
  @media (max-width: 620px) {
    .tally__row { grid-template-columns: 1fr; }
    .tally__cell + .tally__cell {
      border-left: 0; border-top: 1px solid var(--rule-soft);
      margin-top: clamp(20px, 4vh, 32px); padding-top: clamp(20px, 4vh, 32px);
    }
  }

  /* ── 7 · THE STILLS ─────────────────────────────────────────── */
  .grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(20px, 2.6vw, 46px); }
  .cel { margin: 0; }
  .cel__win { display: block; aspect-ratio: var(--ar); overflow: hidden; background: var(--ground-lift); }
  .cel__win :global(img) {
    width: 100%; height: 100%; object-fit: cover;
    filter: saturate(0.94) contrast(1.02);
    transform: scale(1.001);
    transition: filter var(--d-micro) var(--ease), transform 1100ms var(--ease);
  }
  .cel:hover .cel__win :global(img) { filter: saturate(1) contrast(1.06) brightness(1.04); transform: scale(1.035); }
  .cel__no {
    display: block; margin-top: 8px;
    font-size: var(--t-micro); letter-spacing: 0.16em;
    color: var(--dim); font-variant-numeric: tabular-nums;
  }
  @media (max-width: 720px) { .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }

  @media (prefers-reduced-motion: reduce) {
    .w { opacity: 1; transform: none; will-change: auto; }
  }
</style>

<script>
  /* IX's clock, for the statement only. A word's --v is how far its own top
     has risen past a line two thirds down the window, normalised over a third
     of a screen — so words light in reading order, the effect reverses on the
     way back up, and nothing is ever mid-animation while the reader is still.

     A word is written only when its value changes by enough to see: otherwise
     a few dozen spans times sixty frames is thousands of style writes a second
     for a change nobody can perceive. */
  function initStatement() {
    const root = document.querySelector<HTMLElement>('[data-wk]');
    if (!root || root.dataset.bound) return;
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    root.dataset.bound = '1';

    const words = Array.from(root.querySelectorAll<HTMLElement>('[data-w]'));
    if (!words.length) return;

    const last = new WeakMap<HTMLElement, number>();
    let raf = 0;
    const paint = () => {
      raf = 0;
      const line = innerHeight * 0.66;
      const span = innerHeight / 3;
      for (const el of words) {
        const t = el.getBoundingClientRect().top;
        const v = Math.min(1, Math.max(0, (line - t) / span));
        const prev = last.get(el);
        if (prev !== undefined && Math.abs(prev - v) < 0.02) continue;
        last.set(el, v);
        el.style.setProperty('--v', v.toFixed(3));
      }
    };
    const tick = () => { if (!raf) raf = requestAnimationFrame(paint); };
    paint();
    addEventListener('scroll', tick, { passive: true });
    addEventListener('resize', tick, { passive: true });
  }
  initStatement();
  document.addEventListener('astro:page-load', initStatement);
</script>
