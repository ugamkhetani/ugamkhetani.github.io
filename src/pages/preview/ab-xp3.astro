---
/**
 * XP3 · THE SENTENCE — the words are the apertures.
 *
 * THE IDEA: the page already carries a sentence that is the most considered
 * thing on it — "Sometimes the score is not there to tell you what is right."
 * Everywhere else that sentence sits beside the pictures. Here it IS the
 * pictures: each of eight words is cut through to a different frame, the
 * letterforms are the only windows onto the film, and scrolling pulls the
 * film through them so the images move INSIDE the type.
 *
 * WHY THIS AND NOT TYPE OVER AN IMAGE: type on top of a picture is a caption
 * with ambition. Type cut THROUGH to a picture inverts the hierarchy — the
 * words become the aperture plate and the photograph becomes the light. It
 * also means the type can never obscure the image, because the type is the
 * only place the image exists.
 *
 * WHICH WORDS CARRY A FRAME IS AN EDITORIAL DECISION and it is flagged below.
 * The function words — the, is, to — stay solid, so the sentence still reads
 * as a sentence and the eight content words carry the eight frames. That
 * rhythm of solid and cut is the typographic idea, and it is the reason this
 * does not end up as a novelty.
 *
 * THE FRAMES REMAIN AVAILABLE WHOLE. A section that only ever showed the
 * film through letterforms would be withholding the work, so every word is a
 * button: clicking opens that frame entire, beneath the sentence, at full
 * width. The experiment is the entry, not a cage.
 *
 * SCROLL MOVES THE FILM, NOT THE TYPE. background-position is driven from
 * the section's own travel, so the sentence is fixed on the page and the
 * footage runs behind it — which is the right way round for an aperture.
 */
import Base from '../../layouts/Base.astro';
import OpNav from '../../components/OpNav.astro';
import { Image, getImage } from 'astro:assets';
import { getCollection } from 'astro:content';
import { framesFor } from '../../lib/frames';
import { href } from '../../lib/href';

/* THE REAL WORK AND THE REAL STILLS. The collection is the same one
   /work/aasha renders from, so the frames, title, roles, statement and
   standfirst are the page's own, and the harness around the experiment is the
   work page's own type and rhythm. The ONLY variable between ab-xp1 and
   ab-xp8 is the section below the "03 · Stills" rule.

   THE PRODUCTION PAGE IS NOT TOUCHED. src/pages/work/[slug].astro is
   untouched by all eight, and `withoutPreview()` keeps these routes out of
   the built site. */
const works = await getCollection('works');
const work = works.find((w) => w.id === 'aasha')!;
const d = work.data;
const images = framesFor('aasha', d.frames);
const LEDE = (d.description.trim().match(/^[^.!?]+[.!?]/) ?? [d.description.trim()])[0];
const ROLES = d.role.split('·').map((r) => r.trim());
const nn = (i: number) => String(i + 1).padStart(2, '0');
/* `awards` is {text, star?}[], not a string — interpolating the array
   itself renders "[object Object]" in the colophon. */
const AWARDS = (d.awards ?? []).map((a: { text: string }) => a.text).join(' · ');

/* Optimised URLs for the drafts that need the frame inside a CSS property —
   a mask, a background, a band — where <Image> cannot reach. Astro emits
   these into the same /_astro/ directory as everything else. */
const WEB = await Promise.all(
  images.map((src) => getImage({ src, width: 1200, format: 'webp', quality: 78 })),
);

const DRAFTS: [string, string, string][] = [
  ['xp1', 'The score', 'The film’s light, measured and scrubbed'],
  ['xp2', 'The splice', 'You author the cut — 64 of them'],
  ['xp3', 'The sentence', 'The words are the apertures'],
  ['xp4', 'The field', 'A space larger than the window'],
  ['xp5', 'The persistence', 'It coheres only when you stop'],
  ['xp6', 'The attention', 'The band divides by how you looked'],
  ['xp7', 'The sort', 'Sequence against what the light implies'],
  ['xp8', 'The bath', 'Latent until it crosses the surface'],
];
const ME = 'xp3';
const MINE = DRAFTS.find(([id]) => id === ME)!;

/* <- MY CHOICE OF WHICH WORDS CARRY A FRAME, not anything the documents say.
   Eight content words out of twelve; the function words stay solid so the
   sentence still reads. If the statement is ever rewritten the indices stop
   describing it, so the fallback spreads eight picks evenly instead of
   silently cutting through "the" and "is". */
const WORDS = (d.quote ?? '').split(/\s+/).filter(Boolean);
const PICK = WORDS.length === 12
  ? [0, 2, 4, 5, 7, 8, 9, 11]
  : Array.from({ length: 8 }, (_, k) => Math.round((k * (WORDS.length - 1)) / 7));
const SLOT = new Map(PICK.map((w, i) => [w, i]));
/* Stripped here rather than in the markup: a regex literal inside an Astro
   expression is parsed as JSX and the apostrophe in the class ends the
   attribute, which fails the build with a stray ")". */
const BARE = WORDS.map((w) => w.replace(/[^A-Za-z']/g, ''));
---

<Base title={`${d.title} · ${MINE[1]} — stills ${ME.toUpperCase()}`} description={`An experimental direction for the stills section of the Aasha project page: ${MINE[2]}.`}>
  <OpNav variant="bracket" base={href()} />

  <nav class="sw" aria-label="Stills experiments">
    <span class="sw__id">{ME.toUpperCase()}</span>
    <span class="sw__nm">{MINE[1]}</span>
    <span class="sw__su">{MINE[2]}</span>
    <span class="sw__set">
      {DRAFTS.map(([id, name, sub]) => (
        <a class:list={['sw__i', { 'is-here': id === ME }]} href={href(`preview/ab-${id}`)}
          title={`${name} — ${sub}`} aria-current={id === ME ? 'page' : undefined}>{id.slice(2)}</a>
      ))}
      <a class="sw__prev" href={href('preview/ab-st1')} title="The first eight directions">ST1–8</a>
    </span>
  </nav>

  <article class="sc" style={`--ar:${d.ratio.replace(':', ' / ')}`}>
    <header class="hd">
      <p class="mono hd__over">{d.category} · {d.year}</p>
      <h1 class="hd__t">{d.title}</h1>
      <p class="mono hd__meta"><span class="hd__roles">{ROLES.map((r) => <span>{r}</span>)}</span></p>
    </header>

    {d.quote && (
      <section class="q" aria-label="Statement">
        <p class="q__t">{d.quote}</p>
      </section>
    )}

    <section class="blk body" aria-label="About">
      <p class="body__lede" style={`--n:${LEDE.length}`}>{LEDE}</p>
    </section>

    <!-- ══ 03 · STILLS — THE EXPERIMENT ══════════════════════════════ -->
    <section class="blk st" aria-label="Stills">
      <p class="mono st__lbl"><span>03</span><i aria-hidden="true"></i><span>Stills · {MINE[1]}</span></p>
      <div class="se" data-se>
        <p class="se__line">
          {WORDS.map((w, i) => (
            SLOT.has(i)
              ? <button class="se__w se__w--cut" type="button" data-se-w={SLOT.get(i)}
                  style={`--img:url(${WEB[SLOT.get(i)!].src})`}
                  aria-label={`${w} — frame ${nn(SLOT.get(i)!)}, open it whole`}>{w}</button>
              : <span class="se__w se__w--solid">{w}</span>
          ))}
        </p>

        <div class="se__key mono" role="group" aria-label="Which frame is in which word">
          {PICK.map((w, i) => (
            <button class="se__k" type="button" data-se-k={i} aria-label={`Frame ${nn(i)}, in the word ${WORDS[w]}`}>
              <b>{nn(i)}</b><span>{BARE[w]}</span>
            </button>
          ))}
        </div>

        <div class="se__plate" data-se-plate hidden>
          <div class="se__hold">
            {images.map((img, i) => (
              <span class:list={['se__p', { 'is-on': i === 0 }]} data-se-p={i}>
                <Image src={img} alt={i === 0 ? d.alt : ''} aria-hidden={i === 0 ? undefined : 'true'}
                  widths={[760, 1140, 1520]} sizes="(max-width: 900px) 94vw, 900px"
                  loading="lazy" decoding="async" />
              </span>
            ))}
          </div>
          <p class="mono se__pcap">
            <b data-se-pno>01</b>
            <span>in “<em data-se-pw></em>”</span>
            <i aria-hidden="true"></i>
            <button class="se__close" type="button" data-se-close>Close ×</button>
          </p>
        </div>

        <p class="mono hint">
          <em>Scroll runs the film through the type</em>
          <i aria-hidden="true"></i>
          <span>Click any cut word to see that frame whole</span>
        </p>
      </div>
    </section>

    <footer class="cl">
      <hr class="rule" />
      <p class="mono cl__p"><span>{MINE[0].toUpperCase()} · {MINE[1]}</span><i aria-hidden="true"></i><span>{AWARDS}</span></p>
    </footer>
  </article>
</Base>

<script>
  /* THE FILM RUNS, THE SENTENCE DOES NOT. --run is the section's own travel
     through the viewport, 0 to 1, written once per frame onto one element. */
  const se = document.querySelector('[data-se]');
  if (se) {
    const cuts = [...se.querySelectorAll('[data-se-w]')];
    const keys = [...se.querySelectorAll('[data-se-k]')];
    const plate = se.querySelector('[data-se-plate]');
    const pics = [...se.querySelectorAll('[data-se-p]')];
    const pno = se.querySelector('[data-se-pno]');
    const pw = se.querySelector('[data-se-pw]');
    let queued = false;

    const run = () => {
      queued = false;
      const b = se.getBoundingClientRect();
      const span = b.height + innerHeight;
      if (span <= 0) return;
      const p = Math.min(1, Math.max(0, (innerHeight - b.top) / span));
      se.style.setProperty('--run', p.toFixed(4));
    };
    const tick = () => { if (!queued) { queued = true; requestAnimationFrame(run); } };
    addEventListener('scroll', tick, { passive: true });
    addEventListener('resize', tick);
    run();

    const open = (i) => {
      pics.forEach((p, k) => p.classList.toggle('is-on', k === i));
      cuts.forEach((c, k) => c.classList.toggle('is-lit', k === i));
      if (pno) pno.textContent = String(i + 1).padStart(2, '0');
      if (pw) pw.textContent = cuts[i].textContent.replace(/[^A-Za-z']/g, '');
      plate.hidden = false;
    };
    const close = () => {
      plate.hidden = true;
      cuts.forEach((c) => c.classList.remove('is-lit'));
    };

    cuts.forEach((c, i) => c.addEventListener('click', () => (plate.hidden || !c.classList.contains('is-lit') ? open(i) : close())));
    keys.forEach((k, i) => {
      k.addEventListener('click', () => open(i));
      /* Hovering the key lights its word in the sentence — the key is a map
         of the sentence, so it should point at it. */
      k.addEventListener('pointerenter', () => cuts[i].classList.add('is-lit'));
      k.addEventListener('pointerleave', () => { if (plate.hidden) cuts[i].classList.remove('is-lit'); });
    });
    se.querySelector('[data-se-close]')?.addEventListener('click', close);
    addEventListener('keydown', (e) => { if (e.key === 'Escape' && !plate.hidden) close(); });

    window.seRun = run;
    window.seOpen = open;
    window.seState = () => ({ run: getComputedStyle(se).getPropertyValue('--run').trim(), open: !plate.hidden });
  }
</script>

<style>
  /* ══ THE HARNESS ═══════════════════════════════════════════════════
     The work page's own type and rhythm, shared verbatim by all eight, so
     the only thing being judged below the rule is the stills section. */
  .sw {
    position: fixed; inset: 0 0 auto; z-index: 900;
    display: flex; align-items: baseline; gap: 12px;
    padding: 9px clamp(16px, 4vw, 40px);
    background: color-mix(in srgb, var(--ground) 86%, transparent);
    backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--rule);
    font-family: var(--mono); font-size: var(--t-micro);
    letter-spacing: 0.16em; text-transform: uppercase;
  }
  .sw__id { color: var(--accent); }
  .sw__nm { color: var(--bone); }
  .sw__su { color: var(--dim); margin-right: auto; }
  .sw__set { display: flex; gap: 1px; align-items: baseline; }
  .sw__i {
    color: var(--dim); text-decoration: none; padding: 3px 7px;
    border: 1px solid transparent; font-variant-numeric: tabular-nums;
  }
  .sw__i:hover { color: var(--bone); }
  .sw__i.is-here { color: var(--accent); border-color: var(--rule); }
  .sw__prev { color: color-mix(in srgb, var(--dim) 70%, var(--ground)); text-decoration: none; padding: 3px 0 3px 12px; margin-left: 6px; border-left: 1px solid var(--rule); }
  .sw__prev:hover { color: var(--bone-dim); }
  @media (max-width: 860px) { .sw__su { display: none; } .sw__nm { margin-right: auto; } }
  @media (max-width: 560px) { .sw__nm, .sw__prev { display: none; } }

  .sc { padding: clamp(84px, 13vh, 150px) var(--margin) 0; }
  .hd { text-align: center; margin-bottom: clamp(38px, 6.6vh, 80px); }
  .hd__over { font-size: var(--t-micro); letter-spacing: 0.18em; text-transform: uppercase; color: var(--muted); margin: 0 0 clamp(16px, 2.6vh, 30px); }
  .hd__t { margin: 0; font-family: var(--display); font-weight: 500; font-size: clamp(2.6rem, 7vw, 5.6rem); line-height: 0.94; letter-spacing: -0.04em; color: var(--bone); }
  .hd__meta { margin: clamp(14px, 2.2vh, 26px) 0 0; font-size: var(--t-micro); letter-spacing: 0.18em; text-transform: uppercase; color: var(--bone-dim); }
  .hd__roles { display: inline-flex; flex-wrap: wrap; justify-content: center; gap: 0 14px; }
  .hd__roles span + span::before { content: '·'; margin-right: 14px; color: var(--dim); }
  .q { max-width: 34ch; margin: 0 auto clamp(50px, 8vh, 110px); text-align: center; }
  .q__t { margin: 0; font-family: var(--serif); font-style: italic; font-weight: 300; font-size: clamp(1.25rem, 2.4vw, 1.9rem); line-height: 1.26; letter-spacing: -0.012em; color: var(--bone-dim); }
  .body { max-width: var(--measure); margin-inline: auto; }
  .body__lede { margin: 0 auto; max-width: clamp(20ch, calc(var(--n, 90) / 3 * 1ch), 44ch); font-family: var(--display); font-weight: 500; font-size: clamp(1.2rem, min(calc(2.35rem - (var(--n, 90) - 55) * 0.007rem), calc(1.05rem + 2.1vw)), 2.2rem); line-height: 1.12; letter-spacing: -0.025em; color: var(--bone); text-wrap: balance; }
  .blk { margin: 0 auto clamp(104px, 18vh, 240px); }

  .st { --w: var(--measure); }
  .st__lbl {
    display: flex; align-items: center; gap: 12px;
    width: var(--w); margin: 0 auto clamp(24px, 4vh, 50px);
    font-size: var(--t-micro); letter-spacing: 0.18em; text-transform: uppercase; color: var(--muted);
  }
  .st__lbl i { flex: 1; height: 1px; background: var(--rule); }

  /* The one piece of furniture every experiment shares: a line of mono that
     says what the thing in front of you responds to. An experimental
     interaction that nobody can find is a failed one. */
  .hint {
    display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap;
    width: var(--w); margin: 14px auto 0;
    font-size: var(--t-micro); letter-spacing: 0.16em; text-transform: uppercase; color: var(--dim);
  }
  .hint b { font-weight: 400; color: var(--accent); font-variant-numeric: tabular-nums; }
  .hint em { font-style: normal; color: var(--muted); }
  .hint i { flex: 1; min-width: 20px; height: 1px; background: var(--rule); transform: translateY(-3px); }

  .cl { max-width: var(--measure); margin: 0 auto; padding-bottom: clamp(48px, 9vh, 110px); }
  .rule { border: 0; border-top: 1px solid var(--rule); margin: 0 0 16px; }
  .cl__p { display: flex; align-items: baseline; gap: 14px; margin: 0; font-size: var(--t-micro); letter-spacing: 0.16em; text-transform: uppercase; color: var(--dim); }
  .cl__p i { flex: 1; height: 1px; background: var(--rule); transform: translateY(-3px); }
  .cl__p span:last-child { text-align: right; }
  @media (max-width: 620px) { .cl__p { flex-direction: column; gap: 6px; } .cl__p i { display: none; } .cl__p span:last-child { text-align: left; } }

  /* ── XP3 · THE SENTENCE ────────────────────────────────────── */
  .st { --w: min(calc(100vw - 2 * var(--margin)), 1180px); }
  .se { width: var(--w); margin-inline: auto; --run: 0; }

  .se__line {
    margin: 0; display: flex; flex-wrap: wrap; align-items: baseline;
    gap: 0 0.22em;
    font-family: var(--display); font-weight: 500;
    font-size: clamp(2.7rem, 10.4vw, 9.4rem); line-height: 0.92; letter-spacing: -0.045em;
    text-wrap: balance;
  }
  .se__w { display: inline-block; padding: 0; border: 0; background: none; font: inherit; letter-spacing: inherit; }
  .se__w--solid { color: color-mix(in srgb, var(--bone) 26%, var(--ground)); }

  /* THE APERTURE. The frame is the paint and the letterform is the stencil;
     --run is the section's travel, so the footage moves and the type does not. */
  .se__w--cut {
    cursor: pointer; -webkit-tap-highlight-color: transparent;
    color: transparent;
    background-image: var(--img);
    background-size: auto 190%;
    background-position: 50% calc(18% + var(--run) * 64%);
    background-repeat: no-repeat;
    -webkit-background-clip: text; background-clip: text;
  }
  /* Safari and Firefox both honour background-clip:text, but a browser that
     does not would render a solid block over the sentence. This keeps the
     word legible there instead. */
  @supports not ((-webkit-background-clip: text) or (background-clip: text)) {
    .se__w--cut { color: var(--bone); background-image: none; }
  }
  .se__w--cut:hover, .se__w--cut:focus-visible { background-size: auto 215%; }
  .se__w--cut:focus-visible { outline: 1px solid var(--accent); outline-offset: 4px; }
  .se__w--cut.is-lit { background-size: auto 230%; }
  @media (prefers-reduced-motion: no-preference) {
    .se__w--cut { transition: background-size 260ms cubic-bezier(0.2, 0.8, 0.2, 1); }
  }

  .se__key {
    display: flex; flex-wrap: wrap; gap: 1px;
    margin-top: clamp(22px, 3.4vh, 42px); border-top: 1px solid var(--rule); padding-top: 11px;
  }
  .se__k {
    display: flex; align-items: baseline; gap: 7px; padding: 4px 11px 4px 0;
    border: 0; background: none; cursor: pointer;
    font-family: var(--mono); font-size: var(--t-micro); letter-spacing: 0.16em; text-transform: uppercase;
    color: var(--dim);
  }
  .se__k b { font-weight: 400; color: var(--muted); font-variant-numeric: tabular-nums; }
  .se__k:hover, .se__k:focus-visible { color: var(--bone); }
  .se__k:hover b, .se__k:focus-visible b { color: var(--accent); }
  .se__k:focus-visible { outline: 1px solid var(--accent); outline-offset: 1px; }

  .se__plate { margin-top: clamp(20px, 3vh, 36px); }
  .se__plate[hidden] { display: none; }
  .se__hold { position: relative; aspect-ratio: var(--ar); background: var(--ground-lift); overflow: hidden; }
  .se__p { position: absolute; inset: 0; opacity: 0; }
  .se__p.is-on { opacity: 1; }
  .se__p img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .se__pcap {
    display: flex; align-items: baseline; gap: 12px; margin: 10px 0 0;
    font-size: var(--t-micro); letter-spacing: 0.16em; text-transform: uppercase; color: var(--dim);
  }
  .se__pcap b { font-weight: 400; color: var(--accent); font-variant-numeric: tabular-nums; }
  .se__pcap em { font-style: normal; color: var(--bone-dim); }
  .se__pcap i { flex: 1; height: 1px; background: var(--rule); transform: translateY(-3px); }
  .se__close { border: 0; background: none; padding: 0; cursor: pointer; font: inherit; letter-spacing: inherit; color: var(--dim); }
  .se__close:hover { color: var(--bone); }

  @media (max-width: 620px) {
    .se__line { font-size: clamp(2.1rem, 13vw, 4rem); gap: 0 0.18em; }
  }
</style>
