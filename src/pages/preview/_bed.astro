---
/**
 * THE BED — the live hero's mosaic and its layers, and nothing else.
 *
 * NOT A DRAFT. The leading underscore keeps Astro from routing it and the
 * preview index from listing it; it is the shared surface the eight hero
 * drafts are composed ON, so that what varies between them is typography
 * and only typography.
 *
 * THE MOSAIC IS NOT COPIED, IT IS RECOMPUTED FROM THE SAME TABLES. The cast,
 * the swaps, the per-work crops and the per-frame grades all come from
 * src/lib/bed.ts and the composition — the same imports index.astro makes,
 * in the same order, through the same Still component. bed.ts says in its
 * own header that it was split out so the mosaic drafts could do exactly
 * this rather than keep a second copy. A tile cannot drift from the live
 * one without the live one drifting too.
 *
 * THE LAYER CSS IS EXTRACTED, NOT RETYPED. The nineteen rules below are
 * .rg, .ms__ground, .ms__bed, .ms__tile, .ap__mat and .sm, lifted out of
 * index.astro's own stylesheet with their media context intact. They are
 * `is:global` because the drafts' markup is not in this file's scope.
 *
 * <- THE SCROLL RAMP IS HERE NOW, AND THE NOTE THAT USED TO SIT HERE WAS
 *   WRONG. It said the drafts hold --smoke and --haze "at their start
 *   values — which is exactly the state the live hero is in at scroll 0".
 *   They held .rg's DECLARED values, 1 and 7px. The live hero's animation
 *   fills BACKWARDS from its 0% keyframe, so at scroll 0 the running page
 *   is --smoke: 0 and --haze: 0px. Measured on the page: .sm fully
 *   transparent and blur(0px) from scrollY 0 to 400, ramping to 0.26 and
 *   7px by about 850.
 *
 *   So every draft built on this bed showed the hero 26% darker and 14px
 *   softer than the hero actually is. The fix is not a different constant:
 *   it is the real timeline, below, owned by a stand-in works section, so
 *   the ramp runs here exactly as it runs on the page.
 *
 * <- THE DRAFT NAVIGATOR AT THE FOOT IS CHROME, NOT COMPOSITION. It exists
 *   so eight directions can be compared in two clicks. Read past it.
 */
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { composition } from '../../data/composition';
import { BED_SWAPS, BED_CROP, BED_GRADE, BED_TILES, BED_CELLS } from '../../lib/bed';
import Still from '../../components/Still.astro';

interface Props { no: string; name: string; idea: string; }
const { no, name, idea } = Astro.props;

const works = await getCollection('works');
const bySlug = new Map(works.map((w) => [w.id, w]));

const wnodes: { w: any }[] = [];
for (const stanza of composition) {
  for (const p of stanza.items) wnodes.push({ w: bySlug.get(p.slug)! });
}
const bedCast = wnodes.map((n) => {
  const to = BED_SWAPS[n.w.id];
  return to ? { ...n, w: bySlug.get(to)! } : n;
});
const GROUND_TILES = Array.from({ length: BED_TILES }, (_, i) => {
  const pick = BED_CELLS[i];
  if (pick) return { w: bySlug.get(pick.slug)!, frames: [pick.frame], set: true };
  const n = bedCast[i % bedCast.length];
  return { w: n.w, frames: n.w.data.frames, set: false };
});

const ALL = [
  ['d1', 'Half-lit'], ['d2', 'Open'], ['d3', 'Bright'], ['d4', 'Full'],
];
---

<Base title={`${no} · ${name} — hero drafts`} description={`A Swiss-poster reading of the home page hero: ${idea}`}>
  <div class="rg">
    <div class="ms__ground" aria-hidden="true">
      <div class="ms__bed">
        {GROUND_TILES.map((c) => (
          <span
            class="ms__tile"
            class:list={[{ 'ms__tile--crop': !!BED_CROP[c.w.id] }]}
            style={[
              BED_CROP[c.w.id] && `--crop-s:${BED_CROP[c.w.id].scale};--crop-y:${BED_CROP[c.w.id].shiftY}%`,
              !c.set && BED_GRADE[c.w.id] && `--bed-k:${BED_GRADE[c.w.id].contrast}`,
            ].filter(Boolean).join(';') || undefined}
          >
            <Still slug={c.w.id} title={c.w.data.title} year={c.w.data.year}
              category={c.w.data.category} ratio={c.w.data.ratio}
              frames={c.frames} alt={c.w.data.alt}
              sizes="20vw" eager={false} max={1} free={true} />
          </span>
        ))}
      </div>
    </div>

    <div class="ap__mat" aria-hidden="true"></div>
    <div class="sm" aria-hidden="true"></div>

    <slot />

    {/* The ramp needs something to be keyed to. On the page that is the
        conveyor; here it is a plain tall section carrying the same
        view-timeline-name, so entry 50%..100% resolves to the same stretch
        of scroll it does live — the hero leaving, Selected works arriving.
        Scroll down: the bed returns to the running grade. */}
    <section class="wk" aria-label="Selected works (stand-in for the ramp)">
      <p class="wk__k">Selected works</p>
      <p class="wk__n">By here the bed is back to the running site's own grade.</p>
    </section>

    <nav class="dnav" aria-label="Hero drafts">
      <span class="dnav__k">{no}</span>
      <ol class="dnav__l">
        {ALL.map(([slug, t]) => (
          <li><a href={`/preview/ab-${slug}`} aria-current={slug === no.toLowerCase() ? 'page' : undefined}>{slug.toUpperCase()}<span>{t}</span></a></li>
        ))}
      </ol>
      <a class="dnav__b" href="/preview/">All drafts</a>
    </nav>
  </div>
</Base>

<style is:global>
  /* ══ LIFTED FROM index.astro — the mosaic and its layers ══════════
     Every rule whose selector is `.rg` or ends in one of the layer
     names, at any depth, with its media context intact. The descendant
     forms matter most: `.rg .sm` and `:root .rg .sm` carry the real
     smoke alpha and backdrop, and a first pass that matched only the
     bare `.sm` rendered the bed at 0.55 against the live 0.26. */
  .rg { --tier-0: clamp(2.75rem, 10vw, 9rem); --tier-1: clamp(2.5rem, 8vw, 7.5rem); --tier-2: clamp(1.75rem, 5vw, 4.25rem); --tier-3: clamp(1.5rem, 2.8vw, 2.5rem); --tier-4: clamp(1.0625rem, 1.35vw, 1.375rem); padding-inline: var(--margin); padding-bottom: 20vh; }
  .rg { position: relative; }
  .ms__ground { position: fixed; inset: 0; z-index: 0; pointer-events: none; overflow: hidden; }
  .ms__bed { position: absolute; inset: -10%; display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); grid-auto-rows: minmax(0, 1fr); gap: clamp(5px, 0.8vw, 13px); transform: translate3d(0, calc(var(--prog, 0) * -8%), 0) scale(1.06); will-change: transform; }
  .ms__tile { display: block; overflow: hidden; min-height: 0; border-radius: clamp(6px, 0.7vw, 12px); filter: brightness(0.30) saturate(0.7) contrast(var(--bed-k, 1.05)); }
  .ms__panel { margin: clamp(24px, 4.4vh, 58px) auto 0; max-width: 78ch; padding: clamp(22px, 3.6vh, 46px) clamp(20px, 3vw, 44px); background: var(--ground); border: 1px solid var(--rule-soft); border-radius: clamp(10px, 1.2vw, 20px); }
  @media (max-width: 900px) {
    .ms__bed { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }
  .ap__mat { position: fixed; z-index: 1; pointer-events: none; inset: calc(11vh + (1 - var(--lit, 0)) * 15vh) calc(7vw + (1 - var(--lit, 0)) * 13vw); box-shadow: 0 0 0 100vmax var(--ground); border: 1px solid var(--rule); border-radius: 2px; }
  .rg { --body-size: clamp(1.1rem, 1.5vw, 1.36rem); --body-lead: 1.66; --list-size: clamp(1rem, 1.2vw, 1.1rem); }
  .rg { --mat-h: calc(7vw + (1 - var(--lit, 0)) * 13vw - var(--read, 0) * 4.6vw); --win: calc(100vw - 2 * var(--mat-h)); }
  .ap__mat { inset: calc(11vh + (1 - var(--lit, 0)) * 15vh) var(--mat-h); }
  .ms__panel { max-width: min(76ch, calc(var(--win) - 90px)); }
  [data-mv="2"] .ms__panel { max-width: min(940px, calc(var(--win) - 120px)); }
  [data-mv="5"] .ms__panel { max-width: min(1080px, calc(var(--win) - 110px)); }
  .rg .ap__mat { display: none; }
  .rg { --smoke: 1; --haze: 7px; --veil: 100%; --iris: 0%; }
  :root .rg { timeline-scope: --works; }
  .sm { position: fixed; inset: 0; z-index: 1; pointer-events: none; background: color-mix(in srgb, var(--ground) calc(var(--smoke) * 55%), transparent); -webkit-backdrop-filter: blur(var(--haze)); backdrop-filter: blur(var(--haze)); }
  @media (prefers-reduced-motion: reduce) {
    .rg { --smoke: 1; --haze: 7px; --veil: 100%; --iris: 0%; }
  }
  .rg .sm { background: color-mix(in srgb, var(--ground) calc(var(--smoke) * 55%), transparent); -webkit-backdrop-filter: none; backdrop-filter: none; }
  .rg .ms__bed { filter: brightness(0.30) saturate(0.7) contrast(1.05); }
  .rg .ms__tile { filter: none; }
  :root[data-blur] .rg .ms__bed { filter: brightness(0.30) saturate(0.7) contrast(1.05) blur(var(--haze)); }
  :root .rg .sm { background: color-mix(in srgb, var(--ground) calc(var(--smoke) * 26%), transparent); -webkit-backdrop-filter: blur(calc(var(--haze) * 2)) saturate(1.2) brightness(0.86); backdrop-filter: blur(calc(var(--haze) * 2)) saturate(1.2) brightness(0.86); }
  :root[data-blur] .rg .ms__bed, :root .rg .ms__bed { filter: brightness(0.34) saturate(0.78) contrast(1.05); }
  :root .rg { --mono: var(--display); }

  /* ══ DRAFT CHROME — not part of any composition ═══════════════════ */
  .dnav {
    position: fixed; left: 0; right: 0; bottom: 0; z-index: 40;
    display: flex; align-items: center; gap: 18px;
    padding: 9px var(--margin) calc(9px + env(safe-area-inset-bottom, 0px));
    background: color-mix(in srgb, var(--ground) 86%, transparent);
    backdrop-filter: blur(9px);
    border-top: 1px solid color-mix(in srgb, var(--bone) 12%, transparent);
    font-family: var(--mono); font-size: 10px; letter-spacing: 0.1em; text-transform: uppercase;
  }
  .dnav__k { color: var(--accent); flex: none; }
  .dnav__l { display: flex; gap: 14px; list-style: none; margin: 0; padding: 0; overflow-x: auto; flex: 1; }
  .dnav__l a { color: var(--dim); text-decoration: none; white-space: nowrap; display: flex; gap: 6px; }
  .dnav__l a span { color: color-mix(in srgb, var(--bone) 22%, transparent); }
  .dnav__l a:hover { color: var(--bone); }
  .dnav__l a[aria-current] { color: var(--bone); }
  .dnav__l a[aria-current] span { color: var(--accent); }
  .dnav__b { color: var(--dim); text-decoration: none; flex: none; }
  .dnav__b:hover { color: var(--accent); }
  @media (max-width: 720px) { .dnav__l a span { display: none; } }

  /* The accent word, exactly as index.astro sets it. */
  .hot { color: var(--accent); text-transform: none; font-family: var(--serif);
         font-style: italic; font-weight: 300; font-size: 1.06em; }

  /* Every draft composes inside this. One viewport, nothing below it. */
  .hz { position: relative; z-index: 2; min-height: 100svh; }

  /* ══ THE RAMP, LIFTED FROM index.astro ═══════════════════════════
     Same timeline, same range, same keyframes — so --smoke and --haze
     behave here exactly as they do on the page, and the hero starts clean
     (0 and 0px) instead of pre-darkened. */
  :root .rg { timeline-scope: --works; }
  :root .rg .wk { view-timeline-name: --works; view-timeline-axis: block; }

  .wk { position: relative; z-index: 2; min-height: 210vh; padding-top: 12vh;
    display: flex; flex-direction: column; gap: 10px; }
  .wk__k { margin: 0; font-family: var(--mono); font-size: 10px; letter-spacing: 0.16em;
    text-transform: uppercase; color: var(--bone-dim); }
  .wk__n { margin: 0; font-family: var(--display); font-weight: 500; color: var(--dim);
    font-size: clamp(1rem, 1.6vw, 1.3rem); letter-spacing: -0.02em; max-width: 30ch; }

  /* THE ONE NEW PROPERTY. Registered so it interpolates — unregistered, a
     custom property snaps at the halfway mark, which on a brightness
     multiplier is a visible step rather than a morph. */
  @property --lift { syntax: '<number>'; inherits: true; initial-value: 1; }
  .rg { --lift: 1; }

  /* The running site's grade, multiplied by the lift. At --lift: 1 this is
     brightness(0.34) — what the page ships. Each draft supplies its own 0%
     value in its own @keyframes bed-lift. */
  :root[data-blur] .rg .ms__bed,
  :root .rg .ms__bed {
    filter: brightness(calc(0.34 * var(--lift))) saturate(0.78) contrast(1.05);
  }

  @supports (animation-timeline: scroll(root block)) {
    @media (prefers-reduced-motion: no-preference) {
      .rg {
        animation: sm-haze linear both, sm-ground linear both, bed-lift linear both;
        animation-timeline: --works, --works, --works;
        animation-range: entry 50% entry 100%, entry 50% entry 100%, entry 50% entry 100%;
      }
    }
  }
  @keyframes sm-haze   { 0% { --haze: 0px; } 55% { --haze: 7px; } 100% { --haze: 7px; } }
  @keyframes sm-ground { 0% { --smoke: 0; }  55% { --smoke: 0.4; } 100% { --smoke: 1; } }

  /* Reduced motion gets the destination, not the journey — as on the page. */
  @media (prefers-reduced-motion: reduce) {
    .rg { --smoke: 1; --haze: 7px; --lift: 1; }
  }
</style>
