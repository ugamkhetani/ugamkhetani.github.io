---
/**
 * PREVIEW — MOSAIC K · "LIVE, SWAPPED II".
 *
 * THIS IS THE BED THAT IS ON THE SITE RIGHT NOW, with two works exchanged and
 * two frames cropped. Nothing else about it is touched — not the sixteen-work
 * cycle, not the order, not the thirty tiles, not the geometry. It is the
 * smallest possible change to what is already live, which is what separates it
 * from D through I: those all replace the cycle with a ranked selection of
 * twelve, and this keeps the catalogue running as it does today.
 *
 * THE ORDER IS THE SCORE'S OWN. The live bed walks `order` from
 * src/data/composition.ts — the sequence the works appear in down the page —
 * and repeats it until thirty tiles are filled, so a work's place in the bed is
 * its place in the composition. That is read from the same export here rather
 * than copied, so it cannot drift from the score.
 *
 * THE SUBSTITUTIONS ARE MADE IN THE SEQUENCE, NOT IN THE GRID. Dinshaw's sits
 * at index 13 of the sixteen and Ve Maahi at 14; those two slots now hold
 * Diwali Ke Shor Mein and Aasha. Because the cycle repeats, each of those two
 * works appears in the bed twice — once in its own slot and once in the
 * borrowed one.
 *
 * AND THEN AASHA AND MERE HO EXCHANGE PLACES, which is what separates this from
 * J. Aasha moves to index 15 and Mere Ho to 14, so Aasha takes cell 15 — the
 * single clearest cell on the bed, measured unobstructed 0.48 of the time —
 * and Mere Ho takes 14 at 0.47. In J the best cell on the whole bed was
 * spent on Mere Ho.
 *
 * THREE FRAMES ARE CROPPED, FOR TWO DIFFERENT REASONS. Broken Reflections and
 * Diwali carry letterbox bars burned into the file — 21.3% and 13.2% of the
 * frame. Mere Ho carries the record's own title instead: it is a 640 square
 * with "mere ho" and "HEEYA TIKKU" set into the lower right, measured at 0.844
 * to 0.931 of the height. Its crop moves the image DOWN so the type falls past
 * the bottom edge, which is the opposite direction from Diwali's. All three
 * factors are in CROP in src/lib/_pv-mosaic.ts.
 */
import Base from '../../layouts/Base.astro';
import Stage from '../../components/_pv-MosaicStage.astro';
import Tile from '../../components/_pv-MosaicTile.astro';
import { getCollection } from 'astro:content';
import { order } from '../../data/composition';
import { CROP, BEST_FRAME, CLEAR_RANK } from '../../lib/_pv-mosaic';

const works = await getCollection('works');
const bySlug = new Map(works.map((w) => [w.id, w]));

/* The live sequence, with the two asked-for exchanges made in place. */
const SWAPS: Record<string, string> = {
  'dinshaws-dildaari-battles': 'diwali-ke-shor-mein',
  've-maahi': 'aasha',
};
const swapped = order.map((slug) => ({ slug: SWAPS[slug] ?? slug, was: SWAPS[slug] ? slug : null }));

/* Then Aasha and Mere Ho trade places in the sequence — indices 14 and 15 —
   which hands Aasha cell 15, the clearest cell on the bed.

   THE AASHA WANTED IS THE ONE SWAPPED IN FOR VE MAAHI, not Aasha's own slot at
   index 2. Matching on the slug alone finds index 2 first and exchanges the
   wrong pair: Aasha ends up in cells 14 AND 15, two identical frames side by
   side in the two best cells, with Mere Ho pushed into cells nothing ever
   sees. The `was` marker is what distinguishes the borrowed slot. */
const A = swapped.findIndex((c) => c.was === 've-maahi');
const M = swapped.findIndex((c) => c.slug === 'mere-ho');
const CYCLE = swapped.slice();
CYCLE[A] = { ...swapped[M], moved: true } as any;
CYCLE[M] = { ...swapped[A], moved: true } as any;

/* index.astro's own line: thirty tiles, the cycle repeating. */
const TILES = Array.from({ length: 30 }, (_, i) => {
  const c = CYCLE[i % CYCLE.length];
  return { ...c, w: bySlug.get(c.slug)!, cell: i };
});

const CLEAR = new Map(CLEAR_RANK.map((c) => [c.cell, c.clear]));
---

<Base title="Mosaic K — Live, swapped II" description="Preview only.">
  <Stage
    letter="K"
    name="Live, swapped II"
    note="J, with Aasha and Mere Ho exchanged as well. Aasha takes cell 15 — the single clearest cell on the bed, unobstructed 0.48 of the time — and Mere Ho takes 14. Mere Ho carries the record's title burned into the artwork, so it is cropped downward until the type falls past the bottom edge. The sixteen-work cycle, the order, the thirty tiles and the geometry are all still unchanged."
  >
    <div class="ms__ground" slot="bed" aria-hidden="true">
      <div class="ms__bed">
        {TILES.map((t) => (
          <span class="ms__tile" class:list={[{ 'is-swap': !!t.was || !!(t as any).moved, 'is-clear': (CLEAR.get(t.cell) ?? 0) > 0 }]}>
            <Tile slug={t.w.id} frames={t.w.data.frames} alt=""
              pick={BEST_FRAME[t.w.id] ?? 1} crop={CROP[t.w.id]} />
            <span class="ms__mark mono" aria-hidden="true">
              <b>{t.cell}</b>
              {t.w.data.title}
              <i>
                {t.was ? `swapped in for ${t.was.split('-')[0]}` :
                 (t as any).moved ? `moved · clear ${CLEAR.get(t.cell) ?? 0}` :
                 (CLEAR.get(t.cell) ?? 0) > 0 ? `clear ${CLEAR.get(t.cell)}` : 'never seen'}
              </i>
            </span>
          </span>
        ))}
      </div>
    </div>
  </Stage>
</Base>

<style>
  /* ── index.astro's bed, copied declaration for declaration ─────── */
  .ms__ground { position: fixed; inset: 0; z-index: 0; pointer-events: none; overflow: hidden; }
  .ms__bed {
    position: absolute; inset: -10%;
    display: grid; grid-template-columns: repeat(6, minmax(0, 1fr));
    grid-auto-rows: minmax(0, 1fr); gap: clamp(5px, 0.8vw, 13px);
    filter: brightness(0.30) saturate(0.7) contrast(1.05);
    transform: translate3d(0, calc(var(--prog, 0) * -8%), 0) scale(1.06);
    will-change: transform;
  }
  .ms__tile { position: relative; display: block; overflow: hidden; min-height: 0; border-radius: clamp(6px, 0.7vw, 12px); }
  .ms__tile :global(img) { border-radius: inherit; }

  /* ── the cell map, off unless asked for ───────────────────────── */
  .ms__mark { display: none; }
  :global(.rg.map-on) .ms__bed { filter: brightness(0.62) saturate(0.7) contrast(1.05); }
  :global(.rg.map-on) .ms__tile { outline: 1px solid rgba(255, 255, 255, 0.1); outline-offset: -1px; }
  :global(.rg.map-on) .ms__tile.is-clear { outline-color: var(--rule-accent); }
  :global(.rg.map-on) .ms__tile.is-swap { outline: 2px solid var(--accent); }
  :global(.rg.map-on) .ms__mark {
    position: absolute; inset: 0; z-index: 2;
    display: grid; align-content: center; justify-items: center; gap: 3px;
    padding: 6px; text-align: center;
    font-size: 9px; letter-spacing: 0.08em; line-height: 1.25;
    color: var(--bone); background: rgba(6, 6, 5, 0.62);
  }
  :global(.rg.map-on) .ms__mark b { font-size: 15px; letter-spacing: 0; color: var(--dim); }
  :global(.rg.map-on) .ms__tile.is-clear .ms__mark b { color: var(--bone); }
  :global(.rg.map-on) .ms__tile.is-swap .ms__mark b { color: var(--accent); }
  :global(.rg.map-on) .ms__tile:not(.is-clear) .ms__mark { background: rgba(6, 6, 5, 0.85); color: var(--dim); }
  :global(.rg.map-on) .ms__mark i { font-style: normal; font-size: 8px; color: var(--dim); }
  :global(.rg.map-on) .ms__tile.is-swap .ms__mark i { color: var(--accent); }

  @media (max-width: 900px) {
    .ms__bed { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }
</style>
