---
/**
 * PREVIEW — RECOGNITION C · "REGISTER".
 *
 * THE HONOUR IS STATED ONCE. Diwali's two awards are both Official Selections,
 * and the live page prints those two words twice inside a line that already
 * repeats itself. Here identical citations are collapsed into one heading and
 * the festivals are filed beneath it — so the section says "Official Selection"
 * once, in the accent, and then names the two festivals that made it.
 *
 * IT CARRIES A FIGURE, WHICH IS HOW THE REST OF THE SITE COUNTS. Aasha and
 * Broken Reflections already set their recognition as big tabular figures —
 * 7 Official Selections, 10 Nominations, 6 Wins. This puts Diwali in the same
 * voice: 02, set as a figure, against the honour it counts. A work with two
 * selections and a work with seven then read as the same kind of statement at
 * different scales, instead of one being a number and the other a sentence.
 *
 * IT IS THE ONLY DRAFT THAT SCALES BOTH WAYS. One citation with two bodies is
 * a group of two; five citations with one body each are five groups of one; a
 * bare award with no body at all ("India's First AI Rap Battle") is a heading
 * with a figure and nothing under it, which still reads. Nothing has to be
 * special-cased for a work that has not been made yet.
 *
 * THE RISK, STATED PLAINLY: grouping is only an improvement while citations
 * actually repeat. On the fourteen works with a single award it collapses to
 * one heading and one line — correct, but no better than Index would be. It
 * earns its keep on Diwali and on anything shaped like it.
 */
import Base from '../../layouts/Base.astro';
import Stage from '../../components/_pv-RecStage.astro';
import { getEntry } from 'astro:content';
import { parseAwards, groupByCitation } from '../../lib/awards';

const work = await getEntry('works', 'diwali-ke-shor-mein')!;
const GROUPS = groupByCitation(parseAwards(work.data.awards));

const other = await Promise.all(
  ['mumbai-standard-time', 'moholla', 'dinshaws-dildaari-battles'].map((s) => getEntry('works', s)!)
);
---

<Base title="Recognition C — Register" description="Preview only.">
  <Stage
    letter="C"
    name="Register"
    note="The honour stated once. Both of Diwali's awards are Official Selections, so the citation becomes a heading and the two festivals are filed beneath it — with the count set as a figure, which is how Aasha and Broken Reflections already state their recognition. A work with two selections and a work with seven then read as the same kind of statement at different scales."
  >
    <div class="rec" aria-label="Recognition">
      <p class="mono rec__lbl">Recognition</p>

      {GROUPS.map((g) => (
        <div class="rec__grp">
          <p class="rec__n">{String(g.bodies.length || 1).padStart(2, '0')}</p>
          <div class="rec__col">
            <p class="mono rec__cit">
              {g.star && <span class="rec__star" aria-hidden="true">★</span>}
              {g.citation}
            </p>
            {g.bodies.length > 0 && (
              <ul class="rec__bodies">
                {g.bodies.map((b) => (<li class="rec__where display">{b}</li>))}
              </ul>
            )}
          </div>
        </div>
      ))}
    </div>

    <section slot="robustness" class="rb">
      <p class="mono rb__lbl">The same treatment, the other shapes in the catalogue</p>
      <div class="rb__grid">
        {other.map((w) => (
          <div class="rb__cell">
            <p class="mono rb__work">{w.data.title}</p>
            <div class="rec rec--sm">
              {groupByCitation(parseAwards(w.data.awards)).map((g) => (
                <div class="rec__grp">
                  <p class="rec__n">{String(g.bodies.length || 1).padStart(2, '0')}</p>
                  <div class="rec__col">
                    <p class="mono rec__cit">
                      {g.star && <span class="rec__star" aria-hidden="true">★</span>}
                      {g.citation}
                    </p>
                    {g.bodies.length > 0 && (
                      <ul class="rec__bodies">
                        {g.bodies.map((b) => (<li class="rec__where display">{b}</li>))}
                      </ul>
                    )}
                  </div>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>
  </Stage>
</Base>

<style>
  .rec {
    margin: clamp(44px, 7vh, 90px) 0 0;
    padding-top: clamp(24px, 4vh, 46px);
    border-top: 1px solid var(--rule);
  }
  .rec__lbl {
    margin: 0 0 clamp(22px, 3.6vh, 40px);
    font-size: var(--t-micro); letter-spacing: 0.16em;
    text-transform: uppercase; color: var(--dim);
  }

  .rec__grp {
    display: grid;
    grid-template-columns: minmax(0, auto) minmax(0, 1fr);
    align-items: start;
    gap: clamp(18px, 3.4vw, 48px);
  }
  .rec__grp + .rec__grp {
    margin-top: clamp(24px, 4vh, 44px);
    padding-top: clamp(24px, 4vh, 44px);
    border-top: 1px solid var(--rule-soft);
  }

  /* The site's own recognition voice: a big tabular figure. Same face and the
     same optical weight the tally uses on Aasha and Broken Reflections. */
  .rec__n {
    margin: 0;
    font-family: var(--display); font-weight: 500;
    font-size: clamp(2.6rem, 7vw, 5.5rem);
    line-height: 0.8; letter-spacing: -0.05em;
    color: var(--bone); font-variant-numeric: tabular-nums;
  }

  .rec__col { padding-top: clamp(4px, 0.8vh, 10px); }

  .rec__cit {
    margin: 0;
    font-size: var(--t-micro); letter-spacing: 0.16em;
    text-transform: uppercase; color: var(--accent);
  }
  .rec__star { margin-right: 0.5em; }

  .rec__bodies {
    margin: clamp(12px, 2vh, 20px) 0 0;
    padding: 0; list-style: none;
    display: grid; gap: clamp(4px, 0.8vh, 9px);
  }
  .rec__where {
    font-family: var(--display); font-weight: 500;
    font-size: clamp(1.25rem, 2.8vw, 2.2rem);
    line-height: 1.12; letter-spacing: -0.035em;
    color: var(--bone); text-wrap: balance;
  }

  /* ── the robustness strip ─────────────────────────────────────── */
  .rb { max-width: 1180px; margin: clamp(90px, 15vh, 190px) auto 0; }
  .rb__lbl {
    margin: 0 0 clamp(20px, 3vh, 34px); padding-bottom: 12px;
    border-bottom: 1px solid var(--rule-soft);
    font-size: var(--t-micro); letter-spacing: 0.16em;
    text-transform: uppercase; color: var(--dim);
  }
  .rb__grid {
    display: grid; gap: clamp(24px, 4vw, 52px);
    grid-template-columns: repeat(auto-fit, minmax(min(250px, 100%), 1fr));
  }
  .rb__work {
    margin: 0 0 14px;
    font-size: var(--t-micro); letter-spacing: var(--track-mono);
    text-transform: uppercase; color: var(--muted);
  }
  .rec--sm { margin: 0; padding-top: 0; border-top: 0; }
  .rec--sm .rec__n { font-size: clamp(1.8rem, 3.4vw, 2.6rem); }
  .rec--sm .rec__where { font-size: clamp(1rem, 1.6vw, 1.25rem); }
</style>
