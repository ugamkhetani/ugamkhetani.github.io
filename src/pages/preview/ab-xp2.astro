---
/**
 * XP2 · THE SPLICE — the cut is made by the viewer, and here they make it.
 *
 * THE IDEA: Kuleshov's result is that a cut means something neither shot
 * means. Every stills section ever built fixes the adjacencies in advance —
 * the grid decides what sits next to what, and the reader takes it. This one
 * hands the decision over. TWO INDEPENDENT AXES choose the two halves of a
 * diptych: SCROLL picks the left frame, POINTER-X picks the right. Eight by
 * eight is sixty-four cuts, and you walk through them with two gestures that
 * do not interfere with each other.
 *
 * WHY TWO AXES AND NOT A PICKER: a picker is a menu, and a menu makes you
 * choose before you have seen anything. Two continuous axes mean the pairs
 * arrive while you are doing something else, which is how an edit actually
 * gets found — you are looking for one thing and the cut appears.
 *
 * THIS IS THE DIRECT ESCALATION OF ST5. That draft fixed four pairs and said
 * so; this one makes the pairing the interaction and keeps the same seam, the
 * same roman numerals, the same hairline. Where ST5 asserted an order, this
 * refuses to, and prints the count of what you have found instead.
 *
 * THE DIAGONAL IS THE INTERESTING PART. Eight of the sixty-four are a frame
 * against itself, which is not a cut but a hold — the interface names those
 * rather than hiding them, because a hold is an editing decision too.
 *
 * TOUCH AND KEYBOARD GET THE SAME SIXTY-FOUR. The rails are buttons, so the
 * pointer axis is reachable without a pointer; scroll is scroll everywhere.
 */
import Base from '../../layouts/Base.astro';
import OpNav from '../../components/OpNav.astro';
import { Image, getImage } from 'astro:assets';
import { getCollection } from 'astro:content';
import { framesFor } from '../../lib/frames';
import { href } from '../../lib/href';

/* THE REAL WORK AND THE REAL STILLS. The collection is the same one
   /work/aasha renders from, so the frames, title, roles, statement and
   standfirst are the page's own, and the harness around the experiment is the
   work page's own type and rhythm. The ONLY variable between ab-xp1 and
   ab-xp8 is the section below the "03 · Stills" rule.

   THE PRODUCTION PAGE IS NOT TOUCHED. src/pages/work/[slug].astro is
   untouched by all eight, and `withoutPreview()` keeps these routes out of
   the built site. */
const works = await getCollection('works');
const work = works.find((w) => w.id === 'aasha')!;
const d = work.data;
const images = framesFor('aasha', d.frames);
const LEDE = (d.description.trim().match(/^[^.!?]+[.!?]/) ?? [d.description.trim()])[0];
const ROLES = d.role.split('·').map((r) => r.trim());
const nn = (i: number) => String(i + 1).padStart(2, '0');
/* `awards` is {text, star?}[], not a string — interpolating the array
   itself renders "[object Object]" in the colophon. */
const AWARDS = (d.awards ?? []).map((a: { text: string }) => a.text).join(' · ');

/* Optimised URLs for the drafts that need the frame inside a CSS property —
   a mask, a background, a band — where <Image> cannot reach. Astro emits
   these into the same /_astro/ directory as everything else. */
const WEB = await Promise.all(
  images.map((src) => getImage({ src, width: 1200, format: 'webp', quality: 78 })),
);

const DRAFTS: [string, string, string][] = [
  ['xp1', 'The score', 'The film’s light, measured and scrubbed'],
  ['xp2', 'The splice', 'You author the cut — 64 of them'],
  ['xp3', 'The sentence', 'The words are the apertures'],
  ['xp4', 'The field', 'A space larger than the window'],
  ['xp5', 'The persistence', 'It coheres only when you stop'],
  ['xp6', 'The attention', 'The band divides by how you looked'],
  ['xp7', 'The sort', 'Sequence against what the light implies'],
  ['xp8', 'The bath', 'Latent until it crosses the surface'],
];
const ME = 'xp2';
const MINE = DRAFTS.find(([id]) => id === ME)!;

---

<Base title={`${d.title} · ${MINE[1]} — stills ${ME.toUpperCase()}`} description={`An experimental direction for the stills section of the Aasha project page: ${MINE[2]}.`}>
  <OpNav variant="bracket" base={href()} />

  <nav class="sw" aria-label="Stills experiments">
    <span class="sw__id">{ME.toUpperCase()}</span>
    <span class="sw__nm">{MINE[1]}</span>
    <span class="sw__su">{MINE[2]}</span>
    <span class="sw__set">
      {DRAFTS.map(([id, name, sub]) => (
        <a class:list={['sw__i', { 'is-here': id === ME }]} href={href(`preview/ab-${id}`)}
          title={`${name} — ${sub}`} aria-current={id === ME ? 'page' : undefined}>{id.slice(2)}</a>
      ))}
      <a class="sw__prev" href={href('preview/ab-st1')} title="The first eight directions">ST1–8</a>
    </span>
  </nav>

  <article class="sc" style={`--ar:${d.ratio.replace(':', ' / ')}`}>
    <header class="hd">
      <p class="mono hd__over">{d.category} · {d.year}</p>
      <h1 class="hd__t">{d.title}</h1>
      <p class="mono hd__meta"><span class="hd__roles">{ROLES.map((r) => <span>{r}</span>)}</span></p>
    </header>

    {d.quote && (
      <section class="q" aria-label="Statement">
        <p class="q__t">{d.quote}</p>
      </section>
    )}

    <section class="blk body" aria-label="About">
      <p class="body__lede" style={`--n:${LEDE.length}`}>{LEDE}</p>
    </section>

    <!-- ══ 03 · STILLS — THE EXPERIMENT ══════════════════════════════ -->
    <section class="blk st" aria-label="Stills">
      <p class="mono st__lbl"><span>03</span><i aria-hidden="true"></i><span>Stills · {MINE[1]}</span></p>
      <div class="sp" data-sp>
        <div class="sp__rail sp__rail--a">
          <p class="mono sp__cap"><span>A</span><em>scroll</em></p>
          <div class="sp__row">
            {images.map((img, i) => (
              <button class:list={['sp__t', { 'is-on': i === 0 }]} type="button" data-sp-a={i} aria-label={`Left frame ${nn(i)}`}>
                <Image src={img} alt="" widths={[140, 280]} sizes="96px" loading="eager" decoding="async" />
                <i class="mono">{nn(i)}</i>
              </button>
            ))}
          </div>
        </div>

        <div class="sp__cut" data-sp-cut>
          <div class="sp__two">
            <figure class="sp__h">
              {images.map((img, i) => (
                <span class:list={['sp__g', { 'is-on': i === 0 }]} data-sp-ga={i}>
                  <Image src={img} alt={i === 0 ? d.alt : ''} aria-hidden={i === 0 ? undefined : 'true'}
                    widths={[420, 700, 1120]} sizes="(max-width: 760px) 92vw, 46vw"
                    loading={i < 4 ? 'eager' : 'lazy'} decoding="async" />
                </span>
              ))}
            </figure>
            <figure class="sp__h">
              {images.map((img, i) => (
                <span class:list={['sp__g', { 'is-on': i === 0 }]} data-sp-gb={i}>
                  <Image src={img} alt="" aria-hidden="true"
                    widths={[420, 700, 1120]} sizes="(max-width: 760px) 92vw, 46vw"
                    loading={i < 4 ? 'eager' : 'lazy'} decoding="async" />
                </span>
              ))}
            </figure>
          </div>
          <p class="mono sp__read">
            <b data-sp-pa>01</b><span class="sp__slash">/</span><b data-sp-pb>01</b>
            <em data-sp-kind>a hold</em>
            <i aria-hidden="true"></i>
            <span><b data-sp-seen>1</b> of 64 found</span>
          </p>
        </div>

        <div class="sp__rail sp__rail--b" data-sp-brail>
          <div class="sp__row">
            {images.map((img, i) => (
              <button class:list={['sp__t', { 'is-on': i === 0 }]} type="button" data-sp-b={i} aria-label={`Right frame ${nn(i)}`}>
                <Image src={img} alt="" widths={[140, 280]} sizes="96px" loading="eager" decoding="async" />
                <i class="mono">{nn(i)}</i>
              </button>
            ))}
          </div>
          <p class="mono sp__cap"><span>B</span><em data-sp-bmode>move across · click to lock</em></p>
        </div>

        <p class="mono hint">
          <em>Scroll chooses the left · move across for the right</em>
          <i aria-hidden="true"></i>
          <span>64 cuts, eight of them holds</span>
        </p>
      </div>
    </section>

    <footer class="cl">
      <hr class="rule" />
      <p class="mono cl__p"><span>{MINE[0].toUpperCase()} · {MINE[1]}</span><i aria-hidden="true"></i><span>{AWARDS}</span></p>
    </footer>
  </article>
</Base>

<script>
  /* TWO AXES THAT DO NOT TOUCH EACH OTHER. Scroll owns A, the pointer owns B,
     and either can be driven from its rail for touch and keyboard. */
  const sp = document.querySelector('[data-sp]');
  if (sp) {
    const N = 8;
    const ga = [...sp.querySelectorAll('[data-sp-ga]')];
    const gb = [...sp.querySelectorAll('[data-sp-gb]')];
    const ta = [...sp.querySelectorAll('[data-sp-a]')];
    const tb = [...sp.querySelectorAll('[data-sp-b]')];
    const pa = sp.querySelector('[data-sp-pa]'), pb = sp.querySelector('[data-sp-pb]');
    const kind = sp.querySelector('[data-sp-kind]'), seenEl = sp.querySelector('[data-sp-seen]');
    const bmode = sp.querySelector('[data-sp-bmode]');
    const brail = sp.querySelector('[data-sp-brail]');
    const seen = new Set();
    let A = 0, B = 0, locked = false, queued = false;

    const paint = () => {
      ga.forEach((g, k) => g.classList.toggle('is-on', k === A));
      gb.forEach((g, k) => g.classList.toggle('is-on', k === B));
      ta.forEach((t, k) => t.classList.toggle('is-on', k === A));
      tb.forEach((t, k) => t.classList.toggle('is-on', k === B));
      pa.textContent = String(A + 1).padStart(2, '0');
      pb.textContent = String(B + 1).padStart(2, '0');
      kind.textContent = A === B ? 'a hold' : 'a cut';
      seen.add(A * N + B);
      seenEl.textContent = String(seen.size);
    };

    /* A FROM SCROLL. The section's own travel through the viewport is the
       axis, so it costs no extra page height and never fights the document. */
    const readA = () => {
      queued = false;
      const b = sp.getBoundingClientRect();
      const span = b.height + innerHeight;
      if (span <= 0) return;
      const p = Math.min(0.9999, Math.max(0, (innerHeight - b.top) / span));
      const i = Math.floor(p * N);
      if (i !== A) { A = i; paint(); }
    };
    const tick = () => { if (!queued) { queued = true; requestAnimationFrame(readA); } };
    addEventListener('scroll', tick, { passive: true });
    addEventListener('resize', tick);

    /* B FROM POINTER-X, read across the whole section so the gesture is big
       and forgiving rather than a thin strip you have to find. */
    const setB = (i, why) => {
      const next = Math.min(N - 1, Math.max(0, i));
      if (next === B) return;
      B = next; paint();
      if (why === 'pointer' && bmode && !locked) bmode.textContent = 'move across · click to lock';
    };
    sp.addEventListener('pointermove', (e) => {
      if (locked || e.pointerType === 'touch') return;
      const b = sp.getBoundingClientRect();
      setB(Math.floor(((e.clientX - b.left) / b.width) * N), 'pointer');
    });

    const toggleLock = () => {
      locked = !locked;
      sp.classList.toggle('is-locked', locked);
      if (bmode) bmode.textContent = locked ? 'locked — click to release' : 'move across · click to lock';
    };
    sp.querySelector('[data-sp-cut]').addEventListener('click', toggleLock);

    ta.forEach((t, i) => t.addEventListener('click', () => { A = i; paint(); }));
    tb.forEach((t, i) => t.addEventListener('click', (e) => {
      e.stopPropagation();
      locked = true; sp.classList.add('is-locked');
      if (bmode) bmode.textContent = 'locked — click the pair to release';
      setB(i, 'rail');
    }));
    /* Arrow keys on either rail walk that axis, so all 64 are reachable
       without a pointer at all. */
    [[ta, (i) => { A = i; paint(); }], [tb, (i) => setB(i, 'rail')]].forEach(([set, apply]) => {
      set.forEach((t, i) => t.addEventListener('keydown', (e) => {
        const s = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
        if (!s) return;
        e.preventDefault();
        const j = (i + s + N) % N;
        apply(j); set[j].focus();
      }));
    });

    paint(); readA();
    window.spSet = (a, b) => { if (a != null) A = a; if (b != null) B = b; paint(); };
    window.spRead = readA;
    window.spState = () => ({ A, B, locked, seen: seen.size });
  }
</script>

<style>
  /* ══ THE HARNESS ═══════════════════════════════════════════════════
     The work page's own type and rhythm, shared verbatim by all eight, so
     the only thing being judged below the rule is the stills section. */
  .sw {
    position: fixed; inset: 0 0 auto; z-index: 900;
    display: flex; align-items: baseline; gap: 12px;
    padding: 9px clamp(16px, 4vw, 40px);
    background: color-mix(in srgb, var(--ground) 86%, transparent);
    backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--rule);
    font-family: var(--mono); font-size: var(--t-micro);
    letter-spacing: 0.16em; text-transform: uppercase;
  }
  .sw__id { color: var(--accent); }
  .sw__nm { color: var(--bone); }
  .sw__su { color: var(--dim); margin-right: auto; }
  .sw__set { display: flex; gap: 1px; align-items: baseline; }
  .sw__i {
    color: var(--dim); text-decoration: none; padding: 3px 7px;
    border: 1px solid transparent; font-variant-numeric: tabular-nums;
  }
  .sw__i:hover { color: var(--bone); }
  .sw__i.is-here { color: var(--accent); border-color: var(--rule); }
  .sw__prev { color: color-mix(in srgb, var(--dim) 70%, var(--ground)); text-decoration: none; padding: 3px 0 3px 12px; margin-left: 6px; border-left: 1px solid var(--rule); }
  .sw__prev:hover { color: var(--bone-dim); }
  @media (max-width: 860px) { .sw__su { display: none; } .sw__nm { margin-right: auto; } }
  @media (max-width: 560px) { .sw__nm, .sw__prev { display: none; } }

  .sc { padding: clamp(84px, 13vh, 150px) var(--margin) 0; }
  .hd { text-align: center; margin-bottom: clamp(38px, 6.6vh, 80px); }
  .hd__over { font-size: var(--t-micro); letter-spacing: 0.18em; text-transform: uppercase; color: var(--muted); margin: 0 0 clamp(16px, 2.6vh, 30px); }
  .hd__t { margin: 0; font-family: var(--display); font-weight: 500; font-size: clamp(2.6rem, 7vw, 5.6rem); line-height: 0.94; letter-spacing: -0.04em; color: var(--bone); }
  .hd__meta { margin: clamp(14px, 2.2vh, 26px) 0 0; font-size: var(--t-micro); letter-spacing: 0.18em; text-transform: uppercase; color: var(--bone-dim); }
  .hd__roles { display: inline-flex; flex-wrap: wrap; justify-content: center; gap: 0 14px; }
  .hd__roles span + span::before { content: '·'; margin-right: 14px; color: var(--dim); }
  .q { max-width: 34ch; margin: 0 auto clamp(50px, 8vh, 110px); text-align: center; }
  .q__t { margin: 0; font-family: var(--serif); font-style: italic; font-weight: 300; font-size: clamp(1.25rem, 2.4vw, 1.9rem); line-height: 1.26; letter-spacing: -0.012em; color: var(--bone-dim); }
  .body { max-width: var(--measure); margin-inline: auto; }
  .body__lede { margin: 0 auto; max-width: clamp(20ch, calc(var(--n, 90) / 3 * 1ch), 44ch); font-family: var(--display); font-weight: 500; font-size: clamp(1.2rem, min(calc(2.35rem - (var(--n, 90) - 55) * 0.007rem), calc(1.05rem + 2.1vw)), 2.2rem); line-height: 1.12; letter-spacing: -0.025em; color: var(--bone); text-wrap: balance; }
  .blk { margin: 0 auto clamp(104px, 18vh, 240px); }

  .st { --w: var(--measure); }
  .st__lbl {
    display: flex; align-items: center; gap: 12px;
    width: var(--w); margin: 0 auto clamp(24px, 4vh, 50px);
    font-size: var(--t-micro); letter-spacing: 0.18em; text-transform: uppercase; color: var(--muted);
  }
  .st__lbl i { flex: 1; height: 1px; background: var(--rule); }

  /* The one piece of furniture every experiment shares: a line of mono that
     says what the thing in front of you responds to. An experimental
     interaction that nobody can find is a failed one. */
  .hint {
    display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap;
    width: var(--w); margin: 14px auto 0;
    font-size: var(--t-micro); letter-spacing: 0.16em; text-transform: uppercase; color: var(--dim);
  }
  .hint b { font-weight: 400; color: var(--accent); font-variant-numeric: tabular-nums; }
  .hint em { font-style: normal; color: var(--muted); }
  .hint i { flex: 1; min-width: 20px; height: 1px; background: var(--rule); transform: translateY(-3px); }

  .cl { max-width: var(--measure); margin: 0 auto; padding-bottom: clamp(48px, 9vh, 110px); }
  .rule { border: 0; border-top: 1px solid var(--rule); margin: 0 0 16px; }
  .cl__p { display: flex; align-items: baseline; gap: 14px; margin: 0; font-size: var(--t-micro); letter-spacing: 0.16em; text-transform: uppercase; color: var(--dim); }
  .cl__p i { flex: 1; height: 1px; background: var(--rule); transform: translateY(-3px); }
  .cl__p span:last-child { text-align: right; }
  @media (max-width: 620px) { .cl__p { flex-direction: column; gap: 6px; } .cl__p i { display: none; } .cl__p span:last-child { text-align: left; } }

  /* ── XP2 · THE SPLICE ──────────────────────────────────────── */
  .st { --w: min(calc(100vw - 2 * var(--margin)), 1180px); }
  .sp { width: var(--w); margin-inline: auto; }

  .sp__cap {
    display: flex; align-items: baseline; gap: 10px; margin: 0 0 7px;
    font-size: var(--t-micro); letter-spacing: 0.2em; text-transform: uppercase; color: var(--dim);
  }
  .sp__cap span { color: var(--bone); }
  .sp__cap em { font-style: normal; color: color-mix(in srgb, var(--dim) 70%, var(--ground)); }
  .sp__rail--b .sp__cap { margin: 7px 0 0; }

  .sp__row { display: grid; grid-template-columns: repeat(8, minmax(0, 1fr)); gap: clamp(4px, 0.7vw, 8px); }
  .sp__t { display: block; padding: 0; border: 0; background: none; cursor: pointer; -webkit-tap-highlight-color: transparent; }
  /* HEIGHT: AUTO IS LOAD-BEARING. Astro's <Image> emits the intrinsic
     height="2160" attribute, and aspect-ratio is ignored unless one axis is
     auto — without it each 88px-wide thumbnail lays out 2160px tall and the
     rail is two thousand pixels of cropped image. */
  .sp__t img {
    display: block; width: 100%; height: auto; aspect-ratio: var(--ar); object-fit: cover;
    border-top: 1px solid var(--rule); padding-top: 5px; opacity: 0.34;
  }
  .sp__t i { display: block; margin-top: 4px; font-style: normal; font-size: var(--t-micro); letter-spacing: 0.12em; color: var(--dim); font-variant-numeric: tabular-nums; }
  .sp__t:hover img { opacity: 0.66; }
  .sp__t:focus-visible { outline: 1px solid var(--accent); outline-offset: 2px; }
  .sp__t.is-on img { opacity: 1; border-top-color: var(--accent); }
  .sp__t.is-on i { color: var(--bone); }
  @media (prefers-reduced-motion: no-preference) {
    .sp__t img { transition: opacity 130ms linear, border-color 130ms linear; }
  }

  .sp__cut { margin: clamp(14px, 2.2vh, 26px) 0; }
  /* THE SEAM IS SHARED — one hairline, so the pair is one object. Same
     construction as ST5, on purpose: only the authorship changed. */
  .sp__two { display: grid; grid-template-columns: 1fr 1px 1fr; background: var(--rule); }
  .sp__h { position: relative; margin: 0; aspect-ratio: var(--ar); overflow: hidden; background: var(--ground-lift); }
  .sp__h:last-child { grid-column: 3; }
  .sp__g { position: absolute; inset: 0; opacity: 0; }
  .sp__g.is-on { opacity: 1; }
  .sp__g img { width: 100%; height: 100%; object-fit: cover; display: block; }

  .sp__read {
    display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap; margin: 11px 0 0;
    font-size: var(--t-micro); letter-spacing: 0.16em; text-transform: uppercase; color: var(--dim);
  }
  .sp__read b { font-weight: 400; font-size: 1.35rem; letter-spacing: -0.02em; color: var(--bone); line-height: 1; font-variant-numeric: tabular-nums; }
  .sp__read b[data-sp-seen] { font-size: var(--t-micro); color: var(--accent); }
  .sp__slash { color: var(--accent); }
  .sp__read em { font-style: normal; color: var(--muted); }
  .sp__read i { flex: 1; min-width: 20px; height: 1px; background: var(--rule); transform: translateY(-4px); }

  .sp.is-locked .sp__rail--b .sp__cap em { color: var(--accent); }

  @media (max-width: 700px) {
    .sp__two { grid-template-columns: 1fr; grid-template-rows: auto 1px auto; }
    .sp__h:last-child { grid-column: 1; grid-row: 3; }
    .sp__row { gap: 3px; }
    .sp__read b { font-size: 1.1rem; }
  }
</style>
