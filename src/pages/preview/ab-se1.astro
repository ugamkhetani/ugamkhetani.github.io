---
/**
 * AB-SE1 · CUT
 *
 * ONE OF FOUR ISOLATED DRAFTS of the send block's animation — ab-se1..se4.
 * Nothing live is touched; ContactForm.astro is untouched and these pages
 * carry their own copy of the block's structure so it is judged at the real
 * size, in the real layout, without scrolling to the foot of a 15,000px page.
 *
 * WHAT THE LIVE BLOCK DOES TODAY, so the four can be read against it:
 *
 *   send-open    the seventeen letters of the action wake one at a time —
 *                colour --dim to inherit and translateY(0.06em) to none,
 *                520ms each on a 26ms stagger, so the wave takes 936ms end
 *                to end. Fires on `is-woken`, which the script adds when the
 *                orange line's leading edge reaches the words.
 *   send-swell   the refusal's characters thicken, font-weight 400 to 700
 *                and back, 520ms on a 25ms stagger — 1095ms end to end for
 *                twenty-three characters.
 *   the handover the action gives up its white at once and the note takes
 *                it 90ms later, so brightness reads as moving between them.
 *   the arrow    translateX(0.28em) on hover, and only when ready.
 *
 * THE BRIEF IS MODERN, FAST AND INTERESTING, and the first of those three is
 * where the live version is weakest: a wave that takes 936ms to cross a
 * sentence is a wave you wait for. Every draft here finishes the action in
 * under 400ms and the note in under 300, and each gets there a different way.
 *
 * THE STATES ARE THE SAME IN ALL FOUR, and they are the site's own:
 *   .is-ready   on the action — the form is valid. Functional only.
 *   .is-woken   on the action — the gesture. Added separately so the light
 *               delivers the activation rather than the validation.
 *   .is-asking  on the shell — a refusal, after a click on an invalid form.

 * ── THIS ONE: CUT ───────────────────────────────────────────────
 *
 * NOTHING FADES AND NOTHING EASES. The live version dissolves each letter up
 * from --dim over 520ms; this reveals them with a hard edge. .send__chars
 * carries a clip-path that crosses the word left to right in 160ms on
 * `steps(17, end)` — one step per letter — so the letters do not appear
 * gradually, they are CUT IN, and the edge that does it is the same edge a
 * shutter has.
 *
 * steps() IS THE WHOLE IDEA. A linear clip would look like a wipe; stepping
 * it to the letter count means each letter arrives complete and at full
 * strength, seventeen discrete events in 160ms. That is 9.4ms apart, which
 * is faster than the eye resolves as sequence — you read it as one movement
 * with a texture rather than as a queue.
 *
 * THE ARROW IS NOT PART OF THE CLIP. It is a separate element after the
 * chars, and it snaps in at the end of the run with no transition at all —
 * 0ms, a state change rather than an animation. The action is complete the
 * instant the arrow exists.
 *
 * THE REFUSAL DOES NOT SWELL, IT IS STRUCK. The note appears at full weight
 * immediately and a 1px rule draws under it in 120ms from the right — the
 * direction the eye is already travelling, since the note is flush right. No
 * per-character wave: a refusal that takes a second to say itself is a
 * refusal you have already stopped reading.
 */
import Base from '../../layouts/Base.astro';
const SEND = 'Send this enquiry';
const REFUSE = 'Name and email required';
---

<Base title="Cut — send block draft" description="An isolated draft of the send block's animation.">
  <main class="lab">
      <nav class="sw" aria-label="Variation">
        <span class="sw__t">Cut</span>
        <a class="sw__i is-here" href="/preview/ab-se1">SE1</a>
        <a class="sw__i" href="/preview/ab-se2">SE2</a>
        <a class="sw__i" href="/preview/ab-se3">SE3</a>
        <a class="sw__i" href="/preview/ab-se4">SE4</a>
        <a class="sw__i sw__i--src" href="/">LIVE</a>
      </nav>

    <div class="lab__head">
      <p class="lab__k">ab-se1 · Cut</p>
      <p class="lab__d">Nothing fades. The letters are cut in by a clip that crosses the word in 160ms on steps(), and the refusal arrives whole with a rule struck under it.</p>
    </div>

    {/* The send block, markup faithful to ContactForm.astro: the sentence is
        written once for assistive tech and once as letters, and the letters
        are hidden from it. */}
    <div class="send" data-send>
      <div class="send__band">
        <a class="send__act" id="send" href="#" aria-disabled="true">
          <span class="visually-hidden">{SEND}</span>
          <span class="send__chars" aria-hidden="true">{SEND.split('').map((c, i) => (
            <i style={`--i:${i}`}>{c === ' ' ? '\u00A0' : c}</i>
          ))}</span>
          <span class="send__arrow" aria-hidden="true">→</span>
        </a>
        <p class="mono send__note" id="note"></p>
      </div>
    </div>

    <div class="lab__ctl">
      <button type="button" data-act="wake">Wake the action</button>
      <button type="button" data-act="refuse">Refuse</button>
      <button type="button" data-act="ready">Ready note</button>
      <button type="button" data-act="reset">Reset</button>
      <span class="lab__state" data-state></span>
    </div>
  </main>
</Base>

<script is:inline define:vars={{ REFUSE }}>
  (function () {
    const shell = document.querySelector('[data-send]');
    const act = document.getElementById('send');
    const note = document.getElementById('note');
    const state = document.querySelector('[data-state]');
    const READY = 'Opens as a draft. Send it when you\u2019re ready.';

    /* ASTRO SCOPES THIS PAGE'S CSS BY STAMPING data-astro-cid-* ON EVERY
       ELEMENT IN THE TEMPLATE, and compiling `.send__ink` to
       `.send__ink[data-astro-cid-…]`. The note's characters are built here,
       so they are not in the template and never get stamped — and every
       rule below that targets .send__ink or .send__ink i would silently
       fail to match. Measured before this was added: the refusal ran its
       animation on nothing and the note stayed --dim.

       ContactForm.astro solves it the same way. Copying the attribute off
       the note itself keeps the stylesheet ordinary: no :global, no inline
       styles. (HANDOFF §6.) */
    const scope = Array.from(note.attributes).map((a) => a.name)
      .find((n) => n.startsWith('data-astro-cid-'));
    const stamp = (el) => { if (scope) el.setAttribute(scope, ''); return el; };

    /* The same split ContactForm's setNote() uses: one span for a screen
       reader, one per character for the ink. */
    function setNote(text) {
      note.textContent = '';
      const said = stamp(document.createElement('span'));
      said.className = 'visually-hidden';
      said.textContent = text;
      const ink = stamp(document.createElement('span'));
      ink.className = 'send__ink';
      ink.setAttribute('aria-hidden', 'true');
      for (let i = 0; i < text.length; i++) {
        const ch = stamp(document.createElement('i'));
        ch.style.setProperty('--i', String(i));
        ch.textContent = text[i];
        ink.appendChild(ch);
      }
      note.append(said, ink);
    }

    function say(s) { state.textContent = s; }

    function reset() {
      act.classList.remove('is-ready', 'is-woken');
      shell.classList.remove('is-asking');
      act.setAttribute('aria-disabled', 'true');
      setNote(REFUSE);
      say('idle — not ready');
    }

    /* Re-adding a class does not restart an animation unless the element is
       reflowed in between. */
    function restart(el, cls) {
      el.classList.remove(cls);
      void el.offsetWidth;
      el.classList.add(cls);
    }

    document.querySelector('.lab__ctl').addEventListener('click', (e) => {
      const b = e.target.closest('[data-act]');
      if (!b) return;
      const a = b.dataset.act;
      if (a === 'reset') return reset();
      if (a === 'wake') {
        act.classList.add('is-ready');
        act.setAttribute('aria-disabled', 'false');
        shell.classList.remove('is-asking');
        setNote(READY);
        restart(act, 'is-woken');
        say('woken — ready');
      }
      if (a === 'refuse') {
        act.classList.remove('is-ready', 'is-woken');
        act.setAttribute('aria-disabled', 'true');
        setNote(REFUSE);
        restart(shell, 'is-asking');
        say('refused');
      }
      if (a === 'ready') { setNote(READY); say('ready note'); }
    });

    act.addEventListener('click', (e) => {
      e.preventDefault();
      if (!act.classList.contains('is-ready')) {
        setNote(REFUSE);
        restart(shell, 'is-asking');
        say('refused');
      }
    });

    reset();
  })();
</script>

<style>
  /* ══ THE HARNESS ═════════════════════════════════════════════════
     Not design. Enough page to judge the block on, and controls to replay
     the states without filling a form at the bottom of a 15,000px page. */
  .lab {
    min-height: 100vh; padding: clamp(28px, 7vh, 80px) var(--margin);
    display: flex; flex-direction: column; justify-content: center; gap: 44px;
    max-width: 980px;
  }
  .lab__k {
    margin: 0 0 8px; font-family: var(--mono); font-size: var(--t-micro);
    letter-spacing: 0.16em; text-transform: uppercase; color: var(--accent);
  }
  .lab__d { margin: 0; max-width: 62ch; color: var(--muted); font-size: var(--t-sm); line-height: 1.5; }
  .lab__ctl { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; }
  .lab__ctl button {
    font-family: var(--mono); font-size: 11px; letter-spacing: 0.12em;
    text-transform: uppercase; color: var(--muted);
    background: transparent; border: 1px solid var(--rule);
    padding: 9px 14px; border-radius: 999px; cursor: pointer;
    transition: color 140ms linear, border-color 140ms linear;
  }
  .lab__ctl button:hover { color: var(--bone); border-color: var(--bone-dim); }
  .lab__state {
    font-family: var(--mono); font-size: 11px; letter-spacing: 0.12em;
    text-transform: uppercase; color: var(--dim); margin-left: 6px;
  }
  .sw {
    position: fixed; top: 14px; right: 16px; z-index: 40;
    display: flex; align-items: baseline; gap: 12px;
    font-family: var(--mono); font-size: var(--t-micro);
    letter-spacing: 0.16em; text-transform: uppercase;
  }
  .sw__t { color: var(--muted); }
  .sw a { color: var(--dim); text-decoration: none; transition: color 140ms linear; }
  .sw a:hover { color: var(--bone); }
  .sw a.is-here { color: var(--accent); }
  .sw a.sw__i--src { color: var(--muted); margin-left: 5px; }

  /* ══ THE BLOCK, AS THE SITE HAS IT ═══════════════════════════════
     Structure and type copied from ContactForm.astro so the draft is judged
     at the real size and in the real layout. Everything the VARIATION
     changes is in the block below this one. */
  .send__band {
    display: flex; align-items: baseline; gap: var(--s-2); flex-wrap: wrap;
    border-top: 1px solid var(--rule); padding-top: 26px;
  }
  .send__act {
    font-family: var(--display); font-weight: 500;
    font-size: clamp(1.75rem, 3.06vw, 2.75rem);
    letter-spacing: -0.035em; line-height: 1;
    color: var(--bone); text-decoration: none; white-space: nowrap;
    display: inline-flex; align-items: baseline; gap: 0.3em;
    cursor: not-allowed;
  }
  .send__act.is-ready { cursor: pointer; }
  .send__chars i, .send__ink i { display: inline-block; font-style: normal; }
  .send__arrow { display: inline-block; }
  .send__note {
    margin: 0 0 0 auto; text-align: right;
    color: var(--dim); font-size: 14px; line-height: 1.8; max-width: 32ch;
  }
  .send__ink { display: inline-block; white-space: pre-wrap; transform-origin: right center; }
  @media (max-width: 620px) {
    .send__band { flex-direction: column; gap: 18px; }
    .send__note { margin-left: 0; text-align: left; }
    .send__ink { transform-origin: left center; }
    .send__act { white-space: normal; }
  }

  /* ══ SE1 · CUT ═══════════════════════════════════════════════════ */
  .send__chars {
    display: inline-block;
    clip-path: inset(0 100% 0 0);
  }
  .send__act.is-woken .send__chars {
    animation: se1-cut 160ms steps(17, end) forwards;
  }
  @keyframes se1-cut { to { clip-path: inset(0 -0.06em 0 0); } }

  /* No transition: the arrow is a state, not a movement. */
  .send__arrow { opacity: 0; }
  .send__act.is-woken .send__arrow { opacity: 1; transition: opacity 0s linear 160ms; }
  .send__act.is-ready:hover .send__arrow { transform: translateX(0.28em); transition: transform 90ms steps(3, end); }
  .send__act.is-ready:hover { color: var(--accent); }

  /* The refusal is struck, not swelled. */
  .send__note { position: relative; }
  .send.is-asking .send__ink { color: var(--bone); }
  .send__note::after {
    content: ''; position: absolute; left: 0; right: 0; bottom: -4px; height: 1px;
    background: var(--accent); transform: scaleX(0); transform-origin: right center;
  }
  .send.is-asking .send__note::after { animation: se1-strike 120ms steps(6, end) forwards; }
  @keyframes se1-strike { to { transform: scaleX(1); } }
  .send.is-asking .send__act { color: var(--dim); }

  @media (prefers-reduced-motion: reduce) {
    .send__chars, .send__act.is-woken .send__chars { animation: none; clip-path: none; }
    .send__arrow { opacity: 1; }
    .send.is-asking .send__note::after { animation: none; transform: scaleX(1); }
  }
</style>
