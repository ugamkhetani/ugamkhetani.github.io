---
/**
 * PREVIEW — MOSAIC A · "PLACED".
 *
 * NOTHING STRUCTURAL CHANGES. Same 6 x 5 bed, same 30 tiles, same grid, same
 * brightness cap, same drift. The only thing that changes is WHICH work is in
 * WHICH cell — the twelve are laid onto the twelve best-measured cells in rank
 * order, so the most-wanted work sits where the aperture and the panels leave
 * the most room, and the least-wanted of the twelve sits in the weakest of the
 * cells that are actually seen.
 *
 * IT IS THE ZERO-RISK OPTION. One array changes in index.astro; no CSS moves,
 * no layout is reconsidered, nothing can regress in the aperture arithmetic
 * that keeps type legible over the bed.
 *
 * IT ALSO DOES NOTHING ABOUT THE WASTE. Fourteen of the thirty tiles are never
 * seen at either end of the scroll, and this option still fills and decodes
 * them — see B, which removes them. They are filled here by repeating from the
 * top of the ranking, on the reasoning that if a cell cannot be seen it does
 * not matter what is in it, and repeating the favourites costs nothing.
 */
import Base from '../../layouts/Base.astro';
import Stage from '../../components/_pv-MosaicStage.astro';
import Tile from '../../components/_pv-MosaicTile.astro';
import { getCollection } from 'astro:content';
import { RANKED, CELLS, DEAD_CELLS, BEST_FRAME } from '../../lib/_pv-mosaic';

const works = await getCollection('works');
const bySlug = new Map(works.map((w) => [w.id, w]));

/* 30 cells. The measured-best sixteen take the ranking in order (the twelve,
   then the top four again); the fourteen dead cells repeat from the top. */
const TILES: { w: any; rank: number | null; cell: number }[] = Array.from({ length: 30 });
CELLS.forEach((cell, i) => {
  const r = i % RANKED.length;
  TILES[cell] = { w: bySlug.get(RANKED[r])!, rank: r + 1, cell };
});
DEAD_CELLS.forEach((cell, i) => {
  const r = i % RANKED.length;
  TILES[cell] = { w: bySlug.get(RANKED[r])!, rank: null, cell };
});
---

<Base title="Mosaic A — Placed" description="Preview only.">
  <Stage
    letter="A"
    name="Placed"
    note="Same bed, same thirty tiles, same everything — only the order changes. The twelve are laid onto the twelve best-measured cells in rank order, so Diwali sits where the aperture and the panels leave the most room and Bloody Bubbly takes the weakest cell that is still seen. One array changes on the home page; no CSS moves."
  >
    <div class="ms__ground" slot="bed" aria-hidden="true">
      <div class="ms__bed">
        {TILES.map((t) => (
          <span class="ms__tile" class:list={[{ 'is-dead': t.rank === null }]}>
            <Tile slug={t.w.id} frames={t.w.data.frames} alt=""
              sizes="20vw" pick={BEST_FRAME[t.w.id] ?? 1} />
            <span class="ms__mark mono" aria-hidden="true">
              <b>{t.rank ? String(t.rank).padStart(2, '0') : '—'}</b>
              {t.w.data.title}
              <i>cell {t.cell}</i>
            </span>
          </span>
        ))}
      </div>
    </div>
  </Stage>
</Base>

<style>
  /* index.astro's own bed, unchanged. */
  .ms__ground { position: fixed; inset: 0; z-index: 0; pointer-events: none; overflow: hidden; }
  .ms__bed {
    position: absolute; inset: -10%;
    display: grid; grid-template-columns: repeat(6, minmax(0, 1fr));
    grid-auto-rows: minmax(0, 1fr); gap: clamp(5px, 0.8vw, 13px);
    filter: brightness(0.30) saturate(0.7) contrast(1.05);
    transform: translate3d(0, calc(var(--prog, 0) * -8%), 0) scale(1.06);
    will-change: transform;
  }
  .ms__tile { position: relative; display: block; overflow: hidden; min-height: 0; border-radius: clamp(6px, 0.7vw, 12px); }
  .ms__tile :global(img) { border-radius: inherit; }

  /* ── the cell map, off unless asked for ───────────────────────── */
  .ms__mark { display: none; }
  :global(.rg.map-on) .ms__bed { filter: brightness(0.62) saturate(0.7) contrast(1.05); }
  :global(.rg.map-on) .ms__tile { outline: 1px solid var(--rule-accent); outline-offset: -1px; }
  :global(.rg.map-on) .ms__tile.is-dead { outline-color: rgba(255, 255, 255, 0.1); }
  :global(.rg.map-on) .ms__mark {
    position: absolute; inset: 0; z-index: 2;
    display: grid; align-content: center; justify-items: center; gap: 3px;
    padding: 6px; text-align: center;
    font-size: 9px; letter-spacing: 0.08em; line-height: 1.25;
    color: var(--bone); background: rgba(6, 6, 5, 0.62);
  }
  :global(.rg.map-on) .ms__mark b { font-size: 15px; letter-spacing: 0; color: var(--accent); }
  :global(.rg.map-on) .ms__tile.is-dead .ms__mark { color: var(--dim); background: rgba(6, 6, 5, 0.82); }
  :global(.rg.map-on) .ms__tile.is-dead .ms__mark b { color: var(--dim); }
  :global(.rg.map-on) .ms__mark i { font-style: normal; font-size: 8px; color: var(--dim); }

  @media (max-width: 900px) {
    .ms__bed { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }
</style>
