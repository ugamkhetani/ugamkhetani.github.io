---
/**
 * PREVIEW 10 — DECK.  Delete this folder once a direction is chosen.
 * Reference: cosmos_143378693 — overlapping cards drifting past each other
 * at different depths, edges rounded, one behind the next.
 *
 * THE CATALOGUE AS A DECK COMING TOWARD YOU.
 *
 * Works stacked along the axis of view rather than laid across a page. They
 * arrive out of the dark, grow as they approach, pass the camera and are
 * gone. Scrolling pulls the deck through.
 *
 * WHY IT IS NOT THE HELIX. The helix winds works around an axis and asks you
 * to travel it; this holds them near the centre and lets them overlap, which
 * is the reference's actual subject — cards passing each other at different
 * depths, each partly covering the one behind. The lateral drift is small
 * and derived from the work's column in composition.ts, so the deck leans
 * the way the score leans instead of shuffling at random.
 *
 * ONE WORK IS ALWAYS FULLY LEGIBLE. Overlap is the idiom, but an index whose
 * items obscure each other is a bad index — so the work nearest the camera
 * is always the one on top, brightest, and named. Everything behind it reads
 * as depth rather than as clutter.
 *
 * ADDITIVE (§5): the resting state is a plain, complete index; `is-3d` is
 * added by script only, and only when motion is allowed. NO MASTHEAD (§3).
 */
import Base from '../../layouts/Base.astro';
import Nav from '../../components/_pv-Nav.astro';
import Still from '../../components/Still.astro';
import { getCollection } from 'astro:content';
import { composition, numberFor, total, RATIO_NUM } from '../../data/composition';

const works = await getCollection('works');
const bySlug = new Map(works.map((w) => [w.id, w]));

const GAP = 620;      // px between cards along the axis
const LEAN = 74;      // px of lateral drift per grid column away from centre

let i = 0;
const nodes: { w: any; i: number; x: number; y: number; z: number; no: string }[] = [];
for (const stanza of composition) {
  for (const p of stanza.items) {
    const w = bySlug.get(p.slug)!;
    const centre = (p.col - 1) + p.span / 2 - 6;   // -6..6 around the middle
    nodes.push({
      w, i,
      x: +(centre * LEAN).toFixed(1),
      y: +(((i % 3) - 1) * 46).toFixed(1),          // a small, regular rise and fall
      z: -i * GAP,
      no: numberFor(w.id),
    });
    i++;
  }
}
const depth = (i - 1) * GAP;
---

<Base title="Works — Deck" description="Preview only.">
  <Nav here="deck" name="Deck" idea="Cards arriving out of the dark, overlapping as they pass." />

  <div class="dk" data-deck style={`--depth:${depth}`}>
    <h1 class="visually-hidden">Ugam Khetani — selected works across film, brand and music</h1>

    <div class="scene" data-scene>
      <div class="world" data-world>
        {
          nodes.map((n) => (
            <div class="node" data-node data-no={n.no} data-title={n.w.data.title}
              data-meta={`${n.w.data.category} · ${n.w.data.year}`}
              style={`--x:${n.x}px;--y:${n.y}px;--z:${n.z}px;--arn:${RATIO_NUM[n.w.data.ratio]}`}>
              <Still
                slug={n.w.id}
                title={n.w.data.title}
                year={n.w.data.year}
                category={n.w.data.category}
                ratio={n.w.data.ratio}
                frames={n.w.data.frames}
                alt={n.w.data.alt}
                sizes="34vw"
                eager={n.i < 2}
                max={3}
              />
              <span class="node__cap">
                <span class="mono node__no">{n.no}</span>
                <span class="node__title">{n.w.data.title}</span>
              </span>
            </div>
          ))
        }
      </div>
    </div>

    <div class="hud" aria-hidden="true">
      <span class="mono hud__no" data-k-no>{nodes[0].no}</span>
      <span class="mono hud__of">/ {String(total).padStart(3, '0')}</span>
      <span class="hud__title" data-k-title>{nodes[0].w.data.title}</span>
    </div>

    <div class="track" aria-hidden="true"></div>
  </div>
</Base>

<style>
  /* ── RESTING STATE (§5) ───────────────────────────────────────── */
  .dk { padding-inline: var(--margin); padding-top: clamp(150px, 19vh, 220px); padding-bottom: 14vh; }
  .world { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(20px, 3vw, 48px); }
  .node__cap { display: flex; align-items: baseline; gap: 10px; margin-top: 9px; }
  .node__no { font-size: 9px; letter-spacing: 0.12em; color: var(--dim); transition: color var(--d-micro) var(--ease); }
  .node__title {
    font-family: var(--display); font-weight: 500; font-size: var(--t-sm);
    letter-spacing: -0.02em; color: var(--bone-dim);
    transition: color var(--d-micro) var(--ease);
  }
  .hud, .track { display: none; }
  @media (max-width: 900px) { .world { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 640px) { .world { grid-template-columns: 1fr; } }

  /* ── THE DECK ─────────────────────────────────────────────────── */
  .dk.is-3d { padding: 0; }
  .dk.is-3d .scene {
    position: fixed; inset: 0; z-index: 1;
    perspective: 1000px; perspective-origin: 50% 48%;
    overflow: hidden;
  }
  .dk.is-3d .world {
    display: block; position: absolute; top: 50%; left: 50%;
    width: 0; height: 0; transform-style: preserve-3d; will-change: transform;
  }
  .dk.is-3d .node {
    position: absolute;
    width: 34vw; margin: -9vw 0 0 -17vw;
    transform: translate3d(var(--x), var(--y), var(--z));
  }
  /* The reference's rounded card edge — the one piece of its styling worth
     borrowing, because it is what makes overlapping cards read as separate
     objects rather than as one torn image. */
  .dk.is-3d .node :global(.st__win) { border-radius: 14px; }

  .dk.is-3d .node__cap { justify-content: center; opacity: 0; transition: opacity var(--d-micro) var(--ease); }
  .dk.is-3d .node.is-near .node__cap { opacity: 1; }
  .dk.is-3d .node.is-near .node__no { color: var(--accent); }
  .dk.is-3d .node.is-near .node__title { color: var(--bone); }

  .dk.is-3d .hud {
    display: flex; align-items: baseline; gap: 12px;
    position: fixed; z-index: 5; left: var(--margin); bottom: 26px;
    pointer-events: none;
  }
  .hud__no { font-size: var(--t-sm); letter-spacing: 0.14em; color: var(--accent); }
  .hud__of { font-size: 9px; letter-spacing: 0.1em; color: var(--dim); }
  .hud__title {
    font-family: var(--display); font-weight: 500; font-size: var(--t-md);
    letter-spacing: -0.02em; color: var(--bone); margin-left: 8px;
  }

  .dk.is-3d .track { display: block; height: calc(var(--depth) * 1px + 100vh); }
</style>

<script>
  function initDeck() {
    const root = document.querySelector('[data-deck]') as HTMLElement | null;
    if (!root || root.dataset.bound) return;
    root.dataset.bound = '1';
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    if (!matchMedia('(min-width: 901px)').matches) return;

    const world = root.querySelector('[data-world]') as HTMLElement;
    const nodes = Array.from(root.querySelectorAll('[data-node]')) as HTMLElement[];
    const no = root.querySelector('[data-k-no]') as HTMLElement;
    const title = root.querySelector('[data-k-title]') as HTMLElement;
    if (!world || !nodes.length) return;

    root.classList.add('is-3d');
    const depth = parseFloat(getComputedStyle(root).getPropertyValue('--depth')) || 1;
    const zOf = nodes.map((n) => parseFloat(n.style.getPropertyValue('--z')) || 0);

    let raf = 0, last = -1;
    const paint = () => {
      raf = 0;
      const max = document.documentElement.scrollHeight - innerHeight;
      const t = max > 0 ? Math.min(1, Math.max(0, scrollY / max)) : 0;
      const cam = t * depth;
      world.style.transform = `translateZ(${cam.toFixed(1)}px)`;

      /* Works at or behind the camera plane must be culled by hand. CSS does
         not drop them: past the perspective plane an element is projected
         INVERTED rather than discarded, so everything already flown past
         reappears as a mirrored ghost. Measured at camera 3510 on the helix —
         001 through 005 were all behind the eye (zEff >= the 1100px
         perspective) and all five still reported on-screen boxes, 005 at
         1440px wide. -40 leaves a margin so a work does not pop out while it
         is still just in front of the lens. */
      for (let i = 0; i < zOf.length; i++) {
        nodes[i].style.visibility = zOf[i] + cam > -40 ? 'hidden' : '';
      }

      let best = 0, bestD = Infinity;
      for (let i = 0; i < zOf.length; i++) {
        const d = Math.abs(zOf[i] + cam);
        if (d < bestD) { bestD = d; best = i; }
      }
      if (best === last) return;
      last = best;
      nodes.forEach((n, i) => n.classList.toggle('is-near', i === best));
      no.textContent = nodes[best].dataset.no || '';
      title.textContent = nodes[best].dataset.title || '';
    };
    addEventListener('scroll', () => { if (!raf) raf = requestAnimationFrame(paint); }, { passive: true });
    addEventListener('resize', () => { if (!raf) raf = requestAnimationFrame(paint); }, { passive: true });
    paint();
  }

  initDeck();
  document.addEventListener('astro:page-load', initDeck);
</script>
