---
/**
 * PREVIEW — WORK PAGE XI · "LEDGER".  Aasha.
 *
 * A REORDERED PAGE, AND TWO REBUILT SECTIONS.
 *
 * THE ORDER, which was the real problem with IX: that page led with a
 * statement, then the film, then the writing, and set the role — the single
 * most important fact on a composer's work page — in 10px of mono metadata.
 * A visitor arriving from the catalogue has already chosen the work. What
 * they want, in order, is: what is this, what did he do on it, let me see it,
 * why does it matter, then the details. All three of these share that spine
 * and differ only in how the last two sections are set.
 *
 * THE AWARDS AS A RULED TALLY, read left to right like a line of accounts.
 * The figure sits large in its own column with the label beside it rather
 * than beneath, so the three rows scan as a list of quantities — which is
 * what they are. Left-aligned with the reading rather than centred, because
 * this variation sets the whole page as a document rather than as a poster.
 *
 * THE CREDITS AS A GROUPED SPEC SHEET. IX gave one flat run of six rows with
 * no indication that "Director" and "Format" are different KINDS of fact.
 * Here they are grouped under their own subheads — Production, Recognition,
 * Elsewhere — each group ruled, so the block can be scanned for the one thing
 * wanted instead of read through.
 *
 * NOTHING IS INVENTED: every field comes from src/content/works/aasha.md.
 */
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import OpNav from '../../components/OpNav.astro';
import VideoFacade from '../../components/VideoFacade.astro';
import NextWork from '../../components/NextWork.astro';
import Colophon from '../../components/Colophon.astro';
import { Image } from 'astro:assets';
import { framesFor } from '../../lib/frames';
import { order, numberFor, total } from '../../data/composition';

const works = await getCollection('works');
const bySlug = new Map(works.map((w) => [w.id, w]));
const work = bySlug.get('aasha')!;
const d = work.data;

const seq = order.filter((s) => bySlug.has(s));
const next = bySlug.get(seq[(seq.indexOf('aasha') + 1) % seq.length])!;

const images = framesFor('aasha', d.frames);
const poster = images[0];
const num = numberFor('aasha');
const AR = d.ratio.replace(':', ' / ');

/* THE TALLY. One string in the file, split into figure/label pairs so the
   numbers can be set as numbers. Every part must begin with a figure or the
   whole thing falls back to the raw line — a tally with one broken cell is
   worse than no tally. */
const RAW_AWARDS = d.awards.map((a) => a.text).join(' · ');
const AW_PARTS = RAW_AWARDS.split('·').map((p) => p.trim()).filter(Boolean);
const AW_MATCH = AW_PARTS.map((p) => p.match(/^(\d+)\s+(.+)$/));
const TALLY = AW_MATCH.every(Boolean)
  ? AW_MATCH.map((m) => ({ n: m![1], k: m![2] }))
  : null;

const SPECS: { k: string; v: string }[] = d.meta.map((m) => ({ k: m.label, v: m.value }));
---

<Base title={`${d.title} — Ugam Khetani`} description={d.description}>
  <OpNav variant="bracket" />

  <article class="wk" style={`--ar:${AR}`}>
    {/* ── 1 · WHAT IT IS, AND WHAT HE DID ─────────────────────── */}
    <header class="hd">
      <p class="mono hd__folio">{num} / {String(total).padStart(2, '0')} · {d.category} · {d.year}</p>
      <h1 class="hd__t" data-reveal>
        <span class="line"><span class="line__in">{d.title}</span></span>
      </h1>
      <p class="hd__role" data-reveal>{d.role}</p>
      {d.credits.director && (
        <p class="mono hd__dir">A film by {d.credits.director}</p>
      )}
    </header>

    {/* ── 2 · SEE IT ──────────────────────────────────────────── */}
    <section class="blk blk--film" aria-label="Film" data-reveal>
      <VideoFacade youtube={d.media.youtube!} title={d.title} poster={poster} alt={d.alt} eager />
    </section>

    {/* ── 3 · WHY IT EXISTS ───────────────────────────────────── */}
    <section class="blk" aria-label="About the score" data-reveal>
      {d.quote && <p class="say"><em class="serif">{d.quote}</em></p>}
      <p class="body">{d.description.trim()}</p>
    </section>

    {/* ── 4 · WHAT IT WON ─────────────────────────────────────── */}
    {(TALLY || RAW_AWARDS) && (
      <section class="blk tally" aria-label="Recognition" data-reveal>
        <p class="mono blk__lbl">Recognition</p>
        {TALLY ? (
          <dl class="tal">
            {TALLY.map((t) => (
              <div class="tal__row">
                <dt class="tal__n">{t.n}</dt>
                <dd class="tal__k">{t.k}</dd>
              </div>
            ))}
          </dl>
        ) : (
          <p class="mono tal__raw">{RAW_AWARDS}</p>
        )}
      </section>
    )}

    {/* ── 5 · THE STILLS ──────────────────────────────────────── */}
    <section class="blk" aria-label="Stills" data-reveal>
      <p class="mono blk__lbl">Stills</p>
      <div class="grid">
        {images.map((img, i) => (
          <figure class="cel">
            <span class="cel__win">
              <Image
                src={img}
                alt={i === 0 ? d.alt : ''}
                aria-hidden={i === 0 ? undefined : 'true'}
                widths={[420, 700, 1100]}
                sizes="(max-width: 720px) 46vw, 30vw"
                loading={i < 3 ? 'eager' : 'lazy'}
                decoding="async"
              />
            </span>
            <figcaption class="mono cel__no">{String(i + 1).padStart(2, '0')}</figcaption>
          </figure>
        ))}
      </div>
    </section>

    {/* ── 6 · THE CREDITS, GROUPED ────────────────────────────── */}
    <section class="blk" aria-label="Credits" data-reveal>
      <p class="mono blk__lbl">Credits</p>
      <div class="led">
        <section class="led__grp">
          <h2 class="mono led__h">Production</h2>
          <dl class="led__list">
            <div class="led__row"><dt class="mono led__k">Role</dt><dd class="led__v">{d.role}</dd></div>
            {d.credits.director && (
              <div class="led__row"><dt class="mono led__k">Director</dt><dd class="led__v">{d.credits.director}</dd></div>
            )}
            {SPECS.map((s) => (
              <div class="led__row"><dt class="mono led__k">{s.k}</dt><dd class="led__v">{s.v}</dd></div>
            ))}
          </dl>
        </section>

        {RAW_AWARDS && (
          <section class="led__grp">
            <h2 class="mono led__h">Recognition</h2>
            <dl class="led__list">
              {TALLY ? TALLY.map((t) => (
                <div class="led__row"><dt class="mono led__k">{t.k}</dt><dd class="led__v">{t.n}</dd></div>
              )) : (
                <div class="led__row"><dt class="mono led__k">Festivals</dt><dd class="led__v">{RAW_AWARDS}</dd></div>
              )}
            </dl>
          </section>
        )}

        {d.links.length > 0 && (
          <section class="led__grp">
            <h2 class="mono led__h">Elsewhere</h2>
            <dl class="led__list">
              {d.links.map((l) => (
                <div class="led__row">
                  <dt class="mono led__k">{l.platform}</dt>
                  <dd class="led__v"><a class="led__link" href={l.url} target="_blank" rel="noopener">{l.label} &nearr;</a></dd>
                </div>
              ))}
            </dl>
          </section>
        )}
      </div>
    </section>

  </article>

  <NextWork
    slug={next.id}
    title={next.data.title}
    year={next.data.year}
    category={next.data.category}
    frames={next.data.frames}
    alt={next.data.alt}
  />
  <Colophon />
</Base>

<style is:global>
  .runhead { display: none !important; }
</style>

<style>
  .wk { padding: clamp(96px, 15vh, 190px) var(--margin) 0; }
  .blk { max-width: 1180px; margin: 0 auto clamp(72px, 12vh, 160px); }

  /* ── 1 · HEAD ───────────────────────────────────────────────── */
  .hd { max-width: 1180px; margin: 0 auto clamp(56px, 9vh, 120px); text-align: center; }
  .hd__folio {
    margin: 0 0 clamp(22px, 4vh, 44px);
    font-size: var(--t-micro); letter-spacing: 0.16em;
    text-transform: uppercase; color: var(--dim);
    font-variant-numeric: tabular-nums;
  }
  .hd__t {
    margin: 0;
    font-family: var(--display); font-weight: 500;
    font-size: clamp(2.6rem, 10vw, 8rem);
    line-height: 0.86; letter-spacing: -0.05em;
    text-transform: uppercase; color: var(--bone);
  }
  /* THE ROLE, PROMOTED. It was 10px mono furniture in IX; it is the single
     most important fact on a composer's work page. */
  .hd__role {
    margin: clamp(18px, 3vh, 34px) 0 0;
    font-family: var(--display); font-weight: 500;
    font-size: clamp(1.25rem, 2.8vw, 2.2rem);
    line-height: 1.05; letter-spacing: var(--track-tight);
    color: var(--accent);
  }
  .hd__dir {
    margin: 12px 0 0;
    font-size: var(--t-micro); letter-spacing: 0.16em;
    text-transform: uppercase; color: var(--muted);
  }

  .blk--film { margin-bottom: clamp(72px, 12vh, 160px); }

  /* ── 3 · THE WRITING ────────────────────────────────────────── */
  .say {
    margin: 0 auto clamp(30px, 5vh, 56px);
    max-width: 22ch; text-align: center;
    font-family: var(--display); font-weight: 500;
    font-size: clamp(1.4rem, 3.2vw, 2.5rem);
    line-height: 1.04; letter-spacing: var(--track-tight);
    color: var(--bone);
  }
  .say .serif { color: var(--accent); }
  .body {
    margin: 0 auto; max-width: 60ch; text-align: center;
    font-size: clamp(1.1rem, 1.8vw, 1.5rem);
    line-height: 1.44; letter-spacing: -0.012em;
    color: var(--bone-dim); text-wrap: pretty;
  }

  /* ── 4 · THE TALLY, AS ACCOUNTS ─────────────────────────────── */
  /* Figure in its own column, label beside it — three rows that scan as
     quantities. Ruled between rows only; the section already has a rule
     above it from .blk__lbl. */
  .tal { margin: 0; }
  .tal__row {
    display: grid;
    grid-template-columns: minmax(0, 5.5rem) minmax(0, 1fr);
    gap: clamp(16px, 2.4vw, 40px);
    align-items: baseline;
    padding: clamp(14px, 2.4vh, 26px) 0;
  }
  .tal__row + .tal__row { border-top: 1px solid var(--rule-soft); }
  .tal__n {
    margin: 0; text-align: right;
    font-family: var(--display); font-weight: 500;
    font-size: clamp(2.2rem, 5.5vw, 4rem);
    line-height: 0.85; letter-spacing: -0.05em;
    color: var(--accent); font-variant-numeric: tabular-nums;
  }
  .tal__k {
    margin: 0;
    font-size: clamp(1rem, 1.6vw, 1.35rem);
    letter-spacing: -0.01em; color: var(--bone-dim);
  }
  .tal__raw {
    margin: 0; font-size: var(--t-sm); letter-spacing: 0.14em;
    text-transform: uppercase; color: var(--accent);
  }

  /* ── 5 · STILLS ─────────────────────────────────────────────── */
  .blk__lbl {
    margin: 0 0 clamp(16px, 2.6vh, 28px);
    padding-bottom: 10px; border-bottom: 1px solid var(--rule);
    font-size: var(--t-micro); letter-spacing: 0.16em;
    text-transform: uppercase; color: var(--bone-dim);
  }
  .grid {
    display: grid; grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(20px, 2.6vw, 46px);
  }
  .cel { margin: 0; }
  .cel__win {
    display: block; aspect-ratio: var(--ar);
    overflow: hidden; background: var(--ground-lift);
  }
  .cel__win :global(img) {
    width: 100%; height: 100%; object-fit: cover;
    filter: saturate(0.94) contrast(1.02);
    transform: scale(1.001);
    transition: filter var(--d-micro) var(--ease), transform 1100ms var(--ease);
  }
  .cel:hover .cel__win :global(img) {
    filter: saturate(1) contrast(1.06) brightness(1.04);
    transform: scale(1.035);
  }
  .cel__no {
    display: block; margin-top: 8px;
    font-size: var(--t-micro); letter-spacing: 0.16em;
    color: var(--dim); font-variant-numeric: tabular-nums;
  }
  @media (max-width: 720px) { .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }

  /* ── 6 · THE GROUPED LEDGER ─────────────────────────────────── */
  /* Three groups side by side, each with its own subhead and its own rules,
     so a reader can go straight to the kind of fact they want. IX ran all six
     rows together with nothing to say that a director and a format are
     different sorts of thing. */
  .led {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(28px, 4vw, 72px);
    align-items: start;
  }
  .led__grp { min-width: 0; }
  .led__h {
    margin: 0 0 12px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--rule-accent);
    font-size: var(--t-micro); letter-spacing: 0.16em;
    text-transform: uppercase; color: var(--accent);
    font-weight: 400;
  }
  .led__list { margin: 0; }
  .led__row {
    display: grid;
    grid-template-columns: minmax(0, 7rem) minmax(0, 1fr);
    gap: 14px; align-items: baseline;
    padding: 10px 0;
    border-bottom: 1px solid var(--rule-soft);
  }
  .led__k { margin: 0; font-size: var(--t-micro); letter-spacing: 0.16em; text-transform: uppercase; color: var(--muted); }
  .led__v { margin: 0; font-size: var(--t-base); line-height: 1.35; color: var(--bone-dim); }
  .led__link {
    color: var(--bone); text-decoration: none;
    border-bottom: 1px solid var(--rule-accent); padding-bottom: 2px;
    transition: color var(--d-micro) var(--ease), border-color var(--d-micro) var(--ease);
  }
  .led__link:hover { color: var(--accent); border-color: var(--accent); }

  @media (max-width: 900px) {
    .led { grid-template-columns: 1fr; gap: clamp(28px, 5vh, 48px); }
  }
  @media (max-width: 560px) {
    .tal__row { grid-template-columns: minmax(0, 4rem) minmax(0, 1fr); }
    .led__row { grid-template-columns: 1fr; gap: 3px; }
  }

  /* This variation sets the page as a document, so the reading is ranged
     left rather than centred. */
  .hd, .say, .body { text-align: left; }
  .hd { margin-inline: 0; }
  .say, .body { margin-inline: 0; }
</style>
