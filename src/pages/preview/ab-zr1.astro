---
/**
 * ZR1 · THE ROUTE — ZW13's control on all six frames that would carry it.
 *
 * NOT A DESIGN. This is the evidence for a decision, built 2026-10-06 when
 * Ugam asked for ab-zw13 to be applied to the work pages. It was applied,
 * measured across the route, and REVERTED before being committed, because it
 * fails on half of them. The live site is untouched and still carries the
 * pill; this page is the only place the new control exists.
 *
 * WHY IT FAILS, IN ONE LINE: ZW13's whole argument is that the plate behind
 * the old button was holding white type off a brightness that is not there —
 * which is true of AASHA'S photograph, the one frame every draft in that
 * round was built and judged on. It is not true of the catalogue. §5 already
 * says this about the countdown: the thing that threatens white type is the
 * brightest patch inside the glyph's own outline, and that is a property of
 * the individual photograph.
 *
 * MEASURED ON THE BUILT SITE AT 1280x800, each ink against the brightest
 * pixel inside its own glyph box, floors 4.5:1 under 24px and 3:1 at or over:
 *
 *   work            frame        lead    platform     arrow   triangle
 *   Aasha           still 4:3   14.22    5.02         17.04   13.77    PASS
 *   Taskaree        still       5.44     9.82         12.93    9.82    PASS
 *   Ira             still       5.91     5.06          9.83    6.95    PASS
 *   Special Ops     still 2.1:1 1.84*    2.77*         5.45    2.80*   FAIL
 *   Mere Ho         cover 1:1   3.06*    1.01*         1.07*  18.09    FAIL
 *   Ve Maahi        cover 1:1   2.95*    1.66*         2.91*   8.90    FAIL
 *
 * Mere Ho's platform word reads 1.01:1. That is white on white: the sleeve is
 * near-paper at that corner, and the word is invisible rather than faint.
 *
 * SPECIAL OPS HAS NO DARK CORNER AT ALL. Its opening frame measures mean
 * .1619, p95 .3376 and a blown pixel at .9647 across the whole picture; the
 * darkest fifth of it still peaks at .7396. There is nowhere on that frame to
 * put unplated white type.
 *
 * AND A SCRIM CANNOT RESCUE IT CHEAPLY. Working back from the floors, a
 * ground-colour wash behind the lockup would have to reach ALPHA 0.806 to
 * carry Mere Ho's arrow — against the 0.35 the old pill used, and the pill had
 * a 6px backdrop blur helping it. Eighty-one per cent is not a wash, it is a
 * black panel, and a black panel is the thing ZW13 was chosen for not having.
 *
 * SO THE DECISION IS UGAM'S AND IT IS NOT A SMALL ONE. The options, with what
 * each costs, are in the note at the foot of this page.
 *
 * WHAT IS ALREADY BUILT AND IS NOT WASTED: src/components/WatchMark.astro
 * carries the control, and it derives the lead from the work's own label
 * rather than hardcoding "Watch on" — four of these say "Watch on", two say
 * "Listen on" and Diwali says "View on", so the draft's hardcoded verb would
 * have been wrong on three works. That part stands whichever option is taken.
 */
import Base from '../../layouts/Base.astro';
import OpNav from '../../components/OpNav.astro';
import WatchMark from '../../components/WatchMark.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { framesFor } from '../../lib/frames';
import { href } from '../../lib/href';

const works = await getCollection('works');

/* The six that render the control today: an `external` block, and an opening
   that is a bare still or an audio sleeve. Derived, not listed. */
const SHOWN = ['aasha', 'taskaree', 'ira', 'special-ops-2', 'mere-ho', 've-maahi'];
const rows = SHOWN.map((slug) => {
  const w = works.find((x) => x.id === slug)!;
  return { w, poster: framesFor(slug, w.data.frames)[0] };
});

/* Measured 2026-10-06, built site, 1280x800. Worst-pixel contrast per ink.
   Written down rather than computed, because it is a reading of a photograph
   and nothing in the page can derive it. */
const READ: Record<string, { lead: number; plat: number; arrow: number; tri: number; ok: boolean }> = {
  'aasha':         { lead: 14.22, plat: 5.02, arrow: 17.04, tri: 13.77, ok: true },
  'taskaree':      { lead: 5.44,  plat: 9.82, arrow: 12.93, tri: 9.82,  ok: true },
  'ira':           { lead: 5.91,  plat: 5.06, arrow: 9.83,  tri: 6.95,  ok: true },
  'special-ops-2': { lead: 1.84,  plat: 2.77, arrow: 5.45,  tri: 2.80,  ok: false },
  'mere-ho':       { lead: 3.06,  plat: 1.01, arrow: 1.07,  tri: 18.09, ok: false },
  've-maahi':      { lead: 2.95,  plat: 1.66, arrow: 2.91,  tri: 8.90,  ok: false },
};
const f2 = (n: number) => n.toFixed(2);
---

<Base title="ZR1 · The route — ZW13 across the six" description="ZW13's watch control measured on every frame that would carry it. Three of six fail; the live site is untouched.">
  <OpNav variant="bracket" base={href()} />

  <nav class="sw" aria-label="Watch-button drafts">
    <span class="sw__id">ZR1</span>
    <span class="sw__nm">The route</span>
    <span class="sw__su">ZW13 on all six frames — three of them fail</span>
    <span class="sw__set">
      <a class="sw__prev" href={href('preview/ab-zw13')} title="The draft this applies">ZW13</a>
      <a class="sw__prev" href={href('preview/ab-zw2')} title="The stack it came from">ZW2</a>
      <a class="sw__prev" href={href('work/special-ops-2')} title="The live page, still on the pill">LIVE</a>
    </span>
  </nav>

  <article class="sc">
    <header class="zr__hd">
      <p class="mono zr__over">Evidence · 2026-10-06 · nothing applied</p>
      <h1 class="zr__t">Three of six</h1>
      <p class="zr__lede">
        ZW13 takes the plate off the watch control because the corner it sits in
        is the darkest part of Aasha's frame. Every draft in that round was
        built on Aasha. Across the six frames that would actually carry it,
        three cannot hold unplated white type — and on Mere Ho the platform
        word reads 1.01:1, which is white on white.
      </p>
    </header>

    {rows.map(({ w, poster }) => {
      const r = READ[w.id];
      const isAudio = w.data.opening === 'audio';
      return (
        <section class="zr__case" aria-label={w.data.title}>
          <p class="mono zr__case-hd">
            <span class="zr__nm">{w.data.title}</span>
            <span class={`zr__flag ${r.ok ? 'is-ok' : 'is-bad'}`}>{r.ok ? 'passes' : 'fails'}</span>
          </p>

          <div class:list={['zr__frame', { 'is-cover': isAudio }]}>
            <Image src={poster} alt={w.data.alt} widths={[800, 1400, 2000]}
              sizes="(max-width: 900px) 100vw, 78vw" loading="eager" decoding="async" />
            {w.data.external && (
              <WatchMark label={w.data.external.label} platform={w.data.external.platform}
                url={w.data.external.url} />
            )}
          </div>

          <table class="zr__read">
            <thead>
              <tr><th>ink</th><th>size</th><th>reads</th><th>floor</th><th></th></tr>
            </thead>
            <tbody>
              <tr class={r.lead < 4.5 ? 'is-bad' : ''}>
                <td>lead</td><td>10px</td><td>{f2(r.lead)}:1</td><td>4.50</td>
                <td>{r.lead < 4.5 ? 'under' : ''}</td></tr>
              <tr class={r.plat < 3 ? 'is-bad' : ''}>
                <td>platform</td><td>51.2px</td><td>{f2(r.plat)}:1</td><td>3.00</td>
                <td>{r.plat < 3 ? 'under' : ''}</td></tr>
              <tr class={r.arrow < 4.5 ? 'is-bad' : ''}>
                <td>arrow</td><td>17.4px</td><td>{f2(r.arrow)}:1</td><td>4.50</td>
                <td>{r.arrow < 4.5 ? 'under' : ''}</td></tr>
              <tr class={r.tri < 3 ? 'is-bad' : ''}>
                <td>triangle</td><td>34.8px</td><td>{f2(r.tri)}:1</td><td>3.00</td>
                <td>{r.tri < 3 ? 'under' : ''}</td></tr>
            </tbody>
          </table>
        </section>
      );
    })}

    <section class="zr__note" aria-label="The decision">
      <h2 class="zr__nt">What the options cost</h2>
      <p>
        <b>Put it below the frame.</b> On the page's own ground white reads
        19.9:1 and the lead 13.96:1, on every work, whatever the photograph —
        and no chrome at all, now or when a seventeenth work arrives. It
        overturns §5's rule that a bare still has no window and the link
        belongs on the image.
      </p>
      <p>
        <b>Keep it on the frame and add a scrim.</b> Working back from the
        floors, it has to reach alpha 0.806 to carry Mere Ho's arrow. The pill
        it replaced used 0.35 plus a 6px blur. This is the option that gives
        back more chrome than was removed.
      </p>
      <p>
        <b>Two treatments.</b> ZW13 on the three dark frames, the pill on the
        three bright ones, chosen per work by measurement the way the countdown
        carries a dim value per frame. One route, two controls, and a reading
        to re-take whenever a frame changes.
      </p>
      <p>
        <b>Leave it.</b> The pill stays, ZW13 stays a draft, and the fourteen
        remain comparators. Costs nothing and answers nothing.
      </p>
    </section>
  </article>
</Base>

<style>
  .sw {
    position: fixed; inset: 0 0 auto; z-index: 900;
    display: flex; align-items: baseline; gap: 12px;
    padding: 9px clamp(16px, 4vw, 40px);
    background: color-mix(in srgb, var(--ground) 86%, transparent);
    backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--rule);
    font-family: var(--mono); font-size: var(--t-micro);
    letter-spacing: 0.16em; text-transform: uppercase;
  }
  .sw__id { color: var(--accent); }
  .sw__nm { color: var(--bone); }
  .sw__su { color: var(--dim); margin-right: auto; }
  .sw__set { display: flex; gap: 1px; align-items: baseline; }
  .sw__prev { color: color-mix(in srgb, var(--dim) 70%, var(--ground)); text-decoration: none; padding: 3px 6px; margin-left: 4px; }
  .sw__prev:hover { color: var(--bone); }

  .sc {
    --measure: min(760px, 100%);
    --film: max(var(--measure), calc(100vw - 3 * var(--margin)));
    padding: clamp(96px, 15vh, 190px) var(--margin) clamp(96px, 15vh, 190px);
  }
  .zr__hd { max-width: var(--measure); margin-inline: auto; }
  .zr__over {
    margin: 0 0 clamp(20px, 3vh, 36px);
    font-size: var(--t-micro); letter-spacing: 0.16em;
    text-transform: uppercase; color: var(--dim);
  }
  .zr__t {
    margin: 0 0 clamp(20px, 3vh, 34px);
    font-family: var(--display); font-weight: 500;
    font-size: clamp(2.6rem, 8vw, 5.5rem);
    line-height: 0.88; letter-spacing: -0.05em;
    text-transform: uppercase; color: var(--bone);
  }
  .zr__lede { margin: 0; font-size: var(--t-md); line-height: 1.6; color: var(--bone-dim); max-width: 48ch; }

  .zr__case { max-width: var(--measure); margin: clamp(72px, 12vh, 140px) auto 0; }
  .zr__case-hd {
    display: flex; align-items: baseline; gap: 14px;
    margin: 0 0 16px; padding-bottom: 10px;
    border-bottom: 1px solid var(--rule);
    font-size: var(--t-micro); letter-spacing: var(--track-mono); text-transform: uppercase;
  }
  .zr__nm { color: var(--bone); margin-right: auto; }
  .zr__flag.is-ok { color: var(--dim); }
  .zr__flag.is-bad { color: var(--accent); }

  .zr__frame { position: relative; width: var(--film); margin-inline: calc((100% - var(--film)) / 2); }
  /* The songs render a square sleeve, not a full-width still — the live page
     sizes it `min(--film, 72vh)`, and the control has to be judged at the size
     it will actually have. */
  .zr__frame.is-cover { width: min(var(--film), 72vh); margin-inline: auto; }
  .zr__frame :global(img) { width: 100%; height: auto; display: block; }

  .zr__read {
    width: 100%; margin-top: 18px; border-collapse: collapse;
    font-family: var(--mono); font-size: var(--t-micro);
    letter-spacing: 0.08em; text-transform: uppercase;
    font-variant-numeric: tabular-nums;
  }
  .zr__read th {
    text-align: left; font-weight: 400; color: var(--dim);
    padding: 6px 0; border-bottom: 1px solid var(--rule);
  }
  .zr__read td { padding: 6px 0; color: var(--bone-dim); border-bottom: 1px solid var(--rule); }
  .zr__read tr.is-bad td { color: var(--accent); }

  .zr__note { max-width: var(--measure); margin: clamp(96px, 16vh, 180px) auto 0; }
  .zr__nt {
    margin: 0 0 clamp(20px, 3vh, 32px);
    font-family: var(--display); font-weight: 500;
    font-size: clamp(1.6rem, 3.4vw, 2.4rem);
    line-height: 1; letter-spacing: -0.035em; text-transform: uppercase; color: var(--bone);
  }
  .zr__note p { margin: 0 0 18px; font-size: var(--t-base); line-height: 1.65; color: var(--bone-dim); max-width: 52ch; }
  .zr__note b { color: var(--bone); font-weight: 500; }
</style>
