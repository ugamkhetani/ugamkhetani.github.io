---
/**
 * MUMBAI STANDARD TIME · SUBHEADING DRAFT A — Dateline
 *
 * ONE OF SIX, asked for on 2026-09-06. Only the line under the title changes.
 * Nothing here is on the live site.
 *
 * The rule carries the width so the type does not have to. Still 10px, but
 * three short marks on a drawn edge instead of one long bar of text.
 *
 * THE PAGE AROUND IT IS DELIBERATELY CUT DOWN to the folio, the title, the
 * subheading, the statement and the film. That is not laziness: the thing
 * being judged is a 10px line against a 116px title, so the draft carries
 * exactly the type that sets that scale and nothing that would distract from
 * it. The six are generated from one scaffold, so the only difference between
 * any two of these files is the head block and its CSS.
 *
 * NOTHING IS INVENTED. Every word on the page is read from
 * src/content/works/mumbai-standard-time.md.
 */
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import OpNav from '../../components/OpNav.astro';
import VideoFacade from '../../components/VideoFacade.astro';
import { framesFor } from '../../lib/frames';
import { numberFor, total } from '../../data/composition';

const works = await getCollection('works');
const work = works.find((w) => w.id === 'mumbai-standard-time')!;
const d = work.data;
const poster = framesFor(work.id, d.frames)[0];
const num = numberFor(work.id);
const AR = d.ratio.replace(':', ' / ');

/* The six in order, so one can be flipped to the next without going back to
   the index. Built from the letters rather than written out, so adding a
   seventh is one character. */
const LETTERS = ['a', 'b', 'c', 'd', 'e', 'f', 'g', 'h', 'i', 'j', 'k', 'l'];
const HERE = 'a';
---

<Base title={`${d.title} — subheading A`} description={d.description}>
  <OpNav variant="bracket" base="/" />

  <article class="sc" style={`--ar:${AR}`}>
    <header class="hd">
      <p class="mono hd__folio">{num} / {String(total).padStart(2, '0')}</p>
      <h1 class="hd__t">{d.title}</h1>
      <div class="meta meta--a">
        <span class="meta__l">{d.category}</span>
        <span class="meta__c">{d.year}</span>
        <span class="meta__r">{d.role}</span>
      </div>
    </header>

    <section class="q" aria-label="Statement">
      <p class="q__t">{d.quote}</p>
    </section>

    <section class="blk" aria-label="The work">
      <VideoFacade youtube={d.media.youtube} title={d.title} poster={poster} alt={d.alt} eager />
    </section>

    <nav class="mono flip" aria-label="Drafts">
      {LETTERS.map((l) => (
        <a class={l === HERE ? 'flip__a is-here' : 'flip__a'} href={`/preview/mst-sub-${l}`}>{l.toUpperCase()}</a>
      ))}
      <a class="flip__all" href="/preview/">All drafts &rarr;</a>
    </nav>
  </article>
</Base>

<style>
  /* ── THE PAGE'S OWN TYPE, COPIED FROM src/pages/work/[slug].astro ──
     Copied rather than imported because a draft has to be able to differ from
     the live page without a shared file forcing them to agree. These three
     rules are what set the scale the subheading is judged against, so they
     are the ones that must NOT drift: if the title's clamp changes on the live
     page, change it here too or the comparison stops being honest. */
  .sc { --measure: min(760px, 100%); padding: clamp(96px, 15vh, 190px) var(--margin) 0; }
  .sc { --film: max(var(--measure), calc(100vw - 3 * var(--margin))); }
  .hd, .q, .blk { max-width: var(--measure); }
  .hd { margin-inline: auto; text-align: center; }
  .hd__folio {
    margin: 0 0 clamp(24px, 4vh, 48px);
    font-size: var(--t-micro); letter-spacing: 0.16em;
    text-transform: uppercase; color: var(--dim);
    font-variant-numeric: tabular-nums;
  }
  .hd__t {
    margin: 0;
    font-family: var(--display); font-weight: 500;
    font-size: clamp(2.6rem, 10vw, 7.25rem);
    line-height: 0.86; letter-spacing: -0.05em;
    text-transform: uppercase; color: var(--bone);
  }
  .q { max-width: 1180px; margin: clamp(80px, 14vh, 180px) auto; text-align: center; }
  .q__t {
    margin: 0 auto; max-width: 20ch;
    font-family: var(--display); font-weight: 500;
    font-size: clamp(1.9rem, 5.4vw, 4.4rem);
    line-height: 1.02; letter-spacing: -0.045em;
    color: var(--bone);
  }
  .blk { margin: 0 auto clamp(72px, 12vh, 160px); }
  .blk :global(.facade) {
    width: var(--film);
    margin-inline: calc((100% - var(--film)) / 2);
  }

  /* ── THE DRAFT ──────────────────────────────────────────────── */
  /* A · DATELINE. The RULE carries the width so the type does not have to.
     One hairline the measure of the title, three facts hung beneath it at the
     two ends and the middle. The line is 10px — the same size it is today —
     but it stops being one long bar of text and becomes three short marks on
     a drawn edge, which is what makes it read small. */
  .meta--a {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: baseline;
    gap: clamp(12px, 3vw, 40px);
    margin-top: clamp(26px, 4.4vh, 48px);
    padding-top: 13px;
    border-top: 1px solid var(--rule);
    font-family: var(--mono);
    font-size: var(--t-micro);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--dim);
  }
  .meta--a .meta__l { text-align: left; }
  .meta--a .meta__c { text-align: center; color: var(--muted); font-variant-numeric: tabular-nums; }
  .meta--a .meta__r { text-align: right; }
  @media (max-width: 640px) {
    .meta--a { grid-template-columns: 1fr; gap: 7px; text-align: center; }
    .meta--a .meta__l, .meta--a .meta__r { text-align: center; }
  }

  /* ── FLIPPING BETWEEN THE TWELVE ───────────────────────────────── */
  .flip {
    display: flex; justify-content: center; align-items: center; flex-wrap: wrap; gap: 8px;
    margin: 0 auto clamp(60px, 10vh, 120px);
    font-size: var(--t-micro); letter-spacing: 0.14em; text-transform: uppercase;
  }
  .flip__a {
    display: grid; place-items: center; width: 30px; height: 30px;
    border: 1px solid var(--rule); color: var(--dim); text-decoration: none;
  }
  .flip__a:hover { border-color: var(--bone-dim); color: var(--bone); }
  .flip__a.is-here { border-color: var(--accent); color: var(--accent); }
  .flip__all { margin-left: 14px; color: var(--dim); text-decoration: none; }
  .flip__all:hover { color: var(--bone); }
</style>
