---
/**
 * PREVIEW — WORK PAGE II · "SPREAD".  Aasha.
 *
 * THE WORK AS A MAGAZINE SPREAD. Two columns on a gutter with a rule down
 * the middle of it — the same arrangement the enquiry uses, borrowed here
 * because it is the one structure on this site that already reads as print.
 *
 * THE LEFT COLUMN IS THE MASTHEAD AND IT STAYS. Number, title, role,
 * director, awards: the facts you want in view while you read about the
 * score and while you watch the film. It is sticky rather than repeated,
 * so a reader four screens down still knows whose page this is without the
 * page having to tell them twice.
 *
 * THE RIGHT COLUMN IS THE ARTICLE. Standfirst, film, stills, credits, in
 * that order — the order a print feature runs in, and the order the facts
 * are actually wanted in.
 *
 * THE RULE STOPS SHORT OF THE FOOT, at half a gutter, which is the clearance
 * every other rule on this site leaves. It is not decoration: it marks where
 * the masthead's column ends, and stopping it clear of the closing rule keeps
 * the two from meeting in a corner that means nothing.
 *
 * ONE COLUMN UNDER 900px, and the rule goes with it — a 1px hairline down a
 * phone is a scar, not a gutter.
 *
 * NOTHING HERE IS INVENTED: every field comes from src/content/works/aasha.md.
 */
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import OpNav from '../../components/OpNav.astro';
import VideoFacade from '../../components/VideoFacade.astro';
import NextWork from '../../components/NextWork.astro';
import Colophon from '../../components/Colophon.astro';
import { Image } from 'astro:assets';
import { framesFor } from '../../lib/frames';
import { order, numberFor, total } from '../../data/composition';

const works = await getCollection('works');
const bySlug = new Map(works.map((w) => [w.id, w]));
const work = bySlug.get('aasha')!;
const d = work.data;

const seq = order.filter((s) => bySlug.has(s));
const next = bySlug.get(seq[(seq.indexOf('aasha') + 1) % seq.length])!;

const images = framesFor('aasha', d.frames);
const [poster, ...rest] = images;
const num = numberFor('aasha');

const FACTS: { k: string; v: string }[] = [
  ...(d.credits.director ? [{ k: 'Director', v: d.credits.director }] : []),
  ...d.meta.map((m) => ({ k: m.label, v: m.value })),
];
---

<Base title={`${d.title} — Ugam Khetani`} description={d.description}>
  <OpNav variant="bracket" />

  <article class="sp">
    <div class="sp__page">
      <span class="sp__rule" aria-hidden="true"></span>

      {/* ── LEFT · the masthead, held ─────────────────────────── */}
      <header class="mh">
        <div class="mh__in">
          <p class="mono mh__folio">
            <span class="mh__no">{num}</span>
            <span class="mh__of">/ {String(total).padStart(2, '0')}</span>
          </p>

          <h1 class="mh__t" data-reveal>
            <span class="line"><span class="line__in">{d.title}</span></span>
          </h1>

          <p class="mono mh__meta">{d.category} · {d.year}</p>
          <p class="mh__role">{d.role}</p>

          <hr class="mh__hr" />

          <dl class="mh__facts">
            {FACTS.map((f) => (
              <div class="mh__fact">
                <dt class="mono mh__k">{f.k}</dt>
                <dd class="mh__v">{f.v}</dd>
              </div>
            ))}
          </dl>

          {d.awards.length > 0 && (
            <p class="mono mh__awards">{d.awards.map((a) => a.text).join(' · ')}</p>
          )}

          {d.links.length > 0 && (
            <p class="mh__links">
              {d.links.map((l) => (
                <a class="mh__link" href={l.url} target="_blank" rel="noopener">{l.label} &nearr;</a>
              ))}
            </p>
          )}
        </div>
      </header>

      {/* ── RIGHT · the article ───────────────────────────────── */}
      <div class="art">
        {d.quote && (
          <blockquote class="pull" data-reveal>
            <p class="pull__t"><em class="serif">{d.quote}</em></p>
          </blockquote>
        )}

        <p class="lede" data-reveal>{d.description}</p>

        <section class="blk" aria-label="Film" data-reveal>
          <p class="mono blk__lbl">The film</p>
          <VideoFacade youtube={d.media.youtube!} title={d.title} poster={poster} alt={d.alt} eager />
        </section>

        {rest.length > 0 && (
          <section class="blk" aria-label="Stills" data-reveal>
            <p class="mono blk__lbl">Stills</p>
            <div class="figs" style={`--ar:${d.ratio.replace(':', ' / ')}`}>
              {rest.map((img, i) => (
                <figure class="fig">
                  <span class="fig__win">
                    <Image
                      src={img}
                      alt=""
                      aria-hidden="true"
                      widths={[480, 800, 1200]}
                      sizes="(max-width: 900px) 92vw, 44vw"
                      loading="lazy"
                      decoding="async"
                    />
                  </span>
                  <figcaption class="mono fig__no">{String(i + 2).padStart(2, '0')}</figcaption>
                </figure>
              ))}
            </div>
          </section>
        )}
      </div>
    </div>
  </article>

  <NextWork
    slug={next.id}
    title={next.data.title}
    year={next.data.year}
    category={next.data.category}
    frames={next.data.frames}
    alt={next.data.alt}
  />
  <Colophon />
</Base>

<style is:global>
  .runhead { display: none !important; }
</style>

<style>
  .sp {
    padding: clamp(96px, 15vh, 190px) var(--margin) 0;
  }

  /* Two columns and a gutter, exactly as the enquiry sets them. */
  .sp__page {
    /* One declaration for the gutter, because the rule below has to land in
       the middle of it and a second copy of the number would drift. */
    --gap: clamp(40px, 5vw, 88px);
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 0.82fr) minmax(0, 1fr);
    column-gap: var(--gap);
    max-width: 1320px;
    margin-inline: auto;
  }

  /* The rule down the gutter, centred in it and stopped short of the foot by
     half a gutter — the clearance every other rule on this site leaves.

     THE GAP HAS TO BE TAKEN OUT BEFORE THE COLUMNS ARE SPLIT. A fraction of
     100% lands 3px light, because the fr units divide what is left AFTER the
     column-gap, not the whole width — measured, the rule sat at 584 against a
     gutter running 555 to 619, whose middle is 587. Subtracting the gap
     first and adding half of it back puts the rule on the middle exactly, at
     every width. */
  .sp__rule {
    display: none;
    position: absolute;
    top: 0;
    bottom: clamp(20px, 2.5vw, 44px);
    left: calc((100% - var(--gap)) * 0.82 / 1.82 + var(--gap) / 2);
    width: 1px;
    background: var(--rule-soft);
    pointer-events: none;
  }
  @media (min-width: 901px) { .sp__rule { display: block; } }

  /* ── THE MASTHEAD ───────────────────────────────────────────── */
  .mh { min-width: 0; }
  .mh__in { position: sticky; top: clamp(96px, 14vh, 160px); }

  .mh__folio {
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin: 0 0 clamp(18px, 3vh, 30px);
    font-variant-numeric: tabular-nums;
  }
  .mh__no {
    font-size: var(--t-sm);
    letter-spacing: 0.14em;
    color: var(--accent);
  }
  .mh__of { font-size: var(--t-micro); letter-spacing: 0.14em; color: var(--dim); }

  .mh__t {
    margin: 0;
    font-family: var(--display);
    font-weight: 500;
    font-size: clamp(2.2rem, 6vw, 4.6rem);
    line-height: 0.9;
    letter-spacing: -0.045em;
    text-transform: uppercase;
    color: var(--bone);
  }

  .mh__meta {
    margin: clamp(16px, 2.6vh, 26px) 0 0;
    font-size: var(--t-micro);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .mh__role {
    margin: 6px 0 0;
    font-size: var(--t-md);
    letter-spacing: -0.01em;
    color: var(--bone-dim);
  }

  .mh__hr { border: 0; border-top: 1px solid var(--rule); margin: clamp(22px, 3.6vh, 38px) 0 0; }

  .mh__facts { margin: 0; }
  .mh__fact {
    display: grid;
    grid-template-columns: minmax(0, 7rem) minmax(0, 1fr);
    gap: 16px;
    align-items: baseline;
    padding: 11px 0;
    border-bottom: 1px solid var(--rule-soft);
  }
  .mh__k {
    margin: 0;
    font-size: var(--t-micro);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .mh__v { margin: 0; font-size: var(--t-base); line-height: 1.35; color: var(--bone-dim); }

  .mh__awards {
    margin: clamp(20px, 3.2vh, 32px) 0 0;
    font-size: var(--t-xs);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    line-height: 1.7;
  }

  .mh__links { margin: clamp(20px, 3.2vh, 32px) 0 0; display: flex; flex-wrap: wrap; gap: 20px; }
  .mh__link {
    font-size: var(--t-sm);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--bone);
    text-decoration: none;
    border-bottom: 1px solid var(--rule-accent);
    padding-bottom: 3px;
    transition: color var(--d-micro) var(--ease), border-color var(--d-micro) var(--ease);
  }
  .mh__link:hover { color: var(--accent); border-color: var(--accent); }

  /* ── THE ARTICLE ────────────────────────────────────────────── */
  .art { min-width: 0; }

  /* The pull quote opens the column, hung and unquoted — the marks would sit
     outside the measure and pull the first line out of alignment with
     everything under it. */
  .pull { margin: 0; }
  .pull__t {
    margin: 0;
    max-width: 20ch;
    font-family: var(--display);
    font-weight: 500;
    font-size: clamp(1.5rem, 3.4vw, 2.6rem);
    line-height: 1.04;
    letter-spacing: var(--track-tight);
    color: var(--bone);
  }
  .pull__t .serif { color: var(--accent); }

  .lede {
    margin: clamp(30px, 5vh, 56px) 0 0;
    max-width: 58ch;
    font-size: clamp(1.05rem, 1.5vw, 1.35rem);
    line-height: 1.45;
    letter-spacing: -0.01em;
    color: var(--bone-dim);
    text-wrap: pretty;
  }

  .blk { margin-top: clamp(56px, 9vh, 120px); }
  .blk__lbl {
    margin: 0 0 clamp(14px, 2.2vh, 24px);
    padding-bottom: 10px;
    border-bottom: 1px solid var(--rule);
    font-size: var(--t-micro);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--bone-dim);
  }

  /* Stills stagger down the column in two files, the right one dropped, so
     the eye travels rather than scanning a block. */
  .figs {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(20px, 2.5vw, 44px);
  }
  .fig { margin: 0; }
  .fig:nth-child(even) { margin-top: clamp(28px, 6vh, 76px); }
  .fig__win {
    display: block;
    aspect-ratio: var(--ar);
    overflow: hidden;
    background: var(--ground-lift);
  }
  .fig__win :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.94) contrast(1.02);
    transform: scale(1.001);
    transition:
      filter var(--d-micro) var(--ease),
      transform 1100ms var(--ease);
  }
  .fig:hover .fig__win :global(img) {
    filter: saturate(1) contrast(1.06) brightness(1.04);
    transform: scale(1.035);
  }
  .fig__no {
    display: block;
    margin-top: 8px;
    font-size: var(--t-micro);
    letter-spacing: 0.16em;
    color: var(--dim);
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 900px) {
    .sp__page { grid-template-columns: 1fr; row-gap: clamp(48px, 8vh, 96px); }
    .mh__in { position: static; }
    .art { margin-top: 0; }
  }
  @media (max-width: 560px) {
    .figs { grid-template-columns: 1fr; }
    .fig:nth-child(even) { margin-top: 0; }
  }
</style>
