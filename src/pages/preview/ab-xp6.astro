---
/**
 * XP6 · THE ATTENTION — the band divides itself by how you actually looked.
 *
 * THE IDEA: eight frames in a row, filling the width, and the share of the
 * width each one gets is the share of your attention it has earned. Rest on
 * 04 and 04 widens and keeps the width; ignore 07 and 07 narrows to a
 * sliver. By the time you leave, the band is not a layout — it is a portrait
 * of your own looking, and it is different for every person who opens it.
 *
 * WHY IT IS NOT AN ACCORDION. An accordion expands under the cursor and
 * springs back the moment you leave; it is a hover state and it forgets. This
 * ACCUMULATES and it KEEPS: the widths are the integral of dwell over the
 * whole visit, they survive scrolling away and back, and the only way to undo
 * them is to say so. That difference — between a hover and a record — is the
 * entire concept.
 *
 * NOTHING IS EVER HIDDEN. The band is always exactly full width and every
 * frame always holds some of it, so attention redistributes the set rather
 * than deleting from it. A frame you never looked at is still there, narrow,
 * which is a more pointed thing to show than an empty slot.
 *
 * THE LEDGER IS THE OTHER HALF. Mono rows under the band print the seconds
 * and the percentage, because the claim "this is how you looked" is only
 * worth making if it can be checked. The numbers are the evidence.
 *
 * AND IT SUITS THIS FILM PARTICULARLY. Aasha is about a boy whose whole
 * situation turns on whether anybody is paying attention to him. An interface
 * that measures exactly that, and shows you the answer, is not a gimmick
 * here — it is the subject.
 */
import Base from '../../layouts/Base.astro';
import OpNav from '../../components/OpNav.astro';
import { Image, getImage } from 'astro:assets';
import { getCollection } from 'astro:content';
import { framesFor } from '../../lib/frames';
import { href } from '../../lib/href';

/* THE REAL WORK AND THE REAL STILLS. The collection is the same one
   /work/aasha renders from, so the frames, title, roles, statement and
   standfirst are the page's own, and the harness around the experiment is the
   work page's own type and rhythm. The ONLY variable between ab-xp1 and
   ab-xp8 is the section below the "03 · Stills" rule.

   THE PRODUCTION PAGE IS NOT TOUCHED. src/pages/work/[slug].astro is
   untouched by all eight, and `withoutPreview()` keeps these routes out of
   the built site. */
const works = await getCollection('works');
const work = works.find((w) => w.id === 'aasha')!;
const d = work.data;
const images = framesFor('aasha', d.frames);
const LEDE = (d.description.trim().match(/^[^.!?]+[.!?]/) ?? [d.description.trim()])[0];
const ROLES = d.role.split('·').map((r) => r.trim());
const nn = (i: number) => String(i + 1).padStart(2, '0');

/* Optimised URLs for the drafts that need the frame inside a CSS property —
   a mask, a background, a band — where <Image> cannot reach. Astro emits
   these into the same /_astro/ directory as everything else. */
const WEB = await Promise.all(
  images.map((src) => getImage({ src, width: 1200, format: 'webp', quality: 78 })),
);

const DRAFTS: [string, string, string][] = [
  ['xp1', 'The score', 'The film’s light, measured and scrubbed'],
  ['xp2', 'The splice', 'You author the cut — 64 of them'],
  ['xp3', 'The sentence', 'The words are the apertures'],
  ['xp4', 'The field', 'A space larger than the window'],
  ['xp5', 'The persistence', 'It coheres only when you stop'],
  ['xp6', 'The attention', 'The band divides by how you looked'],
  ['xp7', 'The sort', 'Sequence against what the light implies'],
  ['xp8', 'The bath', 'Latent until it crosses the surface'],
];
const ME = 'xp6';
const MINE = DRAFTS.find(([id]) => id === ME)!;

---

<Base title={`${d.title} · ${MINE[1]} — stills ${ME.toUpperCase()}`} description={`An experimental direction for the stills section of the Aasha project page: ${MINE[2]}.`}>
  <OpNav variant="bracket" base={href()} />

  <nav class="sw" aria-label="Stills experiments">
    <span class="sw__id">{ME.toUpperCase()}</span>
    <span class="sw__nm">{MINE[1]}</span>
    <span class="sw__su">{MINE[2]}</span>
    <span class="sw__set">
      {DRAFTS.map(([id, name, sub]) => (
        <a class:list={['sw__i', { 'is-here': id === ME }]} href={href(`preview/ab-${id}`)}
          title={`${name} — ${sub}`} aria-current={id === ME ? 'page' : undefined}>{id.slice(2)}</a>
      ))}
      <a class="sw__prev" href={href('preview/ab-st1')} title="The first eight directions">ST1–8</a>
    </span>
  </nav>

  <article class="sc" style={`--ar:${d.ratio.replace(':', ' / ')}`}>
    <header class="hd">
      <p class="mono hd__over">{d.category} · {d.year}</p>
      <h1 class="hd__t">{d.title}</h1>
      <p class="mono hd__meta"><span class="hd__roles">{ROLES.map((r) => <span>{r}</span>)}</span></p>
    </header>

    {d.quote && (
      <section class="q" aria-label="Statement">
        <p class="q__t">{d.quote}</p>
      </section>
    )}

    <section class="blk body" aria-label="About">
      <p class="body__lede" style={`--n:${LEDE.length}`}>{LEDE}</p>
    </section>

    <!-- ══ 03 · STILLS — THE EXPERIMENT ══════════════════════════════ -->
    <section class="blk st" aria-label="Stills">
      <p class="mono st__lbl"><span>03</span><i aria-hidden="true"></i><span>Stills · {MINE[1]}</span></p>
      <div class="at" data-at>
        <div class="at__band" role="group" aria-label="Eight stills; each one widens with the time you spend on it">
          {images.map((img, i) => (
            <button class="at__c" type="button" data-at-c={i} style="--g:1"
              aria-label={`Frame ${nn(i)}`}>
              <Image src={img} alt={i === 0 ? d.alt : ''} aria-hidden={i === 0 ? undefined : 'true'}
                widths={[420, 760, 1200]} sizes="(max-width: 760px) 50vw, 30vw"
                loading={i < 4 ? 'eager' : 'lazy'} decoding="async" />
              <span class="mono at__n"><b>{nn(i)}</b><em data-at-pc={i}>12%</em></span>
            </button>
          ))}
        </div>

        <div class="at__ledger mono" aria-live="off">
          {images.map((_, i) => (
            <p class="at__row" data-at-r={i}>
              <b>{nn(i)}</b>
              <span class="at__bar"><i data-at-bar={i}></i></span>
              <em data-at-s={i}>0.0s</em>
            </p>
          ))}
        </div>

        <p class="mono hint">
          <em>Rest on a frame · the band keeps the score</em>
          <b data-at-total>0.0s</b>
          <i aria-hidden="true"></i>
          <button class="at__reset" type="button" data-at-reset>Forget it ↺</button>
        </p>
      </div>
    </section>

    <footer class="cl">
      <hr class="rule" />
      <p class="mono cl__p"><span>{MINE[0].toUpperCase()} · {MINE[1]}</span><i aria-hidden="true"></i><span>{d.awards}</span></p>
    </footer>
  </article>
</Base>

<script>
  /* THE INTEGRAL OF DWELL. Accrued in real milliseconds, kept in
     sessionStorage, and only ever reset on request. */
  const at = document.querySelector('[data-at]');
  if (at) {
    const KEY = 'xp6-attention';
    const cols = [...at.querySelectorAll('[data-at-c]')];
    const bars = [...at.querySelectorAll('[data-at-bar]')];
    const secs = [...at.querySelectorAll('[data-at-s]')];
    const pcs = [...at.querySelectorAll('[data-at-pc]')];
    const rows = [...at.querySelectorAll('[data-at-r]')];
    const totalEl = at.querySelector('[data-at-total]');
    const N = cols.length;
    let ms = new Array(N).fill(0);
    let on = -1, lastTick = 0, timer = 0;

    try {
      const saved = JSON.parse(sessionStorage.getItem(KEY) || 'null');
      if (Array.isArray(saved) && saved.length === N) ms = saved.map(Number);
    } catch (e) { /* a private window or blocked storage — start from zero */ }

    const paint = () => {
      const total = ms.reduce((a, b) => a + b, 0);
      const max = Math.max(1, ...ms);
      /* Relative to the most-looked-at frame, so the band is always a
         portrait and never saturates into eight equal wide columns. */
      cols.forEach((c, i) => {
        const share = ms[i] / max;
        c.style.setProperty('--g', (1 + share * 6.5).toFixed(3));
        const pc = total ? (ms[i] / total) * 100 : 100 / N;
        c.classList.toggle('is-fat', share > 0.42);
        rows[i].classList.toggle('is-fat', share > 0.42);
        if (pcs[i]) pcs[i].textContent = `${pc.toFixed(0)}%`;
        if (bars[i]) bars[i].style.setProperty('--p', `${(share * 100).toFixed(1)}%`);
        if (secs[i]) secs[i].textContent = `${(ms[i] / 1000).toFixed(1)}s`;
      });
      if (totalEl) totalEl.textContent = `${(total / 1000).toFixed(1)}s`;
    };

    const save = () => { try { sessionStorage.setItem(KEY, JSON.stringify(ms.map((n) => Math.round(n)))); } catch (e) {} };

    const tick = () => {
      const now = performance.now();
      const dt = Math.min(250, now - lastTick);
      lastTick = now;
      if (on >= 0 && !document.hidden) { ms[on] += dt; paint(); }
    };

    cols.forEach((c, i) => {
      c.addEventListener('pointerenter', () => { on = i; lastTick = performance.now(); });
      c.addEventListener('focus', () => { on = i; lastTick = performance.now(); });
      /* A tap is a deliberate look: give it a second outright, so touch
         readers can build a portrait at all. */
      c.addEventListener('click', () => { ms[i] += 1000; paint(); save(); });
    });
    at.querySelector('.at__band').addEventListener('pointerleave', () => { on = -1; save(); });
    at.addEventListener('focusout', (e) => { if (!at.contains(e.relatedTarget)) { on = -1; save(); } });
    timer = setInterval(tick, 80);
    addEventListener('visibilitychange', () => { lastTick = performance.now(); if (document.hidden) save(); });
    addEventListener('pagehide', save);

    at.querySelector('[data-at-reset]').addEventListener('click', () => {
      ms = new Array(N).fill(0); on = -1; paint(); save();
    });

    paint();
    window.atAdd = (i, n) => { ms[i] += n; paint(); };
    window.atState = () => ({ ms: ms.map((n) => Math.round(n)), grow: cols.map((c) => +c.style.getPropertyValue('--g')) });
  }
</script>

<style>
  /* ══ THE HARNESS ═══════════════════════════════════════════════════
     The work page's own type and rhythm, shared verbatim by all eight, so
     the only thing being judged below the rule is the stills section. */
  .sw {
    position: fixed; inset: 0 0 auto; z-index: 900;
    display: flex; align-items: baseline; gap: 12px;
    padding: 9px clamp(16px, 4vw, 40px);
    background: color-mix(in srgb, var(--ground) 86%, transparent);
    backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--rule);
    font-family: var(--mono); font-size: var(--t-micro);
    letter-spacing: 0.16em; text-transform: uppercase;
  }
  .sw__id { color: var(--accent); }
  .sw__nm { color: var(--bone); }
  .sw__su { color: var(--dim); margin-right: auto; }
  .sw__set { display: flex; gap: 1px; align-items: baseline; }
  .sw__i {
    color: var(--dim); text-decoration: none; padding: 3px 7px;
    border: 1px solid transparent; font-variant-numeric: tabular-nums;
  }
  .sw__i:hover { color: var(--bone); }
  .sw__i.is-here { color: var(--accent); border-color: var(--rule); }
  .sw__prev { color: color-mix(in srgb, var(--dim) 70%, var(--ground)); text-decoration: none; padding: 3px 0 3px 12px; margin-left: 6px; border-left: 1px solid var(--rule); }
  .sw__prev:hover { color: var(--bone-dim); }
  @media (max-width: 860px) { .sw__su { display: none; } .sw__nm { margin-right: auto; } }
  @media (max-width: 560px) { .sw__nm, .sw__prev { display: none; } }

  .sc { padding: clamp(84px, 13vh, 150px) var(--margin) 0; }
  .hd { text-align: center; margin-bottom: clamp(38px, 6.6vh, 80px); }
  .hd__over { font-size: var(--t-micro); letter-spacing: 0.18em; text-transform: uppercase; color: var(--muted); margin: 0 0 clamp(16px, 2.6vh, 30px); }
  .hd__t { margin: 0; font-family: var(--display); font-weight: 500; font-size: clamp(2.6rem, 7vw, 5.6rem); line-height: 0.94; letter-spacing: -0.04em; color: var(--bone); }
  .hd__meta { margin: clamp(14px, 2.2vh, 26px) 0 0; font-size: var(--t-micro); letter-spacing: 0.18em; text-transform: uppercase; color: var(--bone-dim); }
  .hd__roles { display: inline-flex; flex-wrap: wrap; justify-content: center; gap: 0 14px; }
  .hd__roles span + span::before { content: '·'; margin-right: 14px; color: var(--dim); }
  .q { max-width: 34ch; margin: 0 auto clamp(50px, 8vh, 110px); text-align: center; }
  .q__t { margin: 0; font-family: var(--serif); font-style: italic; font-weight: 300; font-size: clamp(1.25rem, 2.4vw, 1.9rem); line-height: 1.26; letter-spacing: -0.012em; color: var(--bone-dim); }
  .body { max-width: var(--measure); margin-inline: auto; }
  .body__lede { margin: 0 auto; max-width: clamp(20ch, calc(var(--n, 90) / 3 * 1ch), 44ch); font-family: var(--display); font-weight: 500; font-size: clamp(1.2rem, min(calc(2.35rem - (var(--n, 90) - 55) * 0.007rem), calc(1.05rem + 2.1vw)), 2.2rem); line-height: 1.12; letter-spacing: -0.025em; color: var(--bone); text-wrap: balance; }
  .blk { margin: 0 auto clamp(104px, 18vh, 240px); }

  .st { --w: var(--measure); }
  .st__lbl {
    display: flex; align-items: center; gap: 12px;
    width: var(--w); margin: 0 auto clamp(24px, 4vh, 50px);
    font-size: var(--t-micro); letter-spacing: 0.18em; text-transform: uppercase; color: var(--muted);
  }
  .st__lbl i { flex: 1; height: 1px; background: var(--rule); }

  /* The one piece of furniture every experiment shares: a line of mono that
     says what the thing in front of you responds to. An experimental
     interaction that nobody can find is a failed one. */
  .hint {
    display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap;
    width: var(--w); margin: 14px auto 0;
    font-size: var(--t-micro); letter-spacing: 0.16em; text-transform: uppercase; color: var(--dim);
  }
  .hint b { font-weight: 400; color: var(--accent); font-variant-numeric: tabular-nums; }
  .hint em { font-style: normal; color: var(--muted); }
  .hint i { flex: 1; min-width: 20px; height: 1px; background: var(--rule); transform: translateY(-3px); }

  .cl { max-width: var(--measure); margin: 0 auto; padding-bottom: clamp(48px, 9vh, 110px); }
  .rule { border: 0; border-top: 1px solid var(--rule); margin: 0 0 16px; }
  .cl__p { display: flex; align-items: baseline; gap: 14px; margin: 0; font-size: var(--t-micro); letter-spacing: 0.16em; text-transform: uppercase; color: var(--dim); }
  .cl__p i { flex: 1; height: 1px; background: var(--rule); transform: translateY(-3px); }
  .cl__p span:last-child { text-align: right; }
  @media (max-width: 620px) { .cl__p { flex-direction: column; gap: 6px; } .cl__p i { display: none; } .cl__p span:last-child { text-align: left; } }

  /* ── XP6 · THE ATTENTION ───────────────────────────────────── */
  .st { --w: min(calc(100vw - 2 * var(--margin)), 1180px); }
  .at { width: var(--w); margin-inline: auto; }

  /* ALWAYS EXACTLY FULL WIDTH. Attention redistributes the band; it never
     removes from it, so every frame keeps a share however little it earned. */
  .at__band { display: flex; height: clamp(280px, 54vh, 600px); gap: 1px; background: var(--rule); }
  .at__c {
    position: relative; flex: var(--g, 1) 1 0; min-width: 0;
    padding: 0; border: 0; background: var(--ground-lift); cursor: pointer; overflow: hidden;
    -webkit-tap-highlight-color: transparent;
  }
  .at__c img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .at__c:focus-visible { outline: 1px solid var(--accent); outline-offset: -2px; z-index: 2; }
  @media (prefers-reduced-motion: no-preference) {
    .at__c { transition: flex-grow 240ms cubic-bezier(0.3, 0.8, 0.3, 1); }
  }

  .at__n {
    position: absolute; inset: auto auto 9px 9px; display: flex; gap: 8px; align-items: baseline;
    font-size: var(--t-micro); letter-spacing: 0.16em; color: var(--bone);
    /* A short, local scrim only under the two numerals — the photograph is
       not darkened to make room for furniture. */
    text-shadow: 0 0 10px rgba(0, 0, 0, 0.85), 0 0 3px rgba(0, 0, 0, 0.9);
    font-variant-numeric: tabular-nums;
  }
  .at__n em { font-style: normal; color: var(--accent); opacity: 0; }
  .at__c.is-fat .at__n em { opacity: 1; }

  .at__ledger { margin-top: 16px; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2px 34px; }
  .at__row {
    display: grid; grid-template-columns: 2.4em minmax(0, 1fr) 3.6em; align-items: center; gap: 10px; margin: 0;
    padding: 5px 0; border-top: 1px solid var(--rule);
    font-size: var(--t-micro); letter-spacing: 0.16em; color: var(--dim);
  }
  .at__row b { font-weight: 400; font-variant-numeric: tabular-nums; }
  .at__row.is-fat b { color: var(--bone); }
  .at__bar { display: block; height: 1px; background: var(--rule); }
  .at__bar i { display: block; height: 1px; width: var(--p, 0%); background: var(--accent); }
  .at__row em { font-style: normal; text-align: right; font-variant-numeric: tabular-nums; }
  @media (prefers-reduced-motion: no-preference) { .at__bar i { transition: width 240ms linear; } }

  .at__reset { border: 1px solid var(--rule); background: none; cursor: pointer; padding: 5px 11px; font: inherit; letter-spacing: inherit; color: var(--dim); }
  .at__reset:hover { border-color: var(--accent); color: var(--bone); }

  @media (max-width: 760px) {
    .at__band { height: clamp(220px, 40vh, 340px); }
    .at__ledger { grid-template-columns: 1fr; }
  }
</style>
