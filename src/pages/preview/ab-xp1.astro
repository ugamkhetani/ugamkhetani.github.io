---
/**
 * XP1 · THE SCORE — the film's own light, measured, and read like a score.
 *
 * THE IDEA: the person whose page this is writes music for picture. A score
 * is a drawing of time; a still is time stopped. So this section refuses to
 * treat the eight frames as eight pictures and treats them as ONE CONTINUOUS
 * SIGNAL — the luminance of the film, sampled 128 columns per frame, 1024
 * samples end to end, drawn as a single unbroken ribbon. A playhead reads it.
 *
 * THE RIBBON IS NOT A DECORATION AND IT IS NOT DRAWN BY HAND. On load the
 * browser pulls the actual frames into a canvas and computes the curve from
 * the pixels. What you are looking at is this film's light, and it would be a
 * different shape for any other film. That is the whole argument for the
 * direction: the interface is derived from the work rather than applied to it.
 *
 * WHAT IT INVERTS: everywhere else the picture is the content and the
 * furniture annotates it. Here the CURVE is the content — it is the thing you
 * navigate, the only control on the page — and the photograph is what the
 * curve resolves into. You read the film as light and the image is the
 * footnote.
 *
 * WHY IT SUITS THESE EIGHT: they are monochrome and they run from near-black
 * (03, the tap) to the blown highlight of 05's slatted light. A set this
 * tonally wide has a curve worth reading. A set of evenly-exposed frames
 * would draw a flat line, and this direction would have nothing to say.
 *
 * THE PLAYHEAD IS COLUMN-ACCURATE, which is the part that makes it a scrub
 * rather than a picker: moving inside one frame's 128 columns moves the tick
 * under the picture to the exact column being read, so you can see WHERE in
 * the frame the light is doing what the curve says.
 */
import Base from '../../layouts/Base.astro';
import OpNav from '../../components/OpNav.astro';
import { Image, getImage } from 'astro:assets';
import { getCollection } from 'astro:content';
import { framesFor } from '../../lib/frames';
import { href } from '../../lib/href';

/* THE REAL WORK AND THE REAL STILLS. The collection is the same one
   /work/aasha renders from, so the frames, title, roles, statement and
   standfirst are the page's own, and the harness around the experiment is the
   work page's own type and rhythm. The ONLY variable between ab-xp1 and
   ab-xp8 is the section below the "03 · Stills" rule.

   THE PRODUCTION PAGE IS NOT TOUCHED. src/pages/work/[slug].astro is
   untouched by all eight, and `withoutPreview()` keeps these routes out of
   the built site. */
const works = await getCollection('works');
const work = works.find((w) => w.id === 'aasha')!;
const d = work.data;
const images = framesFor('aasha', d.frames);
const LEDE = (d.description.trim().match(/^[^.!?]+[.!?]/) ?? [d.description.trim()])[0];
const ROLES = d.role.split('·').map((r) => r.trim());
const nn = (i: number) => String(i + 1).padStart(2, '0');
/* `awards` is {text, star?}[], not a string — interpolating the array
   itself renders "[object Object]" in the colophon. */
const AWARDS = (d.awards ?? []).map((a: { text: string }) => a.text).join(' · ');

/* Optimised URLs for the drafts that need the frame inside a CSS property —
   a mask, a background, a band — where <Image> cannot reach. Astro emits
   these into the same /_astro/ directory as everything else. */
const WEB = await Promise.all(
  images.map((src) => getImage({ src, width: 1200, format: 'webp', quality: 78 })),
);

const DRAFTS: [string, string, string][] = [
  ['xp1', 'The score', 'The film’s light, measured and scrubbed'],
  ['xp2', 'The splice', 'You author the cut — 64 of them'],
  ['xp3', 'The sentence', 'The words are the apertures'],
  ['xp4', 'The field', 'A space larger than the window'],
  ['xp5', 'The persistence', 'It coheres only when you stop'],
  ['xp6', 'The attention', 'The band divides by how you looked'],
  ['xp7', 'The sort', 'Sequence against what the light implies'],
  ['xp8', 'The bath', 'Latent until it crosses the surface'],
];
const ME = 'xp1';
const MINE = DRAFTS.find(([id]) => id === ME)!;

---

<Base title={`${d.title} · ${MINE[1]} — stills ${ME.toUpperCase()}`} description={`An experimental direction for the stills section of the Aasha project page: ${MINE[2]}.`}>
  <OpNav variant="bracket" base={href()} />

  <nav class="sw" aria-label="Stills experiments">
    <span class="sw__id">{ME.toUpperCase()}</span>
    <span class="sw__nm">{MINE[1]}</span>
    <span class="sw__su">{MINE[2]}</span>
    <span class="sw__set">
      {DRAFTS.map(([id, name, sub]) => (
        <a class:list={['sw__i', { 'is-here': id === ME }]} href={href(`preview/ab-${id}`)}
          title={`${name} — ${sub}`} aria-current={id === ME ? 'page' : undefined}>{id.slice(2)}</a>
      ))}
      <a class="sw__prev" href={href('preview/ab-st1')} title="The first eight directions">ST1–8</a>
    </span>
  </nav>

  <article class="sc" style={`--ar:${d.ratio.replace(':', ' / ')}`}>
    <header class="hd">
      <p class="mono hd__over">{d.category} · {d.year}</p>
      <h1 class="hd__t">{d.title}</h1>
      <p class="mono hd__meta"><span class="hd__roles">{ROLES.map((r) => <span>{r}</span>)}</span></p>
    </header>

    {d.quote && (
      <section class="q" aria-label="Statement">
        <p class="q__t">{d.quote}</p>
      </section>
    )}

    <section class="blk body" aria-label="About">
      <p class="body__lede" style={`--n:${LEDE.length}`}>{LEDE}</p>
    </section>

    <!-- ══ 03 · STILLS — THE EXPERIMENT ══════════════════════════════ -->
    <section class="blk st" aria-label="Stills">
      <p class="mono st__lbl"><span>03</span><i aria-hidden="true"></i><span>Stills · {MINE[1]}</span></p>
      <div class="sr" data-sr>
        <div class="sr__stage">
          {images.map((img, i) => (
            <span class:list={['sr__f', { 'is-on': i === 0 }]} data-sr-f={i}>
              <Image src={img} alt={i === 0 ? d.alt : ''} aria-hidden={i === 0 ? undefined : 'true'}
                widths={[760, 1140, 1520]} sizes="(max-width: 900px) 94vw, 760px"
                loading={i < 3 ? 'eager' : 'lazy'} decoding="async" />
            </span>
          ))}
          <i class="sr__col" data-sr-col aria-hidden="true"></i>
        </div>

        <p class="mono sr__read">
          <b class="sr__no" data-sr-no>01</b>
          <span class="sr__w">Column <b data-sr-cn>001</b></span>
          <i aria-hidden="true"></i>
          <span class="sr__w">Luma <b data-sr-lm>·····</b></span>
          <span class="sr__w sr__peak" data-sr-pk></span>
        </p>

        <div class="sr__rib" data-sr-rib tabindex="0" role="slider"
          aria-label="Scrub the film's measured luminance"
          aria-valuemin="0" aria-valuemax="1023" aria-valuenow="0" aria-valuetext="Frame 01, column 1">
          <svg class="sr__svg" viewBox="0 0 1024 160" preserveAspectRatio="none" aria-hidden="true">
            <path class="sr__area" data-sr-area d="" />
            <path class="sr__line" data-sr-line d="" />
            {images.map((_, i) => i > 0 && <line class="sr__div" x1={i * 128} x2={i * 128} y1="0" y2="160" />)}
          </svg>
          <span class="sr__head" data-sr-head aria-hidden="true"></span>
          <span class="sr__ticks" aria-hidden="true">
            {images.map((_, i) => <b class="mono" data-sr-tk={i}>{nn(i)}</b>)}
          </span>
        </div>

        <p class="mono hint">
          <em>Drag the curve</em><b data-sr-state>reading</b>
          <i aria-hidden="true"></i>
          <span data-sr-note>1024 columns measured in your browser</span>
        </p>
      </div>
    </section>

    <footer class="cl">
      <hr class="rule" />
      <p class="mono cl__p"><span>{MINE[0].toUpperCase()} · {MINE[1]}</span><i aria-hidden="true"></i><span>{AWARDS}</span></p>
    </footer>
  </article>
</Base>

<script>
  /* MEASURED, NOT ASSERTED. The browser reads the actual frames into a
     128x96 canvas and computes from the pixels. Same-origin, so getImageData
     is not tainted; if anything throws, the caller falls back and says so on
     the page rather than showing a made-up curve. */
  async function measure(nodes, W = 128, H = 96) {
    const c = document.createElement('canvas');
    c.width = W; c.height = H;
    const x = c.getContext('2d', { willReadFrequently: true });
    const out = [];
    for (const im of nodes) {
      try { if (im.decode) await im.decode(); } catch (e) { /* fall through */ }
      x.clearRect(0, 0, W, H);
      x.drawImage(im, 0, 0, W, H);
      const px = x.getImageData(0, 0, W, H).data;
      const lum = (o) => (0.2126 * px[o] + 0.7152 * px[o + 1] + 0.0722 * px[o + 2]) / 255;
      const cols = new Array(W).fill(0);
      let sum = 0, sq = 0, grad = 0;
      for (let cx = 0; cx < W; cx++) {
        let s = 0;
        for (let cy = 0; cy < H; cy++) {
          const v = lum((cy * W + cx) * 4);
          s += v; sum += v; sq += v * v;
          if (cx) grad += Math.abs(v - lum((cy * W + cx - 1) * 4));
        }
        cols[cx] = s / H;
      }
      const n = W * H;
      const mean = sum / n;
      out.push({
        cols, mean,
        sd: Math.sqrt(Math.max(0, sq / n - mean * mean)),
        detail: grad / ((W - 1) * H),
      });
    }
    return out;
  }
  const sr = document.querySelector('[data-sr]');
  if (sr) {
    const frames = [...sr.querySelectorAll('[data-sr-f]')];
    const nodes = frames.map((f) => f.querySelector('img'));
    const ticks = [...sr.querySelectorAll('[data-sr-tk]')];
    const rib = sr.querySelector('[data-sr-rib]');
    const head = sr.querySelector('[data-sr-head]');
    const colMark = sr.querySelector('[data-sr-col]');
    const elNo = sr.querySelector('[data-sr-no]');
    const elCn = sr.querySelector('[data-sr-cn]');
    const elLm = sr.querySelector('[data-sr-lm]');
    const elPk = sr.querySelector('[data-sr-pk]');
    const elState = sr.querySelector('[data-sr-state]');
    const elNote = sr.querySelector('[data-sr-note]');
    const W = 128, N = frames.length, TOTAL = W * N;
    let curve = null, at = 0, peakAt = -1;

    const draw = (data) => {
      const flat = [];
      data.forEach((f) => f.cols.forEach((v) => flat.push(v)));
      /* 8% of headroom top and bottom so the brightest column does not touch
         the rule and the darkest still reads as a line rather than as nothing. */
      const y = (v) => 160 - (0.08 + v * 0.84) * 160;
      let line = '';
      flat.forEach((v, i) => { line += (i ? 'L' : 'M') + i + ' ' + y(v).toFixed(2) + ' '; });
      sr.querySelector('[data-sr-line]').setAttribute('d', line.trim());
      sr.querySelector('[data-sr-area]').setAttribute('d', `M0 160 ` + line.replace(/^M/, 'L') + `L${flat.length - 1} 160 Z`);
      peakAt = flat.indexOf(Math.max(...flat));
      curve = flat;
    };

    const paint = () => {
      const i = Math.floor(at / W), c = at % W;
      frames.forEach((f, k) => f.classList.toggle('is-on', k === i));
      ticks.forEach((t, k) => t.classList.toggle('is-on', k === i));
      head.style.setProperty('--p', (at / (TOTAL - 1)).toFixed(5));
      /* The tick under the picture is in the STAGE's pixels, not the curve's. */
      colMark.style.setProperty('--c', ((c / (W - 1)) * sr.querySelector('.sr__stage').clientWidth).toFixed(1));
      elNo.textContent = String(i + 1).padStart(2, '0');
      elCn.textContent = String(c + 1).padStart(3, '0');
      if (curve) {
        elLm.textContent = curve[at].toFixed(3);
        elPk.textContent = at === peakAt ? '← brightest column in the film' : '';
      }
      rib.setAttribute('aria-valuenow', String(at));
      rib.setAttribute('aria-valuetext', `Frame ${String(i + 1).padStart(2, '0')}, column ${c + 1}`);
    };

    const seek = (clientX) => {
      const b = rib.getBoundingClientRect();
      const p = Math.min(1, Math.max(0, (clientX - b.left) / b.width));
      at = Math.min(TOTAL - 1, Math.round(p * (TOTAL - 1)));
      paint();
    };

    let held = false;
    rib.addEventListener('pointerdown', (e) => {
      held = true; rib.setPointerCapture(e.pointerId); seek(e.clientX);
      if (elState) elState.textContent = 'scrubbing';
    });
    rib.addEventListener('pointermove', (e) => { if (held) { e.preventDefault(); seek(e.clientX); } });
    const release = (e) => {
      if (!held) return;
      held = false;
      try { rib.releasePointerCapture(e.pointerId); } catch (err) {}
      if (elState) elState.textContent = 'reading';
    };
    rib.addEventListener('pointerup', release);
    rib.addEventListener('pointercancel', release);
    /* A hover scrub would make the curve impossible to read without changing
       it, so the pointer only drives the playhead while it is held down. */

    rib.addEventListener('keydown', (e) => {
      const k = e.key;
      const step = e.shiftKey ? 1 : W;   /* a frame at a time, or a column with Shift */
      let next = at;
      if (k === 'ArrowRight') next = at + step;
      else if (k === 'ArrowLeft') next = at - step;
      else if (k === 'Home') next = 0;
      else if (k === 'End') next = TOTAL - 1;
      else if (k === 'PageDown') next = at + W;
      else if (k === 'PageUp') next = at - W;
      else return;
      e.preventDefault();
      at = Math.min(TOTAL - 1, Math.max(0, next));
      paint();
    });
    addEventListener('resize', paint);

    paint();
    measure(nodes, W, 96)
      .then((data) => { draw(data); paint(); if (elNote) elNote.textContent = `${TOTAL} columns measured in your browser`; })
      .catch(() => { if (elNote) elNote.textContent = 'Curve unavailable — the frames could not be read'; });
    window.srSeek = (i) => { at = Math.min(TOTAL - 1, Math.max(0, i)); paint(); };
    window.srCurve = () => curve;
  }
</script>

<style>
  /* ══ THE HARNESS ═══════════════════════════════════════════════════
     The work page's own type and rhythm, shared verbatim by all eight, so
     the only thing being judged below the rule is the stills section. */
  .sw {
    position: fixed; inset: 0 0 auto; z-index: 900;
    display: flex; align-items: baseline; gap: 12px;
    padding: 9px clamp(16px, 4vw, 40px);
    background: color-mix(in srgb, var(--ground) 86%, transparent);
    backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--rule);
    font-family: var(--mono); font-size: var(--t-micro);
    letter-spacing: 0.16em; text-transform: uppercase;
  }
  .sw__id { color: var(--accent); }
  .sw__nm { color: var(--bone); }
  .sw__su { color: var(--dim); margin-right: auto; }
  .sw__set { display: flex; gap: 1px; align-items: baseline; }
  .sw__i {
    color: var(--dim); text-decoration: none; padding: 3px 7px;
    border: 1px solid transparent; font-variant-numeric: tabular-nums;
  }
  .sw__i:hover { color: var(--bone); }
  .sw__i.is-here { color: var(--accent); border-color: var(--rule); }
  .sw__prev { color: color-mix(in srgb, var(--dim) 70%, var(--ground)); text-decoration: none; padding: 3px 0 3px 12px; margin-left: 6px; border-left: 1px solid var(--rule); }
  .sw__prev:hover { color: var(--bone-dim); }
  @media (max-width: 860px) { .sw__su { display: none; } .sw__nm { margin-right: auto; } }
  @media (max-width: 560px) { .sw__nm, .sw__prev { display: none; } }

  .sc { padding: clamp(84px, 13vh, 150px) var(--margin) 0; }
  .hd { text-align: center; margin-bottom: clamp(38px, 6.6vh, 80px); }
  .hd__over { font-size: var(--t-micro); letter-spacing: 0.18em; text-transform: uppercase; color: var(--muted); margin: 0 0 clamp(16px, 2.6vh, 30px); }
  .hd__t { margin: 0; font-family: var(--display); font-weight: 500; font-size: clamp(2.6rem, 7vw, 5.6rem); line-height: 0.94; letter-spacing: -0.04em; color: var(--bone); }
  .hd__meta { margin: clamp(14px, 2.2vh, 26px) 0 0; font-size: var(--t-micro); letter-spacing: 0.18em; text-transform: uppercase; color: var(--bone-dim); }
  .hd__roles { display: inline-flex; flex-wrap: wrap; justify-content: center; gap: 0 14px; }
  .hd__roles span + span::before { content: '·'; margin-right: 14px; color: var(--dim); }
  .q { max-width: 34ch; margin: 0 auto clamp(50px, 8vh, 110px); text-align: center; }
  .q__t { margin: 0; font-family: var(--serif); font-style: italic; font-weight: 300; font-size: clamp(1.25rem, 2.4vw, 1.9rem); line-height: 1.26; letter-spacing: -0.012em; color: var(--bone-dim); }
  .body { max-width: var(--measure); margin-inline: auto; }
  .body__lede { margin: 0 auto; max-width: clamp(20ch, calc(var(--n, 90) / 3 * 1ch), 44ch); font-family: var(--display); font-weight: 500; font-size: clamp(1.2rem, min(calc(2.35rem - (var(--n, 90) - 55) * 0.007rem), calc(1.05rem + 2.1vw)), 2.2rem); line-height: 1.12; letter-spacing: -0.025em; color: var(--bone); text-wrap: balance; }
  .blk { margin: 0 auto clamp(104px, 18vh, 240px); }

  .st { --w: var(--measure); }
  .st__lbl {
    display: flex; align-items: center; gap: 12px;
    width: var(--w); margin: 0 auto clamp(24px, 4vh, 50px);
    font-size: var(--t-micro); letter-spacing: 0.18em; text-transform: uppercase; color: var(--muted);
  }
  .st__lbl i { flex: 1; height: 1px; background: var(--rule); }

  /* The one piece of furniture every experiment shares: a line of mono that
     says what the thing in front of you responds to. An experimental
     interaction that nobody can find is a failed one. */
  .hint {
    display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap;
    width: var(--w); margin: 14px auto 0;
    font-size: var(--t-micro); letter-spacing: 0.16em; text-transform: uppercase; color: var(--dim);
  }
  .hint b { font-weight: 400; color: var(--accent); font-variant-numeric: tabular-nums; }
  .hint em { font-style: normal; color: var(--muted); }
  .hint i { flex: 1; min-width: 20px; height: 1px; background: var(--rule); transform: translateY(-3px); }

  .cl { max-width: var(--measure); margin: 0 auto; padding-bottom: clamp(48px, 9vh, 110px); }
  .rule { border: 0; border-top: 1px solid var(--rule); margin: 0 0 16px; }
  .cl__p { display: flex; align-items: baseline; gap: 14px; margin: 0; font-size: var(--t-micro); letter-spacing: 0.16em; text-transform: uppercase; color: var(--dim); }
  .cl__p i { flex: 1; height: 1px; background: var(--rule); transform: translateY(-3px); }
  .cl__p span:last-child { text-align: right; }
  @media (max-width: 620px) { .cl__p { flex-direction: column; gap: 6px; } .cl__p i { display: none; } .cl__p span:last-child { text-align: left; } }

  /* ── XP1 · THE SCORE ───────────────────────────────────────── */
  .st { --w: min(calc(100vw - 2 * var(--margin)), 760px); }
  .sr { width: var(--w); margin-inline: auto; }

  .sr__stage { position: relative; aspect-ratio: var(--ar); background: var(--ground-lift); overflow: hidden; }
  .sr__f { position: absolute; inset: 0; opacity: 0; }
  .sr__f.is-on { opacity: 1; }
  .sr__f img { width: 100%; height: 100%; object-fit: cover; display: block; }
  /* The column the playhead is reading, marked ON the picture's own edge
     rather than over it — a 2px tick at the foot, nothing covering the frame. */
  .sr__col {
    position: absolute; bottom: 0; left: 0; width: 2px; height: 13px;
    background: var(--accent); transform: translateX(calc(var(--c, 0) * 1px - 1px));
  }

  .sr__read {
    display: flex; align-items: baseline; gap: 12px; flex-wrap: wrap;
    margin: 12px 0 clamp(16px, 2.4vh, 26px);
    font-size: var(--t-micro); letter-spacing: 0.16em; text-transform: uppercase; color: var(--dim);
  }
  .sr__no { font-weight: 400; font-size: 1.5rem; letter-spacing: -0.02em; color: var(--bone); line-height: 1; }
  .sr__w b { font-weight: 400; color: var(--bone-dim); font-variant-numeric: tabular-nums; }
  .sr__read i { flex: 1; min-width: 20px; height: 1px; background: var(--rule); transform: translateY(-4px); }
  .sr__peak { color: var(--accent); }

  /* THE CURVE IS THE CONTROL. */
  .sr__rib {
    position: relative; height: clamp(104px, 17vh, 170px);
    border-top: 1px solid var(--rule); border-bottom: 1px solid var(--rule);
    cursor: ew-resize; touch-action: none; user-select: none;
  }
  .sr__rib:focus-visible { outline: 1px solid var(--accent); outline-offset: 2px; }
  .sr__svg { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  .sr__area { fill: color-mix(in srgb, var(--bone) 9%, transparent); }
  .sr__line { fill: none; stroke: var(--bone-dim); stroke-width: 1.1; vector-effect: non-scaling-stroke; }
  .sr__div { stroke: var(--rule); stroke-width: 1; vector-effect: non-scaling-stroke; }
  .sr__head {
    position: absolute; top: 0; bottom: 0; left: 0; width: 1px; background: var(--accent);
    transform: translateX(calc(var(--p, 0) * 100%));
  }
  .sr__head::after {
    content: ''; position: absolute; top: -1px; left: -2px; width: 5px; height: 5px; background: var(--accent);
  }
  .sr__ticks {
    position: absolute; inset: auto 0 6px; display: grid; grid-template-columns: repeat(8, 1fr);
    pointer-events: none;
  }
  .sr__ticks b {
    font-weight: 400; font-size: var(--t-micro); letter-spacing: 0.14em; padding-left: 5px;
    color: color-mix(in srgb, var(--dim) 60%, var(--ground)); font-variant-numeric: tabular-nums;
  }
  .sr__ticks b.is-on { color: var(--bone); }

  @media (max-width: 620px) { .sr__rib { height: 124px; } .sr__no { font-size: 1.2rem; } }
</style>
