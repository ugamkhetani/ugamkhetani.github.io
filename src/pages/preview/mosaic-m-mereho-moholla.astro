---
/**
 * PREVIEW — MOSAIC M · "MERE HO / MOHOLLA".
 *
 * MERE HO AND MOHOLLA EXCHANGE. In the live bed Mere Ho sits at cell 9 and
 * Moholla at cell 10; this puts Moholla in 9 and Mere Ho in 10. Their unseen
 * cells, 25 and 26, trade with them.
 *
 * IT MOVES THE ONE FRAME WITH TYPE IN IT FURTHER OUT OF SIGHT. Mere Ho is a
 * square record sleeve with its own title set into the artwork — "mere ho" and
 * "HEEYA TIKKU" measured at 0.844 to 0.931 of the frame height — and the live
 * bed does not crop it. Moving it from cell 9 to cell 10 takes it from clear
 * 0.175 of the time to 0.115, so that type is on screen about a third less
 * often. Moholla, which carries no type, takes the better cell.
 *
 * SO THIS ONE HAS A REASON BEYOND PREFERENCE, unlike L. It is the cheapest way
 * to make the burned-in title less present without cropping the frame.
 *
 * IT STARTS FROM THE LIVE BED, NOT FROM A COPY OF IT. The cast and the crops
 * are imported from src/lib/bed.ts, the same tables index.astro renders from,
 * and this page applies one further exchange on top. So if the live bed changes
 * again, this draft moves with it instead of quietly describing an older
 * version of the site.
 *
 * EVERYTHING ELSE IS THE LIVE BED TO THE DECLARATION — six columns, thirty
 * tiles, the same gap, -10% inset, brightness(0.30) saturate(0.7) contrast(1.05),
 * the same -8% drift on --prog and scale(1.06).
 */
import Base from '../../layouts/Base.astro';
import Stage from '../../components/_pv-MosaicStage.astro';
import Tile from '../../components/_pv-MosaicTile.astro';
import { getCollection } from 'astro:content';
import { order } from '../../data/composition';
import { BED_SWAPS, BED_CROP, BED_TILES } from '../../lib/bed';
import { CLEAR_RANK } from '../../lib/_pv-mosaic';

const works = await getCollection('works');
const bySlug = new Map(works.map((w) => [w.id, w]));

/* The live cast first. */
const liveCast = order.map((slug) => BED_SWAPS[slug] ?? slug);

/* APPLIED — so this page no longer proposes anything, and its exchange is
   empty. It imports the live tables, and the live tables now contain the swap
   it was arguing for; applying it again here would swap it straight back and
   the page would show the bed as it was BEFORE the decision, labelled as the
   proposal. Kept as the record of what was chosen, rendering what is live. */
const EXTRA: Record<string, string> = {};
const cast = liveCast.map((slug) => EXTRA[slug] ?? slug);

const TILES = Array.from({ length: BED_TILES }, (_, i) => {
  const slug = cast[i % cast.length];
  return { slug, w: bySlug.get(slug)!, cell: i, moved: slug === 'mere-ho' || slug === 'moholla' };
});

const CLEAR = new Map(CLEAR_RANK.map((c) => [c.cell, c.clear]));
---

<Base title="Mosaic M — Mere Ho / Moholla (applied)" description="Preview only.">
  <Stage letter="M" name="Mere Ho / Moholla — applied" note="APPLIED — this is now what the live bed renders, and the page is kept as the record of it. Moholla holds cell 9 and Mere Ho cell 10, which moves the one frame with type burned into it further out of sight: Mere Ho is a record sleeve carrying its own title, and cell 10 is clear 0.115 of the time against cell 9&#39;s 0.175, so that title is on screen about a third less often. Moholla, which carries no type, took the better cell.">
    <div class="ms__ground" slot="bed" aria-hidden="true">
      <div class="ms__bed">
        {TILES.map((t) => (
          <span class="ms__tile" class:list={[{ 'is-moved': t.moved, 'is-clear': (CLEAR.get(t.cell) ?? 0) > 0 }]}>
            <Tile slug={t.w.id} frames={t.w.data.frames} alt="" crop={BED_CROP[t.w.id]} />
            <span class="ms__mark mono" aria-hidden="true">
              <b>{t.cell}</b>
              {t.w.data.title}
              <i>{(CLEAR.get(t.cell) ?? 0) > 0 ? `clear ${CLEAR.get(t.cell)}` : 'never seen'}</i>
            </span>
          </span>
        ))}
      </div>
    </div>
  </Stage>
</Base>

<style>
  /* ── index.astro's bed, copied declaration for declaration ─────── */
  .ms__ground { position: fixed; inset: 0; z-index: 0; pointer-events: none; overflow: hidden; }
  .ms__bed {
    position: absolute; inset: -10%;
    display: grid; grid-template-columns: repeat(6, minmax(0, 1fr));
    grid-auto-rows: minmax(0, 1fr); gap: clamp(5px, 0.8vw, 13px);
    filter: brightness(0.30) saturate(0.7) contrast(1.05);
    transform: translate3d(0, calc(var(--prog, 0) * -8%), 0) scale(1.06);
    will-change: transform;
  }
  .ms__tile { position: relative; display: block; overflow: hidden; min-height: 0; border-radius: clamp(6px, 0.7vw, 12px); }
  .ms__tile :global(img) { border-radius: inherit; }

  .ms__mark { display: none; }
  :global(.rg.map-on) .ms__bed { filter: brightness(0.62) saturate(0.7) contrast(1.05); }
  :global(.rg.map-on) .ms__tile { outline: 1px solid rgba(255, 255, 255, 0.1); outline-offset: -1px; }
  :global(.rg.map-on) .ms__tile.is-clear { outline-color: var(--rule-accent); }
  :global(.rg.map-on) .ms__tile.is-moved { outline: 2px solid var(--accent); }
  :global(.rg.map-on) .ms__mark {
    position: absolute; inset: 0; z-index: 2;
    display: grid; align-content: center; justify-items: center; gap: 3px;
    padding: 6px; text-align: center;
    font-size: 9px; letter-spacing: 0.08em; line-height: 1.25;
    color: var(--bone); background: rgba(6, 6, 5, 0.62);
  }
  :global(.rg.map-on) .ms__mark b { font-size: 15px; letter-spacing: 0; color: var(--dim); }
  :global(.rg.map-on) .ms__tile.is-clear .ms__mark b { color: var(--bone); }
  :global(.rg.map-on) .ms__tile.is-moved .ms__mark b { color: var(--accent); }
  :global(.rg.map-on) .ms__tile:not(.is-clear) .ms__mark { background: rgba(6, 6, 5, 0.85); color: var(--dim); }
  :global(.rg.map-on) .ms__mark i { font-style: normal; font-size: 8px; color: var(--dim); }

  @media (max-width: 900px) {
    .ms__bed { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }
</style>
