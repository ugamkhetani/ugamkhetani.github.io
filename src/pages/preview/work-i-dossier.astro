---
/**
 * PREVIEW — WORK PAGE I · "DOSSIER".  Aasha.
 *
 * THE WORK AS A FILE IN THE CATALOGUE, not as a landing page.
 *
 * The site's opening frames every movement with four corner labels and gives
 * the middle to the type. A work page is one more movement in that sequence,
 * so it opens the same way — the frame, the corners, the name — and then does
 * what the homepage never can: stays on one work long enough to say something
 * about it.
 *
 * WHAT MAKES IT EDITORIAL RATHER THAN DECORATED. Three things, all of them
 * borrowed from print rather than from the web:
 *   · the standfirst is set at reading size and given a measure, so the one
 *     paragraph of real writing on the page is the largest body text on it;
 *   · the eight frames are a CONTACT SHEET — numbered, gridded, uniform, in
 *     shooting order — which is how a film's stills are actually looked at;
 *   · the credits are a ledger with ruled rows, not a list of chips.
 *
 * THE QUOTE IS THE PAGE'S ONE PIECE OF DISPLAY WRITING. "A score begins
 * before the theme arrives" is the argument the description then explains, so
 * it is set once, large, in the Fraunces italic the site uses for its accents,
 * and never repeated.
 *
 * NOTHING HERE IS INVENTED. Title, year, category, role, director, awards,
 * quote, description, meta and the YouTube id all come from
 * src/content/works/aasha.md; the number comes from data/composition.
 */
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import OpNav from '../../components/OpNav.astro';
import VideoFacade from '../../components/VideoFacade.astro';
import CreditBlock from '../../components/CreditBlock.astro';
import NextWork from '../../components/NextWork.astro';
import Colophon from '../../components/Colophon.astro';
import { Image } from 'astro:assets';
import { framesFor } from '../../lib/frames';
import { order, numberFor, total } from '../../data/composition';

const works = await getCollection('works');
const bySlug = new Map(works.map((w) => [w.id, w]));
const work = bySlug.get('aasha')!;
const d = work.data;

const seq = order.filter((s) => bySlug.has(s));
const next = bySlug.get(seq[(seq.indexOf('aasha') + 1) % seq.length])!;

const images = framesFor('aasha', d.frames);
const [poster, ...rest] = images;
const num = numberFor('aasha');

/* The credit rows, built once so the ledger and the corners cannot disagree
   about who did what. Only keys the file actually carries are emitted. */
const CREDITS: { k: string; v: string }[] = [
  { k: 'Role', v: d.role },
  ...(d.credits.director ? [{ k: 'Director', v: d.credits.director }] : []),
  ...(d.credits.artist ? [{ k: 'Artist', v: d.credits.artist }] : []),
  ...d.meta.map((m) => ({ k: m.label, v: m.value })),
];
---

<Base title={`${d.title} — Ugam Khetani`} description={d.description}>
  <OpNav variant="bracket" />

  <article class="wk" data-wk>
    {/* ── 1 · THE FILE HEAD ────────────────────────────────────── */}
    <header class="fr fr--open">
      <p class="mono cn cn--tl">{num}/{String(total).padStart(2, '0')}<br />{d.category}</p>
      <p class="mono cn cn--tr">{d.year}<br />{d.role}</p>
      <p class="mono cn cn--bl">Dir.<br />{d.credits.director}</p>
      <p class="mono cn cn--br">Selected works<br /><span class="cue">Scroll &darr;</span></p>

      <div class="fr__mid">
        <h1 class="ttl">
          <span class="line" data-reveal><span class="line__in">{d.title}</span></span>
        </h1>
        {d.quote && (
          <p class="stmt">
            <span class="line" data-reveal style="--i:1"><span class="line__in">
              <em class="serif">{d.quote}</em>
            </span></span>
          </p>
        )}
      </div>
    </header>

    {/* ── 2 · THE FILM ─────────────────────────────────────────── */}
    <section class="reel" aria-label="Film" data-reveal>
      <p class="mono sec__lbl"><span class="sec__no">01</span> The film</p>
      <div class="reel__win">
        <VideoFacade youtube={d.media.youtube!} title={d.title} poster={poster} alt={d.alt} eager />
      </div>
    </section>

    {/* ── 3 · THE STANDFIRST ───────────────────────────────────── */}
    <section class="say" aria-label="About the score" data-reveal>
      <p class="mono sec__lbl"><span class="sec__no">02</span> The score</p>
      <p class="say__body">{d.description}</p>
      {d.awards.length > 0 && (
        <p class="mono say__awards">{d.awards.map((a) => a.text).join(' · ')}</p>
      )}
    </section>

    {/* ── 4 · THE CONTACT SHEET ────────────────────────────────── */}
    {rest.length > 0 && (
      <section class="sheet" aria-label="Stills" data-reveal>
        <p class="mono sec__lbl"><span class="sec__no">03</span> Contact sheet</p>
        <div class="sheet__grid" style={`--ar:${d.ratio.replace(':', ' / ')}`}>
          {images.map((img, i) => (
            <figure class="cell">
              <span class="cell__win">
                <Image
                  src={img}
                  alt={i === 0 ? d.alt : ''}
                  aria-hidden={i === 0 ? undefined : 'true'}
                  widths={[320, 560, 900]}
                  sizes="(max-width: 720px) 46vw, 22vw"
                  loading={i < 2 ? 'eager' : 'lazy'}
                  decoding="async"
                />
              </span>
              <figcaption class="mono cell__no">{String(i + 1).padStart(2, '0')}</figcaption>
            </figure>
          ))}
        </div>
      </section>
    )}

    {/* ── 5 · THE LEDGER ───────────────────────────────────────── */}
    <section class="ldg" aria-label="Credits" data-reveal>
      <p class="mono sec__lbl"><span class="sec__no">04</span> Credits</p>
      <dl class="ldg__list">
        {CREDITS.map((c) => (
          <div class="ldg__row">
            <dt class="mono ldg__k">{c.k}</dt>
            <dd class="ldg__v">{c.v}</dd>
          </div>
        ))}
      </dl>
      {d.links.length > 0 && (
        <p class="ldg__links">
          {d.links.map((l) => (
            <a class="ldg__link" href={l.url} target="_blank" rel="noopener">{l.label} &nearr;</a>
          ))}
        </p>
      )}
    </section>
  </article>

  <NextWork
    slug={next.id}
    title={next.data.title}
    year={next.data.year}
    category={next.data.category}
    frames={next.data.frames}
    alt={next.data.alt}
  />
  <Colophon />
</Base>

<style is:global>
  .runhead { display: none !important; }
</style>

<style>
  .wk {
    --gut: clamp(20px, 2.5vw, 44px);
    padding-inline: var(--margin);
  }

  /* ── THE FRAME. The homepage's own opening, one work deep. ──── */
  .fr {
    position: relative;
    padding: clamp(30px, 5vh, 66px) clamp(26px, 4vw, 72px);
    text-align: center;
    padding-top: clamp(96px, 15vh, 190px);
  }
  .cn {
    position: absolute;
    margin: 0;
    z-index: 3;
    font-size: var(--t-micro);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--bone-dim);
    line-height: 1.55;
  }
  .cn--tl { top: clamp(60px, 10vh, 120px); left: 0; text-align: left; color: var(--bone); }
  .cn--tr { top: clamp(60px, 10vh, 120px); right: 0; text-align: right; }
  .cn--bl { bottom: 0; left: 0; text-align: left; }
  .cn--br { bottom: 0; right: 0; text-align: right; }
  .cue { color: var(--dim); }

  .fr__mid { position: relative; z-index: 2; }

  /* The name, at the masthead's own weight — this page is a movement of the
     same document, not a different one. */
  .ttl {
    margin: 0;
    font-family: var(--display);
    font-weight: 500;
    font-size: clamp(2.4rem, 9.2vw, 7.6rem);
    line-height: 0.86;
    letter-spacing: -0.045em;
    text-transform: uppercase;
    color: var(--bone);
  }

  /* THE ONE PIECE OF DISPLAY WRITING ON THE PAGE. Set at the statement's
     size, in the Fraunces italic the site reserves for accents, and given a
     measure so it breaks as a sentence rather than as a banner. */
  .stmt {
    margin: clamp(28px, 5vh, 60px) auto 0;
    max-width: 22ch;
    font-family: var(--display);
    font-weight: 500;
    font-size: clamp(1.15rem, 2.4vw, 2rem);
    line-height: 1.08;
    letter-spacing: var(--track-tight);
    color: var(--bone-dim);
  }
  .stmt .serif { color: var(--accent); }

  /* ── SECTION LABELS. The catalogue's furniture, reused. ─────── */
  .sec__lbl {
    display: flex;
    align-items: baseline;
    gap: 14px;
    margin: 0 0 clamp(18px, 3vh, 34px);
    padding-bottom: 12px;
    border-bottom: 1px solid var(--rule);
    font-size: var(--t-micro);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--bone-dim);
  }
  .sec__no { color: var(--accent); font-variant-numeric: tabular-nums; }

  .reel, .say, .sheet, .ldg { margin-top: clamp(64px, 11vh, 150px); }

  /* ── THE FILM. One window, held to the catalogue's measure. ─── */
  .reel__win { max-width: 1180px; }

  /* ── THE STANDFIRST ─────────────────────────────────────────── */
  /* The largest body text on the page, because it is the only writing on it.
     A 60ch measure at this size lands near the 66 characters typography has
     agreed on for a century — long enough to read as prose, short enough to
     return to the next line without hunting for it. */
  .say__body {
    margin: 0;
    max-width: 60ch;
    font-size: clamp(1.15rem, 1.9vw, 1.6rem);
    line-height: 1.42;
    letter-spacing: -0.012em;
    color: var(--bone-dim);
    text-wrap: pretty;
  }
  .say__awards {
    margin: clamp(24px, 4vh, 44px) 0 0;
    font-size: var(--t-sm);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
  }

  /* ── THE CONTACT SHEET ──────────────────────────────────────── */
  /* Uniform cells in shooting order, numbered. A film's stills are looked at
     as a sheet, not as a gallery of hero crops — so nothing here is featured,
     cropped differently, or allowed to break the grid. The work's own ratio
     governs every cell, so the sheet is true to the film's frame. */
  .sheet__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--gut);
  }
  .cell { margin: 0; }
  .cell__win {
    display: block;
    aspect-ratio: var(--ar);
    overflow: hidden;
    background: var(--ground-lift);
    border: 1px solid var(--rule-soft);
  }
  .cell__win :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.94) contrast(1.02);
    transform: scale(1.001);
    transition:
      filter var(--d-micro) var(--ease),
      transform 1100ms var(--ease);
  }
  .cell:hover .cell__win :global(img) {
    filter: saturate(1) contrast(1.06) brightness(1.04);
    transform: scale(1.035);
  }
  .cell__no {
    display: block;
    margin-top: 8px;
    font-size: var(--t-micro);
    letter-spacing: 0.16em;
    color: var(--dim);
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 720px) {
    .sheet__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  /* ── THE LEDGER ─────────────────────────────────────────────── */
  /* Ruled rows, label left and value right, tabular — the shape a credit
     block takes on paper. The rule is the soft one: sixteen of them stacked
     at full strength would read as a table of contents rather than as a
     quiet record underneath the work. */
  .ldg__list { margin: 0; }
  .ldg__row {
    display: grid;
    grid-template-columns: minmax(0, 12rem) minmax(0, 1fr);
    gap: var(--gut);
    align-items: baseline;
    padding: 14px 0;
    border-bottom: 1px solid var(--rule-soft);
  }
  .ldg__k {
    margin: 0;
    font-size: var(--t-micro);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .ldg__v {
    margin: 0;
    font-size: var(--t-md);
    line-height: 1.3;
    color: var(--bone-dim);
  }
  .ldg__links { margin: clamp(24px, 4vh, 40px) 0 0; display: flex; flex-wrap: wrap; gap: 24px; }
  .ldg__link {
    font-size: var(--t-sm);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--bone);
    text-decoration: none;
    border-bottom: 1px solid var(--rule-accent);
    padding-bottom: 3px;
    transition: color var(--d-micro) var(--ease), border-color var(--d-micro) var(--ease);
  }
  .ldg__link:hover { color: var(--accent); border-color: var(--accent); }

  @media (max-width: 640px) {
    .ldg__row { grid-template-columns: 1fr; gap: 4px; }
    .cn--bl, .cn--br { position: static; text-align: left; display: block; margin-top: 14px; }
  }
</style>
