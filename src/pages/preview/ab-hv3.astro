<script>
  function initRegister() {
    const page = document.querySelector<HTMLElement>('[data-rg]');
    if (!page || page.dataset.bound) return;
    page.dataset.bound = '1';

    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const fine = matchMedia('(hover: hover) and (pointer: fine)').matches;
    const bar = page.querySelector<HTMLElement>('[data-progress]');

    type Block = { words: HTMLElement[]; el: HTMLElement; lit: number };
    const blocks: Block[] = Array.from(page.querySelectorAll<HTMLElement>('[data-read]')).map((el) => ({
      el, words: Array.from(el.querySelectorAll<HTMLElement>('.w')), lit: 0,
    }));
    if (still) for (const b of blocks) { b.words.forEach((w) => w.classList.add('is-lit')); b.lit = b.words.length; }

    let ticking = false;
    const measure = () => {
      ticking = false;
      const vh = innerHeight;
      const max = document.documentElement.scrollHeight - vh;
      if (bar) bar.style.transform = `scaleY(${max > 0 ? Math.min(scrollY / max, 1) : 0})`;
      if (still) return;
      const line = vh * 0.68;
      for (const b of blocks) {
        const r = b.el.getBoundingClientRect();
        const span = r.height + vh * 0.16;
        const p = span > 0 ? (line - r.top) / span : 0;
        const want = Math.max(0, Math.min(b.words.length, Math.ceil(p * b.words.length)));
        if (want === b.lit) continue;
        if (want > b.lit) for (let i = b.lit; i < want; i++) b.words[i].classList.add('is-lit');
        else for (let i = want; i < b.lit; i++) b.words[i].classList.remove('is-lit');
        b.lit = want;
      }
    };
    const onScroll = () => { if (!ticking) { ticking = true; requestAnimationFrame(measure); } };
    addEventListener('scroll', onScroll, { passive: true });
    addEventListener('resize', onScroll, { passive: true });
    measure();

    /* ── the ledger answers the pointer, as ONE system ────────────
       Rule i in EVERY ledger sits at the same x: they are all laid out
       inside the same page padding, on the same twelve columns. Column i
       is therefore not seven separate hairlines but ONE line running the
       height of the document, drawn in pieces.

       That is why this is bound once on the page and drives every ledger
       together. Bound per section — which is how it was — each section
       ran its own loop, so crossing a seam fired one pointerleave while
       the next fired pointermove, and the light died and was reborn at
       every boundary. Nothing was wrong with the drawing; the system was
       simply cut into pieces that could not see each other.

       Vertical offsets are stored DOCUMENT-relative (rect.top + scrollY).
       Cached viewport offsets are only correct at scroll position zero,
       which is exactly why the segment effect used to work in the first
       movement and nowhere below it.

       Eased, frame-driven, sleeps when settled, real pointers only. */
    if (fine && !still) {
      const ruled = matchMedia('(min-width: 901px)');
      const ledgers = Array.from(page.querySelectorAll<HTMLElement>('.ledger'));
      const perLedger = ledgers.map((l) => Array.from(l.querySelectorAll<HTMLElement>('i')));
      const cols = perLedger.length ? perLedger[0].length : 0;

      if (cols) {
        const groups: HTMLElement[][] = [];
        for (let i = 0; i < cols; i++) groups.push(perLedger.map((rs) => rs[i]).filter(Boolean));

        let lefts: number[] = [];
        let tops: number[] = [];
        let span = 0;
        const cache = () => {
          lefts = groups.map((g) => g[0].getBoundingClientRect().left);
          tops = ledgers.map((l) => l.getBoundingClientRect().top + scrollY);
          span = lefts.length > 1 ? lefts[1] - lefts[0] : 0;
        };
        cache();
        addEventListener('resize', cache, { passive: true });
        // Rules move vertically as images settle, so refresh once things load.
        addEventListener('load', cache);

        const val = new Float32Array(cols);
        const shown = new Float32Array(cols).fill(-1);
        let px = -1e5, py = 0, inside = false, raf = 0;

        const frame = () => {
          raf = 0;
          let busy = false;
          const docY = py + scrollY;
          for (let k = 0; k < ledgers.length; k++) {
            ledgers[k].style.setProperty('--py', (docY - tops[k]).toFixed(1) + 'px');
          }
          for (let i = 0; i < cols; i++) {
            const d = Math.abs(lefts[i] - px);
            const t = inside ? Math.max(0, 1 - d / 200) : 0;
            val[i] += (t * t - val[i]) * 0.2;
            if (val[i] < 0.002) val[i] = 0;
            // The delta test alone never writes the last step home: a value
            // that lands on 0 from 0.002 differs by less than the threshold,
            // so the DOM kept a stale 0.002 for ever while the state said 0.
            // Invisible at 1px — 0.0019 of alpha — but the resting state
            // should be the resting state. Force the final write.
            if (Math.abs(val[i] - shown[i]) > 0.003 || (val[i] === 0 && shown[i] !== 0)) {
              for (const el of groups[i]) {
                el.style.setProperty('--lit', val[i].toFixed(3));
              }
              shown[i] = val[i];
            }
            if (val[i] > 0) busy = true;
          }
          if (inside || busy) raf = requestAnimationFrame(frame);
        };
        const kick = () => { if (!raf) raf = requestAnimationFrame(frame); };

        page.addEventListener('pointermove', (e) => {
          const pe = e as PointerEvent;
          if (pe.pointerType !== 'mouse' || !ruled.matches) return;
          px = pe.clientX; py = pe.clientY; inside = true; kick();
        }, { passive: true });
        page.addEventListener('pointerleave', () => { inside = false; kick(); });
      }
    }

    /* SCOPED — About selects [data-count] meaning "a statistic"; Still puts
       data-count on every work anchor meaning "how many stills". Unscoped, the
       counter wrote textContent over sixteen image stacks. */
    const counters = Array.from(page.querySelectorAll<HTMLElement>('.stat__figure[data-count]'));
    if (counters.length && !still) {
      const io = new IntersectionObserver((entries, obs) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          const el = e.target as HTMLElement;
          obs.unobserve(el);
          const to = Number(el.dataset.count);
          const pad = Number(el.dataset.pad ?? 0);
          const suffix = el.dataset.suffix ?? '';
          const final = String(to).padStart(pad, '0') + suffix;
          /* The count is decoration; the figure is information. Belt and
             braces so the true figure lands whatever the frame loop does. */
          const settle = setTimeout(() => { el.textContent = final; }, 1500);
          const t0 = performance.now();
          const tick = (now: number) => {
            const p = Math.min((now - t0) / 900, 1);
            const v = Math.round(to * (1 - Math.pow(1 - p, 3)));
            el.textContent = p < 1 ? String(v).padStart(pad, '0') + suffix : final;
            if (p < 1) requestAnimationFrame(tick); else clearTimeout(settle);
          };
          requestAnimationFrame(tick);
        }
      }, { threshold: 0.6 });
      counters.forEach((c) => io.observe(c));
    }

    if (fine && !still) {
      page.querySelector<HTMLElement>('[data-works]')?.querySelectorAll<HTMLElement>('li').forEach((li) => {
        const peek = li.querySelector<HTMLElement>('.work__peek');
        if (!peek) return;
        const move = (e: PointerEvent) => {
          const r = li.getBoundingClientRect();
          peek.style.setProperty('--x', `${e.clientX - r.left}px`);
          peek.style.setProperty('--y', `${e.clientY - r.top}px`);
        };
        li.addEventListener('pointerenter', (e) => { move(e as PointerEvent); li.classList.add('is-peek'); });
        li.addEventListener('pointermove', move, { passive: true });
        li.addEventListener('pointerleave', () => li.classList.remove('is-peek'));
      });
    }
  }

  initRegister();
  document.addEventListener('astro:page-load', initRegister);
</script>

<script>
  function initOpWorks() {
    const sec = document.querySelector('.sec--works') as HTMLElement | null;
    const wk = document.querySelector('[data-works-conveyor]') as HTMLElement | null;
    if (!sec || !wk || wk.dataset.bound) return;
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    if (!matchMedia('(min-width: 901px)').matches) {
      if (!wk.dataset.armed) { wk.dataset.armed = '1'; addEventListener('resize', () => initOpWorks(), { passive: true }); }
      return;
    }
    wk.dataset.bound = '1';

    const cards = Array.from(wk.querySelectorAll('[data-card]')) as HTMLElement[];
    const readout = sec.querySelector('[data-readout]') as HTMLElement;
    const title = sec.querySelector('[data-w-title]') as HTMLElement;
    const year = sec.querySelector('[data-w-year]') as HTMLElement;
    const row = sec.querySelector('.rl__ticks') as HTMLElement;
    const ticks = Array.from(sec.querySelectorAll('.rl__t')) as HTMLElement[];
    if (!cards.length) return;

    sec.classList.add('is-live');
    /* THE FIRST MARK IS LIT HERE, NOT BY paint(). The readout's caption and
       year are server-rendered from wnodes[0], so the page arrives already
       claiming to be on work one — but the lit mark has no such markup, and
       the block in paint() that sets it is guarded on a CHANGE of centred
       work, which by definition has not happened yet. Measured before this
       line existed: no mark lit at all through the whole first work. */
    if (ticks[0]) ticks[0].classList.add('is-on');

    /* Natural, unscaled heights. offsetHeight is layout height and is blind
       to transforms, which is exactly what the stack needs — and it is read
       once here and on resize rather than every frame, because sixteen
       offsetHeight reads inside a scroll handler is sixteen forced layouts a
       frame. Read after `is-live` is applied, so the cards are already at
       their scene width. */
    /* WIDTHS now, not heights: the row is horizontal and every card is set to
       one common height, so its width is what varies with the aspect ratio and
       what the edge-to-edge placement has to stack. */
    let W = cards.map((c) => c.offsetWidth || 400);
    /* Which side each work drifts to once it is behind, set on the element
       by the score. Read once — it never changes. */
    const remeasure = () => { W = cards.map((c) => c.offsetWidth || 400); };
    addEventListener('resize', remeasure, { passive: true });
    addEventListener('load', remeasure);
    if (document.fonts && document.fonts.ready) document.fonts.ready.then(remeasure);

    const cs = getComputedStyle(wk);
    const R = parseFloat(cs.getPropertyValue('--r')) || 900;
    const STEP = parseFloat(cs.getPropertyValue('--step')) || 0.5;

    /* Not left to lazy loading: the cards sit in a 0x0 world and are culled
       with visibility:hidden, so the browser never schedules them — measured,
       five of sixteen never loaded, one of them on screen. */
    const warm = (i: number) => {
      const c = cards[i];
      if (!c || c.dataset.warm) return;
      c.dataset.warm = '1';
      c.querySelectorAll('img').forEach((img) => {
        if (!(img as HTMLImageElement).complete) (img as HTMLImageElement).loading = 'eager';
      });
    };
    const warmAround = (b: number) => { for (let k = -3; k <= 3; k++) warm((b + k + cards.length) % cards.length); };
    cards.forEach((_, i) => { if (i < 4) warm(i); });

    let raf = 0, last = -1, written = 0, ring = -1;
    const paint = () => {
      raf = 0;
      const rect = sec.getBoundingClientRect();
      const run = sec.offsetHeight - innerHeight;
      const t = run > 0 ? Math.min(1, Math.max(0, -rect.top / run)) : 0;
      const phase = t * (cards.length - 1);

      /* One pitch for every step. The arc's own R·sin(θ) bunched the works
         hard at the extremes — measured gaps of 65, 47, 99, 253, 426, 130,
         105, 10px. Height is linear in the distance from centre now; only
         the depth still follows the arc. */
      /* ── CONSTANT EDGE-TO-EDGE SPACING ─────────────────────────
         The works are different shapes: at the same width a 9:16 stands
         nearly three times the height of a 2.39:1. A constant CENTRE-to-
         centre pitch therefore leaves wildly different gaps between the
         pictures — the tall ones almost touching, the wide ones marooned.

         So the column is STACKED, not stepped. Every work is placed exactly
         GAP below the bottom edge of the one above it, using rendered
         heights, so the distance between two pictures is the same number for
         every pair at every point in the scroll, whatever the two shapes
         are. That is only possible because the depth is a scale: the height
         is known before the placement, which a translateZ can never give
         you, since its foreshortening is applied after layout. The falloff
         is the same P/(P+z) the perspective was producing, so the depth
         reads exactly as it did. */
      /* ══ THE SWEEP ═══════════════════════════════════════════════
         A horizontal row, read off the reference. The active work is centred
         and largest; its neighbours recede to BOTH sides on one horizontal
         axis, shrinking and fading out.

         DEPTH IS QUADRATIC, NOT COSINE. The vertical fold this replaced used
         z = R(1 - cos(d.STEP)), which is periodic — that is why it had to be
         frozen at 1.4 steps, or works far off screen turned back into full
         size and, because the stack accumulates rendered sizes, shifted
         everything still on screen. A row this long needs a curve that is
         monotonic the whole way out. d-squared is, and it happens to land on
         the reference's own falloff without any clamp: 0.62 and 0.29 against
         the 0.62 and 0.25 measured off the video. */
      const PERSP = 1250;
      /* GENTLER AND FROZEN, because the turn below now supplies depth of its
         own. Aperture III had no fold, so an unbounded d-squared at 750 was
         safe; multiplied by the turn's falloff it takes the far works to
         specks — 0.29 x 0.55 is a different thing from 0.29. */
      const DEPTH = 430;
      const BIAS_MAX = 1.6;
      /* The reference's gutter is 3px on a 1068px frame. Edge-to-edge, as
         everywhere else here: added to the RENDERED half-widths either side,
         so it is the true gap between two works whatever their shapes. */
      const GAP = 4;
      const n = cards.length;

      const s = new Array(n), wr = new Array(n);
      for (let i = 0; i < n; i++) {
        const d = Math.min(Math.abs(i - phase), BIAS_MAX);
        s[i] = PERSP / (PERSP + DEPTH * d * d);
        wr[i] = W[i] * s[i];
      }

      /* Half of mine, the gutter, half of yours. */
      const pos = new Array(n);
      pos[0] = 0;
      for (let i = 1; i < n; i++) pos[i] = pos[i - 1] + wr[i - 1] / 2 + GAP + wr[i] / 2;

      /* Slide the row so the work at `phase` sits on the centre line,
         interpolated between neighbours so the travel is continuous rather
         than snapping from one work to the next. */
      const k = Math.max(0, Math.min(n - 2, Math.floor(phase)));
      const f = Math.max(0, Math.min(1, phase - k));
      const offset = pos[k] + (pos[k + 1] - pos[k]) * f;

      /* ══ THE TURN ════════════════════════════════════════════════
         `pos` above is no longer a screen coordinate. It is ARC LENGTH along
         a path, and the path is a hockey stick laid on its side: dead
         straight through the middle of the frame, then curving away from the
         camera at both ends.

         The straight part is what keeps the gutter. Inside |u| <= U0 there is
         no foreshortening at all, so two consecutive works stay exactly GAP
         apart whatever their shapes — the reference's hairline is untouched.

         Past U0 the path bends onto a circle of radius FOLD_R. Works swing
         out, shrink and dim; and because a circle comes back round, so do
         they. A work far enough along has travelled past the outside of the
         turn and is on its way back towards the centre, small and dim and
         behind the near ones. That returning chain is what makes this read as
         a carousel rather than a strip that runs out of frame.

         U0 at 0.62 of the width keeps two works clear either side of the
         centre before the turn takes them — matching how many the reference
         shows square-on. */
      const U0 = innerWidth * 0.62;
      const FOLD_R = innerWidth * 0.34;

      let best = 0, bestD = Infinity;
      for (let i = 0; i < n; i++) {
        const u = pos[i] - offset;
        const a = Math.abs(u), sgn = u < 0 ? -1 : 1;
        const c = cards[i];

        /* Travel is on X ONLY. The circle is in plan — a carousel seen level,
           not a wheel seen face-on — so every work keeps the one shared
           vertical axis. */
        let x = u, sf = 1, dep = 0, gone = false;
        if (a > U0) {
          const th = Math.min((a - U0) / FOLD_R, Math.PI);
          const zf = FOLD_R * (1 - Math.cos(th));
          sf = PERSP / (PERSP + zf);
          x = sgn * (U0 + FOLD_R * Math.sin(th)) * sf;
          dep = th / Math.PI;
          /* Culled at the far side of the turn, where the chain would double
             back through itself. */
          gone = th >= Math.PI * 0.985;
        }

        const st = s[i] * sf;
        /* FADED OUT BEFORE IT IS CULLED. The cull fires at the far side of the
           turn, where the chain would double back through itself — but a work
           returning round the back arrives at x = -468 in a 1280 window, which
           is well inside the frame. Measured, it was still at 0.16 opacity
           when it was switched off: a visible pop, on screen, every lap. The
           last quarter of the turn now takes it to nothing first, so the cull
           only ever removes something already invisible. */
        const fade = dep > 0.75 ? Math.max(0, (1 - dep) / 0.25) : 1;
        const op = Math.max(0, Math.pow(st, 1.15) * (1 - dep * 0.4) * fade);

        /* How far round the turn this work is: 0 through the straight run,
           1 at the far side. Exposed because it is the one piece of state that
           says whether a work is on the straight — without it the gutter
           cannot be checked, since a returning work passes BEHIND the near
           ones and reads as a negative gap to anything measuring blind. */
        c.style.setProperty('--fold', dep.toFixed(3));
        c.style.setProperty('--tx', `${x.toFixed(1)}px`);
        c.style.setProperty('--s', st.toFixed(4));
        /* THE CULL NO LONGER TOUCHES visibility, AND THAT IS THE POINT.
           `visibility: hidden` stops an element being painted, which
           takes its composited surface down with it — and .wcard carries
           will-change: transform, opacity, so that surface is exactly
           what we are paying to keep. Measured, this flipped 32 times
           across one scroll of the section: thirty-two surfaces thrown
           away and rebuilt, each holding a large image, at the moments
           you are scrolling fastest.

           Nothing is lost by dropping it. --op already reaches 0 before
           the cull fires — the last quarter of the turn takes it there,
           see the note above — so clamping it to a hard 0 leaves the work
           invisible by the same means everything else here uses.

           `inert` does the rest of visibility's job: out of the tab order
           and deaf to the pointer, so an invisible work cannot be clicked
           or focused. It is an attribute, not a paint property, so the
           surface survives. Guarded because writing an attribute that is
           already set still invalidates style. */
        c.style.setProperty('--op', gone ? '0' : op.toFixed(3));
        if (gone !== c.hasAttribute('inert')) c.toggleAttribute('inert', gone);

        const ad = Math.abs(i - phase);
        if (ad < bestD) { bestD = ad; best = i; }
      }
      /* THE EARLY RETURN USED TO SIT HERE, and it cost two things. The
         playhead only moved when the ACTIVE WORK changed, so it stepped from
         tick to tick instead of sliding with the scroll. And a readout write
         cancelled mid-flight by clearTimeout could never be rescheduled,
         because `best === last` bailed out before reaching it — measured, the
         caption sat on "Mere Ho" while the centred work was "Bloody Bubbly".
         Only the work that is genuinely per-change is guarded now. */
      if (best !== last) {
        last = best;
        warmAround(best);
        cards.forEach((c, i) => { c.style.zIndex = String(100 - Math.abs(i - best)); });
      }

      /* ══ THE SCALE TURNS; THE INDEX MARK DOES NOT ════════════════
         This was the reverse — a playhead sliding along a flat ruler, placed
         each frame from ticks[k].offsetLeft. Under the arc the sixteen marks
         are absolutely positioned and rotated about a point 344px above the
         strip, so they all share one offsetLeft and there is nothing left to
         interpolate between: the movement is the row's rotation instead.

         IT IS `phase`, NOT A ROUNDED INDEX, and that costs nothing — phase
         is already computed above for the conveyor itself, so the readout
         rides the same continuous number the pictures do and cannot drift
         away from them. No second scroll listener, no second
         getBoundingClientRect: the one forced layout this handler performs
         now serves both the works and their scale.

         GUARDED ON A CHANGE OF 0.001 because a custom-property write
         invalidates style whether or not the value differs, and at 3.6deg
         per unit a thousandth of a step is 0.0036deg — far below anything
         that can reach a pixel. */
      if (row && Math.abs(phase - ring) > 0.001) {
        ring = phase;
        row.style.setProperty('--ring', phase.toFixed(3));
      }

      /* WRITTEN IMMEDIATELY; THE FADE IS PRESENTATION ONLY.
         This was a debounced write on a 130ms timer, and the timer was being
         starved: paint runs on every scroll event, Lenis emits them for well
         over a second after a jump, and clearTimeout cancelled the queued
         write every time — measured, the caption sat on the first work
         through the whole scroll with is-turning stuck on, so the readout was
         both wrong AND faded out. Guarding the reschedule on the target index
         did not fix it either.

         So the text is set the moment the centred work changes, and the fade
         is a CSS animation restarted by re-adding the class. Worst case, if
         the class handling ever misbehaves, is a caption that does not
         animate — never one that lies about which work you are looking at. */
      if (readout && written !== best) {
        written = best;
        if (title) title.textContent = cards[best].dataset.title || '';
        if (year) year.textContent = cards[best].dataset.year || '';
        /* The lit mark belongs HERE and not with the rotation above: which
           work you are on is a discrete fact that changes sixteen times in
           the whole section, and this is the one place that already knows
           it has changed. Hung off the rotation it would be a sixteen-class
           toggle every frame. */
        ticks.forEach((x, i) => x.classList.toggle('is-on', i === best));
        readout.classList.remove('is-turning');
        void readout.offsetWidth;            /* restart the animation */
        readout.classList.add('is-turning');
      }
    };
    addEventListener('scroll', () => { if (!raf) raf = requestAnimationFrame(paint); }, { passive: true });
    addEventListener('resize', () => { if (!raf) raf = requestAnimationFrame(paint); }, { passive: true });
    paint();
  }

  function initRunningHead() {
    const rh = document.querySelector('[data-runhead]') as HTMLElement | null;
    if (!rh || rh.dataset.bound) return;
    rh.dataset.bound = '1';
    const mv = rh.querySelector('[data-rh-mv]') as HTMLElement;
    const folio = rh.querySelector('[data-rh-folio]') as HTMLElement;
    const secs = Array.from(document.querySelectorAll('[data-mv]')) as HTMLElement[];
    const NAMES = [{n:"01",t:"Selected works"},{n:"02",t:"Who I am"},{n:"03",t:"What I work across"},{n:"04",t:"How I work"},{n:"05",t:"What I’m after"},{n:"06",t:"Contact"}];
    if (!secs.length) return;

    let raf = 0, last = -1, turn = 0;
    const paint = () => {
      raf = 0;
      const line = scrollY + innerHeight * 0.4;
      let now = -1;
      for (const s of secs) if (line >= s.offsetTop) now = Number(s.dataset.mv);
      if (now === last) return;
      last = now;
      rh.classList.add('is-turning');
      clearTimeout(turn);
      turn = window.setTimeout(() => {
        if (now < 0) { mv.textContent = ''; folio.textContent = ''; }
        else { mv.textContent = NAMES[now].t; folio.textContent = NAMES[now].n + '/06'; }
        rh.classList.remove('is-turning');
      }, 200);
    };
    addEventListener('scroll', () => { if (!raf) raf = requestAnimationFrame(paint); }, { passive: true });
    addEventListener('resize', () => { if (!raf) raf = requestAnimationFrame(paint); }, { passive: true });
    paint();
  }

  /* The opening's name drifts up more slowly than the page, so the hand-over
     to the works reads as a camera move rather than a cut. Additive: with no
     script --drift is unset and the name simply sits where it is laid out. */
  function initDrift() {
    const mast = document.querySelector('.ov--mono .ov__mast') as HTMLElement | null;
    if (!mast || mast.dataset.bound) return;
    mast.dataset.bound = '1';
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    let raf = 0;
    const paint = () => {
      raf = 0;
      const d = Math.min(innerHeight, Math.max(0, scrollY)) * 0.18;
      mast.style.setProperty('--drift', `${d.toFixed(1)}px`);
    };
    addEventListener('scroll', () => { if (!raf) raf = requestAnimationFrame(paint); }, { passive: true });
    paint();
  }


  /* ══ THE HOVER READING ═══════════════════════════════════════════
     ONE PANEL, NOT SIXTEEN, AND IT IS NOT A CHILD OF THE CARD. Every
     .wcard carries `transform: scale(var(--s))` — the conveyor's depth is a
     scale, not a translateZ, because the placement needs each work's
     rendered height before it places it. Anything inside a card is scaled
     with it, and across the gate below that is a factor of two: the same
     13px label would set at 6.5px on one work and 12.7px on another. So the
     panel lives outside .wk__world and is positioned from the hovered
     card's own getBoundingClientRect().

     A POSITIVE z-index HERE BEATS THE WHOLE SCENE, and that is not a
     detail. .wk__scene carries `perspective: 1250px` and .wk__world carries
     `transform-style: preserve-3d`; both create a stacking context, so a
     card's z-index is only ever compared against its fifteen siblings. The
     panel is a SIBLING of .wk__scene, so anything it draws is above every
     card — and nothing a card does can climb over it.

     THE GATE IS --op >= 0.5, read off the card's own inline style. That
     property is written every frame by paint() above and is the one number
     that already says how visible a work is. At 1280x800, measured
     mid-section, it admits exactly the three works on the straight run
     either side of centre; a work half way round the turn is at 0.22 and
     200px wide, and putting a crisp reading on it would claim a prominence
     its picture does not have.

     IT IS RE-CHECKED ON SCROLL, in the panel's own rAF rather than inside
     paint(): the row keeps moving under a stationary pointer, so a held
     work can fall through the gate without the pointer ever leaving it.

     KEYBOARD GETS IT TOO. focusin/focusout run the same path as the
     pointer. The panel itself is aria-hidden — it is a pointer affordance,
     and the same four facts set in the four-column block on the work page,
     which is what a screen reader follows the card's own link to.
     <- FLAGGED: say the word and it becomes a live region instead.

     BELOW 901px NOTHING BINDS. The conveyor is not live there — .wk__pin
     goes static and .wk__world becomes a plain two-column grid — so there
     is no hovered work to read, and on a touch pointer there is no hover. */
  function initHvInfo() {
    const sec = document.querySelector('.sec--works') as HTMLElement | null;
    if (!sec || sec.dataset.hvBound) return;
    const panel = sec.querySelector('[data-hv]') as HTMLElement | null;
    const pin = sec.querySelector('.wk__pin') as HTMLElement | null;
    if (!panel || !pin) return;
    if (!matchMedia('(hover: hover) and (pointer: fine)').matches) return;
    if (!matchMedia('(min-width: 901px)').matches) return;
    const cards = Array.from(sec.querySelectorAll('[data-card]')) as HTMLElement[];
    if (!cards.length) return;
    /* NOT `data-hv`: that is the panel's own marker, and a bound flag
       sharing the name makes a document-wide query for it return the
       SECTION rather than the panel. */
    sec.dataset.hvBound = '1';

    const GATE = 0.5;
    const opOf = (c: HTMLElement) => {
      const v = parseFloat(c.style.getPropertyValue('--op'));
      return isNaN(v) ? 1 : v;
    };
    const rowsOf = (c: HTMLElement): { label: string; value: string }[] => {
      try { return JSON.parse(c.dataset.rows || '[]'); } catch { return []; }
    };

    let held: HTMLElement | null = null;
    let raf = 0;

    const slots = Array.from(panel.querySelectorAll('[data-hv-row]')) as HTMLElement[];
    const fill = (c: HTMLElement) => {
      const rows = rowsOf(c);
      slots.forEach((s, i) => {
        const r = rows[i];
        s.hidden = !r;
        if (!r) return;
        s.style.setProperty('--i', String(i));
        (s.querySelector('[data-hv-l]') as HTMLElement).textContent = r.label;
        (s.querySelector('[data-hv-v]') as HTMLElement).textContent = r.value;
      });
    };
    const GRID = 24;   /* the baseline the block steps on */
    const OFFSET = 30; /* how far right of the point the first character sits */
    const rowsBox = panel.querySelector('.hv3__rows') as HTMLElement;
    let px = 0, py = 0;
    /* SYNCHRONOUS, and that is the point — see the header. Two custom
       property writes and one Math.round; src/scripts/frames.ts runs its
       frame scrub on this same event for the same reason. */
    const aim = () => {
      const p = pin.getBoundingClientRect();
      const x = px - p.left, y = py - p.top;
      /* FLIPPED ON THE BLOCK'S OWN WIDTH, not on a guessed distance from
         the edge. The reading is 284px wide on the longest work and about
         160 on the shortest, so one threshold either flips a short block
         far too early or lets a long one run off the frame. Measured
         before this changed, with a fixed 200px trigger: at a pointer x of
         1000 the block's right edge reached 1314 in a 1280 frame and the
         year was clipped away. */
      const w = rowsBox.getBoundingClientRect().width;
      const flip = x + OFFSET + w > p.width - 8;
      panel.classList.toggle('is-flipped', flip);
      panel.style.setProperty('--hv-x', x.toFixed(1) + 'px');
      panel.style.setProperty('--hv-y', (Math.round(y / GRID) * GRID).toFixed(1) + 'px');
    };
    const place = () => { if (held) aim(); };

    const show = (c: HTMLElement) => {
      held = c;

      /* PLACE BEFORE FILL, and the order is load-bearing. hv1 fits its type
         to the panel's width and then measures where the justified items
         landed; both readings are wrong if the panel is still the previous
         work's size. Nothing here reads the other way round. */
      place();
      fill(c);
      sec.classList.add('is-hv');
    };
    const hide = () => {
      const c = held;
      held = null;
      sec.classList.remove('is-hv');

    };

    cards.forEach((c) => {
      const on = () => { if (held !== c && opOf(c) >= GATE) show(c); };
      const off = () => { if (held === c) hide(); };
      c.addEventListener('pointerenter', on);
      c.addEventListener('pointerleave', off);
      c.addEventListener('focusin', on);
      c.addEventListener('focusout', off);
    });
    pin.addEventListener('pointermove', (e: PointerEvent) => {
      px = e.clientX; py = e.clientY;
      if (held) aim();
    }, { passive: true });

    const track = () => {
      raf = 0;
      if (!held) return;
      if (opOf(held) < GATE) { hide(); return; }
      place();
    };
    addEventListener('scroll', () => { if (held && !raf) raf = requestAnimationFrame(track); }, { passive: true });
    addEventListener('resize', () => { if (held && !raf) raf = requestAnimationFrame(track); }, { passive: true });
  }

  initOpWorks();
  initRunningHead();
  initDrift();
  initHvInfo();
  document.addEventListener('astro:page-load', () => { initOpWorks(); initRunningHead(); initDrift(); initHvInfo(); });
</script>

<style>
  /* ── --prog IS DECLARED, SO THAT IT STOPS INHERITING ────────────
     A custom property inherits by default, which means writing one on .rg
     asks the browser to recompute style for all 1133 elements beneath it.
     Measured, that is 2.6ms every frame — and it is charged whether or not
     anything reads the value: a name nothing consumes cost the same 2.2ms
     in the same test.

     Declaring it as a number that does not inherit ends that. The value is
     then visible only on the element it is set on, which is why the write
     moves onto .ms__bed in initSpine below; the two changes are one change
     and neither works alone. With both: 0.0ms.

     UNSUPPORTED IS SAFE. A browser that does not know @property ignores this
     block, --prog inherits as it always did, and the moved write still cuts
     the recompute from 1133 elements to the bed's 150 — measured 0.3ms. */
  /* Declared for the same reason --prog is: a custom property inherits by
     default, and writing one per frame on an element with descendants
     recomputes style for all of them. --ring is written on .rl__ticks,
     which has sixteen, and read only by .rl__ticks itself — so it has no
     business inheriting at all. */
  @property --ring {
    syntax: '<number>';
    inherits: false;
    initial-value: 0;
  }

  @property --prog {
    syntax: '<number>';
    inherits: false;
    initial-value: 0;
  }

  .rg {
    --tier-0: clamp(2.75rem, 10vw, 9rem);
    --tier-1: clamp(2.5rem, 8vw, 7.5rem);
    --tier-2: clamp(1.75rem, 5vw, 4.25rem);
    --tier-3: clamp(1.5rem, 2.8vw, 2.5rem);
    --tier-4: clamp(1.0625rem, 1.35vw, 1.375rem);

    padding-inline: var(--margin);
    padding-bottom: 20vh;
  }

  .rg [data-reveal] { --i: 0; }
  @media (prefers-reduced-motion: no-preference) {
    .rg [data-reveal].is-in { animation-delay: calc(var(--i) * 70ms); }
  }

  .line {
    display: inline-block; overflow: hidden; vertical-align: bottom;
    padding-bottom: 0.24em; margin-bottom: -0.24em;
    padding-right: 0.06em; margin-right: -0.06em;
  }
  .line__in { display: inline-block; }
  /* text-indent INHERITS, and every inline-block is a block container that
     applies it to its own first line. The hanging indent on .stmt below was
     therefore re-applied inside each masked word, pushing the word out of
     its own overflow:hidden box — measured: .line boxes collapsed from full
     word width to 4px, exactly the padding, and the statement rendered as
     fragments. The hang has to happen once, on the statement, and stop. */
  .line, .line__in { text-indent: 0; }
  @media (prefers-reduced-motion: no-preference) {
    .line[data-reveal].is-in .line__in {
      animation: line-up 900ms var(--ease) both;
      animation-delay: calc(var(--i) * 70ms);
    }
  }
  @keyframes line-up { from { transform: translateY(135%); } to { transform: none; } }

  .draw { display: block; height: 1px; border: 0; margin: 0; background: var(--rule); transform-origin: left; }
  @media (prefers-reduced-motion: no-preference) {
    .draw[data-reveal].is-in { animation: draw 1000ms var(--ease) both; }
  }
  @keyframes draw { from { transform: scaleX(0); } to { transform: none; } }

  .read p { color: var(--bone-dim); margin: 0 0 var(--s-3); }
  .read p:last-child { margin-bottom: 0; }
  .w { transition: color var(--d-reveal) var(--ease); }
  .w.is-lit { color: var(--bone); }

  .gauge {
    position: fixed; z-index: 120; pointer-events: none;
    left: calc(var(--margin) * 0.42); width: 1px;
    top: calc(var(--head-h) + 24px); bottom: 24px;
    background: var(--rule-soft);
  }
  .gauge__in { display: block; width: 100%; height: 100%; background: var(--accent); transform-origin: top; transform: scaleY(0); }
  @media (max-width: 900px) { .gauge { display: none; } }

  /* ── the ledger ────────────────────────────────────────────────
     Twelve hairlines on the site's own column boundaries. Decoration,
     aria-hidden, pointer-events: none — it lies over the whole section
     and would otherwise take every hit in it. Drawn only above 901px,
     where --cols is still twelve; below that it would spill into
     implicit columns, so it is simply not rendered. */
  .ledger { display: none; }
  @media (min-width: 901px) {
    .ledger {
      position: absolute; inset: 0; z-index: 0; pointer-events: none;
      display: grid;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--gutter);
    }
  }
  /* ── C · THE LIT SEGMENT ───────────────────────────────────────
     Light localised in BOTH axes: falloff across x chooses which lines
     answer, a gradient centred on the cursor's own height chooses how
     much of each one lights. What travels is a short glowing length of
     line — a lamp held against the grid rather than a switch thrown.

     Each ledger carries its own --py measured from its own document top,
     so when the cursor sits near a seam the ledger below already has a
     small negative --py and its share of the glow is drawn too. The
     segment crosses the boundary instead of stopping at it.

     The line moves to a pseudo-element because a border cannot carry a
     gradient. It sits at left: 0, exactly where the border was. */
  .ledger i { display: block; position: relative; transform-origin: top; }
  .ledger i::before {
    content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 1px;
    background:
      linear-gradient(to bottom,
        transparent calc(var(--py, -9999px) - 130px),
        rgba(255, 255, 255, var(--lit, 0)) calc(var(--py, -9999px) - 24px),
        rgba(255, 255, 255, var(--lit, 0)) calc(var(--py, -9999px) + 24px),
        transparent calc(var(--py, -9999px) + 130px)),
      var(--rule-soft);
  }
  @media (prefers-reduced-motion: no-preference) {
    /* The base reveal would nudge the whole overlay 14px down; the rules
       do their own entrance instead. Hidden state lives only here, and
       the overlay carries no content. */
    .ledger[data-reveal].is-in { animation: none; }
    .ledger[data-reveal].is-in i {
      animation: rule-down 1100ms var(--ease) both;
      animation-delay: calc(var(--i) * 45ms);
    }
  }
  @keyframes rule-down { from { transform: scaleY(0); } to { transform: none; } }

  /* ── Opening ───────────────────────────────────────────────────── */
  .open {
    position: relative;
    min-height: calc(100vh - var(--head-h));
    display: flex; flex-direction: column; justify-content: center;
    padding: clamp(120px, 17vh, 210px) 0 clamp(36px, 6vh, 72px);
  }
  .open > :not(.ledger) { position: relative; z-index: 1; }
  .open__eyebrow { color: var(--muted); font-size: var(--t-xs); margin: 0 0 clamp(28px, 5vh, 60px); }
  .open__h {
    font-family: var(--display); font-weight: 500;
    font-size: var(--tier-1); line-height: 0.98;
    letter-spacing: -0.045em; margin: 0;
  }
  .open__h .line { display: block; }
  .serif { font-family: var(--serif); font-style: italic; font-weight: 400; letter-spacing: -0.015em; }
  /* Fraunces sets optically smaller than the grotesk at the same size. */
  .open__h .serif { font-size: 1.07em; letter-spacing: -0.02em; }
  .hot { color: var(--accent); }

  .open__foot {
    display: flex; flex-wrap: wrap; align-items: baseline;
    justify-content: space-between; gap: var(--s-3);
    margin-top: clamp(36px, 6vh, 72px);
    padding-top: 16px; border-top: 1px solid var(--rule);
  }
  .tags { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--s-3); }
  .tags li { font-size: var(--t-xs); color: var(--muted); }
  .tags li + li::before { content: '·'; color: var(--rule); margin-right: var(--s-3); }
  .tags--dim li { color: var(--dim); }
  .open__portrait { max-width: 340px; margin-top: var(--s-4); }
  .open__portrait img { display: block; width: 100%; height: auto; }

  .cue { display: block; color: var(--dim); font-size: var(--t-md); margin-top: clamp(24px, 4vh, 48px); }
  @media (prefers-reduced-motion: no-preference) {
    .cue { animation: cue-drift 2.4s var(--ease) infinite; }
  }
  @keyframes cue-drift { 0%, 100% { transform: translateY(0); opacity: 0.5; } 50% { transform: translateY(6px); opacity: 1; } }

  /* ── section grid ──────────────────────────────────────────────
     Placed child by child. A `> *` blanket compiles with the scoping
     attribute on both compounds and outranks a single scoped class,
     silently flattening every placement below it to full width. */
  .sec {
    position: relative;
    display: grid;
    grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
    column-gap: var(--gutter);
    padding-top: clamp(56px, 10vh, 130px);
    padding-bottom: clamp(56px, 10vh, 130px);
  }
  .sec--close { padding-bottom: 0; }
  .sec > .spine { grid-column: 1 / span 1; z-index: 1; }
  .sec > .stmt  { grid-column: 2 / -2; z-index: 1; }
  .sec > .well  { grid-column: 4 / -1; z-index: 1; }
  .sec > .steps { grid-column: 4 / -1; z-index: 1; }

  /* The spine holds its name at the head and its folio at the foot, the
     way a book page carries them. */
  .spine {
    align-self: stretch;
    display: flex; flex-direction: column; justify-content: space-between;
    align-items: flex-start; gap: var(--s-4);
  }
  .spine__top { display: flex; flex-direction: column; align-items: flex-start; gap: var(--s-3); }
  .spine__n { color: var(--accent); font-size: var(--t-xs); font-variant-numeric: tabular-nums; }
  .spine__folio { color: var(--dim); font-size: var(--t-xs); font-variant-numeric: tabular-nums; }
  /* vertical-rl reads top-to-bottom; the half turn sends it up the spine. */
  .spine__t {
    writing-mode: vertical-rl; transform: rotate(180deg);
    margin: 0; color: var(--bone); font-size: var(--t-xs); white-space: nowrap;
  }

  /* ── statements, with the first line hung ──────────────────────
     The outdent is smaller than the page margin at every width the
     clamp can reach, so the line can never leave the page. */
  .stmt {
    font-family: var(--display); font-weight: 500;
    font-size: var(--tier-2); line-height: 1.06; letter-spacing: -0.042em;
    margin: 0 0 clamp(40px, 8vh, 88px);
    text-indent: clamp(-84px, -5.4vw, 0px);
  }
  .stmt__a, .stmt__b { display: inline; }
  .stmt__b { letter-spacing: -0.02em; }
  .stmt--stack .stmt__a, .stmt--stack .stmt__b { display: block; }
  /* Only the first line hangs; the second returns to the measure, which
     is what makes the indent read as a hang rather than as a shift. */
  .stmt--stack .stmt__b { text-indent: 0; padding-left: clamp(0px, 5vw, 80px); }
  .stmt--serif { letter-spacing: -0.018em; line-height: 1.1; max-width: 20ch; }

  .lede { font-size: var(--tier-4); line-height: 1.72; max-width: 46ch; margin: 0 0 clamp(44px, 8vh, 88px); }
  .well { display: block; }
  /* ── the stair ─────────────────────────────────────────────────
     Each paragraph starts one column further right than the last. The
     well spans section columns 4–12, so its own column 1+i lands on
     section column 4+i — which is exactly where a ledger hairline is
     drawn. Measured at 1440: the five paragraphs begin at 409, 516,
     624, 732 and 839, every one of them a rule position, off by zero.
     That is the whole point of it. The prose steps down the page ON the
     structure, which is what turns the ledger from something drawn over
     the page into something the page is built on.

     The measure is held constant at 44ch and only the start moves, so
     the fifth paragraph reads no harder than the first. */
  .stair {
    display: grid;
    grid-template-columns: repeat(9, minmax(0, 1fr));
    column-gap: var(--gutter);
    row-gap: clamp(20px, 3.4vh, 38px);
  }
  .stair__p { grid-column: calc(1 + var(--s)) / -1; }
  .stair__p p { font-size: var(--tier-4); line-height: 1.82; max-width: 44ch; margin: 0; }

  /* ── 02 · C · THE QUESTIONS ────────────────────────────────────
     Every clause takes its own line, and the ones that ask take the
     serif. Movement 01 already uses Fraunces italic for the half of a
     sentence that turns something over rather than states it; a question
     is that same move, so it gets the same voice. Three questions were
     packed into a single line and read as one long sentence — they are
     three now, and each is legible as a question at a glance.

     Set at 19px, matching movement 01, which is the same kind of writing
     and was set larger than this section for no reason. */
  .steps { list-style: none; margin: 0; padding: 0; }
  .step {
    display: grid; grid-template-columns: 3rem minmax(0, 4fr) minmax(0, 5fr);
    column-gap: var(--gutter); align-items: baseline;
    padding: clamp(24px, 4vh, 46px) 0;
  }
  .step .draw { grid-column: 1 / -1; margin-bottom: clamp(24px, 4vh, 46px); }
  .step__n { color: var(--accent); font-size: var(--t-xs); }
  .step__title {
    font-family: var(--display); font-weight: 500;
    font-size: var(--tier-3); line-height: 1.08; letter-spacing: -0.032em;
    margin: 0; max-width: 11ch;
  }
  .step__lines { font-size: var(--tier-4); line-height: 1.66; max-width: 46ch; }
  .step__lines p { margin: 0 0 clamp(10px, 1.5vh, 15px); }
  .step__lines p:last-child { margin-bottom: 0; }
  .asks {
    font-family: var(--serif); font-style: italic; font-weight: 400;
    letter-spacing: -0.012em; font-size: 1.06em;
    padding-left: clamp(0px, 2vw, 28px);
  }
  /* ── the tone band ─────────────────────────────────────────────
     The margins cancel the page's own padding exactly, so this is the
     viewport's width and not a pixel more. */
  .band {
    margin: clamp(24px, 5vh, 64px) calc(var(--margin) * -1);
    padding: clamp(72px, 14vh, 180px) var(--margin);
    background: var(--ground-lift);
    border-top: 1px solid var(--rule-soft);
    border-bottom: 1px solid var(--rule-soft);
  }
  .band__q {
    font-size: var(--tier-0); line-height: 0.98; letter-spacing: -0.03em;
    color: var(--bone); margin: 0; max-width: 13ch;
    padding-left: clamp(0px, 16vw, 240px);
  }
  /* The caption was anchored by an accent em dash. It is anchored by an
     accent rule instead — same job, same colour, no dash. The indent moves
     to margin-left so padding-left can hold the rule off the text. */
  .band__cap {
    display: block; color: var(--dim); font-size: var(--t-xs);
    margin-top: var(--s-4);
    margin-left: clamp(0px, 16vw, 240px);
    padding-left: 12px;
    border-left: 1px solid var(--accent);
  }

  /* ── 03 · Movement's grid, as asked ────────────────────────────── */
  .cols { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(28px, 4vw, 72px); align-items: start; }
  .col__lab { color: var(--accent); font-size: var(--t-xs); padding-bottom: 12px; border-bottom: 1px solid var(--rule); margin: 0 0 var(--s-3); }
  .col ul { list-style: none; margin: 0; padding: 0; }
  .col li {
    display: flex; align-items: baseline; gap: 12px;
    /* 21px at 1440, up from a flat 18px. The floor stays at 18px rather
       than dropping to 1rem: a clamp that bottoms out at 16px would have
       made these SMALLER on a phone than they were before, which is not
       what "slightly bigger" means. */
    color: var(--bone-dim); font-size: clamp(1.125rem, 1.5vw, 1.3125rem); padding: 10px 0;
    border-bottom: 1px solid var(--rule-soft);
    transition: color var(--d-micro) var(--ease), padding-left var(--d-micro) var(--ease);
  }
  .col__n { color: transparent; font-size: var(--t-xs); transition: color var(--d-micro) var(--ease); }
  .col li:hover { color: var(--bone); padding-left: 8px; }
  .col li:hover .col__n { color: var(--accent); }
  .col li:last-child { border-bottom: 0; }

  /* ── 04 ────────────────────────────────────────────────────────── */
  .stats { display: flex; flex-wrap: wrap; gap: clamp(28px, 5vw, 88px); padding-bottom: clamp(48px, 9vh, 104px); }
  .stat { display: flex; flex-direction: column; gap: 10px; }
  .stat__figure {
    font-family: var(--display); font-weight: 500;
    font-size: clamp(1.75rem, 3.4vw, 2.875rem); letter-spacing: -0.04em; line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .stat__lab { color: var(--dim); font-size: var(--t-xs); }

  .works { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--rule); }
  .works li { position: relative; }
  .work {
    display: grid; grid-template-columns: minmax(0, 1fr) auto 2rem;
    align-items: baseline; gap: var(--s-3);
    padding: clamp(18px, 2.8vh, 30px) 0; border-bottom: 1px solid var(--rule-soft);
    color: var(--bone); transition: padding-left var(--d-micro) var(--ease);
  }
  .work__title { font-family: var(--display); font-weight: 500; font-size: var(--tier-3); letter-spacing: -0.03em; line-height: 1.1; }
  .work__role { color: var(--dim); font-size: var(--t-xs); text-align: right; }
  .work__arrow { color: var(--dim); text-align: right; transition: transform var(--d-micro) var(--ease), color var(--d-micro) var(--ease); }
  .works li:hover .work { padding-left: 12px; }
  .works li:hover .work__arrow { color: var(--accent); transform: translateX(0.3em); }

  .work__peek {
    position: absolute; top: var(--y, 50%); left: var(--x, 50%);
    width: 320px; margin: -110px 0 0 -160px;
    pointer-events: none; z-index: 3;
    opacity: 0; transform: scale(0.96);
    transition: opacity var(--d-micro) var(--ease), transform var(--d-micro) var(--ease);
  }
  .work__peek :global(img) { display: block; width: 100%; height: auto; }
  .works li.is-peek .work__peek { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: reduce) { .work__peek { display: none; } }

  /* ── 05 ────────────────────────────────────────────────────────── */
  .call { display: block; padding-top: clamp(40px, 7vh, 80px); margin-bottom: clamp(40px, 7vh, 76px); }
  .call__big {
    display: block; font-family: var(--display); font-weight: 500;
    font-size: var(--tier-0); line-height: 0.94; letter-spacing: -0.05em;
    color: var(--bone); max-width: 13ch;
    transition: color var(--d-micro) var(--ease);
  }
  .call:hover .call__big { color: var(--accent); }
  .call__tail { display: block; color: var(--dim); font-size: var(--t-xs); margin-top: var(--s-3); }

  .direct { list-style: none; margin: 0; padding: var(--s-4) 0 0; border-top: 1px solid var(--rule); display: flex; flex-wrap: wrap; gap: var(--s-3) var(--s-5); }
  .direct li { display: flex; align-items: baseline; gap: 10px; }
  .direct .mono { font-size: var(--t-xs); }
  .direct a { font-family: var(--display); font-weight: 500; font-size: var(--t-md); letter-spacing: -0.02em; color: var(--bone); transition: color var(--d-micro) var(--ease); }
  .direct a:hover { color: var(--accent); }

  @media (max-width: 900px) {
    .sec { grid-template-columns: 1fr; row-gap: var(--s-4); }
    /* Answering the by-name rules above at equal specificity — a bare class
       would lose, and `2 / -2` on a one-column grid conjures a phantom. */
    .sec > .spine, .sec > .stmt, .sec > .well, .sec > .steps { grid-column: 1 / -1; }
    .spine { flex-direction: row; align-items: baseline; justify-content: flex-start; gap: var(--s-3); }
    .spine__top { flex-direction: row; align-items: baseline; gap: var(--s-3); }
    .spine__t { writing-mode: horizontal-tb; transform: none; }
    .stmt { text-indent: 0; }
    .stmt--stack .stmt__b { padding-left: 0; }
    .stair { grid-template-columns: 1fr; }
    .stair__p { grid-column: 1 / -1; }
    .step { grid-template-columns: 2.5rem minmax(0, 1fr); row-gap: 12px; }
    .step__lines { grid-column: 2; }
    .asks { padding-left: 0; }
    .cols { grid-template-columns: 1fr; }
    .band__q { padding-left: 0; }
    .band__cap { margin-left: 0; }
  }
  @media (max-width: 640px) {
    .work { grid-template-columns: minmax(0, 1fr) 1.5rem; }
    .work__role { grid-column: 1; text-align: left; }
  }

  /* The band carries NO ledger, deliberately. It is the one place in the
     site where the ground changes, and it is left clean so the change of
     tone is the only thing happening there.

     The cost is stated rather than hidden: the ledger runs the height of
     the document everywhere else, and this is the one interval where it
     does not. The pointer's lit segment therefore fades out as it enters
     the band and returns below it. If that break ever reads as a fault
     rather than as a rest, the fix is a ledger on the band inset to
     `0 var(--margin)` and pulled out vertically by the band's own margin,
     `calc(clamp(24px, 5vh, 64px) * -1)`, which is what used to be here. */
  .band { position: relative; }

  /* ══ THE OPENING ══════════════════════════════════════════════ */
  .ov {
    min-height: 100vh;
    display: flex; flex-direction: column;
    padding-block: clamp(120px, 17vh, 190px) clamp(40px, 7vh, 80px);
    position: relative;
  }
  .ov__mast { display: block; }
  .ov__word {
    display: block;
    font-family: var(--display); font-weight: 500;
    letter-spacing: -0.045em; line-height: 0.86;
    color: var(--bone); text-transform: uppercase;
  }
  .ov__roles { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; }
  .ov__roles li {
    font-size: var(--t-sm); letter-spacing: 0.2em;
    text-transform: uppercase; color: var(--bone-dim);
  }
  .ov__stmt {
    font-family: var(--display); font-weight: 500;
    letter-spacing: var(--track-tight); line-height: 1.02; color: var(--bone-dim);
  }
  .ov__stmt .hot { color: var(--accent); }
  .ov__place { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 4px 22px; }
  .ov__place li { font-size: var(--t-xs); letter-spacing: 0.08em; color: var(--dim); }
  .ov__cue { font-size: var(--t-micro); letter-spacing: var(--track-mono); color: var(--dim); }

  /* ── CORNER LABELS ────────────────────────────────────────────
     The small print is pinned to the corners of the opening block and the
     middle is left to the name. Nothing is set between the two scales, which
     is what makes the jump from 12px to 280px read as deliberate rather than
     as a heading that got out of hand. */
  .ov__corner { position: absolute; z-index: 2; }
  .ov__corner--tl { top: clamp(110px, 15vh, 165px); left: 0; }
  .ov__corner--tr { top: clamp(110px, 15vh, 165px); right: 0; text-align: right; }
  .ov__corner--bl { bottom: clamp(34px, 6vh, 66px); left: 0; }
  .ov__corner--br { bottom: clamp(34px, 6vh, 66px); right: 0; text-align: right; }
  /* The left corners are stated explicitly because a centred opening sets
     text-align on the whole block, and the corner labels inherited it — the
     roles came out ragged, each line centred on the one above instead of
     stacking off a shared left edge. */
  .ov__corner--tl, .ov__corner--bl { text-align: left; }
  .ov__corner p {
    font-size: var(--t-micro); letter-spacing: 0.16em;
    text-transform: uppercase; color: var(--dim); margin: 0;
  }
  .ov__range { color: var(--accent); margin-top: 3px !important; }
  .ov__corner--tr .ov__place { flex-direction: column; align-items: flex-end; gap: 3px; }
  .ov__corner--tl .ov__roles { flex-direction: column; gap: 3px; }

  /* ══ RUNNING HEAD ═════════════════════════════════════════════ */
  .rh {
    position: fixed; z-index: 100; left: var(--margin); bottom: 24px;
    display: flex; align-items: baseline; gap: 10px;
    pointer-events: none; font-variant-numeric: tabular-nums;
  }
  .rh__name { font-size: var(--t-micro); letter-spacing: 0.18em; text-transform: uppercase; color: var(--bone-dim); }
  .rh__sep { font-size: var(--t-micro); color: var(--dim); }
  .rh__mv, .rh__folio {
    font-size: var(--t-micro); letter-spacing: 0.14em; color: var(--dim);
    transition: opacity 320ms var(--ease);
  }
  .rh__folio { color: var(--accent); }
  .rh.is-turning .rh__mv, .rh.is-turning .rh__folio { opacity: 0; }
  @media (max-width: 900px) { .rh { display: none; } }

  /* ══ 01 · THE WORKS ═══════════════════════════════════════════ */
  .sec--works { position: relative; margin-inline: calc(var(--margin) * -1); padding-block: 0; }
  .sec--works.is-live { height: calc(var(--count) * 62vh + 100vh); }
  .is-live .wk { height: 100%; }
  .wk__pin {
    position: sticky; top: 0; height: 100vh; overflow: hidden;
    -webkit-mask-image: linear-gradient(to bottom, transparent 0, #000 9%, #000 91%, transparent 100%);
    mask-image: linear-gradient(to bottom, transparent 0, #000 9%, #000 91%, transparent 100%);
  }
  .wk__scene { position: relative; height: 100%; perspective: 1250px; perspective-origin: 50% 50%; }

  .wk__world { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(20px, 3vw, 48px); margin-inline: var(--margin); padding-block: clamp(60px, 12vh, 140px); }
  .is-live .wk__world {
    display: block; position: absolute; top: 50%; left: 50%;
    width: 0; height: 0; margin: 0; padding: 0; transform-style: preserve-3d;
  }
  /* Scale, then position, then centre. The depth is a SCALE rather than a
     translateZ so each work's rendered height is known before it is placed —
     which is what makes a constant edge-to-edge gap possible at all. The
     -50% pair resolves against the unscaled box and is applied last, so the
     card's centre lands on --ty whatever the scale is. */
  /* ── THE SWEEP'S CARDS ────────────────────────────────────────────
     One common height for every work, so the width is what carries the
     aspect ratio and what the edge-to-edge placement stacks. Travel is on X
     only; opacity comes off the same depth the scale does. */
  .is-live .wcard {
    position: absolute; left: 50%; top: 50%;
    /* ONE COMMON HEIGHT, TIMES THE WORK'S OWN SCALE. It was a flat
       min(40vh, 26vw) for every card, which made a work's AREA proportional to
       its ratio and left the four upright works the smallest things in the
       catalogue — a 9:16 covered 32% of what a 16:9 did, which is a hierarchy
       saying the format a piece was shot in decides its importance.

       --card-k comes from the ratio, not from a list of slugs, so it reaches
       anything narrower than a square and is exactly 1 for everything else. A
       fifth upright work needs no edit and no work is named. See cards.ts.

       The placement script needed no change: it measures offsetWidth per card
       and re-measures on resize, load and fonts.ready. */
    height: calc(min(40vh, 26vw) * var(--card-k, 1));
    width: calc(min(40vh, 26vw) * var(--card-k, 1) * var(--arn, 1.7778));
    transform: translate(-50%, -50%) translateX(var(--tx, 0px)) scale(var(--s, 1));
    opacity: var(--op, 1);
    filter: none;
    will-change: transform, opacity;
  }

  /* ── THE READOUT: caption, ruler, date ────────────────────────────
     One tick per work rather than the reference's dense month ruler — its
     ruler is a calendar and its caption a month; ours is a catalogue, so the
     ticks are the sixteen works and the figure under the playhead is the real
     year of the work you are on. */
  .rl {
    position: absolute; left: 50%; transform: translateX(-50%);
    /* CLEARED OF THE MAT, BY THE MAT'S OWN NUMBER. The aperture's window is
       inset 11vh + (1 - lit) x 15vh top and bottom; at a flat 43px the
       readout's date sat 36px BEHIND the mat's bottom edge and could not be
       read at all. Deriving the offset from the same expression the mat uses
       means the two cannot drift apart when the window breathes. */
    bottom: calc(11vh + (1 - var(--lit, 1)) * 15vh + clamp(14px, 2.4vh, 30px));
    z-index: 5;
    /* A FIXED WIDTH, because the block shrink-wraps to its widest child — the
       caption — and the tick row is centred inside it. Left to shrink-wrap,
       the ruler slid sideways every time the title length changed: measured,
       the playhead ran 61, 46.5, 32, 55.5, 69, 72.5, 127px down a scroll that
       should have moved it steadily one way. The ruler is a fixed instrument;
       it cannot be re-scaled by the name of the thing it is measuring. */
    width: min(720px, 72vw);
    text-align: center; pointer-events: none;
  }
  .rl__cap { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .rl__cap, .rl__date {
    margin: 0; font-family: var(--display); font-weight: 500;
    font-size: var(--t-sm); letter-spacing: 0.02em; line-height: 1.06;
    text-transform: uppercase;
  }
  .rl__cap { color: var(--bone); }
  .rl__date { color: var(--dim); }
  @keyframes rl-in { from { opacity: 0 } to { opacity: 1 } }
  .rl.is-turning .rl__cap, .rl.is-turning .rl__date {
    animation: rl-in 190ms ease both;
  }
  @media (prefers-reduced-motion: reduce) {
    .rl.is-turning .rl__cap, .rl.is-turning .rl__date { animation: none; }
  }
  /* ══ THE SCALE IS AN ARC, AND IT TURNS ══════════════════════════
     Promoted from preview draft rng-c "Horizon", chosen from twenty-four
     readout designs. The flat sixteen-tick row is now a shallow curve with
     its centre 340px ABOVE the strip, so the scale bows downward and the
     marks hang from it; the index mark stays fixed at the top while the
     arc turns beneath it, the way a lens barrel moves under its index.

     THE CENTRE IS ABOVE, NOT BELOW, AND THAT IS THE DESIGN. A concave arc
     is a dial you are turning; a convex one is a horizon you are standing
     over, and the wedge of space it opens beneath its middle is exactly
     the shape a line of type wants to sit in — which is where the work's
     name now goes.

     340px AND 54 DEGREES. A convex arc shows its curvature far more
     readily than a concave one, because the marks fan outward rather than
     inward. At the concave radius the outermost marks lie down and the row
     stops reading as a comb.

     THE MASK IS THE HORIZON. Both ends going to nothing is what stops the
     curve reading as an arc with two ends and starts it reading as a
     surface continuing past the frame. It is one declaration and the whole
     illusion rests on it.

     IT TURNS ON A CONTINUOUS NUMBER. --ring is the same phase the conveyor
     itself derives — see initHorizon below — so the ring is wherever the
     scroll is rather than clicking between sixteen resting positions. The
     first version of this draft used the integer index and a 520ms
     transition to hide the steps; measured across the section, that gives
     16 positions against this one's 41 of 41 samples distinct.

     THERE IS NO TRANSITION ON THE ROW, deliberately. With a per-frame
     input a transition is latency rather than smoothing — the ring would
     always be chasing a value it had already been given. The lit mark
     keeps its 220ms fade, because THAT is a discrete change. */
  .rl__ruler {
    position: relative; height: 42px;
    margin: clamp(12px, 2vh, 18px) auto 0;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 19%, #000 81%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 19%, #000 81%, transparent);
  }
  .rl__ticks {
    display: block; height: 100%;
    transform: rotate(calc((7.5 - var(--ring, 0)) * 3.6deg));
    transform-origin: 50% -340px;
    will-change: transform;
  }
  /* Absolutely positioned, all sixteen stacked on the centre line and then
     fanned out by the nth-child rotations below — so the spacing is angular,
     not metric, and the row's own rotation carries every mark with it. */
  .rl__t {
    position: absolute; left: 50%; top: 4px;
    width: 1px; height: 11px; background: var(--dim);
    transform-origin: 50% -344px;
    transition: height 220ms var(--ease), background-color 220ms var(--ease);
  }
  .rl__t.is-on { height: 18px; background: var(--bone); }
  .rl__t:nth-child(1) { transform: translateX(-50%) rotate(-27.00deg); }
  .rl__t:nth-child(2) { transform: translateX(-50%) rotate(-23.40deg); }
  .rl__t:nth-child(3) { transform: translateX(-50%) rotate(-19.80deg); }
  .rl__t:nth-child(4) { transform: translateX(-50%) rotate(-16.20deg); }
  .rl__t:nth-child(5) { transform: translateX(-50%) rotate(-12.60deg); }
  .rl__t:nth-child(6) { transform: translateX(-50%) rotate(-9.00deg); }
  .rl__t:nth-child(7) { transform: translateX(-50%) rotate(-5.40deg); }
  .rl__t:nth-child(8) { transform: translateX(-50%) rotate(-1.80deg); }
  .rl__t:nth-child(9) { transform: translateX(-50%) rotate(1.80deg); }
  .rl__t:nth-child(10) { transform: translateX(-50%) rotate(5.40deg); }
  .rl__t:nth-child(11) { transform: translateX(-50%) rotate(9.00deg); }
  .rl__t:nth-child(12) { transform: translateX(-50%) rotate(12.60deg); }
  .rl__t:nth-child(13) { transform: translateX(-50%) rotate(16.20deg); }
  .rl__t:nth-child(14) { transform: translateX(-50%) rotate(19.80deg); }
  .rl__t:nth-child(15) { transform: translateX(-50%) rotate(23.40deg); }
  .rl__t:nth-child(16) { transform: translateX(-50%) rotate(27.00deg); }
  .rl__head {
    position: absolute; left: 50%; top: 0; bottom: auto;
    width: 1px; height: 24px; background: var(--bone);
    transform: translateX(-50%); z-index: 2;
  }
  /* Rounded again: 5.5% of the card's width, the radius measured off the
     reference. A flat 4px made the pictures read as browser windows. */
  .is-live .wcard :global(.st__win) {
    border-radius: 5.5%;
    box-shadow: 0 40px 90px rgba(0, 0, 0, 0.6);
  }


  /* ══ RHYTHM ═══════════════════════════════════════════════════ */
  .rg .sec { padding-block: clamp(90px, 17vh, 210px); }
  .sec--bare { position: relative; }
  .sec > .enq { grid-column: 1 / -1; z-index: 1; margin-top: clamp(50px, 10vh, 120px); }
  .enq :global(.ct__page) { padding-top: 0; }

  @media (max-width: 900px) {
    .wk__pin { position: static; height: auto; -webkit-mask-image: none; mask-image: none; }
    .wk__world { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .ov__corner { position: static; text-align: left !important; margin-bottom: 18px; }
  }

  /* ── TWO IDEAS, ONE PAGE ─────────────────────────────────────────
     XV Mosaic put the catalogue behind the type. V Corners left the middle
     empty and labelled the four corners, so the frame was drawn before the
     name was read. Put together they answer each other: the mosaic wants
     something to hold it, and the corner frame wants something inside it.

     ONE BED, FIXED BEHIND THE WHOLE DOCUMENT, and a corner-labelled frame on
     every movement with the middle kept for the type. Centre layout
     throughout — every title, every statement, every frame is on the one axis,
     from the opening to the enquiry.

     READABILITY BY ARITHMETIC. The bed is capped at 0.30 brightness, so the
     brightest pixel a photograph can put on screen is #4C4C4C and bone on it
     is 8.4:1 — above AA at any size. Running text then sits on solid ground,
     which takes it to 19:1. Nothing depends on a picture happening to be dark
     in the right place. */
  .rg { position: relative; }
  .ms__ground { position: fixed; inset: 0; z-index: 0; pointer-events: none; overflow: hidden; }
  .ms__bed {
    position: absolute; inset: -10%;
    display: grid; grid-template-columns: repeat(6, minmax(0, 1fr));
    grid-auto-rows: minmax(0, 1fr); gap: clamp(5px, 0.8vw, 13px);
    transform: translate3d(0, calc(var(--prog, 0) * -8%), 0) scale(1.06);
    will-change: transform;
  }
  /* THE GRADE IS ON THE TILE, NOT ON THE BED. It sat on .ms__bed until one
     frame needed a different contrast — see BED_GRADE in src/lib/bed.ts, where
     the reasoning and the measurements are. The tiles do not overlap and the
     filter is per-pixel, so thirty filtered tiles paint identically to one
     filtered grid; what it buys is a tile being able to name its own value.

     BRIGHTNESS IS NOT A VARIABLE HERE, DELIBERATELY. The 0.30 cap is what the
     readability arithmetic above rests on — it is the reason the brightest
     pixel a photograph can put on screen is #4C4C4C — so it is written as a
     constant that no tile can reach. Only the contrast boost is overridable. */
  .ms__tile {
    display: block; overflow: hidden; min-height: 0;
    border-radius: clamp(6px, 0.7vw, 12px);
    filter: brightness(0.30) saturate(0.7) contrast(var(--bed-k, 1.05));
  }
  /* Reaching past Still's own `transform: scale(1.001)` on the image, which is
     (0,2,1); naming .frame__layer as well makes this (0,3,1) so it wins without
     !important — including over Still's reduced-motion reset, which is also
     (0,2,1). The bed is pointer-events: none, so Still's hover scale, which is
     higher again, can never fire here. */
  .ms__tile--crop :global(.frame__layer img) {
    transform: translateY(var(--crop-y, 0)) scale(var(--crop-s, 1));
  }
  .ms__tile :global(.st), .ms__tile :global(.st__win) { border-radius: inherit; height: 100%; }

  .ov, .mvt { position: relative; z-index: 2; background: transparent; }
  .mvt {
    margin-inline: calc(var(--margin) * -1);
    padding-inline: var(--margin);
    padding-block: clamp(70px, 12vh, 156px);
    text-align: center;
  }
  .ov--cm { text-align: center; justify-content: center; }
  /* The conveyor IS the catalogue; it must not have the catalogue behind it. */
  .mvt.sec--works { padding-block: 0; padding-inline: 0; background: var(--ground); }

  /* ── THE FRAME ────────────────────────────────────────────────────
     Four labels, the middle left alone. */
  .fr { position: relative; padding: clamp(30px, 5vh, 66px) clamp(26px, 4vw, 72px); }
  .fr--hero { padding-block: clamp(46px, 8vh, 104px); }
  /* THE CORNER LABELS SIT OVER THE BED, so --dim cannot be used for them.
     #858585 against the brightest ground a photograph can produce (#4C4C4C)
     is 2.4:1 — nowhere near AA, and these are 10px. At --bone-dim the same
     worst case is 5.9:1, which clears AA for small text, and the shadow gives
     the letterforms an edge to sit on over a busy tile. */
  .cn {
    position: absolute; margin: 0; z-index: 3;
    font-size: var(--t-micro); letter-spacing: 0.16em;
    text-transform: uppercase; color: var(--bone-dim); line-height: 1.55;
    text-shadow: 0 1px 3px var(--ground), 0 0 14px rgba(10, 9, 8, 0.95);
  }
  .cn--tl { top: 0; left: 0; text-align: left; }
  .cn--tr { top: 0; right: 0; text-align: right; }
  .cn--bl { bottom: 0; left: 0; text-align: left; }
  .cn--br { bottom: 0; right: 0; text-align: right; }
  .cn--tl { color: var(--bone); }
  .fr--over { position: absolute; z-index: 6; top: clamp(66px, 10vh, 110px); left: var(--margin); right: var(--margin); }

  .fr__mid { position: relative; z-index: 2; }
  .fr__t {
    margin: 0; font-family: var(--display); font-weight: 500;
    font-size: clamp(1.5rem, min(6vw, 8vh), 4.2rem);
    line-height: 0.96; letter-spacing: -0.045em;
    text-transform: uppercase; color: var(--bone);
  }
  .fr__name {
    margin: 0; font-family: var(--display); font-weight: 500;
    font-size: clamp(2rem, min(11vw, 15vh), 8.5rem);
    line-height: 0.86; letter-spacing: -0.055em;
    text-transform: uppercase; color: var(--bone);
  }
  .fr__w { display: block; }
  .fr__cap {
    margin: clamp(14px, 2.4vh, 32px) auto 0; max-width: 28ch;
    font-family: var(--display); font-weight: 500;
    font-size: clamp(1rem, min(3.2vw, 4.4vh), 2.4rem);
    line-height: 1.1; letter-spacing: var(--track-tight);
    text-transform: uppercase; color: var(--bone-dim);
  }
  .fr__cap .line { display: block; }

  /* ── BODY: CENTRED, ON SOLID GROUND ───────────────────────────────
     Lists set left inside centred columns, because a ragged-right list read as
     centred is not readable. That is the one exception on the page. */
  .ms__panel {
    margin: clamp(24px, 4.4vh, 58px) auto 0; max-width: 78ch;
    padding: clamp(22px, 3.6vh, 46px) clamp(20px, 3vw, 44px);
    background: var(--ground);
    border: 1px solid var(--rule-soft);
    border-radius: clamp(10px, 1.2vw, 20px);
  }
  .s__stmt { margin: 0 auto; max-width: 22ch;
    font-family: var(--display); font-weight: 500;
    font-size: clamp(1.25rem, min(3.8vw, 5.2vh), 2.9rem);
    line-height: 1.14; letter-spacing: -0.028em; color: var(--bone); }
  .s__mark { display: block; margin-top: 0.2em; color: var(--bone-dim); font-style: italic; }
  .s__body { margin: clamp(24px, 4.4vh, 56px) auto 0; columns: 2; column-gap: clamp(24px, 4vw, 60px); max-width: 64ch; text-align: left; }
  .s__p { break-inside: avoid; margin-bottom: var(--s-3); }
  .s__p p, .s__lede p { margin: 0; }
  .s__p .s__rn { display: block; margin-bottom: 3px; }
  .s__rn, .s__coln { color: var(--dim); font-size: var(--t-xs); font-variant-numeric: tabular-nums; }
  .s__lede { max-width: 52ch; margin: clamp(20px, 3.6vh, 44px) auto 0; color: var(--bone-dim); }
  .s__cols { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(22px, 3.4vw, 52px); margin-top: clamp(28px, 5vh, 66px); text-align: left; }
  .s__col ul { list-style: none; margin: 0; padding: 0; }
  .s__col li { display: flex; gap: 10px; padding-block: 7px; border-bottom: 1px solid var(--rule-soft); font-size: var(--t-sm); color: var(--bone-dim); }
  .s__collab { color: var(--accent); font-size: var(--t-xs); margin: 0 0 var(--s-3); padding-bottom: 10px; border-bottom: 1px solid var(--rule); }
  .s__steps { list-style: none; margin: clamp(26px, 5vh, 62px) auto 0; padding: 0; display: grid; gap: clamp(26px, 5vh, 56px); max-width: 66ch; text-align: left; }
  .s__stepn { color: var(--accent); font-size: var(--t-xs); }
  .s__steptitle { margin: 6px 0 var(--s-3); font-family: var(--display); font-weight: 500; font-size: clamp(1.1rem, 2.2vw, 1.7rem); letter-spacing: -0.02em; color: var(--bone); }
  .s__steplines p { margin: 0 0 8px; color: var(--bone-dim); }
  .s__steplines .asks { color: var(--dim); }
  .s__step .draw { margin-bottom: clamp(14px, 2.4vh, 26px); }
  .s__links { list-style: none; margin: clamp(24px, 4vh, 52px) auto 0; padding: 0; display: flex; justify-content: center; gap: clamp(20px, 4vw, 54px); flex-wrap: wrap; }
  .s__enq { margin-top: clamp(44px, 8vh, 100px); text-align: left; }
  .s__enq :global(.ct__page) { padding-top: 0; }
  .hot { color: var(--accent); text-transform: none; font-family: var(--serif); font-style: italic; font-weight: 300; font-size: 1.06em; }
  .ov__cue { color: var(--dim); }

  @media (max-width: 900px) {
    .ms__bed { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .cn { position: static; display: inline-block; margin: 0 10px 10px 0; }
    .fr { padding-inline: 0; }
    .s__body { columns: 1; }
    .s__cols { grid-template-columns: 1fr; }
  }

  /* ══ LXIII · APERTURE IV ═════════════════════════════════════════════
     THE CATALOGUE EXISTS ONLY INSIDE THE WINDOW. A mat of solid ground covers
     the whole viewport except one centred rectangle, and the bed shows through
     that and nowhere else. V Corners drew a frame around an empty middle; this
     draws the same frame and puts the work in it.

     THE WINDOW BREATHES. Its inset is driven by --lit — the highest coverage
     any movement currently has — so it opens as a movement takes the window
     and closes at the joins. Between rooms the aperture narrows to a slot and
     the page is almost entirely ground; arriving somewhere, it opens.

     THE MAT IS A BOX-SHADOW, not four positioned rectangles. A spread of
     100vmax paints solid ground outward from the window's edge in every
     direction at once, so there are no seams to keep in register and nothing
     to recompute when the window moves. */
  .ap__mat {
    position: fixed; z-index: 1; pointer-events: none;
    inset: calc(11vh + (1 - var(--lit, 0)) * 15vh) calc(7vw + (1 - var(--lit, 0)) * 13vw);
    box-shadow: 0 0 0 100vmax var(--ground);
    border: 1px solid var(--rule);
    border-radius: 2px;
    /* NO will-change HERE. It said `inset`, and inset is a layout
       property — there is no compositor path for it to be promoted onto,
       so the hint bought nothing and cost a surface. What it changes is
       still a real cost: --lit moves through ten distinct values across
       the document, and each one relays out this box and repaints a
       100vmax shadow. Measured, --lit does NOT move at all inside
       Selected works, so none of that lands on the section that was
       stuttering; it is written down here rather than changed, because
       changing it would change how the aperture opens. */
  }

  /* ══ COMMON GROUND ═══════════════════════════════════════════════
     Aperture IV set its body at 16px in two columns — a 295px measure, about
     36 characters a line. All three of these open the measure and raise the
     size first, because no amount of editorial detailing rescues a line that
     short; the detailing is what they then differ on. */
  .s__lede { color: var(--bone-dim); }
  .s__lede p, .s__p p, .s__steplines p {
    font-size: var(--body-size); line-height: var(--body-lead);
    /* Widow and orphan control. `pretty` costs a little layout time and is
       ignored where unsupported, so it can only improve the rag. */
    text-wrap: pretty;
  }
  /* the two-into-three grid is gone; see the section redesign below */
  .s__col li { font-size: var(--list-size); line-height: 1.45; padding-block: 10px;
               font-variant-numeric: tabular-nums; }
  .s__steptitle { font-size: clamp(1.15rem, 2.4vw, 1.8rem); text-wrap: balance; }
  .fr__t, .s__stmt { text-wrap: balance; }

  /* ══ LXVII · SET AS A BOOK ═══════════════════════════════════════
     THE RUNNING TEXT BECOMES A SERIF. The register already carries Fraunces,
     but the layout only loads its ITALIC cut — every existing use of --serif
     in this codebase pairs it with font-style: italic, and upright Fraunces
     would have fallen through to Georgia without a word of warning. This
     draft imports the roman axes ITSELF, in its own frontmatter, so the real
     site's font payload is untouched.

     AND IT USES THE OPTICAL SIZE AXIS PROPERLY. Fraunces runs opsz 9–144.
     A face cut for 144pt display has thin hairlines and tight spacing that
     fall apart at reading size; opsz 22 on the body and 96 on the initial is
     the axis doing the job it exists for, rather than one drawing scaled up
     and down. */
  .s__p p, .s__lede p, .s__steplines p {
    font-family: 'Fraunces Variable', 'Iowan Old Style', Palatino, Georgia, serif;
    font-weight: 400; font-style: normal;
    font-variation-settings: 'opsz' 22, 'SOFT' 18, 'WONK' 0;
    letter-spacing: 0;
    hanging-punctuation: first last;
  }
  .rg { --body-size: clamp(1.1rem, 1.5vw, 1.36rem); --body-lead: 1.66;
        --list-size: clamp(1rem, 1.2vw, 1.1rem); }
  /* ══ THE WINDOW OPENS TO READ, FROM APERTURE VI ══════════════════
     The aperture is narrow and cinematic over the works and opens out when
     there is something to read — measured on VI, 1101px to 1219px.

     ONE SOURCE FOR THE APERTURE. The mat's inset and the widths of everything
     inside it are the same number, so nothing set on the page can end up
     wider than the window it is being read through. VI proved why that
     matters: with a fixed max-width, the window closes to about 993px at a
     join between movements and a wider panel runs its outer lines straight
     behind the mat.

     AND THE MEASURE IS NOT STRETCHED INTO THE NEW WIDTH. This is the book
     setting: 60ch of Fraunces comes out at 513px, which is 63 characters a
     line, and 63 is where it should stay — a longer line is not a better one.
     The width the window gains goes to the CATALOGUE, which is the point of
     opening it: more of the work is visible around the text block, and the
     text itself is untouched. The caps below are ceilings that the window can
     close down onto, never targets to grow into. */
  .rg {
    --mat-h: calc(7vw + (1 - var(--lit, 0)) * 13vw - var(--read, 0) * 4.6vw);
    --win: calc(100vw - 2 * var(--mat-h));
  }
  .ap__mat { inset: calc(11vh + (1 - var(--lit, 0)) * 15vh) var(--mat-h); }

  .ms__panel { max-width: min(76ch, calc(var(--win) - 90px)); }
  .s__body { columns: 1; max-width: min(60ch, calc(var(--win) - 150px)); }
  .s__lede { max-width: min(56ch, calc(var(--win) - 180px)); }
  .s__steps { max-width: min(60ch, calc(var(--win) - 150px)); }
  .s__stmt { max-width: 26ch; font-size: clamp(1.5rem, min(4.4vw, 5.6vh), 3.1rem); }

  /* THE RAISED INITIAL, cut at display optical size — the one place on the
     page where the 96 end of the axis belongs. */
  .s__body .s__p:first-of-type p::first-letter {
    float: left;
    font-size: 3.3em; line-height: 0.82;
    margin: 0.02em 0.08em 0 0;
    font-variation-settings: 'opsz' 96, 'SOFT' 0, 'WONK' 1;
    font-weight: 500; color: var(--bone);
  }
  /* the paragraph numbers go quiet: a book does not number its paragraphs */
  .s__p .s__rn { font-size: var(--t-xs); color: var(--dim); opacity: 0.6; }

  /* ══ THE LISTING, IN THE BOOK'S OWN HAND ═════════════════════════
     THE OLD LAYOUT WAS THREE GROUPS IN A TWO-COLUMN GRID. Film and Brand took
     the first row and Music was left alone on the second with an empty cell
     beside it — measured at 322px columns, Music sitting at the same x as
     Film, 318px below. Three things in a two-column grid can only ever come
     out lopsided. The data is a clean 3 x 5: three disciplines, five entries
     each, and every one of these three redesigns is built on that.

     And the entries are set in Fraunces like the running text, at the reading
     end of the optical size axis — the section stops looking like a UI
     component parked in a book. */
  .s__col li, .s__collab {
    font-family: 'Fraunces Variable', 'Iowan Old Style', Palatino, Georgia, serif;
    font-variation-settings: 'opsz' 20, 'SOFT' 18, 'WONK' 0;
  }
  .s__col li { font-style: normal; font-weight: 400; letter-spacing: 0; }

  /* THE LISTING SECTION GETS A WIDER PANEL. Setting a width on the listing
     alone did nothing: .ms__panel is 767px and its own padding takes 77 of
     that, so the block stayed pinned at 688px however wide the listing asked
     to be. The panel is widened for this movement only — the statement and
     the lede inside it keep their own narrower limits, so only the listing
     takes the extra width. Still derived from --win, so it closes with the
     aperture at a join like everything else. */
  [data-mv="2"] .ms__panel { max-width: min(940px, calc(var(--win) - 120px)); }

  /* ══ LXXI · INDEX ════════════════════════════════════════════════
     THREE COLUMNS, ONE ROW. The obvious symmetry, and the opened window is
     what finally affords it: at 1219px each column gets about 370px, which is
     room enough to set the entries at reading size instead of the 13px the
     old three-up needed at 230px. */
  .s__cols {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(20px, 3vw, 46px);
    /* An explicit width, not a ch cap. `ch` resolves against the ELEMENT's
       own font-size, and this block inherits the 13px furniture size — so
       96ch came out at 688px, three 204px columns inside a 1219px window.
       The listing runs wider than the 513px reading measure, as an index in a
       book does, without going full bleed. */
    max-width: min(880px, calc(var(--win) - 200px));
    margin-inline: auto;
    border-top: 1px solid var(--rule);
    padding-top: clamp(20px, 3vh, 36px);
  }
  .s__collab {
    color: var(--bone); border-bottom: 0; padding-bottom: 0;
    margin-bottom: clamp(12px, 1.8vh, 20px);
    font-size: clamp(1.05rem, 1.5vw, 1.4rem);
    font-style: italic; font-weight: 300; letter-spacing: 0;
    text-transform: none;
  }
  .s__col li {
    display: grid; grid-template-columns: 2.1em 1fr; align-items: baseline;
    gap: 0.2em; padding-block: 9px;
    border-bottom: 1px solid var(--rule-soft);
    font-size: clamp(1rem, 1.25vw, 1.18rem); line-height: 1.36;
  }
  .s__col li:first-child { border-top: 1px solid var(--rule-soft); }
  .s__coln { font-family: var(--mono); font-size: var(--t-xs); color: var(--dim); }

  /* ══ LXXIV · THE CONTACT SECTION, OPENED OUT ═════════════════════
     THE DIRECT DETAILS WERE ON THE PAGE TWICE. The section carried its own
     Email / WhatsApp / Phone list AND the enquiry form, which prints the same
     three under "Let's talk" — the same addresses set twice, a screen apart.
     The section's own list is gone; the form's stays, and WhatsApp has been
     added to it between email and phone so nothing was lost in the removal.

     AND THE FORM WAS BEING ASKED TO WORK IN 767px. .ct__page is a two-column
     grid, so at that width each column had barely 340px and the whole thing
     read as cramped. The panel opens to 1080px for this movement only —
     derived from --win like everything else here, so it still closes with the
     aperture at a join. */
  [data-mv="5"] .ms__panel { max-width: min(1080px, calc(var(--win) - 110px)); }
  [data-mv="5"] .s__enq { margin-top: clamp(30px, 5.5vh, 72px); }
  .s__enq :global(.ct__page) { column-gap: clamp(40px, 5vw, 88px); }
  /* THE DIRECT LIST, TIGHTER AGAIN. XXXII had already brought this block
     from 141px down to 101px — three even rows, one address per row, on a
     leading set for a list rather than for prose. This takes the same
     structure further: the row gap comes off first, then the address size,
     then the leading, in that order, because gap is the cheapest space to
     lose and type size the most expensive.

     ONE PER ROW SURVIVES THE SQUEEZE. The grid stays, and it is the reason
     the block can be tightened at all: left to the component's flex-wrap the
     three break unevenly the moment they shrink — email alone on one row,
     WhatsApp and phone sharing the next — which is ragged rather than
     compact. Three even rows shrink evenly.

     THE ADDRESSES STAY LARGER THAN THE COMPONENT'S OWN 20px, on purpose.
     These are the two lines a visitor is most likely to want without filling
     in a form, and a compact block is not the same thing as a quiet one. */
  .s__enq :global(.ct__direct) {
    display: grid; grid-auto-flow: row;
    gap: clamp(5px, 0.8vh, 8px);
  }
  .s__enq :global(.ct__direct li) { gap: 9px; align-items: baseline; }
  .s__enq :global(.ct__direct .mono) { font-size: var(--t-xs); letter-spacing: 0.1em; }
  .s__enq :global(.ct__direct a) {
    font-size: clamp(1.02rem, 1.32vw, 1.22rem);
    line-height: 1.2;
    letter-spacing: -0.016em;
  }
  .s__enq :global(.ct__lede) { font-size: clamp(1rem, 1.25vw, 1.15rem); }
  .s__enq :global(.ct__rule) { margin-block: clamp(20px, 3vh, 34px); }

  /* ══ THE WORKS READOUT ═══════════════════════════════════════════
     The playhead goes accent. It is the one live thing in that readout — it
     is the only mark that moves — and it was the same bone as the static
     furniture around it, so nothing said which mark to watch.

     And the work's name goes up: it was set at the 13px furniture size, the
     same as the corner labels, when it is the one piece of copy in the
     section that changes as you scroll. */
  .rl__head { background: var(--accent); }
  /* THE NAME MOVES INTO THE CURVE. With the arc bowing down there is a
     wedge of space beneath its centre that nothing else can use, and a
     single line of type is exactly what fits it — so the caption is pulled
     up into the bowl rather than sitting clear of the scale. */
  .rl__cap {
    margin-top: -6px;
    font-size: clamp(1.05rem, 1.5vw, 1.4rem);
    letter-spacing: -0.015em; line-height: 1.16;
  }
  /* The year goes to the mono face at furniture size. Against a curved
     scale and a display-face name it is the third voice in the readout and
     should read as the smallest — at --t-sm it competed with the title. */
  .rl__date {
    margin-top: 6px;
    font-family: var(--mono); font-size: var(--t-micro);
    letter-spacing: 0.16em; color: var(--dim);
  }

  /* ══ THE BOXES GO BACK TO BLACK ═════════════════════════════════
     XXXIX and XL cut windows into this panel: the panel gave up its fill and
     a masked layer under the form painted it back with one hole per chip, so
     every answer box was an opening onto the catalogue. That is reverted here
     — the panel keeps its own --ground fill, the masked layer and the script
     that built it are gone, and the chips are plain outlined boxes on solid
     ground again, exactly as XXXII draws them.

     Nothing is left behind to do it: no blackout element, no mask, no
     ResizeObserver, no per-chip geometry. What remains of this draft is the
     three things that were never about the windows — the heading removed,
     the enquiry raised into the space it left, and the gutter rule stopping
     clear of the crossing. */

  /* ══ THE ENQUIRY RISES INTO THE HEADING'S PLACE ══════════════════
     With the CONTACT heading gone, .fr stopped being a title block and became
     a bare band of padding with the four corner labels pinned to its edges —
     top pair at its top, bottom pair at its bottom, and nothing between them.
     Measured, that left the panel starting 190px below the section's top
     where the heading used to start at 122px: 68px of the section's opening
     was empty.

     THE PANEL NOW STARTS EXACTLY WHERE THE WORD DID. The space is taken off
     the section's own top padding rather than out of .fr, because .fr's
     padding IS the label band — the corner labels are absolutely positioned
     to its top and bottom edges, so shrinking it does not tighten the band,
     it collapses the two rows onto each other. At 72px they already clear by
     only 10px.

     AND THE NUMBER IS DERIVED, NOT DIALLED IN. The panel's top is the sum of
     three things: this padding, .fr's own height (2 x its 5vh padding), and
     the panel's 4.4vh top margin. The heading's top was the section's 12vh
     padding plus one of .fr's 5vh. Setting this padding to 12vh - 5vh - 4.4vh
     = 2.6vh makes those two equal — so the panel's top edge lands on the
     heading's old top at every viewport height where the three source clamps
     are in their linear range, which is 615px to 1231px. Outside that the
     clamps stop composing and the two drift apart by a few pixels, which is
     why the bounds here are the source bounds subtracted the same way
     (70-30-24 and 156-66-58) rather than a pair of round numbers. */
  [data-mv="5"] { padding-top: clamp(16px, 2.6vh, 32px); }

  /* ══ THE LINE STOPS AT THE CROSSING ══════════════════════════════
     The grey rule down the gutter ends where it meets the footer's rule,
     just under the send action — an intersection, and then nothing.

     The component draws a tail past that crossing on purpose: it measures
     the distance down to the footer's last line of text, adds an overhang,
     and runs the line off the page so the meeting reads as a crossing rather
     than as the line being cut to fit. The cost is that the tail then runs
     straight down through the middle of "Listen on Spotify or Apple
     Music…", which is 60ch wide and starts at the left margin, so a 1px
     rule lands inside the sentence.

     content: none removes the tail's box outright rather than hiding it, so
     there is nothing left to overlap and nothing left to measure. The
     component's own script still writes --tail; with no ::after to read it
     the value is simply unused, which is why this is one line here and no
     change at all to the component the live site shares.

     AND THEN THE LINE STOPS SHORT OF THE CROSSING ALTOGETHER, so the two
     rules clear each other instead of meeting. The clearance is not a chosen
     number: the rule under the standfirst already stops half a gutter shy of
     this line — measured, it ends at x608 against the line at x640, a 32px
     clearance. Half the gutter is what this reuses, so the vertical rule
     leaves the footer's rule exactly what every other rule in the section
     leaves.

     AND IT IS HALF OF THIS DRAFT'S GUTTER, NOT THE COMPONENT'S. ContactForm
     sets column-gap: 3.4em, which at the 16px this page resolves at would be
     54.4px — but the draft overrides the gutter to clamp(40px, 5vw, 88px),
     64px here. Half of the component's figure gave a 27px clearance against
     the standfirst rule's 32px, close enough to look like a mistake rather
     than a system. clamp(20px, 2.5vw, 44px) is half of the gutter actually
     in force, so the two clearances stay equal at every width.

     Written as a subtraction from the footer's own top margin rather than as
     a height, because that margin is what the line was pinned to in the first
     place: if .ft's margin changes, this still lands half a gutter above it.

     The orange fill is measured as a percentage of this line, so it shortens
     with it and still completes at the new foot. The component's arrival
     watcher is unaffected — it fires when the fill passes the send action's
     top, and the foot is still 47px below that. */
  .s__enq :global(.divide)::after { content: none; }
  .s__enq :global(.divide) { bottom: calc(clamp(20px, 2.5vw, 44px) - clamp(64px, 11vh, 120px)); }

  /* ══ THE MASTHEAD, BORROWED FROM V · CORNERS ═════════════════════
     Only the name and the sentence. XL's opening keeps its aperture, its
     catalogue bed, its four corner labels and its frame; what changes is the
     two pieces of type in the middle of them.

     THE NAME COMES OFF TWO LINES ONTO ONE. XL set .fr__w to display:block, so
     UGAM sat above KHETANI at clamp(2rem, min(11vw, 15vh), 8.5rem) on -0.055em.
     Corners runs the mast as a nowrap flex row with a clamp(12px, 1.7vw, 30px)
     column gap and sizes the words at clamp(2.4rem, 9.2vw, 7.6rem) on -0.045em
     — one line, wider tracking, and the size governed by width alone rather
     than by whichever of 11vw and 15vh is smaller. That last difference is the
     real one: XL's name shrinks on a short viewport to protect the vertical
     rhythm of a full-height opening, and Corners' does not, because a single
     line has far less height to protect.

     THE SENTENCE STOPS BEING UPPERCASE. XL's .fr__cap is uppercase at 28ch on
     line-height 1.1, close under the name at clamp(14px, 2.4vh, 32px).
     Corners' .ov__stmt is sentence case at 24ch on 1.02, standing well clear
     at clamp(34px, 6vh, 72px) — so it reads as a line of prose under a
     masthead rather than as a second, smaller deck of display type.

     The base .ov__word and .ov__stmt rules this builds on are already in this
     stylesheet, character for character the same as Corners' — they were
     carried along unused when the aperture drafts moved to .fr__name. Only
     the four .ov--corners overrides were missing, and they are re-scoped to
     .fr--hero rather than applied by adding the ov--corners class: that class
     also sets align-items:center on the .ov itself, which would shrink
     .fr--hero to its content width and take the four corner labels with it. */
  /* ══ THE FRAME KEEPS XL'S BOX, SO THE CORNERS DO NOT MOVE ═══════
     The four corner labels are absolutely positioned to .fr--hero's own
     edges, so anything that changes the frame's height moves them. Dropping
     the name from two lines to one did exactly that: measured at 1280x720,
     the frame went from 389.98px to 355.41px, and because .ov centres it,
     the labels came in by half of that at each end — the top pair 17px down,
     the bottom pair 17px up.

     So the frame is pinned back to the height it has in XL, and .fr--hero
     becomes a centring flex column so the shorter masthead sits at the same
     centre rather than riding at the top of a box that is now taller than
     its contents. The labels are out of flow and do not care.

     THE HEIGHT IS XL'S OWN EXPRESSIONS, NOT A NUMBER. Two pads, the name's
     two lines at its 0.86 leading, the caption's top margin, and the
     caption's two lines at its 1.1 leading — each read straight off the rule
     it comes from, so this tracks XL at every viewport instead of at one.

     THE 2.265 IS MEASURED, NOT DERIVED. A pure flow model gives 2.2 there
     and lands 2.048px short at 720 and 2.496px short at 1024 — the residual
     is the baseline gap under the inline-block inside each masked caption
     line, which no arithmetic over line-height can see. It scales with the
     caption's own size (2.048/31.68 and 2.496/38.4 agree to three places),
     so it folds into that coefficient rather than sitting outside as a
     constant. Checked against XL: 0.011px out at 720 and 0.0005px at 1024. */
  .fr--hero {
    min-height: calc(
      2 * clamp(46px, 8vh, 104px)
      + 1.72 * clamp(2rem, min(11vw, 15vh), 8.5rem)
      + clamp(14px, 2.4vh, 32px)
      + 2.265 * clamp(1rem, min(3.2vw, 4.4vh), 2.4rem)
    );
    display: flex; flex-direction: column; justify-content: center;
  }
  .fr--hero .ov__middle { display: flex; flex-direction: column; align-items: center; }
  .fr--hero .ov__mast { display: flex; flex-wrap: nowrap; justify-content: center; column-gap: clamp(12px, 1.7vw, 30px); }
  .fr--hero .ov__word { font-size: clamp(2.4rem, 9.2vw, 7.6rem); }
  .fr--hero .ov__stmt {
    margin-top: clamp(34px, 6vh, 72px);
    font-size: clamp(1.3rem, 2.7vw, 2.3rem); max-width: 24ch;
  }
  .fr--hero .ov__stmt .line { display: block; }
</style>
<script>
  /* ONE CLOCK FOR THE WHOLE PAGE.
     Per movement:  --e entry · --x exit · --p through · --f window coverage
     On the register: --prog how far down the document · --lit the highest
     coverage any single movement currently has.
     --lit is what opens and closes the aperture: at a join no movement owns
     the window, it dips, and the frame narrows between rooms. */
  function initSpine() {
    const rg = document.querySelector<HTMLElement>('[data-rg]');
    if (!rg || rg.dataset.spineBound) return;
    rg.dataset.spineBound = '1';
    const secs = Array.from(rg.querySelectorAll<HTMLElement>('.ov, .mvt'));
    const rows = Array.from(rg.querySelectorAll<HTMLElement>('[data-row]'));
    /* --prog is written HERE, not on .rg. See @property --prog at the top of
       the stylesheet for why, and note that .ms__bed is the only thing in the
       codebase that reads it. */
    const bed = rg.querySelector<HTMLElement>('.ms__bed');
    if (!secs.length) return;
    let raf = 0;
    const paint = () => {
      raf = 0;
      /* ══ EVERY MEASUREMENT FIRST, THEN EVERY WRITE ═══════════════
         This used to ask for a box, write four custom properties, ask for
         the next box, write four more — thirty-one boxes a frame, each one
         after a write.

         THE WRITES ARE NOT FREE, WHICH IS THE WHOLE PROBLEM. --lit on .rg
         feeds .ap__mat's `inset` and .rl's `bottom`, and both are layout
         properties, so every write dirtied layout and the next
         getBoundingClientRect had to resolve the whole page again before
         it could answer. Thirty-one forced layouts a frame.

         Reordering costs nothing and changes nothing: the numbers written
         are computed from exactly the same boxes as before. Measured at
         1280 while sweeping Selected works, this function alone:

             as it was    median 3.9ms   p90 4.6ms   worst 9.4ms
             reordered    median 0.8ms   p90 1.0ms   worst 4.6ms

         It was the most expensive of the six scroll loops on the page by
         a factor of six, and it is not the conveyor. */
      const vh = innerHeight;
      const span = document.documentElement.scrollHeight - vh;
      const secBoxes = secs.map((el) => el.getBoundingClientRect());
      const rowBoxes = rows.map((el) => el.getBoundingClientRect());

      let lit = 0, read = 0;
      const covers = new Array(secs.length);
      for (let i = 0; i < secs.length; i++) {
        const r = secBoxes[i];
        const cover = Math.min(1, Math.max(0, (Math.min(r.bottom, vh) - Math.max(r.top, 0)) / vh));
        covers[i] = cover;
        if (cover > lit) lit = cover;
        /* Coverage of whatever owns the window, counted only when it is not
           the works — this is what opens the aperture for reading. A coverage
           figure rather than a flag, so the opening rides the scroll instead
           of snapping the moment a section takes over. */
        if (!secs[i].classList.contains('sec--works') && cover > read) read = cover;
      }

      /* --e, --p AND --f ARE GONE. Nothing in src/ reads any of them —
         checked across every stylesheet and component — so they were 21
         writes a frame, on seven sections, feeding nothing. --x is kept: it
         is read, by .work__peek's `left`, and untangling that is a separate
         question. */
      for (let i = 0; i < secs.length; i++) {
        const el = secs[i], r = secBoxes[i];
        const h = Math.max(1, r.height);
        el.style.setProperty('--x', Math.min(1, Math.max(0, -r.top / h)).toFixed(4));
      }
      if (bed) bed.style.setProperty('--prog', (span > 0 ? Math.min(1, Math.max(0, scrollY / span)) : 0).toFixed(4));
      rg.style.setProperty('--lit', lit.toFixed(4));
      rg.style.setProperty('--read', read.toFixed(4));
      const line = vh * 0.42, reach = vh * 0.34;
      for (let i = 0; i < rows.length; i++) {
        const r = rowBoxes[i];
        if (r.bottom < -vh || r.top > vh * 2) continue;
        const d = Math.abs(r.top + r.height / 2 - line);
        rows[i].style.setProperty('--lit', Math.max(0, 1 - d / reach).toFixed(3));
      }
    };
    addEventListener('scroll', () => { if (!raf) raf = requestAnimationFrame(paint); }, { passive: true });
    addEventListener('resize', () => { if (!raf) raf = requestAnimationFrame(paint); }, { passive: true });
    paint();
  }
  initSpine();
  document.addEventListener('astro:page-load', initSpine);
</script>

<style>
  /* ══ D · POSTER ════════════════════════════════════════════════════
     .po-* classes only; .mvt.po-sec outranks the page's .mvt rules. */
  .mvt.po-sec {
    --po-white: #FFFFFF;
    --po-grey: #9B9B9B;
    --po-rule: rgba(255, 255, 255, 0.2);
    background: var(--ground);
    color: var(--po-white);
    font-family: var(--display);
    text-align: left;
    padding-block: clamp(48px, 8vh, 100px) clamp(110px, 20vh, 240px);
    /* The giant words are meant to be cropped by the screen; clip rather
       than hidden so no scroll container is made, and nothing sideways
       can ever scroll. */
    overflow-x: clip;
  }

  /* ── THE GIANT WORD ─────────────────────────────────────────────── */
  .po-giant {
    margin: 0 0 clamp(20px, 3.4vh, 40px);
    font-size: var(--gs, 24vw); font-weight: 500;
    line-height: 0.8; letter-spacing: -0.058em;
    white-space: nowrap;
  }
  .po-pan { display: inline-block; padding-right: 0.08em; }
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .po-pan {
        animation: po-pan linear both;
        animation-timeline: view();
        animation-range: cover;
      }
    }
  }
  @keyframes po-pan {
    from { transform: translateX(6vw); }
    to   { transform: translateX(-18vw); }
  }

  /* ── THE GRID ───────────────────────────────────────────────────── */
  .po-grid {
    display: grid; grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gutter); row-gap: clamp(44px, 8vh, 100px);
    align-items: start;
    border-top: 1px solid var(--po-rule); padding-top: 14px;
  }
  .po-label {
    margin: 0; font-size: 12px; font-weight: 500; line-height: 1.4;
    letter-spacing: 0.005em; color: var(--po-grey);
  }
  .po-label--hi { color: var(--po-white); }
  .po-c1 { grid-column: 1 / span 2; grid-row: 1; color: var(--po-white); }
  .po-c2 { grid-column: 4 / span 3; grid-row: 1; }
  .po-c3 { grid-column: 7 / span 3; grid-row: 1; }

  .po-state {
    grid-column: 1 / span 10; grid-row: 2; margin: 0;
    font-size: clamp(2.3rem, 5.4vw, 5.8rem); font-weight: 500;
    line-height: 0.98; letter-spacing: -0.04em; text-wrap: balance;
  }
  .po-line { display: block; }
  .po-stop { color: var(--accent); }

  .po-body {
    grid-column: 5 / -1; grid-row: 3;
    columns: 2; column-gap: calc(var(--gutter) * 2);
  }
  .po-body p, .po-lede, .po-steplines p {
    margin: 0 0 1em; font-size: clamp(1.05rem, 1.28vw, 1.26rem);
    line-height: 1.42; letter-spacing: -0.006em; text-wrap: pretty;
  }
  .po-body p { break-inside: avoid; }

  /* ── WHAT I WORK ACROSS ─────────────────────────────────────────── */
  .po-lede { grid-column: 1 / span 5; grid-row: 3; margin: 0; }
  .po-list { grid-row: 4; border-top: 1px solid var(--po-rule); padding-top: 12px; }
  .po-list--0 { grid-column: 1 / span 4; }
  .po-list--1 { grid-column: 5 / span 4; }
  .po-list--2 { grid-column: 9 / span 4; }
  .po-list ul { list-style: none; margin: clamp(22px, 3.6vh, 40px) 0 0; padding: 0; }
  .po-list li {
    font-size: clamp(1.35rem, 2.2vw, 2.25rem); font-weight: 500;
    line-height: 1.1; letter-spacing: -0.028em;
  }

  /* ── HOW I WORK ─────────────────────────────────────────────────── */
  .po-steps { grid-column: 1 / -1; grid-row: 2; list-style: none; margin: 0; padding: 0; }
  .po-step {
    display: grid; grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gutter); align-items: start;
    border-top: 1px solid var(--po-rule);
    padding-block: clamp(18px, 3vh, 34px) clamp(40px, 7vh, 80px);
  }
  .po-step:first-child { border-top: 0; padding-top: 0; }
  .po-stepn { grid-column: 1 / span 2; padding-top: 0.5em; }
  .po-steptitle {
    grid-column: 3 / span 6; margin: 0;
    font-size: clamp(2rem, 4.2vw, 4.5rem); font-weight: 500;
    line-height: 0.98; letter-spacing: -0.038em; text-wrap: balance;
  }
  .po-steplines { grid-column: 9 / -1; padding-top: 0.45em; }
  .po-steplines p:last-child { margin-bottom: 0; }
  .po-ask { color: var(--po-grey); }

  /* ── WHAT I'M AFTER ─────────────────────────────────────────────── */
  .po-state--end {
    grid-column: 1 / -1;
    font-size: clamp(3rem, 8.6vw, 9.8rem); line-height: 0.9; letter-spacing: -0.052em;
  }
  .po-lede--end { grid-column: 7 / span 5; grid-row: 3; }

  @media (max-width: 820px) {
    .po-grid, .po-step { grid-template-columns: minmax(0, 1fr); row-gap: 28px; }
    .po-grid > *, .po-step > * { grid-column: 1 / -1 !important; grid-row: auto !important; }
    .po-body { columns: 1; }
    .po-step { row-gap: 14px; }
    .po-list ul { margin-top: 14px; }
  }

/* ══ MS3 · SMOKED ════════════════════════════════════════════════ */
  .rg .mvt.po-sec {
    background: color-mix(in srgb, var(--ground) 55%, transparent);
    -webkit-backdrop-filter: blur(7px);
    backdrop-filter: blur(7px);
  }
  /* The mat would put a hard-edged rectangle in the middle of a page whose
     whole point is that there is no edge. */
  .rg .ap__mat { display: none; }
  /* Where the pane cannot blur, it thickens instead. */
  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .rg .mvt.po-sec { background: color-mix(in srgb, var(--ground) 76%, transparent); }
  }
  /* A JUDGEMENT, NOT A FIX. I changed these expecting ab-d's #9B9B9B to fail
     here. Measured against the composited worst case it gives 5.71:1, which
     clears AA for small text with room to spare, so the grey was never in
     trouble. They are lifted anyway because a 12px label wants more presence
     over a picture than over flat ground — which is a taste, and is written
     down as one. */
  .rg .po-sec .po-label { color: var(--bone-dim); }
  .rg .po-sec .po-label--hi, .rg .po-sec .po-c1 { color: var(--bone); }


  /* ══ THE SMOKE ═══════════════════════════════════════════════════
     One registered number, inherited, driven by the opening's exit.
     Registration is what makes it interpolate; an unregistered custom
     property snaps at the halfway mark. */
  @property --smoke { syntax: '<number>'; inherits: true; initial-value: 1; }

  .rg { --smoke: 1; }
  @supports (animation-timeline: scroll(root block)) {
    @media (prefers-reduced-motion: no-preference) {
      .rg {
        animation: ms-smoke linear both;
        animation-timeline: scroll(root block);
        animation-range: 35vh 100vh;
      }
    }
  }
  @keyframes ms-smoke { from { --smoke: 0; } to { --smoke: 1; } }

  /* Nothing is ever laid over the bed in the opening. */
  .rg .ov { background: transparent; }

  /* ONE VALUE, THREE SECTIONS. */
  .rg .mvt.po-sec,
  .rg .mvt.sec--works,
  .rg .mvt.mvt--contact {
    background: color-mix(in srgb, var(--ground) calc(var(--smoke) * 55%), transparent);
  }
  .rg .mvt.sec--works, .rg .mvt.mvt--contact {
    -webkit-backdrop-filter: blur(7px); backdrop-filter: blur(7px);
  }
  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .rg .mvt.po-sec,
    .rg .mvt.sec--works,
    .rg .mvt.mvt--contact {
      background: color-mix(in srgb, var(--ground) calc(var(--smoke) * 76%), transparent);
    }
  }

  /* ══ CONTACT, IN THE POSTER'S FURNITURE ══════════════════════════
     The component's own grid is NOT touched: .ct__page keeps its two
     columns, .ct__head keeps its sticky 80vh left column, .divide keeps its
     hairline down the gutter. Only the type and the rules change. */
  .rg .sm-form { grid-column: 1 / -1; grid-row: 2; }
  .rg .sm-form :global(.ct__page) { padding-top: clamp(26px, 4.4vh, 52px); }

  /* The gutter rule joins the poster's hairline family. */
  .rg .sm-form :global(.divide) { background: var(--po-rule); }
  .rg .sm-form :global(.ct__rule) { border-top-color: var(--po-rule); }
  .rg .sm-form :global(.opt), .rg .sm-form :global(.pill) { border-color: var(--po-rule); }

  /* Mono out, the poster's 12px display-face label in. This is the one
     change that does most of the work: the posters above never set a word
     in the mono face, and the contact column was full of it. */
  .rg .sm-form :global(.mono--dim),
  .rg .sm-form :global(.ct__grouphead),
  .rg .sm-form :global(.q__n),
  .rg .sm-form :global(.q__hint) {
    font-family: var(--display); font-weight: 500;
    font-size: 12px; letter-spacing: 0.005em; text-transform: none;
    color: var(--po-grey);
  }
  .rg .sm-form :global(.ct__statement) { letter-spacing: -0.04em; }
  .rg .sm-form :global(.ct__lede) { color: var(--po-grey); }

.rg .sm-grid { row-gap: clamp(26px, 4.4vh, 52px); }
  @media (min-width: 901px) {
    /* The poster's own fold, not a half. */
    .rg .sm-form :global(.ct__page) { grid-template-columns: 5fr 7fr; }
    /* .divide is at left: 50%; the gutter is no longer there. Same
       arithmetic as the grid: (100% - gap) * 5/12 + half the gap. */
    .rg .sm-form :global(.divide) {
      left: calc((100% - 3.4em) * 0.41667 + 1.7em);
    }
  }


  /* ══ ONE PANE ════════════════════════════════════════════════════
     Registered so every one of these interpolates. An unregistered custom
     property snaps at the halfway mark, which on a blur radius is very
     visible and on a mask position is the whole effect lost. */
  @property --smoke { syntax: '<number>'; inherits: true; initial-value: 1; }
  @property --haze { syntax: '<length>'; inherits: true; initial-value: 7px; }
  @property --veil { syntax: '<percentage>'; inherits: true; initial-value: 100%; }
  @property --iris { syntax: '<percentage>'; inherits: true; initial-value: 0%; }

  .rg { --smoke: 1; --haze: 7px; --veil: 100%; --iris: 0%; }

  .sm {
    position: fixed; inset: 0; z-index: 1; pointer-events: none;
    background: color-mix(in srgb, var(--ground) calc(var(--smoke) * 55%), transparent);
    -webkit-backdrop-filter: blur(var(--haze));
    backdrop-filter: blur(var(--haze));
  }
  /* Where the pane cannot blur it thickens instead, so the page never loses
     the separation the blur was providing. */
  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .sm { background: color-mix(in srgb, var(--ground) calc(var(--smoke) * 76%), transparent); }
  }

  /* The sections hand their ground to the pane. The conveyor's own
     var(--ground) goes with them — it was the last opaque thing between the
     content and the bed. */
  .rg .mvt.po-sec,
  .rg .mvt.sec--works,
  .rg .mvt.mvt--contact {
    background: transparent;
    -webkit-backdrop-filter: none; backdrop-filter: none;
  }
  .rg .ov { background: transparent; }

  /* Reduced motion gets the destination, not the journey. */
  @media (prefers-reduced-motion: reduce) {
    .rg { --smoke: 1; --haze: 7px; --veil: 100%; --iris: 0%; }
  }

@supports (animation-timeline: scroll(root block)) {
    @media (prefers-reduced-motion: no-preference) {
      .rg {
        animation: sm-haze linear both, sm-ground linear both;
        animation-timeline: scroll(root block), scroll(root block);
        animation-range: 30vh 96vh, 30vh 104vh;
      }
    }
  }
  /* Soft first: full blur by 55 per cent of its own range. */
  @keyframes sm-haze {
    0%   { --haze: 0px; }
    55%  { --haze: 7px; }
    100% { --haze: 7px; }
  }
  /* Dark after: still at two fifths where the blur has finished. */
  @keyframes sm-ground {
    0%   { --smoke: 0; }
    55%  { --smoke: 0.4; }
    100% { --smoke: 1; }
  }


  /* ══ THE BLUR MOVES OFF THE BACKDROP ═════════════════════════════ */

  /* The pane keeps the ground and gives up the backdrop-filter. Its
     @supports fallback above raised the ground to 76 per cent when
     backdrop-filter was missing; that no longer applies to anything, and
     this rule is one class deeper so it wins in both branches. */
  .rg .sm {
    background: color-mix(in srgb, var(--ground) calc(var(--smoke) * 55%), transparent);
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
  }

  /* One filter for the whole bed: the grade the tiles were each running,
     plus the blur the pane was running on the backdrop. Rasterised once;
     --prog then only transforms the result. */
  /* Grade only. The blur is added below and only once it is earned, so a
     device that never runs the script, or never passes, still gets the
     page's full value range and simply loses its softness. */
  .rg .ms__bed {
    filter: brightness(0.30) saturate(0.7) contrast(1.05);
  }
  /* Thirty filtered surfaces down to none. */
  .rg .ms__tile { filter: none; }
  /* Except the one BED_GRADE names. Targeted on the inline custom property
     the bed markup already writes, so no markup changes: contrast composes
     multiplicatively, so 1.05 on the parent and 1/1.05 here is 1.0. */
  .rg .ms__tile[style*="--bed-k"] { filter: contrast(calc(var(--bed-k) / 1.05)); }

  /* The bed is inset -10% inside an overflow:hidden .ms__ground, so the
     blur's soft edge — about three times its radius — falls well outside
     the clip and no fringe can reach the viewport. */

/* ══ THE BLUR, ONCE EARNED ═══════════════════════════════
     Set by the probe above, which measures the device instead of reading
     its spec sheet. Opt-in on purpose: the failure direction is no blur,
     which is the state the page opens in anyway. */
  :root[data-blur] .rg .ms__bed {
    filter: brightness(0.30) saturate(0.7) contrast(1.05) blur(var(--haze));
  }

  /* ══ THE WORK'S NAME, FROM ab-ty2 ════════════════════════════════
     Applied 2026-09-20. The readout under the conveyor names the work you
     are looking at, and it was the one piece of type in Selected works that
     disagreed with the poster run about CASE.

     MEASURED, LIVE AGAINST ab-ty2, BEFORE CHANGING ANYTHING. The typeface
     was never the difference — both are Neue Haas Grotesk Display at 19.2px,
     weight 500, line-height 22.272, in the bone. What differs is two things:

         case       uppercase     ->  none
         tracking   -0.288px      ->  0.096px   (-0.015em -> 0.005em)

     Uppercase wants letters opened up and lowercase does not, which is why
     the negative tracking went with the capitals and why 0.005em comes back
     with them: it is the poster label's own value, and the name is a label
     for the work. Sentence case also matches every poster giant on the page,
     which are the only other place a title is set large.

     THE YEAR IS DELIBERATELY NOT TOUCHED. ab-ty2 also moves .rl__date off
     JetBrains Mono, but the note above it in this file argues the year
     should read as the third and smallest voice in the readout, and that is
     a separate decision from the one that was asked for here.

     :root, NOT .rg ALONE. This file has three <style> blocks and Astro does
     not emit them in written order — HANDOFF §6 — so a rule written last can
     still lose a tie. The two .rl__cap rules above are (0,1,0); this is
     (0,3,0) and cannot lose to them however the blocks are bundled. */
  :root .rg .rl__cap {
    letter-spacing: 0.005em;
    text-transform: none;
  }

  /* ══ CONTACT, FROM ab-ee1 · FITTED ══════════════════════════════
     Applied 2026-09-20. Typography only — nothing below sets display, grid,
     position, width or margin, and every one of the 24 selectors is scoped
     inside .sm-form, so no other section of the page can be reached by it.

     THE TWO STATEMENTS ARE SIZED BY MEASUREMENT, NOT BY CHOICE. That is the
     whole of this draft and the reason it was the one to take.

         "Let's talk."        3.969px of width per px of type
                              447px column  ->  112.6px   (8.8vw)
         "Send this enquiry"  8.736px per px
                              625px column  ->   71.5px   (5.59vw)

     Verified after: the greeting's ink measures 445 in its 447 column and
     the action's 618 in its 625. Both reach their edges; neither overhangs.
     The send's ratio is worth noting — ContactForm's own comment quotes
     8.71px per px, arrived at independently, and the measurement here says
     8.736. The same number.

     WHY FITTING RATHER THAN A SIZE THAT LOOKED RIGHT. Every giant in the
     About run is sized in vw until the screen crops it, which is fitting to
     the viewport. This is the same idea against a column instead. It also
     means these numbers can be re-derived rather than re-argued: change the
     copy or the column and the two ratios give the new sizes.

     ALL TWENTY-EIGHT ROUNDED CONTROLS MOVE TOGETHER, one step — 22 option
     pills, 5 field pills and the notes area — so the box you type into never
     reads smaller than the box you tap. 16px to 18.2, with padding in em so
     the box grows in proportion rather than staying 10px tall while the word
     gets bigger: 135x48 to 151x54, 119x44 to 132x50, 625x80 to 625x90.

     THE SEND PASSES ITS DOCUMENTED 44px CEILING, deliberately. That comment
     in ContactForm says 44 is the largest that lets "Name and email
     required" sit BESIDE the action on one row at 1440 — and says in the
     same breath that below about 1400 the pair wraps at any size and that
     flex-wrap handles it. At 1280 it already wraps. The note also moves off
     11px mono onto the 12px label here, which is narrower, so some of that
     row is bought back rather than only spent.

     AND THE FIELDS LEAVE INTER. They were the only Inter on the page — a
     third family inside a section whose neighbours use one. */

/* One family: the fields were Inter, the note and summary mono. */
  :root .rg .sm-form :global(.pill__in),
  :root .rg .sm-form :global(.send__note),
  :root .rg .sm-form :global(.send__ink),
  :root .rg .sm-form :global(.send__ink i),
  :root .rg .sm-form :global(summary),
  :root .rg .sm-form :global(.mono) {
    font-family: var(--display); font-variant-numeric: tabular-nums;
  }
  :root .rg .sm-form :global(.send__note),
  :root .rg .sm-form :global(.send__ink),
  :root .rg .sm-form :global(summary),
  :root .rg .sm-form :global(.ct__grouphead),
  :root .rg .sm-form :global(.q__n),
  :root .rg .sm-form :global(.q__hint),
  :root .rg .sm-form :global(.mono--dim) {
    font-size: 12px; font-weight: 500; letter-spacing: 0.005em;
    text-transform: none; color: var(--po-grey, #9B9B9B);
  }

  /* ══ ALL TWENTY-EIGHT ROUNDED BOXES, ONE STEP UP ═════════════════
     Options, fields and the notes area together, so the thing you type into
     never reads smaller than the thing you tap. Padding in em: the box grows
     with its word instead of staying 10px while the type does. */
  :root .rg .sm-form :global(.opt span),
  :root .rg .sm-form :global(.pill),
  :root .rg .sm-form :global(.pill__in) {
    font-size: clamp(1.05rem, 1.42vw, 1.2rem);
    letter-spacing: -0.008em;
  }
  :root .rg .sm-form :global(.opt span) { padding: 0.63em 1.06em; }
  :root .rg .sm-form :global(.pill) { padding: 0.63em 1.06em; }
  :root .rg .sm-form :global(.pill--area) { padding: 0.72em 1.1em; }

/* THE GREETING, SLIGHTLY LARGER, STILL ON ONE LINE.
     WHAT DECIDES THE WRAP IS THE LAYOUT WIDTH, NOT THE PAINTED INK, and
     the two are not the same here. "Let's talk." is eleven characters, so
     its layout box carries eleven letter-spaces while only ten fall
     between the glyphs. Solved from a measured painted 3.989px per px of
     size at -0.042em: the untracked advance is 4.409, the painted ink is
     4.409 + 10t and the LAYOUT ink 4.409 + 11t, which at -0.042em is
     3.947. So the line breaks the moment the size passes box / 3.947.

     IN ITS OWN COLUMN THERE IS NOTHING LEFT. 446.7 / 3.947 = 113.17px
     against the 112.64 it was already set at -- half a per cent, which is
     not a change. That is why the previous pass broke it over two lines:
     it was the only way to make it meaningfully bigger without moving
     something else.

     IT BORROWS NOTHING, AND IS SIZED BY THE PAINTED INK RATHER THAN THE
     LAYOUT BOX. Earlier passes widened the greeting's box with a negative
     right margin so it could reach into .ct__page's 54.4px column-gap --
     half of it, then a quarter. That margin is gone. column / 3.989 is
     the size at which the PAINTED ink lands exactly on the column edge --
     111.97px at 1280 -- and the 0.85 takes it 15 per cent below that.

     STILL GRID-TRACKED, JUST NOT FILLING. The factor multiplies the
     COLUMN, not a frozen pixel value, so the greeting stays a fixed
     proportion of its own column at every width rather than drifting:

       1280   column 446.7   95.18px   painted 379.7   67.0px of air
       1440   column 505.3  107.68px   painted 429.5   75.8px of air
       1024   column 352.8   75.18px   painted 299.9   52.9px of air
        901   column 307.7   65.57px   painted 261.5   46.2px of air

     -15.5 per cent on the 112.64 the greeting started at, one line at
     every width, and the gap to the form column is now the air in the
     column plus the whole 54.4px gutter -- 121.4px at 1280.

     THE LADDER, for whenever this moves again. Everything from 111.97 up
     is anchored to the grid; 0.85 of it is a chosen proportion:
       0.85 of the column               95.18px   -15.5% on the original
                                                  <- set here
       painted ink flush to the column 111.97px    -0.6%
       layout box flush                113.17px    +0.5%, painted
                                                   overhangs by 4.7px
       a quarter of the gutter         116.62px    +3.5%
       a third                         117.77px    +4.6%
       half                            120.07px    +6.6%
       the whole gutter                126.96px   painted overruns the
                                                  form column by 5.3px 

     Nothing else is touched: the tracking stays at -0.042em, and the 5fr
     7fr fold, which this file calls the poster's own fold rather than a
     half, stays as it is. Only the greeting's own box reaches past its
     column, and its right edge is ragged anyway -- it is one line ending
     in a full stop, aligned to nothing.

     Below 901 .ct__page collapses to one column, the greeting has the
     whole measure and the old clamp stands untouched. */
  :root .rg .sm-form :global(.ct__statement) {
    font-size: clamp(2.9rem, 8.8vw, 7.4rem); font-weight: 500;
    line-height: 0.96; letter-spacing: -0.042em;
  }
  @media (min-width: 901px) {
    :root .rg .sm-form :global(.ct__statement) {
      --lt-col: calc((100vw - 2 * var(--margin) - 3.4rem) * 5 / 12);
      font-size: calc(var(--lt-col) * 0.85 / 3.989);
      white-space: nowrap;
    }
  }
  /* THE SEND ACTION, SIZED FROM ITS COLUMN.
     It was clamp(2.2rem, 5.59vw, 5.9rem) -- 71.55px at 1280 -- under a
     comment claiming it filled the form column. It did not: "Send this
     enquiry" runs 7.3595px of ink per px of size, measured and constant
     across widths, so at 71.55 it was 526.5px of ink in a 625.3px column.
     0.842 of it, with 98.8px of slack.

     0.78 now, which is 66.28px at 1280 and 7.4 per cent down.

     DERIVED FROM THE COLUMN RATHER THAN FROZEN AS A vw, so the fraction
     holds at every width instead of drifting: .ct__page is 5fr 7fr above
     900 with a column-gap of 3.4em against an inherited 16px root, so the
     form's column is (measure - 54.4) x 7/12 and the size is that times
     0.78 over the ink constant.

     <- IT WAS MATCHING THE GREETING AND NO LONGER IS. "Let's talk." sits at
       0.85 of its own 5fr column; this sat at 0.842 of the 7fr one, so the
       two display lines in this section filled their columns to within a
       per cent of each other. That was either deliberate or a happy
       accident, and it is worth knowing which before this is taken further
       down -- the pair is now 0.85 against 0.78. */
  :root .rg .sm-form :global(.send__act) {
    font-size: clamp(2.2rem, 5.59vw, 5.9rem);
    line-height: 0.98; letter-spacing: -0.04em;
  }
  @media (min-width: 901px) {
    :root .rg .sm-form :global(.send__act) {
      --send-col: calc((100vw - 2 * var(--margin) - 3.4rem) * 7 / 12);
      font-size: calc(var(--send-col) * 0.78 / 7.3595);
    }
  }

  :root .rg .sm-form :global(.q__q) {
    font-size: clamp(1.35rem, 2.05vw, 1.75rem); font-weight: 500;
    line-height: 1.06; letter-spacing: -0.026em; color: var(--po-white, #FFF);
  }
  :root .rg .sm-form :global(.ct__direct a) {
    font-size: clamp(1.15rem, 1.6vw, 1.4rem); font-weight: 500; letter-spacing: -0.018em;
  }
  :root .rg .sm-form :global(.ct__lede) {
    font-size: clamp(1.05rem, 1.28vw, 1.26rem); line-height: 1.42;
    letter-spacing: -0.006em; color: var(--po-grey, #9B9B9B);
  }

  /* ══ THE OPENING VERSAL, FROM ab-vs4 ════════════════════════════
     Applied 2026-09-20. Only the letter — vs4's heading scale, question
     leading and second-voice colours are NOT brought across.

     CUT BY ARITHMETIC, NOT BY EYE. A cap spanning N lines runs from line
     one's cap-top to line N's baseline, so its height is
     (N-1) x line-height + one cap-height. The body leads at 1.42 and Neue
     Haas' cap-height is 0.6616 of its em — measured off the loaded file with
     canvas, not taken from a spec sheet. Two lines is 23.86 + 11.11 = 34.97px,
     and over the cap ratio that is 52.85px: 3.146em of the 16.8px body. The
     float's own height is then simply 0.6616em, its own cap, which is what
     makes two lines wrap around it.

     THE SHIFT IS MEASURED FOR THIS CAP AND IS NOT PORTABLE. The paragraph's
     ink top is fixed while the cap's grows with its size, so an em value
     correct at one cap is wrong at another — 0.4091em, borrowed from a
     three-line cap in another draft, left this one 0.23px high. 0.4135em
     puts it on its text. The glyph is placed by transform, which changes no
     layout, so being wrong costs a re-measure and not a re-flow.

     AND IT IS DOUBLED FOR SCREEN READERS. A floated letter read aloud is a
     letter, not a word: "I" then "'m Ugam" is two utterances of something
     that is one. The drawn cap is aria-hidden and the same character is
     repeated in a visually hidden span, so the sentence is spoken whole.
     Verified both ways — visible text and spoken text each unchanged. */
  :root .rg .po-versal-sr {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip-path: inset(50%); white-space: nowrap;
  }
  :root .rg .po-open .po-versal {
    float: left; font-size: 3.146em; height: 0.6616em;
    line-height: 0; font-weight: 500; letter-spacing: -0.03em;
    color: var(--po-white, #FFF); margin: 0 0.1em 0 0;
    --vs-shift: 0.4135em; transform: translateY(var(--vs-shift));
  }

  /* ══ THE READOUT'S TYPE, FROM ab-vx DIRECTION 02 · THE MEASURE ══════
     Applied 2026-09-21. Direction 2 derives every size from the About
     body's own line, 23.856px. The work's name takes 1.5 of those units,
     35.784px, on a 2-unit line of 47.712; the year takes half a unit,
     11.928, on a 1-unit line. Measured before: 19.2/22.272 and 10/10.6.

     THE READOUT DOES NOT MOVE. Direction 2 shows it at the grid's left
     edge, but that came from the shared floor in ab-vx, not from the
     Measure, and it was not what was asked for. .rl keeps left: 50% with
     translateX(-50%), text-align: center and its fixed width — which its
     own comment insists on, having measured the playhead run 61, 46.5, 32,
     55.5, 69, 72.5 and 127px down a scroll when the block was allowed to
     shrink-wrap.

     THE TRACKING IS NOT TAKEN. Direction 2 also tightens the name to
     -0.024em, which large type usually wants. 0.005em here is ab-ty2's,
     applied on 2026-09-20 and approved then; changing it was not part of
     this request, so it stands.

     THE RULER IS UNCHANGED, because the Measure does not change it: its
     42px height and its angular tick geometry are the same in direction 2
     as on the live page. */
  :root .rg .rl__cap {
    font-size: 35.784px;
    line-height: 47.712px;
  }
  :root .rg .rl__date {
    font-size: 11.928px;
    line-height: 23.856px;
  }
  /* .rl is min(720px, 72vw), and .rl__cap carries text-overflow: ellipsis,
     so a name wider than the block is truncated silently — which nothing
     does today and nothing should start doing here.

     MEASURED, AND THE FIRST NUMBER WAS WRONG. A canvas estimate put the
     longest of the sixteen titles at 411px; rendered, "Dinshaw's Dildaari
     Battles" is 437 — 26px more, because the estimate was fed the wrong
     letter-spacing sign. 437 needs 72vw, so it fits only above a 607px
     viewport, not the 572 the first breakpoint used: at 600 the title was
     measured truncating. The switch is at 640, which leaves 9px of margin
     at the narrowest width that still shows the large size. Below it the
     name keeps the 19.2 it has today, which fits all sixteen down to 375. */
  @media (max-width: 639px) {
    :root .rg .rl__cap { font-size: 19.2px; line-height: 22.272px; }
  }

  /* ══ THE READOUT SITS LOWER ═══════════════════════════════════
     Applied 2026-09-21. The name, the ruler and the year drop together.

     THE EXPRESSION IS NOT REWRITTEN, ONLY OFFSET. .rl's bottom is
     11vh + (1 - --lit) * 15vh + clamp(14px, 2.4vh, 30px), and its own
     comment explains why: the aperture's window is inset by the first two
     terms, and deriving the readout's offset from the same expression is
     what stops the two drifting apart when the window breathes. A new
     --rl-drop is SUBTRACTED from that rather than replacing it, so the
     lit-dependent behaviour is untouched and the whole block simply sits
     lower at every value of --lit.

     THERE WAS ROOM, AND THE MEASUREMENT SAYS WHERE. At 1280x800 the
     readout ran 1363 to 1493 inside a pin of 800 to 1600, with the first
     card ending at 1360 — a 3px gap above it and 107px of unused space
     below. Moving down opens the tight side and spends the loose one.

     AND ONE TERM IS GUARDING NOTHING. .ap__mat is display: none on this
     page — MS3 removed it, on the grounds that a hard-edged rectangle in
     the middle of a page whose whole point is that there is no edge was
     wrong. So the 11vh that clears the mat now clears an element that is
     not drawn. It is LEFT IN ANYWAY: the mat is hidden, not deleted, and
     re-deriving this offset from an element that may come back is a
     bigger change than was asked for. The drop is a clean subtraction on
     top of it. */
  /* THE DROP IS TWO THINGS, AND max() TAKES WHICHEVER IS LARGER.

     ONE, A DESIGN DROP: 2.6vh, which is 20.8px at 800 and puts the block
     midway between where it started (bottom 107.2) and where the first
     pass left it (65.6).

     TWO, A CLEARANCE, because the readout collides with the cards and
     always did. Measured with the drop removed, the gap above the first
     card is -26px at a 600 viewport height, -11 at 700, -3 at 760, +3 at
     800 and +31 at 900 — negative below roughly 790, which is not an
     unusual window, it is a 13-inch laptop with browser chrome. The
     shortfall closes at about 14.5px per 100px of height, so
     129px - 14.5vh is what is needed, and it reaches zero by itself once
     the layout has room.

     max() means the design drop governs wherever there is space and the
     clearance takes over where there is not — no height media query, and
     no pair of numbers that has to be kept in step by hand. */
  :root .rg .rl {
    --rl-drop: max(2.6vh, calc(129px - 14.5vh));
    bottom: calc(
      11vh + (1 - var(--lit, 1)) * 15vh
      + clamp(14px, 2.4vh, 30px)
      - var(--rl-drop)
    );
  }

  /* ══ THE ABOUT HEADINGS IN CAPITALS, FROM ab-uc1 ═══════════════════
     Applied 2026-09-21. The four headings set entirely uppercase, the way
     .fr__t in Selected works is, and resized so the composition does not
     move.

     THE RESIZE IS NOT COSMETIC. Measured before, the four render 1350.3,
     1349.9, 1356.3 and 1310.8px of ink at 1280 — one common width of about
     1.06 viewports, solved four times for four word-lengths, which is the
     system these headings are built on. Capitals do not widen a line by a
     constant: "Who I am" grows by 1.114, being already mostly caps and
     short words, while "What I work across" grows by 1.299. Uppercased at
     their old sizes the four would run 1504, 1753, 1700 and 1661 — a
     spread of 249px where there was 45, and the common width would be gone.

     So each size is SOLVED, not scaled: its own ink width divided by its
     own measured uppercase ink-per-pixel. Three of the four land on their
     own width to within 0.1px — 1349.9, 1356.3 and 1310.7.

     WHO I AM IS DELIBERATELY BELOW ITS SOLVED SIZE, applied from ab-uc1 on
     2026-09-21. Solving for width gave 23.673vw; it is set at 21.800.
     Equal ink width is not equal apparent size: WHO I AM is eight
     characters and WHAT I WORK ACROSS is eighteen, so holding both to
     1350px puts the first at 303px of type and the second at 130 — a 2.3
     to 1 difference in the size of an actual letter, which makes the
     shortest heading the loudest of the four however well the widths
     match. At 21.8vw it is 279.04px and 1243.4px of ink, 7.9 per cent
     under the other three, which reads as a correction to that rather
     than as a heading that has fallen out of the system.

     THE TRACKING COMES WITH THE CASE. .fr__t is uppercase at -0.045em;
     .po-giant was at -0.058, which is a lowercase setting — tight tracking
     suits a line broken up by ascenders and closes capitals into each
     other, caps having flatter sidebearings and nothing between them to
     hold the gap open. The sizes below are solved WITH -0.045em.

     THE PAN IS UNTOUCHED. po-pan is on .po-pan, the span inside each h2;
     this sets font-size, text-transform and letter-spacing on the h2. Its
     keyframes are in vw, 6 to -18, so it is independent of type size and
     travels exactly as far, at exactly the same rate, as before.

     Set as font-size rather than --gs, because --gs is written inline on
     each h2 and an inline custom property beats a stylesheet one. */
  :root .rg .po-giant {
    text-transform: uppercase;
    letter-spacing: -0.045em;
  }
  /* Solved for the common width this would be 23.673vw; see above. */
  :root .rg #r-who    { font-size: 21.800vw; }
  :root .rg #r-across { font-size: 10.162vw; }
  :root .rg #r-how    { font-size: 17.950vw; }
  :root .rg #r-close  { font-size: 13.853vw; }

  /* ══ THE MONO TEXT, IN THE PAGE'S OWN FACE — FROM ab-hn1 ══════════════
     Applied 2026-09-21. Every string that was rendering in JetBrains Mono
     Variable now sets in the display stack. Case and size are untouched:
     nothing lowercased, nothing resized, tracking left where it was.

     ELEVEN KINDS OF ELEMENT were in it, found by scanning the rendered
     page rather than by reading this stylesheet: the running head's four
     spans, the four corner labels twice over (the opening frame and
     works), the Scroll cue twice, the contact form's email preview, and
     one unclassed span. All inside .rg, and all resolving their family
     through var(--mono) — so redefining that one property switches every
     one of them and cannot miss a rule naming the stack directly, because
     none does.

     var(--display), NOT A LITERAL "Helvetica Neue", so these labels are
     declared exactly as the rest of the page is. Measured, the named
     "Neue Haas Grotesk Display" sets a test string at 702.69px — the same
     as a deliberately invented family name — while "Helvetica Neue" gives
     781.7 and the page gives 781.7, so on this machine it renders
     Helvetica Neue. On a machine that HAS Neue Haas installed these
     labels follow the page into it; naming the fallback directly would
     pin them there while everything around them moved.

     THE WIDTH CHANGE IS NOT A UNIFORM NARROWING. At a fixed 10px the
     opening frame's labels measured 53.2 to 56.0, 121.6 to 126.7, 83.6 to
     77.6 and 106.4 to 112.4px: two grow and two shrink, because mono
     digits are wide and mono capitals relatively narrow. The label
     carrying "00/06 2025 — 2026" loses 6px and the one carrying "SELECTED
     WORKS" gains 6. All four are absolutely positioned in corners, so
     nothing else moves.

     ← .peek__body IS INCLUDED AND IS THE ONE TO RECONSIDER. It is a <pre>
       holding the contact form's email preview, where a monospace face
       was arguably doing semantic work — it read as a mail client because
       it was set like one. Changed here because the request was the whole
       page; recorded because it is the one place the mono carried meaning
       rather than style, and exempting it is one selector. */
  :root .rg { --mono: var(--display); }

  /* ══ THE EMAIL, LOWERCASE AND IN HELVETICA NEUE ═══════════════════
     Applied 2026-09-21. It was already RENDERING Helvetica Neue — measured,
     its stack sets a test string at 781.7px, "Helvetica Neue" alone gives
     781.7, and the named "Neue Haas Grotesk Display" gives 702.69, the
     same as an invented family name — so only the case actually changes
     here. The family is named outright anyway, so the intent survives a
     future change to --mono. Reached with :global() because .ft__mail
     belongs to ContactForm, which is shared with the work pages and is
     never edited from this file. */
  :root .rg .sm-form :global(.ft__mail) {
    text-transform: none;
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
  }

  /* ══ SELECTED WORKS, WHOLLY ON SCREEN AND PARTLY UNDER THE WORK ═══
     Applied 2026-09-21 from preview/ab-wh3e, THE LINTEL, chosen from four.

     WHAT IT WAS. The heading at clamp(1.5rem, min(6vw, 8vh), 4.2rem) —
     67.2px at 1280 — small enough to sit inside the frame with room to
     spare, and painted OVER the conveyor at z-index 6.

     WHAT IT IS NOW. The size is declared from the GRID rather than as a vw
     number: the word is NINE of the twelve columns wide, so it gives up
     three columns and their gutters. 97.83px and 839.7px of ink at 1280,
     measured against a nine-column span of 839.7, and 7.643vw at every
     desktop width. It sits behind the stills, and the top of the card
     band cuts across its feet.

     THE COLUMNS IT GIVES UP ARE SPLIT, NOT HUNG AT ONE END. .mvt sets
     text-align: center and .fr inherits it, so the word stays centred on
     the measure and the 286.7px it no longer fills opens as 143.36px at
     each side. Worth stating because "eleven
     of twelve columns" sounds like a left-aligned word ending a column
     short, and it is not.

     IT WAS THE FULL MEASURE UNTIL 2026-09-22 -- 131.24px, 1126.4px of ink,
     flush to both margins. Taking it to eleven columns is 8.5 per cent
     down and, because the column is itself derived from the measure and
     the gutter, it is the same 8.5 per cent at every width rather than a
     ratio that drifts: 120.10px at 1280, 96.08 at 1024, 34.81 at 375.

     THE BITE LOOKS AFTER ITSELF. top is calculated FROM --wk-size, not set
     beside it, so shrinking the size moves the frame down by exactly the
     amount that keeps the card band cutting the same fraction of the cap.
     The cap goes 95.93 -> 87.79px and the bite 19.19 -> 17.56px, both 0.20
     of the cap. Nothing about the overlap had to be re-solved.

     THE INK CONSTANT IS 8.583px OF PAINTED INK PER PIXEL OF SIZE, and the
     arithmetic is worth writing down because the obvious version is wrong.
     "SELECTED WORKS" is fourteen characters and the canvas sets it at 9.168
     per px untracked; -0.045em takes 0.045 off per spacing. Measured with
     letter-spacing toggled off and on, the layout box moves by 96.77px =
     14 x 6.912 exactly — so all FOURTEEN spacings are inside the box. But
     the trailing one pulls the box in while the final K still paints out to
     where it was, so the INK loses only thirteen: 9.168 - 13 x 0.045 =
     8.583. 8.538 is the box; 8.583 is what you can see. At this size the
     difference is one clipped letter, which is why it is spelled out.

     THE TRAILING SPACE IS PAID BACK. .mvt sets text-align: center (line
     1787) and .fr inherits it, so the word is centred — and the box that
     centring uses is 0.045em narrower than the ink. That puts the painted
     word half of that, 0.0225em or 2.95px here, RIGHT of true centre:
     overhanging the right margin with a gap at the left. It did this before
     this change as well, at the old size, where it was too small to notice.
     padding-right: 0.045em makes the box as wide as the ink again, so what
     gets centred is what you can see.

     Z-INDEX 0 IS WHAT PUTS THE TYPE BEHIND THE WORK. .wcard carries
     z-index 100 and .fr--over only 6, which looks as though the cards
     already win. They do not: .wk__pin is position: sticky, and sticky
     ALWAYS creates a stacking context, so the cards' 100 is scoped inside
     the pin and never competes with the frame. What competes is the pin's
     own z-index, which is auto. Dropping .fr--over from 6 to 0 puts it
     level with the pin, and the pin comes later in the document, so the
     work paints over the word.

     THE VERTICAL PUSH, AND WHY THE ANCHOR IS NOT 30vh. Z-index alone
     changed nothing, because the heading's baseline was TANGENT to the top
     of the card band: 880 + 40 + 0.78 x 153.6 = 1039.81 against 1040.000,
     two tenths of a pixel. The word CLEARED the stills. So the frame comes
     down. A card is min(40vh, 26vw) x --card-k placed top: 50% and pulled
     back half its height, so the common card's top edge is
     50vh - min(20vh, 13vw). That equals 30vh ONLY at 1280 x 800, where
     26vw and 40vh cross; anchored to a flat 30vh the bite measured
     -11.94px at 1024 — the word clear of the work all over again. With
     .fr's clamp(30px, 5vh, 66px) of top padding, a baseline 0.78em below
     the content top (line-height 0.8 against a 1.20em font box) and a cap
     of 0.731em, a bite of beta cap heights is
         top = 50vh - min(20vh, 13vw) - pad - s (0.78 - 0.731 beta)
     and beta is 0.20 here: 19.2px of a 95.9px cap, four fifths of the
     letter still showing. Measured 19.4, 19.5, 19.6 and 19.4 per cent at
     1280x800, 1024x800, 1440x900 and 1280x700.

     ← THE BITE IS NOT UNIFORM ACROSS THE RUN, which is the conveyor's
       design rather than a fault here. --card-k enlarges anything narrower
       than a square by ratio^-0.75, so a 9:16 work stands 492.7px tall
       against the common 320 and its top edge reaches 153.6px — above the
       cap top. The figure above is the bite against the COMMON height,
       twelve of the sixteen works. When one of the four verticals passes it
       cuts deeper, through a 277px-wide slice of the word rather than all
       of it.

     THE PUSH IS ABOVE 900px ONLY: below that .wk__pin goes position: static
     and .fr loses its padding-inline, so there is no pinned band to be
     behind. The SIZE still applies there, which is what keeps the word on
     screen on a phone — 34.81px at 375, 298.7px of ink into a measure of
     327.0px. The eleven-column span there computes to 298.0 and the ink
     lands 0.7px over it, because --gutter is on its 12px clamp floor at
     that width rather than on 1.6vw; it still leaves 14.14px of air each
     side, so nothing is at risk.

     ← overflow-x: clip ON .sec--works IS A GUARD, NOT LOAD-BEARING. It was
       load-bearing in ab-wh3, where the heading ran 159px off the right of
       the screen; at this size nothing overruns, and the conveyor's own
       horizontal excess is already contained by .wk__pin's overflow: hidden.
       It is carried over because it is what was verified, and because clip
       on one axis leaves the other visible and so does not make a scroll
       container that would break the pin — checked: .wk__pin still sticks,
       the cards hold at 240 while the frame rises past them. */
  :root .rg .sec--works { overflow-x: clip; }

  :root .rg .fr--over {
    /* NINE of the twelve columns: the measure, less three columns and
       their gutters, over the ink constant. The column is derived here
       rather than assumed so it tracks --gutter's own clamp. It was the
       full measure until 2026-09-22, then eleven, then ten, now nine --
       each step is exactly one column, which is why the reduction is the
       same fraction at every width instead of a ratio that drifts. */
    --wk-measure: calc(100vw - 2 * var(--margin));
    --wk-col: calc((var(--wk-measure) - 11 * var(--gutter)) / 12);
    --wk-size: calc((var(--wk-measure) - 3 * (var(--wk-col) + var(--gutter))) / 8.583);
    z-index: 0;
    padding-inline: 0;
  }
  :root .rg .fr--over .fr__t {
    font-size: var(--wk-size);
    line-height: 0.8;
    white-space: nowrap;
    margin: 0;
    padding-right: 0.045em;
  }

  @media (min-width: 901px) {
    :root .rg .fr--over {
      top: calc(50vh - min(20vh, 13vw) - clamp(30px, 5vh, 66px) - var(--wk-size) * 0.6338);
    }
  }

  /* ══ THE NUMBERING SYSTEM, AND THE HOW I WORK SPREAD ══════════
     Applied 2026-09-22 from four drafts in one pass: the section numbers
     from ab-sy4, the How I work body layout from ab-fs1, the three step
     numbers from ab-nm1, and the About body-text drift from ab-mo6. The
     page exactly as it stood before is kept at preview/ab-live-prior.

     THE DIM FLOOR, WHICH GOVERNS ALL OF IT. These labels sit over the
     smoked mosaic, whose brightest frame this file already records as
     #4C4C4C: --bone 8.59:1, --bone-dim 6.02:1, #C0C0C0 4.72:1 (AA for
     12px), #A8A8A8 3.61:1 and --po-grey 3.09:1 both failing. */

  /* ── 1 · THE SECTION NUMBERS, from ab-sy4 ────────────────────
     Bigger and lighter: 18px at weight 100 against 12px at 500. The axis
     is real and it is not obvious, because the digits are TABULAR -- the
     advance is 111.2 per 100px at every weight from 100 to 900, so width
     proves nothing. Rendering "02" to a canvas and integrating the alpha
     at the ACTUAL sizes (scaling a 100px sample by area does not work;
     antialiasing and hinting are not linear) gives 57 units here against
     65 as it was: an eighth less ink at one and a half times the size.
     Weight 900 is never worth asking for in this face -- it renders
     identically to 700, same ink to the unit.

     Set at --bone-dim, not the quiet grey: contrast ratio counts
     luminance and not stroke width, and a 100-weight hairline needs the
     6.02:1 to survive a bright frame behind it. */
  :root .rg .po-sec .po-c1,
  :root .rg .sec--works .wk-no {
    font-size: 18px;
    font-weight: 100;
    letter-spacing: 0.06em;
    line-height: 1.1;
    color: var(--bone-dim);
  }

  /* ← 01 IS PUT BACK ON SELECTED WORKS. Removing the four corner labels
     took it with them, so the page counted 00, --, 02, 03, 04, 05, 06.
     One absolutely positioned <p>, clear of the heading: the frame's top
     is 116.823px and this sits at 40. THIS IS THE ONE PIECE OF CONTENT
     ADDED; delete the <p> and this rule and nothing else is affected. */
  :root .rg .sec--works .wk-no {
    position: absolute;
    top: clamp(30px, 5vh, 66px);
    left: var(--margin);
    z-index: 7;
    margin: 0;
  }

  /* ── 2 · HOW I WORK KEEPS ITS ORIGINAL LAYOUT ───────────────
     ab-fs1's verso/recto spread was applied here and is now reverted, so
     the step is back to the base sheet: .po-stepn at 1 / span 2,
     .po-steptitle at 3 / span 6, .po-steplines at 9 / -1, and no gutter
     rule. Nothing is left behind -- the border, the half-gutter margin and
     padding, the .po-step::after that drew the rule for one pass, and the
     820px cancel that went with it have all gone. The step numbers in item
     3 below are unaffected: they were never fs1's. */

  /* ── 3 · THE THREE STEP NUMBERS, from ab-nq6 ────────────────
     THE RECESSION. The figure is half the step title's rank and it gets
     QUIETER as the step is read: opacity 0.85 while the step is arriving,
     0.25 as it passes the middle of the screen, 0.85 again as it leaves.

     An inversion of what motion usually does. The number is an aid on
     approach -- it says where you are in the process before you have
     started reading -- and then withdraws while the words have your
     attention, which is the one moment it has no job to do.

     WAS ab-nm1: the title's own clamp, 53.76px, baselines coincident. That
     was a good solution and a flat one, the number and the title being the
     same size, weight and white side by side. This is half the size and
     never at full strength.

     .po-stepn also carries .po-label--hi, which .rg colours at (0,3,0).
     This selector is (1,3,0) -- an id beats any number of classes -- so it
     wins on specificity rather than on order, which matters because the
     blocks in this file are not emitted in the order they are written.

     ← THE TROUGH IS BELOW THE CONTRAST FLOOR, and it is worth knowing.
       Opacity composites the figure with whatever is behind it, so the
       effective tone is not --bone. Against the brightest frame the mosaic
       can produce (#4C4C4C, the figure this file already records) the
       number measures about 6.8:1 at 0.85, 3.9:1 at the resting 0.55 and
       roughly 2.0:1 at the 0.25 trough -- so at the bottom of the cycle it
       is under the 3:1 that applies to text this size. It is transient, it
       is a locator rather than content, and the scrim over the bed makes
       the real ground darker than the worst case; but if the trough should
       hold 3:1 against even the brightest still, 0.25 becomes 0.43 in the
       keyframes below and nothing else changes. */
  :root .rg #philosophy .po-step {
    view-timeline-name: --nq;
    view-timeline-axis: block;
  }
  :root .rg #philosophy .po-stepn {
    font-size: calc(0.5 * clamp(2rem, 4.2vw, 4.5rem));
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1;
    padding-top: 0.3em;
    color: var(--bone);
    opacity: 0.55;
  }

  /* Guarded twice: @supports because a browser without scroll-driven
     timelines would otherwise hold the from-state and park the figure at
     0.85 for good, and prefers-reduced-motion because this is motion
     nobody asked for. Either way it falls back to the 0.55 resting value
     declared above. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      :root .rg #philosophy .po-stepn {
        animation: nq-recede linear both;
        animation-timeline: --nq;
        animation-range: cover 0% cover 100%;
      }
    }
  }
  @keyframes nq-recede {
    0%   { opacity: 0.85; }
    50%  { opacity: 0.25; }
    100% { opacity: 0.85; }
  }

  /* Below 820 the step is one column, the figure stacks above its title
     and there is no reading position to recede from. Full strength, at a
     size that suits one column, in the quiet grey rather than white. */
  @media (max-width: 820px) {
    :root .rg #philosophy .po-stepn {
      font-size: clamp(1.4rem, 6vw, 2rem);
      padding-top: 0;
      opacity: 1;
      animation: none;
      color: #C0C0C0;
    }
  }

  /* ── 4 · THE ABOUT BODY TEXT, from ab-mo6 ──────────────────
     A counter-scroll: the body drifts 32px against the page across its own
     cover range. The HEADINGS ARE NOT TOUCHED -- mo6 also restyles
     .po-giant and moves .po-body to the full measure, and neither is
     brought across; only the animation is.

     The three selectors are mo6's own and between them they are the body
     text of all four About movements: .po-body is Who I am, .po-lede is
     What I work across and, via .po-lede--end, What I'm after, and
     .po-steplines is How I work.

     .po-steplines WAS TAKEN OUT OF THIS LIST for one pass, while How I
     work carried fs1's gutter rule as a border on that same element --
     animating it would have swung the hairline 32px across a 20.48px
     gutter. The rule is gone with the layout, so there is nothing left for
     the drift to carry and the element is back.

     Guarded twice. @supports because a browser without scroll-driven
     timelines would otherwise hold the from-state and leave the text
     parked 16px to the left; and prefers-reduced-motion because this is
     motion nobody asked for. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      :root .rg .po-body,
      :root .rg .po-lede,
      :root .rg .po-steplines {
        animation: mo6-counter linear both;
        animation-timeline: view();
        animation-range: cover;
      }
    }
  }
  @keyframes mo6-counter {
    from { transform: translateX(-16px); }
    to   { transform: translateX(16px); }
  }

  /* ══ THE THREE QUESTIONS IN FIND THE LANGUAGE ════════════════
     Applied 2026-09-22. "What does it feel like? What is its texture? What
     does it leave unsaid?" is ONE line in the data; clauses() splits it on
     the question marks and asks() tags each piece, so the three arrive as
     three <p class="po-ask"> in a row. Every paragraph in .po-steplines
     carries margin: 0 0 1em, which put a uniform 16.8px between all five
     paragraphs of the step -- measured -- so the questions read as three
     separate statements rather than as one asked in three ways.

     TIGHTENED ONLY BETWEEN THEMSELVES. :has(+ .po-ask) matches a question
     that is FOLLOWED by a question, which is the first two and not the
     third, so the 16.8px above "What does it feel like?" (owned by the
     paragraph before it) and the 16.8px below "What does it leave unsaid?"
     (owned by the third question) are both untouched. 0.25em is 4.2px, so
     the three lines sit 28.06px apart against 40.66px before. :has() is
     supported here -- checked with CSS.supports('selector(...)') rather
     than assumed.

     ITALIC IS A REAL FACE, NOT A SLANT. The stack falls through to
     Helvetica Neue, which has a true Italic: the advance for "What does it
     feel like?" is 390.4px italic against 393.4px roman at 40px, and a
     synthetic oblique is a pure shear that leaves advances identical. So
     this is the drawn face.

     ← AND THE COLOUR IS LIFTED, which was not asked for. .po-ask sits at
       --po-grey, #9B9B9B, which measures 3.09:1 against the brightest
       frame the mosaic can produce (#4C4C4C) and fails AA -- the only text
       on the page below the floor. Since the request is to make these
       stand out, #C0C0C0 takes them to 4.72:1 while still reading quieter
       than the #FFFFFF body around them. Drop this one declaration to keep
       the old grey. */
  :root .rg .po-steplines .po-ask {
    font-style: italic;
    color: #C0C0C0;
  }
  :root .rg .po-steplines .po-ask:has(+ .po-ask) {
    margin-bottom: 0.25em;
  }

  /* ══ HV3 · THE CURSOR ═════════════════════════════════════════════
     :root on every selector for the reason HANDOFF §6 gives.

     The mosaic bed is fixed behind this section and this block travels over
     the pictures as well, so the type carries .cn's two-part shadow.
     Against the brightest frame the graded bed can produce (#4C4C4C):
     --bone 8.59:1, --bone-dim 6.02:1; --muted (2.65:1) and --dim (2.33:1)
     are not used. */
  :root .rg .hv3 {
    position: absolute; top: 0; left: 0;
    z-index: 200; pointer-events: none;
    transform: translate(var(--hv-x, 0px), var(--hv-y, 0px));
    opacity: 0; visibility: hidden;
    transition: opacity 110ms linear, visibility 0s linear 110ms;
  }
  :root .rg .sec--works.is-hv .hv3 {
    opacity: 1; visibility: visible;
    transition: opacity 110ms linear, visibility 0s;
  }
  :root .rg .hv3__rows {
    position: absolute; top: 0; left: 30px;
    display: grid; row-gap: 3px; white-space: nowrap;
  }
  :root .rg .hv3.is-flipped .hv3__rows {
    left: auto; right: 30px; text-align: right;
  }
  /* Never allowed to collapse to its own wrap point: the flip is decided
     from this box's width, so the width has to be the one the reading
     actually needs. */
  :root .rg .hv3__rows { width: max-content; }
  :root .rg .hv3__tick {
    position: absolute; top: 6px; left: 6px;
    width: 12px; height: 1px; background: var(--bone-dim);
    box-shadow: 0 0 10px rgba(10, 9, 8, 0.95);
  }
  :root .rg .hv3.is-flipped .hv3__tick { left: auto; right: 6px; }
  :root .rg .hv3__r {
    display: flex; align-items: baseline; column-gap: 9px;
  }
  :root .rg .hv3.is-flipped .hv3__r { flex-direction: row-reverse; }
  :root .rg .hv3__r[hidden] { display: none; }
  :root .rg .hv3__l {
    font-family: var(--mono); font-size: 9px;
    letter-spacing: 0.16em; text-transform: uppercase;
    color: var(--bone-dim); line-height: 1.5;
    text-shadow: 0 1px 3px var(--ground), 0 0 12px rgba(10, 9, 8, 0.95);
  }
  :root .rg .hv3__v {
    font-family: var(--display); font-weight: 500; font-size: 12px;
    letter-spacing: 0.005em; color: var(--bone); line-height: 1.5;
    text-shadow: 0 1px 3px var(--ground), 0 0 12px rgba(10, 9, 8, 0.95);
  }
  @media (prefers-reduced-motion: reduce) {
    :root .rg .hv3, :root .rg .sec--works.is-hv .hv3 { transition: none; }
  }
  @media (max-width: 900px) { :root .rg .hv3 { display: none; } }
</style>
