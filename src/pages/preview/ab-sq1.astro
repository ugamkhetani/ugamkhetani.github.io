---
/**
 * SQ1 · THE SPREADS — six compositions, and the scroll cuts between them.
 *
 * THE IDEA: a gallery gives every picture the same frame and lets the reader
 * decide the pace. A magazine does the opposite — somebody sized every image,
 * chose every margin, and decided which picture gets a whole page and which
 * shares one. This section is six SPREADS, each a full viewport, each
 * composed on its own and not from a system. The eight frames are distributed
 * across them unevenly because that is what an art director does.
 *
 * SCROLL IS THE PAGE TURN. Proximity snap on the document means each spread
 * settles rather than drifting, so moving down the section feels like turning
 * leaves rather than sliding a surface. Proximity and not mandatory, because a
 * reader who wants to scroll past should be allowed to.
 *
 * THE SIX ARE DELIBERATELY UNALIKE: a full bleed with the type reversed into
 * the picture; a half-page with a column of metadata and a great deal of air;
 * a pause — the darkest frame in the film, set small and centred over a
 * single line, with a hairline so that it still has an edge; a tall offset
 * pair with the type running vertically in the gutter; a split page; and a
 * close that lets two frames overlap.
 *
 * HOVER IS THE TYPE GETTING OUT OF THE WAY. Rest on any frame and that
 * spread's typography drops to a fifth while the frame's own caption comes
 * up. Nothing moves and nothing is covered — the page simply decides, for as
 * long as you are looking, that you came for the picture.
 */
import Base from '../../layouts/Base.astro';
import OpNav from '../../components/OpNav.astro';
import { Image, getImage } from 'astro:assets';
import { getCollection } from 'astro:content';
import { framesFor } from '../../lib/frames';
import { href } from '../../lib/href';

/* THE REAL WORK AND THE REAL STILLS, and the work page's own harness around
   them, so the only variable between ab-sq1 and ab-sq8 is the section below
   the "03 · Stills" rule.

   NOTHING ON THESE PAGES IS CLICKABLE. The brief for this round is scroll and
   hover only: no buttons, no controls, no navigation, nothing draggable. Every
   state is either a function of scroll position or a CSS :hover. If you find
   a cursor:pointer in here it is a mistake.

   THE PRODUCTION PAGE IS NOT TOUCHED — src/pages/work/[slug].astro is
   untouched by all eight, and `withoutPreview()` keeps these out of the
   built site. */
const works = await getCollection('works');
const work = works.find((w) => w.id === 'aasha')!;
const d = work.data;
const images = framesFor('aasha', d.frames);
const LEDE = (d.description.trim().match(/^[^.!?]+[.!?]/) ?? [d.description.trim()])[0];
const ROLES = d.role.split('·').map((r) => r.trim());
const nn = (i: number) => String(i + 1).padStart(2, '0');
/* `awards` is {text, star?}[], not a string. */
const AWARDS = (d.awards ?? []).map((a: { text: string }) => a.text).join(' · ');

/* Optimised URLs for the drafts that need a frame inside a CSS property — a
   background, a band, a blended layer — where <Image> cannot reach. */
const WEB = await Promise.all(
  images.map((src) => getImage({ src, width: 1400, format: 'webp', quality: 80 })),
);

/* MEASURED FROM THE FILES, NOT ASSERTED. Mean luminance of each frame, read
   off a 128x96 canvas by ab-xp1 and reproduced independently by ab-xp7 — the
   two agree to three decimals. Several drafts in this round art-direct from
   it (which frame is big, which is held longest, what order the composite
   resolves in), so it is recorded here rather than re-derived at runtime:
   these eight do no work in the browser that scroll and hover do not need.
      01 .147   02 .179   03 .078   04 .075
      05 .338   06 .214   07 .159   08 .313
   The film never exceeds .489 anywhere, and 03 and 04 are the floor. */
const LUMA = [0.147, 0.179, 0.078, 0.075, 0.338, 0.214, 0.159, 0.313];

const DRAFTS: [string, string, string][] = [
  ['sq1', 'The spreads', 'Six compositions, cut between'],
  ['sq2', 'The composite', 'Eight at once, then apart'],
  ['sq3', 'The duration', 'Editing is how long you hold'],
  ['sq4', 'The pan', 'Scroll is a camera move'],
  ['sq5', 'The stack', 'Every frame you passed is still there'],
  ['sq6', 'The continuity', 'One image from three films'],
  ['sq7', 'The spine', 'A single rule holds the page'],
  ['sq8', 'The approach', 'The pictures take the page'],
];
const ME = 'sq1';
const MINE = DRAFTS.find(([id]) => id === ME)!;

/* <- MY DISTRIBUTION AND MY COMPOSITIONS, not anything the documents state.
   Six spreads over eight frames: 07 alone, 01 alone, 03 alone, 02 with 04,
   05 alone, 06 with 08. The pause on 03 and the close on 06+08 are editorial
   decisions about this set, taken from what is in the pictures and from the
   measured luminance in LUMA above — 03 is the floor of the film at .078 and
   makes the quietest page; 06 and 08 are its two brightest late frames. */
const SPREADS: { k: string; f: number[]; t: string }[] = [
  { k: 'bleed', f: [6], t: 'The room' },
  { k: 'half', f: [0], t: 'A face, turned to the lens' },
  { k: 'pause', f: [2], t: 'The quietest frame in the film' },
  { k: 'tall', f: [1, 3], t: 'Reflected, and watched' },
  { k: 'split', f: [4], t: 'Light through the slats' },
  { k: 'close', f: [5, 7], t: 'Laughing, and the window' },
];
---

<Base title={`${d.title} · ${MINE[1]} — stills ${ME.toUpperCase()}`} description={`An editorial direction for the stills section of the Aasha project page: ${MINE[2]}.`}>
  <OpNav variant="bracket" base={href()} />

  <nav class="sw" aria-label="Stills drafts">
    <span class="sw__id">{ME.toUpperCase()}</span>
    <span class="sw__nm">{MINE[1]}</span>
    <span class="sw__su">{MINE[2]}</span>
    <span class="sw__set">
      {DRAFTS.map(([id, name, sub]) => (
        <a class:list={['sw__i', { 'is-here': id === ME }]} href={href(`preview/ab-${id}`)}
          title={`${name} — ${sub}`} aria-current={id === ME ? 'page' : undefined}>{id.slice(2)}</a>
      ))}
      <a class="sw__prev" href={href('preview/ab-st1')} title="Round one — eight arrangements">ST</a>
      <a class="sw__prev" href={href('preview/ab-xp1')} title="Round two — eight interactions">XP</a>
    </span>
  </nav>

  <article class="sc" style={`--ar:${d.ratio.replace(':', ' / ')}`}>
    <header class="hd">
      <p class="mono hd__over">{d.category} · {d.year}</p>
      <h1 class="hd__t">{d.title}</h1>
      <p class="mono hd__meta"><span class="hd__roles">{ROLES.map((r) => <span>{r}</span>)}</span></p>
    </header>

    {d.quote && (
      <section class="q" aria-label="Statement">
        <p class="q__t">{d.quote}</p>
      </section>
    )}

    <section class="blk body" aria-label="About">
      <p class="body__lede" style={`--n:${LEDE.length}`}>{LEDE}</p>
    </section>

    <!-- ══ 03 · STILLS — THE DRAFT ═══════════════════════════════════ -->
    <section class="blk st" aria-label="Stills">
      <p class="mono st__lbl"><span>03</span><i aria-hidden="true"></i><span>Stills · {MINE[1]}</span></p>
      <div class="sp" data-sp>
        {SPREADS.map((s, k) => (
          <section class:list={['sp__s', `sp--${s.k}`]} data-sp-s={k} aria-label={`Spread ${k + 1}`}>
            <div class="sp__art">
              {s.f.map((fi, j) => (
                <figure class="sp__f" style={`--j:${j}`}>
                  <Image src={images[fi]} alt={fi === 0 ? d.alt : ''} aria-hidden={fi === 0 ? undefined : 'true'}
                    widths={[520, 900, 1400, 1900]} sizes="(max-width: 760px) 94vw, 62vw"
                    loading={k < 2 ? 'eager' : 'lazy'} decoding="async" />
                  <figcaption class="mono sp__cap"><b>{nn(fi)}</b><span>{d.ratio} · luma {LUMA[fi].toFixed(3)}</span></figcaption>
                </figure>
              ))}
            </div>
            <div class="sp__type" data-reveal>
              <p class="mono sp__no">{String(k + 1).padStart(2, '0')} / {String(SPREADS.length).padStart(2, '0')}</p>
              <p class="sp__t">{s.t}</p>
              <p class="mono sp__sub">{s.f.map((fi) => nn(fi)).join(' · ')}</p>
            </div>
          </section>
        ))}

        <p class="mono note">
          <em>Six spreads · the scroll turns the page</em>
          <i aria-hidden="true"></i>
          <span>Rest on a frame and the type stands down</span>
        </p>
      </div>
    </section>

    <footer class="cl">
      <hr class="rule" />
      <p class="mono cl__p"><span>{MINE[0].toUpperCase()} · {MINE[1]}</span><i aria-hidden="true"></i><span>{AWARDS}</span></p>
    </footer>
  </article>
</Base>

<style>
  /* ══ THE HARNESS ═══════════════════════════════════════════════════
     The work page's own type and rhythm, shared verbatim by all eight. */
  .sw {
    position: fixed; inset: 0 0 auto; z-index: 900;
    display: flex; align-items: baseline; gap: 12px;
    padding: 9px clamp(16px, 4vw, 40px);
    background: color-mix(in srgb, var(--ground) 86%, transparent);
    backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--rule);
    font-family: var(--mono); font-size: var(--t-micro);
    letter-spacing: 0.16em; text-transform: uppercase;
  }
  .sw__id { color: var(--accent); }
  .sw__nm { color: var(--bone); }
  .sw__su { color: var(--dim); margin-right: auto; }
  .sw__set { display: flex; gap: 1px; align-items: baseline; }
  .sw__i { color: var(--dim); text-decoration: none; padding: 3px 7px; border: 1px solid transparent; font-variant-numeric: tabular-nums; }
  .sw__i:hover { color: var(--bone); }
  .sw__i.is-here { color: var(--accent); border-color: var(--rule); }
  .sw__prev { color: color-mix(in srgb, var(--dim) 70%, var(--ground)); text-decoration: none; padding: 3px 6px; margin-left: 4px; }
  .sw__prev:first-of-type { border-left: 1px solid var(--rule); margin-left: 8px; padding-left: 11px; }
  .sw__prev:hover { color: var(--bone-dim); }
  @media (max-width: 860px) { .sw__su { display: none; } .sw__nm { margin-right: auto; } }
  @media (max-width: 560px) { .sw__nm { display: none; } }

  .sc { padding: clamp(84px, 13vh, 150px) var(--margin) 0; }
  .hd { text-align: center; margin-bottom: clamp(38px, 6.6vh, 80px); }
  .hd__over { font-size: var(--t-micro); letter-spacing: 0.18em; text-transform: uppercase; color: var(--muted); margin: 0 0 clamp(16px, 2.6vh, 30px); }
  .hd__t { margin: 0; font-family: var(--display); font-weight: 500; font-size: clamp(2.6rem, 7vw, 5.6rem); line-height: 0.94; letter-spacing: -0.04em; color: var(--bone); }
  .hd__meta { margin: clamp(14px, 2.2vh, 26px) 0 0; font-size: var(--t-micro); letter-spacing: 0.18em; text-transform: uppercase; color: var(--bone-dim); }
  .hd__roles { display: inline-flex; flex-wrap: wrap; justify-content: center; gap: 0 14px; }
  .hd__roles span + span::before { content: '·'; margin-right: 14px; color: var(--dim); }
  .q { max-width: 34ch; margin: 0 auto clamp(50px, 8vh, 110px); text-align: center; }
  .q__t { margin: 0; font-family: var(--serif); font-style: italic; font-weight: 300; font-size: clamp(1.25rem, 2.4vw, 1.9rem); line-height: 1.26; letter-spacing: -0.012em; color: var(--bone-dim); }
  .body { max-width: var(--measure); margin-inline: auto; }
  .body__lede { margin: 0 auto; max-width: clamp(20ch, calc(var(--n, 90) / 3 * 1ch), 44ch); font-family: var(--display); font-weight: 500; font-size: clamp(1.2rem, min(calc(2.35rem - (var(--n, 90) - 55) * 0.007rem), calc(1.05rem + 2.1vw)), 2.2rem); line-height: 1.12; letter-spacing: -0.025em; color: var(--bone); text-wrap: balance; }
  .blk { margin: 0 auto clamp(104px, 18vh, 240px); }

  .st { --w: var(--measure); }
  .st__lbl {
    display: flex; align-items: center; gap: 12px;
    width: var(--w); margin: 0 auto clamp(24px, 4vh, 50px);
    font-size: var(--t-micro); letter-spacing: 0.18em; text-transform: uppercase; color: var(--muted);
  }
  .st__lbl i { flex: 1; height: 1px; background: var(--rule); }

  /* One line of mono per draft saying what the composition responds to.
     Scroll and hover are invisible affordances; naming them is not a crutch,
     it is the caption on a piece of behaviour. */
  .note {
    display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap;
    width: var(--w); margin: clamp(16px, 2.4vh, 28px) auto 0;
    font-size: var(--t-micro); letter-spacing: 0.16em; text-transform: uppercase; color: var(--dim);
  }
  .note b { font-weight: 400; color: var(--accent); font-variant-numeric: tabular-nums; }
  .note em { font-style: normal; color: var(--muted); }
  .note i { flex: 1; min-width: 20px; height: 1px; background: var(--rule); transform: translateY(-3px); }

  .cl { max-width: var(--measure); margin: 0 auto; padding-bottom: clamp(48px, 9vh, 110px); }
  .rule { border: 0; border-top: 1px solid var(--rule); margin: 0 0 16px; }
  .cl__p { display: flex; align-items: baseline; gap: 14px; margin: 0; font-size: var(--t-micro); letter-spacing: 0.16em; text-transform: uppercase; color: var(--dim); }
  .cl__p i { flex: 1; height: 1px; background: var(--rule); transform: translateY(-3px); }
  .cl__p span:last-child { text-align: right; }
  @media (max-width: 620px) { .cl__p { flex-direction: column; gap: 6px; } .cl__p i { display: none; } .cl__p span:last-child { text-align: left; } }

  /* ── SQ1 · THE SPREADS ─────────────────────────────────────── */
  .st { --w: min(calc(100vw - 2 * var(--margin)), 1180px); }
  .sp { width: var(--w); margin-inline: auto; }

  /* PROXIMITY, NOT MANDATORY. Each spread settles when you land near it; a
     reader who wants to keep going is never caught. */
  :global(html) { scroll-snap-type: y proximity; }
  .sp__s {
    min-height: 100vh; scroll-snap-align: center; scroll-snap-stop: normal;
    display: grid; align-content: center; position: relative;
    padding-block: clamp(40px, 7vh, 90px);
  }
  .sp__f { margin: 0; position: relative; }
  .sp__f img { display: block; width: 100%; height: auto; object-fit: cover; }

  .sp__cap {
    display: flex; align-items: baseline; gap: 10px; margin-top: 8px;
    font-size: var(--t-micro); letter-spacing: 0.16em; text-transform: uppercase;
    color: var(--dim); opacity: 0.34;
  }
  .sp__cap b { font-weight: 400; color: var(--accent); font-variant-numeric: tabular-nums; }

  .sp__type { display: grid; gap: 10px; align-content: start; }
  .sp__no { margin: 0; font-size: var(--t-micro); letter-spacing: 0.2em; color: var(--accent); font-variant-numeric: tabular-nums; }
  .sp__t {
    margin: 0; font-family: var(--display); font-weight: 500;
    font-size: clamp(1.5rem, 3.2vw, 2.9rem); line-height: 1.02; letter-spacing: -0.035em;
    color: var(--bone); text-wrap: balance;
  }
  .sp__sub { margin: 0; font-size: var(--t-micro); letter-spacing: 0.18em; text-transform: uppercase; color: var(--muted); }

  /* HOVER: the type stands down, the caption comes up. */
  .sp__s:has(.sp__f:hover) .sp__type { opacity: 0.2; }
  .sp__f:hover .sp__cap { opacity: 1; }
  @media (prefers-reduced-motion: no-preference) {
    .sp__type, .sp__cap { transition: opacity 320ms cubic-bezier(0.2, 0.8, 0.2, 1); }
  }

  /* ── THE SIX, EACH COMPOSED ON ITS OWN ─────────────────────── */

  /* I · Full bleed, type reversed into the lower left of the picture. */
  .sp--bleed { width: 100vw; margin-left: calc(var(--margin) * -1); padding-inline: 0; }
  .sp--bleed .sp__art { height: 100vh; }
  .sp--bleed .sp__f, .sp--bleed .sp__f img { height: 100%; }
  .sp--bleed .sp__type { position: absolute; left: var(--margin); bottom: clamp(44px, 9vh, 110px); max-width: 24ch; }
  .sp--bleed .sp__t { font-size: clamp(2rem, 5vw, 4.4rem); }
  .sp--bleed .sp__cap { position: absolute; right: var(--margin); bottom: clamp(48px, 9vh, 114px); margin: 0; }

  /* II · A half page and a great deal of air. */
  .sp--half { grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); gap: clamp(28px, 5vw, 80px); align-items: center; }
  .sp--half .sp__type { align-self: end; padding-bottom: 6%; }

  /* III · The pause. The quietest frame in the film, small, over one line.
     THE HAIRLINE IS NOT DECORATION. 03 measures .078 mean luminance — the
     floor of the whole set — so at this size on a near-black ground it has no
     visible edge at all and reads as absent rather than as quiet. A one-pixel
     rule gives the picture its extent back without touching the photograph,
     which is what a frame is for. */
  .sp--pause { justify-items: center; text-align: center; gap: clamp(22px, 4vh, 48px); }
  .sp--pause .sp__art { width: min(56%, 420px); }
  .sp--pause .sp__f img { box-shadow: 0 0 0 1px var(--rule); }
  .sp--pause .sp__type { justify-items: center; gap: 14px; }
  .sp--pause .sp__t { font-size: clamp(1.9rem, 5.4vw, 4.2rem); max-width: 16ch; }
  .sp--pause .sp__cap { justify-content: center; }

  /* IV · A tall offset pair, type running vertically in the gutter. */
  .sp--tall { grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr); gap: clamp(20px, 3.4vw, 54px); align-items: start; }
  .sp--tall .sp__art { display: contents; }
  .sp--tall .sp__f:nth-child(1) { grid-column: 1; margin-top: 8vh; }
  .sp--tall .sp__f:nth-child(2) { grid-column: 3; margin-top: 26vh; }
  .sp--tall .sp__type {
    grid-column: 2; grid-row: 1; writing-mode: vertical-rl; justify-items: start;
    gap: 16px; align-content: center; height: 100%;
  }
  .sp--tall .sp__t { font-size: clamp(1.1rem, 1.9vw, 1.6rem); letter-spacing: -0.015em; }

  /* V · Split page — picture holds the right half, floor to ceiling. */
  .sp--split { grid-template-columns: minmax(0, 1fr) minmax(0, 1.18fr); gap: clamp(26px, 4.6vw, 76px); align-items: stretch; }
  .sp--split .sp__art { grid-column: 2; height: 78vh; }
  .sp--split .sp__f, .sp--split .sp__f img { height: 100%; }
  .sp--split .sp__type { grid-column: 1; grid-row: 1; align-content: center; }
  .sp--split .sp__t { font-size: clamp(1.8rem, 4vw, 3.4rem); }

  /* VI · The close — two frames, allowed to overlap. */
  .sp--close .sp__art { position: relative; }
  .sp--close .sp__f:nth-child(1) { width: 78%; }
  .sp--close .sp__f:nth-child(2) { position: absolute; right: 0; bottom: -9%; width: 38%; }
  .sp--close .sp__f:nth-child(2) img { box-shadow: 0 0 0 1px var(--ground), 0 0 0 2px var(--rule); }
  .sp--close .sp__type { position: absolute; left: 0; bottom: clamp(30px, 6vh, 70px); max-width: 20ch; }

  @media (max-width: 760px) {
    /* The compositions were made for a landscape page. Rather than let six of
       them collapse into the same stacked column, the ones that depend on two
       axes give up their second: the offsets go, the vertical type turns back,
       and the overlap becomes an inset. The sequence survives; the staging
       does not pretend to. */
    .sp__s { min-height: auto; padding-block: clamp(36px, 7vh, 70px); gap: 18px; }
    .sp--half, .sp--split, .sp--tall { grid-template-columns: 1fr; }
    .sp--tall .sp__art { display: block; }
    .sp--tall .sp__f { grid-column: 1; margin-top: 0; }
    .sp--tall .sp__f + .sp__f { margin-top: 16px; }
    .sp--tall .sp__type { writing-mode: horizontal-tb; grid-column: 1; grid-row: auto; height: auto; }
    .sp--bleed .sp__art, .sp--split .sp__art { height: auto; }
    .sp--bleed .sp__f img, .sp--split .sp__f img { height: auto; aspect-ratio: var(--ar); }
    .sp--bleed .sp__type, .sp--close .sp__type { position: static; max-width: none; }
    .sp--bleed .sp__cap { position: static; }
    .sp--pause .sp__art { width: 62%; }
    .sp--close .sp__f:nth-child(1) { width: 100%; }
    .sp--close .sp__f:nth-child(2) { position: static; width: 56%; margin: -12% 0 0 auto; }
  }

  @media (prefers-reduced-motion: reduce) { :global(html) { scroll-snap-type: none; } }
</style>
