---
/**
 * SEVEN CHANGES, FOUR WAYS — SECOND SET
 *
 * 2026-09-21. The same seven instructions as ab-ps1..4, but varied on four
 * axes rather than two: the Selected works heading, the section numbers, the
 * step numbers and the three questions all differ between drafts. Only items
 * 1, 3 and 7 are fixed, being instructions with one correct answer.
 *
 * 1 · THE FOUR CORNERS AROUND SELECTED WORKS ARE GONE, removed in markup
 *   rather than hidden. With them go "SELECTED WORKS" twice over — the
 *   top-left label and the bottom-right one, both duplicating the heading in
 *   the middle of the same frame — "MUMBAI, INDIA / WORKING GLOBALLY",
 *   "01/06 / 2025 — 2026", and "SCROLL". The number survives as one <p>,
 *   because item 4 asks for it to be re-presented, not removed.
 *   ← "SCROLL" was the cue. The scroll indicator proper — the ruler and its
 *     playhead under the conveyor — is untouched and still reports position.
 *
 * 3 · PLACE AND RANGE ARE OUT of Who I am and out of Contact. Both strings
 *   remain in the opening frame, the one place on the page they are not a
 *   repeat.
 *
 * 7 · THE EMAIL, LOWERCASE AND IN HELVETICA NEUE. Measured first: it is
 *   ALREADY in Helvetica Neue and has been since the mono change went live —
 *   its stack sets a test string at 781.7px and "Helvetica Neue" alone gives
 *   781.7, while the named "Neue Haas Grotesk Display" gives 702.69, the same
 *   as an invented family name. So the only thing left to do is the case, and
 *   the family is stated explicitly anyway so the intent survives a future
 *   change to --mono. Reached with :global(), because .ft__mail belongs to
 *   ContactForm, which is shared with the work pages and is never edited from
 *   here.
 *
 * WHAT DIFFERS. Items 2, 4, 5 and 6, four ways each:
 *
 *            heading             section no.    step no.        questions
 *   RW1      12vw, on the        grey           accent          gap to zero
 *            About ink width
 *   RW2      69.12px, the        10px, 0.18em   Fraunces        gap zero +
 *            statement rank                     italic          leading 1.18
 *   RW3      12vw, banded        grey + rule    boxed marks     gap zero +
 *            between two rules                                  a bracket
 *   RW4      12vw, number        grey, weight   34px            gap zero +
 *            stacked above       400                            hanging indent
 *
 * RW4 · STACKED. The number sits on top of the name, and the step marks are
 * the loudest numerals on the page.
 *
 * 2 · THE HEADING at 12vw with its number stacked directly above it and
 *   closed up — 14px of air rather than the label row's usual interval — so
 *   01 and SELECTED WORKS read as one object rather than as a label and a
 *   title that happen to be near each other. The About movements hang their
 *   number at column 1 under a rule; this one puts it on the heading's own
 *   left edge, which is the same alignment reached a different way.
 *
 * 4 · SECTION NUMBERS, BY WEIGHT. --po-grey at 12px, but at weight 400 where
 *   everything else on the page is 500. It is the smallest change of the
 *   four and the hardest to name when you see it, which is rather the point:
 *   the number stops asserting without anything visibly happening to it.
 *
 * 5 · STEP NUMBERS, BY SCALE. 34px in bone against the section numbers' 12 —
 *   a ratio of 2.8 to 1, and unmistakable at a glance. This inverts the
 *   hierarchy deliberately: How I work is the one section whose content IS a
 *   numbered sequence, so its numbers are the argument's structure rather
 *   than filing. Everywhere else a number is an address and behaves like one.
 *
 * 6 · THE QUESTIONS, HUNG. Gap to zero, leading to 1.1, and the three pulled
 *   left out of the column so they hang off its edge — the device a
 *   dictionary uses for a run of sub-entries. Tighter than any other draft
 *   here, and the only one where the tightening also changes where the block
 *   starts.
 *
 * ← THE SMOKED MOSAIC, the conveyor, the ruler and the About body are
 *   untouched. Only what the seven items name is changed.
 * ← ContactForm IS NOT EDITED. The email is restyled through :global().
 * ← .sec--works CARRIES overflow-x: clip in every draft. The heading is
 *   1311px of ink in a 1126.4px frame and .mvt.po-sec is the only section
 *   that ever clipped; without it the document measured 1448px wide on a
 *   1280 viewport. clip, not hidden, so the conveyor's sticky pin is not
 *   put inside a new scrollport.
 */
import Base from '../../layouts/Base.astro';
import OpNav from '../../components/OpNav.astro';
import Still from '../../components/Still.astro';
import ContactForm from '../../components/ContactForm.astro';
import { HERO, PORTRAIT, WHO, PROCESS, ACROSS, CLOSING } from '../../data/about';
import { EMAIL, PHONE, WHATSAPP } from '../../data/contact';
import { composition, numberFor, total, RATIO_NUM } from '../../data/composition';
import { getCollection } from 'astro:content';
import Opening from '../../components/Opening.astro';
import { framesFor } from '../../lib/frames';
import { BED_SWAPS, BED_CROP, BED_GRADE, BED_TILES } from '../../lib/bed';
import { cardK, type CardMode } from '../../lib/cards';

/* HOW BIG AN UPRIGHT WORK IS IN THE CONVEYOR — draft E · Draw, applied.
   Chosen from five built as real pages and judged in the browser; those pages
   were deleted with the rest of the preview library on 2026-09-05, but every
   mode is kept in src/lib/cards.ts along with the reasoning and the
   measurements. This is the one line that selects between them. */
const CARD_MODE: CardMode = 'draw';

const works = await getCollection('works');
const bySlug = new Map(works.map((w) => [w.id, w]));

/* THE COUNTDOWN'S THREE FRAMES, CHOSEN AND NAMED.

   The opening is the Academy leader: three counts, 3 · 2 · 1, each holding one
   frame from the catalogue behind the numeral. The order below is the order
   they are counted in — first entry behind 3, last behind 1.

   THE FRAME NUMBER IS PART OF THE CHOICE, not an afterthought. Everywhere else
   on the site a work is represented by the first frame in its folder; here
   Special Ops shows its SECOND. So the index is carried explicitly rather than
   assumed, and it is 1-based to match how the frames are named on disk.

   This replaced a slice off the front of the score — every other work, eight of
   them, of which the leader only ever counted the first three. That was the
   right shape for the helix opening this succeeded, which flew all eight; a
   countdown shows three, so three are named. */
/* EACH FRAME IS ALSO AIMED, because the ring is a circle and object-fit alone
   centres the FRAME, not the face in it. Read off the ring at 10% gridlines,
   the three faces sit at these fractions of it:

     3  book-my-yamraj   0.50, 0.49   already centred
     2  taskaree         0.50, 0.455  a little high
     1  special-ops-2    0.47, 0.31   well high, and slightly left

   `zoom` and the shift correct that. A shift alone cannot: two of the three are
   landscape frames in a square ring, so cover fits them by height and there is
   no vertical slack to move into — the zoom is what creates the room, and its
   floor is set by how far off-centre the face is. A face at 0.31 of the height
   can only be centred by discarding everything above 0.62, which is a zoom of
   1/0.62. Shifts are percentages of the ring, applied after the zoom.

   THE ZOOM ALSO HAS TO KEEP THE RING COVERED. The shift can be at most half the
   slack the zoom created, or the frame pulls off an edge and the ground shows
   through. Taskaree ran at 1.12 first, which left its top edge 3.7px inside a
   368px ring — correct, but one rounding from a hairline on a smaller ring;
   1.15 doubles that margin and moves the face by a third of a pixel. The ring
   is always square, so these figures hold at every viewport. */
/* AND EACH FRAME CARRIES ITS OWN BRIGHTNESS, for the same reason it carries
   its own aim: the thing being corrected is a property of that photograph.

   The numeral is white, and what threatens it is not how bright the frame is
   on average but the brightest PATCHES falling inside the glyph's own outline.
   Measured under the real 3/2/1 ink at ring size, the three were unequal and
   two were under the 3:1 floor that text this large wants — the 2 worst at
   2.2:1, on a highlight that belongs to Taskaree alone.

   One global value would have to be dark enough for Taskaree and would then
   take a fifth of Special Ops' brightness away to fix a highlight that is not
   in it. So each frame is dimmed only as far as ITS OWN worst pixel requires,
   which is the brightest each can be:

     3  book-my-yamraj  0.67   2.9:1 -> 4.0:1
     2  taskaree        0.58   2.2:1 -> 4.0:1
     1  special-ops-2   0.76   3.6:1 -> 4.0:1

   Full workings, both viewports and the ring means that show the frames are
   still photographs, are in the filter comment in Opening.astro. Re-measure
   there rather than nudging these by eye — and re-measure if a frame or an aim
   changes, because the aim decides which part of the photograph is under the
   glyph in the first place. */
const COUNTDOWN: { slug: string; frame: number; zoom?: number; x?: number; y?: number; dim: number }[] = [
  { slug: 'book-my-yamraj', frame: 1, dim: 0.67 },                            // behind 3
  { slug: 'taskaree', frame: 1, zoom: 1.15, y: 5, dim: 0.58 },                // behind 2
  { slug: 'special-ops-2', frame: 2, zoom: 1.7, x: 5.4, y: 32.6, dim: 0.76 }, // behind 1
];
const stills = COUNTDOWN.map(({ slug, frame, zoom, x, y, dim }) => {
  const w = bySlug.get(slug)!;
  const all = framesFor(slug, w.data.frames);
  /* Clamped, so a frame that is renumbered or removed degrades to the last one
     the work has rather than failing the build. */
  return {
    img: all[Math.min(Math.max(1, frame), all.length) - 1],
    alt: w.data.alt,
    aim: zoom || x || y ? { zoom: zoom ?? 1, x: x ?? 0, y: y ?? 0 } : undefined,
    dim,
  };
});

const wordsOf = (s: string) => s.split(' ');
const cut = (s: string): [string, string] => {
  const i = s.indexOf(',');
  return i < 0 ? [s, ''] : [s.slice(0, i + 1), s.slice(i + 1).trim()];
};
const [whoSans, whoSerif] = cut(WHO.head);
const LEDGER = Array.from({ length: 12 }, (_, i) => i);
const clauses = (l: string) => l.split(/(?<=\?)\s+/).filter(Boolean);
const asks = (c: string) => c.trim().endsWith('?');

/* The name, taken from the eyebrow rather than retyped. */
const NAME = HERO.eyebrow.split('·')[0].trim();
const NAME_PARTS = NAME.split(' ');

/* The catalogue's real year range, for the corner labels — read off the
   collection so it can never drift from the works themselves. */
const YEARS = [...new Set(works.map((w) => w.data.year))].sort();
const RANGE = `${YEARS[0]} — ${YEARS[YEARS.length - 1]}`;

/* XL flattened HERO.statement to a string and re-wrapped it greedily at 22
   characters, because its caption is uppercase and had to break somewhere the
   data does not. Corners does not re-wrap: it sets one .line per entry in
   HERO.statement, so the break after "A composer working in" is the one the
   data already carries and the accent stays on the word it belongs to rather
   than being matched back out of a flattened string. The re-wrapper, the Word
   type and the accent lookup all go with it. */

const R = 900;
const STEP = 0.5;
let wi = 0;
const wnodes: { w: any; i: number; no: string; x: number }[] = [];
for (const stanza of composition) {
  for (const p of stanza.items) {
    const w = bySlug.get(p.slug)!;
    wnodes.push({
      w, i: wi, no: numberFor(w.id),
      /* Which side this work drifts to once it has gone behind. Taken from
         its column in the score, as the original Conveyor did, so the same
         work always passes on the same side rather than being scattered. */
      x: +((((p.col - 1) + p.span / 2 - 6) / 6)).toFixed(3),
    });
    wi++;
  }
}

/* The bed's cast and its frame corrections live in src/lib/bed.ts. That was
   so the mosaic drafts could render from the same tables as this page rather
   than a second copy; the drafts are gone, and the split stays because those
   tables are content decisions with long arguments attached. */
const bedCast = wnodes.map((n) => {
  const to = BED_SWAPS[n.w.id];
  return to ? { ...n, w: bySlug.get(to)! } : n;
});

/* The catalogue as a bed behind the whole document. It comes round more than
   once on purpose: a wall of work should read as more than you can count. */
const GROUND_TILES = Array.from({ length: BED_TILES }, (_, i) => bedCast[i % bedCast.length]);

/* D · Poster: splits a statement's trailing full stop off so it can take the
   site's orange. The words themselves are untouched. */
const stopOf = (s: string): [string, string] => (s.endsWith('.') ? [s.slice(0, -1), '.'] : [s, '']);
/* The opening letter, split off so it can be set as a versal. */
const versalOf = (s: string): [string, string] => [s.slice(0, 1), s.slice(1)];
---

<Base
  title="Ugam Khetani — Composer, Producer, Sound Designer"
  description="Selected works across film, brand and music. Original score for film, OTT and series; sonic identity for brands; campaign audio authored end to end."
  intro
>
  <Opening stills={stills} />
  <OpNav variant="bracket" />

  <div class="rg" data-rg>
    <div class="gauge" aria-hidden="true"><span class="gauge__in" data-progress></span></div>

    <div class="rh" data-runhead aria-hidden="true">
      <span class="mono rh__name">{NAME}</span>
      <span class="mono rh__sep">&mdash;</span>
      <span class="mono rh__mv" data-rh-mv>Selected works</span>
      <span class="mono rh__folio" data-rh-folio>01/06</span>
    </div>

    <div class="ms__ground" aria-hidden="true">
      <div class="ms__bed">
        {GROUND_TILES.map((c) => (
          <span
            class="ms__tile"
            class:list={[{ 'ms__tile--crop': !!BED_CROP[c.w.id] }]}
            style={[
              BED_CROP[c.w.id] &&
                `--crop-s:${BED_CROP[c.w.id].scale};--crop-y:${BED_CROP[c.w.id].shiftY}%`,
              BED_GRADE[c.w.id] && `--bed-k:${BED_GRADE[c.w.id].contrast}`,
            ]
              .filter(Boolean)
              .join(';') || undefined}
          >
            <Still slug={c.w.id} title={c.w.data.title} year={c.w.data.year}
              category={c.w.data.category} ratio={c.w.data.ratio}
              frames={c.w.data.frames} alt={c.w.data.alt}
              sizes="20vw" eager={false} max={1} free={true} />
          </span>
        ))}
      </div>
    </div>

    <div class="ap__mat" aria-hidden="true"></div>

    {/* One pane for the whole page. See the stylesheet. */}
    {/* THE BLUR IS EARNED, NOT GUESSED.

        What this replaced was a guess in three parts — cores, memory and a
        900px width rule — and measured, it pointed the wrong way. The bed is
        1.2x the viewport in each axis, so an iPhone 15 Pro blurs 4.34
        physical megapixels and a 1512x982 MacBook blurs 8.55. The phone did
        half the work and was switched off; the laptop did twice as much and
        was let through. Width is not a capability test.

        Nor could a static test be fixed: deviceMemory does not exist in
        Safari, so no iPhone can ever pass it, and what iOS reports for
        hardwareConcurrency could not be determined here — guessing wrong
        gates every iPhone, which is the exact outcome this is meant to
        avoid.

        So it is measured, and the design pays for the window. The blur is
        0px until 240px of scroll — the opening is blur-free by construction
        — which is long enough to discard the first ten frames, watch the
        next forty and decide before anything expensive is wanted. Nothing is
        shown and then taken away. The loop is bounded at two hundred frames
        or five seconds, whichever comes first, and running out is itself a
        verdict: no blur.

        THE BAR IS THE DISPLAY'S OWN CADENCE, not a millisecond count. The
        shortest frame observed is taken as the refresh period and the device
        passes if its median frame sits within 1.35 of it, which reads the
        same on a 60Hz phone and a 120Hz laptop where one fixed threshold
        would have had to pick one and be wrong about the other.

        AND THE CADENCE ITSELF HAS TO BE A HEALTHY ONE. Testing the ratio
        alone let a device pinned at 30fps through — it holds 33.3ms
        perfectly, ratio 1.01, which reads as a device in complete control of
        itself. Consistency is not health. The period must also be 20ms or
        better, which is 50Hz: 60 and 120 pass, a throttled or low-power
        device does not.

        FAILS TO THE CHEAP STATE. No script, no attribute, no blur. */}
    <script is:inline>
      (function () {
        var d = document.documentElement;
        /* A stated preference, not a capability. Never probe, never blur. */
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        /* The verdict survives client-side navigation, so this runs once a
           session rather than once a page. */
        try {
          var seen = sessionStorage.getItem('blur-ok');
          if (seen === '1') { d.setAttribute('data-blur', ''); return; }
          if (seen === '0') return;
        } catch (e) {}

        /* THE FIRST FRAMES ARE THROWN AWAY, and this is the difference
           between letting a good phone through and failing it. The probe
           starts at load, which is when image decoding is heaviest — a
           capable phone can easily spend its first ten frames behind and
           then hold 60 perfectly. Judging it on those frames would fail
           exactly the device this measurement exists to let through. */
        var dts = [], last = 0, seen = 0, t0 = 0;
        var WARMUP = 10, N = 40, MAX_FRAMES = 200, MAX_MS = 5000;
        requestAnimationFrame(function tick(now) {
          if (!t0) t0 = now;
          seen++;
          if (last && seen > WARMUP) {
            var dt = now - last;
            /* Over 100ms is a tab switch or an image decode, not a verdict
               on the device. */
            if (dt < 100) dts.push(dt);
          }
          last = now;

          /* BOUNDED TWO WAYS, and it has to be. Waiting only for N clean
             samples means a device whose frames are mostly OVER 100ms never
             collects them — and the loop then runs for the life of the page,
             on precisely the hardware least able to spare it. It costs 7
             nanoseconds a frame, so this is untidy rather than harmful, but
             an unbounded loop is not something to leave in. Frames cap the
             fast case, wall clock caps the slow one: at 5fps, 200 frames
             would be 40 seconds. */
          if (dts.length < N && seen < MAX_FRAMES && now - t0 < MAX_MS) {
            requestAnimationFrame(tick);
            return;
          }

          var ok = false;
          /* Falling out of the loop without enough clean samples IS the
             verdict: the device could not produce forty frames under 100ms
             inside two hundred attempts or five seconds. No blur, and it is
             cached like any other answer so the probe does not run again. */
          if (dts.length >= N) {
            var sorted = dts.slice().sort(function (a, b) { return a - b; });
            var period = sorted[0];
            var median = sorted[sorted.length >> 1];
            /* TWO TESTS, AND THE SECOND ONE MATTERS. The ratio alone says
               the device is holding whatever cadence it has — and a machine
               pinned at 30fps holds 33.3ms perfectly, ratio 1.01, and sails
               through. Consistency is not health. The period itself has to
               be a healthy one: 20ms is 50Hz, which lets 60 and 120 through
               and stops a throttled or low-power device from calling itself
               capable. */
            ok = period > 0 && period <= 20 && median / period <= 1.35;
          }
          if (ok) d.setAttribute('data-blur', '');
          try { sessionStorage.setItem('blur-ok', ok ? '1' : '0'); } catch (e) {}
        });
      })();
    </script>
    <div class="sm" aria-hidden="true"></div>

    <header class="ov ov--cm" id="top">
      <div class="fr fr--hero">
        <p class="mono cn cn--tl">00<br />Opening</p>
        <p class="mono cn cn--tr">{HERO.place[0]}<br />{HERO.place[1]}</p>
        <p class="mono cn cn--bl">00/06<br />{RANGE}</p>
        <p class="mono cn cn--br">Selected works<br /><span class="ov__cue">Scroll &darr;</span></p>
        {/* Corners' middle, lifted whole: .ov__middle / .ov__mast / .ov__word
            and the .ov__stmt heading, with the same --i reveal ordering. The
            frame around it is still XL's — .fr--hero and its four corner
            labels are untouched. */}
        <div class="fr__mid">
          <div class="ov__middle">
            <div class="ov__mast">
              {NAME_PARTS.map((part, i) => (
                <span class="line ov__word" data-reveal style={`--i:${i + 1}`}>
                  <span class="line__in">{part}</span>
                </span>
              ))}
            </div>
            <h1 class="ov__stmt">
              {HERO.statement.map((line, li) => (
                <span class="line" data-reveal style={`--i:${li + 3}`}>
                  <span class="line__in">
                    {line.map((part) => (part.accent ? <em class="hot serif">{part.t}</em> : part.t))}
                  </span>
                </span>
              ))}
            </h1>
          </div>
        </div>
      </div>
    </header>

    <section class="mvt mvt--a2 sec--works" id="works" aria-labelledby="r-works" data-mv="0" style={`--count:${wnodes.length}`}>
      <div class="fr fr--over">
        <p class="wk-no">01</p>
        <div class="fr__mid">
          <h2 class="fr__t" id="r-works">
            <span class="line" data-reveal><span class="line__in">Selected works</span></span>
          </h2>
        </div>
      </div>

      <div class="wk" data-works-conveyor style={`--r:${R};--step:${STEP}`}>
        <div class="wk__pin">
          <div class="wk__scene" data-scene>
            <div class="wk__world">
              {wnodes.map((n) => (
                <div class="wcard" data-card data-no={n.no} data-title={n.w.data.title} data-year={n.w.data.year}
                  style={`--arn:${RATIO_NUM[n.w.data.ratio]};--card-k:${cardK(CARD_MODE, RATIO_NUM[n.w.data.ratio])}`}>
                  <Still slug={n.w.id} title={n.w.data.title} year={n.w.data.year}
                    category={n.w.data.category} ratio={n.w.data.ratio}
                    frames={n.w.data.frames} alt={n.w.data.alt}
                    sizes="46vw" eager={n.i < 3} />
                </div>
              ))}
            </div>
          </div>
          <div class="rl" data-readout aria-hidden="true">
            <p class="rl__cap"><span data-w-title>{wnodes[0].w.data.title}</span></p>
            <div class="rl__ruler">
              <span class="rl__ticks">
                {wnodes.map(() => <span class="rl__t"></span>)}
              </span>
              <span class="rl__head" data-rl-head></span>
            </div>
            <p class="rl__date"><span data-w-year>{wnodes[0].w.data.year}</span></p>
          </div>
        </div>
      </div>
    </section>

    <section class="mvt po-sec" id="about" aria-labelledby="r-who" data-mv="1">
      <h2 class="po-giant" id="r-who" style="--gs:27vw"><span class="po-pan">Who I am</span></h2>
      <div class="po-grid">
        <p class="po-label po-c1">02</p>
        <p class="po-label po-c2">{HERO.place[0]}<br />{HERO.place[1]}</p>
        <p class="po-label po-c3">{RANGE}</p>
        <h3 class="po-state">{stopOf(WHO.head)[0]}<span class="po-stop">{stopOf(WHO.head)[1]}</span></h3>
        <div class="po-body">
          {WHO.body.map((p, i) => (i === 0
            ? <p class="po-open"><span class="po-versal" aria-hidden="true">{versalOf(p)[0]}</span><span class="po-versal-sr">{versalOf(p)[0]}</span>{versalOf(p)[1]}</p>
            : <p>{p}</p>))}
        </div>
      </div>
    </section>

    <section class="mvt po-sec" aria-labelledby="r-across" data-mv="2">
      <h2 class="po-giant" id="r-across" style="--gs:13.5vw"><span class="po-pan">What I work across</span></h2>
      <div class="po-grid">
        <p class="po-label po-c1">03</p>
        <h3 class="po-state">
          {ACROSS.head.map((l) => <span class="po-line">{stopOf(l)[0]}<span class="po-stop">{stopOf(l)[1]}</span></span>)}
        </h3>
        <p class="po-lede">{ACROSS.lede}</p>
        {ACROSS.columns.map((c, i) => (
          <div class={`po-list po-list--${i}`}>
            <h4 class="po-label po-label--hi">{c.label}</h4>
            <ul>{c.items.map((it) => <li>{it}</li>)}</ul>
          </div>
        ))}
      </div>
    </section>

    <section class="mvt po-sec" id="philosophy" aria-labelledby="r-how" data-mv="3">
      <h2 class="po-giant" id="r-how" style="--gs:23vw"><span class="po-pan">How I work</span></h2>
      <div class="po-grid">
        <p class="po-label po-c1">04</p>
        <ol class="po-steps">
          {PROCESS.map((s) => (
            <li class="po-step">
              <span class="po-label po-label--hi po-stepn">{s.n}</span>
              <h3 class="po-steptitle">{s.title}</h3>
              <div class="po-steplines">
                {s.lines.flatMap((l) => clauses(l)).map((c) => (
                  <p class={asks(c) ? 'po-ask' : undefined}>{c}</p>
                ))}
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="mvt po-sec po-sec--end" aria-labelledby="r-close" data-mv="4">
      <h2 class="po-giant" id="r-close" style="--gs:18vw"><span class="po-pan">What I’m after</span></h2>
      <div class="po-grid">
        <p class="po-label po-c1">05</p>
        <h3 class="po-state po-state--end">{stopOf(CLOSING.head)[0]}<span class="po-stop">{stopOf(CLOSING.head)[1]}</span></h3>
        <p class="po-lede po-lede--end">{CLOSING.body}</p>
      </div>
    </section>

    {/* The CONTACT heading is gone. aria-label replaces aria-labelledby, so
        the section is still named for anyone navigating by landmark — the
        heading was the only thing that id pointed at, and a dangling
        aria-labelledby names a section after nothing at all. The corner
        still reads 06 / Contact, and the form opens on "Let's talk." */}
    <section class="mvt po-sec sm-sec mvt--contact" id="contact" aria-label="Contact" data-mv="5">
      <div class="po-grid sm-grid">
        <p class="po-label po-c1">06</p>
        <p class="po-label po-c2">{HERO.place[0]}<br />{HERO.place[1]}</p>
        <p class="po-label po-c3">{RANGE}</p>
        <div class="sm-form"><ContactForm /></div>
      </div>
    </section>
  </div>
</Base>

<style is:global>
  .runhead { display: none !important; }
</style>

<script>
  function initRegister() {
    const page = document.querySelector<HTMLElement>('[data-rg]');
    if (!page || page.dataset.bound) return;
    page.dataset.bound = '1';

    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const fine = matchMedia('(hover: hover) and (pointer: fine)').matches;
    const bar = page.querySelector<HTMLElement>('[data-progress]');

    type Block = { words: HTMLElement[]; el: HTMLElement; lit: number };
    const blocks: Block[] = Array.from(page.querySelectorAll<HTMLElement>('[data-read]')).map((el) => ({
      el, words: Array.from(el.querySelectorAll<HTMLElement>('.w')), lit: 0,
    }));
    if (still) for (const b of blocks) { b.words.forEach((w) => w.classList.add('is-lit')); b.lit = b.words.length; }

    let ticking = false;
    const measure = () => {
      ticking = false;
      const vh = innerHeight;
      const max = document.documentElement.scrollHeight - vh;
      if (bar) bar.style.transform = `scaleY(${max > 0 ? Math.min(scrollY / max, 1) : 0})`;
      if (still) return;
      const line = vh * 0.68;
      for (const b of blocks) {
        const r = b.el.getBoundingClientRect();
        const span = r.height + vh * 0.16;
        const p = span > 0 ? (line - r.top) / span : 0;
        const want = Math.max(0, Math.min(b.words.length, Math.ceil(p * b.words.length)));
        if (want === b.lit) continue;
        if (want > b.lit) for (let i = b.lit; i < want; i++) b.words[i].classList.add('is-lit');
        else for (let i = want; i < b.lit; i++) b.words[i].classList.remove('is-lit');
        b.lit = want;
      }
    };
    const onScroll = () => { if (!ticking) { ticking = true; requestAnimationFrame(measure); } };
    addEventListener('scroll', onScroll, { passive: true });
    addEventListener('resize', onScroll, { passive: true });
    measure();

    /* ── the ledger answers the pointer, as ONE system ────────────
       Rule i in EVERY ledger sits at the same x: they are all laid out
       inside the same page padding, on the same twelve columns. Column i
       is therefore not seven separate hairlines but ONE line running the
       height of the document, drawn in pieces.

       That is why this is bound once on the page and drives every ledger
       together. Bound per section — which is how it was — each section
       ran its own loop, so crossing a seam fired one pointerleave while
       the next fired pointermove, and the light died and was reborn at
       every boundary. Nothing was wrong with the drawing; the system was
       simply cut into pieces that could not see each other.

       Vertical offsets are stored DOCUMENT-relative (rect.top + scrollY).
       Cached viewport offsets are only correct at scroll position zero,
       which is exactly why the segment effect used to work in the first
       movement and nowhere below it.

       Eased, frame-driven, sleeps when settled, real pointers only. */
    if (fine && !still) {
      const ruled = matchMedia('(min-width: 901px)');
      const ledgers = Array.from(page.querySelectorAll<HTMLElement>('.ledger'));
      const perLedger = ledgers.map((l) => Array.from(l.querySelectorAll<HTMLElement>('i')));
      const cols = perLedger.length ? perLedger[0].length : 0;

      if (cols) {
        const groups: HTMLElement[][] = [];
        for (let i = 0; i < cols; i++) groups.push(perLedger.map((rs) => rs[i]).filter(Boolean));

        let lefts: number[] = [];
        let tops: number[] = [];
        let span = 0;
        const cache = () => {
          lefts = groups.map((g) => g[0].getBoundingClientRect().left);
          tops = ledgers.map((l) => l.getBoundingClientRect().top + scrollY);
          span = lefts.length > 1 ? lefts[1] - lefts[0] : 0;
        };
        cache();
        addEventListener('resize', cache, { passive: true });
        // Rules move vertically as images settle, so refresh once things load.
        addEventListener('load', cache);

        const val = new Float32Array(cols);
        const shown = new Float32Array(cols).fill(-1);
        let px = -1e5, py = 0, inside = false, raf = 0;

        const frame = () => {
          raf = 0;
          let busy = false;
          const docY = py + scrollY;
          for (let k = 0; k < ledgers.length; k++) {
            ledgers[k].style.setProperty('--py', (docY - tops[k]).toFixed(1) + 'px');
          }
          for (let i = 0; i < cols; i++) {
            const d = Math.abs(lefts[i] - px);
            const t = inside ? Math.max(0, 1 - d / 200) : 0;
            val[i] += (t * t - val[i]) * 0.2;
            if (val[i] < 0.002) val[i] = 0;
            // The delta test alone never writes the last step home: a value
            // that lands on 0 from 0.002 differs by less than the threshold,
            // so the DOM kept a stale 0.002 for ever while the state said 0.
            // Invisible at 1px — 0.0019 of alpha — but the resting state
            // should be the resting state. Force the final write.
            if (Math.abs(val[i] - shown[i]) > 0.003 || (val[i] === 0 && shown[i] !== 0)) {
              for (const el of groups[i]) {
                el.style.setProperty('--lit', val[i].toFixed(3));
              }
              shown[i] = val[i];
            }
            if (val[i] > 0) busy = true;
          }
          if (inside || busy) raf = requestAnimationFrame(frame);
        };
        const kick = () => { if (!raf) raf = requestAnimationFrame(frame); };

        page.addEventListener('pointermove', (e) => {
          const pe = e as PointerEvent;
          if (pe.pointerType !== 'mouse' || !ruled.matches) return;
          px = pe.clientX; py = pe.clientY; inside = true; kick();
        }, { passive: true });
        page.addEventListener('pointerleave', () => { inside = false; kick(); });
      }
    }

    /* SCOPED — About selects [data-count] meaning "a statistic"; Still puts
       data-count on every work anchor meaning "how many stills". Unscoped, the
       counter wrote textContent over sixteen image stacks. */
    const counters = Array.from(page.querySelectorAll<HTMLElement>('.stat__figure[data-count]'));
    if (counters.length && !still) {
      const io = new IntersectionObserver((entries, obs) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          const el = e.target as HTMLElement;
          obs.unobserve(el);
          const to = Number(el.dataset.count);
          const pad = Number(el.dataset.pad ?? 0);
          const suffix = el.dataset.suffix ?? '';
          const final = String(to).padStart(pad, '0') + suffix;
          /* The count is decoration; the figure is information. Belt and
             braces so the true figure lands whatever the frame loop does. */
          const settle = setTimeout(() => { el.textContent = final; }, 1500);
          const t0 = performance.now();
          const tick = (now: number) => {
            const p = Math.min((now - t0) / 900, 1);
            const v = Math.round(to * (1 - Math.pow(1 - p, 3)));
            el.textContent = p < 1 ? String(v).padStart(pad, '0') + suffix : final;
            if (p < 1) requestAnimationFrame(tick); else clearTimeout(settle);
          };
          requestAnimationFrame(tick);
        }
      }, { threshold: 0.6 });
      counters.forEach((c) => io.observe(c));
    }

    if (fine && !still) {
      page.querySelector<HTMLElement>('[data-works]')?.querySelectorAll<HTMLElement>('li').forEach((li) => {
        const peek = li.querySelector<HTMLElement>('.work__peek');
        if (!peek) return;
        const move = (e: PointerEvent) => {
          const r = li.getBoundingClientRect();
          peek.style.setProperty('--x', `${e.clientX - r.left}px`);
          peek.style.setProperty('--y', `${e.clientY - r.top}px`);
        };
        li.addEventListener('pointerenter', (e) => { move(e as PointerEvent); li.classList.add('is-peek'); });
        li.addEventListener('pointermove', move, { passive: true });
        li.addEventListener('pointerleave', () => li.classList.remove('is-peek'));
      });
    }
  }

  initRegister();
  document.addEventListener('astro:page-load', initRegister);
</script>

<script>
  function initOpWorks() {
    const sec = document.querySelector('.sec--works') as HTMLElement | null;
    const wk = document.querySelector('[data-works-conveyor]') as HTMLElement | null;
    if (!sec || !wk || wk.dataset.bound) return;
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    if (!matchMedia('(min-width: 901px)').matches) {
      if (!wk.dataset.armed) { wk.dataset.armed = '1'; addEventListener('resize', () => initOpWorks(), { passive: true }); }
      return;
    }
    wk.dataset.bound = '1';

    const cards = Array.from(wk.querySelectorAll('[data-card]')) as HTMLElement[];
    const readout = sec.querySelector('[data-readout]') as HTMLElement;
    const title = sec.querySelector('[data-w-title]') as HTMLElement;
    const year = sec.querySelector('[data-w-year]') as HTMLElement;
    const row = sec.querySelector('.rl__ticks') as HTMLElement;
    const ticks = Array.from(sec.querySelectorAll('.rl__t')) as HTMLElement[];
    if (!cards.length) return;

    sec.classList.add('is-live');
    /* THE FIRST MARK IS LIT HERE, NOT BY paint(). The readout's caption and
       year are server-rendered from wnodes[0], so the page arrives already
       claiming to be on work one — but the lit mark has no such markup, and
       the block in paint() that sets it is guarded on a CHANGE of centred
       work, which by definition has not happened yet. Measured before this
       line existed: no mark lit at all through the whole first work. */
    if (ticks[0]) ticks[0].classList.add('is-on');

    /* Natural, unscaled heights. offsetHeight is layout height and is blind
       to transforms, which is exactly what the stack needs — and it is read
       once here and on resize rather than every frame, because sixteen
       offsetHeight reads inside a scroll handler is sixteen forced layouts a
       frame. Read after `is-live` is applied, so the cards are already at
       their scene width. */
    /* WIDTHS now, not heights: the row is horizontal and every card is set to
       one common height, so its width is what varies with the aspect ratio and
       what the edge-to-edge placement has to stack. */
    let W = cards.map((c) => c.offsetWidth || 400);
    /* Which side each work drifts to once it is behind, set on the element
       by the score. Read once — it never changes. */
    const remeasure = () => { W = cards.map((c) => c.offsetWidth || 400); };
    addEventListener('resize', remeasure, { passive: true });
    addEventListener('load', remeasure);
    if (document.fonts && document.fonts.ready) document.fonts.ready.then(remeasure);

    const cs = getComputedStyle(wk);
    const R = parseFloat(cs.getPropertyValue('--r')) || 900;
    const STEP = parseFloat(cs.getPropertyValue('--step')) || 0.5;

    /* Not left to lazy loading: the cards sit in a 0x0 world and are culled
       with visibility:hidden, so the browser never schedules them — measured,
       five of sixteen never loaded, one of them on screen. */
    const warm = (i: number) => {
      const c = cards[i];
      if (!c || c.dataset.warm) return;
      c.dataset.warm = '1';
      c.querySelectorAll('img').forEach((img) => {
        if (!(img as HTMLImageElement).complete) (img as HTMLImageElement).loading = 'eager';
      });
    };
    const warmAround = (b: number) => { for (let k = -3; k <= 3; k++) warm((b + k + cards.length) % cards.length); };
    cards.forEach((_, i) => { if (i < 4) warm(i); });

    let raf = 0, last = -1, written = 0, ring = -1;
    const paint = () => {
      raf = 0;
      const rect = sec.getBoundingClientRect();
      const run = sec.offsetHeight - innerHeight;
      const t = run > 0 ? Math.min(1, Math.max(0, -rect.top / run)) : 0;
      const phase = t * (cards.length - 1);

      /* One pitch for every step. The arc's own R·sin(θ) bunched the works
         hard at the extremes — measured gaps of 65, 47, 99, 253, 426, 130,
         105, 10px. Height is linear in the distance from centre now; only
         the depth still follows the arc. */
      /* ── CONSTANT EDGE-TO-EDGE SPACING ─────────────────────────
         The works are different shapes: at the same width a 9:16 stands
         nearly three times the height of a 2.39:1. A constant CENTRE-to-
         centre pitch therefore leaves wildly different gaps between the
         pictures — the tall ones almost touching, the wide ones marooned.

         So the column is STACKED, not stepped. Every work is placed exactly
         GAP below the bottom edge of the one above it, using rendered
         heights, so the distance between two pictures is the same number for
         every pair at every point in the scroll, whatever the two shapes
         are. That is only possible because the depth is a scale: the height
         is known before the placement, which a translateZ can never give
         you, since its foreshortening is applied after layout. The falloff
         is the same P/(P+z) the perspective was producing, so the depth
         reads exactly as it did. */
      /* ══ THE SWEEP ═══════════════════════════════════════════════
         A horizontal row, read off the reference. The active work is centred
         and largest; its neighbours recede to BOTH sides on one horizontal
         axis, shrinking and fading out.

         DEPTH IS QUADRATIC, NOT COSINE. The vertical fold this replaced used
         z = R(1 - cos(d.STEP)), which is periodic — that is why it had to be
         frozen at 1.4 steps, or works far off screen turned back into full
         size and, because the stack accumulates rendered sizes, shifted
         everything still on screen. A row this long needs a curve that is
         monotonic the whole way out. d-squared is, and it happens to land on
         the reference's own falloff without any clamp: 0.62 and 0.29 against
         the 0.62 and 0.25 measured off the video. */
      const PERSP = 1250;
      /* GENTLER AND FROZEN, because the turn below now supplies depth of its
         own. Aperture III had no fold, so an unbounded d-squared at 750 was
         safe; multiplied by the turn's falloff it takes the far works to
         specks — 0.29 x 0.55 is a different thing from 0.29. */
      const DEPTH = 430;
      const BIAS_MAX = 1.6;
      /* The reference's gutter is 3px on a 1068px frame. Edge-to-edge, as
         everywhere else here: added to the RENDERED half-widths either side,
         so it is the true gap between two works whatever their shapes. */
      const GAP = 4;
      const n = cards.length;

      const s = new Array(n), wr = new Array(n);
      for (let i = 0; i < n; i++) {
        const d = Math.min(Math.abs(i - phase), BIAS_MAX);
        s[i] = PERSP / (PERSP + DEPTH * d * d);
        wr[i] = W[i] * s[i];
      }

      /* Half of mine, the gutter, half of yours. */
      const pos = new Array(n);
      pos[0] = 0;
      for (let i = 1; i < n; i++) pos[i] = pos[i - 1] + wr[i - 1] / 2 + GAP + wr[i] / 2;

      /* Slide the row so the work at `phase` sits on the centre line,
         interpolated between neighbours so the travel is continuous rather
         than snapping from one work to the next. */
      const k = Math.max(0, Math.min(n - 2, Math.floor(phase)));
      const f = Math.max(0, Math.min(1, phase - k));
      const offset = pos[k] + (pos[k + 1] - pos[k]) * f;

      /* ══ THE TURN ════════════════════════════════════════════════
         `pos` above is no longer a screen coordinate. It is ARC LENGTH along
         a path, and the path is a hockey stick laid on its side: dead
         straight through the middle of the frame, then curving away from the
         camera at both ends.

         The straight part is what keeps the gutter. Inside |u| <= U0 there is
         no foreshortening at all, so two consecutive works stay exactly GAP
         apart whatever their shapes — the reference's hairline is untouched.

         Past U0 the path bends onto a circle of radius FOLD_R. Works swing
         out, shrink and dim; and because a circle comes back round, so do
         they. A work far enough along has travelled past the outside of the
         turn and is on its way back towards the centre, small and dim and
         behind the near ones. That returning chain is what makes this read as
         a carousel rather than a strip that runs out of frame.

         U0 at 0.62 of the width keeps two works clear either side of the
         centre before the turn takes them — matching how many the reference
         shows square-on. */
      const U0 = innerWidth * 0.62;
      const FOLD_R = innerWidth * 0.34;

      let best = 0, bestD = Infinity;
      for (let i = 0; i < n; i++) {
        const u = pos[i] - offset;
        const a = Math.abs(u), sgn = u < 0 ? -1 : 1;
        const c = cards[i];

        /* Travel is on X ONLY. The circle is in plan — a carousel seen level,
           not a wheel seen face-on — so every work keeps the one shared
           vertical axis. */
        let x = u, sf = 1, dep = 0, gone = false;
        if (a > U0) {
          const th = Math.min((a - U0) / FOLD_R, Math.PI);
          const zf = FOLD_R * (1 - Math.cos(th));
          sf = PERSP / (PERSP + zf);
          x = sgn * (U0 + FOLD_R * Math.sin(th)) * sf;
          dep = th / Math.PI;
          /* Culled at the far side of the turn, where the chain would double
             back through itself. */
          gone = th >= Math.PI * 0.985;
        }

        const st = s[i] * sf;
        /* FADED OUT BEFORE IT IS CULLED. The cull fires at the far side of the
           turn, where the chain would double back through itself — but a work
           returning round the back arrives at x = -468 in a 1280 window, which
           is well inside the frame. Measured, it was still at 0.16 opacity
           when it was switched off: a visible pop, on screen, every lap. The
           last quarter of the turn now takes it to nothing first, so the cull
           only ever removes something already invisible. */
        const fade = dep > 0.75 ? Math.max(0, (1 - dep) / 0.25) : 1;
        const op = Math.max(0, Math.pow(st, 1.15) * (1 - dep * 0.4) * fade);

        /* How far round the turn this work is: 0 through the straight run,
           1 at the far side. Exposed because it is the one piece of state that
           says whether a work is on the straight — without it the gutter
           cannot be checked, since a returning work passes BEHIND the near
           ones and reads as a negative gap to anything measuring blind. */
        c.style.setProperty('--fold', dep.toFixed(3));
        c.style.setProperty('--tx', `${x.toFixed(1)}px`);
        c.style.setProperty('--s', st.toFixed(4));
        /* THE CULL NO LONGER TOUCHES visibility, AND THAT IS THE POINT.
           `visibility: hidden` stops an element being painted, which
           takes its composited surface down with it — and .wcard carries
           will-change: transform, opacity, so that surface is exactly
           what we are paying to keep. Measured, this flipped 32 times
           across one scroll of the section: thirty-two surfaces thrown
           away and rebuilt, each holding a large image, at the moments
           you are scrolling fastest.

           Nothing is lost by dropping it. --op already reaches 0 before
           the cull fires — the last quarter of the turn takes it there,
           see the note above — so clamping it to a hard 0 leaves the work
           invisible by the same means everything else here uses.

           `inert` does the rest of visibility's job: out of the tab order
           and deaf to the pointer, so an invisible work cannot be clicked
           or focused. It is an attribute, not a paint property, so the
           surface survives. Guarded because writing an attribute that is
           already set still invalidates style. */
        c.style.setProperty('--op', gone ? '0' : op.toFixed(3));
        if (gone !== c.hasAttribute('inert')) c.toggleAttribute('inert', gone);

        const ad = Math.abs(i - phase);
        if (ad < bestD) { bestD = ad; best = i; }
      }
      /* THE EARLY RETURN USED TO SIT HERE, and it cost two things. The
         playhead only moved when the ACTIVE WORK changed, so it stepped from
         tick to tick instead of sliding with the scroll. And a readout write
         cancelled mid-flight by clearTimeout could never be rescheduled,
         because `best === last` bailed out before reaching it — measured, the
         caption sat on "Mere Ho" while the centred work was "Bloody Bubbly".
         Only the work that is genuinely per-change is guarded now. */
      if (best !== last) {
        last = best;
        warmAround(best);
        cards.forEach((c, i) => { c.style.zIndex = String(100 - Math.abs(i - best)); });
      }

      /* ══ THE SCALE TURNS; THE INDEX MARK DOES NOT ════════════════
         This was the reverse — a playhead sliding along a flat ruler, placed
         each frame from ticks[k].offsetLeft. Under the arc the sixteen marks
         are absolutely positioned and rotated about a point 344px above the
         strip, so they all share one offsetLeft and there is nothing left to
         interpolate between: the movement is the row's rotation instead.

         IT IS `phase`, NOT A ROUNDED INDEX, and that costs nothing — phase
         is already computed above for the conveyor itself, so the readout
         rides the same continuous number the pictures do and cannot drift
         away from them. No second scroll listener, no second
         getBoundingClientRect: the one forced layout this handler performs
         now serves both the works and their scale.

         GUARDED ON A CHANGE OF 0.001 because a custom-property write
         invalidates style whether or not the value differs, and at 3.6deg
         per unit a thousandth of a step is 0.0036deg — far below anything
         that can reach a pixel. */
      if (row && Math.abs(phase - ring) > 0.001) {
        ring = phase;
        row.style.setProperty('--ring', phase.toFixed(3));
      }

      /* WRITTEN IMMEDIATELY; THE FADE IS PRESENTATION ONLY.
         This was a debounced write on a 130ms timer, and the timer was being
         starved: paint runs on every scroll event, Lenis emits them for well
         over a second after a jump, and clearTimeout cancelled the queued
         write every time — measured, the caption sat on the first work
         through the whole scroll with is-turning stuck on, so the readout was
         both wrong AND faded out. Guarding the reschedule on the target index
         did not fix it either.

         So the text is set the moment the centred work changes, and the fade
         is a CSS animation restarted by re-adding the class. Worst case, if
         the class handling ever misbehaves, is a caption that does not
         animate — never one that lies about which work you are looking at. */
      if (readout && written !== best) {
        written = best;
        if (title) title.textContent = cards[best].dataset.title || '';
        if (year) year.textContent = cards[best].dataset.year || '';
        /* The lit mark belongs HERE and not with the rotation above: which
           work you are on is a discrete fact that changes sixteen times in
           the whole section, and this is the one place that already knows
           it has changed. Hung off the rotation it would be a sixteen-class
           toggle every frame. */
        ticks.forEach((x, i) => x.classList.toggle('is-on', i === best));
        readout.classList.remove('is-turning');
        void readout.offsetWidth;            /* restart the animation */
        readout.classList.add('is-turning');
      }
    };
    addEventListener('scroll', () => { if (!raf) raf = requestAnimationFrame(paint); }, { passive: true });
    addEventListener('resize', () => { if (!raf) raf = requestAnimationFrame(paint); }, { passive: true });
    paint();
  }

  function initRunningHead() {
    const rh = document.querySelector('[data-runhead]') as HTMLElement | null;
    if (!rh || rh.dataset.bound) return;
    rh.dataset.bound = '1';
    const mv = rh.querySelector('[data-rh-mv]') as HTMLElement;
    const folio = rh.querySelector('[data-rh-folio]') as HTMLElement;
    const secs = Array.from(document.querySelectorAll('[data-mv]')) as HTMLElement[];
    const NAMES = [{n:"01",t:"Selected works"},{n:"02",t:"Who I am"},{n:"03",t:"What I work across"},{n:"04",t:"How I work"},{n:"05",t:"What I’m after"},{n:"06",t:"Contact"}];
    if (!secs.length) return;

    let raf = 0, last = -1, turn = 0;
    const paint = () => {
      raf = 0;
      const line = scrollY + innerHeight * 0.4;
      let now = -1;
      for (const s of secs) if (line >= s.offsetTop) now = Number(s.dataset.mv);
      if (now === last) return;
      last = now;
      rh.classList.add('is-turning');
      clearTimeout(turn);
      turn = window.setTimeout(() => {
        if (now < 0) { mv.textContent = ''; folio.textContent = ''; }
        else { mv.textContent = NAMES[now].t; folio.textContent = NAMES[now].n + '/06'; }
        rh.classList.remove('is-turning');
      }, 200);
    };
    addEventListener('scroll', () => { if (!raf) raf = requestAnimationFrame(paint); }, { passive: true });
    addEventListener('resize', () => { if (!raf) raf = requestAnimationFrame(paint); }, { passive: true });
    paint();
  }

  /* The opening's name drifts up more slowly than the page, so the hand-over
     to the works reads as a camera move rather than a cut. Additive: with no
     script --drift is unset and the name simply sits where it is laid out. */
  function initDrift() {
    const mast = document.querySelector('.ov--mono .ov__mast') as HTMLElement | null;
    if (!mast || mast.dataset.bound) return;
    mast.dataset.bound = '1';
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    let raf = 0;
    const paint = () => {
      raf = 0;
      const d = Math.min(innerHeight, Math.max(0, scrollY)) * 0.18;
      mast.style.setProperty('--drift', `${d.toFixed(1)}px`);
    };
    addEventListener('scroll', () => { if (!raf) raf = requestAnimationFrame(paint); }, { passive: true });
    paint();
  }

  initOpWorks();
  initRunningHead();
  initDrift();
  document.addEventListener('astro:page-load', () => { initOpWorks(); initRunningHead(); initDrift(); });
</script>

<style>
  /* ── --prog IS DECLARED, SO THAT IT STOPS INHERITING ────────────
     A custom property inherits by default, which means writing one on .rg
     asks the browser to recompute style for all 1133 elements beneath it.
     Measured, that is 2.6ms every frame — and it is charged whether or not
     anything reads the value: a name nothing consumes cost the same 2.2ms
     in the same test.

     Declaring it as a number that does not inherit ends that. The value is
     then visible only on the element it is set on, which is why the write
     moves onto .ms__bed in initSpine below; the two changes are one change
     and neither works alone. With both: 0.0ms.

     UNSUPPORTED IS SAFE. A browser that does not know @property ignores this
     block, --prog inherits as it always did, and the moved write still cuts
     the recompute from 1133 elements to the bed's 150 — measured 0.3ms. */
  /* Declared for the same reason --prog is: a custom property inherits by
     default, and writing one per frame on an element with descendants
     recomputes style for all of them. --ring is written on .rl__ticks,
     which has sixteen, and read only by .rl__ticks itself — so it has no
     business inheriting at all. */
  @property --ring {
    syntax: '<number>';
    inherits: false;
    initial-value: 0;
  }

  @property --prog {
    syntax: '<number>';
    inherits: false;
    initial-value: 0;
  }

  .rg {
    --tier-0: clamp(2.75rem, 10vw, 9rem);
    --tier-1: clamp(2.5rem, 8vw, 7.5rem);
    --tier-2: clamp(1.75rem, 5vw, 4.25rem);
    --tier-3: clamp(1.5rem, 2.8vw, 2.5rem);
