---
/**
 * ST6 · THE INDEX — a catalogue in type; the picture comes on request.
 *
 * THE IDEA: treat the stills as an archive rather than a gallery. The section
 * is a list — number, description, ratio, hairline — set as type and readable
 * with no images loaded at all. The plate beside it answers whichever row you
 * are on. So the primary medium of the stills section is WRITING, and the
 * photograph is the footnote.
 *
 * WHY IT SUITS THIS WORK: the page already carries a long record set in mono
 * — the roles, the festival line, the colophon. An index extends that voice
 * instead of interrupting it, and it is the only direction of the eight in
 * which the stills section can be skimmed.
 *
 * WHAT IT COSTS: it is the least photographic presentation of a set of
 * photographs, and it depends entirely on the descriptions being good. The
 * ones below are mine and are flagged as such.
 *
 * THE ROW IS A BUTTON, NOT A HOVER TARGET. Pointer, keyboard and touch all
 * reach it the same way, and the plate does not change under a cursor that
 * is only passing through — see the dwell guard in the script.
 */
import Base from '../../layouts/Base.astro';
import OpNav from '../../components/OpNav.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { framesFor } from '../../lib/frames';
import { href } from '../../lib/href';

/* THE REAL WORK AND THE REAL STILLS. Nothing on this page is mocked: the
   collection is the same one /work/aasha renders from, so the frames, the
   title, the roles, the statement and the standfirst are the page's own, and
   the harness around the draft — header, quote, lede, colophon — is the work
   page's own CSS, condensed. The ONLY variable between ab-st1 and ab-st8 is
   the section below the "03 · Stills" rule.

   THE PRODUCTION PAGE IS NOT TOUCHED. src/pages/work/[slug].astro is
   untouched by all eight; these are additive preview routes and
   `withoutPreview()` keeps them out of the built site. */
const works = await getCollection('works');
const work = works.find((w) => w.id === 'aasha')!;
const d = work.data;
const images = framesFor('aasha', d.frames);
const LEDE = (d.description.trim().match(/^[^.!?]+[.!?]/) ?? [d.description.trim()])[0];
const ROLES = d.role.split('·').map((r) => r.trim());
const nn = (i: number) => String(i + 1).padStart(2, '0');

const DRAFTS: [string, string, string][] = [
  ['st1', 'The select', 'Curation made visible'],
  ['st2', 'The gate', 'One frame; the scroll cuts'],
  ['st3', 'The dark', 'No borders; the black joins'],
  ['st4', 'The reel', 'One continuous band'],
  ['st5', 'The pair', 'Four diptychs'],
  ['st6', 'The index', 'A catalogue in type'],
  ['st7', 'The fall', 'Sequencing as rhythm'],
  ['st8', 'The aperture', 'The film moves behind'],
];
const ME = 'st6';
const MINE = DRAFTS.find(([id]) => id === ME)!;

/* <- MY DESCRIPTIONS, NOT CAPTIONS FROM THE FILM. Each line says only what is
   visible in that frame, in reading order, and nothing about the story. They
   are placeholder copy in the sense that matters: the design needs eight short
   lines of roughly this length, and Ugam should replace them with his own. */
const DESCR = [
  'A face, turned to the lens',
  'The same face, in a mirror',
  'A tap, a can, the floor',
  'An eye, out of the dark',
  'Light through the slats',
  'Laughing',
  'A room, a meal',
  'Behind the window bars',
];
---

<Base title={`${d.title} · ${MINE[1]} — stills draft ${ME.toUpperCase()}`} description={`A design direction for the stills section of the Aasha project page: ${MINE[2]}.`}>
  <OpNav variant="bracket" base={href()} />

  <nav class="sw" aria-label="Stills drafts">
    <span class="sw__id">{ME.toUpperCase()}</span>
    <span class="sw__nm">{MINE[1]}</span>
    <span class="sw__su">{MINE[2]}</span>
    <span class="sw__set">
      {DRAFTS.map(([id, name, sub]) => (
        <a class:list={['sw__i', { 'is-here': id === ME }]} href={href(`preview/ab-${id}`)}
          title={`${name} — ${sub}`} aria-current={id === ME ? 'page' : undefined}>{id.slice(2)}</a>
      ))}
    </span>
  </nav>

  <article class="sc" style={`--ar:${d.ratio.replace(':', ' / ')}`}>
    <header class="hd">
      <p class="mono hd__over">{d.category} · {d.year}</p>
      <h1 class="hd__t">{d.title}</h1>
      <p class="mono hd__meta"><span class="hd__roles">{ROLES.map((r) => <span>{r}</span>)}</span></p>
    </header>

    {d.quote && (
      <section class="q" aria-label="Statement">
        <p class="q__t">{d.quote}</p>
      </section>
    )}

    <section class="blk body" aria-label="About">
      <p class="body__lede" style={`--n:${LEDE.length}`}>{LEDE}</p>
    </section>

    <!-- ══ 03 · STILLS — THE DRAFT ═══════════════════════════════════ -->
    <section class="blk st" aria-label="Stills">
      <p class="mono st__lbl"><span>03</span><i aria-hidden="true"></i><span>Stills · {MINE[1]}</span></p>
      <div class="ix" data-ix>
        <div class="ix__list" role="group" aria-label="Frames">
          {DESCR.map((t, i) => (
            <button class:list={['ix__row', { 'is-on': i === 0 }]} type="button" data-ix-r={i}>
              <span class="mono ix__n">{nn(i)}</span>
              <span class="ix__t">{t}</span>
              <span class="ix__rl" aria-hidden="true"></span>
              <span class="mono ix__m">{d.ratio}</span>
            </button>
          ))}
        </div>

        <div class="ix__plate">
          <div class="ix__hold">
            {images.map((img, i) => (
              <span class:list={['ix__f', { 'is-on': i === 0 }]} data-ix-f={i}>
                <Image src={img} alt={i === 0 ? d.alt : ''} aria-hidden={i === 0 ? undefined : 'true'}
                  widths={[460, 760, 1060]} sizes="(max-width: 860px) 92vw, 42vw"
                  loading={i < 2 ? 'eager' : 'lazy'} decoding="async" />
              </span>
            ))}
          </div>
          <p class="mono ix__cap"><b data-ix-no>01</b><i aria-hidden="true"></i><span data-ix-t>{DESCR[0]}</span></p>
        </div>
      </div>
    </section>

    <footer class="cl">
      <hr class="rule" />
      <p class="mono cl__p"><span>{MINE[0].toUpperCase()} · {MINE[1]}</span><i aria-hidden="true"></i><span>{d.awards}</span></p>
    </footer>
  </article>
</Base>

<script>
  /* DWELL BEFORE SWAPPING. A cursor crossing the list to reach something else
     should not flip the plate eight times on the way; a click or a focus is
     deliberate and takes effect at once. */
  const ix = document.querySelector<HTMLElement>('[data-ix]');
  if (ix) {
    const rows = [...ix.querySelectorAll<HTMLButtonElement>('[data-ix-r]')];
    const frames = [...ix.querySelectorAll<HTMLElement>('[data-ix-f]')];
    const no = ix.querySelector<HTMLElement>('[data-ix-no]');
    const cap = ix.querySelector<HTMLElement>('[data-ix-t]');
    let at = 0, timer = 0;

    const show = (i: number) => {
      if (i === at) return;
      at = i;
      rows.forEach((r, k) => r.classList.toggle('is-on', k === i));
      frames.forEach((f, k) => f.classList.toggle('is-on', k === i));
      if (no) no.textContent = String(i + 1).padStart(2, '0');
      if (cap) cap.textContent = rows[i].querySelector('.ix__t')?.textContent ?? '';
    };
    const later = (i: number) => { clearTimeout(timer); timer = window.setTimeout(() => show(i), 90); };
    const now = (i: number) => { clearTimeout(timer); show(i); };

    rows.forEach((r, i) => {
      r.addEventListener('pointerenter', (e) => { if (e.pointerType !== 'touch') later(i); });
      r.addEventListener('click', () => now(i));
      r.addEventListener('focus', () => now(i));
    });
    ix.querySelector('.ix__list')?.addEventListener('pointerleave', () => clearTimeout(timer));
    (window as any).ixShow = show;
  }
</script>

<style>
  /* ══ THE HARNESS ═══════════════════════════════════════════════════
     Deliberately the work page's own type and rhythm, so the only thing
     being judged below the rule is the stills section. Shared verbatim by
     all eight drafts. */
  .sw {
    position: fixed; inset: 0 0 auto; z-index: 900;
    display: flex; align-items: baseline; gap: 12px;
    padding: 9px clamp(16px, 4vw, 40px);
    background: color-mix(in srgb, var(--ground) 86%, transparent);
    backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--rule);
    font-family: var(--mono); font-size: var(--t-micro);
    letter-spacing: 0.16em; text-transform: uppercase;
  }
  .sw__id { color: var(--accent); }
  .sw__nm { color: var(--bone); }
  .sw__su { color: var(--dim); margin-right: auto; }
  .sw__set { display: flex; gap: 1px; }
  .sw__i {
    color: var(--dim); text-decoration: none; padding: 3px 7px;
    border: 1px solid transparent; font-variant-numeric: tabular-nums;
  }
  .sw__i:hover { color: var(--bone); }
  .sw__i.is-here { color: var(--accent); border-color: var(--rule); }
  @media (max-width: 720px) { .sw__su { display: none; } .sw__nm { margin-right: auto; } }
  @media (max-width: 460px) { .sw__nm { display: none; } }

  .sc { padding: clamp(84px, 13vh, 150px) var(--margin) 0; }
  .hd { text-align: center; margin-bottom: clamp(38px, 6.6vh, 80px); }
  .hd__over { font-size: var(--t-micro); letter-spacing: 0.18em; text-transform: uppercase; color: var(--muted); margin: 0 0 clamp(16px, 2.6vh, 30px); }
  .hd__t { margin: 0; font-family: var(--display); font-weight: 500; font-size: clamp(2.6rem, 7vw, 5.6rem); line-height: 0.94; letter-spacing: -0.04em; color: var(--bone); }
  .hd__meta { margin: clamp(14px, 2.2vh, 26px) 0 0; font-size: var(--t-micro); letter-spacing: 0.18em; text-transform: uppercase; color: var(--bone-dim); }
  .hd__roles { display: inline-flex; flex-wrap: wrap; justify-content: center; gap: 0 14px; }
  .hd__roles span + span::before { content: '·'; margin-right: 14px; color: var(--dim); }
  .q { max-width: 34ch; margin: 0 auto clamp(50px, 8vh, 110px); text-align: center; }
  .q__t { margin: 0; font-family: var(--serif); font-style: italic; font-weight: 300; font-size: clamp(1.25rem, 2.4vw, 1.9rem); line-height: 1.26; letter-spacing: -0.012em; color: var(--bone-dim); }
  .body { max-width: var(--measure); margin-inline: auto; }
  .body__lede { margin: 0 auto; max-width: clamp(20ch, calc(var(--n, 90) / 3 * 1ch), 44ch); font-family: var(--display); font-weight: 500; font-size: clamp(1.2rem, min(calc(2.35rem - (var(--n, 90) - 55) * 0.007rem), calc(1.05rem + 2.1vw)), 2.2rem); line-height: 1.12; letter-spacing: -0.025em; color: var(--bone); text-wrap: balance; }
  .blk { margin: 0 auto clamp(104px, 18vh, 240px); }

  /* The section label matches whatever width the draft chose for itself. */
  .st { --w: var(--measure); }
  .st__lbl {
    display: flex; align-items: center; gap: 12px;
    width: var(--w); margin: 0 auto clamp(24px, 4vh, 50px);
    font-size: var(--t-micro); letter-spacing: 0.18em; text-transform: uppercase; color: var(--muted);
  }
  .st__lbl i { flex: 1; height: 1px; background: var(--rule); }

  .cl { max-width: var(--measure); margin: 0 auto; padding-bottom: clamp(48px, 9vh, 110px); }
  .rule { border: 0; border-top: 1px solid var(--rule); margin: 0 0 16px; }
  .cl__p {
    display: flex; align-items: baseline; gap: 14px; margin: 0;
    font-size: var(--t-micro); letter-spacing: 0.16em; text-transform: uppercase; color: var(--dim);
  }
  .cl__p i { flex: 1; height: 1px; background: var(--rule); transform: translateY(-3px); }
  .cl__p span:last-child { text-align: right; }
  @media (max-width: 620px) { .cl__p { flex-direction: column; gap: 6px; } .cl__p i { display: none; } .cl__p span:last-child { text-align: left; } }

  /* ── ST6 · THE INDEX ───────────────────────────────────────── */
  .st { --w: min(calc(100vw - 2 * var(--margin)), 1180px); }
  .ix {
    width: var(--w); margin-inline: auto;
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 0.84fr);
    gap: clamp(28px, 4vw, 64px); align-items: start;
  }

  .ix__row {
    display: grid; grid-template-columns: 2.6em minmax(0, auto) minmax(18px, 1fr) auto;
    align-items: baseline; gap: 12px;
    width: 100%; padding: clamp(11px, 1.5vh, 17px) 0;
    border: 0; border-top: 1px solid var(--rule); background: none;
    text-align: left; cursor: pointer; -webkit-tap-highlight-color: transparent;
  }
  .ix__row:last-child { border-bottom: 1px solid var(--rule); }
  .ix__n { font-size: var(--t-micro); letter-spacing: 0.16em; color: var(--dim); font-variant-numeric: tabular-nums; }
  .ix__t {
    font-family: var(--display); font-weight: 500;
    font-size: clamp(1.02rem, 1.7vw, 1.46rem); line-height: 1.1; letter-spacing: -0.02em;
    color: var(--muted);
  }
  .ix__rl { height: 1px; background: var(--rule); transform: translateY(-0.3em); }
  .ix__m { font-size: var(--t-micro); letter-spacing: 0.16em; color: color-mix(in srgb, var(--dim) 62%, var(--ground)); }

  .ix__row:hover .ix__t, .ix__row:focus-visible .ix__t { color: var(--bone-dim); }
  .ix__row:focus-visible { outline: 1px solid var(--accent); outline-offset: 2px; }
  .ix__row.is-on .ix__t { color: var(--bone); }
  .ix__row.is-on .ix__n { color: var(--accent); }
  .ix__row.is-on .ix__rl { background: var(--accent); }
  @media (prefers-reduced-motion: no-preference) {
    .ix__t, .ix__n, .ix__rl { transition: color 140ms linear, background-color 140ms linear; }
  }

  /* The plate follows the list down, because the list is longer than it. */
  .ix__plate { position: sticky; top: clamp(70px, 12vh, 118px); }
  .ix__hold {
    position: relative; aspect-ratio: var(--ar);
    background: var(--ground-lift); overflow: hidden;
  }
  .ix__f { position: absolute; inset: 0; opacity: 0; }
  .ix__f.is-on { opacity: 1; }
  .ix__f img { width: 100%; height: 100%; object-fit: cover; display: block; }
  @media (prefers-reduced-motion: no-preference) {
    .ix__f { transition: opacity 150ms linear; }
  }
  .ix__cap {
    display: flex; align-items: baseline; gap: 10px; margin: 10px 0 0;
    font-size: var(--t-micro); letter-spacing: 0.16em; text-transform: uppercase; color: var(--dim);
  }
  .ix__cap b { font-weight: 400; color: var(--accent); font-variant-numeric: tabular-nums; }
  .ix__cap i { width: 18px; height: 1px; background: var(--rule); transform: translateY(-3px); flex: none; }

  @media (max-width: 860px) {
    /* The plate goes first and stays put; the list reads under it. */
    .ix { grid-template-columns: 1fr; gap: 22px; }
    .ix__plate { position: static; order: -1; }
    .ix__row { grid-template-columns: 2.4em minmax(0, auto) minmax(14px, 1fr) auto; }
  }
</style>
