  .rec {
    margin: clamp(56px, 9vh, 110px) 0 0;
  }
  .rec__list {
    margin: 0; padding: 0; list-style: none;
    display: grid;
    /* What the hairline between rows used to do. */
    gap: clamp(22px, 3.4vh, 40px);
  }
  .rec__row {
    display: grid;
    /* A fixed figure column, so every festival starts on one left edge. */
    grid-template-columns: clamp(44px, 5vw, 68px) minmax(0, 1fr);
    align-items: baseline;
    gap: clamp(10px, 2vw, 24px);
  }
  .rec__n {
    font-size: var(--t-micro); letter-spacing: var(--track-mono);
    color: var(--dim); font-variant-numeric: tabular-nums;
  }
  .rec__body { display: grid; gap: clamp(6px, 1vh, 11px); }
  .rec__cit {
    font-size: var(--t-micro); letter-spacing: 0.16em;
    text-transform: uppercase; color: var(--accent);
  }
  .rec__star { margin-right: 0.5em; color: var(--accent); }

  /* B · PARALLAX ON RECOGNITION, applied 2026-09-07.

     THE TWO HALVES OF A ROW ARRIVE AT DIFFERENT RATES. The figure and the
     honour ride at the page's own --v; the festival that gave it lags on --v
     SQUARED. So the small mono key is already legible while the thing it
     names is still coming up, which is the order a row is read in.

     A LAG IS A SQUARE, NOT A DELAY. v * v is behind v everywhere except at
     the two ends, where both are exactly 0 and exactly 1 — the halves
     separate through the middle and land together, with no timer, nothing to
     keep in step, and a clean reverse on the way back up.

     EACH ROW HAS ITS OWN --v, so Diwali's three selections cascade as they
     cross the reading line rather than arriving as a block. That is the whole
     reason `data-reveal` came OFF this section: the site's global reveal adds
     `.is-in` once, on first intersection, and gives the whole block a 14px
     rise that never plays again and never reverses. Two reveals on one
     element fight; this one replaces it.

     NO display DECLARATION IS NEEDED and none is written. .rec__row is a grid
     and .rec__body is a grid, so every part named here is already a grid item
     and therefore blockified — a transform applies without help. Adding
     `display: inline-block` would have been a line that does nothing, which
     is worse than no line at all.

     THE TALLY WORKS ARE UNTOUCHED. Aasha and Broken Reflections set their
     record as three big figures on a ruled band rather than as citations;
     that is a different element with a different shape and this rule does not
     reach it. Six works get this: Book My Yamraj, Dinshaw's, Diwali, Moholla,
     Mumbai Standard Time and My Red Crayon. */
  .rec__row {
    --v2: calc(var(--v, 1) * var(--v, 1));
  }
  .rec__n, .rec__cit {
    opacity: calc(0.14 + var(--v, 1) * 0.86);
    transform: translateY(calc((1 - var(--v, 1)) * 0.34em));
    will-change: opacity, transform;
  }
  .rec__where {
    opacity: calc(0.08 + var(--v2, 1) * 0.92);
    transform: translateY(calc((1 - var(--v2, 1)) * 0.6em));
    will-change: opacity, transform;
  }
  /* The one thing on the row that differs from the row above it, so the one
     thing set at size. */
  .rec__where {
    font-family: var(--display); font-weight: 500;
    font-size: clamp(1.3rem, 3vw, 2.35rem);
    line-height: 1.06; letter-spacing: -0.035em;
    color: var(--bone); text-wrap: balance;
  }
  @media (max-width: 620px) {
    .tally__row { grid-template-columns: 1fr; }
    .tally__cell + .tally__cell {
      border-left: 0; border-top: 1px solid var(--rule-soft);
      margin-top: clamp(20px, 4vh, 32px); padding-top: clamp(20px, 4vh, 32px);
    }
  }

  /* ── CREDITS — XV's ruled table ─────────────────────────────── */
  /* One hairline per edge: the table draws its own left and top, each cell
     its right and bottom. Drawn on all four, every internal edge doubles and
     reads at 1px on a dark ground as uneven weight, not a heavier rule. */

  /* ── FRAMES ─────────────────────────────────────────────────── */
  /* auto-fill so a short last row keeps the cell size of the row above it,
     and a track sized to the work's own aspect — see the note on the page. */
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(var(--sw, 340px), 100%), 1fr));
    gap: clamp(20px, 2.6vw, 46px);
  }
  .cel { margin: 0; }
  /* Entry is the site's own reveal, staggered by column so a row arrives as a
     sweep rather than as three things at once. */
  .cel[data-reveal] {
    opacity: 0;
    transform: translateY(18px);
    transition:
      opacity var(--d-reveal) var(--ease) calc(var(--i) * 90ms),
      transform var(--d-reveal) var(--ease) calc(var(--i) * 90ms);
  }
  .cel[data-reveal].is-in { opacity: 1; transform: none; }
  .cel__win {
    display: block; aspect-ratio: var(--ar);
    overflow: hidden; background: var(--ground-lift);
  }
  .cel__win :global(img) {
    width: 100%; height: 100%; object-fit: cover;
    /* See FRAME_CROP in src/lib/frames.ts — the crop window sits on the
       picture rather than on the file, for the two works with baked-in bars. */
    object-position: 50% var(--fcy, 50%);
    filter: saturate(0.94) contrast(1.02);
    transform: scale(1.001);
    transition: filter var(--d-micro) var(--ease), transform 1100ms var(--ease);
  }
  .cel:hover .cel__win :global(img) {
    filter: saturate(1) contrast(1.06) brightness(1.04);
    transform: scale(1.035);
  }
  .cel__no {
    display: block; margin-top: 8px;
    font-size: var(--t-micro); letter-spacing: 0.16em;
    color: var(--dim); font-variant-numeric: tabular-nums;
  }
  /* Below this the track governs on its own — a fixed two columns would make
     a portrait still taller on a phone than it is on a desktop. */
  @media (max-width: 720px) { .grid { --sw: min(46vw, 220px); } }

  /* ── CREDITS ────────────────────────────────────────────────── */

  /* ── REDUCED MOTION HANDS OVER THE SENTENCE ─────────────────── */
  @media (prefers-reduced-motion: reduce) {
    .w { opacity: 1; transform: none; will-change: auto; }
    .cel[data-reveal] { opacity: 1; transform: none; transition: none; }
    .rec__n, .rec__cit, .rec__where { opacity: 1; transform: none; will-change: auto; }
    .body__lede, .body__rest { opacity: 1; transform: none; will-change: auto; }
    .wt__t, .wt__arw { opacity: 1; transform: none; will-change: auto; }
    .cr__k, .cr__v { opacity: 1; transform: none; will-change: auto; }
  }

  /* ══ XXIV · NO RULES ══════════════════════════════════════════════
     Space divides instead of lines. The only rule left on the page is the one
     the clock draws, which is why it reads as a mark rather than furniture. */
  .blk { margin-bottom: clamp(104px, 18vh, 240px); }

  /* The recognition band loses its two rules and its cell hairlines. */
  .tally {
    margin-top: clamp(56px, 9vh, 110px);
    padding-block: 0;
    border-top: 0; border-bottom: 0;
  }
  .tally__cell + .tally__cell { border-left: 0; }
  .tally__row { gap: clamp(20px, 3vw, 56px); }

  /* The credit table loses every border and becomes cells held apart by
     gaps. The label colour is what keeps the pairs legible without them. */

  /* The ghost folio is gone. It set the section's number at 13vw behind each
     heading at 0.04 opacity — decorative, and the only ornament on the page.
     Removed on request. Its `.blk { position: relative }` and the
     `.blk > :not(.fol)` layering went with it: the only thing that needed a
     positioned ancestor was the folio itself, and `.rl` anchors to
     the label it hung on, which carried its own.

     THE HEAD'S FOLIO IS ALSO GONE NOW. This used to end by saying the
     sections were still numbered where it mattered, because the line at the
     top of the page read "007 / 16". It does not: J1 replaced it with the
     category and year on 2026-09-06, so there is no number anywhere on a work
     page any more, and since /contents was removed on 2026-09-07 the
     catalogue is not counted anywhere on the site. */

  /* ══ ONE MEASURE ══════════════════════════════════════════════════
     Borrowed from preview XXII "Measure". Every block sits on the same
     narrow column, so the page has exactly two vertical edges and
     everything begins and ends on them. Minimalism here is a rule about
     WIDTH rather than about removing anything: nothing else changes.

     760px, not the 1180px these blocks were drawn at. The body loses its
     own 60ch cap so it fills the measure rather than sitting narrower
     still inside it — one column, one edge.

     THE STILLS GRID IS DELIBERATELY LEFT ALONE, which is where this
     departs from the reference. XXII forces two columns because it was
     built for Aasha; measured across the catalogue, the live grid's
     ratio-aware auto-fill already lands on two for thirteen of the sixteen
     works at this measure, and on three for the three 9:16 portrait works —
     which is better than two would be for them. Forcing it would throw that
     away to match a draft that only ever had one ratio to satisfy.

     The credit table does drop to two. Three cells on a 760px measure
     leaves about 215px each, which is not enough for a value to sit on one
     line — that is a real consequence of narrowing, so it is carried. The
     existing 860px rule cannot do it: that is a viewport query, and the
     viewport is still wide. */
  .sc { --measure: min(760px, 100%); }
  .hd, .q, .blk { max-width: var(--measure); }
  /* The one-measure pass gave .body its own width; it is a wrapper now and
     its two paragraphs carry their own, so there is nothing left to release. */
  .body { max-width: none; }
</style>

<style>
  /* ── MEDIA THE DRAFT DID NOT HAVE TO CARRY ──────────────────── */
  /* XXVI opened on one YouTube facade. These are the other three openings,
     given the same measure and the same ground so a record and a film sit in
     the page identically. */
  /* auto-FILL, not auto-fit: with fit, a last row holding two of six items
     stretches them to half the measure each and the grid stops being a grid.
     Empty tracks keep every film the same size as the row above it. */
  .films {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(var(--fw, 300px), 100%), 1fr));
    gap: clamp(16px, 2.2vw, 34px);
  }
  /* THE SLEEVE IS SIZED LIKE A FILM, CAPPED BY THE WINDOW'S HEIGHT.

     It was clamp(220px, 34vw, 380px) — 380 on a 1280 desktop and 220 on a
     phone, an illustration beside the prose rather than the thing the page is
     about, which is the same fault the bare stills had.

     It takes --film, the SAME width the facade and the stills take, so all
     three kinds of opening share one edge. But a song is 1:1, and --film is
     1016px at 1280 wide, so matching the film exactly would make a block 1016
     TALL in a window 800 tall — the one page where you could not see the
     opening. Hence the 72vh cap, which is on the height because the height is
     the constraint a square has and the 16:9 openings do not.

     THE SOURCES ARE THE OTHER CEILING, and they are why the cap is not looser.
     Ve Maahi's sleeve is 1024x1024 and Mere Ho's 1254x1254, so on a 2x display
     a CSS width over 512 is already an upscale for Ve Maahi. 72vh keeps it
     mild — 576px at 800 tall is 1.13x, invisible — where matching --film would
     ask 1016 CSS px of a 1024 source and render it a visibly soft 2x.

     Measured: 1280x800 -> 576 (was 380), 1440x900 -> 648, 1920x1080 -> 778,
     and 375 wide -> 327, the full measure, where --film wins over 72vh and the
     sleeve lands exactly where a still lands. */
  .cover { position: relative; width: min(var(--film), 72vh); margin-inline: auto; }
  .cover :global(img), .still :global(img) { width: 100%; height: auto; display: block; }
  .still { overflow: hidden; background: var(--ground-lift); }

  /* ══ THE OPENING FILM IS WIDER THAN THE MEASURE ═══════════════════
     D · Inset, chosen from five built as real pages on Aasha and judged in
     the browser. The film stops one and a half --margins in from each window
     edge — measured 1050x590 at 1280x800, against the 760px measure — where
     B stopped at one margin and A held a fixed 920px column.

     ONLY THE FILM MOVES. The label above it, its rule, the statement, the
     body, the stills and the credits all stay on the measure, so the film
     breaks the column and the column is still there to be broken.

     WHICH WORKS GET IT, AND WHY THE SELECTOR IS THE WHOLE ANSWER. The three
     vertical works with multiple episodes — Book My Yamraj's six, Dinshaw's
     four, Aladdin's four — are excluded, and no test for that is written
     anywhere. They carry `media.films`, so they render a `.films` GRID rather
     than a facade, and this rule only reaches `.facade`. The distinction Ugam
     drew is already the distinction the markup makes: one film gets a facade,
     several get a grid. A ratio test would have been a second, weaker way of
     saying the same thing, and would have gone wrong the day a landscape work
     had episodes.

     So this reaches the eight single-video works: seven on YouTube and Diwali
     on Vimeo. Every one of them is landscape or square.

     THE max() IS A FLOOR AND IT IS LOAD-BEARING. --margin bottoms out at 24px
     on a phone, where 100vw - 3 x margin is 303px against a measure of 327 —
     without it the film would be NARROWER THAN THE TEXT beside it. Measured
     at 375x812: it clamps to 327 and sits flush with the column.

     --measure is `min(760px, 100%)` and the 100% in a custom property resolves
     where the property is USED. It is used on .facade, whose containing block
     is .blk, so it resolves to the block's width rather than to .sc's.

     IT ESCAPES BY NEGATIVE INLINE MARGINS, not a wider parent, so .blk keeps
     its max-width and only this child overflows — computed from the SAME
     --film as the width, so the two cannot disagree at any viewport.

     SPECIFICITY IS DELIBERATE. VideoFacade sets `margin-inline: auto` at
     (0,2,0) with its own scope attribute; a plain `.blk :global(.facade)` is
     also (0,2,0) and would be a tie broken by source order, and losing it
     means `auto` wins and the frame stops being centred. The
     :not([data-instagram]) takes this to (0,4,0).

     AND IT MUST STAY IN A SCOPED STYLE BLOCK. The third block in this file is
     `<style is:global>`, where Astro ships :global() as a literal string, no
     browser understands it and the rule is dropped with no error at all —
     the symptom is the element measuring exactly as it did before. HANDOFF
     section 6. */
  .sc { --film: max(var(--measure), calc(100vw - 3 * var(--margin))); }
  .blk :global(.facade:not([data-instagram])) {
    width: var(--film);
    margin-inline: calc((100% - var(--film)) / 2);
  }

  /* BLOODY BUBBLY IS THE ONE VERTICAL WORK WITH A SINGLE VIDEO, so it is not
     in the excluded set and it does not belong in the rule above either: an
     Instagram facade is portrait and carries the post's own chrome.

     It widens on its own terms. 400px is the width Instagram's embed code
     ships with; 540px is the widest their embed supports, and 440 is a tenth
     more than the default and comfortably inside that range, so the mounted
     iframe still matches the facade and nothing jumps on press.

     THE COST IS HEIGHT, because the shape is fixed at 400/700: at 440 the
     frame is 770px tall, which is 96% of an 800px viewport against 88% before.
     That is the trade for widening a portrait frame at all, and it is why this
     is 440 rather than Instagram's full 540 — which would stand 945px tall and
     be taller than the window it is shown in.

     max-width, not --facade-max: that custom property is set INLINE by
     VideoFacade, and an inline custom property beats a stylesheet one. */
  .blk :global(.facade[data-instagram]) { max-width: 440px; }

  /* ══ THE PAGE IS LABELLED ONCE, AND THE CREDITS ARE A COLOPHON ════
     D · Colophon, chosen from nine built as real pages on Aasha.

     FOUR HEADINGS ARE GONE — "The work" (or "Listen"), "The score",
     "Recognition" and "Credits". "Stills" is the only one left, because it is
     the only one naming something a reader cannot infer: a grid of frames
     could be production photos, a gallery, or the film's own stills. The
     others sat over a video, a paragraph, three figures with their own nouns
     ("7 Official Selections"), and a list of labelled values — each of which
     announces itself.

     STILLS WENT TOO, on 2026-09-05, and it was the last one. FIVE headings
     are gone and the page now carries NO visible section label at all — the
     parts are told apart by their content and by the space between them, which
     is what §5's "no rules" note wanted in the first place and never quite
     reached.

     THE DRAWN RULES WENT WITH THEM. Each label carried the hairline that
     scaled in as its section arrived, so removing the last label removed the
     last rule: the `.blk__lbl` and `.rl` classes are gone, and so is the
     `[data-rl]` query in the scroll handler, which would otherwise have sat
     there collecting an empty list for ever. The handler still runs — it
     drives the word-by-word reading light off `[data-w]`, which is untouched
     and was verified working after the change.

     NOTHING IS LOST TO ASSISTIVE TECH. Every section keeps its `aria-label`,
     so the document still announces Watch, Credits and the rest. The headings
     were never the accessible name.

     THE CREDITS ARE A PARAGRAPH, not a table: one running line of pairs
     divided by middots, set at body size, as a colophon is set at the back of
     a book. The `dl` is kept and made inline rather than replaced by a `<p>`,
     so the markup still says "pairs" while reading as prose. `dd` carries a
     default `margin-inline-start` of 40px which has to be reset, or every
     value sits a tab stop from its label.

     SELECTORS ARE ANCHORED TO `.blk` DELIBERATELY. These sections are
     `class="blk cr"` and `class="blk wt"`, so `.blk` and `.cr` match the same
     element at the same (0,2,0) once Astro adds its scope attribute, and the
     tie is settled by which rule the BUNDLE emits last — which is not
     document order: this file's second style block is bundled before its
     first. `.blk.cr` is (0,3,0) and cannot be reordered out of winning.
     HANDOFF §6. */
  .blk.cr { margin-top: clamp(40px, 7vh, 90px); }
  /* THE DOT BETWEEN CATEGORIES IS GONE, 2026-09-06, and space does the
     dividing instead. It used to set " · " between every pair, which put the
     same mark between "Role" and "Director" as the one inside "Neeraj Pandey
     · Shivam Nair" — so the page drew no distinction between a break between
     two credits and a break between two people sharing one. Now the middot
     means one thing only: another item in the SAME category.

     THE ROW BECOMES inline-block RATHER THAN inline, which is what makes the
     gap possible and also fixes something the dots were hiding: an inline row
     could break between its label and its value at the end of a line, so
     "Director" and "Rohan Bakshi" could land on different lines with nothing
     joining them. inline-block keeps every pair whole and wraps between
     pairs, which is the only place a colophon should ever break. */
  .cr__list { margin: 0; display: block; max-width: 62ch; }
  /* THE GAP IS TIGHTENED, AND BOTH GAPS HAD TO MOVE. Measured at 1280 before
     this change: 44px between one pair and the next, against 19px between a
     label and its own value — a ratio of 2.3, which is what made the pairs
     read as pairs once the dot between them was removed.

     So the between-pair gap could not simply be cut. Space is the only thing
     separating one credit from the next now, and taking it to 24px against a
     19px inner gap would have been a ratio of 1.26 — near enough to even that
     "Composer" and "Director" would read as one run.

     THE INNER GAP THEREFORE COMES DOWN WITH IT. The label carried TWO no-break
     spaces after it and now carries one. Both numbers drop by about half and
     the ratio holds, so the pairs still group while the whole block closes up.
     Read off the rendered page at 1280 rather than predicted — I had guessed
     11px and 2.2, and it is 12 and 2.0:

                        was    now
       between pairs    44     24
       label to value   19     12
       ratio           2.3    2.0

     max-width is the guard inline-block needs. A shrink-wrapped box takes its
     content's width, so a value longer than the column would push the page
     wide rather than wrap — the one failure a narrow page must never have.
     Measured at 375, where the list is 327: the widest row in the catalogue
     is Taskaree's three directors at 305, so nothing needs it today. It is
     here so that the next long credit wraps instead of breaking the page. */
  .cr__row { display: inline-block; max-width: 100%; margin-right: clamp(14px, 1.9vw, 26px); }
  .cr__row:last-child { margin-right: 0; }
  .cr__k {
    margin: 0; font-size: var(--t-micro); letter-spacing: 0.14em;
    text-transform: uppercase; color: var(--dim);
  }
  .cr__k::after { content: '\00a0'; }
  .cr__v { margin: 0; font-size: var(--t-md); color: var(--bone); }

  /* C · COLOPHON, applied 2026-09-07, replacing B · Overshoot the same day.

     THE RECOGNITION SECTION'S RULE, AT THE SCALE OF THE WHOLE BLOCK. Every
     label rides the page's own --v and every value lags on --v SQUARED, so
     the colophon arrives once, as a key half and an answer half — which is
     what a colophon is. Recognition already separates its figure from the
     festival this way, and the description its standfirst from its
     paragraph; this is the same device a third time rather than a third idea.

     THE NUMBERS ARE RECOGNITION'S, UNCHANGED — 0.14 and 0.34em on the key,
     0.08 and 0.6em on what it names. Checked against the rendered recognition
     row rather than against the source: at a --v of 0.4 both read 0.484 and
     0.2272, at 0.7 both read 0.742 and 0.5308.

     THE TRAVEL IN PIXELS DIFFERS AND SHOULD. The same 0.6em moves the
     recognition body 18.95px and a credit value 9.07px, because one is 37.6px
     type and the other 18. An em is relative to its element, which is the
     whole reason the rule is written in em and not in pixels.

     ONE ARRIVAL RATHER THAN SIX. The overshoot this replaces gave every pair
     its own clock, so the block cascaded; the credits are the last thing on
     the page and a sixfold cascade there is a lot of motion at the moment a
     reader is finishing. This resolves in a single move.

     AND THE WORD SPANS ARE GONE WITH IT. The overshoot needed each value split
     into inline-block words to move them separately — nine to twenty-four
     spans a page. The value moves as one box now, so the markup is back to a
     plain <dd>.

     inline-block IS STILL LOAD-BEARING on both halves: .cr__k and .cr__v are
     display: inline, and a transform does not apply to a non-replaced inline
     element. The recognition row needs no such declaration because its parts
     are grid items and blockified already. Row widths are unaffected — 271,
     137, 181, 553, 169 and 86 by 29 on Mumbai Standard Time, before and
     after. */
  .cr__list { --v2: calc(var(--v, 1) * var(--v, 1)); }
  .cr__k {
    display: inline-block;
    opacity: calc(0.14 + var(--v, 1) * 0.86);
    transform: translateY(calc((1 - var(--v, 1)) * 0.34em));
    will-change: opacity, transform;
  }
  .cr__v {
    display: inline-block;
    opacity: calc(0.08 + var(--v2, 1) * 0.92);
    transform: translateY(calc((1 - var(--v2, 1)) * 0.6em));
    will-change: opacity, transform;
  }

  /* The watch link: right-aligned, at title scale, with no rule at all. The
     separation from the credits is a full section of air and the fact that one
     is a line of display type and the other a paragraph — not a box. */
  .blk.wt { margin-bottom: clamp(64px, 11vh, 150px); text-align: right; }
  .wt__a { display: inline-flex; align-items: baseline; gap: 14px; text-decoration: none; color: var(--bone); }
  .wt__t { font-size: clamp(1.6rem, 4.2vw, 2.6rem); line-height: 1.05; letter-spacing: -0.02em; }
  /* A · LEDGER ON THE WATCH LINK, applied 2026-09-07. The label rides the
     page's own --v and the arrow lags on --v SQUARED — the same relationship
     a recognition row has between its figure and the festival, and the
     description between its standfirst and its paragraph.

     THE ARROW ARRIVES ALONG ITS OWN DIAGONAL, up and to the right: the
     direction the glyph points and the direction it already travels on
     hover. So the entry and the hover are one gesture at two sizes rather
     than two ideas sharing a control.

     THE TRANSITION IS ON THE INNER BOX ONLY. --d-micro is 240ms, which is
     long enough that a transition on the scroll-driven transform would drag
     the arrow visibly behind the scroll. The outer span takes the scroll and
     is untransitioned; the inner one takes the hover and is. */
  .wt__a { --v2: calc(var(--v, 1) * var(--v, 1)); }
  .wt__t {
    opacity: calc(0.12 + var(--v, 1) * 0.88);
    transform: translateY(calc((1 - var(--v, 1)) * 0.28em));
    will-change: opacity, transform;
  }
  .wt__arw {
    font-size: var(--t-md); color: var(--dim);
    transition: color var(--d-micro) var(--ease);
    opacity: calc(0.05 + var(--v2, 1) * 0.95);
    transform: translate(calc((1 - var(--v2, 1)) * -14px), calc((1 - var(--v2, 1)) * 14px));
    will-change: opacity, transform;
  }
  .wt__arw-i { display: inline-block; transition: transform var(--d-micro) var(--ease); }
  .wt__a:hover .wt__arw { color: var(--bone); }
  .wt__a:hover .wt__arw-i { transform: translate(3px, -3px); }
  .wt__a:hover .wt__t { text-decoration: underline; text-underline-offset: 6px; }

  /* THE BARE STILL IS A WINDOW, so it is given the film's width and the film's
     button. On Taskaree and Special Ops the page has nothing to play: the
     frame is the work, and the only way to watch is elsewhere. Sized at 760
     with the link filed below it, that frame read as an illustration beside
     the prose rather than as the thing the page is about.

     It takes the SAME --film as the facade — not a second number — so the two
     kinds of opening share an edge, and a change to one moves the other.

     The button copies .facade__play: same inset from the corner, same border,
     ground and blur, so a still that links out and a video that plays look
     like the same control doing two jobs. It is an anchor rather than a
     button because it leaves the site, and it carries the arrow the rest of
     the page uses for that. */
  .still { position: relative; }
  .blk :global(.still) {
    width: var(--film);
    margin-inline: calc((100% - var(--film)) / 2);
  }
  .still__go {
    position: absolute; left: var(--margin); bottom: var(--margin);
    display: inline-flex; align-items: center; gap: 11px;
    padding: 11px 18px;
    border: 1px solid rgba(255, 255, 255, 0.5);
    background: rgba(10, 9, 8, 0.35);
    backdrop-filter: blur(6px);
    color: var(--bone); text-decoration: none;
    transition: border-color var(--d-micro) var(--ease), background var(--d-micro) var(--ease);
  }
  .still__go .mono { color: inherit; }
  .still__go:hover { border-color: var(--accent); background: rgba(10, 9, 8, 0.6); }
  .still__arw { transition: transform var(--d-micro) var(--ease); }
  .still__go:hover .still__arw { transform: translate(2px, -2px); }
  @media (max-width: 900px) {
    .still__go { left: var(--s-3); bottom: var(--s-3); padding: 9px 14px; }
  }
</style>

<script>
  /* ONE CLOCK for every assembling thing on the page.

     A word's --v is how far its own top has risen past a line two thirds down
     the window, normalised over a third of a screen. So words light in
     reading order as the paragraph rises, the effect reverses on the way back
     up, and nothing is ever mid-animation while the reader is still — which
     is what separates this from a timed stagger, and the reason a timed one
     looks right once and wrong every time after.


     Writing a custom property per word is the expensive part, so a word is
     only written when its value actually changes by enough to see: 240-odd
     spans times sixty frames is otherwise fourteen thousand style writes a
     second for a change no one can perceive. */
  function initScore() {
    const root = document.querySelector<HTMLElement>('[data-sc]');
    if (!root || root.dataset.bound) return;
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    root.dataset.bound = '1';

    /* WORDS ONLY NOW. This also collected [data-rl] and drove the hairline
       under each section's heading from the same number. The headings are
       gone — Stills was the last — so there are no rules left to drive, and
       the query goes rather than sit there returning an empty list. */
    /* [data-w] is a word of prose. [data-v] is anything else that wants its
       own progress — today, a recognition row. Same number, same formula, so
       there is one clock on the page rather than two. */
    const items = Array.from(root.querySelectorAll<HTMLElement>('[data-w], [data-v]'));
    if (!items.length) return;

    const last = new WeakMap<HTMLElement, number>();
    let raf = 0;

    const paint = () => {
      raf = 0;
      const line = innerHeight * 0.66;
      const span = innerHeight / 3;
      for (const el of items) {
        const t = el.getBoundingClientRect().top;
        const v = Math.min(1, Math.max(0, (line - t) / span));
        const prev = last.get(el);
        if (prev !== undefined && Math.abs(prev - v) < 0.02) continue;
        last.set(el, v);
        el.style.setProperty('--v', v.toFixed(3));
      }
    };
    const tick = () => { if (!raf) raf = requestAnimationFrame(paint); };

    paint();
    addEventListener('scroll', tick, { passive: true });
    addEventListener('resize', tick, { passive: true });
  }
  initScore();
  document.addEventListener('astro:page-load', initScore);
</script>

<style is:global>
  /* The same line index.astro carries: OpNav replaces the running head rather
     than sitting under it. */
  .runhead { display: none !important; }
</style>

<style>
  /* ══ THE MOSAIC BED ═════════════════════════════════════════════ */
  .ms__ground { position: fixed; inset: 0; z-index: 0; pointer-events: none; overflow: hidden; }
  .ms__bed {
    position: absolute; inset: -10%;
    display: grid; grid-template-columns: repeat(6, minmax(0, 1fr));
    grid-auto-rows: minmax(0, 1fr); gap: clamp(5px, 0.8vw, 13px);
    transform: scale(1.06);
    /* One filter on one element rather than thirty. */
    filter: brightness(0.30) saturate(0.7) contrast(1.05);
  }
  .ms__tile {
    display: block; overflow: hidden; min-height: 0;
    border-radius: clamp(6px, 0.7vw, 12px);
  }
  /* Contrast composes multiplicatively: 1.05 on the bed and 1/1.05 here
     resolves to 1.0 for the one tile BED_GRADE names. */
  .ms__tile[style*="--bed-k"] { filter: contrast(calc(var(--bed-k) / 1.05)); }
  .ms__tile--crop :global(.frame__layer img) {
    transform: translateY(var(--crop-y, 0)) scale(var(--crop-s, 1));
  }
  .ms__tile :global(.st), .ms__tile :global(.st__win) { border-radius: inherit; height: 100%; }
  @media (max-width: 900px) {
    .ms__bed { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }

  /* The bed is inset -10% inside an overflow: hidden ground, so the blur's
     soft edge -- about three times its radius -- falls outside the clip and
     no fringe reaches the viewport. */
  :root[data-blur] .ms__bed {
    filter: brightness(0.30) saturate(0.7) contrast(1.05) blur(var(--haze, 7px));
  }

  /* ══ THE SMOKE ══════════════════════════════════════════════════
     Static at the About section's resting values rather than animated from
     the opening, because a work page has no opening to protect. */
  .sm {
    position: fixed; inset: 0; z-index: 1; pointer-events: none;
    background: color-mix(in srgb, var(--ground) calc(var(--smoke, 1) * 55%), transparent);
  }

  /* ══ THE CONTENT, LIFTED ════════════════════════════════════════
     A fixed element at z-index 0 paints in step 6 of the painting order and
     non-positioned inline content in step 5, so without this the bed sits
     ON the text. index.astro does the same with .ov, .mvt at z-index 2. */
  .sc { position: relative; z-index: 2; }
  :global(.next), :global(.colophon) { position: relative; z-index: 2; }
</style>

<script>
  /* A stated preference is not a capability: reduced motion never blurs.
     ← THIS IS NOT THE REAL GATE. index.astro measures the device with a
       frame-timing probe before setting this attribute, because the blur
       covers 1.2x the viewport in each axis. Port that, not this, if the
       bed is ever applied to a work page for real. */
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.documentElement.setAttribute('data-blur', '');
  }
</script>
