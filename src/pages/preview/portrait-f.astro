---
/**
 * THE PORTRAIT IN THE ABOUT MOVEMENT — DRAFT F, Aperture
 *
 * ONE OF SIX asked for on 2026-09-07, the first drafts to use the photograph
 * Ugam uploaded. Nothing here is on the live site.
 *
 * The frame opens from its centre line as the section arrives while the
 * picture drifts up behind it on the square of the same clock — two rates,
 * one number.
 *
 * WHAT THE FILE ACTUALLY IS, because four of these six are shaped by it.
 * src/media/about/portrait.PNG is 1620 by 971 — LANDSCAPE, not the upright
 * the PORTRAIT slot in src/data/about.ts was written for. It is a working
 * frame rather than a headshot: three-quarter view at a studio desk, laptop
 * open, control-room window behind, lit warm. Measured on the file, the face
 * sits about 46% across and 29% down, and a second person's head is cropped
 * at the far left edge — which is why the crops here start well inside it.
 *
 * THE SECTION AROUND IT IS THE HOME PAGE'S. Movement 02, "Who I am" — its
 * frame, its corner labels, its statement and its numbered paragraphs, with
 * the type copied from src/pages/index.astro so the picture is judged against
 * what it will actually sit in.
 *
 * ONE THING IS SIMPLIFIED AND SHOULD BE SAID. The live page lights its words
 * by adding .is-lit from an observer; here the same colour ramp runs
 * continuously off --v, because the observer lives in a script the whole home
 * page shares. The words read the same at rest and while scrolling; the
 * difference is that this version reverses on the way back up.
 */
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import OpNav from '../../components/OpNav.astro';
import portrait from '../../media/about/portrait.PNG';
import { HERO, WHO } from '../../data/about';

const wordsOf = (s: string) => s.split(' ');
const FAM = ['a', 'b', 'c', 'd', 'e', 'f'];
const HERE = 'f';
---

<Base title="Portrait — draft F" description="Where the portrait sits in the About movement.">
  <OpNav variant="bracket" base="/" />

  <article class="pg" data-sc-pt>
    <section class="mvt" aria-labelledby="r-who">
      <div class="fr">
        <p class="mono cn cn--tl">02<br />Who I am</p>
        <p class="mono cn cn--tr">{HERO.place[0]}<br />{HERO.place[1]}</p>
        <p class="mono cn cn--bl">02/06</p>
        <p class="mono cn cn--br">Portrait draft F</p>
        <div class="fr__mid">
          <h2 class="fr__t" id="r-who">Who I am</h2>
        </div>
      </div>

      <div class="ms__panel pn--a">
        <figure class="pt pt--ap" data-v>
          <span class="pt__win">
            <span class="pt__par">
              <Image src={portrait} alt="Ugam Khetani at the desk, mid-session" widths={[520, 900, 1400, 1620]} sizes="(max-width: 900px) 80vw, 34vw" loading="eager" decoding="async" />
            </span>
          </span>
          <figcaption class="mono pt__cap">At the desk &middot; Mumbai</figcaption>
        </figure>
        <div class="pt__col">
          <h3 class="s__stmt">
            {WHO.head}
          </h3>
          <div class="s__body">
            {WHO.body.map((p, i) => (
              <div class="s__p">
                <span class="mono s__rn">{String(i + 1).padStart(2, '0')}</span>
                <p>{wordsOf(p).map((w) => <span class="w">{w + ' '}</span>)}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <div class="tail" aria-hidden="true"></div>

    <nav class="mono flip" aria-label="Drafts">
      {FAM.map((l) => (
        <a class={l === HERE ? 'flip__a is-here' : 'flip__a'} href={`/preview/portrait-${l}`}>{l.toUpperCase()}</a>
      ))}
      <a class="flip__all" href="/preview/">All drafts &rarr;</a>
    </nav>
  </article>
</Base>

<style>
  /* ── THE HOME PAGE'S ABOUT MOVEMENT, copied from src/pages/index.astro. */
  .pg {
    --measure: min(760px, 100%);
    --film: max(var(--measure), calc(100vw - 3 * var(--margin)));
    padding: 0 var(--margin);
  }
  .mvt {
    margin-inline: calc(var(--margin) * -1);
    padding-inline: var(--margin);
    padding-block: clamp(70px, 12vh, 156px);
    text-align: center;
  }
  .fr { position: relative; padding: clamp(30px, 5vh, 66px) clamp(26px, 4vw, 72px); }
  .cn {
    position: absolute; margin: 0; z-index: 3;
    font-size: var(--t-micro); letter-spacing: 0.16em;
    text-transform: uppercase; color: var(--bone-dim); line-height: 1.55;
    text-shadow: 0 1px 3px var(--ground), 0 0 14px rgba(10, 9, 8, 0.95);
  }
  .cn--tl { top: 0; left: 0; text-align: left; color: var(--bone); }
  .cn--tr { top: 0; right: 0; text-align: right; }
  .cn--bl { bottom: 0; left: 0; text-align: left; }
  .cn--br { bottom: 0; right: 0; text-align: right; }
  .fr__mid { position: relative; z-index: 2; }
  .fr__t {
    margin: 0; font-family: var(--display); font-weight: 500;
    font-size: clamp(1.5rem, min(6vw, 8vh), 4.2rem);
    line-height: 0.96; letter-spacing: -0.045em;
    text-transform: uppercase; color: var(--bone);
  }
  .ms__panel {
    margin: clamp(24px, 4.4vh, 58px) auto 0; max-width: 78ch;
    padding: clamp(22px, 3.6vh, 46px) clamp(20px, 3vw, 44px);
    background: var(--ground);
    border: 1px solid var(--rule-soft);
    border-radius: clamp(10px, 1.2vw, 20px);
  }
  .s__stmt {
    margin: 0 auto; max-width: 22ch;
    font-family: var(--display); font-weight: 500;
    font-size: clamp(1.25rem, min(3.8vw, 5.2vh), 2.9rem);
    line-height: 1.14; letter-spacing: -0.028em; color: var(--bone);
  }
  .s__mark { display: block; margin-top: 0.2em; color: var(--bone-dim); font-style: italic; }
  .s__body { margin: clamp(24px, 4.4vh, 56px) auto 0; columns: 2; column-gap: clamp(24px, 4vw, 60px); max-width: 64ch; text-align: left; }
  .s__p { break-inside: avoid; margin-bottom: var(--s-3); }
  .s__p p { margin: 0; color: var(--bone-dim); }
  .s__rn { display: block; margin-bottom: 3px; color: var(--dim); font-size: var(--t-xs); font-variant-numeric: tabular-nums; }
  .w { color: color-mix(in srgb, var(--bone) calc(var(--v, 1) * 100%), var(--bone-dim)); }
  @media (max-width: 900px) { .s__body { columns: 1; } }

  /* ── THE TWO-COLUMN PANEL, shared by A, E and F. The prose keeps the live
     type; only the track it sits in changes, and .s__body drops to one column
     because two columns of 250px would be four columns of nothing. */
  .pn--a, .pn--c {
    display: grid; gap: clamp(24px, 3.4vw, 54px);
    align-items: start; text-align: left;
  }
  .pn--a { grid-template-columns: 0.85fr 1fr; max-width: var(--film); }
  .pn--a .s__stmt, .pn--c .s__stmt { margin-inline: 0; }
  .pn--a .s__body, .pn--c .s__body { columns: 1; margin-inline: 0; max-width: none; }

  /* ── THE FRAME EVERY DRAFT SHARES. Window, grade, hover push and caption
     are the stills' own, from src/pages/work/[slug].astro, so a portrait
     treatment is judged against the way this site already shows a picture.
     .pt__par is the untransitioned box the scroll-linked drafts move; see the
     note in F. */
  .pt { margin: 0; }
  .pt__win { display: block; overflow: hidden; background: var(--ground-lift); }
  .pt__par { display: block; width: 100%; height: 100%; }
  .pt__win :global(img) {
    width: 100%; height: 100%; object-fit: cover; display: block;
    filter: saturate(0.94) contrast(1.02);
    transform: scale(1.001);
    transition: filter var(--d-micro) var(--ease), transform 1100ms var(--ease);
  }
  .pt:hover .pt__win :global(img) {
    filter: saturate(1) contrast(1.06) brightness(1.04);
    transform: scale(1.035);
  }
  .pt__cap {
    display: block; margin-top: 8px;
    font-size: var(--t-micro); letter-spacing: 0.16em;
    text-transform: uppercase; color: var(--dim);
    font-variant-numeric: tabular-nums;
  }

  /* ── WHAT THIS DRAFT ADDS ───────────────────────────────────── */
  /* F · APERTURE. A's layout, and the frame opens from its own centre line as
     the section arrives — the way a shutter opens — with the picture drifting
     up behind it at a different rate.

     TWO RATES, ONE CLOCK. The window uncovers on --v and the picture moves on
     --v squared, so the picture is still travelling when the frame has
     finished opening. That difference is what reads as depth rather than as a
     box growing. It is the same square lag the description, the recognition
     rows and the credits all now use, so the portrait arrives in the language
     the rest of the page already speaks.

     THE INSET IS SQUARED, SO THE FRAME OPENS FAST AND SETTLES SLOWLY, and it
     ends at a true 0 — measured across the travel: 50% at v=0, 28.1% at 0.25,
     12.5% at 0.5, 3.1% at 0.75, 0% at 1. Never left a fraction clipped.

     THE SCALE AND THE DRIFT SIT ON .pt__par, NOT ON THE PICTURE, and that is
     the whole reason the wrapper exists. The image itself carries a 1100ms
     transform transition for the hover push it shares with the stills; a
     scroll-linked transform on the same element would be dragged through that
     transition and lag the scroll by a second. Two boxes, one transitioned
     and one not — the same split the watch link already uses.

     BOTH THE OVERSCAN AND THE TRAVEL ARE PERCENTAGES, which is the only way
     the frame is safe at every size. Something translated inside its own
     window has to be larger than the window or an edge lifts off the ground
     mid-travel. scale(1.1) leaves 5% of the height above and below; the drift
     is 4% of it. Five beats four at any window height, so the margin holds on
     a phone as well as it does here. Written in pixels it would not: at the
     426-wide column the window is 255 tall, 12.75px of overscan, and a fixed
     16px of travel would lift the bottom edge clear of the ground by 3px
     around v=0.2 — under the clip at that point, but only by luck. */
  .pt--ap { --v2: calc(var(--v, 1) * var(--v, 1)); }
  .pt--ap .pt__win { clip-path: inset(calc((1 - var(--v, 1)) * (1 - var(--v, 1)) * 50%) 0); }
  .pt--ap .pt__par { transform: translateY(calc((1 - var(--v2, 1)) * -4%)) scale(1.1); }
  .pt--ap .pt__cap { opacity: calc(0.1 + var(--v, 1) * 0.9); }

  /* THE STACK COMES LAST ON PURPOSE. C sets its own track width above, and a
     draft's rule and this one have identical specificity — so if this query
     were declared before the block above, the two-column track would still
     win inside it and C's prose column would be 100px wide on a phone.
     Measured, before the order was fixed: 180px of picture and 100px of
     text at a 375 window. */
  @media (max-width: 900px) {
    .pn--a, .pn--c { grid-template-columns: 1fr; }
  }

  @media (prefers-reduced-motion: reduce) {
    .pt, .pt *, .w {
      transition: none !important; transform: none !important;
      clip-path: none !important; opacity: 1 !important;
    }
  }

  .tail { min-height: 60vh; }
  .flip {
    display: flex; justify-content: center; align-items: center; flex-wrap: wrap; gap: 8px;
    margin: 0 auto clamp(60px, 10vh, 120px);
    font-size: var(--t-micro); letter-spacing: 0.14em; text-transform: uppercase;
  }
  .flip__a {
    display: grid; place-items: center;
    min-width: 30px; height: 30px; padding-inline: 8px;
    border: 1px solid var(--rule); color: var(--dim); text-decoration: none;
  }
  .flip__a:hover { border-color: var(--bone-dim); color: var(--bone); }
  .flip__a.is-here { border-color: var(--accent); color: var(--accent); }
  .flip__all { margin-left: 14px; color: var(--dim); text-decoration: none; }
  .flip__all:hover { color: var(--bone); }
</style>

<script>
  /* The site's clock, cut down: a --v per [data-v] and per word, read from the
     same line two thirds down the window over a third of its height. */
  function initPt() {
    const root = document.querySelector('[data-sc-pt]');
    if (!root || root.dataset.bound) return;
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    root.dataset.bound = '1';
    const items = Array.from(root.querySelectorAll('[data-v], .w'));
    if (!items.length) return;
    const last = new WeakMap();
    let raf = 0;
    const paint = () => {
      raf = 0;
      const line = innerHeight * 0.66, span = innerHeight / 3;
      for (const el of items) {
        const v = Math.min(1, Math.max(0, (line - el.getBoundingClientRect().top) / span));
        const prev = last.get(el);
        if (prev !== undefined && Math.abs(prev - v) < 0.02) continue;
        last.set(el, v);
        el.style.setProperty('--v', v.toFixed(3));
      }
    };
    const tick = () => { if (!raf) raf = requestAnimationFrame(paint); };
    paint();
    addEventListener('scroll', tick, { passive: true });
    addEventListener('resize', tick, { passive: true });
  }
  initPt();
  document.addEventListener('astro:page-load', initPt);
</script>
