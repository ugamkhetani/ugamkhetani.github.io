---
/**
 * ZW6 · THE PLATE — Off the picture, a ruled caption beneath it
 *
 * THE OBSERVATION, AND IT QUESTIONS THE BRIEF RATHER THAN ANSWERING IT: the
 * reason the live button needs a border, a translucent ground and a blur is
 * that it is standing ON a photograph. Take it off the photograph and all
 * three stop being necessary. Every other draft in this round makes the type
 * survive the picture; this one asks whether it should be there at all.
 *
 * SO IT IS A CAPTION PLATE UNDER THE FRAME — the still's full width, a
 * hairline across the top of it, "WATCH ON" flush left and the platform
 * flush right, set in the editorial language the rest of the page already
 * uses for its colophon.
 *
 * THE PRICE IS STATED PLAINLY: the frame stops offering the work. §5 is
 * explicit that a bare still has no window, that the frame IS the work as far
 * as the page is concerned, and that the button is on the image because the
 * image is the only thing to press. This draft overturns that, and the
 * argument for overturning it is that Aasha now carries one outbound link
 * rather than two — so the page's single action can afford to be a line of
 * its own instead of an object sitting on a picture.
 *
 * IT IS ALSO THE ONE DRAFT WHERE THE ACCENT CAN BE THE INK. Off the frame the
 * ground is #0A0908, where #E85D2C reads 5.72:1 — AA for the size it is set
 * at here — against 1.92:1 over the picture's bottom band. So the platform
 * name is set in the accent on this page and in white on the seven others,
 * and that difference is a measurement rather than a preference.
 *
 * MEASURED OFF THE OPENING FRAME, NOT ASSERTED. The still is
 * src/media/works/aasha/frames/01.png at 2880x2160 — exactly the declared
 * 4:3 — so `object-fit: cover` crops nothing and the whole file is what a
 * visitor sees. There is no FRAME_CROP entry for aasha, so the geometry is
 * the file's. Relative luminance (WCAG), read off the decoded pixels:
 *
 *   region                       mean    p95     max   white reads
 *   the whole frame             .0273   .0976  .3325   13.6 / 7.1 / 2.8
 *   where the button sits now   .0077   .0168  .1500   18.2 / 15.7 / 5.2
 *   bottom-left quadrant        .0120   .0482  .1500   16.9 / 10.7 / 5.2
 *   full-width bottom 12%       .0250   .1070  .1746   14.0 / 6.7 / 4.7
 *   left edge column 10%        .0097   .0382  .1878   17.6 / 11.9 / 4.4
 *   brightest patch anywhere      —       —    .3325   2.8
 *
 * TWO CONSEQUENCES, AND THEY SHAPE ALL EIGHT.
 *
 * ONE — THE GLASS IS SOLVING A PROBLEM THIS PICTURE DOES NOT HAVE. The live
 * button carries a 1px 50%-white border, a 35% ground and a 6px
 * backdrop-filter: chrome whose job is to hold white type off a bright
 * photograph. The corner it sits in is the DARKEST region of the frame —
 * white reads 18.2:1 against its mean and 15.7:1 against its 95th
 * percentile, where 4.5:1 is the AA floor. Nothing there needs a plate. That
 * measurement is what licenses every draft in this round to take the box
 * away, and it is the round's one argument.
 *
 * TWO — THE ACCENT CANNOT BE THE INK ON THE PICTURE. #E85D2C is luminance
 * .2517: 5.2:1 in that dark corner, but 1.92:1 against the bottom band's p95
 * and 1.27:1 against the brightest patch. So the accent is used here as a
 * RULE, a FIELD or a MARK and never as small type over the frame. The one
 * exception is ZW6, which leaves the image altogether and sets it on the page
 * ground, where it reads 5.7:1.
 *
 * EVERY HOVER RULE IS MIRRORED ON `.is-hover`, at the same specificity and in
 * the same scoped block, because `:hover` cannot be forced from script
 * (HANDOFF §6) and this state has to be measurable without a pointer.
 *
 * MEASURED, BUILT SITE AT 1280x800. The plate is **1049.6 wide, exactly the
 * still's width** — left and right deltas both 0.0 — sitting 15px beneath it,
 * 44.7 tall, with the label flush to its left edge at 0.0 and the platform
 * flush to its right at 0.0, baselines shared. Off the picture the accent
 * reads **5.72:1** on the page's own ground and the label 5.39:1; on hover the
 * platform goes to bone at 13.96:1.
 *
 * At 375 the plate is 327x37, still exactly the still's width, still below
 * it. No horizontal overflow.
 *
 * THE WORK PAGE IS NOT TOUCHED. src/pages/work/[slug].astro is untouched by
 * all eight, and `withoutPreview()` keeps these out of the built site. The
 * only thing that differs between ab-zw1 and ab-zw8 is the watch control on
 * the opening still; the head, the statement and the lede are the live page's
 * so the control is judged where it actually lives.
 */
import Base from '../../layouts/Base.astro';
import OpNav from '../../components/OpNav.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { framesFor } from '../../lib/frames';
import { href } from '../../lib/href';

const works = await getCollection('works');
const work = works.find((w) => w.id === 'aasha')!;
const d = work.data;
const images = framesFor('aasha', d.frames);
const poster = images[0];

/* THE REAL LINK, from the markdown. Aasha's `external` is ZEE5 — platform,
   label and url — and every draft uses it as written. Nothing here invents a
   platform, a label or a destination. */
const EXT = d.external!;

const ROLES = d.role.split('·').map((r) => r.trim());
const QW = (d.quote ?? '').split(' ').filter(Boolean);
/* The first sentence, as the live page takes it. The regex lives here and not
   in the markup: a regex literal inside an Astro template expression is
   parsed as JSX and fails the build (HANDOFF §6). */
const LEDE = (d.description.trim().match(/^[^.!?]+[.!?]/) ?? [d.description.trim()])[0];

const ME = 'zw6';
const DRAFTS: [string, string, string][] = [
  ['zw1', 'The rule', 'A hairline across the frame, the label under it'],
  ['zw2', 'The stack', 'Two sizes, flush left, nothing drawn'],
  ['zw3', 'The field', 'The page grid made visible, the link held by it'],
  ['zw4', 'The band', 'A flat accent plane, type knocked out'],
  ['zw5', 'The spine', 'Set vertically up the frame’s left edge'],
  ['zw6', 'The plate', 'Off the picture, a ruled caption beneath it'],
  ['zw7', 'The marks', 'Crop marks, the label registered between them'],
  ['zw8', 'The block', 'The facts as a ruled data table'],
  ['zw9', 'The gate', 'ZW2 with a ruled play mark in the middle of the frame'],
  ['zw10', 'The mark', 'ZW2 with a bare triangle, no ring at all'],
];
const MINE = DRAFTS.find(([id]) => id === ME)!;
---

<Base title={`${d.title} · ${MINE[1]} — watch ${ME.toUpperCase()}`} description={`A Swiss-poster reading of the watch control on the Aasha project page: ${MINE[2]}.`}>
  <OpNav variant="bracket" base={href()} />

  <nav class="sw" aria-label="Watch-button drafts">
    <span class="sw__id">{ME.toUpperCase()}</span>
    <span class="sw__nm">{MINE[1]}</span>
    <span class="sw__su">{MINE[2]}</span>
    <span class="sw__set">
      {DRAFTS.map(([id, name, sub]) => (
        <a class:list={['sw__i', { 'is-here': id === ME }]} href={href(`preview/ab-${id}`)}
          title={`${name} — ${sub}`} aria-current={id === ME ? 'page' : undefined}>{id.slice(2)}</a>
      ))}
      <a class="sw__prev" href={href('work/aasha')} title="The live page, for comparison">LIVE</a>
    </span>
  </nav>

  <article class="sc">
    <header class="hd">
      <p class="mono hd__over">{d.category} · {d.overline ?? d.year}</p>
      <h1 class="hd__t">{d.title}</h1>
      <p class="mono hd__meta">
        <span class="hd__roles">
          {ROLES.map((r, i) => (<>{i > 0 && <i class="hd__bar" aria-hidden="true"></i>}<span>{r}</span></>))}
        </span>
      </p>
    </header>

    {QW.length > 0 && (
      <section class="q" aria-label="Statement">
        <p class="q__t">{d.quote}</p>
      </section>
    )}

    <!-- ══ 01 · THE WORK — THE DRAFT IS THE CONTROL ON THIS STILL ═══ -->
    <section class="blk" aria-label="The work">
      <div class="still">
        <Image src={poster} alt={d.alt} widths={[800, 1400, 2000]} sizes="(max-width: 900px) 100vw, 78vw" loading="eager" decoding="async" />
      </div>
      <a class="zw6" href={EXT.url} target="_blank" rel="noopener noreferrer">
        <span class="zw6__k">Watch on</span>
        <span class="zw6__p">{EXT.platform}<i class="zw6__a" aria-hidden="true">&nearr;</i></span>
      </a>
    </section>

    <section class="blk body" aria-label="About the work">
      <p class="body__lede">{LEDE}</p>
    </section>
  </article>
</Base>

<style>
  /* ══ THE SWITCHER — the stills rounds' bar, unchanged ═════════ */
  .sw {
    position: fixed; inset: 0 0 auto; z-index: 900;
    display: flex; align-items: baseline; gap: 12px;
    padding: 9px clamp(16px, 4vw, 40px);
    background: color-mix(in srgb, var(--ground) 86%, transparent);
    backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--rule);
    font-family: var(--mono); font-size: var(--t-micro);
    letter-spacing: 0.16em; text-transform: uppercase;
  }
  .sw__id { color: var(--accent); }
  .sw__nm { color: var(--bone); }
  .sw__su { color: var(--dim); margin-right: auto; }
  .sw__set { display: flex; gap: 1px; align-items: baseline; }
  .sw__i { color: var(--dim); text-decoration: none; padding: 3px 7px; border: 1px solid transparent; font-variant-numeric: tabular-nums; }
  .sw__i:hover { color: var(--bone); }
  .sw__i.is-here { color: var(--accent); border-color: var(--rule); }
  .sw__prev { color: color-mix(in srgb, var(--dim) 70%, var(--ground)); text-decoration: none; padding: 3px 6px; margin-left: 4px; }
  .sw__prev:hover { color: var(--bone); }

  /* ══ THE WORK PAGE'S OWN HARNESS — the settled values ════════ */
  .sc {
    --measure: min(760px, 100%);
    --film: max(var(--measure), calc(100vw - 3 * var(--margin)));
    padding: clamp(96px, 15vh, 190px) var(--margin) 0;
  }
  .hd, .q, .blk { max-width: var(--measure); }
  .hd { margin-inline: auto; text-align: center; }
  .hd__over {
    margin: 0 0 clamp(24px, 4vh, 48px);
    font-size: var(--t-micro); letter-spacing: 0.16em;
    text-transform: uppercase; color: var(--dim);
    font-variant-numeric: tabular-nums;
  }
  .hd__t {
    margin: 0;
    font-family: var(--display); font-weight: 500;
    font-size: clamp(2.6rem, 10vw, 7.25rem);
    line-height: 0.86; letter-spacing: -0.05em;
    text-transform: uppercase; color: var(--bone);
  }
  .hd__meta {
    display: flex; justify-content: center; flex-wrap: wrap;
    margin: clamp(28px, 4.6vh, 50px) 0 0;
    font-size: var(--t-micro); letter-spacing: 0.16em;
    text-transform: uppercase; color: var(--dim);
  }
  .hd__roles { display: inline-flex; align-items: center; flex-wrap: wrap; justify-content: center; row-gap: 8px; }
  .hd__bar { display: inline-block; width: 1px; height: 7px; margin-inline: clamp(10px, 1.8vw, 16px); background: var(--rule); }
  .q { margin: clamp(80px, 14vh, 180px) auto; text-align: center; }
  .q__t {
    margin: 0 auto; max-width: 20ch;
    font-family: var(--display); font-weight: 500;
    font-size: clamp(1.9rem, 5.4vw, 4.4rem);
    line-height: 1.02; letter-spacing: -0.045em; color: var(--bone);
  }
  .blk { margin: 0 auto clamp(72px, 12vh, 160px); }
  .body__lede {
    margin: 0; font-size: var(--t-md); line-height: 1.6;
    color: var(--bone-dim); max-width: 44ch;
  }

  /* THE BARE STILL TAKES --film, as it does live, so the control is judged at
     the width it will actually have: 1049.6px at 1280, 787.2 tall at 4:3. */
  .still { position: relative; }
  .blk .still { width: var(--film); margin-inline: calc((100% - var(--film)) / 2); }
  .still :global(img) { width: 100%; height: auto; display: block; }

  /* ══ ZW6 · THE PLATE ═════════════════════════════ */
  /* THE PLATE TAKES --film, so it ends exactly where the picture above it
     ends. One edge, two objects — which is the whole reason it reads as that
     picture's caption and not as a control that happens to sit below it. */
  .zw6 {
    display: flex; align-items: baseline; justify-content: space-between;
    gap: var(--s-3);
    width: var(--film); margin-inline: calc((100% - var(--film)) / 2);
    margin-top: 15px; padding-top: 13px;
    border-top: 1px solid var(--rule);
    text-decoration: none;
  }
  .zw6__k {
    font-family: var(--mono); font-size: var(--t-micro);
    letter-spacing: var(--track-mono); text-transform: uppercase;
    color: var(--dim);
    transition: color var(--d-micro) var(--ease);
  }
  .zw6:hover .zw6__k, .zw6.is-hover .zw6__k { color: var(--bone-dim); }
  /* ACCENT AS INK, AND ONLY HERE. 5.72:1 on the page ground; it would be
     1.92:1 over the picture's bottom band, which is why no other draft in
     this round does it. */
  .zw6__p {
    position: relative;
    font-family: var(--display); font-weight: 500;
    font-size: clamp(1.3rem, 2.5vw, 1.85rem);
    line-height: 1; letter-spacing: -0.03em; text-transform: uppercase;
    color: var(--accent);
    transition: color var(--d-micro) var(--ease);
  }
  .zw6:hover .zw6__p, .zw6.is-hover .zw6__p { color: var(--bone); }
  .zw6__a {
    font-style: normal; font-size: 0.6em; margin-left: 0.5em;
    display: inline-block;
    transition: transform var(--d-micro) var(--ease);
  }
  .zw6:hover .zw6__a, .zw6.is-hover .zw6__a { transform: translate(2px, -2px); }
  /* The rule above the plate takes the accent as the pointer arrives, the
     same gesture ZW1 uses on the frame. */
  .zw6::before {
    content: ''; position: absolute; left: 0; right: 0; top: -1px; height: 1px;
    background: var(--accent);
    transform: scaleX(0); transform-origin: left;
    transition: transform var(--d-micro) var(--ease);
  }
  .zw6 { position: relative; }
  .zw6:hover::before, .zw6.is-hover::before { transform: scaleX(1); }
  @media (prefers-reduced-motion: reduce) {
    .zw6__k, .zw6__p, .zw6__a, .zw6::before { transition: none; }
  }
</style>
