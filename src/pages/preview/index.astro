---
/**
 * THE PREVIEW INDEX — one page that lists every draft.
 *
 * The library used to be 71 pages with no way in except a URL you had to
 * remember, and it was deleted partly for that. This is the way back in: any
 * .astro file dropped in this folder appears here on the next build, with no
 * list to keep in step.
 *
 * DISCOVERY IS A GLOB, NOT A TABLE. `import.meta.glob` is evaluated at build
 * time and is eager: false, so nothing here loads a draft's module — only its
 * path is read. A draft that is deleted stops being listed because the file is
 * gone, which is the only kind of index that cannot go stale.
 *
 * The glob is case-sensitive, as it is in src/lib/frames.ts (HANDOFF §6), but
 * every page in this folder is lowercase .astro so one pattern is enough.
 *
 * NOTES ARE OPTIONAL. A slug with no entry in NOTES still lists, under a title
 * derived from its filename — so adding a draft never means editing this file,
 * and writing a note is a courtesy rather than a requirement.
 */
import Base from '../../layouts/Base.astro';

const pages = Object.keys(import.meta.glob('./*.astro', { eager: false }))
  .map((p) => p.replace('./', '').replace('.astro', ''))
  .filter((s) => s !== 'index')
  .sort();

/** slug → [group, title, note]. Anything missing falls back to its filename. */
const NOTES: Record<string, [string, string, string]> = {
  'ab-blend1': ['About · Blends', 'Blend 1 · Pin, with the live statements', 'P2j · Pin throughout — the cropped panning names, the 26px spindle-hole port onto a 1400px record, the centred prose, What I work across and How I work — with the Who I am and closing statements taken from the live site as its own markup, not a copy of its styling. So they arrive the way they do on the site: each line rising out of an overflow-hidden box, the closing one word at a time, 70ms apart. Two clocks on one page — the site’s reveal, which fires once, and P2j’s scroll-driven turn and pan, which run throughout.'],
  'ab-d': ['About · redesigned from scratch', 'D · Poster', 'Swiss posters in the site’s own grotesk: each movement’s name so large the screen crops it, panning sideways as you scroll past, over a strict twelve-column grid. Monochrome — the only colour is the site’s orange on the full stops.'],
  'ab-fh5': ['About · ab-fv8, process at scale', 'FH5 · Hanging Display', 'FV8’s idea at the size FV8 should have used. Same display face, same uppercase, same −0.045em — the page’s own way of naming a movement — but at 2.63 times the body instead of 1.65: 40.8px against 15.5px. At that scale the tight tracking stops reading as a label’s device and starts reading as what it is on the frame above. The names sit flush left and the prose indents three characters under them, so the left edge of the section is three large names and nothing else. No rules, no numbers, no boxes: one alignment, held.'],
  'ab-fitlive': ['About · Blends', 'Fit · with the live frame', 'Blend 1b · Fit with its fitted SVG titles replaced by the live site’s own heading apparatus, lifted whole: the movement number and name at the top left, the place at the top right, the folio and year range at the bottom left, Selected works and the scroll cue at the bottom right, and the name again at size in the middle. Everything below the frame is Fit’s — the live statements and their reveals, the prose at 48 characters, How I work at 42 with its questions breaking to 56. Amended 19 Sep: the spindle ports and the records behind them are gone, the closing statement is set in the opening statement’s face rather than the serif, and Who I am carries 02 in the accent like the three movements below it.'],
  'ab-hv2': ['Selected works · the hover reading', 'HV2 · The Corners', 'Hover a work in the conveyor and it answers with its format, platform, role and year \u2014 one fact in each corner of the frame, in the page\u2019s own corner furniture, with nothing at all in the middle. The frame labels the picture instead of the picture carrying a label. Flat hierarchy on purpose: four facts, four corners, one size, one weight, one tone, because which of them matters is the reader\u2019s business. The four blocks travel 12px in from their own corners and land together at 170ms rather than in a stagger \u2014 a stagger makes the frame assemble, landing together makes it arrive. Measured at 1280\u00d7800: x 76.8 and 1203.2, y 96\u2013135.5 and 664.5\u2013704, clear of the cards, the readout and the running head. A work with only three facts fills the corners in reading order and leaves the last one empty.'],
  'ab-hp1': ['Selected works · the hover reading', 'HP1 · The Plinth', 'The picture gains a base. A hairline exactly as wide as the work, seated in the foot of the frame at the mask’s own 9%, with the reading standing on it — so the panel is not beside the picture or on it but under it, in the one band that is clear of every work at every scroll position. THE COLUMN COUNT COMES FROM THE PICTURE’S OWN WIDTH: repeat(auto-fit, minmax(104px, 1fr)) over the card’s rendered box, so the centred work at 556.3px sets four columns of 128.9 and a 9:16 work at 277.1px sets two of 128.3 and wraps to two rows. Nothing names a ratio and nothing switches on a slug — the same device the stills grid uses on a work page. Label over value, four equal fields, --muted at 6.2:1 over --bone. Motion: the rule draws left to right in 210ms and the four cells rise 7px on a 48ms stagger behind its leading edge, 324ms end to end. The only direction here that touches the readout — it steps back to 0.14 over 140ms rather than being dodged, because the plinth and the instrument want the same band. One declaration to drop if that is not wanted. Clamped into the page margin, so a work hanging off the frame measures the part of it you can see.'],
  'ab-hp2': ['Selected works · the hover reading', 'HP2 · The Overprint', 'No furniture at all: no panel, no scrim, no box, no rule and no labels. Four words set straight onto the photograph in its bottom-left corner, 20px in and 18px up, inside the 5.5% radius the picture’s box carries. THE LABELS ARE GONE, which is the idea and the risk — a format, a platform, a role and a year are each recognisable from their own form, and dropping the names takes the block from eight elements to four and from 66px tall to 38px, which is what lets it sit in the picture rather than become a panel. Order is the only hierarchy. The year is the one figure in the set and carries an 8px accent tick HANGING IN THE MARGIN on a negative margin-left, so the type stays flush and the mark sits outside the column like a printed sidenote. Motion: one clip-path wipe left to right in 190ms — nothing moves, something is uncovered — with the open state slack by 18px on every edge so the text-shadow is not shaved off. The honest cost is contrast: this is the only direction that sets type on a full-brightness still rather than on the ground or the bed, and the two-part shadow is the whole defence.'],
  'ab-hp3': ['Selected works · the hover reading', 'HP3 · The Plumb', 'The pointer draws a line and the line carries a heading. A hairline stands at the pointer’s x for the full opaque height of the frame, y 72 to 728, and the four facts set as ONE LINE at its head in the clear band above every work. TWO CLOCKS, DELIBERATELY: the rule tracks x continuously with no transition — it is under your finger — while the reading SNAPS to the page’s own twelve columns. Measured at 1280, a column is 75.09px and the step between boundaries 95.57, so the type can only start at 76.8, 172.4, 267.9 … 1128.1. The reading takes whichever side of the plumb has room: right by default, snapped to the first boundary 14px clear, and flipping to the left with the slide-in reversed when that would pass the right margin. That needs the line’s width, so this is the ONE direction in the set that fills before it places. One line and not a stack because four stacked pairs would be 194px tall and run into the work band — set as one line the discipline holds: the rule may cross a photograph, the type may not. Motion: transform-origin is the pointer’s own y, so scaleY 0 to 1 over 170ms opens the line up and down from exactly where you are, and the words fade in 7px out of it.'],
  'ab-hp4': ['Selected works · the hover reading', 'HP4 · The Crossing', 'Four rules cross the whole frame and the picture is what they cross. Margin to margin, x 76.8 to 1203.2, four hairlines stacked on the frame’s vertical centre at y 312 to 488, each carrying its label flush left and its value flush right. The work is struck through by its own data. THE LABEL AND THE VALUE ARE 1126px APART, which is the point and not an oversight: this is how a table of contents is set, and the rule is what carries your eye from the name of the thing to the thing. Nothing else in this set asks the reader to travel; here the travelling is the reading. The only direction indifferent to where the picture is — the rules are the page’s, so they are in the same place whichever work you point at. Hierarchy is in the rule’s WEIGHT and not the type’s: the three upper rules are --rule-soft at 7% white and the year’s is --rule at 13%, the only figure getting the only solid line. Motion: each rule scales from its left edge over 190ms on a 28ms stagger, each label fades as its own rule starts, and each value is held 150ms so it appears at the far margin about as the rule reaches it — the reading is carried across rather than switched on. It leaves as one thing, 110ms, no stagger.'],
  'ab-hp5': ['Selected works · the hover reading', 'HP5 · The Slug', 'No new furniture anywhere on the frame. The page already has an instrument that names the work you are looking at — the readout, a caption over a sixteen-tick arc with the year beneath it — and this gives that instrument one more thing to say. Hover a work and the caption line stops being its title and becomes its slug: MICRO DRAMA · SOCIAL-FIRST · SOUND DESIGN · 2025, in the readout’s own voice, on the line the title was on. THE MINIMUM POSSIBLE INTERVENTION, which is the argument for it: not one pixel of the frame changes, there is nothing to place, clamp or collide with, and a visitor who never hovers sees exactly the page that is live today. Against that, it puts the reading furthest from the thing being read — the slug is 584px down the frame whichever work you point at. Values only; the dividers are the page’s accent because on this page the accent marks information, and they are the one part of the line that does NOT wake, so the punctuation belongs to the instrument and the words to the work. Motion: the send action’s own wave at the scale of a fact — --dim to --bone, 200ms apiece on a 60ms stagger, crossing the line in 380ms. A letter-level wave was tried and is wrong at 47 characters: 1.2 seconds is a page turning, not a label answering. The title fades UNDER the slug rather than being rewritten, because paint() writes that node every frame and anything writing to it would lose on the next scroll event.'],
  'ab-hp6': ['Selected works · the hover reading', 'HP6 · The Quarter', 'The grid places the reading, not the picture. Four fields across the head of the frame, each exactly three of the page’s twelve columns, margin to margin — the information is filed where the page says information goes and the work has no say in it. THE ARITHMETIC FALLS OUT EXACTLY, which is why it is four: at 1280 a column is 75.09px, three columns plus two inner gutters is 266.23, and four of those plus three gutters is 1126.36 against a content width of 1126.4. So repeat(4, 1fr) with column-gap: var(--gutter) IS a 3-3-3-3 division of the twelve, at every width, with nothing hardcoded. Each field is ruled: label at 10px, a hairline the full width of the cell, value at 18px — how a specimen sheet is set, so the eye reads across rather than down. It occupies y 72 to 118 and clears the tallest thing the conveyor can produce by 35.6px, so it is the only direction whose panel is placed entirely in CSS with no rect read from the card at all. A three-fact work leaves the fourth field EMPTY rather than redividing: the fields do not grow, because then the same fact would sit in a different place on a different work. Motion: every cell clips open downward and every rule draws from its own left edge, all four together over 200ms, no stagger and no delay anywhere — the deliberate counterpoint to ab-hp8, which stages the same four facts sequentially.'],
  'ab-hp7': ['Selected works · the hover reading', 'HP7 · The Yield', 'The work makes room for its own caption. Every other direction adds a reading to the page; this one takes it out of the picture — the photograph retreats from the foot of its own frame by a quarter of its height and the four facts set in the strip it gives up. THE PHOTOGRAPH IS CLIPPED, THE BOX IS NOT, and that is the whole trick: .st__win carries the 5.5% radius, the 0 40px 90px drop shadow and the #0F0E0D background, so clipping it would delete the picture’s shadow on all four sides. What is clipped is .frame__layer, the stills inside — the box keeps its shadow and its radius and the strip exposes its own lifted ground, so the caption sets at 18.7:1 with no scrim anywhere. The crop is a PERCENTAGE, which is why there is no scale arithmetic: inset(0 0 26% 0) resolves against the layer’s own box, so it is a quarter of the picture whatever the conveyor has scaled it to, and the scroll watcher never touches it. It is a registered @property or it would not animate — an unregistered custom property interpolates discretely and the crop would jump — and the transition lives on .wcard rather than on the layer, because .frame__layer already owns its transition for the scrub crossfade and a shorthand written from the page would kill it on the one work being pointed at. 26% is the smallest crop that holds a two-by-two field on the narrowest work the gate admits, 232.8 x 413.9. Motion: the strip opens over 210ms and the type is held back 90ms and rises 6px, so the room exists before anything is put in it; reversed leaving, type first, so the plate is never briefly empty.'],
  'ab-hp8': ['Selected works · the hover reading', 'HP8 · The Index', 'The reading is numbered and the numbering is the hierarchy. 01 02 03 04 in the page’s accent, flush right against the frame’s right margin, each with its value beside it and no label at all. Nothing is bigger or brighter than anything else; what ranks the four facts is that they are counted. THE PAGE ALREADY COUNTS THINGS THIS WAY — work pages set their recognition as a numbered index, the catalogue numbers every work as a three-digit folio, /about numbers its movements, and the home page’s own sections carry 01, 02, 03 — so this is the direction most obviously made out of parts the site already has. The labels are dropped and the ordinals take their place: two marks per row would be a label and a number doing the same filing job, and the ordinal wins because it also gives the reading an order. Ordinals are in the TEMPLATE rather than written from script, so Astro stamps them with the scope attribute itself. It grows upward from bottom: calc(9% + 10px) and occupies y 616 to 720 at x 1053 to 1203.2 — the quietest quarter of the page, clear of the readout at x 1000 and of every work at the gate. Motion: a TRUE STAGGER, and it is the point — each row travels 8px in from the right over 180ms on a 34ms stagger, settling at 282ms, because a numbered list is the one shape where arriving in order is what the content is already doing. Held against ab-hp6 it is the clearest test in the set of whether a stagger reads as intent or as delay. A three-fact work is numbered 01 02 03 and stops, the opposite decision from ab-hp6 where the empty field holds its place.'],
  'ab-mv1': ['Selected works · how the reading arrives', 'MV1 · The Composing Stick', 'The type is SET, not faded in. Four facts slide in from the left along their own baselines and come to a hard stop against a rule, the way a line of metal type is knocked up in a composing stick. Nothing fades — each line is at full strength behind a mask and it ARRIVES. The easing is not the site’s: cubic-bezier(0.62, 0, 0.16, 1) is fast out of the gate, still travelling three-quarters of the way, then stops almost dead, which is the difference between a drawer closing and a line of type hitting a stop. The rhythm is MECHANICAL — 55ms between lines, equal intervals, verified at 0, 55, 110 and 165ms — because a stagger that eases reads as choreography and this is meant to read as a machine running at one speed. Label and value share ONE baseline across a fixed 96px tab stop, so the four values line up on a second vertical edge and the block has two edges rather than one. The catalogue steps back to 0.22 and the held work to 0.56: the stick runs x 76.8..426.8 while the centred work runs x 259.7..816.1, so the type is over the work being read and not only over its neighbours. Measured across all sixteen, the worst contrast is 5.26:1. The project title opens its tracking from 0.02em to 0.055em while the reading is up — the page making room, and nearly subliminal.'],
  'ab-mv2': ['Selected works · how the reading arrives', 'MV2 · The Unfold', 'One opaque leaf hinged at the frame’s head, swinging down. It rotates about its own top edge from rotateX(-88deg) to flat under a 900px perspective, so the reading arrives as one physical object rather than as four pieces of information — the only direction in either set that moves in three dimensions, and it earns that by being the only one whose panel is a THING: an opaque leaf with an edge, a ground and a hairline. IT OVERSHOOTS, and the overshoot is the character: cubic-bezier(0.34, 1.26, 0.38, 1) over 420ms takes it past flat and lets it come back. Nothing else on this site overshoots. The facts COUNTER-ROTATE — 14deg of their own, flattening over 300ms on a 90ms delay — so they are still settling as the leaf lands; without it the type is painted on the board and the whole thing reads as a texture rotating. A 1px accent line catches the leading edge while it turns and is gone before you can look at it directly. Six of the twelve columns, flush right: measured 553.0px, exactly 6 columns plus 5 gutters, its left edge on column boundary 7. It brings its own ground, so it needs no recession — and it overlaps the top of the work band by 51.8px on the tallest card, deliberately, because a plate that comes down OVER the work is a plate and one that stops politely short is a panel.'],
  'ab-mv3': ['Selected works · how the reading arrives', 'MV3 · The Curtain', 'One continuous sweep down the frame, and everything else follows from it. A veil descends from y 72 to y 728 over 520ms with a 1px accent line on its leading edge; as that edge passes each fact the fact lights, and as it passes the project title the title steps back to 0.42. NOTHING HERE HAS A DELAY CHOSEN BY HAND — every delay is that element’s own y as a fraction of the sweep, written in CSS as calc((var(--y) - 72) / 656 * 520ms). Verified: the four marks compute 61.83, 172.81, 283.78 and 394.76ms and the caption 401.10ms, which is exactly the geometry. The sequencing IS the geometry, which is why it reads as one gesture rather than as five things timed to look like one. THE GESTURE MAKES THE GROUND IT NEEDS: most directions answer the contrast problem by adding a gradient, a plate or a recession, and this one has the recession BE the animation — the veil is rgba(10,9,8,0.72) and what it leaves behind is the darker page the reading needs, with no second timeline to keep in step. Measured, the worst contrast anywhere is 9.43:1. The facts are spaced down the frame at y 150, 290, 430, 570 rather than grouped — the only layout in either set that uses the frame’s full vertical extent, and it exists because the motion does. The easing is nearly linear on purpose: a curtain falls at the speed it falls. Going back up is FASTER, 380ms, and the facts go dark in reverse — symmetry would read as an undo, a quicker return reads as a release.'],
  'ab-mv4': ['Selected works · how the reading arrives', 'MV4 · The Convergence', 'Four facts arriving from four depths onto one plane. The first grows into place from 0.880, the last shrinks into it from 1.080, the two between depart from 0.947 and 1.013 — and they land TOGETHER at 300ms. Nothing is staggered: what separates them is not time but DISTANCE, so the arrival has depth without having an order. Held against ab-hp8, which stages the same four facts in four beats, and ab-hp6, which lands them flat together, this is the third answer. And then it keeps breathing: the four hold their planes against the pointer, the nearest moving 5px across the whole frame and the furthest 1.25px — verified by writing pointer positions and reading the transforms, which came back 1.25, 2.5, 3.75 and 5.0px exactly. The project title is put on the DEEPEST plane of all at 0.8px, which ties it into the same space rather than leaving it flat behind a floating panel. The restraint is the whole risk: past about 8px it reads as a toy, and 1:1 tracking reads as a gimmick within two seconds. The arrival and the parallax are on TWO elements because both are transforms and one element can carry only one transition for transform — written on one, the parallax inherits the arrival’s 300ms curve and trails the pointer by a third of a second. The pointer is read once per frame from an rAF, not per event.'],
  'ab-mv5': ['Selected works · how the reading arrives', 'MV5 · The Spine', 'The reading runs UP the edge of the page, set like a book spine — the one place in typography where a line may turn ninety degrees and nobody thinks it is a trick. It is the only direction in either set that changes the AXIS of the type. It unrolls upward: a single clip opens from the foot of the column to its head over 480ms on cubic-bezier(0.32, 0.72, 0.2, 1), quick off the mark and long in the tail, so the words appear in the order you would read them. The hairline draws with it and FINISHES FIRST — 380ms against 480 — so the type is set against a rule that is already there rather than racing it. The facts are reordered for this direction only, year first at the foot where the eye starts, because the axis changed. VALUES ONLY AND AT 14px, both forced by measurement rather than taste: with labels at 17px, ELEVEN of the sixteen works overflowed the top of the frame and Special Ops 2.0 asked for 948.6px against the 656 available. Labels alone were 215.6px of that. After: the worst case is 600.6px, nothing overflows, and with the catalogue at 0.25 the worst contrast on the spine is 14.78:1. That loss is real and worth naming — a reader gets 2025 and Hotstar with nothing saying which is which — and if labels matter this is not the direction to take.'],
  'ab-mv6': ['Selected works · how the reading arrives', 'MV6 · The Counterweight', 'Three things move, in two directions, weighted against each other. The work you are pointing at LIFTS 12px, the reading RISES 18px into the space under it, and the project title DROPS 5px. No other direction in either set moves the picture at all. The masses have different inertias and that is the whole craft of it: the picture overshoots on cubic-bezier(0.34, 1.32, 0.42, 1) over 340ms, the reading does NOT on 240ms, the title barely does on 300ms. A picture is the heaviest thing on the page and may arrive past its mark and settle back; type that bounces reads as a toy. Held against ab-mv2, which puts the overshoot on a panel, this asks the same question of a photograph. The lift is on .st__win and not on .wcard, whose transform paint() rewrites every frame — the window carries the radius and the shadow, so lifting it takes the shadow with it. It is 12px in the CARD’S space, which measures 11.7px on screen at scale 0.975: correct rather than a rounding error, because a work further away should lift less. The typography is inverted — value at 20px with its label UNDER it, like a figure and its caption — and nothing is drawn, so it can be compared against ab-hp1, which is the same placement with the opposite manner. The readout’s year steps aside while it is up, because the beam is already saying it.'],
  'ab-mv7': ['Selected works · how the reading arrives', 'MV7 · The Slip', 'The reading is DRAWN OUT from behind the picture, like a slip pulled from a sleeve — the idea being that the information was always there, filed behind the work, rather than summoned on top of it. Every other direction in these sets adds something to the frame; this one takes something out of it. Three movements in one gesture and the third is what sells it: the slip translates 26px out from under the picture, a clip travels with it so its leading edge is always exactly at the picture’s edge and it genuinely appears to EMERGE, and it carries a 0.55deg rotation that settles to zero as it comes to rest. A card drawn from a sleeve never comes out square; without the rotation the whole thing reads as a panel with a mask on it. It takes whichever side it fits on — out to the right by default, out of the LEFT edge with the clip, the translate and the rotation all mirrored when a 280px slip would pass the margin. Verified on all sixteen works and on the off-centre positions that force the flip: every slip lands inside the frame and inside the mask’s band, tucked 12px under the picture, and settles to identity. It brings its own ground and its own shadow, so there is no recession, no gradient and nothing to measure. The picture is not touched at all — it does not lift, dim, crop or move.'],
  'ab-mv8': ['Selected works · how the reading arrives', 'MV8 · The Cascade', 'The facts FALL, and they land hard. Four values drop 26px on an ACCELERATING curve — cubic-bezier(0.55, 0.06, 0.88, 0.24), close to the shape of gravity — so each is moving fastest at the moment it arrives. Every other reveal in both sets decelerates into place because that is what interface motion is taught to do; this one refuses, and the refusal is the point: a thing that eases to a stop is being placed, a thing that accelerates to a stop has ARRIVED. And the page answers: under each value is a hairline exactly the width of that value’s own ink (verified — 100.5/100.5, 73.5/73.5, 232/232, 41.2/41.2), and at the instant its value lands that rule compresses to 0.35 of its height and springs back. Four small impacts in sequence, each one 1px of movement on a 1px line, which is what turns a stagger into a cascade. 70ms apart, which is slower than it sounds — 470ms end to end, deliberately past the point where four things read as simultaneous, because the whole direction depends on the impacts being heard separately. LAST IN, FIRST OUT: leaving, they lift in REVERSE at 55ms apart, counted back from however many facts the work has, so a three-fact work does not start its exit with a beat of silence. The title takes the LAST impact only, timed from script to whichever landing is last — 450ms with four facts, 380ms with three.'],
  'ab-fm1': ['Selected works · what the reading is', 'FM1 · The Rarity', 'How rare a fact is decides how big it is set. A value no other work carries sets at 34px; the commonest in the catalogue sets at 15px; the rest fall on the line between — so the hierarchy is COMPUTED FROM THE CATALOGUE rather than chosen, and it is different on every work. Point at Bloody Bubbly and Sound Design is the largest thing on the frame, because it is the only sound-design credit in sixteen works. Aasha leads on ZEE5, Mere Ho on Producer, Taskaree on Additional Composer. It is the only direction in any of the three sets where the typography CARRIES information rather than expressing it: size is the datum, and it cannot be wrong because it is counted. They arrive commonest first, so the line builds to what is unusual. THE TOP OF THE SCALE IS COUNTED, NOT WRITTEN, and that was a bug first — set against YouTube’s 6, the commonest PLATFORM, the year fell off the bottom: 2025 is carried by NINE works and computed 3.6px, unreadable on nine of the sixteen. Measured after: 1 share -> 34px, 3 -> 29.25, 5 -> 24.5, 9 -> 15, and nothing overflows the measure.'],
  'ab-fm2': ['Selected works · what the reading is', 'FM2 · The Kinship', 'The sixteen works are drawn, and the ones this work is like light up. A rule runs margin to margin divided into sixteen segments, one per work in score order; the four facts set above it instantly, and then the rule answers a different question every 620ms — which works share this format, this platform, this role, this year. It is the ONLY reading in any of the three sets that puts a work in relation to the others: everything else, in all twenty-four drafts, tells you about the work you are pointing at and nothing else. This one says five of the sixteen are this role, and here is exactly which five. Verified on The Shiva Trilogy: the kin counts from the build are 2, 6, 5 and 7 and the four passes light precisely those works. The type is instant and the marks take their time, which is what makes a cycle acceptable — a reader who wants the facts has them in 150ms; a reader who stays gets the second reading free. Withholding them for two seconds was the first version and it was unusable. The lit segments RISE as well as change colour, because a colour-only change on a 1px line at a sixteenth of the measure is close to invisible.'],
  'ab-fm3': ['Selected works · what the reading is', 'FM3 · The Difference', 'It shows you what changed. All four facts arrive lit; 220ms later the ones this work has in common with the work before it in the score recede to --dim, and only what is new stays white. So it answers a question none of the other twenty-three ask: not what is this work, but what is different about it. It only makes sense because the score is an ORDER — composition.ts is a sequence somebody chose, and reading each work against its predecessor reads the portfolio the way it was arranged; moving along the row becomes a kind of differential. The two stages are the whole idea: showing only the changed facts would mean you never see the full reading and cannot tell an unchanged fact from an absent one. Verified on The Shiva Trilogy against My Red Crayon — Platform is the one carried-over fact and it alone dims to rgb(133,133,133) with its accent tick off, while Format, Role and Year stay white with ticks lit. Compared BY LABEL, not by position, because Book My Yamraj has no platform and returns three rows: index-against-index would report a change that is really a missing row. The first work in the score has nothing before it, so everything on it counts as new.'],
  'ab-fm4': ['Selected works · what the reading is', 'FM4 · The Tally', 'Each fact is counted out in front of you. Four rows, each the fact followed by sixteen marks with as many filled as there are works carrying it. Point at The Shiva Trilogy and Role fills five of sixteen, Platform six, Year seven. Point at Bloody Bubbly and Role fills ONE, and that single mark says more about the work than the words beside it. The marks fill from the LEFT rather than at the works’ own positions, which is the difference between this and ab-fm2: that one lights where those works sit, so it answers WHICH; this compares lengths, so it answers HOW MANY. The count is PERFORMED — each mark snaps on 40ms after the last with steps(1, end), no fade, so the row is counted rather than drawn, and a five-mark row takes 200ms while a one-mark row is over before it starts. The unfilled marks are drawn too, or the row is a bar of unknown scale rather than five out of sixteen. The fill was a CSS comparison first and did not survive: the rule was gated behind an @supports test for RELATIVE COLOUR SYNTAX, a different feature, and measured, every row declared the right count with not one mark filled.'],
  'ab-fm5': ['Selected works · what the reading is', 'FM5 · The Ratio', 'The shape the work was made in, drawn. An outlined rectangle at the work’s true aspect ratio sits beside the four facts, so before you read a word you know whether this is a 2.39:1 feature, a 9:16 vertical or a 1:1 song — the one fact in this catalogue that is genuinely visual. THE RECTANGLE IS `ratio`, NOT `Format`, and they are different fields: Format is Ugam’s words for what kind of work it is, ratio is the shape it was shot in, and they do not imply each other. So this direction shows FIVE facts and the fifth is labelled on the page rather than folded silently into the Format row. CONSTANT AREA, NOT CONSTANT HEIGHT, is the whole trick: drawn to a common height a 2.39:1 rectangle is simply a bigger object and the eye reads size before proportion. Every rectangle encloses the same area, so the only thing that differs is the shape — measured, 2.39:1 draws 69.1 x 28.9, 16:9 draws 59.6 x 33.5, 1:1 draws 44.7 x 44.7, 9:16 draws 33.5 x 59.6, all true to the ratio and constant in area to within the rounding. It draws itself edge by edge, top then right then bottom then left. All eight shapes stand on one shared floor at y 152.'],
  'ab-fm6': ['Selected works · what the reading is', 'FM6 · The Specimen', 'The role is the specimen and the other three are its apparatus — a type specimen sets ONE thing large and surrounds it with the particulars, and this reads the work the same way. The argument for putting Role at the top of the hierarchy is that this is a COMPOSER’S portfolio: what a visitor is deciding is whether this person can do the thing they need doing, and the role is the only one of the four that describes him. Every other direction in all three sets treats the four as equals or ranks them by an abstract rule; this one takes a position. The size is FITTED, not chosen — the roles run from Producer to Additional Production / Assistant Composer, 8 characters to 41, so any fixed size is small for the short ones or off the page for the long. The ceiling was 44px first and the fit never fired: at 44 the longest role sets 851.9px against a 1126.4px measure, so all sixteen came out at exactly 44 — a fitted specimen that was not fitting anything. At 72 the long roles genuinely come down (the longest to 58.2px) and the short ones get the full size. The scale is why the catalogue steps back to 0.24: 72px of role plus its rule and apparatus is about 100px, which the 83px clear band will not take. The rule under it is drawn to the width of the SET role, so it changes length with every work.'],
  'ab-fm7': ['Selected works · what the reading is', 'FM7 · The Proportion', 'The whole catalogue, segmented four ways, with this work’s segment lit. Four bars run margin to margin, one per fact, each the sixteen works divided into groups by that fact — eight segments for Format, six for Platform, nine for Role, two for Year — and the segment this work belongs to is the lit one. So the reading is not your role is Composer but Composer is this much of the catalogue, and you are in it. It is the only direction that shows the SHAPE of the whole body of work: read down the four bars and the portfolio describes itself — Format evenly divided into eight, Role dominated by one group of five with six singletons hanging off it, Year two blocks because all of this is two years old. None of that is stated anywhere on the site and none of it is a claim; it is the catalogue, counted. THE BAR IS ALWAYS SIXTEEN WORKS LONG, which took a correction: only twelve works name a platform and only three carry Channels, so bars built from the groups alone stretched twelve works across the full width and the Platform bar looked exactly like the whole catalogue divided six ways. The remainder now gets a quieter segment of its own, so four works having no platform is something you can see and count — the more interesting reading as well as the honest one.'],
  'ab-fm8': ['Selected works · what the reading is', 'FM8 · The Index', 'The preview is the catalogue’s own index with your row lit. Five rows of a table — folio, format, platform, role, year — the hovered work in the middle at full strength and its two neighbours either side at --dim. So this is not a panel about one work; it is a WINDOW onto the index, and the work you are pointing at is simply the line that is lit. And moving along the row SCROLLS the index rather than replacing it: point at the next work and the table shifts by exactly one row, carrying the neighbours with it — verified by catching it mid-move, where the body reads translateY of exactly one row height and settles to zero. Held against every other direction in all three sets, which build a fresh panel per work, this one never rebuilds: it moves. A table is a bad answer to tell me about this work and the only honest answer to where does this work sit, because you cannot see a position without seeing what it is a position among. The columns are fixed across all sixteen rows or it is five captions rather than a table. Above the first work and below the last there is nothing, left blank rather than wrapped: a catalogue has a beginning, and showing work sixteen above work one would imply a loop the score does not have.'],
  'ab-sw1': ['Selected works · the work is never touched', 'SW1 · The Footprint', 'The reading is the work’s footprint and it MOVES with it. A rail in the foot band, exactly as wide as the picture above it, with the four facts standing at the centres of its four quarters — so a 556px work spreads its facts 139px apart and a 232px work packs them into 58. The work’s proportions set the reading’s rhythm. It tracks: the conveyor never stops, and most panels in the three earlier sets sit still while the work they describe travels away from them. This one is re-placed every frame from the card’s own rect. Verified at 1280x800: the rail matches the picture to the tenth of a pixel (x 259.7, w 556.3) and the four facts land on the quarter centres at 69.5, 208.6, 347.7 and 486.8 exactly. The readout’s year steps aside because the rail crosses it and the rail already says the year. Nothing is laid on the picture and NOT ONE of the sixteen cards changes opacity, transform, filter or clip when it opens.'],
  'ab-sw2': ['Selected works · the work is never touched', 'SW2 · The Lintel', 'The reading is set as a LINTEL, which is the page’s own device — the works section already has one, sized as an expression rather than a number so it is as wide as the text column at every width, and it scrolls away at the top and the frame never sees it again. This gives that slot back and gives it to the data. THE SIZE IS THE CONTENT’S, NOT A CHOICE: the four facts are joined into one line and set at whatever size makes it exactly fill the measure, so a work with short values sets big and one with long values sets small, and every work’s line has the same two edges. Verified: all sixteen fill 100.0% of the measure with the ink terminating on x 1203.2, the right margin to the pixel, at sizes from 24.9px to 63.5px. Three bugs to get there — the fit measured the BOX (always the measure) instead of the ink; then the tracking it was measured at was not the tracking it settles at; and then a running CSS transition was overriding the inline style used for the measurement, because a transition sits ABOVE inline in the cascade.'],
  'ab-sw3': ['Selected works · the work is never touched', 'SW3 · The Column Lock', 'The facts fly in and LOCK into the grid, and you see them lock. Each arrives from outside the frame, overshoots its column by 9px and snaps back — and at the instant it seats, a 1px rule flashes down the boundary it locked to, then goes. The grid is invisible on this site; for 180ms per fact, it is not. They arrive from ALTERNATING sides, first and third from the left, second and fourth from the right, so no fact travels more than half the frame and the block reads as a composition assembling rather than a queue unloading. Verified: all four land on the page’s own column boundaries — 76.80, 363.52, 650.23, 936.95, which are boundaries 1, 4, 7 and 10 — with lock delays of 0, 70, 140 and 210ms and flashes at 260, 330, 400 and 470ms. The overshoot is 9px because past about 14 it reads as elastic, which is the wrong register for a grid: a column lock should feel like a detent.'],
  'ab-sw4': ['Selected works · the work is never touched', 'SW4 · The Counter-scroll', 'The reading moves AGAINST the catalogue. The conveyor slides left as you scroll; this slides right at a third of the rate, for as long as a work is held. It is the only direction in any of the four sets whose motion is driven by the PAGE rather than by the pointer or a timeline — it has almost no arrival choreography, because what it is doing is joining the kinetic system the composition already has. Why opposition and not sympathy: a panel travelling WITH the work is a label pinned to it, and ab-sw1 does that better by tracking it exactly. Moving the other way makes the reading a fixed thing the catalogue is passing, which inverts the page’s hierarchy for as long as you hold a work. Verified across a 400px scroll: the card travelled -260.7px and the reading +86px, a ratio of -0.33, opposed, and clamped inside the page’s margins throughout.'],
  'ab-sw5': ['Selected works · the work is never touched', 'SW5 · The Condensation', 'The words CONDENSE into legibility. Nothing fades and nothing moves. Each value begins at 0.62em of tracking — so wide it reads as a row of letters rather than a word — and closes to its own -0.01em. The information is present the whole time and becomes READABLE rather than becoming visible. It is the one reveal in thirty-two drafts that uses no opacity, no transform and no clip: verified, every value computes opacity 1 throughout. The four close at DIFFERENT rates, which is the composition — each duration is scaled by its own length, because tracking is per-letter and a 26-character role moves far more ink than a four-character year. Measured: 4 characters closes in 380ms, 12 in 432, 26 in 523. They start together and arrive apart, which is the opposite of a stagger and reads as four things settling rather than four things queuing. The labels hold still at their own 0.16em.'],
  'ab-sw6': ['Selected works · the work is never touched', 'SW6 · The Title Takes It', 'The metadata is MEASURED BY THE TITLE. The four facts set beneath the work’s name and are justified to the name’s own ink width — not to the measure, not to the readout’s box — so the title and its metadata become one typographic object. Change the name and the whole block changes width. It is the only direction in thirty-two that makes the project title structural. Verified: eleven distinct block widths across the sixteen works, ten of them tracking their title exactly, from 215px to 437px. Two corrections got it there. Set as ONE line the four facts need about 420px before their values touch, and the titles run 79.6 to 436.8 — so thirteen of sixteen sat at the floor and the whole proposition was invisible five sixths of the time; two rows of two need only 215. And below the caption nothing is free until y 664, which is 64px from the mask’s edge and not enough — so the ruler and the year stand down for as long as a work is held, and the TITLE does not, which is the point.'],
  'ab-sw7': ['Selected works · the work is never touched', 'SW7 · The Footline', 'The facts join the page’s own footer line. The running head is fixed at the bottom left of the viewport and the whole width to its right is empty at every scroll position on every page of this site; nothing has ever been put there. The four facts set on that same baseline, flush right, in that same 10px at 0.14em. It is the QUIETEST of the thirty-two and that is the proposition: no panel, no rule, no ground, nothing that could be called an effect. A visitor who is not looking for it may not notice; one who is will find that the page’s own furniture answered them. It is the direction to take if the site should feel like it always knew rather than like it responded. Verified: the panel is position: fixed and OUTSIDE the pin’s mask — at y 760 inside it the footline would render at about 0.55 opacity, which on --dim is invisible — sharing the running head’s band at y 762..776 against its 759.8..776, clear of it horizontally, and terminating on the right margin. The words are wiped in left to right at 0, 60, 120 and 180ms.'],
  'ab-sw8': ['Selected works · the work is never touched', 'SW8 · The Aperture', 'The frame has two edges nobody has ever seen. .wk__pin carries a mask that fades its top and bottom 9%, so there are two horizontal lines on this page — at y 72 and y 728 — where the frame stops being transparent. Every draft in all four sets has been placed against those two numbers and none of them has ever drawn them. This one draws them and hangs the reading off them: two hairlines margin to margin, two facts hanging below the upper and two standing on the lower, so the reading is suspended from the aperture. It is the one direction that explains the page to itself — the works section is built on a window whose edges are soft and therefore unreadable, and showing them tells a visitor what shape they have been looking through. The lines draw from OPPOSITE ends so the frame closes like a pair of jaws, and every element moves toward the middle. Verified: the edges land on y 72 and 727 — the mask’s own figures — spanning the measure exactly, and a three-fact work puts two above and one below rather than rebalancing, because the corners are positions and not a queue.'],
  'ab-rt1': ['Selected works · the shape of the work (fm5 variations)', 'RT1 · The Family', 'The whole vocabulary is always there and hovering SELECTS from it. All eight ratios the catalogue contains are drawn at once — nested from a common bottom-left corner, at constant area — and the one belonging to the work you are pointing at is lit; the other seven stay at --rule-soft. This turns a proportion into a POSITION: ab-fm5 draws one rectangle and asks you to remember the last one, and this never asks you to remember anything, because every shape the portfolio works in is on screen the whole time. You read not this is 2.39:1 but this is the widest of the eight, which is seen rather than computed. Nested from a corner and not centred — concentric, the eight would cross into a rosette with no shared edge to compare along. Nothing moves when the work changes, only the light, so the diagram reads as a fixed instrument the works are measured against. The count is part of the fact: 16:9 is six of sixteen, 9:16 three, 1:1 two, the rest only work. Verified: eight shapes, all sharing the corner at 0,0, exactly one lit per work, every lit ratio true to the card’s own --arn.'],
  'ab-rt2': ['Selected works · the shape of the work (fm5 variations)', 'RT2 · The Morph', 'One rectangle that never redraws — it CHANGES SHAPE. ab-fm5 builds a new outline edge by edge for every work; this keeps the same rectangle and lets it deform from the last work’s proportions into this one’s over 420ms. Which makes the comparison automatic and free: a proportion alone is nearly unreadable, and here you never see one in isolation because you always see it ARRIVE from the one before. Going from Taskaree’s 3:2 to Book My Yamraj’s 9:16 is not two facts, it is one movement, and the size of that movement is the information. A ghost holds the previous shape for 260ms so the comparison survives the transition instead of being lost the moment it completes. The numerals do NOT interpolate — there is no such format as 1.82:1, and a counter running through invented numbers would be inventing facts — so they cut while the geometry takes the long way round. Constant area is kept from fm5 and earns its place twice: a morph between equal areas reads as pure deformation where one between different sizes reads as a zoom with a shape change hidden in it. Verified on a paused timeline: 73x41.1 to 71.3x42.8 to 57x57 to 42.8x71.3 to 41.1x73 — exactly square at the midpoint, which is what 16:9 to 9:16 at constant area must pass through.'],
  'ab-rt3': ['Selected works · the shape of the work (fm5 variations)', 'RT3 · The Projection', 'Constant HEIGHT, not constant area — which is how formats are actually compared. fm5 holds area, so a 2.39:1 shape is short and a 9:16 one narrow and the two enclose the same ink. That is fair for abstract proportions and it is not how anyone has ever compared projected formats: widescreen means WIDER AT THE SAME HEIGHT, because a projector’s gate is a fixed height and the image spreads sideways from it. This draws them that way — one baseline, one height, one left edge — and width becomes the fact you read, which is the easiest quantity there is to compare. Two areas of equal size but different shape take real effort to rank; two lines from the same origin take none. It also gives the comparison an absolute reference: a second outline at 16:9, the catalogue’s commonest ratio at six of sixteen, always drawn behind, so every shape is read as wider or narrower than THAT. On the six 16:9 works the two coincide and the reference vanishes into the shape, which is the right reading. What it gives up is real — at constant height a 9:16 work is a 36px stripe, a less impressive object than fm5’s 41x73. Verified: every height is exactly 64, widths match 64 x ratio, 36px at 9:16 to 153 at 2.39:1.'],
  'ab-rt4': ['Selected works · the shape of the work (fm5 variations)', 'RT4 · The Strip', 'All sixteen shapes, in the order the score puts them. A strip of sixteen outlines runs across the head of the frame — one per work, in composition order, at constant height so width carries the ratio — and a mark travels along it to whichever work you are pointing at. The strip never changes; what moves is the reading of it. So the fifth fact becomes a position in a RHYTHM: rt1 shows the eight shapes the catalogue uses, this shows the sixteen in the order they occur, which is a more editorial fact. You can see the run open with landscape works, the three verticals fall together, the two square songs close it. That is the portfolio’s shape rhythm and it is nowhere on the site at present. It is also the conveyor’s own content drawn as geometry — the readout already carries sixteen identical ticks saying only there are sixteen and you are here; this is the same instrument with the ticks replaced by the works’ actual proportions. Nothing grows and nothing reflows: the obvious move is to enlarge the selected shape and it is wrong, because sixteen items on a shared baseline all shift when any changes size. Verified: sixteen shapes, all 22px tall, widths 22 x ratio, strip spanning the measure exactly at 1126.4, and the computed mark lands on the lit shape’s centre to 0.1px.'],
  'ab-xr1': ['Selected works · layout and type (fm5 variations)', 'XR1 · The Spread', 'The head and the foot of the frame as two halves of ONE composition, joined by a single hairline running the full 656px of the aperture. The scale contrast is the whole typography: the ratio numerals set at 64px flush left in the head — larger than the readout’s own 35.8px title, the biggest type in the works section — and the four written facts at 9px flush right in the foot on the opposite margin. Seven to one, diagonally opposite corners, 490px of picture between them, and nothing at an intermediate size, because an intermediate size invites the eye to read a gradient rather than two poles. The rectangle is SET, not placed: an inline-block on the numerals’ own baseline at their cap height, measured at 0.0px off on all sixteen works, so it belongs to the line of type rather than sitting beside it — 46 x the ratio, from 25.9px at 9:16 to 109.9px at 2.39:1. The rule is structural: it falls on the first twelve-column boundary CLEAR of the rectangle’s right edge, so the geometry chooses which column the composition hangs on. Nearest was the first attempt and it was wrong on half the catalogue — measured, it put the hairline inside the rectangle on eight of the sixteen works. Three of the twelve boundaries are reached across the eight ratios (267.9, 363.5, 459.1) with clearances from 20.9px to 89.8px. Motion: the rule delivers the metadata — numerals first, the hairline drawing downward over 520ms, the facts wiping in from the right only once it lands. One unit bug worth recording: --rx was written as a bare number into translateX(), which takes a length and silently discards the WHOLE transform, so the rule sat at x 0 at full height on all sixteen works. An invalid transform is not a clamped transform.'],
  'ab-xr2': ['Selected works · layout and type (fm5 variations)', 'XR2 · The Plate', 'A technical drawing, not a caption. The shape is dimensioned the way a drawn part is: extension lines standing off its own corners, dimension lines running between them clear of the object, the figure sitting on the line rather than near the shape. Both axes are dimensioned, so the ratio reads as a relationship between two measured runs — and the axis figures are the RATIO’s own two terms, 16 and 9, not the pixel size of the drawing, because a plate dimensions the part and not the paper. Verified: every extension and dimension line attaches to the box’s own edges across all eight ratios. All the type is 9px and one piece is not: the ratio alone at 17px, because in a set of drawings the only thing allowed to be large is the dimension being called out. The rectangle holds a constant area — measured 1796.5 to 1800.5 across the eight ratios, which is rounding, not drift — running 65.6 x 27.4 at 2.39:1 to 31.8 x 56.6 at 9:16. That area is set by the band and not by taste: at 2600 a 9:16 work drew its width figure at y 61, eleven pixels above the mask’s opaque edge, so the figure and both extension line tops faded into the gradient on three of the sixteen. The four facts are a numbered key, 01 to 04 in the accent, the number on the label’s line and the value beneath, set two by two. One row of four ran to x 821 on Special Ops 2.0 — 744px from the margin, not a plate surrounded by paper; a 2 x 2 of three-line cells is 94px against 83px of band. Set as it is now the whole reading runs 3.6 to 5.8 of the twelve columns, so six to eight columns are empty on every work. Motion is a measurement being taken: box 260ms, extension lines 260, dimension lines 350, axis figures 520, the ratio 560, the key 600 and 60 a cell — draughtsman’s order, read off the computed style.'],
  'ab-xr3': ['Selected works · layout and type (fm5 variations)', 'XR3 · The Masthead', 'The shape is set as a CHARACTER IN THE LINE. The Format value runs across the head of the frame at 60px and the ratio’s rectangle sits inside that line — on its baseline, at 0.7em of cap height, between the words and the numerals — so the geometry is not a diagram beside the type, it is a glyph in it. Its advance changes with the ratio exactly as a letter’s does: 23.6px at 9:16 to 100.4px at 2.39:1, verified as 0.7em x the proportion on all eight. Which is the one relationship between typography and geometry none of the other variations has: fm5, rt1-4, xr1 and xr2 all make the shape an object the type refers to. Here the LINE’S OWN LENGTH is the fact — measured, 310.6px on Mere Ho to 824.5px on Special Ops 2.0, twelve distinct lengths over sixteen works, 27.6% to 73.2% of the measure. It was written as a fit-to-the-measure first and that contradicted the idea: a fitted line is the SAME length on every work, and the shape stops meaning anything. Measured, the fit was inert anyway — all sixteen wanted more than the 72px ceiling and clamped there. What is left is a guard that shrinks only if the line would pass the measure, and on the present sixteen it never fires. One size, chosen by the band: 62.4px of line box plus 12.6 of footnote plus 6 of air is 81 of the 83px available, so the composition fills y 72 to 153 and nothing else. Format leads and the ratio closes, and the footnote — platform, role, year at 9px flush right — deliberately does not repeat the Format. Two traps: .mvt IS .sec--works and sets text-align: center, which this line inherited, putting the ink at twelve different x positions between 227.7 and 484.7 under a flush-right footnote; and getClientRects() reports TRANSFORMED geometry, so measuring the line while the rectangle is still at scaleX(0.02) under-reads it by the width of the one element the direction is about.'],
  'ab-xr4': ['Selected works · layout and type (fm5 variations)', 'XR4 · The Foot Plate', 'It does not set a heading, because the page already has one. The readout puts the work’s name at 35.784px in the foot of the frame — the largest type in the works section, already doing a headline’s job — and every other variation in these sets composes elsewhere and leaves the page with two headings. This takes the title as the top of its hierarchy: the rectangle immediately left of it at the title’s own cap height on the title’s own baseline, the ratio numerals between the two, the four facts right of it at 10px. Read left to right: shape, ratio, name, particulars. Everything is placed from the title’s INK and not its box — .rl__cap is a block filling the readout’s 720px, so its rect says nothing about the name; a Range over its contents gives sixteen distinct left edges where the box gives one. The composition is asymmetric about a fixed centre and breathes with the name: the ink runs 79.6px on Roar to 436.8px on Dinshaw’s Dildaari Battles. The baseline is MEASURED, by a zero-height inline-block on the baseline of a line set in the caption’s own font, and that is not pedantry — as a hardcoded 592px the rectangle sat 2.6px low on fifteen works and 40.7px low on Mere Ho, where the readout is at y 539.9 rather than 578. A constant cannot follow an element that moves. The facts WRAP to whatever width the name leaves rather than setting in two fixed columns: as a 2 x 2 grid of max-content columns they overflowed the right margin on five of sixteen works and Special Ops 2.0 put ink at x 1286, six pixels outside the frame. Wrapped, the block takes one row on Aasha and Mere Ho, two on eleven works and three on the three longest titles, and grows upward because the baseline is the fixed thing. The stagger follows: the row is ranked off the laid-out offsetTops, since a wrapped block cannot be counted in the markup. The instrument stands down and the name does not — the sixteen-tick arc and the year fade to 0 while a work is held, the caption stays at 35.8px and opacity 1, and `animation: none` is load-bearing on the year because .rl.is-turning .rl__date runs rl-in with fill-mode both.'],
  'ab-xs1': ['Selected works · the title’s place in the composition (xr4 evolutions)', 'XS1 · The Justified Line', 'The whole reading is ONE line, and it is justified. Seven items — the shape, the ratio’s numerals, the name and the four facts — set on one baseline across the full 1126.4px measure, flush on both margins. The items are fixed and THE SPACES BETWEEN THEM ARE THE VARIABLE, exactly as in a line of metal type where the words are given and the spaces are what the compositor works with. So the title stops being a fixed centre and becomes a word: because it is by far the widest item, its length decides the rhythm of the entire line. Measured, the space is a different number on all sixteen works — 98.6px on Aasha, 75.2 on Moholla, 15.8 on Mumbai Standard Time, 10 on Dinshaw’s Dildaari Battles — and within any one line the spaces are equal to 0.1px. The line begins on 76.8 and ends on 1203.2 every time. The readout’s caption stands down, so there is still only one heading on the page, and it is now the HOVERED work’s name rather than the centred one. Motion: it arrives SET SOLID, every item packed left with a single 14px space, and the spaces then open to the measure over 560ms, each item travelling exactly as far as justification moves it — up to 507px, down to 6. Two works justify CLOSED rather than open, which is correct rather than a bug: set solid they are wider than the measure allows, and a tight line is justified by reducing the space below the normal space. Two traps recorded: `justify-content: space-between` IS justification and computing the positions in script would have been wrong the moment the window resized; and --dx must be read from offsetLeft, not getBoundingClientRect, because the rect reports the transform and the first pass measured its own start state — the line closed up instead of opening out.'],
  'ab-xs2': ['Selected works · the title’s place in the composition (xr4 evolutions)', 'XS2 · The Aperture', 'The work’s proportion becomes the page. The largest rectangle of the work’s own ratio that fits the aperture is drawn as a single hairline — 1126.4 x 633.6 at 16:9, 369 x 656 at 9:16, 1126.4 x 471.3 at 2.39:1 — and the whole reading is set inside it: the name hanging from its top rule, the particulars standing on its bottom rule, the numerals in the corner opposite the name. Every other variation in these sets draws the shape as a mark a few centimetres across; this draws it at page scale and puts the type in it. So the composition is RECOMPOSED by every work rather than adjusted by it — the eye’s path, how far it travels and in which direction, is set by the aspect ratio. THE FIGURE IS CONCENTRIC WITH THE WORK AND THE MOTION SAYS SO: it arrives as an exact outline of the card itself, verified to within 1.5px on every work, and opens to page scale over 560ms. Because the card is already drawn at the work’s ratio that is a pure uniform scale with no distortion at any point, and what you see is the work’s own frame growing until it is the page. Rule and type are two layers on one computed box — one transformed, one not — because scaling type up from 24% is the commonest way this idea is done badly. The name WRAPS to the figure rather than being fitted into it: set at the page’s own 35.8px on all sixteen, it takes two lines on exactly one work, Dinshaw’s Dildaari Battles, the longest name in the catalogue in the narrowest figure. A shrink-only fit was the first answer and it drove that name down to 21.8px to hold a line it had no reason to hold. The particulars follow the same rule — one row in a letterbox, three at 9:16 — so the ratio is told three times in one composition and only once by the numerals.'],
  'ab-xs3': ['Selected works · the title’s place in the composition (xr4 evolutions)', 'XS3 · The Column', 'The ratio is the MEASURE. Nothing is drawn — there is no rectangle at all. The proportion becomes the width of the column the reading is set in: 99px at 9:16, 176 at 1:1, 312.9 at 16:9, 420.6 at 2.39:1. The only mark is a hairline across the head of the column, exactly the column’s width, which is the measure made visible. And the name is sized by it — set as large as the column allows, wrapping as many times as it needs to, so the work’s SHAPE decides how big its NAME is set and how many lines it breaks into. Roar takes one line at 114.3px; Dinshaw’s Dildaari Battles takes three at 16. Fifteen distinct sizes over sixteen works. This is the only variation where the title wraps, and wrapping is the point: a name on one line is a label, a name broken over three lines in a narrow measure is a masthead, and the difference is produced by nothing but the aspect ratio. THE SECOND MEASURE IS THE BAND’S DEPTH, read live off the lowest lit card — and it corrects a mistake the whole xr set inherited. That set was built on the note that the cards live in the middle third, x 502..778, which is about the TALLEST card and not the widest: the held card runs to 742.6px on Broken Reflections, and the neighbours fill whatever is left, so there is NO clear vertical strip anywhere in this frame at any scroll position. A 132px headline in the left margin was sitting on three photographs on seven of the sixteen works. Moved to the foot and clamped by the live band depth, it is clear of every lit card, the smallest measured gap being 5.5px. The fit is a bisection rather than two shrink loops, because fitting wrapped type is not a proportion and the two constraints fought each other: Mumbai Standard Time fitted the width at 59.5px over three lines, was cut to 39.8 by the depth, then re-wrapped to fewer lines and filled 67% of a column it had been sized to fill.'],
  'ab-xs4': ['Selected works · the title’s place in the composition (xr4 evolutions)', 'XS4 · The Diagonal', 'The ratio as an ANGLE. A rectangle’s proportion is the slope of its diagonal, and nothing else in this library has used that: every other draft draws the shape as an outline and asks the eye to compare two lengths, where an angle is read in one glance and without comparison. So the geometry is a single hairline through the frame’s centre at exactly the angle of the work’s own diagonal — measured, 22.71 degrees at 2.39:1 through 45 at 1:1 to 60.64 at 9:16, matching arctan(1/ratio) to within 0.2 degrees on every work. THIS IS THE ONE THAT KEEPS AB-XR4’S ARGUMENT: the readout’s caption stays exactly where the page put it, at 35.8px, untouched, still the only headline, and nothing is set at anything approaching its size. What changes is that the composition around it is no longer a line of annotation beside the name but an axis across the whole frame, with the name at its centre. The reading is at the two ends, which are the only places it can be, and both corners MOVE with the ratio: upper-right runs from (1203, 164) at 2.39:1 to (824, 72) at 9:16, so the type travels a quarter of the frame between the widest work and the narrowest, and where it is IS the proportion. The year is not set at all, because the readout’s own date line stays up and a reading that repeats what the page says two inches away is arguing with it — so three facts on most works, two on Book My Yamraj. The ruler stands down instead, the exact inverse of ab-xr4: the sixteen-tick arc runs through y 600..664 and would cross the diagonal at a shallow angle, which is the one thing two pieces of geometry must not do. Motion: every work begins as a square and finds its proportion. The line rests at 45 degrees — 1:1, the rectangle that favours neither axis — and rotates and extends into the work’s own angle over 620ms, both halves turning about a centre that never moves. The two square works are the only ones where nothing turns, which is the animation telling the truth rather than failing.'],
  'ab-live': ['The site itself', 'The homepage before op1 · 20 Sep 2026', 'A byte-for-byte copy of src/pages/index.astro as it stood immediately before the op1 design was applied, kept so the previous site can be read, compared or restored without going through git. Only two things differ from the original: every relative import is one level deeper, because this sits in preview/, and its header comment. The About movements are .mvt--a2 sections with the live statements and their reveals rather than Swiss posters; there is no pane over the page, so the bed shows only through .ap__mat’s breathing window; the conveyor sits on solid ground; and the bed’s grade is on each of the thirty tiles rather than on the bed. This is the page every draft in this library was measured against.'],
  'ab-live-prior': ['Revert point', 'The live site before 2026-09-22', 'A REVERT POINT, NOT A DESIGN. src/pages/index.astro copied verbatim at commit 2533db9, immediately before four things were applied to it in one pass: the section numbers from ab-sy4, the How I work body layout from ab-fs1, the three step numbers from ab-nm1 and the About body-text drift from ab-mo6. Nothing is changed except what has to be — the eleven relative imports gain one ../ because this file sits a directory deeper, and a header comment is added. Verified byte-exact: undoing those two things reproduces the live file’s sha256 (ea5d8e9e985a70e1). To go back, git show 2533db9:src/pages/index.astro > src/pages/index.astro; this page exists so the previous state can be opened and compared side by side, not because git has lost it.'],
  'ab-wh3e': ['Behind the work, on screen', 'WH3E · The Lintel', 'The heading is exactly the measure — declared as the measure divided by the ink constant rather than as a vw number, so it is as wide as the page’s text column at every width, with .fr’s padding-inline cancelled so it starts on the margin with everything else. 131.24px, 10.253vw, 1126.4px of ink filling the measure exactly at 1280 — 76.80 to 1203.20, both margins met. The lightest bite but one: a fifth of the cap, 19.2px of 95.9, under the stills. A lintel the work stacks against. Variations of ab-wh3, which drops .fr--over to z-index 0 so the stills travel in front of the word: .wcard carries z-index 100 and .fr--over only 6, which looks as though the cards already win — they do not, because .wk__pin is position: sticky and sticky always creates a stacking context, so the cards’ 100 is scoped inside the pin and never competes with the frame. What competes is the pin’s own z-index, which is auto. WHAT AB-WH3 DOES NOT DO, measured at 1280 x 800: its ink runs x 128 to 1439, so 159px is off the screen; and its painted cap band is y 926 to 1036 against a card band starting at 1040, so the word CLEARS the work by four pixels rather than going behind it. That tangency is deliberate — 880 + 40 + 0.78 x 153.6 = 1039.81 against 1040.000 — which is why shrinking alone makes it worse: every one of ab-wh3a to ab-wh3d lifts the baseline further clear. So these push the frame down as well, each naming its bite as a fraction of its own cap: top = 50vh - min(20vh, 13vw) - clamp(30px, 5vh, 66px) - size x (0.78 - 0.731 beta), where the first term is the common card’s own top edge — a card is height: min(40vh, 26vw) x --card-k placed top: 50% and pulled back half its height. That equals 30vh at 1280 x 800 and nowhere else, because 26vw and 40vh cross exactly there; anchored to a flat 30vh the bite measured -11.94px at 1024, the word clear of the work again. The baseline sits 0.78em below the frame’s content top (line-height 0.8 against a 1.20em font box) and the cap is 0.731em. The bite is not uniform across the run, which is the design: --card-k enlarges anything narrower than a square by ratio^-0.75, so a 9:16 work stands 492.7px tall against the common 320 and cuts deeper, through a 277px slice of the word. Every figure quoted is the bite against the common height, twelve of the sixteen works. Scoped above 900px, where the pin is still sticky. The ink constant here is 8.583, not the 8.538 used earlier in this thread: with letter-spacing toggled the layout box moves by 96.77px = 14 x 6.912 exactly, so all fourteen spacings are inside it, and the trailing one pulls the box in 6.912px while the final K still paints out to where it was. One correction they all carry: .fr inherits text-align: center, and the box that centring uses is 0.045em narrower than the ink, because all fourteen spacings sit inside it while the final K still paints out to where the fourteenth began. That puts the painted word 0.0225em — 2.95px here — right of true centre, overhanging the right margin while leaving a gap at the left, on the live page as much as here. padding-right: 0.045em on .fr__t makes the box as wide as the ink again, so what gets centred is what you can see. Nothing else changes — same white, same face, same weight, same -0.045em, same stills and animation.'],
};const pretty = (s: string) =>
  s.replace(/-/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase());

const groups = new Map<string, { slug: string; title: string; note: string }[]>();
for (const slug of pages) {
  const [group, title, note] = NOTES[slug] ?? ['Unfiled', pretty(slug), ''];
  if (!groups.has(group)) groups.set(group, []);
  groups.get(group)!.push({ slug, title, note });
}
---

<Base title="Previews — Ugam Khetani">
  <main class="pv">
    <header class="pv__hd">
      <p class="mono pv__eyebrow">Previews</p>
      <h1 class="pv__t">Drafts</h1>
      <p class="pv__lede">
        Design options built as real pages, to be judged in the browser rather
        than described. Nothing here is on the live site unless it says so.
      </p>
      <p class="mono pv__count">{pages.length} {pages.length === 1 ? 'draft' : 'drafts'}</p>
    </header>

    {[...groups].map(([group, items]) => (
      <section class="pv__grp" aria-label={group}>
        <p class="mono pv__grpname">{group}</p>
        <ul class="pv__list">
          {items.map((it) => (
            <li class="pv__row">
              <a class="pv__a" href={`/preview/${it.slug}`}>
                <span class="pv__name">{it.title}</span>
                <span class="mono pv__slug">{it.slug}</span>
                {it.note && <span class="pv__note">{it.note}</span>}
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}

    <p class="mono pv__back"><a href="/">&larr; Back to the site</a></p>
  </main>
</Base>

<style>
  .pv {
    max-width: min(860px, 100%);
    margin-inline: auto;
    padding: clamp(96px, 15vh, 190px) var(--margin) clamp(80px, 14vh, 180px);
  }
  .pv__eyebrow {
    margin: 0 0 clamp(18px, 3vh, 30px);
    font-size: var(--t-micro); letter-spacing: 0.16em;
    text-transform: uppercase; color: var(--dim);
  }
  .pv__t {
    margin: 0 0 clamp(18px, 3vh, 28px);
    font-family: var(--display); font-weight: 500;
    font-size: clamp(2.4rem, 7vw, 4.2rem); line-height: 1; letter-spacing: -0.03em;
  }
  .pv__lede { margin: 0 0 14px; max-width: 52ch; font-size: var(--t-md); color: var(--bone-dim); }
  .pv__count { margin: 0 0 clamp(56px, 9vh, 110px); font-size: var(--t-micro); color: var(--dim); }

  .pv__grp { margin-bottom: clamp(52px, 8vh, 96px); }
  .pv__grpname {
    margin: 0 0 clamp(14px, 2vh, 20px); padding-bottom: 12px;
    border-bottom: 1px solid var(--rule);
    font-size: var(--t-micro); letter-spacing: 0.16em;
    text-transform: uppercase; color: var(--bone-dim);
  }
  .pv__list { list-style: none; margin: 0; padding: 0; }
  .pv__row { border-bottom: 1px solid var(--rule); }
  .pv__a {
    display: grid; grid-template-columns: minmax(0, 1fr) auto;
    gap: 4px clamp(16px, 3vw, 40px); align-items: baseline;
    padding-block: clamp(16px, 2.4vh, 24px);
    text-decoration: none; color: var(--bone);
  }
  .pv__name { font-size: var(--t-md); }
  .pv__slug { font-size: var(--t-micro); color: var(--dim); text-align: right; }
  .pv__note {
    grid-column: 1 / -1; max-width: 60ch;
    font-size: var(--t-sm); color: var(--bone-dim); line-height: 1.5;
  }
  .pv__a:hover .pv__name { text-decoration: underline; text-underline-offset: 4px; }
  .pv__a:hover .pv__slug { color: var(--bone-dim); }

  .pv__back { margin: 0; font-size: var(--t-micro); }
  .pv__back a { color: var(--dim); text-decoration: none; }
  .pv__back a:hover { color: var(--bone); }
</style>
