---
/**
 * THE PREVIEW INDEX — one page that lists every draft.
 *
 * The library used to be 71 pages with no way in except a URL you had to
 * remember, and it was deleted partly for that. This is the way back in: any
 * .astro file dropped in this folder appears here on the next build, with no
 * list to keep in step.
 *
 * DISCOVERY IS A GLOB, NOT A TABLE. `import.meta.glob` is evaluated at build
 * time and is eager: false, so nothing here loads a draft's module — only its
 * path is read. A draft that is deleted stops being listed because the file is
 * gone, which is the only kind of index that cannot go stale.
 *
 * The glob is case-sensitive, as it is in src/lib/frames.ts (HANDOFF §6), but
 * every page in this folder is lowercase .astro so one pattern is enough.
 *
 * NOTES ARE OPTIONAL. A slug with no entry in NOTES still lists, under a title
 * derived from its filename — so adding a draft never means editing this file,
 * and writing a note is a courtesy rather than a requirement.
 */
import Base from '../../layouts/Base.astro';

const pages = Object.keys(import.meta.glob('./*.astro', { eager: false }))
  .map((p) => p.replace('./', '').replace('.astro', ''))
  .filter((s) => s !== 'index')
  .sort();

/** slug → [group, title, note]. Anything missing falls back to its filename. */
const NOTES: Record<string, [string, string, string]> = {
  'mst-desc-a': ['Mumbai Standard Time \u00b7 description', 'A \u00b7 Standfirst', 'The first sentence set large, the rest at reading size. The oldest move in magazine setting \u2014 and the only one of the six that survives a description of any length.'],
  'mst-desc-b': ['Mumbai Standard Time \u00b7 description', 'B \u00b7 Columns', 'Poured into two columns at the film\u2019s width, so the prose sits on the same edge as the film above it. Two short ribbons rather than one long one.'],
  'mst-desc-g': ['Mumbai Standard Time \u00b7 description, length-proof', 'G \u00b7 Drop', 'A real drop cap, sunk three lines rather than a big letter on the baseline. The rule addresses one character, so it cannot care how long the description is.'],
  'mst-desc-u': ['Mumbai Standard Time \u00b7 description, interactive', 'U \u00b7 Unfold', 'The standfirst is always there and the rest opens under it. A real <details>, so it works from the keyboard and with JavaScript off.'],
  'mst-desc-v': ['Mumbai Standard Time \u00b7 A\u2019s layout, with movement', 'V \u00b7 Focus', 'The standfirst arrives out of focus and sharpens as it reaches the reading line. A filter, so the box it occupies never changes.'],
  'mst-desc-w': ['Mumbai Standard Time \u00b7 A\u2019s layout, with movement', 'W \u00b7 Assemble', 'The live lift kept to the decimal, plus a sideways component and a slight scale seeded per word \u2014 the paragraph gathers itself rather than rising as a block.'],
  'mst-desc-x': ['Mumbai Standard Time \u00b7 A\u2019s layout, with movement', 'X \u00b7 Hold', 'Point at the description and every word comes up to full; take the pointer away and the scroll light has it back. It answers a reader who has stopped to read.'],
  'mst-desc-y': ['Mumbai Standard Time \u00b7 A\u2019s layout, with movement', 'Y \u00b7 Proximity', 'A light travels with the pointer and the nearest words come up to white. Word positions are cached once, so a move costs no layout at all.'],
  'mst-desc-w2': ['Mumbai Standard Time \u00b7 A\u2019s layout, with movement', 'W2 \u00b7 Depth', 'W\u2019s family with the scale carrying the variation: every word rises the live 0.32em, but each starts at its own distance, 0.90 to 1.00.'],
  'mst-desc-w3': ['Mumbai Standard Time \u00b7 A\u2019s layout, with movement', 'W3 \u00b7 Stagger', 'The only one that changes WHEN rather than where. Identical path for every word, each clock nudged up to a fifth of the reveal, so words do not arrive in reading order.'],
  'mst-desc-w4': ['Mumbai Standard Time \u00b7 A\u2019s layout, with movement', 'W4 \u00b7 Tilt', 'Each word settles out of its own rotation of up to 2.4 degrees, pivoting near the baseline so it tips into place rather than wobbling.'],
  'mst-desc-w5': ['Mumbai Standard Time \u00b7 A\u2019s layout, with movement', 'W5 \u00b7 Ink', 'No geometry at all beyond the live rise. The words darken in at their own rates, the way a page comes up in a developing tray. The cheapest of the five.'],
  'mst-desc-m': ['Mumbai Standard Time \u00b7 restored, own layout, now scrollable', 'M \u00b7 Cascade', 'Each sentence rises out of its own slot, masked rather than faded. Sets the description as sentence blocks, so the layout is not the live one.'],
  'mst-desc-n': ['Mumbai Standard Time \u00b7 restored, own layout, now scrollable', 'N \u00b7 Focus pull', 'Sentences arrive out of focus and sharpen. Blur is per sentence, not per word, because blur is the one filter with no cheap composite path.'],
  'mst-desc-o': ['Mumbai Standard Time \u00b7 restored, own layout, now scrollable', 'O \u00b7 Weight', 'Words thicken as they are read, on Inter\u2019s wght axis. NOTE: weight changes glyph widths, so this one reflows \u2014 it cannot keep the live line breaks.'],
  'mst-desc-p': ['Mumbai Standard Time \u00b7 restored, own layout, now scrollable', 'P \u00b7 Trace', 'A hairline draws itself between standfirst and paragraph and the prose comes up behind it. The closest of the six to the live setting.'],
  'mst-desc-q': ['Mumbai Standard Time \u00b7 restored, own layout, now scrollable', 'Q \u00b7 Drift', 'W\u2019s ancestor: every word arrives from its own hashed direction. Same concept as W, on its own single-paragraph layout rather than the live one.'],
  'mst-desc-r': ['Mumbai Standard Time \u00b7 restored, own layout, now scrollable', 'R \u00b7 Aperture', 'The block opens from its centre line outward, the way an iris opens. One clip-path on one element.'],
  'mst-rc-a': ['Mumbai Standard Time \u00b7 recognition & credits', 'A \u00b7 Cascade', 'Every recognition row and credit pair gets its own --v, so both sections arrive in reading order exactly as the description already does.'],
  'mst-rc-b': ['Mumbai Standard Time \u00b7 recognition & credits', 'B \u00b7 Wipe', 'Hard edges rather than fades: the festival name rises out of a mask and each credit pair is uncovered left to right.'],
  'mst-rc-c': ['Mumbai Standard Time \u00b7 recognition & credits', 'C \u00b7 Bloom', 'Nothing moves; only colour. The citation warms from --dim into the accent as its row lands, and each credit value comes up to --bone under a label that holds still.'],
  'mst-rc-d': ['Mumbai Standard Time \u00b7 recognition & credits', 'D \u00b7 Ledger', 'Two stages per row \u2014 the mono key first, the thing it labels a moment later. The lag is the row\u2019s own --v squared, so it needs no second observer.'],
  'mst-full-a': ['Mumbai Standard Time \u00b7 whole page', 'A \u00b7 Wipe, full page', 'B \u00b7 Wipe carried across the entire work page \u2014 recognition, stills, watch, credits and the next-work card, in the live order. The description keeps W \u00b7 Assemble as applied.'],
  'mst-full-b': ['Mumbai Standard Time \u00b7 whole page', 'B \u00b7 Wipe + Stagger', 'The same page, with W3 \u00b7 Stagger on the description instead: every word travels the identical path and only its clock is nudged, so words do not arrive in reading order.'],
  'mst-page-a': ['Mumbai Standard Time \u00b7 whole page, the statement\u2019s language', 'A \u00b7 Kept', 'The description keeps W \u00b7 Assemble exactly as applied; every other part of the page takes the statement\u2019s own two declarations.'],
  'mst-page-b': ['Mumbai Standard Time \u00b7 whole page, the statement\u2019s language', 'B \u00b7 One voice', 'The description drops W\u2019s sideways drift and takes the statement\u2019s rule too, so the page is one declaration repeated from the quote to the last credit.'],
  'mst-page-c': ['Mumbai Standard Time \u00b7 whole page, the statement\u2019s language', 'C \u00b7 Whole phrases', 'The same rule as B applied to whole SECTIONS rather than to the rows, stills and credit pairs inside them. Five arrivals rather than thirty.'],
  'mst-mod-a': ['Mumbai Standard Time \u00b7 whole page, modern', 'A \u00b7 Aperture', 'One device everywhere: a rectangle that grows from an origin and uncovers what is under it. Stills open from the centre like a shutter; rows and credit pairs open from the left, with the reading.'],
  'mst-mod-b': ['Mumbai Standard Time \u00b7 whole page, modern', 'B \u00b7 Parallax', 'Nothing is masked; the parts of a thing arrive at different rates. The still\u2019s window holds still while the picture drifts inside it, and every small mono key leads the thing it names.'],
  'mst-mod-c': ['Mumbai Standard Time \u00b7 whole page, modern', 'C \u00b7 Counter-mask', 'A mask moves one way while the content inside moves the opposite way at the same rate, so the content is uncovered while appearing to hold still. The edge travels, not the object.'],
  'mst-anim-a1': ['Mumbai Standard Time \u00b7 description, as two blocks', 'A1 \u00b7 Lead and lag', 'The standfirst rides the page\u2019s clock and the paragraph lags on its square \u2014 the recognition rule, at the scale of two blocks of text.'],
  'mst-anim-a2': ['Mumbai Standard Time \u00b7 description, as two blocks', 'A2 \u00b7 Own clocks', 'Each block carries its own progress and both use the statement\u2019s plain rule, so the sequence comes from where they sit rather than from a formula. The simplest of the six.'],
  'mst-anim-a3': ['Mumbai Standard Time \u00b7 description, as two blocks', 'A3 \u00b7 Slot', 'Each block rises out of its own mask. A hard edge rather than a fade, so the type is never drawn at half weight.'],
  'mst-anim-b1': ['Mumbai Standard Time \u00b7 description, word by word', 'B1 \u00b7 Plain', 'The statement\u2019s rule word for word with no stagger at all \u2014 the description said in exactly the same voice as the quote above it. Measured: the same 0.56 opacity at half travel.'],
  'mst-anim-b2': ['Mumbai Standard Time \u00b7 description, word by word', 'B2 \u00b7 Lead and lag, per word', 'Per-word motion, but the standfirst\u2019s words ride the clock and the paragraph\u2019s lag on its square. A1\u2019s relationship at the grain of a word.'],
  'mst-anim-b3': ['Mumbai Standard Time \u00b7 description, word by word', 'B3 \u00b7 Sweep', 'Per-word, delayed by position rather than by a hash, so the paragraph lights strictly left to right. The opposite answer to the applied W3, which scatters on purpose.'],
  'mst-cw-a': ['Mumbai Standard Time \u00b7 credits & watch', 'A \u00b7 Ledger', 'The key leads and the thing it names follows \u2014 the page\u2019s square lag, at the grain of a credit pair. The watch arrow lags too, and arrives along the diagonal it already points down.'],
  'mst-cw-b': ['Mumbai Standard Time \u00b7 credits & watch', 'B \u00b7 Draw', 'Lines drawn from an edge: a rule crosses above the credits and each pair wipes in behind it, and the watch label draws the underline it already has on hover, from the page\u2019s right edge.'],
  'mst-cw-c': ['Mumbai Standard Time \u00b7 credits & watch', 'C \u00b7 Reverse', 'The mark arrives first and the words follow it. The arrow lands and \u201cWatch on YouTube\u201d unrolls toward it; each credit value rises out of a mask under its own label.'],
  'mst-asm-a': ['Mumbai Standard Time \u00b7 credits & watch, assembled', 'A \u00b7 Converge', 'W \u00b7 Assemble\u2019s own device moved onto the credits and the link: every word arrives from its own side, slightly behind, and settles. The scatter is centred on zero, so words converge rather than slide in.'],
  'mst-asm-b': ['Mumbai Standard Time \u00b7 credits & watch, assembled', 'B \u00b7 Typeset', 'The same idea run in order. The link is set letter by letter and each credit value word by word, strictly left to right \u2014 composition rather than motion.'],
  'mst-asm-c': ['Mumbai Standard Time \u00b7 credits & watch, assembled', 'C \u00b7 Join', 'Assembly as two halves meeting: the label enters from the left and its value from the right, and the link\u2019s label and arrow close on the gap between them.'],
};

const pretty = (s: string) =>
  s.replace(/-/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase());

const groups = new Map<string, { slug: string; title: string; note: string }[]>();
for (const slug of pages) {
  const [group, title, note] = NOTES[slug] ?? ['Unfiled', pretty(slug), ''];
  if (!groups.has(group)) groups.set(group, []);
  groups.get(group)!.push({ slug, title, note });
}
---

<Base title="Previews — Ugam Khetani">
  <main class="pv">
    <header class="pv__hd">
      <p class="mono pv__eyebrow">Previews</p>
      <h1 class="pv__t">Drafts</h1>
      <p class="pv__lede">
        Design options built as real pages, to be judged in the browser rather
        than described. Nothing here is on the live site unless it says so.
      </p>
      <p class="mono pv__count">{pages.length} {pages.length === 1 ? 'draft' : 'drafts'}</p>
    </header>

    {[...groups].map(([group, items]) => (
      <section class="pv__grp" aria-label={group}>
        <p class="mono pv__grpname">{group}</p>
        <ul class="pv__list">
          {items.map((it) => (
            <li class="pv__row">
              <a class="pv__a" href={`/preview/${it.slug}`}>
                <span class="pv__name">{it.title}</span>
                <span class="mono pv__slug">{it.slug}</span>
                {it.note && <span class="pv__note">{it.note}</span>}
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}

    <p class="mono pv__back"><a href="/">&larr; Back to the site</a></p>
  </main>
</Base>

<style>
  .pv {
    max-width: min(860px, 100%);
    margin-inline: auto;
    padding: clamp(96px, 15vh, 190px) var(--margin) clamp(80px, 14vh, 180px);
  }
  .pv__eyebrow {
    margin: 0 0 clamp(18px, 3vh, 30px);
    font-size: var(--t-micro); letter-spacing: 0.16em;
    text-transform: uppercase; color: var(--dim);
  }
  .pv__t {
    margin: 0 0 clamp(18px, 3vh, 28px);
    font-family: var(--display); font-weight: 500;
    font-size: clamp(2.4rem, 7vw, 4.2rem); line-height: 1; letter-spacing: -0.03em;
  }
  .pv__lede { margin: 0 0 14px; max-width: 52ch; font-size: var(--t-md); color: var(--bone-dim); }
  .pv__count { margin: 0 0 clamp(56px, 9vh, 110px); font-size: var(--t-micro); color: var(--dim); }

  .pv__grp { margin-bottom: clamp(52px, 8vh, 96px); }
  .pv__grpname {
    margin: 0 0 clamp(14px, 2vh, 20px); padding-bottom: 12px;
    border-bottom: 1px solid var(--rule);
    font-size: var(--t-micro); letter-spacing: 0.16em;
    text-transform: uppercase; color: var(--bone-dim);
  }
  .pv__list { list-style: none; margin: 0; padding: 0; }
  .pv__row { border-bottom: 1px solid var(--rule); }
  .pv__a {
    display: grid; grid-template-columns: minmax(0, 1fr) auto;
    gap: 4px clamp(16px, 3vw, 40px); align-items: baseline;
    padding-block: clamp(16px, 2.4vh, 24px);
    text-decoration: none; color: var(--bone);
  }
  .pv__name { font-size: var(--t-md); }
  .pv__slug { font-size: var(--t-micro); color: var(--dim); text-align: right; }
  .pv__note {
    grid-column: 1 / -1; max-width: 60ch;
    font-size: var(--t-sm); color: var(--bone-dim); line-height: 1.5;
  }
  .pv__a:hover .pv__name { text-decoration: underline; text-underline-offset: 4px; }
  .pv__a:hover .pv__slug { color: var(--bone-dim); }

  .pv__back { margin: 0; font-size: var(--t-micro); }
  .pv__back a { color: var(--dim); text-decoration: none; }
  .pv__back a:hover { color: var(--bone); }
</style>
