---
/**
 * THE PREVIEW INDEX — one page that lists every draft.
 *
 * The library used to be 71 pages with no way in except a URL you had to
 * remember, and it was deleted partly for that. This is the way back in: any
 * .astro file dropped in this folder appears here on the next build, with no
 * list to keep in step.
 *
 * DISCOVERY IS A GLOB, NOT A TABLE. `import.meta.glob` is evaluated at build
 * time and is eager: false, so nothing here loads a draft's module — only its
 * path is read. A draft that is deleted stops being listed because the file is
 * gone, which is the only kind of index that cannot go stale.
 *
 * The glob is case-sensitive, as it is in src/lib/frames.ts (HANDOFF §6), but
 * every page in this folder is lowercase .astro so one pattern is enough.
 *
 * NOTES ARE OPTIONAL. A slug with no entry in NOTES still lists, under a title
 * derived from its filename — so adding a draft never means editing this file,
 * and writing a note is a courtesy rather than a requirement.
 */
import Base from '../../layouts/Base.astro';

const pages = Object.keys(import.meta.glob('./*.astro', { eager: false }))
  .map((p) => p.replace('./', '').replace('.astro', ''))
  .filter((s) => s !== 'index')
  .sort();

/** slug → [group, title, note]. Anything missing falls back to its filename. */
const NOTES: Record<string, [string, string, string]> = {
  'ab-fit5': ['About · Fit, editorial headings — second set', 'Fit 5 · Crossing', 'The title is dropped onto the box: the lower third of its letters crosses the panel’s top edge, so the name is half on the catalogue and half on the ground and the edge cuts through it. The overlap is proportional to each title’s own size, not a fixed distance — and the panel’s padding rises by exactly the same amount, so the first line of reading clears the letters by 43px in all four movements.'],
  'ab-fit6': ['About · Fit, editorial headings — second set', 'Fit 6 · Spine', 'The name runs down the side, rotated a quarter turn, fitted to 62vh of screen rather than to the width of the column — measured 496px on all four. It buys the top of the page: a movement opens directly on its statement, and the name stays present the whole way down. Refined: a quarter turn makes the same pan vertical, so the name drifts down the margin as you read.'],
  'ab-fit7': ['About · Fit, editorial headings — second set', 'Fit 7 · Duet', 'The site has a device for a sentence that answers itself — the grotesk states, the serif italic replies — and it has never been used on a title. Each name splits at its last word: “What I work” in the grotesk, “across” in Fraunces italic, set and fitted as one line. One text, two spans, one textLength: fitting the halves separately would set two measures and the join would show.'],
  'ab-fit8': ['About · Fit, editorial headings — second set', 'Fit 8 · Weight', 'The title gets heavier as you read it — wght 300 on arrival, 700 at the middle, 300 on leaving — and does not move while it does. The line is still fitted, so the extra weight has nowhere to go but into the spacing: measured, Fraunces at 700 is 11% wider than at 300, and here that 11% is absorbed, holding the block at 840 units while the letters thicken.'],
  'ab-fit1': ['About · Fit, editorial headings', 'Fit 1 · Rule', 'The oldest chapter opening in print: a hairline above the title and another below, each exactly as wide as the name between them — measured, 946px of rule against 946px of title — with the movement number let into a gap in the upper rule rather than floating over it. Refined: the rules draw outward from the centre as the movement arrives, on the timeline the title pans on.'],
  'ab-fit2': ['About · Fit, editorial headings', 'Fit 2 · Cut', 'The names go into the serif, upright, at the display end of its optical-size axis — a different drawing, not the same letters scaled. The site names Fraunces in --serif and only ever pairs it with italic, so its roman has never appeared on the page. The axis is why the face is fetched: the installed copy does not answer to opsz (4.2356 at 9 and at 144, the same number twice); the Google cut does.'],
  'ab-fit3': ['About · Fit, editorial headings', 'Fit 3 · Folio', 'The number becomes the title and the name becomes its caption — the magazine chapter opener, and the one arrangement that solves what Fit could not: fitting four names of different lengths to one width forces four wildly different sizes, but fitting the NUMBERS keeps every movement opening at the same scale (measured, a 3.2% spread). Refined: the numeral and the name pan against each other, so the pair shears rather than slides.'],
  'ab-fit4': ['About · Fit, editorial headings', 'Fit 4 · Stack', 'Each name broken in two and both lines fitted to the same width, so a title stops being a line and becomes a rectangle — “What I” over “work across”, equal widths at sizes with nothing in common (321 against 169). The split is a line break, not an edit. Refined: the second line travels six tenths as far as the first, so the block shears as it moves and is only square at the middle of its range.'],
  'ab-blend1a': ['About · Blend 1 · Pin, titles re-approached', 'Blend 1a · Measure', 'Every title set to overflow by exactly the same amount — 128vw wide, 14vw past each edge, measured — so a name’s size now states how long it is: “What I work across” is less than half the size of “Who I am” because it is more than twice as long, and the two crop identically. The three questions become an interlude: the page’s own serif italic, a size up, fenced by two hairlines.'],
  'ab-blend1b': ['About · Blend 1 · Pin, titles re-approached', 'Blend 1b · Fit', 'Nothing crops, and every name is the same width — four lines of identical measure at four sizes. The fit is done by SVG textLength, not by the font-size, so it survives a fallback face; the ink spans exactly 840 of the viewBox’s 1000 units on all four. The measure is chosen from the motion: clear of both edges even at the far end of the pan. The questions break the measure — 56 characters inside a 42-character column.'],
  'ab-blend1c': ['About · Blend 1 · Pin, titles re-approached', 'Blend 1c · Ledger', 'The opposite decision: one size for all four, nothing adjusted, so they render 102, 203, 120 and 148 per cent of the viewport — “Who I am” barely reaching the edges while “What I work across” loses a third off both sides. The page stops flattering the names and starts reporting them. Each question takes a 7px accent disc: the port’s own circle, at the size of the spindle hole it cuts.'],
  'ab-blend1d': ['About · Blend 1 · Pin, titles re-approached', 'Blend 1d · Diminuendo', 'The titles get quieter as the section goes on — rendered widths descending in equal steps, 140, 124, 108, 92 per cent of the viewport — so About opens at the top of its voice and the closing serif statement arrives under the smallest title on the page. The questions drop the other way, to a caption: the site’s mono, uppercased, tracked, in the accent, smaller than the prose.'],
  'ab-fb1': ['About · Live frame, headings enlarged', 'FB1 · Deck', 'The live title is one line at 64px with a line-height of 0.96 it never gets to use. Broken over two lines at 88px and closed to 0.84, the descenders of the first run past the ascenders of the second and the pair reads as one object — a two-line deck occupies barely more height than a one-line title plus the air it needs. The break is chosen where the sense turns, not where the measure runs out.'],
  'ab-fb2': ['About · Live frame, headings enlarged', 'FB2 · Bleed', 'The name leaves the frame: large enough to run past both edges, with the corner labels left holding a page whose heading is too big for it. One size, chosen from the measured face so the SHORTEST name exactly fills the screen — every longer one then overflows by its own length (113, 149, 187 and 262 per cent of the viewport). Flex-centred, so the crop is even on both sides.'],
  'ab-fb3': ['About · Live frame, headings enlarged', 'FB3 · Fold', 'Sized from the screen’s HEIGHT, not its width — 15vh, so the name always owns the same share of the fold and what changes it is how tall your window is, not how wide. A heading’s job is to own the top of the screen, and the screen’s top is a height; almost nothing on the web is sized this way. Serif at the display end of the optical size axis, with a width guard for narrow windows.'],
  'ab-fb4': ['About · Live frame, headings enlarged', 'FB4 · Justified', 'Every name exactly the same width, fitted by the WORD spaces rather than by stretching the tracking: text-align-last: justify, one declaration, letters left as the face drew them. Stretched tracking reads as a typeface being adjusted; stretched word spaces read as a line being justified, and the shorter the name the more dramatic the gaps. The words arrive left to right, so the justification opens in sequence.'],
  'ab-bd1': ['About · Body text re-set', 'BD1 · Standfirst', 'The five paragraphs of Who I am are not five equal things, and they have been set as though they were. Here the first is a standfirst — display at 300, a third larger, in full bone — under a hairline that draws from its own centre rather than from the left; the middle three are running text opening on a raised Fraunces italic versal; and the last is a coda in the statement’s own face after a gap you look up at. How I work takes the step numbers already sitting unused in the data, draws its rules instead of printing them, and closes on the pull quote no page has ever rendered.'],
  'ab-bd2': ['About · Body text re-set', 'BD2 · Taper', 'Nothing is added. No rule, no number, no second face — the only thing that changes down the column is how wide it is. Who I am narrows 58 → 51 → 45 → 39 characters with the type coming down beside it, so the measured width falls 606px → 366px at 1280 and the argument arrives at “Those details aren’t decoration. They’re the work.” with nowhere left to go. The reveal accelerates with the measure, 63ms between paragraphs down to 35, then a 56ms beat before the conclusion. How I work runs it backwards: the questions are the narrowest thing on the page and everything after opens away from them.'],
  'ab-bd3': ['About · Body text re-set', 'BD3 · Passage', 'Who I am set as one justified passage in a real roman serif, paragraph breaks marked by an accent middot inside the text rather than by space between blocks — and the serif had to be fetched, because the site loads only Fraunces’ italic and its roman has never appeared on any page. The full cut brings a live optical size axis with it: the reading text at opsz 14, the versal at 144, from one file. How I work takes run-in heads — number, title and prose on the same line, the way a reference book sets a short entry. The runs ink in rather than rise, because a rise moves a phrase off the baseline its own line is sitting on.'],
  'ab-bd4': ['About · Body text re-set', 'BD4 · Spread', 'The one that breaks the axis. Who I am becomes a spread: running text left at 42 characters, the identification lifted out to the top of the narrow column as a byline under a hairline, the conclusion set right at the foot of it — and the empty quarter between them is the most expensive thing in the layout. How I work becomes a ledger: numbers and titles small and uppercase in a right-set rail, the prose in the wide column at a LARGER size than the headings that name it, because the sentences are the work. The hairline between them fills with the accent on the section’s own view() timeline — the page’s only continuous motion since the ports came out.'],
  'ab-ed1': ['About · Body text, with an initial', 'ED1 · Drop', 'A true three-line drop cap, which needed two things the page had never had: a column that sets LEFT (a float has to have a block to wrap against, and .mvt centres everything) and a Fraunces that has a ROMAN. Three lines does not mean three line-heights — it means the cap runs from line one’s cap-top to line THREE’s baseline, two line-heights plus the body’s own cap-height, and every number is measured off the canvas rather than guessed. It has the lead-in everyone drops, and the column is set as a book sets one: no air between paragraphs, indented turns, because the opening sentence is only two lines and the third line beside the cap belongs to the next paragraph.'],
  'ab-ed2': ['About · Body text, with an initial', 'ED2 · Margin', 'The manuscript initial rather than the magazine one: the letter sits BESIDE the column in a margin of its own and the text block stays an unbroken rectangle. A drop cap costs you the shape of the first three lines; a margin initial costs nothing — and because it is outside the measure it can be far larger, here exactly six lines, set light so it stays drawn rather than stamped. Then the system: How I work’s step numbers hang in the SAME margin at the same right edge, so both sections share one axis down the panel. Everything in that margin wipes downward after the column it marks has arrived — the scribe first, the rubricator after.'],
  'ab-ed3': ['About · Body text, with an initial', 'ED3 · Aperture', 'The initial is cut out of his own work: a three-line drop cap filled not with ink but with a frame from the catalogue, which PANS vertically inside the letterform as the section crosses the viewport. The page already sits on a bed of his frames; an initial cut from the same material says the thesis in one letter. The contrast is measured the way the countdown filter measures its own — as little lift as the worst pixel needs, 4.55:1 at 0.50 — and it is said plainly that on an I this reads as a slot, not a window. How I work becomes a triptych: three columns, one step each, the whole method in a glance.'],
  'ab-ed4': ['About · Body text, with an initial', 'ED4 · Columns', 'The device is already on the live site — .s__body sets the About prose in two columns with a floated ::first-letter — and this draft’s own base threw both away when it centred everything. So this one does not invent a magazine opening, it retrieves the page’s, then does the four things the original never got to: a cap that is a real element and can be revealed, a roman that actually exists, three lines that are measured, and a FOOT — the conclusion out of the columns and across the full measure. The hairline in the gutter fills as you read, on the section’s own view() timeline. How I work is set as a programme note.'],
  'ab-in1': ['About · Body text, initials again', 'IN1 · Ghost', 'The initial is behind the text, not in it: an I of 300px cropped on three sides by the column it stands behind, and drifting against it on the section’s own view() timeline so the ground moves under the writing. A drop cap costs the first three lines their shape and caps out at about three lines tall; a ghost costs nothing and has no ceiling — this one measures 8.9 lines and does not interrupt a single word. Its contrast is set deliberately below legibility and measured there: 1.52:1 against the panel, plainly a shape and nowhere near readable. How I work gets the same ground — a ghost numeral behind each step, no rules anywhere, the numerals dividing the section by weight instead of by a line.'],
  'ab-in2': ['About · Body text, initials again', 'IN2 · Block', 'The oldest initial there is: a block of the page’s accent, three lines square, with the letter cut out of it in the ground colour — a cast capital, ink first, the letter being whatever the block leaves behind. --accent appears on this page as a 12px numeral and a full stop, never as an area; here it becomes 79 square pixels of solid and that is the whole of this draft’s boldness, with everything near it taken down rather than up. Measured: 78.87px square, exactly three line-heights, ground on accent at 5.72:1. On reveal the ink RISES — the block fills from the foot and the letter arrives as the fill passes through it, one gesture rather than two. The three step numbers are the same block at chip size.'],
  'ab-in3': ['About · Body text, initials again', 'IN3 · Crop', 'The initial straddles the box: 59% of it stands outside the panel, on the catalogue, and the rest is inside on the panel’s own ground. The page is built in two planes and until now every element belonged entirely to one of them — this letter belongs to both, and it is the only thing on the page that does. It also drifts horizontally on the section’s own view() timeline, so how much of it is outside changes while you read. The box had to come in to the column’s width first: measured, a negative margin against a centred column put the letter 151px INSIDE the panel, which is the exact opposite of the idea. How I work keeps the boundary — the step numbers hang 12px outside the box on the same axis.'],
  'ab-in4': ['About · Body text, initials again', 'IN4 · Cascade', 'Every paragraph gets an initial and each is smaller than the last: three lines, two lines, then two raised versals. The column is illuminated the way a manuscript is — not once at the top but at every opening — and the diminishing is what stops it being a novelty, because a scale reads as structure rather than as four decorations in a row. The conclusion has none at all, which is the point at which it stops being prose. The first two are real drop caps on measured arithmetic; the last two are RAISED rather than dropped, because a one-line drop cap is a large letter pretending. The cascade is also the timing: largest first, each a beat behind, each striking downward. How I work runs the same scale on its three numbers.'],
  'ab-fi1': ['About · Body text, initials III', 'FI1 · Grotesk', 'Eleven drafts, eleven Fraunces capitals — because a drop cap is a book device and a book is set in a serif. This one is not: the initial is Neue Haas Grotesk at 500, the page’s own display face, the same weight and tracking as WHO I AM in the frame above it. Which makes it part of the TITLE system rather than a borrowed tradition. It also needs different arithmetic — a grotesk cap is shorter for its em, cap ratio 0.6616 against Fraunces’ 0.7000, so the same three lines take 97.4px instead of 92.1. Carry the old number over and the letter lands five pixels short of the third baseline with nobody able to say why. How I work becomes a flat ruled grid: three rows, three columns, hairlines full width, nothing vertical.'],
  'ab-fi2': ['About · Body text, initials III', 'FI2 · Register', 'The initial is printed twice and slightly out of register — one impression in bone, one in the accent, two pixels apart — and it COMES INTO REGISTER as you scroll, the two plates converging on the section’s own view() timeline until the accent disappears behind the bone. Misregistration is not a style, it is the one fault every printed thing has had and the one the person who made it was trying to eliminate; a page about a man who says the details are the work can afford one image of a detail being got right. It is the only motion in any of these sixteen drafts that RESOLVES rather than merely moves. The three step numbers converge with it, so the section registers as you read down it.'],
  'ab-fi3': ['About · Body text, initials III', 'FI3 · Well', 'Five lines deep, which is deeper than a drop cap is usually allowed to go — the letter drops through the first paragraph and into the second, and it only works because the column is set as a book sets one. With air between the paragraphs a cap that outlasts its own paragraph looks like a mistake; close the gaps, indent every turned paragraph, and the wrap becomes continuous. The device and the setting are one decision. The letter takes about a third of the column’s height, so the paragraph has a shape before it has a word. How I work takes side-heads — titles out of the text and into the margin, outdented and tracked — the tightest and quietest How I work in the set, and those are the same property.'],
  'ab-fi4': ['About · Body text, initials III', 'FI4 · Stencil', 'The initial is an outline that inks in as you read: a three-line capital in a one-pixel bone stroke with no fill, the panel showing straight through it, and then a solid impression fading up inside the outline on the section’s own view() timeline. Empty when it arrives, full by the time you have read the paragraph it opens. It is the inverse of the two other solids here — IN2 cut the letter out of ink, IN1 laid a wash behind the text — and the only one of the three that CHANGES. The fill is a pseudo-element carrying the character through attr(), so it is not selectable, not copied and not in the accessibility tree. How I work keeps the stencil on its titles and runs at 34 characters, the tightest measure in the set.'],
  'ab-wa1': ['About · Body text, initials IV', 'WA1 · Gauge', 'The initial arrives as an outline of itself and the ink RISES THROUGH IT — a hard waterline climbing the letterform on the section’s own view() timeline, so how full the capital is tells you how far into the section you are. A progress bar is interface bolted onto a page; this is the page’s own first letter doing the same job with none of the furniture, in the one place the reader is already looking. The line is clip-path on a solid impression, not a fade: a fade reads as something appearing, an edge reads as a quantity. Every step number is the same gauge at label size, so How I work is three levels filling in turn.'],
  'ab-wa2': ['About · Body text, initials IV', 'WA2 · Axis', 'The letterform itself changes as you scroll — not its size or its colour, its DESIGN. Fraunces has four axes and this is the first thing on the site with access to all of them: opsz 9→144, SOFT 100→0, WONK 1→0, swept across the crossing. An optical size axis exists because a letter drawn for 9pt is the wrong drawing at 144pt; that is the whole argument for variable type and it is normally invisible because a page picks one point and stays there. Showing the axis move is showing the argument. Measured mid-range: opsz 76.5, SOFT 50, WONK 0.5. How I work samples the same axis in three steps instead of sweeping it.'],
  'ab-wa3': ['About · Body text, initials IV', 'WA3 · Cartouche', 'A hairline box round the capital — the oldest way of setting a decorated initial short of cutting a woodblock, and the quietest. A solid block says the letter is an object; a ruled box says it has a PLACE, which on a page whose whole apparatus is a corner-labelled frame is the claim that agrees with the rest of the document. The box is square to the TEXT, three line-heights exactly including its own rule and padding — measured, content-box had it at 3.253 and the wrap ran to four lines. It draws itself: the vertical hairline first, the horizontal a beat behind, the letter after both. Every step number gets a small one.'],
  'ab-wa4': ['About · Body text, initials IV', 'WA4 · Mono', 'The site has three faces and one of them has never been set above twelve pixels. JetBrains Mono does every corner label, folio and step number on this page and has never once been asked to be a piece of type; here it is the initial. The serif is the page’s answering half and the grotesk is its name — the mono is its CATALOGUE, and a section that opens with a monospaced capital reads as an entry in a run of six numbered movements rather than as an essay. Its cap-height is 0.730 against Fraunces’ 0.700, so the same three lines take 5.307em rather than 5.534: the rule is a ratio, never a number.'],
  'ab-wa5': ['About · Body text, initials IV', 'WA5 · Optical', 'This one has no idea you can see. A plain three-line drop cap, and all of the effort spent on the thing nobody is supposed to notice: making the left edge of the column actually straight. A letter’s box is wider than its ink, and a capital I in a serif has a large side bearing — measured at 3.45px here — so a cap aligned by its BOX sits visibly indented from the lines below it. Hung back out, the letter’s ink and the first word of line four start at the same x: 436.47 against 436.46. Plus hanging-punctuation, real CSS that almost nothing uses. If any draft in this library earns the word premium it is this one, by being invisible.'],
  'ab-wa6': ['About · Body text, initials IV', 'WA6 · Incipit', 'The opening LINE is set larger than the ones under it — not the opening paragraph. ::first-line is a pseudo-element almost nobody uses because it re-flows every time the column changes width, which is exactly why it is interesting: the size step follows the line BREAK rather than the markup, so it is right at every viewport without a breakpoint. Wrapping the first few words in a span puts the emphasis on a fixed number of words, and at 375px that span is two lines and the effect falls apart. The leading had to go absolute to survive it — measured, unitless leading put the float at 3.16 lines and the cap stopped landing on anything.'],
  'ab-wa7': ['About · Body text, initials IV', 'WA7 · Hinge', 'The statement and the body sit on ONE BASELINE GRID whose origin is the statement’s last baseline — the exact line “not something added to it.” sits on. The body’s first baseline is two of its own lines below it, measured at 52.58px against a 52.58px unit, and every space beneath is a whole number of the same. Everything in this movement is centred on a vertical axis and nothing at all was aligned horizontally; this gives the gap between the two blocks a reason, and the reason is visible even though the line is not. The literal lock was tried first and measured out — it would have put the body ten pixels into the statement’s descenders.'],
  'ab-wa8': ['About · Body text, initials IV', 'WA8 · Slab', 'The widest weight span the page can make, with the initial at the top of it: the capital at 900 — the black end of Fraunces’ axis, SOFT 0 and WONK on, the hardest drawing the family has — against a body at 300. Six hundred units between the first letter and the sentence it opens, where this site has never left the 400-to-500 band. And the column gets LIGHTER rather than smaller: the usual way to make an initial look big is to shrink everything round it, but the line here keeps its reading size and gives up weight instead. The only draft in the set with no motion of its own, because a letter this heavy arriving is enough.'],
  'ab-rg1': ['About · FI2 · Register, refined', 'RG1 · First & Last', 'Two corrections to FI2. The offset is on ONE AXIS now: a press does not misregister diagonally — the sheet travels on one axis and the plates part along it, so a real fringe is horizontal and a diagonal one always ends up looking like a drop shadow. And the device happens exactly TWICE on the page rather than four times: the opening capital and the full stop that closes “They’re the work.” — one enormous, one three millimetres wide, converging on the same timeline. A device used twice is a rhyme; used four times it is a pattern, and a pattern is decoration. The column is book-set: no air between paragraphs, indented turns, 42 characters.'],
  'ab-rg2': ['About · FI2 · Register, refined', 'RG2 · Trap', 'The second plate stops being a ghost and becomes a TRAP — the deliberate overlap given to two inks so a small misregistration does not open a white line between them. The accent sits as a hairline halo all the way round the capital and closes to nothing as the section crosses. An offset plate says two things were printed in the wrong place; a trap says two things were printed to FIT each other and the fit is being made, which on a page arguing that sound is part of the world rather than added to it is doing more work. The column is set flush and hang — first lines outdented, no gaps — and How I work takes run-in heads at 38 characters.'],
  'ab-rg3': ['About · FI2 · Register, refined', 'RG3 · Fringe', 'Three plates, not two: the accent spread one way, a dim bone the other, the true bone between them, all converging. Two impressions look like a mistake or a shadow; three, spread in opposite directions from a centre, read as SEPARATION — the eye knows it instantly from badly registered newsprint, and knowing it is the point. The spread is asymmetric on purpose, 2.4px against 1.5px, because a real fringe never is. The column is two-tier — a lede at 1.3em, which is also what makes the drop cap possible, then everything after at 0.97em and 1.5 leading — and How I work hangs its numbers out of the column entirely.'],
  'ab-rg4': ['About · FI2 · Register, refined', 'RG4 · Slur', 'Not a second plate — a SLUR. When a sheet moves under the impression the ink smears along the direction of travel; that is a different fault from misregistration and it needs no second impression at all. One letter, a text-shadow whose offset and blur close together so the smear shortens and sharpens at once — either alone reads as a glow, both together read as ink settling. Wet at the top of the crossing, dry by the bottom. The column is the densest in the library: 38 characters, leading 1.46, and no space between paragraphs at all — each opens with the page’s own accent middot instead. How I work runs at 34 characters, the tightest here.'],
  'ab-sc1': ['About · RG3 · Fringe, process rethought', 'SC1 · Score', 'How I work as a SCORE: three systems, each a hairline stave running the measure with the step’s title sitting ON the line, the way a tempo mark sits on a stave, and its sentences beneath. Twenty-eight versions of this section exist here and every one borrows its shape from print — a ledger, a programme, a triptych, an index. He is a composer; a score is the document his process actually produces, and it is the only arrangement in the library that is not a loan from another trade. The stave is a flex row of rule — title — rule, so the gap is the heading’s own width at any measure. The questions become a bracketed performance direction.'],
  'ab-sc2': ['About · RG3 · Fringe, process rethought', 'SC2 · Running order', 'The titles leave the text and become a running order at the head of the section; the bodies follow keyed by number alone, with nothing above each but a figure in the rail. The claim that this is tighter was written first and the measurement refused it — 631px of step blocks against RG3’s 606, plus about 190px of list, so it is the TALLEST of the eight. Kept anyway, because what it buys is not height: three lines at the top say there are three stages and what they are called, so the prose never has to announce itself again. The three h3s live in the list and each body points back at its own with aria-labelledby, so the words appear exactly once.'],
  'ab-sc3': ['About · RG3 · Fringe, process rethought', 'SC3 · Staircase', 'Each step begins further in than the last, so the section descends to the right and the shape of the block says what the words say. It is the only layout here that carries the argument rather than the content — every other version marks the three as equal and numbers them to say which comes first; a staircase does not need the numbers to say it. The tread is one measure unit, three characters of the step’s own column, so it stays a staircase at every viewport instead of becoming a cliff on a phone. The questions are the deepest thing in the section, which puts the only moment of doubt at the bottom of the descent. Flattens below 820.'],
  'ab-sc4': ['About · RG3 · Fringe, process rethought', 'SC4 · Scholia', 'The three questions go into the MARGIN as a marginal note beside the step they belong to — scholia, the oldest apparatus in bookmaking. And it is what the content has been asking for: step one is a continuous statement with an aside inside it, and every other version has had to choose between breaking the statement in half or moving the questions somewhere they do not belong. A margin is the third option. Measured, the step blocks come out 516px against RG3’s 606 — fifteen per cent, the largest saving of the eight and the only one made by moving content rather than by closing space. The note aligns to the block it annotates, not to the top.'],
  'ab-sc5': ['About · RG3 · Fringe, process rethought', 'SC5 · Verse', 'The process is already written as verse and nobody has set it that way: three declarative sentences per step, one idea each, of very unequal length. That is a stanza, not a paragraph, and running it together gives it a ragged right edge it never asked for. Here each sentence gets its own line with a HANGING TURN, so the short lines stay short — “They influence each other.” is four words and now occupies four words of the page. In prose a very short sentence between two long ones is a bump; as verse it is a beat, and you can see the process breathing. The lines arrive 80ms apart rather than the page’s 70, because a line of verse is read as a unit.'],
  'ab-sc6': ['About · RG3 · Fringe, process rethought', 'SC6 · Gatefold', 'Three does not divide two, and that is the layout: steps one and two side by side, step three full width beneath. The grid is unequal because the content is — the first two stages are things you DO and the third is a position you hold, not a third instruction. Every other version treats the three as equal, which is honest about the sequence and wrong about the weight. “About a third off” was the first claim about its height; measured, 546px against RG3’s 606 — ten per cent, because the pair is as tall as its longer column and step one carries the questions. Second tightest of the eight.'],
  'ab-sc7': ['About · RG3 · Fringe, process rethought', 'SC7 · Schedule', 'Every SENTENCE gets its own ruled row — not every step. Eleven rows on a regular pitch, the numbers in the left column only where a step begins. The process is eleven short declarative statements; setting them as three paragraphs hides that and setting them as ruled rows admits it, which is what makes the section read as a method rather than a description of one. A call sheet, a cue sheet and a technical rider all look like this and all three are documents he works from. The three asks share ONE band, because they are one moment in the process, not three. The rules draw down the page 60ms apart.'],
  'ab-sc8': ['About · RG3 · Fringe, process rethought', 'SC8 · Epigraph', '“What does it feel like? What is its texture? What does it leave unsaid?” is the best writing on the page and it has been set as body copy twenty-eight times. Here it is an EPIGRAPH: lifted to the head of the step it belongs to, at display scale in the serif, outdented past the column’s left edge, and the only thing in the movement above body size. The order is not changed — the questions are still inside step one and still before “From there, I shape a language that belongs to the work.” They have moved up within their own step, which is where an epigraph goes. Everything else comes down to make room: 36 characters, labels, no rules.'],
  'ab-ep1': ['About · RG3 · Fringe, process as editorial', 'EP1 · Deck', 'A deck is the paragraph a magazine sets between the headline and the body — larger than the text, lighter than the headline, at a wider measure — and the first sentence of every step already is one: a complete statement of its stage, followed by qualification. Every version of this section so far has set the two at the same size. Here the first line goes up and the rest comes down: 1.28em against 0.94, light against regular, bone against bone-dim, and the deck runs two characters wider than the body beneath it — the small widening that makes a deck read as a different register rather than as a big first line. Nothing is drawn.'],
  'ab-ep2': ['About · RG3 · Fringe, process as editorial', 'EP2 · Span', 'The newspaper page: prose flowing continuously in two columns across all three steps, with the titles cutting the full width on column-span: all — the CSS almost nothing uses, because almost nothing on the web sets continuous matter in columns. The three steps are one process, not three panels; three blocks say “here are three things”, one flow with three spanning heads says “here is one thing in three stages”. The measure comes out around 26 characters, which is a newspaper measure and why newspapers can be read at arm’s length. Measured at 435px against RG3’s 606 — 28% shorter, the tightest process block in the library.'],
  'ab-ep3': ['About · RG3 · Fringe, process as editorial', 'EP3 · Shoulder', 'Shoulder heads: the title sits in the margin aligned to the first BASELINE of the text it names — not the top of the block, which is a side head, and not inside the line, which is a run-in. A side head top-aligned floats above its own text, because a capital’s top is higher than a lower-case line’s; baseline-aligned, the head and the first word sit on the same line of the page and the eye reads them as one movement. It is one declaration — align-items: baseline — and grid’s baseline alignment is the only thing that makes it tractable, which is why it is almost unseen on the web. Verified at 11813.48 against 11813.48.'],
  'ab-ep4': ['About · RG3 · Fringe, process as editorial', 'EP4 · Folio', 'Each step set as a page: a running head across the top with a rule under it, the matter beneath, and a DROP FOLIO at the foot — the page number below the text block, centred and small, which is what the foot of almost every book page looks like. It moves the number to where a number belongs. Every other version puts 01, 02, 03 at the start of the step as a label; a folio does not label anything, it tells you where you are once you are already there. Putting them at the foot turns three steps into three pages you have turned rather than three items you are being shown, and it costs nothing but a change of position.'],
  'ab-ep5': ['About · RG3 · Fringe, process as editorial', 'EP5 · Breaker', 'The three questions become a breaker — the block that cuts a feature’s column part way down, full measure, display scale, rules above and below, giving the eye somewhere to land and carrying the line the piece is actually about. And it is put where the DATA puts it: in step one the questions sit between “The sound begins with understanding the world inside the frame.” and “From there, I shape a language that belongs to the work.” — so the breaker cuts step one in half, exactly there. The three asks set as one block at 1.5em, the largest thing in the section and the only thing in it that is not prose.'],
  'ab-ep6': ['About · RG3 · Fringe, process as editorial', 'EP6 · Caption', 'A caption is the most disciplined format in a magazine — small, tight, hung under something larger, ruled off, never allowed to run on — and the only one read by people who have decided not to read the article. So the titles go up to 1.9em, the largest type in the movement, and the matter comes down hard to 0.82em on 1.4 in a 30-character column, each sentence with a hairline over it. The ratio is better than two to one where every other version runs about one to one. A list sets label and content at the same weight; a caption block makes the thing above unmissable and the thing below quiet.'],
  'ab-ep7': ['About · RG3 · Fringe, process as editorial', 'EP7 · Recto Verso', 'The steps alternate sides like facing pages — one left, two right, three left again — with a hairline down the centre of the panel as a gutter. A codex alternates recto and verso and the reader’s eye learns the rhythm without being told; a web page is an infinite recto. Putting the alternation back gives a three-item sequence a physical shape no amount of numbering can, and it lands the third step back on the left, which is where a sequence that has gone somewhere and returned belongs. The verso sets RIGHT-ALIGNED against the gutter — ragged on the right it would only be an indented block. 462px, 24% shorter than RG3.'],
  'ab-ep8': ['About · RG3 · Fringe, process as editorial', 'EP8 · Notes', 'The three questions go to the foot of the movement as a footnote: a dagger after the sentence they belong to, the same dagger under a short rule at the bottom, the asks set there in small type. It is the only device in the library that lets all three steps set IDENTICALLY — every other version has step one running longer because it is the one carrying the questions, and that unevenness has been designed around a dozen different ways. The mark is a dagger rather than a figure, because the steps are already numbered 01, 02, 03 and a superscript 1 beside an 01 is two numbering systems arguing.'],
  'ab-pr1': ['About · RG3 · Fringe, process unnumbered', 'PR1 · Asterism', 'Three asterisks in a triangle — ⁂, one character — centred between blocks of prose: the mark a book uses for a section break when the sections are not chapters and are not to be numbered, which is exactly this case. The titles become run-in caps, so nothing stands above the text at all: three passages with two marks between them, which reads as an essay rather than a list. The asterism takes the accent, and it is now the only accent in the movement — one colour, two instances, in the two places where the reader needs to know something has ended.'],
  'ab-pr2': ['About · RG3 · Fringe, process unnumbered', 'PR2 · Sinkage', 'Sinkage is the depth a chapter opening drops from the top of its page, and in a well-made book it is identical on every chapter so the openings rhyme. Here it is deliberately not: three steps, three sinks, three lines then two then one. Nothing is numbered and nothing is ruled, but the gaps are visibly closing and a reader feels a sequence tightening without being able to say why — the order is in the WHITE. Measured in whole line-heights from a registered length, not in clamps that happen to decrease: 69.84, 46.56, 23.28 against a 23.28px line.'],
  'ab-pr3': ['About · RG3 · Fringe, process unnumbered', 'PR3 · Cut-in', 'A cut-in head is a heading set INTO the text block with the prose wrapping round it — the same idea as a drop cap but the thing cut in is a word. It is in every serious book on typesetting and essentially unseen on the web, because it needs a float and a measured height. Two lines deep exactly, so the third line of prose starts flush and the notch closes: written first as 2 × 1.5em it resolved against the HEAD’s font-size and came out 38.4px against 46.56, and the top margin then pushed the margin box — which is what decides the wrap — to 2.066 lines. Both measured and fixed; 2.000 on both boxes now.'],
  'ab-pr4': ['About · RG3 · Fringe, process unnumbered', 'PR4 · Chapter', 'Each step set as a chapter opening: title centred, a short centred rule beneath it, and the first LINE of prose in capitals — the three-part apparatus a book has used to open a chapter since the sixteenth century, and one that needs no number because the display already says a new thing has begun. The centred head against a ranged-left body is the part that makes it read as a book rather than as a web section, and it is a combination this page has not used once. The caps are on ::first-line, so they follow the line break rather than a fixed count of words.'],
  'ab-pr5': ['About · RG3 · Fringe, process unnumbered', 'PR5 · Ticks', 'One hairline down the left of the whole section with a short tick out of it at each step. The rule is continuous, which says the three are one thing; the ticks say where each begins. A number says “this is the second”; a tick says “this is here” — and for a process where the order is real but the count is not interesting, that is the more honest mark, and the numerals were doing the lesser job at the cost of being the loudest thing in the section. The spine draws down on the section’s own view() timeline.'],
  'ab-pr6': ['About · RG3 · Fringe, process unnumbered', 'PR6 · Hanging', 'The titles are the only thing touching the left margin: each name flush left with the whole of its prose indented under it, so the left edge of the section is three words and nothing else. Read down it and you get the method; read across and you get the detail. It is the cleanest replacement for a numeral because it does the numeral’s job with ink the title was already using — and that word also says what the step IS, which no figure does. The indent is three characters of the prose’s own column, so the hang is proportional to the type at every width.'],
  'ab-pr7': ['About · RG3 · Fringe, process unnumbered', 'PR7 · Kicker', 'Each step’s last sentence leaves the column and stands in a narrow one of its own. Read the three together and you have the argument of the whole section in three lines — and in every other version of this page they have been buried at the foot of a paragraph. Down the right runs a spine of three conclusions; down the left runs the working. No numbers are needed because a working paragraph and the conclusion beside it are visibly a pair, and three pairs read as three stages. 460px against RG3’s 606 — the tightest of these eight.'],
  'ab-pr8': ['About · RG3 · Fringe, process unnumbered', 'PR8 · Bracket', 'A single hairline bracket holds all three steps — a vertical with a short return at the top and another at the foot — and a bracket means one thing in every document that has ever used one: what is inside this belongs together. It is the opposite claim to a numbered list. Numbering says three things are separate and ordered; bracketing says they are one statement in three parts, which is nearer to what the writing does. Built from three borders rather than a glyph, because a brace scaled to 400px is a distortion. It closes as you scroll.'],
  'ab-qu1': ['About · RG3 · Fringe, process as genre', 'QU1 · Dialogue', 'The section set as an interview: each title takes the question position — flush left, in the serif — and its sentences take the answer, indented and in the grotesk a size down. Which is what the content already is: “Find the language” is not a label on a paragraph, it is the thing being asked about, and the three sentences under it are the reply. Every other version sets the title as a heading when it behaves much more like a prompt. The indent IS the speaker change — in a printed interview nothing else marks the turn. The three real questions go in deeper still: an aside inside an answer, the only three-level moment in the section.'],
  'ab-qu2': ['About · RG3 · Fringe, process as genre', 'QU2 · Glossary', 'Three dictionary entries: headword, then the sense running on from it on the SAME line, with only the turns hanging. Not the hanging block — PR6 sets a title flush and indents the whole prose beneath it, which is a heading with an indented body. This is one paragraph, and the difference is a line of white per step and a different claim: a glossary entry does not have a heading, it has a word being defined. 0.92em on 1.42 at 38 characters, no rules, a single line between entries — a dictionary page is the densest thing anyone reads willingly, and the hang is why.'],
  'ab-qu3': ['About · RG3 · Fringe, process as genre', 'QU3 · Sideline', 'Each step gets its own short vertical rule in the margin running the full height of its block — the mark a Bible, a statute or a set of proofs uses to say “this passage, here”. Not a spine, which is continuous and says the run is one thing; not a tick, which is a point and says a thing begins. A sideline has LENGTH, and its length is the passage — which is the one thing a number could never do. You can see at a glance how much of the section each stage takes, and the three rules are visibly unequal because the stages are. Each draws down its own passage on the section’s view() timeline.'],
  'ab-qu4': ['About · RG3 · Fringe, process as genre', 'QU4 · Panel', 'The third step lifted into a ruled box-out. A magazine boxes the matter that is not part of the narrative, and “Hold the intent” is exactly that: the first two stages are what happens, the third is the discipline that keeps them true. A box is a claim about KIND, not about importance — nobody boxes a paragraph to emphasise it, you box it to say it is a different kind of thing from the column beside it. A hairline box with tight padding reads as a UI component; the same box with an em and a half of air inside reads as print, and that is the entire difference.'],
  'ab-qu5': ['About · RG3 · Fringe, process as genre', 'QU5 · Extract', 'The three questions set as a displayed extract — and therefore SMALLER. A book indents a long quotation from both margins at a size down with no quotation marks, because the indent has already done the quoting. Every version of this section so far has made the questions bigger; that is what a pull quote does, and these are not one. A pull quote is matter lifted out and enlarged to sell it; an extract is matter quoted inside and reduced, because it is not the author speaking and the reader should see that before reading a word. One opening mark, hung into the indent.'],
  'ab-qu6': ['About · RG3 · Fringe, process as genre', 'QU6 · Value', 'No headings on their own lines, no rules, no numbers, and no change of size — the only thing that moves down this section is the VALUE of the ink. Each step’s opening statement sets in full bone and everything qualifying it in bone-dim. Typography’s usual way to subordinate is smaller; a page that holds one size and moves the grey does the same job with a variable nobody notices they are reading. Both values are the page’s own — 19.9:1 and 14.0:1 against the panel — so nothing trades legibility for subtlety. The questions take full bone: they are the asking, not qualification.'],
  'ab-qu7': ['About · RG3 · Fringe, process as genre', 'QU7 · Apparatus', 'Text in the centre, titles in the left margin, questions in the right — the annotated edition, and the fullest use the panel’s width has been put to here. SC4 puts the questions in a margin and leaves the titles inline; PR6 does the reverse. Neither can do both, because one margin can only hold one apparatus without the two arguing — and once they are separated it becomes obvious that a finding aid and a commentary were never the same kind of thing. Each margin is baseline-aligned to its own matter. The right folds in at 1100 and the left at 820; the order is a decision.'],
  'ab-qu8': ['About · RG3 · Fringe, process as genre', 'QU8 · Solidus', 'The whole process as one block of text: no headings on their own lines, no paragraphs, no rules, no numbers — three stages running on as a single passage with the titles inline in tracked caps and every sentence separated by a spaced solidus. It is the credits block, the way a masthead, a filmography and a title card all set a list that must not look like one. Eleven statements and three titles in about 44 characters, and because the solidus carries the break none of it costs a line. 389px against RG3’s 606 — 36% shorter, the tightest process block in the library.'],
  'ab-fv1': ['About · RG3 · Fringe, from the page itself', 'FV1 · Corners', 'Borrowed: the frame. Every movement here is announced by four monospaced labels at the corners of a box — the page’s single most recognisable device, and it has never been used below the title. Each step gets the same apparatus at a quarter size: the name top left in .cn’s own values (10px, 0.16em, uppercase, bone-dim) with its sentences in the box it labels. A heading sits above a block and claims it; a corner label sits beside one and identifies it, the way a plate number identifies a plate — and for stages that are named rather than titled that is the truer relationship. Rules top and left only, so the corner is implied.'],
  'ab-fv2': ['About · RG3 · Fringe, from the page itself', 'FV2 · Statement', 'Borrowed: the statement and its lede. Every movement on this page opens with a short declarative set large in the display face and a longer passage under it at reading size, dimmer and wider. WHO I AM does it, WHAT I WORK ACROSS does it, WHAT I’M AFTER does it — HOW I WORK is the only movement that does not. So each step opens as a statement at .s__stmt’s scale brought down a step, with everything after it as the lede at .pv-lede’s 50 characters. The simplest of the eight and probably the strongest argument: the fix was not a new idea but the page’s existing one, used three times.'],
  'ab-fv3': ['About · RG3 · Fringe, from the page itself', 'FV3 · Axis', 'Borrowed: the centred axis, which this whole line of drafts abandoned. ab-fitlive centres everything; RG3 and every draft from it set the process LEFT, because a drop cap needs a block to wrap against — a reason that belongs to Who I am and never applied here. So it goes back on the axis and is made worth it: titles centred in the corner-label setting, prose centred at 38 characters tapering to 32, and the questions breaking the measure OUTWARD to 52 — ab-fitlive’s own device, and the only reason it works is that a centred overhang is symmetrical. A taper on a centred axis is visible on both edges at once.'],
  'ab-fv4': ['About · RG3 · Fringe, from the page itself', 'FV4 · Drawn', 'Borrowed: the rule that draws itself. .draw is in this file already — 1px, transform-origin left, scaling from zero over 1000ms on reveal — and the process section divides its steps with a static border-top, which is the same line doing none of the work. Here every division is drawn, 250ms apart, so the section builds like a page being laid out rather than appearing complete. The titles sit ON the rules with a little of the panel’s ground either side, which is what the frame does at the top of every movement. And the rules alternate origin, because three identical gestures in a row read as a loop.'],
  'ab-fv5': ['About · RG3 · Fringe, from the page itself', 'FV5 · Aperture', 'Borrowed: the two planes. This page is a box on a bed of his own frames, and the catalogue behind it is never seen from inside. Here each step gets its own panel — the page’s ground, hairline, radius and padding — and the gaps between them are transparent, so the work shows through the section that describes how the work is made. The page’s own structure, recursed: a movement is a box on a bed, a step is now a box on a bed, and nothing new is introduced at all. The section’s own panel loses its ground for this movement, because three boxes inside a fourth would be a UI.'],
  'ab-fv6': ['About · RG3 · Fringe, from the page itself', 'FV6 · Two Voices', 'Borrowed: the second voice. The one typographic idea this page is built on is a statement answered by itself in another face — the grotesk, then the serif italic beneath it, dimmer, on its own line. Every step already has that shape: “Music, sound design, voice and mix are not separate boxes.” → “They influence each other.” → “I prefer building them together…” Statement, qualification, answer. The page’s own device fits the content without a word being moved. The questions become the third voice: the same serif at full bone rather than dim, which is the one distinction left once two faces are in use.'],
  'ab-fv7': ['About · RG3 · Fringe, from the page itself', 'FV7 · Listing', 'Borrowed: the listing. WHAT I WORK ACROSS sets three disciplines as three columns, each under a hairline with a label over it — the only multi-column structure on the page, two movements above this one. The process is also a three, so it takes the same rule, the same label setting and the same fold at 820. Measured at 236px against RG3’s 606 — 61% shorter, the tightest process block in the library by a distance, for the same reason the listing is the shortest movement on the page: three columns of three sentences is one band instead of three.'],
  'ab-fv8': ['About · RG3 · Fringe, from the page itself', 'FV8 · Movements', 'Borrowed: the way a movement is named. .fr__t sets each movement in the display face, uppercase, at −0.045em — tight, large, the same five times down the page. It is the page’s masthead voice and it stops at the movement level. Here the three stages are named the same way at a quarter of the size, so the process reads as three movements inside a movement. Tight tracking on uppercase display type is unusual and specific — most pages letterspace their caps OUT and this one closes them — and copying the value rather than the idea is what makes the names read as the same hand.'],
  'ab-ft1': ['About · Live frame, headings re-set', 'FT1 · Lowercase', 'The live title is uppercase and tracked NEGATIVE — capitals pulled together at exactly the size their counters need room. This sets the name the other way: lowercase, in the serif’s roman, large, against corner labels that stay in tracked micro capitals. A lowercase line has ascenders and a silhouette; “WHO I AM” is a rectangle. Refined: it reveals word by word on the page’s own --i, the way the live closing statement does.'],
  'ab-ft2': ['About · Live frame, headings re-set', 'FT2 · Capitals', 'Capitals set as capitals: tracking opened to +0.12em and the size brought down by about half — 33.6px where the live title sets 64. Letterspaced capitals at a modest size read as authority; tightly tracked capitals at a large size read as a logo, and this is a section heading. The trailing letter-space is compensated with a negative right margin, which is the difference between type that is set and type that is styled.'],
  'ab-ft3': ['About · Live frame, headings re-set', 'FT3 · Unison', 'The title and the statement set at exactly the same size, so they stop being a hierarchy and become a sequence — one voice at one volume, separated only by case and colour. Not copied at one width: the title takes the live statement’s own clamp, so they track together everywhere. Measured 44.8/44.8 at 1280 and 24/24 at 375, with identical leading.'],
  'ab-ft4': ['About · Live frame, headings re-set', 'FT4 · Overture', 'The other three bring the title down; this asks how far the page’s type can stretch before it stops being one system. The name at the display end of Fraunces’ optical size axis against corner labels at nine point: measured 92px to 9px, a ratio of 10.2 to 1 where the live page runs 6.4. Everything between them is untouched, which is what makes it read as deliberate rather than loud.'],
  'ab-fl1': ['About · Live frame, headings redesigned', 'FL1 · Plate', 'On the live site the four corner labels are the only evidence a frame exists — you deduce the rest. Here it is ruled: a hairline under the upper pair and another above the lower, so the movement is a plate with its caption set into the margins. Refined: the rules draw outward from the centre, the upper first and the lower a beat behind (cover 0–30% and 10–40%).'],
  'ab-fl2': ['About · Live frame, headings redesigned', 'FL2 · Running head', 'Four labels at four corners is a frame; the same four things as one justified line is a running head — a book’s device, read in one pass instead of four glances, leaving the middle of the screen to the name. Set on a three-column grid, not space-between, so the centre is centred on the page rather than on what is left over: measured 310 / 640 / 970 against a page centre of 640.'],
  'ab-fl3': ['About · Live frame, headings redesigned', 'FL3 · Hanging', 'Everything in this family is centred, which is the safest composition there is. This breaks it in the heading only: the name hangs flush left from a rule across the top, the movement number sits large at its right in the serif, and the remaining labels drop to one line beneath. The page then has exactly one moment of asymmetry, at the top of every movement.'],
  'ab-fl4': ['About · Live frame, headings redesigned', 'FL4 · Whisper', 'Every other system here made the name bigger. This makes it smaller than the statement it introduces — 10px mono, tracked, set exactly like the four labels around it — so the frame becomes five pieces of furniture and the loudest thing on screen is what the movement says. Measured: statement 44.8px against a 10px title, where the live page has that the other way round.'],
  'ab-fitlive': ['About · Blends', 'Fit · with the live frame', 'Blend 1b · Fit with its fitted SVG titles replaced by the live site’s own heading apparatus, lifted whole: the movement number and name at the top left, the place at the top right, the folio and year range at the bottom left, Selected works and the scroll cue at the bottom right, and the name again at size in the middle. Everything below the frame is Fit’s — the live statements and their reveals, the prose at 48 characters, How I work at 42 with its questions breaking to 56. Amended 19 Sep: the spindle ports and the records behind them are gone, the closing statement is set in the opening statement’s face rather than the serif, and Who I am carries 02 in the accent like the three movements below it.'],
  'ab-livebody': ['About · Blends', 'Live · Blend 1b’s bodies', 'The live homepage with only its running text re-set, and its headings kept. Nothing in the markup is touched — the frames, the giant names, the statements, the numbered rows, the step rules and the read-along word spans are index.astro’s own; the whole draft is a stylesheet. Measured against ab-blend1b at 1024: prose 427px, lede 467, step lines 374, questions 498 — identical on both. The live serif prose becomes the grotesk, because that is what Blend 1b’s bodies are.'],
  'ab-blend1': ['About · Blends', 'Blend 1 · Pin, with the live statements', 'P2j · Pin throughout — the cropped panning names, the 26px spindle-hole port onto a 1400px record, the centred prose, What I work across and How I work — with the Who I am and closing statements taken from the live site as its own markup, not a copy of its styling. So they arrive the way they do on the site: each line rising out of an overflow-hidden box, the closing one word at a time, 70ms apart. Two clocks on one page — the site’s reveal, which fires once, and P2j’s scroll-driven turn and pan, which run throughout.'],
  'ab-d13': ['About · D9 · Frame, set editorially', 'D13 · Broadsheet', 'A front page inside D9’s frame: masthead, rule, deck, then the story in three justified and hyphenated columns with a hairline column rule and a raised initial at opsz 144. The deck is the statement, set in the serif at the size that face was drawn to be cut at. Refined: the four corner hairlines now arrive one at a time, clockwise, instead of together.'],
  'ab-d14': ['About · D9 · Frame, set editorially', 'D14 · Marginalia', 'A web page has no margin, so D9 set its labels above the thing they name. This gives it one: every step number and service label hangs in a wide left margin, pulled onto the baseline of the line beside it, with the reading in a single 58-character measure. The margin’s rule draws down on the same timeline as the frame’s corners.'],
  'ab-d15': ['About · D9 · Frame, set editorially', 'D15 · Spread', 'Verso and recto with a gutter between them, and each movement laid out on its own terms: 02 statement left, prose right; 03 statement and lede together, the three service lists down the recto; 04 crossing the fold in two columns, because a process should not be interrupted by one; 05 one line on each page. The pan is unchanged, but now it reads as a word crossing the fold.'],
  'ab-d16': ['About · D9 · Frame, set editorially', 'D16 · Colophon', 'One face, four optical sizes: 144 on the name, 72 on the statement, 24 on the lede, 12 on the prose — not four sizes of one drawing but four drawings. Measured, the axis is live: the same string at 60px sets 102px narrower at opsz 144 than at 9. The one departure from D, which is the only reason the draft exists.'],
  'ab-d9': ['About · D · Poster, on the live mosaic', 'D9 · Frame', 'The page already has a way of holding a photograph and D ignored it: the corner-labelled frame with the middle left alone. The labels come out of D’s top row and go where the site keeps them — the four corners of the movement — and the bed becomes the middle. Four hairlines draw themselves in as you arrive; the reading sits on the live page’s own panel.'],
  'ab-d10': ['About · D · Poster, on the live mosaic', 'D10 · Register', 'D invents a twelve-column grid; the site has been running a six-column one behind it since the first screen. This throws D’s away and sets the poster on the bed’s actual columns — rules drawn on the real boundaries, the name and panel starting on them. Derived in CSS from the bed’s own terms, then checked against the tiles: within 0.1px at 1280, exact at 375 where the bed becomes four columns.'],
  'ab-d11': ['About · D · Poster, on the live mosaic', 'D11 · Veil', 'No edge at all. Every other answer cuts, and a cut is always visible as a line. Here the ground arrives as a gradient — nothing at the top where the name sits on bare mosaic, thickening to 0.97 where the prose is — so the catalogue dissolves rather than stopping. Computed over the bed’s brightest possible pixel: 19.7:1 for the prose, 18.2:1 for the statement, with no panel under either.'],
  'ab-d12': ['About · D · Poster, on the live mosaic', 'D12 · Shutter', 'The live page’s aperture is a rectangle that widens; this is an aperture in the other sense — a six-bladed iris that opens by turning. One polygon with a hole wound the other way (evenodd), twelve points moving together, no mask and no second element. Arriving at a movement stops being a reveal and becomes a mechanism.'],
  'ab-d5': ['About · D · Poster, with the catalogue showing', 'D5 · Knockout', 'D set its giant words white on a black wall. Here the wall is the same ground but the words are cut out of it, and what shows through the letterforms is the catalogue. The pan is unchanged — same range, same timeline — but against a fixed bed it stops being kinetic type and becomes a window travelling across photographs.'],
  'ab-d6': ['About · D · Poster, with the catalogue showing', 'D6 · Aperture', 'The live site’s own device, handed to the poster: a mat of solid ground covering everything but one rectangle, made by a 100vmax box-shadow. Refined — where the live page drives the window from a script-kept coverage number, this drives it from a view() timeline: 92% × 84% of the section across a movement’s middle, closing to 60% × 31% at its joins.'],
  'ab-d7': ['About · D · Poster, with the catalogue showing', 'D7 · Columns', 'The grid stops being invisible: the ground is laid in bands on D’s own twelve columns, two closed and the third open, so a line of type crosses ground, photograph, ground. The gap widens from 8% to 42% of its tile as you read, and each movement is registered a different phase so no two show the same frames.'],
  'ab-d8': ['About · D · Poster, with the catalogue showing', 'D8 · Ground', 'Nothing is opaque except the words. The catalogue is visible edge to edge and the only solid ground is the shape of the text — the prose carrying it line by line via box-decoration-break, measured at 3/4/5/4/3 slabs, so the paragraphs sit on the photographs as a ragged stack. The giant name gets none: white on the bed at 8.4:1.'],
  'ab-p2l1': ['About · P2l · Transit, at the record’s true size', 'P2l1 · Sleeve', 'The one number P2l had wrong: it drew the record at 0.27 of its cover, and a real one is 0.96. At 0.95 it fills the sleeve and the only place it can go is out of the top, which is where a record goes — filed showing 6% of itself, drawn out to 62%. The cut becomes a thumb notch on the open edge, the one hole in this family that exists on the object for a reason.'],
  'ab-p2l2': ['About · P2l · Transit, at the record’s true size', 'P2l2 · Double', 'P2l’s disc went in the top and out the bottom, which is object permanence and not a thing a record does. At true scale there is a better reason for two openings: a double album has one in each half. Two records, two notches, out of opposite ends, counter-turning — the second labelled with the catalogue’s year range.'],
  'ab-p2l3': ['About · P2l · Transit, at the record’s true size', 'P2l3 · Return', 'Every scroll-driven thing on this site travels one way, because the scroll does. This one comes out over the first half of the movement, is fully clear at the exact middle, and is filed again by the end — measured 6 → 36 → 66 → 36 → 6%. The only draft in the set that makes the middle of a section its climax rather than the end.'],
  'ab-p2l4': ['About · P2l · Transit, at the record’s true size', 'P2l4 · Flip', 'Fifty drafts have turned a disc about its spindle; this one turns it about its diameter. It clears the cover and flips — side A away, side B towards you, the label becoming the year range. The spin sits inside the flip, so past 90° the same animation is seen from behind and the record reverses direction by itself, the way a real one does.'],
  'ab-p2j': ['About · P2 · Port, centred text — eight', 'P2j · Pin', 'The smallest port there is: 26 pixels across, onto a record 54 times its width, clipped to the hole so you cannot see how big it is. At that size the arc is nearly straight, so what reads is fine parallel lines travelling. Type: the live page’s own Fraunces italic, kept exactly — the draft the others are measured against.'],
  'ab-p2k': ['About · P2 · Port, centred text — eight', 'P2k · Halo', 'A ring is cut, not a hole — two mask layers composited with add — and what is inside it is left: an island of the page floating in a ring of record, with the movement’s number set on it. Type: Playfair Display italic, a Didone at the same size as the line it answers, so the contrast is all in the drawing of the letters.'],
  'ab-p2l': ['About · P2 · Port, centred text — eight', 'P2l · Transit', 'One record, two holes and a disappearance: it enters at the top edge, crosses behind the page where the box hides it completely, and comes out at the foot. The interest is entirely in the part you cannot see. Type: no serif at all — the site’s mono at 0.42em, uppercased and tracked to 0.22em, stamped rather than written.'],
  'ab-p2m': ['About · P2 · Port, centred text — eight', 'P2m · Run-in', 'The About is one side and you are tracking in: the aperture closes 154 → 123 → 97 → 72 movement by movement and moves inward over the same 1180px record, from the outer grooves at 02 to dead centre at 05. Type: EB Garamond italic at 1.35× — the second voice is the louder of the two.'],
  'ab-p2n': ['About · P2 · Port, centred text — eight', 'P2n · Full Stop', 'The period is the hole. The port is cut exactly where the statement’s full stop belongs and a record turns behind the punctuation — the only port here whose position is not a design decision. Measured and placed by a ResizeObserver, sized at 0.34 of the type it replaces. Type: Instrument Serif, upright, the one unslanted second voice in the set.'],
  'ab-p2o': ['About · P2 · Port, centred text — eight', 'P2o · Corona', 'The record is around the hole, not behind it: the cut shows the bed, clean, and the disc is laid on the page as a ring whose inner edge lands on the cut’s edge — both resolve to the same 140.8px, one edge and not two that nearly agree. Type: Cormorant Garamond italic at 300, 1.5× and open — the lightest face here.'],
  'ab-p2p': ['About · P2 · Port, centred text — eight', 'P2p · Chord', 'Two circles, one hole, and it is not round: the cut is the lens the two have in common, made of nothing but circles. Two records turn against each other and the page is open only where they agree. Type: not another face at all — the same grotesk at 0.62em, uppercased, in the accent. A second register of one voice, which is the argument the drawing makes.'],
  'ab-p2q': ['About · P2 · Port, centred text — eight', 'P2q · Corner', 'The cut takes a corner, and the corner travels: 02 loses its top left, 03 its top right, 04 its bottom right, 05 its bottom left. The box is torn rather than punched, and the column never moves off the axis — the inset is applied to both sides whatever corner is gone. Type: Bodoni Moda italic, and the one accent full stop in the set.'],
  'ab-p2f': ['About · P drafts, centred text — four apiece', 'P2f · Iris', 'The aperture is the animation: the hole opens as the movement arrives, is widest exactly when the movement is centred in the window, and closes as it leaves. The record behind it grows and shrinks with it and turns throughout. Never quite shuts — 30px at the ends.'],
  'ab-p2g': ['About · P drafts, centred text — four apiece', 'P2g · Sprockets', 'One hole is a port; eight are a perforation. Four along the top edge and four along the bottom, small enough that the box reads as a punched strip rather than a page with a hole in it. Eight discs behind them, alternate ones turning against the rest.'],
  'ab-p2h': ['About · P drafts, centred text — four apiece', 'P2h · Eclipse', 'The hole holds still and the record passes behind it. The disc is 1.72 times the aperture and crosses it as the movement is read, so what shows is a crescent of label, then the whole label, then a crescent the other way. Measured: 10.6 → 64.1 → 100 → 64.1 → 10.6%.'],
  'ab-p2i': ['About · P drafts, centred text — four apiece', 'P2i · Passage', 'The port travels. It enters at the left of the box’s top edge and leaves at the right — a window scanning the width of the page, the record riding inside it. The hole and the disc are the same registered number, so they cannot come apart.'],
  'ab-p5f': ['About · P drafts, centred text — four apiece', 'P5f · Tonearm', 'Six drafts have drawn the record and none has drawn the thing that plays it. The arm is laid across the reading rather than behind it, tracking inward as the movement is read: measured, the stylus goes from 175 to 110 units of a 200-unit platter. Two pinned layers, because one cannot be both behind the box and in front of it.'],
  'ab-p5g': ['About · P drafts, centred text — four apiece', 'P5g · Rise', 'Pinned, and still moving. The held record climbs the screen against the scroll — 68vh over a movement, measured — passing behind the box on the way. The page and the record travel in opposite directions at once, which is what makes a pinned object read as a separate thing.'],
  'ab-p5h': ['About · P drafts, centred text — four apiece', 'P5h · Approach', 'The one transform this family had not used. The record starts at the size of a label and grows to wider than the box, so the last of the movement is read through a record. Scale is the only one of the three that changes your relationship to a thing rather than its position.'],
  'ab-p5i': ['About · P drafts, centred text — four apiece', 'P5i · Depth', 'Three records, three speeds, three distances: 330, 272 and 214 degrees; 112, 72 and 32 pixels of travel. There is no perspective here and no shadow — only three things agreeing to move by different amounts, which is the whole of parallax.'],
  'ab-p6f': ['About · P drafts, centred text — four apiece', 'P6f · Tracking', 'A stylus that does not move is a stylus that is not playing — the one thing about P6 that was never quite honest. Here it rides the whole length of the groove as the movement is read. Measured, the stylus centre and the filled edge report the same number at every point.'],
  'ab-p6g': ['About · P drafts, centred text — four apiece', 'P6g · Stereo', 'A groove is not a straight line — it is a wall cut by a signal, and a stereo record carries two of them. So the hairline is modulated and there are two, one down each margin, mirrored, with the reading held between the channels.'],
  'ab-p6h': ['About · P drafts, centred text — four apiece', 'P6h · Bands', 'One continuous groove for the whole About, interrupted the way a record interrupts it: a 26px band gap at each movement, a hairline ruled the full width, the track number in the margin. Not four sections with a rule down the side — one side of a record with four tracks on it.'],
  'ab-p6i': ['About · P drafts, centred text — four apiece', 'P6i · Locked', 'Three movements carry the straight groove. The fourth spirals in through three turns and closes into a circle it cannot leave — a locked groove. It is under 05 on purpose: the only statement here that does not resolve into the next thing.'],
  'ab-p2d': ['About · P drafts, centred text — two apiece', 'P2d · Twin', 'The port cut out of both side edges at once — one mask, two circles, the panel intersected with each. A centred column has two margins rather than one, so it is given a disc in each, counter-turning. What was a composition with a side to it becomes a symmetrical one.'],
  'ab-p2e': ['About · P drafts, centred text — two apiece', 'P2e · Wrap', 'The port moves into the middle of the reading and the prose flows round it: two floats with shape-outside, a circle of nothing inside the text block. The only draft where the record is not beside the words or behind them but among them.'],
  'ab-p5d': ['About · P drafts, centred text — two apiece', 'P5d · Twins', 'Two decks pinned, one at each screen edge, turning against each other while the reading passes up between them. C2 · Deck put two discs beside the box and they travelled with the page; these hold still, tucked 61px behind the box’s edges, and the page moves instead.'],
  'ab-p5e': ['About · P drafts, centred text — two apiece', 'P5e · Platter', 'The deck pinned under the foot of the screen, far wider than the window, so what shows is a shallow rising arc the box appears to rest on. Everything it carries is at the rim — 36 ticks and a ring of type — because on a disc this size the label sits 750px below the fold.'],
  'ab-p6d': ['About · P drafts, centred text — two apiece', 'P6d · Rails', 'A groove down each margin, each filling as the movement is read, each with its own stylus. One line at the edge of a centred composition pulls it off balance; two hold it. And a record has two sides, which is the only honest reason to draw the line twice.'],
  'ab-p6e': ['About · P drafts, centred text — two apiece', 'P6e · Unwind', 'P6 asserts that a groove unwound is a straight rule; this one draws the unwinding. Five turns of real spiral are cut over the first third of the movement, then run on as the hairline that carries the rest of it. One gesture, one clock, split by animation-range rather than by seconds.'],
  'ab-p2c': ['About · P drafts, centred', 'P2c · Port, centred', 'P2 cut its circle out of the panel’s right edge — a composition with a side to it. On the axis the port moves to the bottom edge, half in the page and half below it, so the disc hangs under the box like a record halfway out of the foot of its sleeve.'],
  'ab-p5c': ['About · P drafts, centred', 'P5c · Spindle, centred', 'P5 pinned the disc to the screen’s right edge. Here it goes to the middle, behind the box: the record holds still at the heart of the page while the reading travels up over it, and is wider than the panel so it shows all round.'],
  'ab-p6c': ['About · P drafts, centred', 'P6c · Groove, centred', 'P6 ran its groove down the left margin, clear of everything. On the axis it cannot be: it runs down the middle and passes behind the box. A groove with a label sitting on it is what a record looks like; one down an empty margin is just a rule.'],
  'ab-c7': ['About · D · Poster centred — second set', 'C7 · Pressing', 'The record is pressed out of the catalogue: no disc is drawn at all, the grooves are rings of light straight onto the mosaic, so the vinyl is made of the work itself. Nothing is covered — a circle of stills simply becomes a surface.'],
  'ab-c8': ['About · D · Poster centred — second set', 'C8 · Strobe', 'The part of a turntable that measures itself: the ring of marks round a platter’s edge that stands still when the speed is right. Forty-eight of them go round the box, four struck in accent. The one draft where the record’s contribution is a measurement rather than an image.'],
  'ab-c9': ['About · D · Poster centred — second set', 'C9 · Stack', 'Records seen edge-on, and the pile grows as you read: one disc on the spindle at 02, four by 05. A record is also an object with an edge, and a changer’s stack is the one image in the vocabulary that counts rather than spins.'],
  'ab-c10': ['About · D · Poster centred — second set', 'C10 · Lathe', 'The record is being cut while you read it: a real Archimedean spiral of thirteen turns, drawn from the middle out as the movement is scrolled. Not a ring that fills — the shape a groove actually is.'],
  'ab-c11': ['About · D · Poster centred — second set', 'C11 · Rim', 'The movement’s name closed into a circle around the box, stretched to meet itself, so the reading sits inside its own title the way a label sits inside the run-out. The name is a headline above and an object here.'],
  'ab-c12': ['About · D · Poster centred — second set', 'C12 · Impressions', 'The record as the page’s punctuation: the same groove-and-label form at seven pixels, standing in for every bullet and step marker, at label size beside each statement, and at full size closing the last movement. One object from 7px to 190px.'],
  'ab-c1': ['About · D · Poster centred, with the record', 'C1 · Label', 'The box is the label and the page is the record: a disc far larger than the panel sits centred behind it, grooves running out from behind the box on every side and off the screen. Its outer band carries the movement number as a catalogue number, turning with it.'],
  'ab-c2': ['About · D · Poster centred, with the record', 'C2 · Deck', 'Two decks with the box between them — a disc each side, half cut off by the screen, counter-rotating, so the reading sits where a mixer sits. The labels carry what the page already knows: the movement number and the year range.'],
  'ab-c3': ['About · D · Poster centred, with the record', 'C3 · Ring', 'The groove is drawn round the box and it is the progress: one circular hairline encloses the panel, fills as the movement is read, and a stylus runs along it. P6 unwound the spiral into a line; this keeps the circle and puts the box inside it.'],
  'ab-c4': ['About · D · Poster centred, with the record', 'C4 · Tonearm', 'The arm is the part of a record player that knows where you are. It rests off the record at the top of a movement, drops onto the outer groove and tracks inward as the section is read — position as information.'],
  'ab-c5': ['About · D · Poster centred, with the record', 'C5 · Close-up', 'The record is too big to see: a disc two and a half times the width of the screen, so no edge is ever visible and what crosses the page is a set of wide arcs. The quietest of the six — it draws the material rather than the object.'],
  'ab-c6': ['About · D · Poster centred, with the record', 'C6 · Flip', 'Every movement is a side, and the record turns over between them: a disc above the box flips on its vertical axis as you scroll, the number going and the name arriving. Two faces on one disc, not a crossfade.'],
  'ab-p1': ['About · D · Poster boxed, with the record', 'P1 · Sleeve-out', 'The panel is a sleeve and the record is what it is holding: the disc sits behind the box and is pulled out to the right by the scroll, turning as it goes. Display type on the wall over the mosaic, reading on paper inside the box.'],
  'ab-p2': ['About · D · Poster boxed, with the record', 'P2 · Port', 'The record is a hole in the page and the catalogue is its playing surface: a circle is masked out of the panel’s right edge, so the stills show through it and the grooves are drawn over them. The panel’s edge halves the circle, so it reads as something the page is opened onto.'],
  'ab-p3': ['About · D · Poster boxed, with the record', 'P3 · Dial', 'The record as an instrument: small, set into the panel’s top edge like a dial let into a deck, turning with the movement, with a fixed index above it and one tick per thing the movement contains — five paragraphs, three disciplines, three steps, two closing lines.'],
  'ab-p4': ['About · D · Poster boxed, with the record', 'P4 · Cut', 'The name is filled with the record: knocked out of a plate of ground with a disc behind it, so the letterforms are grooves and the label turns behind one of them. D3 cut the same hole onto the catalogue; this cuts it over an object.'],
  'ab-p5': ['About · D · Poster boxed, with the record', 'P5 · Spindle', 'The record is playing while you read: pinned to the right edge for the whole of a movement, half off the page, turning, while the panel travels up past it — and the label carries that movement’s number, so the side changes as you pass.'],
  'ab-p6': ['About · D · Poster boxed, with the record', 'P6 · Groove', 'The record unwound. A groove is one continuous spiral, so it is drawn straight: a hairline down every movement with a disc sitting on it like a stylus at the start of a side, filling as you scroll. The only one of the six that is not a picture of a disc.'],
  'ab-t1': ['About · D2 · Traverse — variations', 'T1 · Hold', 'The sheet stops to be read. D2 travels at one rate, so the type drifts the whole time you are reading it; here it holds on each panel for most of that panel’s scroll and crosses to the next quickly — 58% holds, 42% eased moves — and a rail at the foot carries one tick per panel with the live one in accent.'],
  'ab-t2': ['About · D2 · Traverse — variations', 'T2 · Counter', 'The sheet is cut into bands that travel against each other, and the poster assembles itself in the middle: name, statement and reading move in opposite directions at different rates and are all at zero exactly half way through the movement. The composition is a moment rather than a state — and it is shorter than D2, not longer.'],
  'ab-t3': ['About · D2 · Traverse — variations', 'T3 · Frame', 'The name stops travelling and everything else goes through it: fixed in the middle of the pinned stage, set in difference blend, so wherever a line passes under it the overlap flips. The accent moves to the folio, because white over orange would make a blue this site does not own.'],
  'ab-d1': ['About · D · Poster — variations', 'D1 · Justified', 'Every movement’s name is SVG text fitted to the full measure, so it is flush at both margins at any width — and the grid is drawn, eleven hairlines on the real column boundaries, so the type can be seen meeting it. Fitting to a fixed measure sets the short titles large and the long ones small; that difference is the composition.'],
  'ab-d2': ['About · D · Poster — variations', 'D2 · Traverse', 'The whole poster travels, not just the word: each movement pins and its sheet moves sideways — name, statement, reading, each a screen wide — while the giant name counter-moves at a third of the rate, so type and page separate as it goes. Costs length: about twice D’s height.'],
  'ab-d3': ['About · D · Poster — variations', 'D3 · Window', 'The names are cut rather than printed: a plate of the site’s ground with the letterforms knocked out, over transparent sections, so the catalogue shows through the type. The bed only appears inside the page’s aperture, so a word fills with picture as it crosses the window and empties as it leaves.'],
  'ab-g': ['About · redesigned again, palette unchanged', 'G · Specimen', 'The About section as a type specimen of the site’s own serif. Every block is labelled in the margin with the settings it is really set in, and Who I am descends the optical size axis over five paragraphs — 46px down to 18px, opsz 96 down to 20 — so the section opens at display size and settles into reading size.'],
  'ab-h': ['About · redesigned again, palette unchanged', 'H · Plate', 'Drawn as a technical plate: a ruled sheet with the title block in its corner, a dimension line under the statement, dashed leaders running out to each annotation, three assemblies with their parts, and the method as a signal chain — three stages joined by a rule with an arrowhead. IBM Plex Sans and Mono.'],
  'ab-i': ['About · redesigned again, palette unchanged', 'I · Subtitle', 'The page is already a film, so the About section becomes the thing you watch the catalogue with: sections go transparent, the wall of stills shows through, and the writing arrives one caption at a time in the lower third. Scrolling is the transport. Costs length — About runs about two and a half times taller.'],
  'ab-j': ['About · redesigned again, palette unchanged', 'J · Spine', 'The movement’s name set down the edge of the page like the spine of a book and held there while it is read, everything else hanging to the right of one hairline. The hairline carries a tick whose position is that movement’s own scroll progress — the spine is also its scrollbar. Big Shoulders Display and Literata.'],
  'ab-k': ['About · redesigned again, palette unchanged', 'K · Stack', 'Four cards that stack: each sticks to the top and the next slides over it, leaving its number and title showing, so by the last movement the screen carries the whole About section as a row of tabs. Layout rather than animation. Bricolage Grotesque, the least neutral face here, against Spectral.'],
  'ab-l': ['About · redesigned again, palette unchanged', 'L · Clause', 'Set as a document: one family — the site’s own mono — one measure, hard left, no display type anywhere, and every line numbered as a clause, 02.0 through 05.1. The most reduced of the twelve, and reduced towards record rather than towards space.'],
  'ab-a': ['About · redesigned from scratch', 'A · Credits', 'Set as a film’s end credits: one centre axis on pure black, labels right of it and entries left, prose as centred cards in Archivo’s condensed width. The last card — “The work should sound like itself.” — holds on screen for 70vh before contact arrives, the way every film’s final card does.'],
  'ab-b': ['About · redesigned from scratch', 'B · Score', 'Engraved as the opening pages of a full score in EB Garamond. What I work across becomes the instrumentation page — three families bracketed down the margin, fifteen staves drawing in — How I work is three movements between barlines, and the section ends on a final double barline.'],
  'ab-c': ['About · redesigned from scratch', 'C · Silence', '“The weight of a silence” as a layout: the one pale page in a dark site. Cool paper, graphite Jost at three sizes, each thought placed off-axis with long empty space between, How I work descending as a stair, nothing moving. It ends on one line at the centre of an empty screen.'],
  'ab-d': ['About · redesigned from scratch', 'D · Poster', 'Swiss posters in the site’s own grotesk: each movement’s name so large the screen crops it, panning sideways as you scroll past, over a strict twelve-column grid. Monochrome — the only colour is the site’s orange on the full stops.'],
  'ab-e': ['About · redesigned from scratch', 'E · Feature', 'A magazine profile: Bodoni Moda headlines at full optical size, Newsreader for reading, a mono folio and margin, a drop cap, a double-ruled fact box, and step one’s three questions lifted into a pull quote across the spread. It ends on a tombstone.'],
  'ab-f': ['About · redesigned from scratch', 'F · Sleeve', 'Packaged as an LP: square sleeves hung over the wall of stills — orange gothic cover type, liner notes, a tracklist — a gatefold for How I work, and the closing line set round a record label that turns as you scroll. The only draft that keeps the bed visible.'],
};

const pretty = (s: string) =>
  s.replace(/-/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase());

const groups = new Map<string, { slug: string; title: string; note: string }[]>();
for (const slug of pages) {
  const [group, title, note] = NOTES[slug] ?? ['Unfiled', pretty(slug), ''];
  if (!groups.has(group)) groups.set(group, []);
  groups.get(group)!.push({ slug, title, note });
}
---

<Base title="Previews — Ugam Khetani">
  <main class="pv">
    <header class="pv__hd">
      <p class="mono pv__eyebrow">Previews</p>
      <h1 class="pv__t">Drafts</h1>
      <p class="pv__lede">
        Design options built as real pages, to be judged in the browser rather
        than described. Nothing here is on the live site unless it says so.
      </p>
      <p class="mono pv__count">{pages.length} {pages.length === 1 ? 'draft' : 'drafts'}</p>
    </header>

    {[...groups].map(([group, items]) => (
      <section class="pv__grp" aria-label={group}>
        <p class="mono pv__grpname">{group}</p>
        <ul class="pv__list">
          {items.map((it) => (
            <li class="pv__row">
              <a class="pv__a" href={`/preview/${it.slug}`}>
                <span class="pv__name">{it.title}</span>
                <span class="mono pv__slug">{it.slug}</span>
                {it.note && <span class="pv__note">{it.note}</span>}
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}

