---
/**
 * THE PREVIEW INDEX — one page that lists every draft.
 *
 * The library used to be 71 pages with no way in except a URL you had to
 * remember, and it was deleted partly for that. This is the way back in: any
 * .astro file dropped in this folder appears here on the next build, with no
 * list to keep in step.
 *
 * DISCOVERY IS A GLOB, NOT A TABLE. `import.meta.glob` is evaluated at build
 * time and is eager: false, so nothing here loads a draft's module — only its
 * path is read. A draft that is deleted stops being listed because the file is
 * gone, which is the only kind of index that cannot go stale.
 *
 * The glob is case-sensitive, as it is in src/lib/frames.ts (HANDOFF §6), but
 * every page in this folder is lowercase .astro so one pattern is enough.
 *
 * NOTES ARE OPTIONAL. A slug with no entry in NOTES still lists, under a title
 * derived from its filename — so adding a draft never means editing this file,
 * and writing a note is a courtesy rather than a requirement.
 */
import Base from '../../layouts/Base.astro';

const pages = Object.keys(import.meta.glob('./*.astro', { eager: false }))
  .map((p) => p.replace('./', '').replace('.astro', ''))
  .filter((s) => s !== 'index')
  .sort();

/** slug → [group, title, note]. Anything missing falls back to its filename. */
const NOTES: Record<string, [string, string, string]> = {
  'txt-a': ['Home · told in type, from the reference film', 'A · Typeset', 'The page sets itself line by line: every heading line rises fully out of its own mask, then the paragraph beneath is lit top-down, a line of words at a time. The reference’s three-line stacked headline read as an instruction.'],
  'txt-b': ['Home · told in type, from the reference film', 'B · Uncover', 'The wall of work comes forward, crosses in front of the type, and the words are simply there in its wake. Directly from 4.6–7.6s, where a train of cards swallows whole words and gives them back. The only draft where one part of the page hides another.'],
  'txt-c': ['Home · told in type, from the reference film', 'C · Restage', 'The type is re-set rather than revealed — headings arrive at 1.7×, the statement at 1.22, paragraphs at 1.08, and all settle onto their real size. Copied from the headline that is one giant line at 5s and three stacked lines by 8s.'],
  'txt-d': ['Home · told in type, from the reference film', 'D · Handover', 'Text leaves as well as arrives: a movement lifts away up the screen while the next is already landing. One clock for the whole movement, with a still middle third where nothing moves and everything is read. The thing the reference does at 8.6s that no draft here has ever done.'],
  'txt-e': ['Home · told in type, from the reference film', 'E · Diagonal', 'A band of light crosses the writing at 40° — neither reading order nor line order, so the paragraph fills as a wave. The card cascade turned into type. Nothing travels and nothing scales; the page only lights.'],
  'txt-f': ['Home · told in type, from the reference film', 'F · Counter', 'The title comes from the left and its paragraph from the right, meeting at true — the reference’s alternating rows at the scale of a sentence. The statement is deliberately left out of it, so the trio has a still point.'],
  'ind-a': ['Selected works · the scroll indicator', 'A · Rule', 'The ticks go. One hairline the width of the instrument and a solid segment growing along it — proportion instead of enumeration. The plainest of the six and the only one needing no instruction.'],
  'ind-b': ['Selected works · the scroll indicator', 'B · Index', 'The ticks become numerals, 01 to 16, in the mono face — the catalogue counted rather than measured, with a rule under the one you are on. CSS counters, so not a single element was added.'],
  'ind-c': ['Selected works · the scroll indicator', 'C · Comb', 'A comb of majors and minors with everything ahead of the playhead veiled in the page’s own ground. Keeps the count the live version has and adds the proportion it lacks; every fourth mark stands taller so sixteen is countable at a glance.'],
  'ind-d': ['Selected works · the scroll indicator', 'D · Bracket', 'The playhead becomes two marks above and below one hairline, closing on the work like a frame marked up for a cut — and the caption sits inside them, so the instrument names what it points at.'],
  'ind-e': ['Selected works · the scroll indicator', 'E · Dial', 'A dense scale of the kind etched on a lens barrel: 48 graduations out of 16 elements, majors in --dim, minors in --rule, playhead overhanging in bone. The page’s vocabulary is optical; this is the one instrument it had never drawn.'],
  'ind-f': ['Selected works · the scroll indicator', 'F · Foot', 'The instrument becomes a running foot — title hard left, year hard right, rule stretched between them across the full film width. What every book does, and what this page already does with its corner labels.'],
  'nm-a': ['Selected works · the name and the indicator', 'A · Underline', 'The indicator becomes the name’s own underline — one rule 4px beneath the title, filling from the left. Three stacked things become one mark, and with nothing competing below it the name goes up to 2rem and is allowed to wrap.'],
  'nm-b': ['Selected works · the name and the indicator', 'B · Folio', 'No rule at all. The name, and beneath it a folio — 04 / 16 — in the mono face. Position told in numbers, the way a book tells you. The most reduced of the twelve, and the only one that says exactly which of exactly how many.'],
  'nm-c': ['Selected works · the name and the indicator', 'C · Masthead', 'The name goes big and hard left at cover size, the year to the far right of the same line, and the hairline runs above the pair. Everything on this page is centred; this is the one place that can be left-aligned without breaking that.'],
  'nm-d': ['Selected works · the name and the indicator', 'D · Plate', 'The whole readout becomes one rounded plate — folio, name and year on a line, with the progress drawn as a fill behind all three so the plate charges up. The reference film is built from plates at every size; this is the furniture that never joined in.'],
  'nm-e': ['Selected works · the name and the indicator', 'E · Stack', 'Name and year stacked tight at the left, the rule running away to the right — the only draft where the instrument is longer than the type is wide, which makes the rule the subject and the name its label.'],
  'nm-f': ['Selected works · the name and the indicator', 'F · Slug', 'Everything goes mono and small: the name tracked out at 11px with the year after it, a hairline, and one 14px block travelling on it. The quietest answer — the conveyor already shows you the work at full size, so the readout only logs it.'],
  'rd-a': ['Selected works · the readout, reimagined', 'A · Reel', 'The indicator becomes the catalogue. All sixteen names in one long row that slides so the one you are on sits lit on the centre line, neighbours legible either side, the rest running off into the dark. The caption goes — the reel is the caption.'],
  'rd-b': ['Selected works · the readout, reimagined', 'B · Sprocket', 'The strip gets perforations and the name sits in the frame between them. The page opens on an Academy leader and is built around an aperture; the one piece of film it had never drawn is the edge of the stock itself.'],
  'rd-c': ['Selected works · the readout, reimagined', 'C · Waveform', 'Each mark takes its height from that work’s own aspect ratio — 2.39 stands tall, 9:16 sits low — so the scale is a picture of the catalogue’s shape and the playhead is a transport crossing it. Verified: all sixteen heights match the sixteen real ratios.'],
  'rd-d': ['Selected works · the readout, reimagined', 'D · Strike', 'One hairline the full width, and the title sits on it, knocking a hole with its own ground so the rule passes behind the type and out the other side. A rule interrupted by a word — except the word changes as you scroll.'],
  'rd-e': ['Selected works · the readout, reimagined', 'E · Register', 'Printer’s registration marks: sixteen faint crosshairs with the live one struck full in accent, and the name between two corner marks like an image being placed. The one piece of production language that is literally an indicator.'],
  'rd-f': ['Selected works · the readout, reimagined', 'F · Segment', 'A segmented meter — sixteen blocks filling one at a time, smooth underneath and stepped on top, so it says which work AND how far into it. Discrete, because there are sixteen works and you are on one of them.'],
  'px-a': ['Selected works · the readout, by mechanism', 'A · Contact', 'The scale becomes a contact sheet — sixteen frames of the catalogue at 26×18, dark until live, the current one lifting and coming up to full colour. Every indicator ever made abstracts what it indexes; this is the thing itself, sixteen times.'],
  'px-b': ['Selected works · the readout, by mechanism', 'B · Chronology', 'Position stops meaning “which” and starts meaning “when”: the ruler divides into a band per year and each work sits in its own. Measured — your catalogue is 9 works in 2025 and 7 in 2026, and the scale now says so.'],
  'px-c': ['Selected works · the readout, by mechanism', 'C · Ring', 'The scale bent onto an arc about a centre 520px below the page — a lens focus ring. The index mark is fixed at the top and the ring turns under it, which is how a lens actually works: the barrel moves, the index does not.'],
  'px-c2': ['Selected works · the readout, by mechanism', 'C2 · Ring, smooth', 'C · Ring turned by an integer, so it clicked between sixteen resting positions with a 520ms ease hiding the steps. This reads the same continuous number the conveyor reads and drops the transition entirely. Measured across the section: 16 possible positions become 41 of 41 distinct, evenly stepped and monotonic.'],
  'px-d': ['Selected works · the readout, by mechanism', 'D · Weight', 'The only draft that changes how the thing behaves rather than how it looks. One declaration — a transition on left with an overshooting curve — and the marker stops being welded to the scroll and starts being an object with mass.'],
  'px-e': ['Selected works · the readout, by mechanism', 'E · Flap', 'The name changes like a departure board: each character turns over on its own axis, 26ms apart, so a new work is set letter by letter rather than cross-faded. Transport signage, not software.'],
  'px-f': ['Selected works · the readout, by mechanism', 'F · Handle', 'The name rides the marker. No caption above the ruler — the title is printed inside the playhead, so the label travels with the position it describes and the two cannot be misread as separate things.'],
  'rng-a': ['Selected works · Ring, smooth — variations', 'A · Barrel', 'The lens drawn properly: every fourth mark stands taller, a hairline follows the same 520px arc beneath them, and both ends fade into the dark so the scale reads as the near face of a barrel turning. The grouping is what makes sixteen countable at a glance.'],
  'rng-b': ['Selected works · Ring, smooth — variations', 'B · Meter', 'The ring fills as it turns — marks past the index are lit, marks still to come are furniture. The boundary is fixed in the frame rather than attached to any mark, so the ring turns through it and the arc reads as charging rather than sliding.'],
  'rng-c': ['Selected works · Ring, smooth — variations', 'C · Horizon', 'The arc turned over: the centre goes above the page, so the scale bows downward and the marks hang from it. Same mechanism, opposite gesture — and the wedge of space it opens underneath is exactly the shape a line of type wants to sit in.'],
};

const pretty = (s: string) =>
  s.replace(/-/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase());

const groups = new Map<string, { slug: string; title: string; note: string }[]>();
for (const slug of pages) {
  const [group, title, note] = NOTES[slug] ?? ['Unfiled', pretty(slug), ''];
  if (!groups.has(group)) groups.set(group, []);
  groups.get(group)!.push({ slug, title, note });
}
---

<Base title="Previews — Ugam Khetani">
  <main class="pv">
    <header class="pv__hd">
      <p class="mono pv__eyebrow">Previews</p>
      <h1 class="pv__t">Drafts</h1>
      <p class="pv__lede">
        Design options built as real pages, to be judged in the browser rather
        than described. Nothing here is on the live site unless it says so.
      </p>
      <p class="mono pv__count">{pages.length} {pages.length === 1 ? 'draft' : 'drafts'}</p>
    </header>

    {[...groups].map(([group, items]) => (
      <section class="pv__grp" aria-label={group}>
        <p class="mono pv__grpname">{group}</p>
        <ul class="pv__list">
          {items.map((it) => (
            <li class="pv__row">
              <a class="pv__a" href={`/preview/${it.slug}`}>
                <span class="pv__name">{it.title}</span>
                <span class="mono pv__slug">{it.slug}</span>
                {it.note && <span class="pv__note">{it.note}</span>}
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}

    <p class="mono pv__back"><a href="/">&larr; Back to the site</a></p>
  </main>
</Base>

<style>
  .pv {
    max-width: min(860px, 100%);
    margin-inline: auto;
    padding: clamp(96px, 15vh, 190px) var(--margin) clamp(80px, 14vh, 180px);
  }
  .pv__eyebrow {
    margin: 0 0 clamp(18px, 3vh, 30px);
    font-size: var(--t-micro); letter-spacing: 0.16em;
    text-transform: uppercase; color: var(--dim);
  }
  .pv__t {
    margin: 0 0 clamp(18px, 3vh, 28px);
    font-family: var(--display); font-weight: 500;
    font-size: clamp(2.4rem, 7vw, 4.2rem); line-height: 1; letter-spacing: -0.03em;
  }
  .pv__lede { margin: 0 0 14px; max-width: 52ch; font-size: var(--t-md); color: var(--bone-dim); }
  .pv__count { margin: 0 0 clamp(56px, 9vh, 110px); font-size: var(--t-micro); color: var(--dim); }

  .pv__grp { margin-bottom: clamp(52px, 8vh, 96px); }
  .pv__grpname {
    margin: 0 0 clamp(14px, 2vh, 20px); padding-bottom: 12px;
    border-bottom: 1px solid var(--rule);
    font-size: var(--t-micro); letter-spacing: 0.16em;
    text-transform: uppercase; color: var(--bone-dim);
  }
  .pv__list { list-style: none; margin: 0; padding: 0; }
  .pv__row { border-bottom: 1px solid var(--rule); }
  .pv__a {
    display: grid; grid-template-columns: minmax(0, 1fr) auto;
    gap: 4px clamp(16px, 3vw, 40px); align-items: baseline;
    padding-block: clamp(16px, 2.4vh, 24px);
    text-decoration: none; color: var(--bone);
  }
  .pv__name { font-size: var(--t-md); }
  .pv__slug { font-size: var(--t-micro); color: var(--dim); text-align: right; }
  .pv__note {
    grid-column: 1 / -1; max-width: 60ch;
    font-size: var(--t-sm); color: var(--bone-dim); line-height: 1.5;
  }
  .pv__a:hover .pv__name { text-decoration: underline; text-underline-offset: 4px; }
  .pv__a:hover .pv__slug { color: var(--bone-dim); }

  .pv__back { margin: 0; font-size: var(--t-micro); }
  .pv__back a { color: var(--dim); text-decoration: none; }
  .pv__back a:hover { color: var(--bone); }
</style>
