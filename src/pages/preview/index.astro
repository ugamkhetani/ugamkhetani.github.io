---
/**
 * THE PREVIEW INDEX — one page that lists every draft.
 *
 * The library used to be 71 pages with no way in except a URL you had to
 * remember, and it was deleted partly for that. This is the way back in: any
 * .astro file dropped in this folder appears here on the next build, with no
 * list to keep in step.
 *
 * DISCOVERY IS A GLOB, NOT A TABLE. `import.meta.glob` is evaluated at build
 * time and is eager: false, so nothing here loads a draft's module — only its
 * path is read. A draft that is deleted stops being listed because the file is
 * gone, which is the only kind of index that cannot go stale.
 *
 * The glob is case-sensitive, as it is in src/lib/frames.ts (HANDOFF §6), but
 * every page in this folder is lowercase .astro so one pattern is enough.
 *
 * NOTES ARE OPTIONAL. A slug with no entry in NOTES still lists, under a title
 * derived from its filename — so adding a draft never means editing this file,
 * and writing a note is a courtesy rather than a requirement.
 */
import Base from '../../layouts/Base.astro';

const pages = Object.keys(import.meta.glob('./*.astro', { eager: false }))
  .map((p) => p.replace('./', '').replace('.astro', ''))
  .filter((s) => s !== 'index')
  .sort();

/** slug → [group, title, note]. Anything missing falls back to its filename. */
const NOTES: Record<string, [string, string, string]> = {
  /* THE LIBRARY WAS EMPTIED 2026-10-04 on Ugam's instruction and has been
     rebuilt since. The sixty-three entries that used to be here keyed drafts
     that no longer exist — `git show d45bbfe:src/pages/preview/index.astro`
     has all of them, and the drafts themselves are in the same commit.

     A note is a courtesy, not a requirement: a draft with no entry still
     lists, under a title derived from its filename. */

  /* ── AASHA · STILLS ─────────────────────────────────────────────
     Eight directions for the stills section of the work page, built
     2026-10-04. Each one is a different claim about what a sequence of
     frames IS, not a different arrangement of the same claim, and each
     carries the Aasha page's own header, statement and lede so it can be
     judged in context. The production section is untouched. */
  'ab-st1': ['Aasha · Stills', 'ST1 · The select', 'A contact sheet with one frame promoted — curation made visible. Click or arrow through the eight.'],
  'ab-st2': ['Aasha · Stills', 'ST2 · The gate', 'One frame, pinned, and the scroll CUTS between them. No dissolve anywhere.'],
  'ab-st3': ['Aasha · Stills', 'ST3 · The dark', 'No borders. The frames are masked at all four edges so their own blackness joins the page.'],
  'ab-st4': ['Aasha · Stills', 'ST4 · The reel', 'One continuous full-bleed band, read sideways. The ruler of numbers is also the scrub bar.'],
  'ab-st5': ['Aasha · Stills', 'ST5 · The pair', 'Four diptychs on a shared seam, numbered I–IV. The unit is the pair, not the frame.'],
  'ab-st6': ['Aasha · Stills', 'ST6 · The index', 'A catalogue set in type; the plate answers whichever row you are on. Readable with no images.'],
  'ab-st7': ['Aasha · Stills', 'ST7 · The fall', 'Five widths down one column, with the numerals enormous in the empty gutters. The subject is timing.'],
  'ab-st8': ['Aasha · Stills', 'ST8 · The aperture', 'A fixed hole; the eight frames slide through it as one strip. The opposite of ST2.'],

  /* ── AASHA · THE REEL, SECOND FOUR ──────────────────────────────
     2026-10-05, same brief as RL1-4 and deliberately not overlapping them.
     Four further facts about the material: that a reel is a spiral, that a
     misframed projector shows the bar between two frames, that a feature is
     handed between two machines mid-screening, and that before any of this
     the roll comes back from the lab as a contact sheet. */
  'ab-rl5': ['Aasha · The reel II', 'RL5 · The wind', 'A reel is a spiral. Frames arrive on a tangent and wind onto a growing coil; the first to arrive ends up innermost.'],
  'ab-rl6': ['Aasha · The reel II', 'RL6 · The rack', 'Lives in the misframe: two half-frames and the frame line between them. The exact opposite of RL2.'],
  'ab-rl7': ['Aasha · The reel II', 'RL7 · The changeover', 'Two projectors, two reels. Cue mark, both machines live, handover — the structural break is where the reel ends.'],
  'ab-rl8': ['Aasha · The reel II', 'RL8 · The sheet', 'The whole roll contact-printed as four strips. Nothing moves except the reading, which scroll walks and hover overrides.'],

  /* ── AASHA · THE HORIZONTAL STRIP, REFINED ──────────────────────
     2026-10-05. Four reworkings of ab-fs2 — same 135 stock, same linear
     advance, same geometry to spec — asked to be more elegant. The stock
     itself changed once for all four: the film base lifts 5.5% off the page
     so the strip reads as an object, the perforation is the page punched
     through with no second tone, and the long edges take a hairline. */
  'ab-fa1': ['Aasha · The strip II', 'FA1 · The edge', 'The page cuts the film below the aperture: one rail, no picture lost, half the furniture of FS2. Numbers off the film and into the air above it.'],
  'ab-fa2': ['Aasha · The strip II', 'FA2 · The gate', 'One window two apertures wide on an empty page. The most restrained of the set — one object, one hairline, one rule.'],
  'ab-fa3': ['Aasha · The strip II', 'FA3 · The baseline', 'A large clean photograph and a small strip at the foot of the page, driven by one number so they cannot drift.'],
  'ab-fa4': ['Aasha · The strip II', 'FA4 · The measure', 'Set to the measure and cut by it rather than bled off the viewport. The symmetrical, conventional one — deliberately.'],

  /* ── AASHA · STILLS, THE REEL ───────────────────────────────────
     2026-10-05. Four readings of the film reel, scroll and hover only. The
     brief was explicitly not a film-strip skin, so none of these put the
     stills inside a sprocketed graphic: each takes a different fact about
     the physical material — how it hangs, how it moves through a gate, what
     a leader is for, how two rolls are conformed — and lets that fact set
     the composition. No invented key numbers or footage counts anywhere;
     every figure is either a property of the page or a measured luminance. */
  'ab-rl1': ['Aasha · The reel', 'RL1 · The pay-out', 'Film draped on a curve through the page, frames riding it tangentially. The feed coil shrinks as the take-up grows.'],
  'ab-rl2': ['Aasha · The reel', 'RL2 · The intermittent', 'The projector’s real mechanism: the sprockets turn with your scroll, the gate advances in jerks, the loop absorbs the difference.'],
  'ab-rl3': ['Aasha · The reel', 'RL3 · The leader', 'The Academy countdown as the structure. 08 down to 01, so the film runs in reverse and ends at its first frame.'],
  'ab-rl4': ['Aasha · The reel', 'RL4 · The checkerboard', 'A and B rolls, alternating picture and black leader, converging into a single printed strip as you scroll.'],

  /* ── AASHA · STILLS, THIRD ROUND ────────────────────────────────
     2026-10-05. Scroll and hover only — no clicks, no controls, no
     navigation anywhere in these eight; the generator asserts it rather than
     trusting me. Editorial and cinematic rather than interactive: the
     behaviour is composed into the page instead of operated by the reader.
     Several art-direct from the luminance measured in round two, which is
     recorded in each file's frontmatter rather than recomputed. */
  'ab-sq1': ['Aasha · Stills III', 'SQ1 · The spreads', 'Six full-viewport compositions, snapped — a magazine, not a system. Hover and the spread’s type stands down.'],
  'ab-sq2': ['Aasha · Stills III', 'SQ2 · The composite', 'All eight screened into one picture; scroll resolves them and lets them close again. Hover pulls the other seven back.'],
  'ab-sq3': ['Aasha · Stills III', 'SQ3 · The duration', 'Scroll-distance per frame varies 6× — a real edit. Some frames pin, some flash past; the cutting strip shows the rhythm.'],
  'ab-sq4': ['Aasha · Stills III', 'SQ4 · The pan', 'Hard formats, and scroll moves the frame inside them — tilts and pans, never a zoom. Hover draws what the crop excludes.'],
  'ab-sq5': ['Aasha · Stills III', 'SQ5 · The stack', 'Nothing scrolls away; frames pile up and their exposed edges write a contents page. Hover thumbs one print up.'],
  'ab-sq6': ['Aasha · Stills III', 'SQ6 · The continuity', 'Three flush bands take thirds of three different frames into one image nobody photographed. Hover opens a band to its source.'],
  'ab-sq7': ['Aasha · Stills III', 'SQ7 · The spine', 'The Swiss one. Every frame hangs flush off a single hairline that scroll draws from the top. Hover connects one to it.'],
  'ab-sq8': ['Aasha · Stills III', 'SQ8 · The approach', 'One arc: the pictures grow 6× while the typography shrinks by the same, and they trade places. Hover gives the words back.'],

  /* ── AASHA · STILLS, SECOND ROUND ───────────────────────────────
     2026-10-05. The brief was to push far past ST1–8: the INTERACTION is the
     concept here, not the arrangement. Eight different interaction models —
     a scrubbed data curve, two independent axes, type as an aperture plate, a
     field you pan, velocity, accumulated dwell, measured properties, and a
     material state. Two of them (XP1, XP7) compute from the actual pixels in
     the browser, so their numbers are measured rather than asserted. */
  'ab-xp1': ['Aasha · Stills II', 'XP1 · The score', 'The browser measures the film’s light, 128 columns a frame, and draws it as one ribbon you scrub. The curve is the only control.'],
  'ab-xp2': ['Aasha · Stills II', 'XP2 · The splice', 'Scroll picks the left frame, pointer-X picks the right. 64 cuts, and you author them. ST5 with the authorship handed over.'],
  'ab-xp3': ['Aasha · Stills II', 'XP3 · The sentence', 'The statement’s eight content words are cut through to eight frames; scroll runs the film inside the letterforms.'],
  'ab-xp4': ['Aasha · Stills II', 'XP4 · The field', 'The stills are in a space three screens wide. Drag to search it; the minimap is the only complete view of the set.'],
  'ab-xp5': ['Aasha · Stills II', 'XP5 · The persistence', 'Each frame is nine bands that shear apart with scroll VELOCITY and settle when you stop. Captions are the reward for stillness.'],
  'ab-xp6': ['Aasha · Stills II', 'XP6 · The attention', 'One full-width band that divides itself by how long you actually looked. It accumulates and it keeps — not an accordion.'],
  'ab-xp7': ['Aasha · Stills II', 'XP7 · The sort', 'Measured luminance, contrast and detail lay the eight out on real axes. Sequence beside them shows what the light implies.'],
  'ab-xp8': ['Aasha · Stills II', 'XP8 · The bath', 'They arrive as negatives; one fixed line across the viewport is the developer’s surface. Scroll back up and they un-develop.'],

  /* ── ABOUT · HEADINGS ───────────────────────────────────────────
     The four About headings and how far they travel. ab-pn1 is applied to
     the live site; the other two are its alternatives and ab-live is what
     the site looked like before it went in. */
  'ab-hs1': ['About · Headings', 'HS1 · One size', 'All four About headings at 10.162vw, matching WHAT I WORK ACROSS. The starting point for the pan drafts.'],
  'ab-pn1': ['About · Headings', 'PN1 · Later exit', 'APPLIED LIVE. The three short headings start further right so they hold the screen longer.'],
  'ab-pn2': ['About · Headings', 'PN2 · Slower', 'The same entry points as PN1 with the travel slowed instead of shortened.'],
  'ab-pn3': ['About · Headings', 'PN3 · Matched ends', 'Speeds left variable, but all three enter and leave exactly where WHAT I WORK ACROSS does.'],
  'ab-live': ['About · Headings', 'The site before PN1', 'A snapshot of index.astro taken before PN1 was applied, kept so the change can be read both ways.'],
};

const pretty = (s: string) =>
  s.replace(/-/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase());

const groups = new Map<string, { slug: string; title: string; note: string }[]>();
for (const slug of pages) {
  const [group, title, note] = NOTES[slug] ?? ['Unfiled', pretty(slug), ''];
  if (!groups.has(group)) groups.set(group, []);
  groups.get(group)!.push({ slug, title, note });
}
---

<Base title="Previews — Ugam Khetani">
  <main class="pv">
    <header class="pv__hd">
      <p class="mono pv__eyebrow">Previews</p>
      <h1 class="pv__t">Drafts</h1>
      <p class="pv__lede">
        Design options built as real pages, to be judged in the browser rather
        than described. Nothing here is on the live site unless it says so.
      </p>
      <p class="mono pv__count">{pages.length} {pages.length === 1 ? 'draft' : 'drafts'}</p>
    </header>

    {[...groups].map(([group, items]) => (
      <section class="pv__grp" aria-label={group}>
        <p class="mono pv__grpname">{group}</p>
        <ul class="pv__list">
          {items.map((it) => (
            <li class="pv__row">
              <a class="pv__a" href={`/preview/${it.slug}`}>
                <span class="pv__name">{it.title}</span>
                <span class="mono pv__slug">{it.slug}</span>
                {it.note && <span class="pv__note">{it.note}</span>}
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}

    <p class="mono pv__back"><a href="/">&larr; Back to the site</a></p>
  </main>
</Base>

<style>
  .pv {
    max-width: min(860px, 100%);
    margin-inline: auto;
    padding: clamp(96px, 15vh, 190px) var(--margin) clamp(80px, 14vh, 180px);
  }
  .pv__eyebrow {
    margin: 0 0 clamp(18px, 3vh, 30px);
    font-size: var(--t-micro); letter-spacing: 0.16em;
    text-transform: uppercase; color: var(--dim);
  }
  .pv__t {
    margin: 0 0 clamp(18px, 3vh, 28px);
    font-family: var(--display); font-weight: 500;
    font-size: clamp(2.4rem, 7vw, 4.2rem); line-height: 1; letter-spacing: -0.03em;
  }
  .pv__lede { margin: 0 0 14px; max-width: 52ch; font-size: var(--t-md); color: var(--bone-dim); }
  .pv__count { margin: 0 0 clamp(56px, 9vh, 110px); font-size: var(--t-micro); color: var(--dim); }

  .pv__grp { margin-bottom: clamp(52px, 8vh, 96px); }
  .pv__grpname {
    margin: 0 0 clamp(14px, 2vh, 20px); padding-bottom: 12px;
    border-bottom: 1px solid var(--rule);
    font-size: var(--t-micro); letter-spacing: 0.16em;
    text-transform: uppercase; color: var(--bone-dim);
  }
  .pv__list { list-style: none; margin: 0; padding: 0; }
  .pv__row { border-bottom: 1px solid var(--rule); }
  .pv__a {
    display: grid; grid-template-columns: minmax(0, 1fr) auto;
    gap: 4px clamp(16px, 3vw, 40px); align-items: baseline;
    padding-block: clamp(16px, 2.4vh, 24px);
    text-decoration: none; color: var(--bone);
  }
  .pv__name { font-size: var(--t-md); }
  .pv__slug { font-size: var(--t-micro); color: var(--dim); text-align: right; }
  .pv__note {
    grid-column: 1 / -1; max-width: 60ch;
    font-size: var(--t-sm); color: var(--bone-dim); line-height: 1.5;
  }
  .pv__a:hover .pv__name { text-decoration: underline; text-underline-offset: 4px; }
  .pv__a:hover .pv__slug { color: var(--bone-dim); }

  .pv__back { margin: 0; font-size: var(--t-micro); }
  .pv__back a { color: var(--dim); text-decoration: none; }
  .pv__back a:hover { color: var(--bone); }
</style>
