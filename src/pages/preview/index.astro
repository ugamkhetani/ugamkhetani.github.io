---
/**
 * THE PREVIEW INDEX — one page that lists every draft.
 *
 * The library used to be 71 pages with no way in except a URL you had to
 * remember, and it was deleted partly for that. This is the way back in: any
 * .astro file dropped in this folder appears here on the next build, with no
 * list to keep in step.
 *
 * DISCOVERY IS A GLOB, NOT A TABLE. `import.meta.glob` is evaluated at build
 * time and is eager: false, so nothing here loads a draft's module — only its
 * path is read. A draft that is deleted stops being listed because the file is
 * gone, which is the only kind of index that cannot go stale.
 *
 * The glob is case-sensitive, as it is in src/lib/frames.ts (HANDOFF §6), but
 * every page in this folder is lowercase .astro so one pattern is enough.
 *
 * NOTES ARE OPTIONAL. A slug with no entry in NOTES still lists, under a title
 * derived from its filename — so adding a draft never means editing this file,
 * and writing a note is a courtesy rather than a requirement.
 */
import Base from '../../layouts/Base.astro';

const pages = Object.keys(import.meta.glob('./*.astro', { eager: false }))
  .map((p) => p.replace('./', '').replace('.astro', ''))
  .filter((s) => s !== 'index')
  .sort();

/** slug → [group, title, note]. Anything missing falls back to its filename. */
const NOTES: Record<string, [string, string, string]> = {
  'ab-blend1': ['About · Blends', 'Blend 1 · Pin, with the live statements', 'P2j · Pin throughout — the cropped panning names, the 26px spindle-hole port onto a 1400px record, the centred prose, What I work across and How I work — with the Who I am and closing statements taken from the live site as its own markup, not a copy of its styling. So they arrive the way they do on the site: each line rising out of an overflow-hidden box, the closing one word at a time, 70ms apart. Two clocks on one page — the site’s reveal, which fires once, and P2j’s scroll-driven turn and pan, which run throughout.'],
  'ab-d': ['About · redesigned from scratch', 'D · Poster', 'Swiss posters in the site’s own grotesk: each movement’s name so large the screen crops it, panning sideways as you scroll past, over a strict twelve-column grid. Monochrome — the only colour is the site’s orange on the full stops.'],
  'ab-fh5': ['About · ab-fv8, process at scale', 'FH5 · Hanging Display', 'FV8’s idea at the size FV8 should have used. Same display face, same uppercase, same −0.045em — the page’s own way of naming a movement — but at 2.63 times the body instead of 1.65: 40.8px against 15.5px. At that scale the tight tracking stops reading as a label’s device and starts reading as what it is on the frame above. The names sit flush left and the prose indents three characters under them, so the left edge of the section is three large names and nothing else. No rules, no numbers, no boxes: one alignment, held.'],
  'ab-fitlive': ['About · Blends', 'Fit · with the live frame', 'Blend 1b · Fit with its fitted SVG titles replaced by the live site’s own heading apparatus, lifted whole: the movement number and name at the top left, the place at the top right, the folio and year range at the bottom left, Selected works and the scroll cue at the bottom right, and the name again at size in the middle. Everything below the frame is Fit’s — the live statements and their reveals, the prose at 48 characters, How I work at 42 with its questions breaking to 56. Amended 19 Sep: the spindle ports and the records behind them are gone, the closing statement is set in the opening statement’s face rather than the serif, and Who I am carries 02 in the accent like the three movements below it.'],
  'ab-hv2': ['Selected works · the hover reading', 'HV2 · The Corners', 'Hover a work in the conveyor and it answers with its format, platform, role and year \u2014 one fact in each corner of the frame, in the page\u2019s own corner furniture, with nothing at all in the middle. The frame labels the picture instead of the picture carrying a label. Flat hierarchy on purpose: four facts, four corners, one size, one weight, one tone, because which of them matters is the reader\u2019s business. The four blocks travel 12px in from their own corners and land together at 170ms rather than in a stagger \u2014 a stagger makes the frame assemble, landing together makes it arrive. Measured at 1280\u00d7800: x 76.8 and 1203.2, y 96\u2013135.5 and 664.5\u2013704, clear of the cards, the readout and the running head. A work with only three facts fills the corners in reading order and leaves the last one empty.'],
  'ab-hp1': ['Selected works · the hover reading', 'HP1 · The Plinth', 'The picture gains a base. A hairline exactly as wide as the work, seated in the foot of the frame at the mask’s own 9%, with the reading standing on it — so the panel is not beside the picture or on it but under it, in the one band that is clear of every work at every scroll position. THE COLUMN COUNT COMES FROM THE PICTURE’S OWN WIDTH: repeat(auto-fit, minmax(104px, 1fr)) over the card’s rendered box, so the centred work at 556.3px sets four columns of 128.9 and a 9:16 work at 277.1px sets two of 128.3 and wraps to two rows. Nothing names a ratio and nothing switches on a slug — the same device the stills grid uses on a work page. Label over value, four equal fields, --muted at 6.2:1 over --bone. Motion: the rule draws left to right in 210ms and the four cells rise 7px on a 48ms stagger behind its leading edge, 324ms end to end. The only direction here that touches the readout — it steps back to 0.14 over 140ms rather than being dodged, because the plinth and the instrument want the same band. One declaration to drop if that is not wanted. Clamped into the page margin, so a work hanging off the frame measures the part of it you can see.'],
  'ab-hp2': ['Selected works · the hover reading', 'HP2 · The Overprint', 'No furniture at all: no panel, no scrim, no box, no rule and no labels. Four words set straight onto the photograph in its bottom-left corner, 20px in and 18px up, inside the 5.5% radius the picture’s box carries. THE LABELS ARE GONE, which is the idea and the risk — a format, a platform, a role and a year are each recognisable from their own form, and dropping the names takes the block from eight elements to four and from 66px tall to 38px, which is what lets it sit in the picture rather than become a panel. Order is the only hierarchy. The year is the one figure in the set and carries an 8px accent tick HANGING IN THE MARGIN on a negative margin-left, so the type stays flush and the mark sits outside the column like a printed sidenote. Motion: one clip-path wipe left to right in 190ms — nothing moves, something is uncovered — with the open state slack by 18px on every edge so the text-shadow is not shaved off. The honest cost is contrast: this is the only direction that sets type on a full-brightness still rather than on the ground or the bed, and the two-part shadow is the whole defence.'],
  'ab-hp3': ['Selected works · the hover reading', 'HP3 · The Plumb', 'The pointer draws a line and the line carries a heading. A hairline stands at the pointer’s x for the full opaque height of the frame, y 72 to 728, and the four facts set as ONE LINE at its head in the clear band above every work. TWO CLOCKS, DELIBERATELY: the rule tracks x continuously with no transition — it is under your finger — while the reading SNAPS to the page’s own twelve columns. Measured at 1280, a column is 75.09px and the step between boundaries 95.57, so the type can only start at 76.8, 172.4, 267.9 … 1128.1. The reading takes whichever side of the plumb has room: right by default, snapped to the first boundary 14px clear, and flipping to the left with the slide-in reversed when that would pass the right margin. That needs the line’s width, so this is the ONE direction in the set that fills before it places. One line and not a stack because four stacked pairs would be 194px tall and run into the work band — set as one line the discipline holds: the rule may cross a photograph, the type may not. Motion: transform-origin is the pointer’s own y, so scaleY 0 to 1 over 170ms opens the line up and down from exactly where you are, and the words fade in 7px out of it.'],
  'ab-hp4': ['Selected works · the hover reading', 'HP4 · The Crossing', 'Four rules cross the whole frame and the picture is what they cross. Margin to margin, x 76.8 to 1203.2, four hairlines stacked on the frame’s vertical centre at y 312 to 488, each carrying its label flush left and its value flush right. The work is struck through by its own data. THE LABEL AND THE VALUE ARE 1126px APART, which is the point and not an oversight: this is how a table of contents is set, and the rule is what carries your eye from the name of the thing to the thing. Nothing else in this set asks the reader to travel; here the travelling is the reading. The only direction indifferent to where the picture is — the rules are the page’s, so they are in the same place whichever work you point at. Hierarchy is in the rule’s WEIGHT and not the type’s: the three upper rules are --rule-soft at 7% white and the year’s is --rule at 13%, the only figure getting the only solid line. Motion: each rule scales from its left edge over 190ms on a 28ms stagger, each label fades as its own rule starts, and each value is held 150ms so it appears at the far margin about as the rule reaches it — the reading is carried across rather than switched on. It leaves as one thing, 110ms, no stagger.'],
  'ab-hp5': ['Selected works · the hover reading', 'HP5 · The Slug', 'No new furniture anywhere on the frame. The page already has an instrument that names the work you are looking at — the readout, a caption over a sixteen-tick arc with the year beneath it — and this gives that instrument one more thing to say. Hover a work and the caption line stops being its title and becomes its slug: MICRO DRAMA · SOCIAL-FIRST · SOUND DESIGN · 2025, in the readout’s own voice, on the line the title was on. THE MINIMUM POSSIBLE INTERVENTION, which is the argument for it: not one pixel of the frame changes, there is nothing to place, clamp or collide with, and a visitor who never hovers sees exactly the page that is live today. Against that, it puts the reading furthest from the thing being read — the slug is 584px down the frame whichever work you point at. Values only; the dividers are the page’s accent because on this page the accent marks information, and they are the one part of the line that does NOT wake, so the punctuation belongs to the instrument and the words to the work. Motion: the send action’s own wave at the scale of a fact — --dim to --bone, 200ms apiece on a 60ms stagger, crossing the line in 380ms. A letter-level wave was tried and is wrong at 47 characters: 1.2 seconds is a page turning, not a label answering. The title fades UNDER the slug rather than being rewritten, because paint() writes that node every frame and anything writing to it would lose on the next scroll event.'],
  'ab-hp6': ['Selected works · the hover reading', 'HP6 · The Quarter', 'The grid places the reading, not the picture. Four fields across the head of the frame, each exactly three of the page’s twelve columns, margin to margin — the information is filed where the page says information goes and the work has no say in it. THE ARITHMETIC FALLS OUT EXACTLY, which is why it is four: at 1280 a column is 75.09px, three columns plus two inner gutters is 266.23, and four of those plus three gutters is 1126.36 against a content width of 1126.4. So repeat(4, 1fr) with column-gap: var(--gutter) IS a 3-3-3-3 division of the twelve, at every width, with nothing hardcoded. Each field is ruled: label at 10px, a hairline the full width of the cell, value at 18px — how a specimen sheet is set, so the eye reads across rather than down. It occupies y 72 to 118 and clears the tallest thing the conveyor can produce by 35.6px, so it is the only direction whose panel is placed entirely in CSS with no rect read from the card at all. A three-fact work leaves the fourth field EMPTY rather than redividing: the fields do not grow, because then the same fact would sit in a different place on a different work. Motion: every cell clips open downward and every rule draws from its own left edge, all four together over 200ms, no stagger and no delay anywhere — the deliberate counterpoint to ab-hp8, which stages the same four facts sequentially.'],
  'ab-hp7': ['Selected works · the hover reading', 'HP7 · The Yield', 'The work makes room for its own caption. Every other direction adds a reading to the page; this one takes it out of the picture — the photograph retreats from the foot of its own frame by a quarter of its height and the four facts set in the strip it gives up. THE PHOTOGRAPH IS CLIPPED, THE BOX IS NOT, and that is the whole trick: .st__win carries the 5.5% radius, the 0 40px 90px drop shadow and the #0F0E0D background, so clipping it would delete the picture’s shadow on all four sides. What is clipped is .frame__layer, the stills inside — the box keeps its shadow and its radius and the strip exposes its own lifted ground, so the caption sets at 18.7:1 with no scrim anywhere. The crop is a PERCENTAGE, which is why there is no scale arithmetic: inset(0 0 26% 0) resolves against the layer’s own box, so it is a quarter of the picture whatever the conveyor has scaled it to, and the scroll watcher never touches it. It is a registered @property or it would not animate — an unregistered custom property interpolates discretely and the crop would jump — and the transition lives on .wcard rather than on the layer, because .frame__layer already owns its transition for the scrub crossfade and a shorthand written from the page would kill it on the one work being pointed at. 26% is the smallest crop that holds a two-by-two field on the narrowest work the gate admits, 232.8 x 413.9. Motion: the strip opens over 210ms and the type is held back 90ms and rises 6px, so the room exists before anything is put in it; reversed leaving, type first, so the plate is never briefly empty.'],
  'ab-hp8': ['Selected works · the hover reading', 'HP8 · The Index', 'The reading is numbered and the numbering is the hierarchy. 01 02 03 04 in the page’s accent, flush right against the frame’s right margin, each with its value beside it and no label at all. Nothing is bigger or brighter than anything else; what ranks the four facts is that they are counted. THE PAGE ALREADY COUNTS THINGS THIS WAY — work pages set their recognition as a numbered index, the catalogue numbers every work as a three-digit folio, /about numbers its movements, and the home page’s own sections carry 01, 02, 03 — so this is the direction most obviously made out of parts the site already has. The labels are dropped and the ordinals take their place: two marks per row would be a label and a number doing the same filing job, and the ordinal wins because it also gives the reading an order. Ordinals are in the TEMPLATE rather than written from script, so Astro stamps them with the scope attribute itself. It grows upward from bottom: calc(9% + 10px) and occupies y 616 to 720 at x 1053 to 1203.2 — the quietest quarter of the page, clear of the readout at x 1000 and of every work at the gate. Motion: a TRUE STAGGER, and it is the point — each row travels 8px in from the right over 180ms on a 34ms stagger, settling at 282ms, because a numbered list is the one shape where arriving in order is what the content is already doing. Held against ab-hp6 it is the clearest test in the set of whether a stagger reads as intent or as delay. A three-fact work is numbered 01 02 03 and stops, the opposite decision from ab-hp6 where the empty field holds its place.'],
  'ab-live': ['The site itself', 'The homepage before op1 · 20 Sep 2026', 'A byte-for-byte copy of src/pages/index.astro as it stood immediately before the op1 design was applied, kept so the previous site can be read, compared or restored without going through git. Only two things differ from the original: every relative import is one level deeper, because this sits in preview/, and its header comment. The About movements are .mvt--a2 sections with the live statements and their reveals rather than Swiss posters; there is no pane over the page, so the bed shows only through .ap__mat’s breathing window; the conveyor sits on solid ground; and the bed’s grade is on each of the thirty tiles rather than on the bed. This is the page every draft in this library was measured against.'],
  'ab-live-prior': ['Revert point', 'The live site before 2026-09-22', 'A REVERT POINT, NOT A DESIGN. src/pages/index.astro copied verbatim at commit 2533db9, immediately before four things were applied to it in one pass: the section numbers from ab-sy4, the How I work body layout from ab-fs1, the three step numbers from ab-nm1 and the About body-text drift from ab-mo6. Nothing is changed except what has to be — the eleven relative imports gain one ../ because this file sits a directory deeper, and a header comment is added. Verified byte-exact: undoing those two things reproduces the live file’s sha256 (ea5d8e9e985a70e1). To go back, git show 2533db9:src/pages/index.astro > src/pages/index.astro; this page exists so the previous state can be opened and compared side by side, not because git has lost it.'],
  'ab-wh3e': ['Behind the work, on screen', 'WH3E · The Lintel', 'The heading is exactly the measure — declared as the measure divided by the ink constant rather than as a vw number, so it is as wide as the page’s text column at every width, with .fr’s padding-inline cancelled so it starts on the margin with everything else. 131.24px, 10.253vw, 1126.4px of ink filling the measure exactly at 1280 — 76.80 to 1203.20, both margins met. The lightest bite but one: a fifth of the cap, 19.2px of 95.9, under the stills. A lintel the work stacks against. Variations of ab-wh3, which drops .fr--over to z-index 0 so the stills travel in front of the word: .wcard carries z-index 100 and .fr--over only 6, which looks as though the cards already win — they do not, because .wk__pin is position: sticky and sticky always creates a stacking context, so the cards’ 100 is scoped inside the pin and never competes with the frame. What competes is the pin’s own z-index, which is auto. WHAT AB-WH3 DOES NOT DO, measured at 1280 x 800: its ink runs x 128 to 1439, so 159px is off the screen; and its painted cap band is y 926 to 1036 against a card band starting at 1040, so the word CLEARS the work by four pixels rather than going behind it. That tangency is deliberate — 880 + 40 + 0.78 x 153.6 = 1039.81 against 1040.000 — which is why shrinking alone makes it worse: every one of ab-wh3a to ab-wh3d lifts the baseline further clear. So these push the frame down as well, each naming its bite as a fraction of its own cap: top = 50vh - min(20vh, 13vw) - clamp(30px, 5vh, 66px) - size x (0.78 - 0.731 beta), where the first term is the common card’s own top edge — a card is height: min(40vh, 26vw) x --card-k placed top: 50% and pulled back half its height. That equals 30vh at 1280 x 800 and nowhere else, because 26vw and 40vh cross exactly there; anchored to a flat 30vh the bite measured -11.94px at 1024, the word clear of the work again. The baseline sits 0.78em below the frame’s content top (line-height 0.8 against a 1.20em font box) and the cap is 0.731em. The bite is not uniform across the run, which is the design: --card-k enlarges anything narrower than a square by ratio^-0.75, so a 9:16 work stands 492.7px tall against the common 320 and cuts deeper, through a 277px slice of the word. Every figure quoted is the bite against the common height, twelve of the sixteen works. Scoped above 900px, where the pin is still sticky. The ink constant here is 8.583, not the 8.538 used earlier in this thread: with letter-spacing toggled the layout box moves by 96.77px = 14 x 6.912 exactly, so all fourteen spacings are inside it, and the trailing one pulls the box in 6.912px while the final K still paints out to where it was. One correction they all carry: .fr inherits text-align: center, and the box that centring uses is 0.045em narrower than the ink, because all fourteen spacings sit inside it while the final K still paints out to where the fourteenth began. That puts the painted word 0.0225em — 2.95px here — right of true centre, overhanging the right margin while leaving a gap at the left, on the live page as much as here. padding-right: 0.045em on .fr__t makes the box as wide as the ink again, so what gets centred is what you can see. Nothing else changes — same white, same face, same weight, same -0.045em, same stills and animation.'],
};const pretty = (s: string) =>
  s.replace(/-/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase());

const groups = new Map<string, { slug: string; title: string; note: string }[]>();
for (const slug of pages) {
  const [group, title, note] = NOTES[slug] ?? ['Unfiled', pretty(slug), ''];
  if (!groups.has(group)) groups.set(group, []);
  groups.get(group)!.push({ slug, title, note });
}
---

<Base title="Previews — Ugam Khetani">
  <main class="pv">
    <header class="pv__hd">
      <p class="mono pv__eyebrow">Previews</p>
      <h1 class="pv__t">Drafts</h1>
      <p class="pv__lede">
        Design options built as real pages, to be judged in the browser rather
        than described. Nothing here is on the live site unless it says so.
      </p>
      <p class="mono pv__count">{pages.length} {pages.length === 1 ? 'draft' : 'drafts'}</p>
    </header>

    {[...groups].map(([group, items]) => (
      <section class="pv__grp" aria-label={group}>
        <p class="mono pv__grpname">{group}</p>
        <ul class="pv__list">
          {items.map((it) => (
            <li class="pv__row">
              <a class="pv__a" href={`/preview/${it.slug}`}>
                <span class="pv__name">{it.title}</span>
                <span class="mono pv__slug">{it.slug}</span>
                {it.note && <span class="pv__note">{it.note}</span>}
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}

    <p class="mono pv__back"><a href="/">&larr; Back to the site</a></p>
  </main>
</Base>

<style>
  .pv {
    max-width: min(860px, 100%);
    margin-inline: auto;
    padding: clamp(96px, 15vh, 190px) var(--margin) clamp(80px, 14vh, 180px);
  }
  .pv__eyebrow {
    margin: 0 0 clamp(18px, 3vh, 30px);
    font-size: var(--t-micro); letter-spacing: 0.16em;
    text-transform: uppercase; color: var(--dim);
  }
  .pv__t {
    margin: 0 0 clamp(18px, 3vh, 28px);
    font-family: var(--display); font-weight: 500;
    font-size: clamp(2.4rem, 7vw, 4.2rem); line-height: 1; letter-spacing: -0.03em;
  }
  .pv__lede { margin: 0 0 14px; max-width: 52ch; font-size: var(--t-md); color: var(--bone-dim); }
  .pv__count { margin: 0 0 clamp(56px, 9vh, 110px); font-size: var(--t-micro); color: var(--dim); }

  .pv__grp { margin-bottom: clamp(52px, 8vh, 96px); }
  .pv__grpname {
    margin: 0 0 clamp(14px, 2vh, 20px); padding-bottom: 12px;
    border-bottom: 1px solid var(--rule);
    font-size: var(--t-micro); letter-spacing: 0.16em;
    text-transform: uppercase; color: var(--bone-dim);
  }
  .pv__list { list-style: none; margin: 0; padding: 0; }
  .pv__row { border-bottom: 1px solid var(--rule); }
  .pv__a {
    display: grid; grid-template-columns: minmax(0, 1fr) auto;
    gap: 4px clamp(16px, 3vw, 40px); align-items: baseline;
    padding-block: clamp(16px, 2.4vh, 24px);
    text-decoration: none; color: var(--bone);
  }
  .pv__name { font-size: var(--t-md); }
  .pv__slug { font-size: var(--t-micro); color: var(--dim); text-align: right; }
  .pv__note {
    grid-column: 1 / -1; max-width: 60ch;
    font-size: var(--t-sm); color: var(--bone-dim); line-height: 1.5;
  }
  .pv__a:hover .pv__name { text-decoration: underline; text-underline-offset: 4px; }
  .pv__a:hover .pv__slug { color: var(--bone-dim); }

  .pv__back { margin: 0; font-size: var(--t-micro); }
  .pv__back a { color: var(--dim); text-decoration: none; }
  .pv__back a:hover { color: var(--bone); }
</style>
