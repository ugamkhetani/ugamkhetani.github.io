---
/**
 * THE PREVIEW INDEX — one page that lists every draft.
 *
 * The library used to be 71 pages with no way in except a URL you had to
 * remember, and it was deleted partly for that. This is the way back in: any
 * .astro file dropped in this folder appears here on the next build, with no
 * list to keep in step.
 *
 * DISCOVERY IS A GLOB, NOT A TABLE. `import.meta.glob` is evaluated at build
 * time and is eager: false, so nothing here loads a draft's module — only its
 * path is read. A draft that is deleted stops being listed because the file is
 * gone, which is the only kind of index that cannot go stale.
 *
 * The glob is case-sensitive, as it is in src/lib/frames.ts (HANDOFF §6), but
 * every page in this folder is lowercase .astro so one pattern is enough.
 *
 * NOTES ARE OPTIONAL. A slug with no entry in NOTES still lists, under a title
 * derived from its filename — so adding a draft never means editing this file,
 * and writing a note is a courtesy rather than a requirement.
 */
import Base from '../../layouts/Base.astro';

const pages = Object.keys(import.meta.glob('./*.astro', { eager: false }))
  .map((p) => p.replace('./', '').replace('.astro', ''))
  .filter((s) => s !== 'index')
  .sort();

/** slug → [group, title, note]. Anything missing falls back to its filename. */
const NOTES: Record<string, [string, string, string]> = {
  'ab-d1': ['About · D · Poster — variations', 'D1 · Justified', 'Every movement’s name is SVG text fitted to the full measure, so it is flush at both margins at any width — and the grid is drawn, eleven hairlines on the real column boundaries, so the type can be seen meeting it. Fitting to a fixed measure sets the short titles large and the long ones small; that difference is the composition.'],
  'ab-d2': ['About · D · Poster — variations', 'D2 · Traverse', 'The whole poster travels, not just the word: each movement pins and its sheet moves sideways — name, statement, reading, each a screen wide — while the giant name counter-moves at a third of the rate, so type and page separate as it goes. Costs length: about twice D’s height.'],
  'ab-d3': ['About · D · Poster — variations', 'D3 · Window', 'The names are cut rather than printed: a plate of the site’s ground with the letterforms knocked out, over transparent sections, so the catalogue shows through the type. The bed only appears inside the page’s aperture, so a word fills with picture as it crosses the window and empties as it leaves.'],
  'ab-g': ['About · redesigned again, palette unchanged', 'G · Specimen', 'The About section as a type specimen of the site’s own serif. Every block is labelled in the margin with the settings it is really set in, and Who I am descends the optical size axis over five paragraphs — 46px down to 18px, opsz 96 down to 20 — so the section opens at display size and settles into reading size.'],
  'ab-h': ['About · redesigned again, palette unchanged', 'H · Plate', 'Drawn as a technical plate: a ruled sheet with the title block in its corner, a dimension line under the statement, dashed leaders running out to each annotation, three assemblies with their parts, and the method as a signal chain — three stages joined by a rule with an arrowhead. IBM Plex Sans and Mono.'],
  'ab-i': ['About · redesigned again, palette unchanged', 'I · Subtitle', 'The page is already a film, so the About section becomes the thing you watch the catalogue with: sections go transparent, the wall of stills shows through, and the writing arrives one caption at a time in the lower third. Scrolling is the transport. Costs length — About runs about two and a half times taller.'],
  'ab-j': ['About · redesigned again, palette unchanged', 'J · Spine', 'The movement’s name set down the edge of the page like the spine of a book and held there while it is read, everything else hanging to the right of one hairline. The hairline carries a tick whose position is that movement’s own scroll progress — the spine is also its scrollbar. Big Shoulders Display and Literata.'],
  'ab-k': ['About · redesigned again, palette unchanged', 'K · Stack', 'Four cards that stack: each sticks to the top and the next slides over it, leaving its number and title showing, so by the last movement the screen carries the whole About section as a row of tabs. Layout rather than animation. Bricolage Grotesque, the least neutral face here, against Spectral.'],
  'ab-l': ['About · redesigned again, palette unchanged', 'L · Clause', 'Set as a document: one family — the site’s own mono — one measure, hard left, no display type anywhere, and every line numbered as a clause, 02.0 through 05.1. The most reduced of the twelve, and reduced towards record rather than towards space.'],
  'ab-a': ['About · redesigned from scratch', 'A · Credits', 'Set as a film’s end credits: one centre axis on pure black, labels right of it and entries left, prose as centred cards in Archivo’s condensed width. The last card — “The work should sound like itself.” — holds on screen for 70vh before contact arrives, the way every film’s final card does.'],
  'ab-b': ['About · redesigned from scratch', 'B · Score', 'Engraved as the opening pages of a full score in EB Garamond. What I work across becomes the instrumentation page — three families bracketed down the margin, fifteen staves drawing in — How I work is three movements between barlines, and the section ends on a final double barline.'],
  'ab-c': ['About · redesigned from scratch', 'C · Silence', '“The weight of a silence” as a layout: the one pale page in a dark site. Cool paper, graphite Jost at three sizes, each thought placed off-axis with long empty space between, How I work descending as a stair, nothing moving. It ends on one line at the centre of an empty screen.'],
  'ab-d': ['About · redesigned from scratch', 'D · Poster', 'Swiss posters in the site’s own grotesk: each movement’s name so large the screen crops it, panning sideways as you scroll past, over a strict twelve-column grid. Monochrome — the only colour is the site’s orange on the full stops.'],
  'ab-e': ['About · redesigned from scratch', 'E · Feature', 'A magazine profile: Bodoni Moda headlines at full optical size, Newsreader for reading, a mono folio and margin, a drop cap, a double-ruled fact box, and step one’s three questions lifted into a pull quote across the spread. It ends on a tombstone.'],
  'ab-f': ['About · redesigned from scratch', 'F · Sleeve', 'Packaged as an LP: square sleeves hung over the wall of stills — orange gothic cover type, liner notes, a tracklist — a gatefold for How I work, and the closing line set round a record label that turns as you scroll. The only draft that keeps the bed visible.'],
};

const pretty = (s: string) =>
  s.replace(/-/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase());

const groups = new Map<string, { slug: string; title: string; note: string }[]>();
for (const slug of pages) {
  const [group, title, note] = NOTES[slug] ?? ['Unfiled', pretty(slug), ''];
  if (!groups.has(group)) groups.set(group, []);
  groups.get(group)!.push({ slug, title, note });
}
---

<Base title="Previews — Ugam Khetani">
  <main class="pv">
    <header class="pv__hd">
      <p class="mono pv__eyebrow">Previews</p>
      <h1 class="pv__t">Drafts</h1>
      <p class="pv__lede">
        Design options built as real pages, to be judged in the browser rather
        than described. Nothing here is on the live site unless it says so.
      </p>
      <p class="mono pv__count">{pages.length} {pages.length === 1 ? 'draft' : 'drafts'}</p>
    </header>

    {[...groups].map(([group, items]) => (
      <section class="pv__grp" aria-label={group}>
        <p class="mono pv__grpname">{group}</p>
        <ul class="pv__list">
          {items.map((it) => (
            <li class="pv__row">
              <a class="pv__a" href={`/preview/${it.slug}`}>
                <span class="pv__name">{it.title}</span>
                <span class="mono pv__slug">{it.slug}</span>
                {it.note && <span class="pv__note">{it.note}</span>}
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}

    <p class="mono pv__back"><a href="/">&larr; Back to the site</a></p>
  </main>
</Base>

<style>
  .pv {
    max-width: min(860px, 100%);
    margin-inline: auto;
    padding: clamp(96px, 15vh, 190px) var(--margin) clamp(80px, 14vh, 180px);
  }
  .pv__eyebrow {
    margin: 0 0 clamp(18px, 3vh, 30px);
    font-size: var(--t-micro); letter-spacing: 0.16em;
    text-transform: uppercase; color: var(--dim);
  }
  .pv__t {
    margin: 0 0 clamp(18px, 3vh, 28px);
    font-family: var(--display); font-weight: 500;
    font-size: clamp(2.4rem, 7vw, 4.2rem); line-height: 1; letter-spacing: -0.03em;
  }
  .pv__lede { margin: 0 0 14px; max-width: 52ch; font-size: var(--t-md); color: var(--bone-dim); }
  .pv__count { margin: 0 0 clamp(56px, 9vh, 110px); font-size: var(--t-micro); color: var(--dim); }

  .pv__grp { margin-bottom: clamp(52px, 8vh, 96px); }
  .pv__grpname {
    margin: 0 0 clamp(14px, 2vh, 20px); padding-bottom: 12px;
    border-bottom: 1px solid var(--rule);
    font-size: var(--t-micro); letter-spacing: 0.16em;
    text-transform: uppercase; color: var(--bone-dim);
  }
  .pv__list { list-style: none; margin: 0; padding: 0; }
  .pv__row { border-bottom: 1px solid var(--rule); }
  .pv__a {
    display: grid; grid-template-columns: minmax(0, 1fr) auto;
    gap: 4px clamp(16px, 3vw, 40px); align-items: baseline;
    padding-block: clamp(16px, 2.4vh, 24px);
    text-decoration: none; color: var(--bone);
  }
  .pv__name { font-size: var(--t-md); }
  .pv__slug { font-size: var(--t-micro); color: var(--dim); text-align: right; }
  .pv__note {
    grid-column: 1 / -1; max-width: 60ch;
    font-size: var(--t-sm); color: var(--bone-dim); line-height: 1.5;
  }
  .pv__a:hover .pv__name { text-decoration: underline; text-underline-offset: 4px; }
  .pv__a:hover .pv__slug { color: var(--bone-dim); }

  .pv__back { margin: 0; font-size: var(--t-micro); }
  .pv__back a { color: var(--dim); text-decoration: none; }
  .pv__back a:hover { color: var(--bone); }
</style>
