---
/**
 * THE PREVIEW INDEX — one page that lists every draft.
 *
 * The library used to be 71 pages with no way in except a URL you had to
 * remember, and it was deleted partly for that. This is the way back in: any
 * .astro file dropped in this folder appears here on the next build, with no
 * list to keep in step.
 *
 * DISCOVERY IS A GLOB, NOT A TABLE. `import.meta.glob` is evaluated at build
 * time and is eager: false, so nothing here loads a draft's module — only its
 * path is read. A draft that is deleted stops being listed because the file is
 * gone, which is the only kind of index that cannot go stale.
 *
 * The glob is case-sensitive, as it is in src/lib/frames.ts (HANDOFF §6), but
 * every page in this folder is lowercase .astro so one pattern is enough.
 *
 * NOTES ARE OPTIONAL. A slug with no entry in NOTES still lists, under a title
 * derived from its filename — so adding a draft never means editing this file,
 * and writing a note is a courtesy rather than a requirement.
 */
import Base from '../../layouts/Base.astro';

const pages = Object.keys(import.meta.glob('./*.astro', { eager: false }))
  .map((p) => p.replace('./', '').replace('.astro', ''))
  .filter((s) => s !== 'index')
  .sort();

/** slug → [group, title, note]. Anything missing falls back to its filename. */
const NOTES: Record<string, [string, string, string]> = {
  'aasha-order-a': ['Work page \u00b7 section order', 'A \u00b7 Direct', 'The smallest change: credits move from last to second. Film, credits, score, stills, watch \u2014 nothing else touched.'],
  'aasha-order-b': ['Work page \u00b7 section order', 'B \u00b7 Paired', 'Credits move up and the watch link comes with the film, since it is the film\u2019s action. The page then ends on the stills.'],
  'aasha-order-c': ['Work page \u00b7 section order', 'C \u00b7 Split', 'Credits move up and recognition comes with them \u2014 record filed with record, leaving the score as pure prose.'],
  'mst-sub-a': ['Mumbai Standard Time \u00b7 subheading', 'A \u00b7 Dateline', 'The rule carries the width so the type does not have to. Still 10px, but three short marks hung on a drawn edge instead of one long bar of text.'],
  'mst-sub-b': ['Mumbai Standard Time \u00b7 subheading', 'B \u00b7 Column', 'Narrow and tall instead of wide and thin. The only draft that shrinks the type \u2014 9px \u2014 which it can afford because each line is short.'],
  'mst-sub-c': ['Mumbai Standard Time \u00b7 subheading', 'C \u00b7 Index', 'The colophon treatment from the foot of the page brought to the head, so the two rhyme. Labels are the schema\u2019s own field names, not new words.'],
  'mst-sub-d': ['Mumbai Standard Time \u00b7 subheading', 'D \u00b7 Punched rule', 'Same words, same size, same dots \u2014 but a hairline runs the measure through them and the type sits in a gap punched in it.'],
  'mst-sub-e': ['Mumbai Standard Time \u00b7 subheading', 'E \u00b7 Hairlines', 'Middots become drawn 1px verticals and the tracking opens to 0.3em. A dot joins the words into one bar; a hairline cuts them into three marks.'],
  'mst-sub-f': ['Mumbai Standard Time \u00b7 subheading', 'F \u00b7 Split', 'The shortest line of the six: the year leaves it and goes up beside the folio, where a magazine puts its date. Discipline only, in two tones.'],
  'mst-sub-g': ['Mumbai Standard Time \u00b7 subheading, no slash', 'G \u00b7 Serial', 'Space divides the three facts, a comma divides the three roles \u2014 two levels of separation, not one glyph spent on either.'],
  'mst-sub-h': ['Mumbai Standard Time \u00b7 subheading, no slash', 'H \u00b7 Credit block', 'The separator is the line break. It also settles what makes a slash tempting: \u201cVoice Over\u201d is two words, and on its own line it cannot be misread.'],
  'mst-sub-i': ['Mumbai Standard Time \u00b7 subheading, no slash', 'I \u00b7 Ampersand', 'The serial form \u2014 commas, then an ampersand \u2014 the one separator that tells you the list has ended. Hierarchy inverted: craft up, filing down.'],
  'mst-sub-j': ['Mumbai Standard Time \u00b7 subheading, no slash', 'J \u00b7 Hairline roles', 'The drawn hairline moves to where the slash was. A 7px rule has no baseline and no weight, so it cannot be read as a character.'],
  'mst-sub-k': ['Mumbai Standard Time \u00b7 subheading, no slash', 'K \u00b7 Register', 'The separator is the typeface. Filing stays mono caps; the craft moves to Fraunces italic in sentence case, where a comma is just how a list is written.'],
  'mst-sub-l': ['Mumbai Standard Time \u00b7 subheading, no slash', 'L \u00b7 Bracket', 'The separator is the enclosure \u2014 the site\u2019s own bracket, the mark the menu sets around \u201c( Ugam Khetani )\u201d. Inside it a middot is enough.'],
  'mst-sub-j1': ['Mumbai Standard Time \u00b7 J, folio removed', 'J1 \u00b7 Overhead', 'Category and year take the slot the folio just vacated, so the head loses a line rather than gaining one. Context above, craft below.'],
  'mst-sub-j2': ['Mumbai Standard Time \u00b7 J, folio removed', 'J2 \u00b7 Left mark', 'They leave the centre column and hang in the empty field to its left, aligned with the top of the title \u2014 a magazine\u2019s issue line. 183px of that field is sitting unused at 1280.'],
  'mst-sub-j3': ['Mumbai Standard Time \u00b7 J, folio removed', 'J3 \u00b7 Under', 'Nothing above the title at all. Both facts move below it, craft first at 10px and the filing under it at 9px. The only one with a clear top edge.'],
};

const pretty = (s: string) =>
  s.replace(/-/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase());

const groups = new Map<string, { slug: string; title: string; note: string }[]>();
for (const slug of pages) {
  const [group, title, note] = NOTES[slug] ?? ['Unfiled', pretty(slug), ''];
  if (!groups.has(group)) groups.set(group, []);
  groups.get(group)!.push({ slug, title, note });
}
---

<Base title="Previews — Ugam Khetani">
  <main class="pv">
    <header class="pv__hd">
      <p class="mono pv__eyebrow">Previews</p>
      <h1 class="pv__t">Drafts</h1>
      <p class="pv__lede">
        Design options built as real pages, to be judged in the browser rather
        than described. Nothing here is on the live site unless it says so.
      </p>
      <p class="mono pv__count">{pages.length} {pages.length === 1 ? 'draft' : 'drafts'}</p>
    </header>

    {[...groups].map(([group, items]) => (
      <section class="pv__grp" aria-label={group}>
        <p class="mono pv__grpname">{group}</p>
        <ul class="pv__list">
          {items.map((it) => (
            <li class="pv__row">
              <a class="pv__a" href={`/preview/${it.slug}`}>
                <span class="pv__name">{it.title}</span>
                <span class="mono pv__slug">{it.slug}</span>
                {it.note && <span class="pv__note">{it.note}</span>}
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}

    <p class="mono pv__back"><a href="/">&larr; Back to the site</a></p>
  </main>
</Base>

<style>
  .pv {
    max-width: min(860px, 100%);
    margin-inline: auto;
    padding: clamp(96px, 15vh, 190px) var(--margin) clamp(80px, 14vh, 180px);
  }
  .pv__eyebrow {
    margin: 0 0 clamp(18px, 3vh, 30px);
    font-size: var(--t-micro); letter-spacing: 0.16em;
    text-transform: uppercase; color: var(--dim);
  }
  .pv__t {
    margin: 0 0 clamp(18px, 3vh, 28px);
    font-family: var(--display); font-weight: 500;
    font-size: clamp(2.4rem, 7vw, 4.2rem); line-height: 1; letter-spacing: -0.03em;
  }
  .pv__lede { margin: 0 0 14px; max-width: 52ch; font-size: var(--t-md); color: var(--bone-dim); }
  .pv__count { margin: 0 0 clamp(56px, 9vh, 110px); font-size: var(--t-micro); color: var(--dim); }

  .pv__grp { margin-bottom: clamp(52px, 8vh, 96px); }
  .pv__grpname {
    margin: 0 0 clamp(14px, 2vh, 20px); padding-bottom: 12px;
    border-bottom: 1px solid var(--rule);
    font-size: var(--t-micro); letter-spacing: 0.16em;
    text-transform: uppercase; color: var(--bone-dim);
  }
  .pv__list { list-style: none; margin: 0; padding: 0; }
  .pv__row { border-bottom: 1px solid var(--rule); }
  .pv__a {
    display: grid; grid-template-columns: minmax(0, 1fr) auto;
    gap: 4px clamp(16px, 3vw, 40px); align-items: baseline;
    padding-block: clamp(16px, 2.4vh, 24px);
    text-decoration: none; color: var(--bone);
  }
  .pv__name { font-size: var(--t-md); }
  .pv__slug { font-size: var(--t-micro); color: var(--dim); text-align: right; }
  .pv__note {
    grid-column: 1 / -1; max-width: 60ch;
    font-size: var(--t-sm); color: var(--bone-dim); line-height: 1.5;
  }
  .pv__a:hover .pv__name { text-decoration: underline; text-underline-offset: 4px; }
  .pv__a:hover .pv__slug { color: var(--bone-dim); }

  .pv__back { margin: 0; font-size: var(--t-micro); }
  .pv__back a { color: var(--dim); text-decoration: none; }
  .pv__back a:hover { color: var(--bone); }
</style>
