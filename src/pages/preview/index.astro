---
/**
 * THE PREVIEW INDEX — one page that lists every draft.
 *
 * The library used to be 71 pages with no way in except a URL you had to
 * remember, and it was deleted partly for that. This is the way back in: any
 * .astro file dropped in this folder appears here on the next build, with no
 * list to keep in step.
 *
 * DISCOVERY IS A GLOB, NOT A TABLE. `import.meta.glob` is evaluated at build
 * time and is eager: false, so nothing here loads a draft's module — only its
 * path is read. A draft that is deleted stops being listed because the file is
 * gone, which is the only kind of index that cannot go stale.
 *
 * The glob is case-sensitive, as it is in src/lib/frames.ts (HANDOFF §6), but
 * every page in this folder is lowercase .astro so one pattern is enough.
 *
 * NOTES ARE OPTIONAL. A slug with no entry in NOTES still lists, under a title
 * derived from its filename — so adding a draft never means editing this file,
 * and writing a note is a courtesy rather than a requirement.
 */
import Base from '../../layouts/Base.astro';

const pages = Object.keys(import.meta.glob('./*.astro', { eager: false }))
  .map((p) => p.replace('./', '').replace('.astro', ''))
  .filter((s) => s !== 'index')
  .sort();

/** slug → [group, title, note]. Anything missing falls back to its filename. */
const NOTES: Record<string, [string, string, string]> = {
  'ab-fh5': ['About · ab-fv8, process at scale', 'FH5 · Hanging Display', 'FV8’s idea at the size FV8 should have used. Same display face, same uppercase, same −0.045em — the page’s own way of naming a movement — but at 2.63 times the body instead of 1.65: 40.8px against 15.5px. At that scale the tight tracking stops reading as a label’s device and starts reading as what it is on the frame above. The names sit flush left and the prose indents three characters under them, so the left edge of the section is three large names and nothing else. No rules, no numbers, no boxes: one alignment, held.'],
  'ab-fitlive': ['About · Blends', 'Fit · with the live frame', 'Blend 1b · Fit with its fitted SVG titles replaced by the live site’s own heading apparatus, lifted whole: the movement number and name at the top left, the place at the top right, the folio and year range at the bottom left, Selected works and the scroll cue at the bottom right, and the name again at size in the middle. Everything below the frame is Fit’s — the live statements and their reveals, the prose at 48 characters, How I work at 42 with its questions breaking to 56. Amended 19 Sep: the spindle ports and the records behind them are gone, the closing statement is set in the opening statement’s face rather than the serif, and Who I am carries 02 in the accent like the three movements below it.'],
  'ab-blend1': ['About · Blends', 'Blend 1 · Pin, with the live statements', 'P2j · Pin throughout — the cropped panning names, the 26px spindle-hole port onto a 1400px record, the centred prose, What I work across and How I work — with the Who I am and closing statements taken from the live site as its own markup, not a copy of its styling. So they arrive the way they do on the site: each line rising out of an overflow-hidden box, the closing one word at a time, 70ms apart. Two clocks on one page — the site’s reveal, which fires once, and P2j’s scroll-driven turn and pan, which run throughout.'],
  'ab-p2j': ['About · P2 · Port, centred text — eight', 'P2j · Pin', 'The smallest port there is: 26 pixels across, onto a record 54 times its width, clipped to the hole so you cannot see how big it is. At that size the arc is nearly straight, so what reads is fine parallel lines travelling. Type: the live page’s own Fraunces italic, kept exactly — the draft the others are measured against.'],
  'ab-d': ['About · redesigned from scratch', 'D · Poster', 'Swiss posters in the site’s own grotesk: each movement’s name so large the screen crops it, panning sideways as you scroll past, over a strict twelve-column grid. Monochrome — the only colour is the site’s orange on the full stops.'],
  'ab-ms1': ['About · ab-d, with the bed showing', 'MS1 · Headland', 'The ground retreats to the reading matter: each poster’s slab starts at the twelve-column rule and runs down, and above that rule there is nothing but catalogue with the giant word set straight onto it. The poster already divides itself into a word meant to be cropped by the screen and a grid meant to be read; those halves want different grounds and ab-d gave them the same one. It costs nothing in readability — a 27vw headline on the worst pixel the bed can produce is 8.4:1. Measured at the top of a poster, 43 per cent of the viewport is bed. And the pan becomes a parallax: the word travels 24vw on its view timeline while the bed behind it drifts 8 per cent on --prog, so it slides ACROSS the catalogue rather than with it.'],
  'ab-ms2': ['About · ab-d, with the bed showing', 'MS2 · The Join', 'Every poster keeps its solid ground and its full bleed — nothing is ever read on a photograph — but the posters stop touching, and a band of catalogue opens between each one and the next. ab-d’s aperture had this idea and put it in the wrong place: it opened the window as a movement arrived and narrowed it at the joins, so the catalogue was most visible exactly where you were trying to read. This inverts it. The band runs on the section’s own view timeline, --band registered as a length so it interpolates instead of snapping at halfway; driven to its keyframes it reads 72px, 0, 0, 72px, and the corridor between consecutive posters measures 144px open.'],
  'ab-ms3': ['About · ab-d, with the bed showing', 'MS3 · Smoked', 'The bed visible everywhere, through everything — the whole About run becomes one translucent pane at 55 per cent ground with a 7px backdrop blur. No windows, no bands, no slabs. The arithmetic is why it is allowed: ab-d caps the bed at brightness 0.30 so the brightest pixel a photograph can put on screen is #4C4C4C, and composited the worst background under any word here is rgb(34,34,34). Measured against that: white 15.87:1, bone-dim 11.13:1, the orange full stop 4.56:1. I lifted the 12px labels off ab-d’s grey expecting it to fail and it would not have — 5.71:1 — so that change is recorded as a taste, not a fix.'],
  'ab-ms4': ['About · ab-d, with the bed showing', 'MS4 · Spine', 'The catalogue becomes a fixed vertical column down the right edge, full height, always there — the work running past like sprocket holes down a film strip. This one keeps .ap__mat and repurposes it: the mat paints ground outward from its inset with a 100vmax box-shadow, so four numbers turn a centred breathing window into a right-hand slot, with no new element and no seams to keep in register. The grid keeps all twelve columns but the slab stops on the spine’s inner edge; the only thing that crosses it is the giant word, which is meant to be cropped and is now cropped by the catalogue instead of the viewport. 108px at 1280, 53 at 375, overlap zero at both.'],
  'ab-ct1': ['About · ms3 carried through', 'CT1 · The Sixth Poster', 'Contact stops being a different kind of page and becomes movement 06 of the same run — giant cropped word, twelve-column rule, the 06 / place / range label row, and the component’s own “Let’s talk.” promoted to statement scale. The simplest answer to the brief, built first so the others had something to beat: nothing here is invented, it all existed in ab-d’s poster language. The orange full stop had to move. It belongs on a statement, but the component writes the period inside its text node with no span to colour, and drawing it with ::before over a font-size: 0 parent — which is what I did first — leaves the real text in the accessibility tree and announces the phrase twice. It is on the giant word instead, which is this page’s own markup.'],
  'ab-ct2': ['About · ms3 carried through', 'CT2 · The Directory', 'The giant word is “Enquiries” — ab-d’s own corner cue for this movement, taken from the page rather than invented — and the three ways to reach him are the biggest type in the section, each at 56.32px on its own line, each closing on the orange stop. Most contact pages put a form first and the address in small print, which is the wrong way round for someone who already knows what they want to say; this one is answerable in a glance and a copy. “Let’s talk.” drops to the label register to make room, because the addresses are the headline. The form is still there in full, just no longer the loudest thing.'],
  'ab-ct3': ['About · ms3 carried through', 'CT3 · The Address', 'The giant panning word is the email address itself. Every other poster sets its movement’s name at architectural scale and lets the screen crop it; the last movement’s name is not “Contact”, it is khetaniugam@gmail.com, and setting it at 9.2vw is the most literal reading of the poster grammar this page has — and the only one where the cropped word is also a link, so it gets its own focus ring rather than one drawn off-screen with it. The component’s own email line is dropped with display: none rather than hidden visually: measured, five mailto links in the DOM and four exposed, because a screen reader announcing the address twice is the same fault in another medium.'],
  'ab-ct4': ['About · ms3 carried through', 'CT4 · The Colophon', 'The one draft that does not open another room. Contact is set as a printer’s colophon at the foot of the document: the giant word ranged RIGHT against the run’s left-flush everything-else, and the section in three columns — statement, channels, form — reading across rather than down. Four posters have opened flush left; a fifth that does the same reads as a continuation, one that turns to the other margin reads as the end, and it costs one text-align. The pan reverses with it: ab-d’s words run 6vw right to 18vw left, which pulls a left-flush word into the page, so this one runs −6vw to +18vw and pulls off the right edge. The base’s keyframe, mirrored.'],
  'ab-rc1': ['About · ms3 refined', 'RC1 · The Rule', 'The least that makes Contact belong, and the benchmark the other three have to beat. The twelve-column rule opens the section and the 06 / place / range label row sits under it, exactly as on the four posters above; below that the component’s own composition is left entirely alone — sticky left column at min-height 80vh, form right, hairline down the gutter — and only the labels change face, from the mono to the poster’s 12px display grey. Worth knowing before adding anything: most of the discontinuity was the corner frame and the bordered panel, not the section. Strip those two and change the label face and it already reads as movement 06.'],
  'ab-rc2': ['About · ms3 refined', 'RC2 · The Ledger', 'RC1, and then the three channels stop being a wrapped row of links and become a ledger — one per line, label left at 12px, value right, a hairline under each. ab-d already sets data this way: .s__col li is a flex row with a bottom hairline, and it is how the What I work across columns are built. It also fixes something the wrap was doing quietly — measured on RC1, the three channels sit on two rows, 2 + 1, which puts the phone number alone on a second line and makes the group read as two things rather than three.'],
  'ab-rc3': ['About · ms3 refined', 'RC3 · Numbered', 'The continuity is put in the form rather than the head. The right column’s questions take the poster’s step treatment — number in the label register, question at 25.92px, a hairline opening each — which is how How I work sets its three steps two sections above. The head is one statement and three links and was never what made this section read as a different page; the form is seventy-odd words of interface and two thirds of the section’s height, and it was the only part still set entirely in another voice. The numbers are the form’s own 01/02/03 in the grey label register, not the orange step numerals that were removed from How I work.'],
  'ab-rc4': ['About · ms3 refined', 'RC4 · Asymmetry', 'The left and right stay; what changes is where the fold between them falls. The component splits its page 1fr 1fr, and the posters above never split anything in half — .po-body runs 5 / -1, .po-state 1 / span 10, the label row 1–2, 4–6, 7–9. A half is the one proportion a twelve-column grid cannot express. Re-split 5 / 7, measured at 447:625, which is 41.7 per cent and a real gridline. And .divide had to follow: it is positioned at left: 50% with a comment explaining the gutter runs 693–747 at 1440, so at the new ratio it would have been drawn straight through the form’s first column. Moved by the same arithmetic the grid uses.'],
  'ab-tr1': ['About · one pane, four arrivals', 'TR1 · Dissolve', 'The bed goes soft before it goes dark. Both halves of the smoke move across the same scroll on different curves: the blur is at full 7px by 55 per cent of the range while the ground is still only two fifths in — measured, 0.4 at the moment the blur finishes. The catalogue defocuses first and settles into shadow after, which is what a lens does. A pane whose opacity and blur rise together reads as a sheet of glass sliding in front of the page; separating them reads as the page itself changing state, and it costs one extra keyframe list.'],
  'ab-tr2': ['About · one pane, four arrivals', 'TR2 · Blind', 'The smoke is at full strength from the first frame — 55 per cent and 7px, never interpolated — and what moves is WHERE it is drawn. A gradient mask runs down the pane, its edge driven by scroll from −28 per cent to 100, so the smoke descends the viewport like a blind being lowered, with a 26 per cent soft edge so no hard line travels down the screen. A fade changes the whole page at once and has no direction; this has one, and it is the direction the reader is already moving in. The bed stays sharp below the edge while it scrolls, which a crossfade cannot do. The mask catches the backdrop-filter as well as the ground, so both stop at the same edge.'],
  'ab-tr3': ['About · one pane, four arrivals', 'TR3 · Iris', 'A radial mask holds one circular opening in the pane. At the top of the page the opening is larger than the screen, so nothing is covered and the catalogue is at full strength behind the name; as you scroll it contracts past the corners, past the edges, and seals in the middle — 150 per cent to 0 with an 18 per cent soft edge, so the closing ring is a gradient and never a drawn circle. ab-d already had this vocabulary and called it Aperture IV, a mat with one centred window breathing on --lit. That window rationed the catalogue and was retired when the smoke replaced it; this brings the gesture back as the transition rather than as the state. Centred on 50 / 42 so it seals on the name.'],
  'ab-tr4': ['About · one pane, four arrivals', 'TR4 · Two Stage', 'One transition, two moves, and a held beat between them. The blur arrives first and finishes early, over the opening’s exit; then nothing happens for 208px of scroll; then the ground arrives, over the conveyor’s entry. The catalogue softens while you are still on the name, holds there out of focus and at full brightness, and only darkens once the work is on screen. Every other draft here treats the transition as one event of some shape; this treats it as two with a pause, and the pause is what gives them meaning — the soft-focus hold says the catalogue is still the subject, the later darkening says it has become the ground for something else. The only one that finishes during the works section rather than before it.'],
  'ab-op1': ['About · TR1 made cheap to scroll', 'OP1 · Cautious', 'TR1 with the blur moved off the backdrop and onto the bed, and the tile grade collapsed to one filter. Identical at every scroll position — same 55 per cent ground, same 7px blur, same dissolve with the blur leading. What changed is where the work happens. backdrop-filter means “blur whatever is behind me right now”, and what was behind it is a bed whose transform is rewritten every frame by --prog, so 4.1 million pixels at 1280×800 on a 2× display were re-blurred from scratch every frame, forever. A filter on an element is rasterised once into a texture the compositor reuses; moving it afterwards is free. Measured, page-wide filtered elements drop from 183 to 155 — the 29 redundant tile surfaces — and the one BED_GRADE names keeps its own, cancelled back with contrast(0.952381) because contrast composes multiplicatively.'],
  'ab-op2': ['About · TR1 made cheap to scroll', 'OP2 · Aggressive', 'OP1, plus two things that do change the look slightly. The blur radius drops 7px to 4px — blur cost rises faster than linearly with radius, and at brightness 0.30 behind a 55 per cent ground the difference is very hard to see, which is the point of trying it. And a capability gate drops the blur entirely, leaving the ground alone, under prefers-reduced-motion, below 900px, or when the device reports four or fewer cores or 4GB or less of memory — set by an inline script before first paint so the expensive state is never shown and then taken away. Verified: 4px normally, grade-only when gated, and grade-only at 375px.'],
  'ab-op3': ['About · TR1 made cheap to scroll', 'OP3 · Everything', 'All six changes, including the one that costs a design decision: Selected works takes its opaque ground back, which is what ab-d did on purpose — “the conveyor IS the catalogue; it must not have the catalogue behind it.” It is driven by --smoke rather than set flat, so the dissolve still plays through it and it resolves to 100 per cent of ground where the others take 55; once opaque, the browser can stop painting the bed behind 8736px of page. Also here: the conveyor’s grade moves from each image to the card — every card holds TEN frames, all display:block with one at opacity 1, which is the correction to my having counted only the visible one — with its hover, focus-within and is-active states rebuilt, since frames.ts sets is-active where there is no pointer and losing it would have regressed the grade on phones. And the handler’s last layout reads go, offsets cached and re-derived from scrollY, invalidated on resize, load and fonts.ready. Page-wide filtered surfaces: 183 on TR1, 155 on OP1, 51 here. The cost is the mosaic behind the works.'],
  'ab-live': ['The site itself', 'The homepage before op1 · 20 Sep 2026', 'A byte-for-byte copy of src/pages/index.astro as it stood immediately before the op1 design was applied, kept so the previous site can be read, compared or restored without going through git. Only two things differ from the original: every relative import is one level deeper, because this sits in preview/, and its header comment. The About movements are .mvt--a2 sections with the live statements and their reveals rather than Swiss posters; there is no pane over the page, so the bed shows only through .ap__mat’s breathing window; the conveyor sits on solid ground; and the bed’s grade is on each of the thirty tiles rather than on the bed. This is the page every draft in this library was measured against.'],
  'ab-sw1': ['The whole scroll, in one world', 'SW1 · One Voice', 'The shared correction and nothing else, built first so the others have something to beat. Three families become one: every corner label, readout and card role leaves JetBrains Mono for the poster’s own label — display face, 12px, 0.005em, sentence case, --po-grey — and the opening statement’s accented words leave Fraunces italic and keep only the accent colour. Counted, not guessed: correcting the obvious labels still left THIRTY-FOUR elements setting in mono, four of them the running head, which is fixed on screen for the entire scroll. It is now one, and the one that stays is .peek__body, the composed email quoted back to the sender, where monospace is what the thing IS. Nothing moves; only the voices collapse.'],
  'ab-sw2': ['The whole scroll, in one world', 'SW2 · Every Movement Opens The Same', 'SW1, and then the page’s signature gesture is given to the two movements that never had it. Four of the six open with a word at architectural scale, cropped by the screen, drifting as it passes; the opening had a centred masthead and Selected works a centred uppercase title. Both now take the same treatment on the same view() timeline — measured, the masthead at 243.2px and the works title at 192px against the posters’ 345.6, all three panning 6vw right to 18vw left. A reader meets the same event six times going down, which is what makes it one document rather than six pages stapled together, and it costs no new device.'],
  'ab-sw3': ['The whole scroll, in one world', 'SW3 · One Grid, Top To Bottom', 'SW1, and then the centre axis goes. The page changed its axis halfway down — the opening and Selected works centred, every poster flush left on twelve columns — and two axes on one scroll is the loudest thing left after the type is reconciled, because it is structural and you feel it before you read. The corner labels become the poster’s label row on the grid, opened by the same hairline. Measured, the opening’s label box now runs 77..247 and the poster’s runs 77..247: the same gridline, not an approximation of it. What it costs is the corner frame, the page’s oldest device, in two places — the opening stops reading as a title card and starts reading as the first page of a document.'],
  'ab-sw4': ['The whole scroll, in one world', 'SW4 · The Score', 'SW1, and then the page admits what it already is. Every section is numbered — 00 Opening through 06 Contact — and the numbers were set at 12px in the corner, the smallest thing in the frame, while being the only element that appears in all seven, the only one that says where you are, and the one thing a reader scrolling a long page actually wants. So the number becomes the largest thing in every label row: measured at 46.08px in the opening, in Selected works and in the posters alike, with everything else left at 12. The giants are untouched. It is a score, not a progress bar — composition.ts already calls that order the score, and nothing is invented or counted.'],
  'ab-ty1': ['The whole scroll, on one scale', 'TY1 · Five Ranks', 'Every element assigned to one of the poster’s five sizes, and where more levels are needed weight and colour do it — not more sizes, which is how Contact reached ten on its own. Measured: fifteen distinct sizes across the three sections down to TEN. I had claimed five or six; that was wrong. The five on the scale are 117.8 giant, 69.1 state, 16.8 body, 16 root, 12 label — all three section statements now agree at 69.1 where they were 34.6, 64 and 96, and every label is 12 where they were 10. The five left are in the footer and inside ContactForm, which is shared with the live site.'],
  'ab-ty2': ['The whole scroll, on one scale', 'TY2 · One Statement Size', 'The narrowest cut: six sections, six statements, and three different sizes for the same rank — the opening at 34.6, Selected works at 64, Contact at 96, with four poster statements at 69.1 sitting between them. All of them take .po-state’s clamp and nothing else is touched. Built to answer whether the heading rank alone is doing the damage, because if it is, TY1’s full sweep is not worth what it costs. Contact loses the most — 96 down to 69.1 — and that is the argument rather than a side effect: the quietest section was shouting loudest. Measured 15 sizes down to 12.'],
  'ab-ty3': ['The whole scroll, on one scale', 'TY3 · The Sequence', 'Not one scale but one SHAPE, repeated. Every poster is the same editorial unit in the same order — rule, label row, statement, lede, body — which is why four posters saying four different things read as one document: the reader learns the shape once and recognises it after. The other three sections each invent their own order. Here all three take the sequence, at the poster’s four sizes. Nothing new is said: every word used as a lede is already on the page, in the corner of the same section at 10px — this moves it and sets it, it does not write it. Measured 15 down to 12.'],
  'ab-ty4': ['The whole scroll, on one scale', 'TY4 · The Data Block', 'The body-text answer, and the one that touches the most words. A poster sets data one way only — 12px label in the grey above a body-size value in the bone, hairline under — and does it in three places. Everywhere else, data is whatever it happened to be: a card’s title and year at 19.2 and 10 with no label, the readout at 10, Contact’s channels a 10px mono word against a 20px link. None wrong alone; together, five ways of saying the same kind of thing. The statements and giants are deliberately untouched — this draft argues the incoherence people feel is in the small type, because there is far more of it and it is what you read while the big type is what you see.'],
  'ab-cx1': ['Contact, in the poster’s voice', 'CX1 · The Ranks', 'Every voice in the section assigned to one of the poster’s three — state, body, label — and where more levels are needed, weight and colour do it rather than another size. The statement comes down from 1.41× the poster’s to exactly the poster’s: 96px to 69.1. Questions and channel values leave 20/500/−0.40, a rank that belongs to nothing, and become body size at 500. The lede and pills go from 18 and 16 to 16.8, so “nearly” becomes “is”, and the fields follow them out of Inter. Measured, excluding the footer: eight distinct sizes down to five, three families down to two — and the second is the message preview, where monospace is what the thing is. The benchmark the other three have to beat.'],
  'ab-cx2': ['Contact, in the poster’s voice', 'CX2 · The Interview', 'The questions are the headings, because in this section they are the content. Everywhere else on the page the large type is what the page says; here it was “Let’s talk.” — a greeting — while the three things actually being asked sat at 20px, the same as a link. So they take the poster’s step-title rank, the one How I work uses for “Find the language”, and the greeting steps back to the lede’s register. Measured: questions at 53.8px, statement at 16.8. It works only because there are three questions; a form with nine would be unreadable set this way, and that would be a different draft.'],
  'ab-cx3': ['Contact, in the poster’s voice', 'CX3 · The Address', 'The three ways to reach him are the largest type in the section, because they are what the section is for. The channels take the statement rank — measured 69.1px — and “Let’s talk.” drops to 12px above them, where it reads as what it is: a heading for a list, not a sentence. Somebody who already knows what they want to say does not want a form, and at 20px against a 96px greeting they had to go looking for the address. The form keeps its body size and stays in full for the person who would rather be asked questions. The email is the longest string on the page, so overflow-wrap is set to anywhere — a broken address is ugly, an overflowing one is broken.'],
  'ab-cx4': ['Contact, in the poster’s voice', 'CX4 · One Size', 'Everything below the statement at the poster’s body, with every rank carried by weight and colour alone: 500 bone for what is asked, 400 bone for what can be chosen, 500 grey for what things are called, 400 grey for what is explained. One size, four voices. A form is a list of equal things — the reader is not meant to rank a question above an option, and every size invented to express importance is really just another interruption. What a form needs to signal is state, answered or not, and the component already does that with colour and fill; this stops size competing with it. The most austere of the four and the most likely to read as plain rather than designed, which is the risk and is worth learning from a draft.'],
  'ab-lt1': ['Contact, set loud', 'LT1 · One Octave Up', 'Every voice moves up one poster rank and the relationships between them are kept exactly. Measured against live at 1280: “Let’s talk.” 96 → 122.9, “Send this enquiry” 39.2 → 69.1 which is the poster’s state rank to the pixel, option text 16 → 23.7 with the button growing 135×48 → 199×72, question 20 → 37. The section’s internal hierarchy was never wrong — greeting, questions, options, labels — it was pitched a register below the posters above it, so it read as an appendix rather than the last movement. Moving every rank up by the same amount fixes the pitch without touching the argument. The send landing exactly on 69.1 is the keeper: the last thing the page asks of you is set at the size of everything the page has told you.'],
  'ab-lt2': ['Contact, set loud', 'LT2 · The Bookends', 'The greeting and the action are set at the same size and are the two largest things in the section — measured, 107.5 and 107.5 to the pixel. The section opens by asking to talk and closes by sending the thing that starts the talking: the same sentence at both ends, one in the second person and one in the first. Setting them identically makes the form read as the space BETWEEN two halves of one gesture rather than a queue of controls with a button at the bottom. It also means the largest type in the section is the only type in it that is a verb — everything else names something, these two do something. The form between them sits at one raised rank throughout so nothing competes: options 25.6 in a 217×78 button, questions 30.7.'],
  'ab-lt3': ['Contact, set loud', 'LT3 · The Choice', 'The option buttons are the largest recurring type in the section, because they are the only words on the page the visitor chooses. Measured: option text 16 → 33.3, button 135×48 → 288×102, and the question drops from 20 to 12. That last move is the argument — “What do you need?” is not the content of the form, it is the name of a set, exactly as 02 / Mumbai, India / 2025–2026 names a poster’s label row. The content is Original score, Sound design, Voice direction & casting: twenty-two words somebody reads, weighs and picks, and they were the smallest type in the section apart from furniture. Set at 33px they become its texture. The cost, stated: this is the draft that makes the section longest.'],
  'ab-lt4': ['Contact, set loud', 'LT4 · The Crescendo', 'The section builds, and the largest type on it is the last thing you do — measured, “Send this enquiry” at 133.1 against a greeting at 102.4. Every other draft here, and every poster above, puts its loudest type at the top, which is what a heading is. This is the only section where the opposite is defensible: Contact is the only one that asks the reader to do something rather than read something, and the thing it asks is at the end. The page spends six movements telling you things; the last sentence is the one you act on. What it costs is stated in the file — 133px is three times the send’s documented 44px ceiling, so the note sits under it at every width rather than beside it. That is the component’s own wrap behaviour, made permanent on purpose.'],
  'ab-ee1': ['Contact, editorial', 'EE1 · Fitted', 'Both statements set to fill their own column exactly, and the sizes are measured rather than chosen. “Let’s talk.” runs 3.969px of width per px of type, so it fills its 447px column at 112.6 — verified, ink 445 in 447. “Send this enquiry” runs 8.736 per px, which is the 8.71 ContactForm’s own comment quotes, so it fills the 625px form column at 71.5 — verified, ink 618 in 625. This is the move that separates a poster from a page with big type on it: the line is not set at a size someone liked, it is set at the size that reaches both edges of the measure. It is also the only draft here whose numbers can be re-derived if the copy or the column changes, rather than re-argued.'],
  'ab-ee2': ['Contact, editorial', 'EE2 · The Stack', 'The greeting stops being a line and becomes a block. Past 112.6 it breaks, and this takes it past on purpose — then fits it again: at 11.8vw each line measured 291 in a 447 column, which is a broken line, not a stack. 18vw puts the longer word across the full measure, verified at ink 446 in 447 over two lines. Two words each filling the column, one on the other, which is what every poster giant on this page is. It was first built as “the accent thread”, colouring the statement’s full stop the way every poster statement does — that is impossible without editing a shared component, because ContactForm renders it as a single text node, and generating the period with ::after would put punctuation into the accessibility tree as content. The arrow is real text and takes the accent instead.'],
  'ab-ee3': ['Contact, editorial', 'EE3 · The Poster’s Own Ranks', 'No invented sizes at all — the two statements take the two display specifications the About run already uses. The send takes .po-state’s clamp copied verbatim, measured at 69.1px: the identical declaration that sets “I think about sound as part of the world” four sections above, so the last sentence the page asks of you is set by the same rule as the first thing it tells you about itself. The greeting takes the giant’s treatment rather than its size — 0.8 leading and −0.058em tracking, the two numbers that make those words read as architecture rather than as large text. The conservative draft, deliberately: nothing here is a new idea, it is the existing system applied to the one section that never received it.'],
  'ab-ee4': ['Contact, editorial', 'EE4 · Two Voices', 'The greeting and the action are the same size and set deliberately differently, because they are not the same kind of sentence — one is offered, one is asked for. Measured at 104.3px each: the invitation open at −1.88px tracking on a 110.6px line, the instruction tight at −5.42 on 93.9. Every other draft in this set and the two before it says the difference between two statements by making one bigger, which is the only thing a scale can say: importance. Two sentences can matter equally and still want opposite settings. The cost is stated in the file — nowrap at 8.736px per px caps the send at 71.5 in a 625 column, and 104 measured 877 wide and hung 251px past it, so the action is allowed to break to two lines. It is the one thing this draft changes besides type.'],
  'ab-vs1': ['About, with the emphasis moved', 'VS1 · The Versal', 'The emphasis leaves the heading and goes to the paragraph: 27vw down to 8vw, 345.6px to 102.4, and a three-line drop cap cut by arithmetic rather than by eye. Three lines of body at 1.42 leading is 2 × 23.86 + one cap-height of 11.11 = 58.83px, and over Neue Haas’ measured 0.6616 cap ratio that is 88.9px, or 5.29em of the 16.8px body — verified, 88.87 against 88.87 and a box of 58.8 against 58.8, sitting 0.01px off its text. The second voice is Fraunces italic, which is a restoration: before the poster rewrite a statement’s second clause was marked with an <em> and ab-fitlive’s stylesheet still carries the note. The questions close from a 16.8px gap to 2px — three paragraphs at body leading read as three claims; shut up they read as one breath.'],
  'ab-vs2': ['About, with the emphasis moved', 'VS2 · The Raised Cap', 'The other versal, and the one this library has never built. A drop cap sinks and cuts a notch into the paragraph; a raised cap rises and leaves the text alone — nothing wraps, nothing is displaced, the first line starts where every other line starts. On a page whose complaint is too much emphasis, a versal that costs the paragraph nothing is the right kind of large. Verified sitting exactly on the first baseline, 0px apart, with float: none. The heading drops to the statement’s own rank, 69.1, and takes the poster’s hairline underneath — named rather than shouted, using the device every poster grid already opens with. The second voice is weight and tracking only: 400 against 500, opened to +0.01em where the statement sits at −0.04. A second voice without a second family.'],
  'ab-vs3': ['About, with the emphasis moved', 'VS3 · The Margin Note', 'The heading stops being type and becomes furniture — 27vw to 12px, the poster’s own label rank, beside the movement number. The argument: “Who I am” tells the reader nothing the first sentence underneath does not, so a name that adds no information deserves to be findable, not 345 pixels. What takes over is the paragraph: with nothing above it competing the versal goes to four lines, 7.44em, 125px, verified 0.01px off its text. The questions hang as a scholium. The second voice takes the accent — and that disagrees with ab-blend1’s note, which says of these same two phrases “THE COLOUR NEEDED NOTHING.” That was about making them match each other and it was right; this is the other question, making them stand out from the clause they answer.'],
  'ab-vs4': ['About, with the emphasis moved', 'VS4 · The Brighter Half', 'The second voice is not quieter than the first — it is louder, which inverts what this page used to do. Before the rewrite these clauses were set DIMMER; ab-fitlive still records “Same obsession.” rendering at a disc’s opacity. Dimmer is what you do to an aside, and neither of these is one: “not something added to it.” is the entire argument of the sentence in front of it, and “Same obsession.” is the reason the three formats above it are worth listing. So the first clause drops to bone-dim and the second stays full bone — the sentence brightens as it resolves, and nothing is added to the page to do it: no second face, no colour, no rule, one value moved. The versal is deliberately the smallest here, two lines, because the emphasis belongs inside the sentences rather than at the top of them.'],
  'ab-rf1': ['About, refined', 'RF1 · The Measure', 'One change, and it is the one the section has been quietly paying for. .po-body sits at grid-column 5 / -1 — eight of twelve columns, 744px — split in two with a 40.96 gap, which leaves each column 352px: THIRTY-SEVEN AND A HALF CHARACTERS. The comfortable range is 45 to 75 and the usual ideal about 66. At 37.7 the eye returns twice as often as it should and every sentence breaks three or four times; text-wrap: pretty is already on and cannot help, because there is nothing to choose between. Taking the body to the full twelve columns makes it 57.9 — measured — with leading opened 1.42 to 1.50 and tracking loosened, because tight tracking helps a short measure and hurts a long one. The rag goes shallow and the paragraph starts to look composed rather than poured.'],
  'ab-rf2': ['About, refined', 'RF2 · The Baseline', 'Every vertical distance becomes a whole number of one unit, and the unit is the body’s own line: 23.856px. Measured after — the statement’s line 67.74 to 71.568, exactly three; the row gap 64 to 71.568, also three. The leading is trimmed with text-box: trim-both cap alphabetic so what lands on the grid is the cap line and the baseline rather than the em box plus whatever Neue Haas carries above its capitals — without that the numbers are right and the type still floats, which is the usual reason a baseline grid looks like it did not work. Nothing about it is visible, and that is the point: a reader feels a page where every line sits on one rhythm as calm without ever knowing why. It costs height, because quantising always rounds up.'],
  'ab-rf3': ['About, refined', 'RF3 · The Rule', 'The structure stops being carried by size and starts being carried by line. The poster already opens every grid with a hairline and never uses one again; here the rule becomes the whole apparatus — grid top, under the label row, under the statement, and down the gutter between the body’s columns. Four hairlines at one weight doing what 345 pixels of heading was doing, so the heading comes down to 7vw, 89.6px. The column rule is the one that matters: two columns separated by white space are two columns, separated by a hairline they are a spread, and that line is the difference between a website with two columns and a page out of a journal. Drawn with column-rule rather than a border so it belongs to the multicol and cannot drift out of register.'],
  'ab-rf4': ['About, refined', 'RF4 · The Optical Pass', 'No size or position changes — the list a typesetter does last and nobody can name after. Tracking in the direction the size asks for, because one letter-spacing across a range is always wrong at one end: statement −0.045em, body +0.001, labels +0.012, measured at −3.11 / +0.017 / +0.144px. Tabular figures on every label, which is what makes a label row look set rather than typed. Widow control the multicol honours. Contextual alternates for the apostrophes this copy is full of. And hung punctuation, which DOES NOTHING HERE and is recorded as such — CSS.supports returns false in this browser, so the declaration is inert; it is left in because it costs nothing and Safari has had it for years. Every one of these is invisible alone; together they are the difference between type set and type placed.'],
  'ab-el1': ['About, eight ways to stop shouting', 'EL1 · The Running Head', '345.6px to 12 — the largest single reduction of the eight. The name is set at the label’s own rank in the grey, directly above the twelve-column rule, so it reads as the first line of the section’s furniture rather than as a title: 02, the name, the place, the range, all one register, which is exactly how a running head works in a book. You need to know where you are, not to be told loudly. The argument for going this far is that “Who I am” carries no information the first sentence underneath does not already give. What it buys is the whole width: the body goes from 38.1 characters to 58.1 — measured — with leading opened to 1.5 and tracking loosened, because tight tracking helps a short measure and hurts a long one.'],
  'ab-el2': ['About, eight ways to stop shouting', 'EL2 · The Spine', 'The name turns ninety degrees and runs up the left edge, bottom-to-top, the convention for Latin spine type in Europe. Rotation is the one move that costs a heading nothing in presence and everything in footprint: it keeps a real size — 2.4vw, 30.72px measured — while occupying a strip the grid was not using. It also reads as a LABEL on the section rather than a TITLE above it, which is the most literally Swiss gesture available. Measured at x 0 to 31 against a page margin of 77, starting at y 64, exactly level with the grid’s rule, clearing the first column by 46px — so the body still gets the full 58.1-character measure rather than paying for the gesture. Rotating about left top instead of the default centre lands it at x −31, off the screen, where the section’s overflow-x: clip eats it; that was measured and fixed. Below 820px it comes out of the margin and sits in flow, because 2.4vw on a phone is 9px, which is not type, it is a scratch.'],
  'ab-el3': ['About, eight ways to stop shouting', 'EL3 · The Outline', 'The name keeps its architecture and gives up its weight. Same 27vw, same crop, same pan — and no fill: drawn in a one-pixel stroke in the rule colour, so the letterforms become the largest hairline on a page already built out of hairlines. Nothing about the composition moves. The argument is that scale is not actually the problem — a 345px word can be perfectly quiet — WEIGHT is: 345 pixels of solid bone against a 16.8 body is a value contrast no amount of grid discipline survives. Hollowed, the same word sits at about the value of a rule, which is where the page’s other structural lines already sit. The only draft of the eight that changes the body not at all, because the heading did not take anything from it. -webkit-text-stroke is the only reliable way to do this today; unprefixed text-stroke has not shipped.'],
  'ab-el4': ['About, eight ways to stop shouting', 'EL4 · The Watermark', 'The name keeps its size and loses its place in the reading order — pushed to z-index 0 at a tenth of its opacity, it becomes the ground the statement and the body sit on rather than a thing above them. The section then reads as one field with type in it, which is what a printed poster actually is: ink on a sheet, not a stack of blocks. The statement is unchanged at 69.1 and is now simply the largest thing you can READ, which is the only ranking that matters. A watermark under running text is usually a mistake, so this one is held at 0.10 and placed behind the whole section rather than behind the paragraph: nothing sits ON it, so the worst contrast any word sits on is exactly what it was. The vacated space goes to the measure, 58.1 characters.'],
  'ab-el5': ['About, eight ways to stop shouting', 'EL5 · The Crop', 'The heading keeps every pixel of its 345.6 and is given a box 0.38em tall against a line box of 0.8, so the grid’s hairline runs straight through the letterforms and the rest is clipped — you read it the way you read a word running off the edge of a poster: completely, instantly, without it ever having been fully shown. Measured: 109 of the W’s 229px of cap height survive the cut, 47.7 per cent, which puts the rule just below the middle of the capitals, and 43.4 per cent of total ink at every one of the four sizes, so the crop really is scale-invariant — unlike the drop cap on this page, which is not. The page already crops these words horizontally; .mvt.po-sec sets overflow-x: clip precisely so they can run off the side. This adds the second axis and lands the cut on a line the grid was already drawing, so it reads as structural rather than accidental.'],
  'ab-el6': ['About, eight ways to stop shouting', 'EL6 · The Colophon', 'The name comes last, the way a signature does. The section opens on the rule and the label row — 02, Mumbai, the range — then the statement, then the words; the name arrives underneath all of it at 5vw in grey above a hairline, as a running foot. The quietest of the eight without shrinking much, and the reason is position rather than size: a heading is loud partly because being first means it has to be read before anything else and it sets the volume for what follows. Last, it is a caption on something already read — same word, same page, a fraction of the insistence. Done by making the section a flex column and ordering the heading after the grid, so the DOM order is untouched and the h2 still precedes its content in source and tab order. Scoped off the Contact section, which shares .po-sec and must not become a flex column.'],
  'ab-el7': ['About, eight ways to stop shouting', 'EL7 · The Chapter Mark', 'The name becomes a divider and the statement takes over as the thing you see first. Set lowercase at 13px with 0.38em of tracking, centred in a hairline running the full measure — the mark a magazine puts between movements, at the same visual weight as the rule it sits in. What gets the volume instead is the statement, the only line in the section that is actually an argument: 5.4vw to 6.4, measured 69.12 to 81.92, across all twelve columns. This is the swap the whole set is circling — the page had its loudest type on its least informative words. The flanking rules are content: ‘’ pseudo-elements, so nothing is added to what a screen reader says. Scoping matters here: a :root-prefixed .po-state outranks .po-state--end and flattened the closing statement from 110.08px to 81.92 before it was shut out with :not().'],
  'ab-el8': ['About, eight ways to stop shouting', 'EL8 · Withheld', 'The name is not on the screen at all; the number carries the section. 02 goes to 4.6vw — 58.88px measured — in white with tabular lining figures, alone above the rule where the giant word was, and the name is taken off the screen but kept in the accessibility tree, so the section is still called Who I am to anyone navigating by landmark or heading. Nothing is deleted: clip-path: inset(50%) on a 1px box, the same technique the live page already uses for the drop cap’s spoken letter. A number can do this work because the four sections ARE a sequence and always were — 02 through 05 already run down the left edge as labels. Promoting them admits that the reader’s real question at the top of a section is WHERE AM I, which an ordinal answers faster than a phrase, and the statement directly underneath answers WHAT IS THIS in the section’s own words. The boldest of the eight, and the only one that cannot be softened: a heading is either on the screen or it is not.'],
  'ab-fs1': ['About, the section rebuilt', 'FS1 · The Spread', 'The section stops being a poster and becomes two facing pages — columns 1 to 6 the verso, 7 to 12 the recto, statement left, running text right, and in How I work every step split the same way. The gutter rule is the detail: drawn on the right leaf with a half-gutter of negative margin and a matching pad so it lands in the MIDDLE of the 20.48px gutter rather than hard against the first word of the recto, which is a mistake you see constantly on the web and never in a book. Measured: the statement’s right edge at 629.8 against column six’s right edge at 629.8, the rule at 640.0 against a gutter midpoint of 640.0, error 0.00. The movement number goes to the outer corner as a folio, flush with the grid’s right edge at 1203.2. The heading becomes a 14px folio header: a spread does not need a title above it, it needs to know which spread it is.'],
  'ab-fs2': ['About, the section rebuilt', 'FS2 · The Shoulder', 'The name moves into the margin at 18px and sits on the statement’s own first baseline — the oldest quiet heading there is, and the page reads as continuous text with a name beside it rather than text interrupted by a name. The technique is the point: .po-grid is set to display: contents, which dissolves it and promotes the heading and the grid’s children into ONE grid on the section, so heading and statement share a row and align-self: baseline does the work. Measured delta 0.00px in three sections. In How I work there is no statement — row two is the ordered list — so the grid takes its first baseline from the step NUMBER and the shoulder lands on 01, 28px above the title, also 0.00 against the number: the same rule on a different first item, and arguably the better answer. Dissolving the grid costs its border-top and padding-top; they come back as a ::before grid item, with 15px of clearance rather than 14, because live clears a 1px border box plus 14px of padding. Measure 38.1 to 47.8.'],
  'ab-fs3': ['About, the section rebuilt', 'FS3 · The Text Page', 'The two-column poster grid is put away and the words are set as a book page: one column at 3 to 9, 648.5px, 69.7 characters — inside the comfortable 45 to 75 band for the first time. The statement comes down 69.12 to 40 so it reads as the opening LINE of that text rather than a slab above it, and the row gap closes from 64px to one body line. Measured: statement and body share a left edge at 267.9 and a width of 648.5, and the gap between them is 25.200px against a body line of 25.200px — exactly one line, which is what makes the eye read two blocks as continuous. They ARE still two blocks: a true run-in needs one element and the markup gives an h3 and a div, so nothing here claims otherwise. The lists in What I work across keep their three columns, because a list is not running text and does not want a book measure.'],
  'ab-fs4': ['About, the section rebuilt', 'FS4 · The Plate', 'A hairline box with a deep inset turns the section into a plate — the way a catalogue frames an object and captions it rather than titling it. The name sits at 13px uppercase on the frame’s top edge with the rule running out of it to the right corner. The obvious way to put a word in a rule is an opaque chip over it, and on this page that chip would show: .rg paints the section at 76 per cent of the ground so the mosaic reads through, and a solid patch behind eight letters is a visibly darker tab. Instead the heading is a flex row whose ::after IS the rule, flex: 1 to the corner, aligned flex-end — measured landing on the frame’s top edge with a gap of 0.00px, nothing overlapped and nothing painted out. The inset is where the premium is: 36.8px top and bottom against 35.84 left and right, more air above and below the contents than beside them, which is how a mounted print is windowed.'],
  'ab-fs5': ['About, the section rebuilt', 'FS5 · The Even Colour', 'THE RATIO WAS ALREADY THERE. The labels are 12px and the body 16.8, and 16.8 / 12 is exactly 1.4 — a clean modular scale sitting under the section that nothing above it obeys. Continued upward: 23.52, 32.93, 46.10, 64.54, 90.35. So the statement moves 69.12 to 64.54, step titles 53.76 to 46.10, and the heading 345.6 to 90.35 — one step above the statement instead of five and a bit, which is the over-emphasis problem stated as arithmetic. Horizontally the body takes all twelve columns and is justified with hyphenate-limit-chars: 7 4 3, at 57.9 characters, where justification works; at 38 the spaces tear holes. Measured: every non-final line is exactly 540.2px, the full column — one paragraph gives 540.2, 540.2, then a ragged 176.6. At 375 the top of the scale would put 711px of ink in a 327px grid, so it steps down two rungs of the SAME scale, 86 per cent visible.'],
  'ab-fs6': ['About, the section rebuilt', 'FS6 · The Specification', 'The label row is a row — 02, Mumbai, the range, strung left to right — which says they belong to the section as a whole. They do not: the place and the range describe the person the body is about, and the number names the movement. Stacked into columns 1 and 2, flush right against a hairline running the height of the content, each lands in the same grid row as the thing it belongs to. Measured: the place sits 0.00px from the statement’s top and the range 0.00px from the body’s, all three flush right at 247.5, one gutter (20.5px) clear of the rule at 267.9. NOTHING POSITIONS THEM — that is the grid’s own row structure with align-items: start, which was already set; no offsets and no magic numbers, true at every width. Flush right against a rule is how a credits block, a specimen caption and a technical drawing all set data, and it is the most editorial thing available for three short strings.'],
  'ab-fs7': ['About, the section rebuilt', 'FS7 · The Staircase', 'Every section on this page starts at column 1 and ends at column 12, four times, which is why they read as four of the same thing rather than four movements of one thing. Here Who I am starts at column 1, What I work across at 2, How I work at 3, What I’m after at 4 — measured left edges 76.8, 172.4, 267.9, 363.5, stepping 95.6, 95.5, 95.6 against a column-plus-gutter of 95.6, with the headings stepping identically. The only draft in either set that cannot be seen in one section: you have to scroll all four, which is exactly what a poster designer does with a sequence and what a web page almost never does. The white it leaves down the left is the figure. Driven by data-mv, which the markup already carries. The lists in What I work across hold the full width on purpose — something has to stay still for the movement to be visible.'],
  'ab-fs8': ['About, the section rebuilt', 'FS8 · The Common Measure', '27vw, 13.5, 23, 18 look arbitrary and are not. Measured, the four headings render 1096, 1088, 1099 and 1059 pixels of ink — within 3.7 per cent. They are not four sizes, they are ONE WIDTH of about 1.07 viewports solved four times for four word-lengths, which is why they feel like a system while feeling too loud. The fault was never the method; it was the number fed into it. New target: the right edge of column 6, 49.091 per cent of the grid, divided by each heading’s measured ink-per-pixel (3.965, 7.870, 4.665, 5.747). Measured after: 553.0, 552.9, 552.9, 552.9px of ink, edges landing on column 6 within 0.1px, and Who I am 345.6 to 139.5 — a factor of 2.5. The unit is cqw with the section as an inline-size container, so the target is a share of the GRID: checked at 1600 where the margin clamps at 88, all four still render one width, 699px, 1px shy — that pixel being the gutter’s own clamp, and the whole error budget of the method. The pan is switched off, because an edge solved onto a grid line only matters if it stays there.'],
  'ab-su1': ['About, eight surfaces', 'SU1 · The Insert', 'The four sections take a warm off-white ground and near-black ink, so the About reads as a paper insert bound into a dark book — the boldest move in any of the three sets that is still entirely Swiss. It takes almost nothing to do: the section already declares --po-white, --po-grey and --po-rule as its own custom properties, so redefining those three plus the background does most of it, and the versal picks up the new ink for free because it was written as var(--po-white). Measured on the new ground: body, statement and labels at 16.29:1, the heading’s grey at 4.97:1, the accent stop at 4.71:1 — all clearing AA. The accent had to change: #E85D2C is 3.03:1 against #F2EFE9 and fails for small text, so it goes to --accent-deep #BF3D0B. The heading drops hardest here, 345.6 to 64, because black on white is optically heavier than white on black at the same size.'],
  'ab-su2': ['About, eight surfaces', 'SU2 · Two Inks', 'Count what the About currently uses: #FFFFFF for the statement, --bone-dim for the labels, --bone for the lifted ones, #9B9B9B for the greys, rgba(255,255,255,0.2) for the rules and #E85D2C for the full stops. Six values on a section trying to look austere. Here there are two, and it is measured as two: every leaf element in the section computes either #FFFFFF or #9B9B9B, nothing else. Ink A carries what the section SAYS — statement and body. Ink B carries everything that is apparatus — labels, step numbers, rules, list headings, full stops, and the heading. THAT is the whole move on the heading: it stays at 9vw, 115.2px, and simply stops being the brightest thing present. Hierarchy by value rather than size is the most elegant demotion there is, because nothing has to shrink for it to work. The rule gets heavier as a cost of the discipline, and that is chosen rather than overlooked.'],
  'ab-su3': ['About, eight surfaces', 'SU3 · The Second Colour', '--accent is currently spent on .po-stop — the full stops ending the statements. Colouring punctuation is a decorative use of a second ink: it pulls the eye to a mark that carries no information, in the middle of the one line you most want read cleanly. A two-colour press job spends its second ink on STRUCTURE, so the stops return to the text colour (measured: .po-stop now computes identical to .po-state) and the orange goes to the movement numerals, the step numbers, the list headings, and the rules at --rule-accent rgba(232,93,44,0.40) — which the stylesheet already defines and never used here. The orange now tells you where you are, 02 through 05 down the left edge and a warm hairline opening each section, instead of telling you a sentence has ended, which you could already see. #E85D2C measures 5.78:1 on the ground, so the numerals clear AA at 12px.'],
  'ab-su4': ['About, eight surfaces', 'SU4 · The Aperture', 'The picture is currently everywhere behind the About and nowhere in particular — a veil over the whole region, which is why it reads as atmosphere rather than as an image. Here the section goes opaque and one rectangle, 44 per cent wide against the top band, is cut out of it: the mosaic appears there and only there, as a plate. The hole is not clip-path, which cannot describe a rectangle with a rectangle missing without dropping to path() and a fill rule. Two mask layers on an absolutely positioned ::before — one covering the box, one the size of the window — composited with mask-composite: exclude, which subtracts the second from the first. Verified supported and applied: mask-size reads "100% 100%, 44% 120px" and mask-composite "exclude, exclude". It is a paint-time mask on a static layer, so nothing is recomputed on scroll. The window sits where no text is, so no word’s contrast depends on which photograph is behind it.'],
  'ab-su5': ['About, eight surfaces', 'SU5 · The Band', 'A Swiss poster almost always has one solid — a bar, a field, a block of flat colour that anchors the hairlines. This page has none: it is all type and 20-per-cent rules, which is why it can read as a wireframe of a poster rather than a poster. So the label row becomes a bone bar across all twelve columns with the labels reversed out in --ground, drawn as .po-grid’s ::before placed in row one, which stretches to the row’s height on its own and needs no measured value. The opening hairline goes, because the bar does that job. A solid outranks anything in outline, so the heading can fall to 12px and sit above it as a caption. IT DOES NOT SURVIVE ONE COLUMN: at 820 the base sheet forces .po-grid > * to grid-row auto, but a ::before is not matched by > * and stays pinned to row 1, which then has nothing in it — measured at 375, rows read "0px 38.8 55.6 38.8" and all three labels painted --ground on --ground, invisible. The band is withdrawn below 820 and the original hairline and ink come back.'],
  'ab-su6': ['About, eight surfaces', 'SU6 · The Fade', '--smoke is one number driving one veil at one density for the whole About. Here it becomes four: Who I am at 40 per cent, What I work across at 55, How I work at 70, What I’m after at 85 — verified resolving to 0.4, 0.55, 0.7 and 0.85 on the four sections. The About moves from the concrete to the abstract, so the picture withdrawing as the writing gets less literal is the surface agreeing with the argument; by the closing statement there is nothing behind the words, which is where you want a reader on a last line. It also fixes something real: the closing statement is the biggest type on the page at 8.6vw, and big type over a busy backdrop is exactly where a veil is most needed — the section that needed the most opacity now has it. The headings step with the ground, #FFFFFF to #C6C6C6 to #9B9B9B to #6E6E6E, demoting across the sequence rather than within a section.'],
  'ab-su7': ['About, eight surfaces', 'SU7 · The Weight', 'The heading and the statement are set at the SAME size — 46px, verified identical — and the heading is still obviously subordinate, because it is weight 200 in grey against weight 600 in white. Nothing shrank relative to its neighbour; 345.6 to 46 is the largest reduction in the set, and the section reads more hierarchical afterwards, not less, because two axes are doing the work where one was. Scale is the loudest tool in typography and the first everybody reaches for; weight is quieter and more precise, and a 200 and a 600 of one face read as two voices of one person where two sizes read as two announcements. A DEPENDENCY, MEASURED: --display names Neue Haas Grotesk Display first, which is not a webfont here, and on this machine it does not resolve — it sets a test string at exactly the width of an invented family name. The stack falls to Helvetica Neue, which has six distinct weights between 100 and 700; Arial has two. Full range on macOS, two steps elsewhere, which is why the value axis is in this draft and not the weight alone.'],
  'ab-su8': ['About, eight surfaces', 'SU8 · Unsmoked', 'The mosaic belongs to the opening — it is the material the hero is made of. Behind six hundred words of running text it is not atmosphere, it is interference, and every typographic decision in this library has been made against a backdrop nobody can predict. Here the four sections go fully opaque: solid --ground, no veil. The type finally gets a known ground, #FFFFFF at 19.9:1 and #9B9B9B at 7.16:1, flat numbers rather than a worst case over a photograph — which is why the heading can sit at 8vw in the grey and be confidently the second thing you see rather than defensively the first. THE FIRST VERSION OF THIS NOTE CLAIMED IT MADE THE PAGE FASTER BY STRIPPING backdrop-filter FROM FOUR TALL SECTIONS. It strips none: op1 already set backdrop-filter: none on .po-sec and every element on the live page measures none. What it removes is the veil and four large translucent compositing layers — real, but small. The reason to want it is editorial, not mechanical.'],
  'ab-mo1': ['About, eight in time', 'MO1 · The Settle', 'The name is large while it arrives and small once it is being read. At rest 7vw, 89.6px, down from 345.6; while the section enters it is scaled 2.05, about 184px, settling to its resting size exactly as the section finishes arriving. IT COSTS NOTHING TO RUN: the settle is a transform, not a font-size, so the layout box is the 7vw one at every moment and nothing reflows on scroll — animating font-size would relayout the section every frame, which is the same class of mistake as the backdrop-filter. transform-origin is left bottom, so the word grows up out of its own baseline and the left edge stays locked to the grid. Verified three ways: keyframes read back as scale(2.05) to scale(1); attached to the h2 with animation-timeline view(), range entry, fill both; and the same keyframes re-run through the Web Animations API on a paused timeline sample 2.05, 1.7875, 1.525, 1.0 at 0, 25, 50 and 100 per cent. .po-pan keeps running on the span inside — scale on the h2, pan on its child, so they compose rather than collide.'],
  'ab-mo2': ['About, eight in time', 'MO2 · The Dim', 'The name is bright for one moment and then gets out of the way: resting at 9vw and 45 per cent opacity, full white on the way in, fading to rest as the section completes its entry. WHY THE REST STATE IS THE DIM ONE — if bright were the resting state, a reader with prefers-reduced-motion would get the loud page and everyone else the quiet one, which would let an accessibility setting choose the design. Written this way round, reduced motion loses the flare and keeps the composition. 45 rather than 38, with numbers: composited against flat --ground, white at 0.38 gives 3.52:1 and white at 0.45 gives 4.52:1; large text needs 3:1, so 0.38 clears by half a point with nothing spare, and the mosaic can only raise the backdrop and lower that figure. Sampled 1, 0.725, 0.45. Opacity is a compositor property — this is the cheapest of the eight.'],
  'ab-mo3': ['About, eight in time', 'MO3 · The Rule Draws', 'Every section opens on a single hairline across twelve columns. Here that line draws itself, left to right, as the section arrives — a poster grid is normally a fact you infer; for one second it is a thing you watch being made. That is the whole demotion mechanism: the opening gesture becomes structural rather than typographic, so the heading has no work left and goes to 12px in the grey, level with the label row. .po-grid’s border-top is replaced by an absolutely positioned ::before of exactly 1px in the same --po-rule colour, animating scaleX(0) to scaleX(1) from transform-origin left — a compositor transform, no width animated, nothing relayouts. Verified at rest as 1px, rgba(255,255,255,0.2), position absolute, with the grid’s own border at 0px: identical to the border it replaced. Sampled 0, 0.5, 1.0. Animating the one line the design already believes in is more Swiss than adding anything new.'],
  'ab-mo4': ['About, eight in time', 'MO4 · The Register', 'The statement arrives from one column left and the running text from one column right, both locking onto the grid as the section finishes entering — for a moment the page is slightly out of register, then it snaps true. It is the most literally press-like gesture available to a page built on twelve columns. WHY OPPOSITE DIRECTIONS: a single shared offset is a slide-in, the default move on every site built this year; two elements converging from opposite sides says the grid is the thing they are both agreeing to. Amplitude 2.4vw — measured 30.72px at 1280, under half a 75.09px column, because registration error is small by definition. Attached to all seven affected elements across the four sections and sampled at -30.72, -15.36, 0 and +30.72, +15.36, 0. The heading takes 8vw and does not move at all: it is the plate everything else registers against.'],
  'ab-mo5': ['About, eight in time', 'MO5 · The Cascade', '02, then Mumbai, then the range — three labels landing one after another as the section enters, each rising eight pixels into place, telling you the label row is a SEQUENCE of three facts rather than one decorative strip. STAGGERED BY RANGE, NOT BY DELAY: animation-delay is meaningless on a scroll-driven timeline, because there is no clock to delay against — the timeline is a position. So the three share one set of keyframes and differ only in animation-range, verified distinct at entry 10-45 per cent, 22-57 and 34-69. The offset between them is scroll distance, so the cascade holds its shape at any scroll speed, including a trackpad flick where a time-based stagger collapses into everything at once. That is the whole argument for scroll-driven stagger over the delay-based kind every site ships. Sampled 8px/0 opacity, 6/0.25, 4/0.5, 0/1; resting opacity verified at 1.'],
  'ab-mo6': ['About, eight in time', 'MO6 · The Counter-Pan', 'po-pan already sweeps the giant word 24vw whenever a section is on screen — read out of its keyframes, translateX(76.8px) to translateX(-230.4px). That motion is currently unanswered, so it reads as a heading doing a trick. Here the running text drifts the other way over the same range and the two become parallax. SIXTEEN EACH WAY, NOT SIXTY: the heading sweeps 307px, and if the text answered at that scale you would be reading a moving target; this is -16 to +16, sampled at -16, -8, 0, +16. Under the threshold at which you notice motion, above the one at which it registers as depth. AND IT IS IN REGISTER EXACTLY WHEN YOU ARE READING — the keyframes are symmetrical about zero, so the midpoint of range cover, the moment the section is centred in the viewport, puts the text at translateX(0), dead on the grid. The drift exists on the way in and the way out and is absent while you read.'],
  'ab-mo7': ['About, eight in time', 'MO7 · The Wipe', 'A clip tracks the section’s entry and uncovers the heading left to right, so for the entire time the word is the most prominent thing on screen it is also incomplete; by the time it is whole, the statement and body are in place and it is no longer what you are reading. It keeps its full 14vw, 179.2px, and still never dominates — the demotion is in the timing, not the size. WHY A WIPE AND NOT A FADE: a fade says the word is appearing; a hard vertical edge travelling across it says it is being PRINTED, which is the right metaphor for a page built as a poster and the one reveal that reads mechanical rather than atmospheric. inset(0 100% 0 0) to inset(0), sampled at 100, 75, 50 and 0 per cent of cover; the end state is the same rectangle as no clip at all, and the resting heading is verified at clip-path: none, which is what makes it safe to lose on reduced motion. It clips the .po-pan span with the word, so the letters travel under a fixed edge rather than dragging it along.'],
  'ab-mo8': ['About, eight in time', 'MO8 · The Trade', 'As the section enters, the name is at full white and the statement is held back at 55 per cent and 14px low; across the same scroll range they swap — the name falls to 40 per cent and lifts 10px away, the statement comes to full and settles onto its line. You arrive at a poster and leave holding a sentence. THIS IS THE ONE THAT ACTUALLY ANSWERS THE BRIEF: every other draft in four sets has made the heading quieter by giving it less — less size, weight, contrast, time. This gives the loudness to something else. The section still has a loud element at every moment; it is just no longer the least informative one. Both halves are one gesture, which is why the ranges are identical — verified equal at entry 15 per cent to contain 25; two different ranges would read as two events. Sampled: recede 0/1 to -10px/0.4, rise 14px/0.55 to 0/1, both linear. Rest state is the end state, so reduced motion gets the resolved composition.'],
  'ab-uc1': ['About headings in capitals', 'UC1 · Entirely Uppercase', 'The four About headings set entirely uppercase the way the Selected works heading is, resized so the composition does not move, with the pan untouched. WHY THE RESIZE IS NOT OPTIONAL: measured at 1280 the four headings render 1350.3, 1349.9, 1356.3 and 1310.8px of ink — one common width of about 1.06 viewports, solved four times for four word-lengths, and that is the system the page is built on. Capitals break it, because they do not widen a line by a constant: Who I am grows by 1.114, being already mostly caps and short words, while What I work across grows by 1.299. Uppercased at their current sizes the four would run 1504, 1753, 1700 and 1661 — a spread of 249px where there is currently 45. So each size is SOLVED rather than scaled: every heading’s uppercase ink-per-pixel was measured and its new size is its own current ink width divided by that number. 13.5 to 10.162, 23 to 17.950, 18 to 13.853, each landing on its own width to within 0.1px. WHO I AM IS DELIBERATELY BELOW ITS SOLVED SIZE: 27vw solved to 23.673 but is set at 21.800, because equal ink width does not mean equal apparent size — eight characters against eighteen puts WHO I AM at 303px of type and WHAT I WORK ACROSS at 130, a 2.3 to 1 difference in the size of an actual letter, so the shortest heading is the loudest of the four however well the widths match. At 21.8vw it is 279.04px and 1243.4px of ink, 7.9 per cent under the other three. Measured: 1243.4, 1349.9, 1356.3 and 1310.7px. THE TRACKING COMES WITH THE CASE: .fr__t is uppercase at -0.045em while .po-giant is at -0.058, which is a lowercase setting — tight tracking suits a line broken up by ascenders and closes capitals into each other. The sizes are solved with -0.045em. THE ANIMATION IS NOT TOUCHED: po-pan lives on the span inside each h2 and its keyframes are in vw, 6 to -18, so it travels exactly as far at exactly the same rate — verified still 4 instances on view()/cover with the original keyframes.'],
  'ab-hn1': ['The mono text, re-faced', 'HN1 · Mono Into The Page Face', 'Every string on the homepage rendering in JetBrains Mono Variable set instead in the display stack, which on this machine resolves to Helvetica Neue. Case and size untouched — nothing lowercased, nothing resized. WHAT IS ACTUALLY IN MONO, found by scanning the rendered page rather than reading the stylesheet: eleven kinds of element carry their own text in it, all inside .rg — the running head’s four spans, the four corner labels twice over (opening frame and works), the Scroll cue twice, the contact form’s email preview, and one unclassed span. ONE LINE DOES IT: all of them resolve their family through var(--mono), so redefining that property on .rg switches every one and cannot miss a rule naming the stack directly, because none does. Set to var(--display) rather than a literal Helvetica Neue, so the labels are declared exactly as the rest of the page is — measured, the named Neue Haas sets a test string at 702.69px, identical to a deliberately invented family name, while Helvetica Neue gives 781.7 and the page gives 781.7. On a machine that HAS Neue Haas these labels would follow the page into it; naming the fallback directly would pin them while everything around them moved. WHAT CHANGES WIDTH IS NOT WHAT YOU WOULD GUESS: at a fixed 10px the opening frame’s labels go 53.2 to 56.0, 121.6 to 126.7, 83.6 to 77.6 and 106.4 to 112.4px — two grow and two shrink, because mono digits are wide and mono capitals relatively narrow, so the label carrying 00/06 2025 — 2026 loses 6px while the one carrying SELECTED WORKS gains 6. All four are absolutely positioned in corners, so nothing else moves. Verified: zero elements remain in JetBrains Mono at 1280 and 375. FLAGGED: .peek__body is a pre holding the contact form’s email preview, where a monospace face is arguably doing semantic work — it reads as a mail client because it is set like one. Included because the brief said the entire homepage; named here because it is the one place the mono carried meaning rather than style.'],
  'ab-ps1': ['Seven changes, four ways', 'PS1 · By Value', 'Section numbers and step numbers are currently IDENTICAL — both 12px, weight 500, full bone — so nothing tells you 02 names a movement and 01 names a step inside one. Here they are told apart by tone with neither changing size: section numbers go to --po-grey, measured 7.16:1 against the ground, staying at 12px and in place and simply ceasing to be the brightest thing in the label row; step numbers take the accent #E85D2C at 5.78:1, which is the page’s one colour and is already doing this exact job as the full stop ending each About statement. Colour is the right axis because size would make the steps louder than the movements containing them, which is backwards, and weight at 12px is nearly invisible. Items 1, 2, 3, 6 and 7 are identical in all four, being instructions rather than choices: the four corner texts around SELECTED WORKS removed in markup (taking “Selected works” twice over, the place, the counter, the range and the SCROLL cue — the ruler under the conveyor, which is the actual position instrument, is untouched); the heading rebuilt at the About movements’ rank, measured 8.538px of ink per pixel of size so 12vw gives 153.6px and 1311px of ink, the same mass as WHAT I’M AFTER at 1310.7, with the hairline every movement opens on and its number hung at column 1; place and range out of Who I am and Contact, both strings still present in the opening frame where they are not a repeat; the three questions in Find the language closed from 17px apart to 3; and the email out of capitals, reached with :global() because .ft__mail belongs to ContactForm and is never edited from here. Character count 2601 to 2455 at 1280 and 2571 to 2425 at 375 — a delta of exactly 146, which is the named strings and nothing else. '],
  'ab-ps2': ['Seven changes, four ways', 'PS2 · By Voice', 'The step numbers change typeface, which is the one difference nobody has to be taught. Section numbers go to --po-grey at 12px; the three step numbers set in Fraunces italic at 20px — the page’s second voice, used for the accented clause in the opening statement and nowhere else. A serif italic beside a grotesk label is not a variation on the same mark, it is a different hand. The argument: step numbers are the only place on the page where a number belongs to prose rather than structure — 02 names a movement of the document, but 01 in How I work is the first of three things he does, which is an argument, not an index. Fraunces renders noticeably smaller than the grotesk at equal pixel size, so 20 against 12 is closer to parity than the figures suggest. Items 1, 2, 3, 6 and 7 are identical in all four, being instructions rather than choices: the four corner texts around SELECTED WORKS removed in markup (taking “Selected works” twice over, the place, the counter, the range and the SCROLL cue — the ruler under the conveyor, which is the actual position instrument, is untouched); the heading rebuilt at the About movements’ rank, measured 8.538px of ink per pixel of size so 12vw gives 153.6px and 1311px of ink, the same mass as WHAT I’M AFTER at 1310.7, with the hairline every movement opens on and its number hung at column 1; place and range out of Who I am and Contact, both strings still present in the opening frame where they are not a repeat; the three questions in Find the language closed from 17px apart to 3; and the email out of capitals, reached with :global() because .ft__mail belongs to ContactForm and is never edited from here. Character count 2601 to 2455 at 1280 and 2571 to 2425 at 375 — a delta of exactly 146, which is the named strings and nothing else. '],
  'ab-ps3': ['Seven changes, four ways', 'PS3 · By Form', 'Section numbers go to --po-grey at 12px; the three step marks keep that exact size and colour and are put in a one-pixel box — the rehearsal mark a score uses at the points a conductor stops and restarts from, which for a page whose movements are already numbered like a score is the reference nearest to hand. A box rather than a bigger number because the distinction is CATEGORICAL, not hierarchical: a step number is not more important than a section number, it is a different kind of thing, and scale says more while an enclosure says this belongs to its own series. Drawn at 34 per cent rather than the rules’ 20, because a 1px stroke around 12px of type reads lighter than the same stroke across twelve columns. CORRECTED: display: inline-block computed to block, .po-stepn being a grid item at column 1 / span 2, and the border drew a 170px box around a 12px number — justify-self: start shrinks it to 29px, which is what a rehearsal mark is. Items 1, 2, 3, 6 and 7 are identical in all four, being instructions rather than choices: the four corner texts around SELECTED WORKS removed in markup (taking “Selected works” twice over, the place, the counter, the range and the SCROLL cue — the ruler under the conveyor, which is the actual position instrument, is untouched); the heading rebuilt at the About movements’ rank, measured 8.538px of ink per pixel of size so 12vw gives 153.6px and 1311px of ink, the same mass as WHAT I’M AFTER at 1310.7, with the hairline every movement opens on and its number hung at column 1; place and range out of Who I am and Contact, both strings still present in the opening frame where they are not a repeat; the three questions in Find the language closed from 17px apart to 3; and the email out of capitals, reached with :global() because .ft__mail belongs to ContactForm and is never edited from here. Character count 2601 to 2455 at 1280 and 2571 to 2425 at 375 — a delta of exactly 146, which is the named strings and nothing else. '],
  'ab-ps4': ['Seven changes, four ways', 'PS4 · By Scale', 'Section numbers become the smallest thing on the page and step numbers the largest small thing. Sections go to 10px in --po-grey with tracking opened to 0.18em, where a number stops reading as a word and starts reading as a mark — registered without being looked at, which is all a movement index has to do, and the furthest of the four from over-emphasis. Step numbers go the other way to 34px in bone, unmistakably not section numbers, carrying weight the step titles used to carry alone. A ratio of 3.4 to 1. This inverts the hierarchy deliberately: How I work is the one section whose content IS a numbered sequence, so its numbers are the argument’s structure rather than filing, while everywhere else a number is an address and should behave like one. Items 1, 2, 3, 6 and 7 are identical in all four, being instructions rather than choices: the four corner texts around SELECTED WORKS removed in markup (taking “Selected works” twice over, the place, the counter, the range and the SCROLL cue — the ruler under the conveyor, which is the actual position instrument, is untouched); the heading rebuilt at the About movements’ rank, measured 8.538px of ink per pixel of size so 12vw gives 153.6px and 1311px of ink, the same mass as WHAT I’M AFTER at 1310.7, with the hairline every movement opens on and its number hung at column 1; place and range out of Who I am and Contact, both strings still present in the opening frame where they are not a repeat; the three questions in Find the language closed from 17px apart to 3; and the email out of capitals, reached with :global() because .ft__mail belongs to ContactForm and is never edited from here. Character count 2601 to 2455 at 1280 and 2571 to 2425 at 375 — a delta of exactly 146, which is the named strings and nothing else. '],
  'ab-rw1': ['Seven changes, four ways — second set', 'RW1 · On The Ink Width', 'HEADING at 12vw. Measured, SELECTED WORKS uppercase at -0.045em is 8.538px of ink per pixel of size, so 12vw gives 153.6px and 1311.4px of ink — the same mass as WHAT I’M AFTER at 1310.7. That is how the About headings relate to each other: not by sharing a size, which they do not, but by sharing a width. SECTION NUMBERS by value, to --po-grey at 7.16:1 — same size, same place, no longer the brightest thing in the label row. STEP NUMBERS by hue, the accent at 5.78:1, the page’s one colour, already ending every About statement as its full stop. QUESTIONS to zero gap, leaving the three exactly one line-height apart at 23.856px — the same interval as the lines inside each of them, so they become one block of three lines with no value invented. Shared in all four: the corner texts removed in markup (taking “Selected works” twice over, the place, the counter, the range and the SCROLL cue — the ruler under the conveyor is untouched); place and range out of Who I am and Contact, both still in the opening frame where they are not a repeat; and the email lowercased and named Helvetica Neue outright — measured, it was ALREADY rendering Helvetica Neue since the mono change (781.7 against Helvetica Neue at 781.7, while the named Neue Haas gives 702.69, the same as an invented family), so only the case actually changed. Character count 2601 to 2455 at 1280 and 2571 to 2425 at 375, a delta of exactly 146 — the named strings and nothing else.'],
  'ab-rw2': ['Seven changes, four ways — second set', 'RW2 · The Quiet Title', 'HEADING drops out of display rank entirely to 69.12px / 0.98 / -0.04em, exactly .po-state. The argument: the About movements have a display heading because each is a long piece of writing that needs announcing; Selected works is not writing, it is sixteen pictures and a ruler, and it already says what it is on every card. The only draft here where the largest thing in the section is the work itself. SECTION NUMBERS by size, 10px at 0.18em, where a number stops reading as a word and becomes a mark. STEP NUMBERS by voice, Fraunces italic at 20px — the page’s second face, used for the accented clause and nowhere else; a different hand, not a variation on the same mark. QUESTIONS tighter than the page: gap to zero AND leading 1.42 to 1.18, measured 19.824px, so the block is denser than the text around it rather than merely closer together. Shared in all four: the corner texts removed in markup (taking “Selected works” twice over, the place, the counter, the range and the SCROLL cue — the ruler under the conveyor is untouched); place and range out of Who I am and Contact, both still in the opening frame where they are not a repeat; and the email lowercased and named Helvetica Neue outright — measured, it was ALREADY rendering Helvetica Neue since the mono change (781.7 against Helvetica Neue at 781.7, while the named Neue Haas gives 702.69, the same as an invented family), so only the case actually changed. Character count 2601 to 2455 at 1280 and 2571 to 2425 at 375, a delta of exactly 146 — the named strings and nothing else.'],
  'ab-rw3': ['Seven changes, four ways — second set', 'RW3 · Banded', 'Everything needing separation is separated by a rule, the page’s only structural mark. HEADING at 12vw banded between two hairlines — one above where every movement already opens, one below closing it. SECTION NUMBERS by rule: grey with a hairline above the number alone, one column wide rather than twelve, reading as a tick on the long rule. STEP NUMBERS by form, boxed at the same 12px and the same bone — the rehearsal mark a score puts where a conductor stops and restarts. The distinction is CATEGORICAL, not hierarchical: scale says more, an enclosure says its own series. Drawn at 34 per cent against the rules’ 20, because a 1px stroke around 12px of type reads lighter than the same stroke across twelve columns; justify-self: start rather than inline-block, since .po-stepn is a grid item and blockifies, which otherwise draws a 170px box around a 12px number — measured 29px after. QUESTIONS bracketed: gap to zero plus a hairline down their left edge, marked as one set rather than merely closer. Shared in all four: the corner texts removed in markup (taking “Selected works” twice over, the place, the counter, the range and the SCROLL cue — the ruler under the conveyor is untouched); place and range out of Who I am and Contact, both still in the opening frame where they are not a repeat; and the email lowercased and named Helvetica Neue outright — measured, it was ALREADY rendering Helvetica Neue since the mono change (781.7 against Helvetica Neue at 781.7, while the named Neue Haas gives 702.69, the same as an invented family), so only the case actually changed. Character count 2601 to 2455 at 1280 and 2571 to 2425 at 375, a delta of exactly 146 — the named strings and nothing else.'],
  'ab-rw4': ['Seven changes, four ways — second set', 'RW4 · Stacked', 'HEADING at 12vw with its number stacked directly above and closed to 6px, so 01 and SELECTED WORKS read as one object rather than a label and a title that happen to be near each other. SECTION NUMBERS by weight: --po-grey at 12px but weight 400 where everything else is 500 — the smallest change of the four and the hardest to name when you see it, which is the point. STEP NUMBERS by scale, 34px against 12, measured 2.83 to 1, inverting the hierarchy deliberately: How I work is the one section whose content IS a numbered sequence, so its numbers are the argument’s structure rather than filing. QUESTIONS hung: gap to zero, leading to 1.1 (18.48px), and the three pulled 14px left to hang off the column edge, the device a dictionary uses for sub-entries. CORRECTED: at 375 the grid collapses and .po-steplines starts at the page margin, so the pull put the questions at x=10 inside a 24px margin. The hang is dropped below 900; the tightening stays. Shared in all four: the corner texts removed in markup (taking “Selected works” twice over, the place, the counter, the range and the SCROLL cue — the ruler under the conveyor is untouched); place and range out of Who I am and Contact, both still in the opening frame where they are not a repeat; and the email lowercased and named Helvetica Neue outright — measured, it was ALREADY rendering Helvetica Neue since the mono change (781.7 against Helvetica Neue at 781.7, while the named Neue Haas gives 702.69, the same as an invented family), so only the case actually changed. Character count 2601 to 2455 at 1280 and 2571 to 2425 at 375, a delta of exactly 146 — the named strings and nothing else.'],
  'ab-nv1': ['Seven changes — four new ideas per axis', 'NV1 · In Motion', 'HEADING PANS. Every About heading runs po-pan — translateX(6vw) to -18vw on a view() timeline over range cover. Eight drafts have matched their size, case, tracking and ink width; none matched the thing you actually notice. Selected works gets the same keyframes in kind, same timeline, same range, so it drifts at the rate the four below it do; at rest 12vw on the About ink width. SECTION NUMBERS let through: bone at 40 per cent opacity rather than a flat grey — over a photographic mosaic a transparent numeral lets the picture through ITSELF rather than sitting on it as a lighter solid, the only treatment in this library whose value changes with what is behind it. Measured 3.75:1, clear of the 3:1 floor. STEP NUMBERS reversed, ground on bone where the sections are grey on ground — the page has no other solid anywhere, so three small filled rectangles are unmistakable without being large. QUESTIONS to -5px, 18.9px apart: tighter than the page’s own 23.856 line, not merely closed up. CORRECTED: the number first moved to grid-row 2 to sit on the statement’s baseline and printed ON TOP of it — .po-c1 at [77,247] and .po-state at [77,1012] share a row and a left edge; shifting row two right by two columns would also have narrowed the contact form, whose column widths are documented invariants. Shared: corners removed in markup (taking “Selected works” twice, the place, the counter, the range and the SCROLL cue — the ruler under the conveyor is untouched); place and range out of Who I am and Contact; email lowercased and named Helvetica Neue, which it already rendered since the mono change (781.7 against Helvetica Neue’s 781.7, the named Neue Haas giving 702.69, the same as an invented family). Character count 2601 to 2455 at 1280 and 2571 to 2425 at 375 — exactly 146, the named strings and nothing else.'],
  'ab-nv2': ['Seven changes — four new ideas per axis', 'NV2 · In The Margin', 'Everything that is apparatus leaves the measure. HEADING FLUSH RIGHT — same 12vw and ink width, set against the right edge instead of the left; the one alignment the page has never used, and the grid is symmetrical so it is as true to it as the left. SECTION NUMBERS turned 90 degrees into the left margin, bottom to top, tracking opened to 0.14em because rotated type reads tighter than it measures; the margin is 77px of nothing, so a number there is out of the reading path entirely. STEP NUMBERS hung out of their column into the gutter — the marginal numeral of a printed list; same size, same colour, position alone saying they are a different order of thing. QUESTIONS as a staircase, gap to zero and each indented 1.1em further. CORRECTED TWICE: :nth-of-type counted all the step’s paragraphs, not just its questions (the order is statement, ask, ask, ask, statement), so it indented the first two and left the third flush — measured 18.48, 36.96, 0; adjacent-sibling selectors count questions. And at 375 the 28px hang overshot a 24px margin, landing the numeral at x=-4 where the section clipped it. Shared: corners removed in markup (taking “Selected works” twice, the place, the counter, the range and the SCROLL cue — the ruler under the conveyor is untouched); place and range out of Who I am and Contact; email lowercased and named Helvetica Neue, which it already rendered since the mono change (781.7 against Helvetica Neue’s 781.7, the named Neue Haas giving 702.69, the same as an invented family). Character count 2601 to 2455 at 1280 and 2571 to 2425 at 375 — exactly 146, the named strings and nothing else.'],
  'ab-nv3': ['Seven changes — four new ideas per axis', 'NV3 · Off The Edge', 'HEADING RUNS OFF THE LEFT — still 12vw and the same ink width, hung out to the viewport’s own edge, measured at x=0. The About headings are already cropped by the screen on the right; this crops one on the left too, so the word arrives from outside the page rather than starting inside it. CORRECTED: cancelling --margin alone left it at x=51, only 26px out, because .fr--over carries clamp(26px, 4vw, 72px) of its own padding that also has to be given back. SECTION NUMBERS as folios, moved to column 12 and set flush right — measured landing exactly on the grid’s right edge at 1203; nothing else on the page uses that position, so they become a column down the right and the left edge is left to content. STEP NUMBERS with a leader: the numeral followed by a hairline running to the edge of its column, the rule a table of contents puts between an entry and its page. A leader says “this belongs to what follows”, which is the relationship a step number has and a section number does not. QUESTIONS smaller — gap to zero AND 14px against the surrounding 16.8, so the block is physically smaller as well as closer. Shared: corners removed in markup (taking “Selected works” twice, the place, the counter, the range and the SCROLL cue — the ruler under the conveyor is untouched); place and range out of Who I am and Contact; email lowercased and named Helvetica Neue, which it already rendered since the mono change (781.7 against Helvetica Neue’s 781.7, the named Neue Haas giving 702.69, the same as an invented family). Character count 2601 to 2455 at 1280 and 2571 to 2425 at 375 — exactly 146, the named strings and nothing else.'],
  'ab-nv4': ['Seven changes — four new ideas per axis', 'NV4 · The Masthead', 'HEADING STACKS — SELECTED over WORKS, two lines at 12vw with leading at 0.8, measured wrapping at 736 and 540px. It is the one shape the About movements cannot make, every one of their headings being a single line by construction, and it is done by letting the line wrap at a narrow enough measure rather than by adding a break. SECTION NUMBERS spaced out to 0.6em of tracking — measured 7.2px — far enough that the two digits stop reading as a number and start reading as two marks with a gap; widely letterspaced figures say “reference” rather than “quantity”. STEP NUMBERS underscored: a single hairline directly beneath the numeral, its own width, no box, no colour, no change of size — the smallest mark that makes a numeral a different kind of numeral, and the quietest beside a page already made of rules. QUESTIONS compressed both ways: gap to zero, leading 1.42 to 1.0 (16.8px, the type’s own size, as tight as a line sets before descenders touch) and tracking to -0.012em. Every other draft tightened vertically only. Shared: corners removed in markup (taking “Selected works” twice, the place, the counter, the range and the SCROLL cue — the ruler under the conveyor is untouched); place and range out of Who I am and Contact; email lowercased and named Helvetica Neue, which it already rendered since the mono change (781.7 against Helvetica Neue’s 781.7, the named Neue Haas giving 702.69, the same as an invented family). Character count 2601 to 2455 at 1280 and 2571 to 2425 at 375 — exactly 146, the named strings and nothing else.'],
  'ab-wh1': ['The Selected works heading, four more', 'WH1 · Flush Both Edges', 'The only display type on the page that begins and ends on a grid line. The four About headings are solved for WIDTH — 1243.4, 1349.9, 1356.3 and 1310.7px, within 113px of each other — and every one consequently runs off the right of the screen. This takes the same method with a different constant: the measure itself, 88vw, 1126.4px at 1280. Solving 1126.4 / 8.538 gives 131.93px, 10.307vw. Verified: ink 1126.4 against a measure of 1126.4, left and right error 0.0. TWO THINGS HAD TO BE FIXED TO MAKE THAT TRUE. The frame carries clamp(26px, 4vw, 72px) of its own padding-inline, so at margin: 0 the ink was the right width in the wrong place — 128..1254 against a grid of 77..1203, 51.2px right on both edges. And written as the shorthand margin: 0 calc(0px - clamp(...)) the declaration was dropped whole and the computed margin came back 0px, the rule matching and doing nothing; separate longhands negating by calc(x * -1) parse. At 375 the heading runs 3px wider than the measure, because --margin clamps to 24px there and the measure is 87.2vw rather than 88. Built on the live page as it now stands, the four corner labels already gone, so the frame holds nothing but this word. “SELECTED WORKS” uppercase at -0.045em measures 8.538px of ink per pixel of size; every figure is solved from that. Not repeated from ab-ps*, ab-rw* or ab-nv*: the common ink width, the statement rank, banded rules, a stacked number, the pan, flush right, hung to the viewport edge, two-line stack.'],
  'ab-wh2': ['The Selected works heading, four more', 'WH2 · Cropped By Its Own Box', 'The About headings are cut off by the screen; this one is cut off by the frame it sits in. 12vw, 153.6px, with a line box of 0.38em against the font’s own 0.8 — measured, a box 58.4px tall holding capitals 112.3px tall, so 52 per cent of the cap survives and the cut lands just above the middle of the letterforms. You read it completely and instantly and never see it whole. THE SAME GESTURE ON A DIFFERENT AXIS: the four About headings all overflow horizontally, 1243 to 1356px of ink in a 1280 viewport, held there on purpose by .mvt.po-sec’s overflow-x: clip. Cropping is already the house move; it has only ever been applied sideways. The height is set in em so one value holds at every viewport — everything inside the heading scales with its own font-size, which is not true of the drop cap on this page. Built on the live page as it now stands, the four corner labels already gone, so the frame holds nothing but this word. “SELECTED WORKS” uppercase at -0.045em measures 8.538px of ink per pixel of size; every figure is solved from that. Not repeated from ab-ps*, ab-rw* or ab-nv*: the common ink width, the statement rank, banded rules, a stacked number, the pan, flush right, hung to the viewport edge, two-line stack.'],
  'ab-wh3': ['The Selected works heading, four more', 'WH3 · Behind The Work', 'The type becomes the ground and the stills become the figure. Every About section sets its heading OVER a photographic mosaic — image as ground, type on it — and that holds for the whole page. Selected works is the one section where the image is not atmosphere but the actual subject, so the relationship inverts: the heading drops behind the cards at 12vw and they travel across it. HOW THE STACKING ACTUALLY WORKS, because it is not obvious: .wcard carries z-index 100 and .fr--over only 6, which looks as though the cards already win. They do not — .wk__pin is position: sticky, and sticky always creates a stacking context, so the cards’ 100 is scoped inside the pin and never competes with the frame. What competes is the pin’s own z-index, which is auto. Dropping .fr--over from 6 to 0 puts it level with the pin, and the pin comes later in the document, so the work paints over the word. Verified: frame 0, pin auto and sticky, card 100. The heading is not dimmed to make room — same white, same size; the stills simply pass in front of it. Built on the live page as it now stands, the four corner labels already gone, so the frame holds nothing but this word. “SELECTED WORKS” uppercase at -0.045em measures 8.538px of ink per pixel of size; every figure is solved from that. Not repeated from ab-ps*, ab-rw* or ab-nv*: the common ink width, the statement rank, banded rules, a stacked number, the pan, flush right, hung to the viewport edge, two-line stack.'],
  'ab-wh4': ['The Selected works heading, four more', 'WH4 · The Spine', 'The heading turns ninety degrees and gives the whole measure back to the work. Bottom-to-top in the left margin at 4.4vw — measured 56.32px, running 524px up the page — tracked open to 0.01em because rotated type reads tighter than it measures. At 1280 it occupies x 10 to 66 and clears the grid’s first column by 10px, sitting entirely inside a 77px margin that was holding nothing. WHY THIS BELONGS TO THE ABOUT SYSTEM RATHER THAN ESCAPING IT: those headings are large because each introduces six hundred words that need announcing. This section’s content announces itself — it is the work, on screen, moving — so the heading’s job is to name the section, not to open it. A spine label names without occupying, which is what a book spine is for. Bottom-to-top is the European convention for Latin spine type and the direction this page already uses in ab-nv2 and ab-el2. Built on the live page as it now stands, the four corner labels already gone, so the frame holds nothing but this word. “SELECTED WORKS” uppercase at -0.045em measures 8.538px of ink per pixel of size; every figure is solved from that. Not repeated from ab-ps*, ab-rw* or ab-nv*: the common ink width, the statement rank, banded rules, a stacked number, the pan, flush right, hung to the viewport edge, two-line stack.'],
  'ab-wh3a': ['Behind the work, smaller', 'WH3A · The Mass Of Who I Am', '11.377vw, measured 145.63px and 1243.4px of ink — exactly the width of WHO I AM, which is the narrowest of the four About headings and the only one that does not run off the screen at 1280. Matching it makes Selected works the second heading on the page that fits. 5.2 per cent down from ab-wh3, and still inside the band the About movements occupy — the lightest of the four touches. Variations of ab-wh3, which puts the heading behind the conveyor so the stills travel across it. That draft’s stacking is kept: .wcard carries z-index 100 and .fr--over only 6, which looks as though the cards already win — they do not, because .wk__pin is position: sticky and sticky always creates a stacking context, so the cards’ 100 is scoped inside the pin and never competes with the frame. What competes is the pin’s own z-index, which is auto; dropping .fr--over from 6 to 0 puts it level with the pin, which comes later in the document. Only the size changes here. “SELECTED WORKS” uppercase at -0.045em is 8.538px of ink per pixel of size, and ab-wh3 sets 12vw — 153.6px, 1311.4px of ink, the mass of WHAT I’M AFTER at 1310.7.'],
  'ab-wh3b': ['Behind the work, smaller', 'WH3B · Twice The Statement', '10.8vw, measured 138.24px, which is 69.12 x 2 exactly — the About statement rank doubled. The page’s type has a 69.12 in it and then nothing until the display sizes; putting the works heading on a clean multiple of it gives that gap a rung. 1180.3px of ink, 10 per cent down, and the first of the four that reads as visibly under the About group rather than at its edge. Variations of ab-wh3, which puts the heading behind the conveyor so the stills travel across it. That draft’s stacking is kept: .wcard carries z-index 100 and .fr--over only 6, which looks as though the cards already win — they do not, because .wk__pin is position: sticky and sticky always creates a stacking context, so the cards’ 100 is scoped inside the pin and never competes with the frame. What competes is the pin’s own z-index, which is auto; dropping .fr--over from 6 to 0 puts it level with the pin, which comes later in the document. Only the size changes here. “SELECTED WORKS” uppercase at -0.045em is 8.538px of ink per pixel of size, and ab-wh3 sets 12vw — 153.6px, 1311.4px of ink, the mass of WHAT I’M AFTER at 1310.7.'],
  'ab-wh3c': ['Behind the work, smaller', 'WH3C · The Measure Exactly', '10.307vw, measured 131.93px and 1126.4px of ink against a measure of 1126.4 — 88vw, the grid’s own width. The heading spans the twelve columns and stops, neither cropped by the screen nor short of the edge. Behind the cards this reads differently than the same size does in ab-wh1, where it is flush and in front: here the word is exactly as wide as the field the work moves across. 14.1 per cent down. Variations of ab-wh3, which puts the heading behind the conveyor so the stills travel across it. That draft’s stacking is kept: .wcard carries z-index 100 and .fr--over only 6, which looks as though the cards already win — they do not, because .wk__pin is position: sticky and sticky always creates a stacking context, so the cards’ 100 is scoped inside the pin and never competes with the frame. What competes is the pin’s own z-index, which is auto; dropping .fr--over from 6 to 0 puts it level with the pin, which comes later in the document. Only the size changes here. “SELECTED WORKS” uppercase at -0.045em is 8.538px of ink per pixel of size, and ab-wh3 sets 12vw — 153.6px, 1311.4px of ink, the mass of WHAT I’M AFTER at 1310.7.'],
  'ab-wh3d': ['Behind the work, smaller', 'WH3D · One Step Of The Scale', '9.882vw, measured 126.49px, which is 12 x 1.4 to the seventh — 126.5. The labels are 12px and the body 16.8, and 16.8 / 12 is exactly 1.4, a modular scale already sitting under the page that nothing above it obeys. Continued upward it reaches 126.5, and this is the only draft where the works heading is a term in it. 1079.9px of ink against 1080.1 predicted, 17.6 per cent down, and the smallest of the four: the word becomes a caption to the work rather than a heading over it. Variations of ab-wh3, which puts the heading behind the conveyor so the stills travel across it. That draft’s stacking is kept: .wcard carries z-index 100 and .fr--over only 6, which looks as though the cards already win — they do not, because .wk__pin is position: sticky and sticky always creates a stacking context, so the cards’ 100 is scoped inside the pin and never competes with the frame. What competes is the pin’s own z-index, which is auto; dropping .fr--over from 6 to 0 puts it level with the pin, which comes later in the document. Only the size changes here. “SELECTED WORKS” uppercase at -0.045em is 8.538px of ink per pixel of size, and ab-wh3 sets 12vw — 153.6px, 1311.4px of ink, the mass of WHAT I’M AFTER at 1310.7.'],
  'ab-rp1': ['About, one size', 'RP1 · One Size, From The Right', 'All four headings at the size of What I work across — 13.5vw, 172.8px at 1280 — with the pan keeping its exact speed and each word entering at the right edge instead of halfway across. Set as font-size rather than --gs, because --gs is written inline on every h2 and an inline custom property beats a stylesheet one. THE REASON ONE SIZE NEEDS FOUR START POSITIONS: the old 27/13.5/23/18vw were not arbitrary — all four used to render about 1370px of ink, one common width of roughly 1.07 viewports solved four times for four word-lengths. Forcing one font size throws that away; measured at 13.5vw the inks are 675.1, 1349.9, 796.1 and 983.1px, so Who I am is half the width of What I work across and the old single 6vw start would have put it at x=153.6, a third across the screen. Each now starts at translateX = 1203.2 - ink: 41.26vw, -11.46, 31.80, 17.20. Verified right edges at 1280.1, 1280.0, 1279.9 and 1280.0 against a 1280 viewport. THE SPEED IS UNTOUCHED: every heading travels 24vw over range cover, measured at 307.2px each, identical to po-pan today, all finishing with their right edge at 972.8. Only animation-name is overridden — view(), cover, linear and fill both come from the page’s own rule, inside its own guards, and the var() fallbacks are 6vw and -18vw. At 375 the start sits 1.5px past the edge, which is --margin clamping to 24px (6.4vw, not 6).'],
  'ab-rp2': ['About, one size', 'RP2 · One Size, Matched To Live', 'Variation of RP1. RP1 started every heading with its right edge ON the right edge of the screen, which was too far in: What I work across is 1349.9px of ink in a 1280 viewport, so it began already cropped on the left and kept losing letters from the moment it was legible. Here the reference is the live page, measured — live What I work across is already 13.5vw and pans 6vw to -18vw, starting right edge 1503.5 and ending 1196.3, which puts its start 223.5px PAST the screen edge rather than on it. That overshoot is what gives it room to be read, and RP1 had removed it. So across is restored exactly and the other three are matched to its starting right edge of 117.4609vw: offset = 117.4609 minus the 6vw margin minus each heading’s own ink, giving 58.719, 6.000, 49.266 and 34.656vw. The across row resolving to exactly 6.000vw is the check the arithmetic is right — it is the live value, reached independently. MEASURED AT MID-PAN, where you actually read it: RP1 cut 223px off the LEFT of What I work across, so you lost the word What; RP2 cuts nothing off the left and 70 off the right, and matches live to the pixel at 0..1350 and 94.8 per cent visible. The cost: the three shorter headings were 100 per cent visible at mid-pan and are now cut 70px right — which buys all four right edges landing on the same 1350, one crop instead of four. Speed untouched: 24vw over cover, 307.2px, on every heading.'],
  'ab-wk1': ['Opening and Works, in the poster hand', 'WK1 · One Hand', 'Nothing moves; the furniture stops being set in a different typeface from the rest of the page. Measured, the corner labels were JetBrains Mono at --t-micro (10px) with 0.16em of tracking and text-transform: uppercase, while the About label row is the display face at 12px, weight 500, 0.005em, sentence case, tabular figures — same page, same job, two systems. These take the About row’s values, and .fr__t drops the capitals it was the last heading on the page still wearing. TWO THINGS DELIBERATELY NOT CHANGED: --bone-dim and the text-shadow. Unlike the About rows these labels sit directly on the photographic bed with no veil, and the stylesheet’s own note records #858585 at 2.4:1 against the brightest ground a tile can produce against --bone-dim at 5.9:1 — moving them to the poster’s rank must not quietly move them to the poster’s colour. The figures keep monospaced behaviour without the monospaced font: font-variant-numeric: tabular-nums is the only thing the mono was actually buying. Verified: family, 12px, 0.06px tracking, none, tabular-nums, shadow intact.'],
  'ab-wk2': ['Opening and Works, in the poster hand', 'WK2 · The Header Row', 'The four corners become the About sections’ label row, so the page opens the way all four movements do. Every About section starts on a hairline across twelve columns with labels hung at columns 1, 4 and 7; the hero and Selected works had the same four facts scattered into four corners instead. Here they come to the top edge at columns 1, 4, 7 and 10 under the same rule, 14px below it, which is what .po-grid’s padding-top gives its own labels. WHY CORNERS WERE WRONG FOR THIS PAGE and not wrong in general: four corner marks are a FRAME device, describing an edge, and they work when what is inside is a plate — a poster, a still, a title card. Below the fold this page stops being a plate and becomes a grid, and a frame around a grid is a different drawing. The positions are computed, not guessed: (n-1) x (colw + gutter) with colw = (100% - 11 gutters) / 12, the same expression .po-grid resolves — verified landing at 77, 364, 650 and 937 against computed columns of 77, 364, 650 and 937. Below 900 the base sheet turns .cn static and the row stops being a row, so the clearing padding is reverted and only the rule stays.'],
  'ab-wk3': ['Opening and Works, in the poster hand', 'WK3 · The Counter', 'The one piece of furniture that is genuinely data gets promoted and the rest stays put. 00/06 and 01/06 are the only strings in these corners a reader cannot work out from what is already on screen — the section name is written across the middle in 4-rem capitals, the place and the range both appear again in the About row, and the position in the sequence appears nowhere else. It was the smallest thing on the page at 10px; it goes to 4.4vw, measured 56.32px, in bone with lining tabular figures, the range sitting under it at label rank. A counter is the right thing to make large here because the page IS a numbered sequence — 00 through 06, numbered again as 02, 03, 04, 05 down the left edge of the About sections — and a reader’s first question on arriving somewhere is where am I, which an ordinal answers faster than a phrase. The other three corners take the poster’s label hand and do not move. At 375 the clamp floor holds it at 35.2px.'],
  'ab-wk4': ['Opening and Works, in the poster hand', 'WK4 · The Colophon', 'All four labels collapse into one corner and the frame gives up three of its marks. A poster does not caption its four edges; it puts the credits in one block, in one corner, and leaves the rest of the sheet to the image and the title. Number and section, place, counter and range, cue — stacked bottom left with a 12px gap, nothing at the other three corners, so the hero’s name and statement and the Selected works title get the entire field. Four corner marks pull the eye to the edges before it reaches the middle; one block sits under the middle and waits. It needs one wrapper and nothing else: the four paragraphs are already contiguous in both frames, so they go in a single flex column — no per-label bottom offsets to drift when one of them is a line shorter, which the works frame’s cue now is. THE WRAPPER HAD TO FOLLOW ITS CHILDREN: below 900 the base sheet sets .cn to position: static but .wk-col stayed absolute, and at 375 the block ran 371 to 581 straight through .fr__mid at 377 to 516, printing the labels over the name. Now static below 900, measured abutting at 421 with no overlap.'],
  'ab-qt1': ['About headings, quieter at the same size', 'QT1 · The Blend', 'mix-blend-mode: soft-light. The word stops being painted ON the page and starts taking its value FROM it — the letterforms lighten what is already there the way a wash lightens paper rather than covering it, so over the Smoked mosaic the heading is brighter where the photograph is brighter and nearly gone where it is dark. It can never be the highest-contrast thing on screen, because its contrast is bounded by the image’s own. WHY SOFT-LIGHT: multiply would darken a word on an already dark ground into nothing; overlay pivots on the BACKDROP’s value and would crush white toward black, varying violently by tile; soft-light pivots on the SOURCE, and white as a source lightens gently with a ceiling, which is exactly what a heading asked to be subtler wants. Verified: soft-light applies to the h2, and .po-sec is position: relative with z-index 2, so it does form the stacking context the blend resolves against. WHAT CANNOT BE SHOWN HERE: the rendered value depends on the photograph and this pane cannot sample a composited pixel. The variability is not a limitation of the draft, it is the draft.'],
  'ab-qt2': ['About headings, quieter at the same size', 'QT2 · The Dissolve', 'A vertical gradient painted through the letterforms with background-clip: text — full --po-white at the cap line, 62 per cent at the midpoint, 12 per cent at the baseline. The tops hold the line of the grid; the bottoms dissolve into the section. WHY DOWNWARD AND NOT UP: the heading sits directly above the twelve-column rule and the label row, so a word fading upward would carry its weight at the bottom, pressing on the grid it is supposed to introduce. Fading downward puts the mass in the empty margin above and leaves the lightest ink closest to the first line of type, so the eye crosses from heading to content without stepping over a hard edge. THE GRADIENT IS ON .po-pan AND THAT MATTERS: .po-giant is the grid’s width, 1126.4px, while the word runs to 1370px of ink and deliberately overflows it — a background on the h2 would be clipped to the h2’s box and the overflowing letters painted with nothing, which is to say invisible. .po-pan is exactly the word. It is also the element the pan transforms, which changes nothing: a background is not an animation.'],
  'ab-qt3': ['About headings, quieter at the same size', 'QT3 · The Wake', 'A horizontal mask so the trailing edge dissolves and the pan reads as movement rather than a slab being dragged. po-pan sweeps the word 24vw leftward; every letter currently has the same hard edge at both ends, which is why the motion reads as a solid object sliding. The word moves LEFT, so its left end is the one being left behind — the mask fades toward the left, the arriving edge stays crisp, the departing edge does not, which is how anything moving actually looks. It is a linear ramp across 30 per cent of the word, averaging half alpha over that stretch, so it removes about fifteen per cent of the apparent ink, not thirty — measured on What I work across: 1350px of ink, 405px of ramp. MASKED ON .po-pan, WHICH IS THE WORD ITSELF: on .po-giant the mask’s positioning area would be the h2’s 1126.4px box and everything overflowing it, which is most of the word, would be masked out entirely by mask-repeat: no-repeat. On .po-pan the fade is always the same FRACTION of the word, so Who I am and What I work across dissolve over the same proportion of themselves rather than the same number of pixels.'],
  'ab-qt4': ['About headings, quieter at the same size', 'QT4 · The Floor', 'The heading is set at the lowest value that still clears AA for large text, and not one step quieter. Not a guess: large text needs 3:1, and solving the WCAG ratio against --ground #0A0908, relative luminance 0.002774, gives a required text luminance of 0.108322, which is sRGB 92.5 — and white composited at alpha a over that ground is 10 + 245a, so a = 0.337. Set at rgba(255,255,255,0.34), three hundredths above the floor. Measured after: composites to sRGB 93,93,92 and 3.02:1 against the 3.00 the arithmetic asked for. WHERE IT SITS IN THE PAGE’S OWN SCALE: --po-white 19.9:1, --bone-dim 14.0, --po-grey 7.16, --po-rule 1.75 — so this lands quieter than every piece of type on the page and louder than the only mark quieter than type. The giant word becomes the step between the text and the rules, a rank the design did not have. WHY NOT GO TO THE RULE’S VALUE: 1.75:1 fails AA outright, and each heading is its section’s accessible name via aria-labelledby. A heading you cannot read is a different draft — ab-el8 makes that argument properly by removing it and promoting the number.'],
  'ab-qt3a': ['About headings, quieter at the same size', 'QT3A · The Wake, Both Ends', 'Variation on ab-qt3’s fade. QT3 softens the trailing edge only, but every one of these headings is WIDER THAN THE SCREEN by design — measured at 1280 the four inks are 1350, 1350, 1356 and 1311px in a 1280 viewport — so both ends are cropped by the window for most of the pan, and a hard edge at the window’s boundary reads as CUT OFF where a soft one reads as CONTINUING. Fading both ends turns an accident of width into the statement that the word runs past the page. WHY NOT SYMMETRICAL: the word travels left, so the left end is being left behind and the right end is arriving, and anything in motion has a softer trailing edge than leading edge — that was the whole reason QT3 faded the left. So the ramps are 30 per cent left and 16 right; equal ramps would read as a vignette, which is a framing device and says nothing about direction. Verified by integrating the ramp on a canvas: 23 per cent of the word’s ink removed, against QT3’s 15. Size, face and po-pan are untouched and checked.'],
  'ab-qt3b': ['About headings, quieter at the same size', 'QT3B · The Long Ease', 'The other two axes of QT3’s fade: how long, and what shape. The trailing fade runs across 58 per cent of the word rather than 30, so the heading is at full strength only in its leading third and gradates away across most of its length — and the ramp is EASED rather than linear, seven stops approximating an S-curve, flat at both ends and steepest in the middle. WHY LINEAR RAMPS LOOK WRONG: a linear alpha ramp does not read as linear, because perceived lightness is not linear in alpha — the first few per cent drop visibly while the last few do almost nothing, so the fade appears to START abruptly and then stall. Easing the ends puts the change where the eye can least detect its onset, which is why a cross-dissolve in film is never cut linear. The residual is genuinely zero at the far end rather than a ghost: a tail held at 0.14 alpha composites to 1.43:1 over --ground, below the threshold at which it reads as anything but noise, so it buys nothing and costs the cleanliness of an actual end. Verified by canvas integration: mean alpha 64.1 per cent, so 35.9 per cent of the ink removed, against QT3’s 15 and QT3A’s 23.'],
  'ab-ad1': ['One art direction, top to bottom', 'AD1 · The Poster Sequence', 'Three posters in a run, so the opening is the first of them rather than a cover for a different book. THE FINDING THE WHOLE SET RESTS ON: the opening is CENTRED — .ov__middle is a flex column with align-items: center and .ov__mast justifies centre — while every About movement is flush left on twelve columns. That single difference breaks the page in half more than any typeface or colour does, and all four drafts fix it first. Here the name stacks flush to the margin, UGAM over KHETANI at 16vw with line-height 0.82, and the statement drops from its own 2.7vw to the About statement’s rank exactly: 69.12px, line-height 0.98, tracking -0.04em, set across columns 6 to 12 so it answers the name across the gutter instead of sitting under it. Selected works takes display rank at 13.5vw on the same margin, so the run reads 00 NAME, 01 SELECTED WORKS, 02 WHO I AM at one scale and one alignment. The readout leaves the centre of the viewport for the grid’s left edge, still at a fixed width. The stills do not move: the type around them grows, so the ranking changes without a pixel of the conveyor shifting.'],
  'ab-ad2': ['One art direction, top to bottom', 'AD2 · The Archive', 'The page becomes a catalogue and the works section becomes its index. The readout stops being a centred caption under a picture and becomes a running entry: it moves to the right margin at a fixed 560px, the work’s name sets at 2.2vw flush right, and the year turns ninety degrees to run up beside it as a spine label — bottom-to-top, the convention for Latin spine type, tracked open because rotated type reads tighter than it measures. The opening becomes a title page: name flush left at 12vw, and the four corner labels collapse into one metadata column on columns 10 to 12, flush right against the grid’s outer edge the way a colophon sets a list of particulars. DENSITY AGAINST SILENCE — this is the only draft that deliberately crowds one part of the composition: six facts stacked at 12px on a 1.4 line, everything else given air. A catalogue page earns its white space by having somewhere dense to put the particulars; a page spaced evenly everywhere reads as under-designed rather than calm. Figures are tabular throughout, including the year, which is what makes a column of numbers look set rather than typed.'],
  'ab-ad3': ['One art direction, top to bottom', 'AD3 · The System Resolving', 'What a Swiss poster designer does with the one thing the sheet never had: the reader’s position in time. The most disciplined composition of the four — flush left, one rank per element, nothing cropped — and every part of it ARRIVES. Three scroll-driven layers on view() timelines: the frame’s hairline scales from 0 out of the left margin as the section enters, so the grid asserts itself before anything is set on it; the opening’s two words carry a -3.2vw displacement at entry and lock to the margin, which is a press idea (out of register, coming into it) not a web one; and Selected works takes the About headings’ own pan, 6vw to -18vw over range cover, so the one heading on the page that was static now moves the way the four below it do. NOTHING FADES UP AND NOTHING BOUNCES — every animation is a POSITION resolving, because the thing being communicated is a grid. Every keyframe ends where the static CSS already is, so reduced motion gets the finished composition and simply does not watch it assemble. Verified: three animations attached, po-pan still running at 4, the conveyor’s sticky pin intact.'],
  'ab-ad4': ['One art direction, top to bottom', 'AD4 · The Crop', 'Order and disruption, argued rather than decorated. The name sets at 26vw and overflows the margin on both sides; the statement goes to the outer margin and turns ninety degrees, running bottom-to-top in the strip the grid never uses; the section ordinal is pulled from the corner and set at 22vw behind everything at 8 per cent, aligned to the VIEWPORT rather than the measure — the one deliberate rule-break in the set; and Selected works rotates into the left margin as a spine at 4.4vw so the stills get the full width. TWO THINGS THIS DRAFT GOT WRONG AND THE MEASUREMENTS CAUGHT. First, .cn--tl is the ordinal AND the section’s name, so 22vw put "Selected works" at 22vw too and ran the section to scrollWidth 1357 on a 1280 viewport; the number is now wrapped so the name stays at label rank. Second, the note claimed the section already clipped horizontally — it does not: overflow-x is visible on .ov, .fr--hero and .sec--works, and only .mvt.po-sec clips, which is exactly why the About headings can run off the side and this one could not. Both frames now carry overflow-x: clip — clip and not hidden, so the conveyor’s sticky pin is not put inside a new scrollport. Verified sticky after.'],
  'ab-vx': ['One art direction, top to bottom', 'VX · Eight Directions, One Page', 'Eight art directions for the opening and Selected works, built as ONE page rather than eight copies. Press 0 to 8, or use the strip at the bottom left — 0 is the live page untouched, so every direction compares against it and against each other without a reload; the choice is kept in sessionStorage. Forty drafts in this library are each a full copy of index.astro, which is right for one proposal and wrong for a set meant to be judged side by side: you cannot see a difference you have to navigate to. Each direction is a block under :root[data-v=”n”] and switching is one attribute write. THE METHOD: the About movements are not a style, they are six decisions — the page is a sequence of numbered movements; type is set at two extremes with almost no middle; the largest element is always partly outside the frame; structure is drawn once and trusted; the image is ground, never figure; motion is one gesture tied to position. Each direction takes ONE of them as its generating principle and follows it across the whole page. 1 The Stave, 2 The Measure, 3 The Missing Middle, 4 The Contact Sheet, 5 The Travelling Window, 6 The Margin, 7 The Cadence, 8 The Silence. Four measured faults are fixed in all eight as a floor rather than as an idea: the opening was CENTRED where every About movement is flush left; the corner furniture was 10px JetBrains Mono against the label row’s 12px display face; the titles were uppercase where no .po-giant is; and the readout was centred on the viewport rather than the grid. Verified across all nine states at 1280 and 375: scrollWidth equal to the viewport, 2601 non-whitespace characters excluding the switcher — identical to live in every direction — and the conveyor’s sticky pin intact. Direction 2 measures 5, 5, 3, 1.5 and 0.5 multiples of the 23.856px unit. Two claims were corrected after measuring: direction 3 has a fourth size, em.hot at 73.2672, which is a 6 per cent optical correction for Fraunces and not a rank; and direction 8 removes 9 drawn rules of 175, not “every rule”.'],
};const pretty = (s: string) =>
  s.replace(/-/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase());

const groups = new Map<string, { slug: string; title: string; note: string }[]>();
for (const slug of pages) {
  const [group, title, note] = NOTES[slug] ?? ['Unfiled', pretty(slug), ''];
  if (!groups.has(group)) groups.set(group, []);
  groups.get(group)!.push({ slug, title, note });
}
---

<Base title="Previews — Ugam Khetani">
  <main class="pv">
    <header class="pv__hd">
      <p class="mono pv__eyebrow">Previews</p>
      <h1 class="pv__t">Drafts</h1>
      <p class="pv__lede">
        Design options built as real pages, to be judged in the browser rather
        than described. Nothing here is on the live site unless it says so.
      </p>
      <p class="mono pv__count">{pages.length} {pages.length === 1 ? 'draft' : 'drafts'}</p>
    </header>

    {[...groups].map(([group, items]) => (
      <section class="pv__grp" aria-label={group}>
        <p class="mono pv__grpname">{group}</p>
        <ul class="pv__list">
          {items.map((it) => (
            <li class="pv__row">
              <a class="pv__a" href={`/preview/${it.slug}`}>
                <span class="pv__name">{it.title}</span>
                <span class="mono pv__slug">{it.slug}</span>
                {it.note && <span class="pv__note">{it.note}</span>}
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}

    <p class="mono pv__back"><a href="/">&larr; Back to the site</a></p>
  </main>
</Base>

<style>
  .pv {
    max-width: min(860px, 100%);
    margin-inline: auto;
    padding: clamp(96px, 15vh, 190px) var(--margin) clamp(80px, 14vh, 180px);
  }
  .pv__eyebrow {
    margin: 0 0 clamp(18px, 3vh, 30px);
    font-size: var(--t-micro); letter-spacing: 0.16em;
    text-transform: uppercase; color: var(--dim);
  }
  .pv__t {
    margin: 0 0 clamp(18px, 3vh, 28px);
    font-family: var(--display); font-weight: 500;
    font-size: clamp(2.4rem, 7vw, 4.2rem); line-height: 1; letter-spacing: -0.03em;
  }
  .pv__lede { margin: 0 0 14px; max-width: 52ch; font-size: var(--t-md); color: var(--bone-dim); }
  .pv__count { margin: 0 0 clamp(56px, 9vh, 110px); font-size: var(--t-micro); color: var(--dim); }

  .pv__grp { margin-bottom: clamp(52px, 8vh, 96px); }
  .pv__grpname {
    margin: 0 0 clamp(14px, 2vh, 20px); padding-bottom: 12px;
    border-bottom: 1px solid var(--rule);
    font-size: var(--t-micro); letter-spacing: 0.16em;
    text-transform: uppercase; color: var(--bone-dim);
  }
  .pv__list { list-style: none; margin: 0; padding: 0; }
  .pv__row { border-bottom: 1px solid var(--rule); }
  .pv__a {
    display: grid; grid-template-columns: minmax(0, 1fr) auto;
    gap: 4px clamp(16px, 3vw, 40px); align-items: baseline;
    padding-block: clamp(16px, 2.4vh, 24px);
    text-decoration: none; color: var(--bone);
  }
  .pv__name { font-size: var(--t-md); }
  .pv__slug { font-size: var(--t-micro); color: var(--dim); text-align: right; }
  .pv__note {
    grid-column: 1 / -1; max-width: 60ch;
    font-size: var(--t-sm); color: var(--bone-dim); line-height: 1.5;
  }
  .pv__a:hover .pv__name { text-decoration: underline; text-underline-offset: 4px; }
  .pv__a:hover .pv__slug { color: var(--bone-dim); }

  .pv__back { margin: 0; font-size: var(--t-micro); }
  .pv__back a { color: var(--dim); text-decoration: none; }
  .pv__back a:hover { color: var(--bone); }
</style>
