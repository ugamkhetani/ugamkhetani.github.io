---
/**
 * MUMBAI STANDARD TIME · DESCRIPTION DRAFT Y — Proximity   [interactive]
 *
 * ONE OF FOUR asked for on 2026-09-07: two that add movement and two that add
 * interaction. Nothing here is on the live site.
 *
 * A light travels with the pointer and the nearest words come up to white.
 * Positions are cached once, so a move costs no layout at all.
 *
 * THE LAYOUT IS THE LIVE PAGE'S, TO THE DECLARATION. That was the brief and
 * it is the constraint every choice below answers to. The markup is draft A
 * as applied — the same wrapper, the same standfirst with its --n derived
 * size and measure, the same word spans carrying [data-w] — and the type
 * rules further down are copied from src/pages/work/[slug].astro rather than
 * rewritten. The only additions are a modifier class on the wrapper and, for
 * two of the four, one attribute on each word.
 *
 * SO NOTHING HERE CAN REFLOW. Every effect is opacity, transform, filter or a
 * custom property: none of them participates in layout, so a line breaks in
 * exactly the place it breaks on the live page at every moment of every
 * animation. A weight or size ramp would have been the obvious way to make
 * type feel alive and is precisely what is ruled out — it would relayout the
 * standfirst under the reader, and the standfirst's size is already derived
 * from its own character count.
 *
 * MOTION IS NEVER A DEPENDENCY. Every default in the CSS is the FINISHED
 * state — var(--v, 1), never var(--v, 0) — so reduced motion, or JavaScript
 * that never runs, gives the settled paragraph rather than an empty box.
 */
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import OpNav from '../../components/OpNav.astro';
import VideoFacade from '../../components/VideoFacade.astro';
import { framesFor } from '../../lib/frames';

const works = await getCollection('works');
const work = works.find((w) => w.id === 'mumbai-standard-time')!;
const d = work.data;
const poster = framesFor(work.id, d.frames)[0];
const AR = d.ratio.replace(':', ' / ');
const ROLES = d.role.split('/').map((r) => r.trim()).filter(Boolean);

/* The live split, verbatim: standfirst, remainder, and both in words. */
const SENT = d.description.trim().split(/(?<=\.)\s+/).filter(Boolean);
const LEDE = SENT[0] ?? d.description.trim();
const REST = SENT.slice(1).join(' ');
const LW = LEDE.split(/\s+/).filter(Boolean);
const RW = REST ? REST.split(/\s+/).filter(Boolean) : [];

const FAM = ['a', 'b', 'g', 'u', 'v', 'w', 'x', 'y'];
const HERE = 'y';
---

<Base title={`${d.title} — description Y`} description={d.description}>
  <OpNav variant="bracket" base="/" />

  <article class="sc" data-sc-ds style={`--ar:${AR}`}>
    <header class="hd">
      <p class="mono hd__over">{d.category} · {d.overline ?? d.year}</p>
      <h1 class="hd__t">{d.title}</h1>
      <p class="mono hd__meta">
        <span class="hd__roles">
          {ROLES.map((r, i) => (<>{i > 0 && <i class="hd__bar" aria-hidden="true"></i>}<span>{r}</span></>))}
        </span>
      </p>
    </header>

    <section class="q" aria-label="Statement">
      <p class="q__t">{d.quote}</p>
    </section>

    <section class="blk" aria-label="The work">
      <VideoFacade youtube={d.media.youtube} title={d.title} poster={poster} alt={d.alt} eager />
    </section>

    <section class="blk" aria-label="Description">
      <div class="body body--y">
        <p class="body__lede" style={`--n:${LEDE.length}`}>
          {LW.map((w, i) => (<><span class="w" data-w>{w}</span>{i < LW.length - 1 ? ' ' : ''}</>))}
        </p>
        {RW.length > 0 && (
          <p class="body__rest">
            {RW.map((w, i) => (<><span class="w" data-w>{w}</span>{i < RW.length - 1 ? ' ' : ''}</>))}
          </p>
        )}
      </div>
    </section>

    <nav class="mono flip" aria-label="Drafts">
      {FAM.map((l) => (
        <a class={l === HERE ? 'flip__a is-here' : 'flip__a'} href={`/preview/mst-desc-${l}`}>{l.toUpperCase()}</a>
      ))}
      <a class="flip__all" href="/preview/">All drafts &rarr;</a>
    </nav>
  </article>
</Base>

<style>
  /* ── THE LIVE PAGE'S TYPE, copied from src/pages/work/[slug].astro. If the
     live rules change, change these too or the comparison stops being one. */
  .sc { --measure: min(760px, 100%); padding: clamp(96px, 15vh, 190px) var(--margin) 0; }
  .sc { --film: max(var(--measure), calc(100vw - 3 * var(--margin))); }
  .hd, .q, .blk { max-width: var(--measure); }
  .hd { margin-inline: auto; text-align: center; }
  .hd__over {
    margin: 0 0 clamp(24px, 4vh, 48px);
    font-size: var(--t-micro); letter-spacing: 0.16em;
    text-transform: uppercase; color: var(--dim);
    font-variant-numeric: tabular-nums;
  }
  .hd__t {
    margin: 0;
    font-family: var(--display); font-weight: 500;
    font-size: clamp(2.6rem, 10vw, 7.25rem);
    line-height: 0.86; letter-spacing: -0.05em;
    text-transform: uppercase; color: var(--bone);
  }
  .hd__meta {
    display: flex; justify-content: center; flex-wrap: wrap;
    margin: clamp(28px, 4.6vh, 50px) 0 0;
    font-family: var(--mono);
    font-size: var(--t-micro); letter-spacing: 0.16em;
    text-transform: uppercase; color: var(--dim);
  }
  .hd__roles { display: inline-flex; align-items: center; flex-wrap: wrap; justify-content: center; row-gap: 8px; }
  .hd__bar { display: inline-block; width: 1px; height: 7px; margin-inline: clamp(10px, 1.8vw, 16px); background: var(--rule); }
  .q { max-width: 1180px; margin: clamp(80px, 14vh, 180px) auto; text-align: center; }
  .q__t {
    margin: 0 auto; max-width: 20ch;
    font-family: var(--display); font-weight: 500;
    font-size: clamp(1.9rem, 5.4vw, 4.4rem);
    line-height: 1.02; letter-spacing: -0.045em;
    color: var(--bone);
  }
  .blk { margin: 0 auto clamp(72px, 12vh, 160px); }
  .blk :global(.facade) { width: var(--film); margin-inline: calc((100% - var(--film)) / 2); }

  /* ── A · STANDFIRST, EXACTLY AS APPLIED. Not re-typed by hand: these are the
     live declarations, including the standfirst's derived measure and its
     size, which is capped by the viewport as well as by --n. */
  .body { margin: 0; }
  .body__lede {
    margin: 0 0 clamp(22px, 3.4vh, 40px);
    max-width: clamp(20ch, calc(var(--n, 90) / 3 * 1ch), 44ch);
    font-family: var(--display); font-weight: 500;
    font-size: clamp(
      1.2rem,
      min(calc(2.35rem - (var(--n, 90) - 55) * 0.007rem), calc(1.05rem + 2.1vw)),
      2.2rem
    );
    line-height: 1.12; letter-spacing: -0.025em;
    color: var(--bone); text-wrap: balance;
  }
  .body__rest {
    margin: 0; max-width: 54ch;
    font-size: clamp(1.05rem, 1.6vw, 1.25rem);
    line-height: 1.62; letter-spacing: -0.006em;
    color: var(--bone-dim); text-wrap: pretty;
  }
  .w {
    display: inline-block;
    opacity: calc(0.12 + var(--v, 1) * 0.88);
    transform: translateY(calc((1 - var(--v, 1)) * 0.32em));
    will-change: opacity, transform;
  }

  /* ── WHAT THIS DRAFT ADDS ───────────────────────────────────── */
  /* Y · PROXIMITY. A light travels with the pointer and the words nearest it
     come up to white, falling off with distance.

     THE POSITIONS ARE CACHED, WHICH IS THE ENTIRE PERFORMANCE STORY. The
     obvious implementation reads getBoundingClientRect on every word on every
     pointermove — sixty-nine forced layouts a frame, which is how a page comes
     to stutter only on the reviewer's machine. Here each word's centre is
     measured ONCE after load and again on resize; a move then costs
     sixty-nine subtractions and one style write each, and no layout at all.

     --p IS A SECOND LIGHT, NOT A REPLACEMENT. The word's opacity is the
     larger of the scroll light and the pointer light, so the pointer can only
     ever ADD brightness: the scroll reveal still runs underneath, and a
     reader who never moves a pointer sees exactly the live page.

     THE RADIUS IS 150px, which at this size covers three or four words rather
     than one. A tighter light picks out single words and reads as a cursor
     effect; this reads as a lamp held over the page, which is the thing worth
     having on a page whose whole scroll behaviour is already called a reading
     light. */
  .body--y .w {
    opacity: max(calc(0.12 + var(--v, 1) * 0.88), var(--p, 0));
    transition: opacity 160ms linear;
  }

  @media (prefers-reduced-motion: reduce) {
    .body, .body * {
      transition: none !important; animation: none !important;
      transform: none !important; filter: none !important; opacity: 1 !important;
    }
  }

  /* ── FLIPPING BETWEEN THE DRAFTS ────────────────────────────── */
  .flip {
    display: flex; justify-content: center; align-items: center; flex-wrap: wrap; gap: 8px;
    margin: clamp(60px, 10vh, 120px) auto;
    font-size: var(--t-micro); letter-spacing: 0.14em; text-transform: uppercase;
  }
  .flip__a {
    display: grid; place-items: center;
    min-width: 30px; height: 30px; padding-inline: 8px;
    border: 1px solid var(--rule); color: var(--dim); text-decoration: none;
  }
  .flip__a:hover { border-color: var(--bone-dim); color: var(--bone); }
  .flip__a.is-here { border-color: var(--accent); color: var(--accent); }
  .flip__all { margin-left: 14px; color: var(--dim); text-decoration: none; }
  .flip__all:hover { color: var(--bone); }
</style>

<script>
  /* THE LIVE PAGE'S CLOCK, cut down to this draft and extended by one line.

     A --v is how far an element's top has risen past a line two thirds down
     the window, normalised over a third of a screen. Everything visual is
     derived from that one number, so nothing can be half-lifted and fully lit
     at once, and scrolling back up reverses it exactly. A value is written
     only when it changes by enough to see.

     REDUCED MOTION OPTS OUT ENTIRELY and leaves every default of 1 in place,
     which is the finished state rather than the empty one. */
  function initDs() {
    const root = document.querySelector('[data-sc-ds]');
    if (!root || root.dataset.bound) return;
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    root.dataset.bound = '1';
    const items = Array.from(root.querySelectorAll('[data-w]'));
    const lede = root.querySelector('.body__lede');
    if (!items.length) return;
    const last = new WeakMap();
    let raf = 0;
    const paint = () => {
      raf = 0;
      const line = innerHeight * 0.66, span = innerHeight / 3;
      const at = (el) => Math.min(1, Math.max(0, (line - el.getBoundingClientRect().top) / span));
      for (const el of items) {
        const v = at(el);
        const prev = last.get(el);
        if (prev !== undefined && Math.abs(prev - v) < 0.02) continue;
        last.set(el, v);
        el.style.setProperty('--v', v.toFixed(3));
      }
      /* The standfirst's own progress, for the drafts that move it as a whole
         rather than word by word. */
      if (lede) lede.style.setProperty('--vl', at(lede).toFixed(3));
    };
    const tick = () => { if (!raf) raf = requestAnimationFrame(paint); };
    paint();
    addEventListener('scroll', tick, { passive: true });
    addEventListener('resize', tick, { passive: true });
    /* Measure once, then never again until the box changes. */
    const wrap = document.querySelector('.body--y');
    if (wrap) {
      const words = Array.from(wrap.querySelectorAll('.w'));
      let pts = [];
      const measure = () => {
        pts = words.map((el) => {
          const r = el.getBoundingClientRect();
          return { el, x: r.left + r.width / 2 + scrollX, y: r.top + r.height / 2 + scrollY };
        });
      };
      const R = 150;
      let raf = 0, mx = -1e5, my = -1e5;
      const paint = () => {
        raf = 0;
        for (const p of pts) {
          const dx = p.x - mx, dy = p.y - my;
          const d = Math.sqrt(dx * dx + dy * dy);
          const v = d > R ? 0 : 1 - d / R;
          p.el.style.setProperty('--p', v.toFixed(3));
        }
      };
      const tick = () => { if (!raf) raf = requestAnimationFrame(paint); };
      addEventListener('pointermove', (e) => { mx = e.pageX; my = e.pageY; tick(); }, { passive: true });
      wrap.addEventListener('pointerleave', () => { mx = my = -1e5; tick(); });
      addEventListener('resize', () => { measure(); tick(); }, { passive: true });
      measure();
    }
  }
  initDs();
  document.addEventListener('astro:page-load', initDs);
</script>
