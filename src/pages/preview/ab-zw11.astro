---
/**
 * ZW11 · THE LOCKUP — A ring beside the stack, centred on the block
 *
 * THE PLAYER'S OWN SHAPE: a ring, then the label. It is the arrangement every
 * transport control has used since tape, and the one a reader needs no
 * instruction to understand — the circle is the thing you press and the words
 * tell you what it does.
 *
 * THE RING IS 44px, DOWN FROM ZW9's 72, because it no longer has a whole
 * frame to hold its own against; it is sized to the block beside it. It is
 * centred on the FULL two-tier stack rather than on the big word, so the
 * lockup has one horizontal axis through it and the label hangs off that axis
 * evenly above and below.
 *
 * <- THAT CENTRING IS THE DEBATABLE PART. Centred on the block, the ring sits
 *   slightly low against "ZEE5" because the micro label above it is much
 *   shorter than the display line below. Centring it on the big word instead
 *   is one property, and it is the obvious thing to try if this reads as
 *   sagging. *
 * FOUR MORE ON UGAM'S BRIEF OF 2026-10-06: ZW2's stack with a minimal, modern
 * play mark set ALONGSIDE THE TEXT rather than in the middle of the frame.
 * ZW9 and ZW10 answered the centred version; these four answer the other one,
 * and they vary in a single thing — where the mark meets the type.
 *
 * SO THE ANCHOR IS THE LOCKUP AGAIN, NOT THE FRAME. ZW9 and ZW10 had to make
 * the whole still the link, because a mark in the middle and a label in the
 * corner are two affordances and two anchors would have been two tab stops
 * for one URL. With the mark brought into the lockup there is only one object
 * to press, so the anchor shrinks back to it: a small target, a focus ring
 * that fits the control, and the picture is a picture again.
 *
 * THE CORNER IS WHY A BARE MARK WORKS HERE. The bottom-left is the darkest
 * region of the frame — the live button's own box measures mean .0077 and p95
 * .0168, white at 18.2:1 and 15.7:1 — and ZW2's three inks read 14.22, 12.82
 * and 10.70:1 against the worst pixel each one covers. So the ring in these is
 * never a legibility device, the way it would have to be on a bright frame. It
 * is a question of form only, which is what makes ZW11 and ZW12 a fair pair.
 *
 * <- THE ↗ STAYS IN ALL FOUR, and it is one deletion per file if it should
 *   not. The reasoning is the one recorded in ZW9: Aasha's opening is `still`,
 *   there is no video on this page, and the mark opens ZEE5 in a new tab. A
 *   play triangle promises inline playback, and the ↗ is the site's own mark
 *   for leaving — with the triangle now sitting in the same lockup, it is the
 *   only thing in that lockup saying the press goes elsewhere. Whether two
 *   marks in one small object is one too many is a real question and it is
 *   ORTHOGONAL to the four below: answer it once and it applies to all of
 *   them. Dropping it leaves the words "WATCH ON ZEE5", which do say where
 *   you are going, in type rather than in a glyph.
 *
 * ZW11's OWN FIGURES. The lockup is 202.3x73.3 — 64px wider than ZW2's 138.3,
 * all of it the ring and its gap. The ring is 44x44 and reads 13.97:1 against
 * the worst pixel under it; the 11x13 triangle inside reads 14.74:1; the
 * micro label 9.39:1. At 375 the ring is 36x36 and the lockup 136x53.
 *
 * MEASURED ON THE BUILT SITE AT 1280x800, TRANSITIONS COLLAPSED, then at 375.
 * One link on the frame, accessible name "Watch on ZEE5", the mark
 * `aria-hidden="true"`, the anchor clickable at its own centre, the lockup
 * inside the frame at the margin inset of 76.8 and 76.8, and no horizontal
 * overflow at 375.
 *
 * <- THE MARK PUSHES THE WORD INTO BRIGHTER PICTURE, AND THAT IS THE ONE COST
 *   THE WHOLE FAMILY SHARES. In ZW2 "ZEE5" spans x 76.8-193.8 of the still
 *   and reads 12.82:1 against the worst pixel it covers. Add a mark to its
 *   left and the word starts further in: in ZW11 it spans 140.8-257.8 and
 *   reads 5.02:1. ZW12 and ZW13 displace it less but land on the same bright
 *   patch and measure 5.02:1 as well.
 *
 *   It passes — the floor for text at 51.2px is 3:1, so there is two thirds
 *   of headroom — and it is still worth knowing, because it is invisible and
 *   it is not a property of the mark. It is a property of WHERE THE WORD ENDS
 *   UP. ZW14 is the only one of the four that does not pay it: by growing
 *   upward rather than sideways it leaves "ZEE5" where ZW2 had it, at
 *   12.82:1.
 */

import Base from '../../layouts/Base.astro';
import OpNav from '../../components/OpNav.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { framesFor } from '../../lib/frames';
import { href } from '../../lib/href';

const works = await getCollection('works');
const work = works.find((w) => w.id === 'aasha')!;
const d = work.data;
const images = framesFor('aasha', d.frames);
const poster = images[0];

/* THE REAL LINK, from the markdown. Aasha's `external` is ZEE5 — platform,
   label and url — and every draft uses it as written. Nothing here invents a
   platform, a label or a destination. */
const EXT = d.external!;

const ROLES = d.role.split('·').map((r) => r.trim());
const QW = (d.quote ?? '').split(' ').filter(Boolean);
/* The first sentence, as the live page takes it. The regex lives here and not
   in the markup: a regex literal inside an Astro template expression is
   parsed as JSX and fails the build (HANDOFF §6). */
const LEDE = (d.description.trim().match(/^[^.!?]+[.!?]/) ?? [d.description.trim()])[0];

const ME = 'zw11';
const DRAFTS: [string, string, string][] = [
  ['zw1', 'The rule', 'A hairline across the frame, the label under it'],
  ['zw2', 'The stack', 'Two sizes, flush left, nothing drawn'],
  ['zw3', 'The field', 'The page grid made visible, the link held by it'],
  ['zw4', 'The band', 'A flat accent plane, type knocked out'],
  ['zw5', 'The spine', 'Set vertically up the frame’s left edge'],
  ['zw6', 'The plate', 'Off the picture, a ruled caption beneath it'],
  ['zw7', 'The marks', 'Crop marks, the label registered between them'],
  ['zw8', 'The block', 'The facts as a ruled data table'],
  ['zw9', 'The gate', 'ZW2 with a ruled play mark in the middle of the frame'],
  ['zw10', 'The mark', 'ZW2 with a bare triangle, no ring at all'],
  ['zw11', 'The lockup', 'A ring beside the stack, centred on the block'],
  ['zw12', 'The bare', 'The same lockup with the ring taken away'],
  ['zw13', 'The inline', 'The triangle set inside the line of type'],
  ['zw14', 'The lead', 'The mark above the label, a three-tier column'],
];
const MINE = DRAFTS.find(([id]) => id === ME)!;
---

<Base title={`${d.title} · ${MINE[1]} — watch ${ME.toUpperCase()}`} description={`A Swiss-poster reading of the watch control on the Aasha project page: ${MINE[2]}.`}>
  <OpNav variant="bracket" base={href()} />

  <nav class="sw" aria-label="Watch-button drafts">
    <span class="sw__id">{ME.toUpperCase()}</span>
    <span class="sw__nm">{MINE[1]}</span>
    <span class="sw__su">{MINE[2]}</span>
    <span class="sw__set">
      {DRAFTS.map(([id, name, sub]) => (
        <a class:list={['sw__i', { 'is-here': id === ME }]} href={href(`preview/ab-${id}`)}
          title={`${name} — ${sub}`} aria-current={id === ME ? 'page' : undefined}>{id.slice(2)}</a>
      ))}
      <a class="sw__prev" href={href('work/aasha')} title="The live page, for comparison">LIVE</a>
    </span>
  </nav>

  <article class="sc">
    <header class="hd">
      <p class="mono hd__over">{d.category} · {d.overline ?? d.year}</p>
      <h1 class="hd__t">{d.title}</h1>
      <p class="mono hd__meta">
        <span class="hd__roles">
          {ROLES.map((r, i) => (<>{i > 0 && <i class="hd__bar" aria-hidden="true"></i>}<span>{r}</span></>))}
        </span>
      </p>
    </header>

    {QW.length > 0 && (
      <section class="q" aria-label="Statement">
        <p class="q__t">{d.quote}</p>
      </section>
    )}

    <!-- ══ 01 · THE WORK — THE DRAFT IS THE CONTROL ON THIS STILL ═══ -->
    <section class="blk" aria-label="The work">
      <div class="still">
        <Image src={poster} alt={d.alt} widths={[800, 1400, 2000]} sizes="(max-width: 900px) 100vw, 78vw" loading="eager" decoding="async" />
        <a class="zw11" href={EXT.url} target="_blank" rel="noopener noreferrer">
          <span class="zw11__mark" aria-hidden="true"><i class="zw11__tri"></i></span>
          <span class="zw11__t">
            <span class="zw11__k">Watch on</span>
            <span class="zw11__p">{EXT.platform}<i class="zw11__a" aria-hidden="true">&nearr;</i></span>
          </span>
        </a>
      </div>
    </section>

    <section class="blk body" aria-label="About the work">
      <p class="body__lede">{LEDE}</p>
    </section>
  </article>
</Base>

<style>
  /* ══ THE SWITCHER — the stills rounds' bar, unchanged ═════════ */
  .sw {
    position: fixed; inset: 0 0 auto; z-index: 900;
    display: flex; align-items: baseline; gap: 12px;
    padding: 9px clamp(16px, 4vw, 40px);
    background: color-mix(in srgb, var(--ground) 86%, transparent);
    backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--rule);
    font-family: var(--mono); font-size: var(--t-micro);
    letter-spacing: 0.16em; text-transform: uppercase;
  }
  .sw__id { color: var(--accent); }
  .sw__nm { color: var(--bone); }
  .sw__su { color: var(--dim); margin-right: auto; }
  .sw__set { display: flex; gap: 1px; align-items: baseline; }
  .sw__i { color: var(--dim); text-decoration: none; padding: 3px 7px; border: 1px solid transparent; font-variant-numeric: tabular-nums; }
  .sw__i:hover { color: var(--bone); }
  .sw__i.is-here { color: var(--accent); border-color: var(--rule); }
  .sw__prev { color: color-mix(in srgb, var(--dim) 70%, var(--ground)); text-decoration: none; padding: 3px 6px; margin-left: 4px; }
  .sw__prev:hover { color: var(--bone); }

  /* ══ THE WORK PAGE'S OWN HARNESS — the settled values ════════ */
  .sc {
    --measure: min(760px, 100%);
    --film: max(var(--measure), calc(100vw - 3 * var(--margin)));
    padding: clamp(96px, 15vh, 190px) var(--margin) 0;
  }
  .hd, .q, .blk { max-width: var(--measure); }
  .hd { margin-inline: auto; text-align: center; }
  .hd__over {
    margin: 0 0 clamp(24px, 4vh, 48px);
    font-size: var(--t-micro); letter-spacing: 0.16em;
    text-transform: uppercase; color: var(--dim);
    font-variant-numeric: tabular-nums;
  }
  .hd__t {
    margin: 0;
    font-family: var(--display); font-weight: 500;
    font-size: clamp(2.6rem, 10vw, 7.25rem);
    line-height: 0.86; letter-spacing: -0.05em;
    text-transform: uppercase; color: var(--bone);
  }
  .hd__meta {
    display: flex; justify-content: center; flex-wrap: wrap;
    margin: clamp(28px, 4.6vh, 50px) 0 0;
    font-size: var(--t-micro); letter-spacing: 0.16em;
    text-transform: uppercase; color: var(--dim);
  }
  .hd__roles { display: inline-flex; align-items: center; flex-wrap: wrap; justify-content: center; row-gap: 8px; }
  .hd__bar { display: inline-block; width: 1px; height: 7px; margin-inline: clamp(10px, 1.8vw, 16px); background: var(--rule); }
  .q { margin: clamp(80px, 14vh, 180px) auto; text-align: center; }
  .q__t {
    margin: 0 auto; max-width: 20ch;
    font-family: var(--display); font-weight: 500;
    font-size: clamp(1.9rem, 5.4vw, 4.4rem);
    line-height: 1.02; letter-spacing: -0.045em; color: var(--bone);
  }
  .blk { margin: 0 auto clamp(72px, 12vh, 160px); }
  .body__lede {
    margin: 0; font-size: var(--t-md); line-height: 1.6;
    color: var(--bone-dim); max-width: 44ch;
  }

  /* THE BARE STILL TAKES --film, as it does live, so the control is judged at
     the width it will actually have: 1049.6px at 1280, 787.2 tall at 4:3. */
  .still { position: relative; }
  .blk .still { width: var(--film); margin-inline: calc((100% - var(--film)) / 2); }
  .still :global(img) { width: 100%; height: auto; display: block; }

  /* ══ ZW11 · THE LOCKUP ════════════════════════════ */
  .zw11 {
    position: absolute; left: var(--margin); bottom: var(--margin);
    display: flex; align-items: center; gap: 20px;
    text-decoration: none; color: var(--bone);
  }
  .zw11__mark {
    flex: none; width: 44px; height: 44px;
    border: 1px solid rgba(255, 255, 255, 0.7); border-radius: 50%;
    display: grid; place-items: center;
    transition: border-color var(--d-micro) var(--ease), transform var(--d-micro) var(--ease);
  }
  .zw11__tri {
    width: 11px; height: 13px; background: var(--bone);
    clip-path: polygon(0 0, 100% 50%, 0 100%);
    margin-left: 2px; /* ← optical centring: a triangle's mass sits a third
                           from its base, so a centred box reads as left */
  }
  .zw11:hover .zw11__mark, .zw11.is-hover .zw11__mark {
    border-color: var(--bone); transform: scale(1.08);
  }
  .zw11__t { display: flex; flex-direction: column; align-items: flex-start; gap: 10px; }
  .zw11__k {
    font-family: var(--mono); font-size: var(--t-micro);
    letter-spacing: var(--track-mono); text-transform: uppercase;
    color: var(--bone-dim); transition: color var(--d-micro) var(--ease);
  }
  .zw11:hover .zw11__k, .zw11.is-hover .zw11__k { color: var(--bone); }
  .zw11__p {
    position: relative;
    font-family: var(--display); font-weight: 500;
    font-size: clamp(2rem, 4.4vw, 3.2rem);
    line-height: 0.92; letter-spacing: -0.04em; text-transform: uppercase;
  }
  .zw11__p::after {
    content: ''; position: absolute; left: 0; right: 0; bottom: -0.1em; height: 2px;
    background: currentColor; transform: scaleX(0); transform-origin: left;
    transition: transform var(--d-micro) var(--ease);
  }
  .zw11:hover .zw11__p::after, .zw11.is-hover .zw11__p::after { transform: scaleX(1); }
  .zw11__a {
    font-style: normal; font-size: 0.34em; vertical-align: 0.9em;
    margin-left: 0.34em; display: inline-block;
    transition: transform var(--d-micro) var(--ease);
  }
  .zw11:hover .zw11__a, .zw11.is-hover .zw11__a { transform: translate(3px, -3px); }
  @media (prefers-reduced-motion: reduce) {
    .zw11__mark, .zw11__p::after, .zw11__a { transition: none; }
    .zw11:hover .zw11__mark, .zw11.is-hover .zw11__mark { transform: none; }
  }
  @media (max-width: 900px) {
    .zw11 { left: var(--s-2); bottom: var(--s-2); gap: 14px; }
    .zw11__mark { width: 36px; height: 36px; }
    .zw11__tri { width: 9px; height: 11px; }
    .zw11__t { gap: 7px; }
  }
</style>
