---
/**
 * FS4 · THE SLEEVE — two cut strips, laid flat.
 *
 * THE IDEA: film does not stay on the reel. It gets cut into short lengths
 * and filed, four or five frames to a strip, in sleeves — which is the state
 * most film actually spends its life in and the state in which anybody
 * choosing between frames looks at it. The roll here is cut into two strips
 * of four, laid one above the other with the spacing of a sleeve page.
 *
 * IT IS THE ONLY ONE OF THE FOUR THAT DOES NOT MOVE AT ALL. No pinning, no
 * advancing, no reading line. Two strips, set square, with their edges and
 * their numbers, and nothing happens until you put a cursor on one. For a
 * brief asking for restraint that is the most restrained answer available,
 * and it is the one that most looks like an object on a table.
 *
 * 135 GEOMETRY, HORIZONTAL, because that is how still film is cut and filed
 * — eight perforations a frame, a 36 by 24 aperture — and because strips of
 * four are the length a sleeve pocket takes.
 *
 * THE MARKINGS ARE THE TWO THAT A CUT STRIP ACTUALLY CARRIES: the frame
 * number in the edge area, and the strip's own position in the roll, set
 * outside the film in the page's mono. Nothing is printed on the stock that
 * would not be printed on the stock.
 *
 * HOVER IS ONE HAIRLINE AND ONE LINE OF TYPE. The frame takes a one-pixel
 * rule at the aperture's edge and its reading appears at the end of the strip,
 * in the margin, where there is already room for it. Nothing is drawn on a
 * photograph and nothing grows, lifts or lights up.
 */
import Base from '../../layouts/Base.astro';
import OpNav from '../../components/OpNav.astro';
import { Image, getImage } from 'astro:assets';
import { getCollection } from 'astro:content';
import { framesFor } from '../../lib/frames';
import { href } from '../../lib/href';

/* THE REAL WORK AND THE REAL STILLS, and the work page's own harness around
   them, so the only variable between ab-sq1 and ab-sq8 is the section below
   the "03 · Stills" rule.

   NOTHING ON THESE PAGES IS CLICKABLE. Scroll and hover only: no buttons, no
   controls, no navigation, nothing draggable. Every state is either a
   function of scroll position or a CSS :hover. If you find a cursor:pointer
   in here it is a mistake.

   AND NOTHING HERE IS INVENTED FILM PRODUCTION DATA. These four take the reel
   as their system, which makes it tempting to print key numbers, footage
   counts and lab marks that would look right and mean nothing. Every figure
   on these pages is either a property of the page itself — how far the film
   has paid out, which frame is in the gate, how much slack is in the loop —
   or a luminance measured off the actual files. There is no fake edge print.

   THE PRODUCTION PAGE IS NOT TOUCHED — src/pages/work/[slug].astro is
   untouched by all eight, and `withoutPreview()` keeps these out of the
   built site. */
const works = await getCollection('works');
const work = works.find((w) => w.id === 'aasha')!;
const d = work.data;
const images = framesFor('aasha', d.frames);
const LEDE = (d.description.trim().match(/^[^.!?]+[.!?]/) ?? [d.description.trim()])[0];
const ROLES = d.role.split('·').map((r) => r.trim());
const nn = (i: number) => String(i + 1).padStart(2, '0');
/* `awards` is {text, star?}[], not a string. */
const AWARDS = (d.awards ?? []).map((a: { text: string }) => a.text).join(' · ');

/* Optimised URLs for the drafts that need a frame inside a CSS property — a
   background, a band, a blended layer — where <Image> cannot reach. */
const WEB = await Promise.all(
  images.map((src) => getImage({ src, width: 1400, format: 'webp', quality: 80 })),
);

/* MEASURED FROM THE FILES, NOT ASSERTED. Mean luminance of each frame, read
   off a 128x96 canvas by ab-xp1 and reproduced independently by ab-xp7 — the
   two agree to three decimals. Several drafts in this round art-direct from
   it (which frame is big, which is held longest, what order the composite
   resolves in), so it is recorded here rather than re-derived at runtime:
   these eight do no work in the browser that scroll and hover do not need.
      01 .147   02 .179   03 .078   04 .075
      05 .338   06 .214   07 .159   08 .313
   The film never exceeds .489 anywhere, and 03 and 04 are the floor. */
const LUMA = [0.147, 0.179, 0.078, 0.075, 0.338, 0.214, 0.159, 0.313];

const DRAFTS: [string, string, string][] = [
  ['fs1', 'The strip', 'One length of 35mm, down the page'],
  ['fs2', 'The advance', 'A 135 strip, advancing with the scroll'],
  ['fs3', 'The margin', 'The film is a column, not the page'],
  ['fs4', 'The sleeve', 'Two cut strips, laid flat'],
];

/* ── 35MM, TO SPEC ────────────────────────────────────────────────
   Every number below is the real stock, not an approximation of how film
   looks. Getting these right is the whole of this round: a strip drawn to
   spec reads as film immediately and needs no grain, no filter and no
   texture to do it.

     film width            35.00 mm
     perforation           2.794 across the film x 1.981 along it (KS)
     perforation pitch     4.75 mm
     between inner edges   25.40 mm, so 2.006 from the film edge to the
                           outer edge of a perforation

   MOTION PICTURE, 4-PERF: the aperture is 24 x 18 mm and the pitch is 19 mm,
   four perforations to a frame, leaving 1 mm of frame line.

   <- AND 24 x 18 IS EXACTLY 4:3, which is the ratio these eight stills are
   already in. So they sit in a real full-aperture frame at their own ratio
   with nothing cropped and nothing letterboxed — the geometry did not have
   to be bent to fit them, which is the reason this round can be literal
   without being a costume.

   135 STILL FILM is the same stock run the other way: same width, same
   perforations, same pitch, but 8 perforations to a frame and a 36 x 24
   aperture. It is what the horizontal drafts use, because a motion picture
   strip laid horizontally shows its frames on their side. */
const FILM = {
  w: 35, perfW: 2.794, perfH: 1.981, perfPitch: 4.75, perfInset: 2.006, perfR: 0.51,
  mp: { imgW: 24, imgH: 18, pitch: 19, perfs: 4 },
  still: { apW: 36, apH: 24, pitch: 38, perfs: 8 },
};
const ME = 'fs4';
const MINE = DRAFTS.find(([id]) => id === ME)!;

const PER = 4;
const CUTS = [images.slice(0, PER), images.slice(PER)];
const PERFS = PER * FILM.still.perfs;
---

<Base title={`${d.title} · ${MINE[1]} — stills ${ME.toUpperCase()}`} description={`An editorial direction for the stills section of the Aasha project page: ${MINE[2]}.`}>
  <OpNav variant="bracket" base={href()} />

  <nav class="sw" aria-label="Stills drafts">
    <span class="sw__id">{ME.toUpperCase()}</span>
    <span class="sw__nm">{MINE[1]}</span>
    <span class="sw__su">{MINE[2]}</span>
    <span class="sw__set">
      {DRAFTS.map(([id, name, sub]) => (
        <a class:list={['sw__i', { 'is-here': id === ME }]} href={href(`preview/ab-${id}`)}
          title={`${name} — ${sub}`} aria-current={id === ME ? 'page' : undefined}>{id.slice(2)}</a>
      ))}
      <a class="sw__prev" href={href('preview/ab-st1')} title="Round one — eight arrangements">ST</a>
      <a class="sw__prev" href={href('preview/ab-xp1')} title="Round two — eight interactions">XP</a>
      <a class="sw__prev" href={href('preview/ab-sq1')} title="Round three — eight editorial">SQ</a>
      <a class="sw__prev" href={href('preview/ab-rl1')} title="The reel, conceptual">RL</a>
    </span>
  </nav>

  <article class="sc" style={`--ar:${d.ratio.replace(':', ' / ')}`}>
    <header class="hd">
      <p class="mono hd__over">{d.category} · {d.year}</p>
      <h1 class="hd__t">{d.title}</h1>
      <p class="mono hd__meta"><span class="hd__roles">{ROLES.map((r) => <span>{r}</span>)}</span></p>
    </header>

    {d.quote && (
      <section class="q" aria-label="Statement">
        <p class="q__t">{d.quote}</p>
      </section>
    )}

    <section class="blk body" aria-label="About">
      <p class="body__lede" style={`--n:${LEDE.length}`}>{LEDE}</p>
    </section>

    <!-- ══ 03 · STILLS — THE DRAFT ═══════════════════════════════════ -->
    <section class="blk st" aria-label="Stills">
      <p class="mono st__lbl"><span>03</span><i aria-hidden="true"></i><span>Stills · {MINE[1]}</span></p>
      <div class="sl" data-sl>
        <div class="sl__head mono">
          <span>{d.title} · {d.year}</span>
          <i aria-hidden="true"></i>
          <span>135 · two strips of four · 36 × 24 mm</span>
        </div>

        {CUTS.map((cut, s) => (
          <section class="sl__row" data-reveal>
            <div class="sl__film film" data-sl-film={s}>
              <div class="sl__rail sl__rail--t" aria-hidden="true">
                {Array.from({ length: PERFS }, (_, k) => <i class="perf" style={`--k:${k}`}></i>)}
              </div>

              <div class="sl__cells">
                {cut.map((img, k) => {
                  const fi = s * PER + k;
                  return (
                    <figure class="sl__cell" data-sl-c={fi}>
                      <Image src={img} alt={fi === 0 ? d.alt : ''} aria-hidden={fi === 0 ? undefined : 'true'}
                        widths={[320, 580, 900]} sizes="(max-width: 760px) 44vw, 24vw"
                        loading={s === 0 ? 'eager' : 'lazy'} decoding="async" />
                      <figcaption class="mono sl__key">{nn(fi)}</figcaption>
                    </figure>
                  );
                })}
              </div>

              <div class="sl__rail sl__rail--b" aria-hidden="true">
                {Array.from({ length: PERFS }, (_, k) => <i class="perf" style={`--k:${k}`}></i>)}
              </div>
            </div>

            <p class="mono sl__lbl">
              <b>Strip {s + 1}</b>
              <span>Frames {nn(s * PER)}–{nn(s * PER + PER - 1)}</span>
              <em data-sl-read={s}></em>
            </p>
          </section>
        ))}

        <p class="mono note">
          <em>Two cut lengths, laid flat · nothing moves</em>
          <i aria-hidden="true"></i>
          <span>Rest on a frame for its reading</span>
        </p>
      </div>
    </section>

    <footer class="cl">
      <hr class="rule" />
      <p class="mono cl__p"><span>{MINE[0].toUpperCase()} · {MINE[1]}</span><i aria-hidden="true"></i><span>{AWARDS}</span></p>
    </footer>
  </article>
</Base>

<script>
  /* The only script in this draft: put the hovered frame's reading at the end
     of its strip. Everything else here is CSS and geometry. */
  const sl = document.querySelector('[data-sl]');
  if (sl) {
    const LUMA = [0.147, 0.179, 0.078, 0.075, 0.338, 0.214, 0.159, 0.313];
    const reads = [...sl.querySelectorAll('[data-sl-read]')];
    [...sl.querySelectorAll('[data-sl-c]')].forEach((c) => {
      const i = +c.dataset.slC;
      const row = i < 4 ? 0 : 1;
      c.addEventListener('pointerenter', () => {
        if (reads[row]) reads[row].textContent = `${String(i + 1).padStart(2, '0')} · luma ${LUMA[i].toFixed(3)}`;
      });
      c.addEventListener('pointerleave', () => { if (reads[row]) reads[row].textContent = ''; });
    });
  }
</script>

<style>
  /* ══ THE HARNESS ═══════════════════════════════════════════════════
     The work page's own type and rhythm, shared verbatim by all eight. */
  .sw {
    position: fixed; inset: 0 0 auto; z-index: 900;
    display: flex; align-items: baseline; gap: 12px;
    padding: 9px clamp(16px, 4vw, 40px);
    background: color-mix(in srgb, var(--ground) 86%, transparent);
    backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--rule);
    font-family: var(--mono); font-size: var(--t-micro);
    letter-spacing: 0.16em; text-transform: uppercase;
  }
  .sw__id { color: var(--accent); }
  .sw__nm { color: var(--bone); }
  .sw__su { color: var(--dim); margin-right: auto; }
  .sw__set { display: flex; gap: 1px; align-items: baseline; }
  .sw__i { color: var(--dim); text-decoration: none; padding: 3px 7px; border: 1px solid transparent; font-variant-numeric: tabular-nums; }
  .sw__i:hover { color: var(--bone); }
  .sw__i.is-here { color: var(--accent); border-color: var(--rule); }
  .sw__prev { color: color-mix(in srgb, var(--dim) 70%, var(--ground)); text-decoration: none; padding: 3px 6px; margin-left: 4px; }
  .sw__prev:first-of-type { border-left: 1px solid var(--rule); margin-left: 8px; padding-left: 11px; }
  .sw__prev:hover { color: var(--bone-dim); }
  @media (max-width: 860px) { .sw__su { display: none; } .sw__nm { margin-right: auto; } }
  @media (max-width: 560px) { .sw__nm { display: none; } }

  .sc { padding: clamp(84px, 13vh, 150px) var(--margin) 0; }
  .hd { text-align: center; margin-bottom: clamp(38px, 6.6vh, 80px); }
  .hd__over { font-size: var(--t-micro); letter-spacing: 0.18em; text-transform: uppercase; color: var(--muted); margin: 0 0 clamp(16px, 2.6vh, 30px); }
  .hd__t { margin: 0; font-family: var(--display); font-weight: 500; font-size: clamp(2.6rem, 7vw, 5.6rem); line-height: 0.94; letter-spacing: -0.04em; color: var(--bone); }
  .hd__meta { margin: clamp(14px, 2.2vh, 26px) 0 0; font-size: var(--t-micro); letter-spacing: 0.18em; text-transform: uppercase; color: var(--bone-dim); }
  .hd__roles { display: inline-flex; flex-wrap: wrap; justify-content: center; gap: 0 14px; }
  .hd__roles span + span::before { content: '·'; margin-right: 14px; color: var(--dim); }
  .q { max-width: 34ch; margin: 0 auto clamp(50px, 8vh, 110px); text-align: center; }
  .q__t { margin: 0; font-family: var(--serif); font-style: italic; font-weight: 300; font-size: clamp(1.25rem, 2.4vw, 1.9rem); line-height: 1.26; letter-spacing: -0.012em; color: var(--bone-dim); }
  .body { max-width: var(--measure); margin-inline: auto; }
  .body__lede { margin: 0 auto; max-width: clamp(20ch, calc(var(--n, 90) / 3 * 1ch), 44ch); font-family: var(--display); font-weight: 500; font-size: clamp(1.2rem, min(calc(2.35rem - (var(--n, 90) - 55) * 0.007rem), calc(1.05rem + 2.1vw)), 2.2rem); line-height: 1.12; letter-spacing: -0.025em; color: var(--bone); text-wrap: balance; }
  .blk { margin: 0 auto clamp(104px, 18vh, 240px); }

  .st { --w: var(--measure); }
  .st__lbl {
    display: flex; align-items: center; gap: 12px;
    width: var(--w); margin: 0 auto clamp(24px, 4vh, 50px);
    font-size: var(--t-micro); letter-spacing: 0.18em; text-transform: uppercase; color: var(--muted);
  }
  .st__lbl i { flex: 1; height: 1px; background: var(--rule); }

  /* One line of mono per draft saying what the composition responds to.
     Scroll and hover are invisible affordances; naming them is not a crutch,
     it is the caption on a piece of behaviour. */
  .note {
    display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap;
    width: var(--w); margin: clamp(16px, 2.4vh, 28px) auto 0;
    font-size: var(--t-micro); letter-spacing: 0.16em; text-transform: uppercase; color: var(--dim);
  }
  .note b { font-weight: 400; color: var(--accent); font-variant-numeric: tabular-nums; }
  .note em { font-style: normal; color: var(--muted); }
  .note i { flex: 1; min-width: 20px; height: 1px; background: var(--rule); transform: translateY(-3px); }

  .cl { max-width: var(--measure); margin: 0 auto; padding-bottom: clamp(48px, 9vh, 110px); }
  .rule { border: 0; border-top: 1px solid var(--rule); margin: 0 0 16px; }
  .cl__p { display: flex; align-items: baseline; gap: 14px; margin: 0; font-size: var(--t-micro); letter-spacing: 0.16em; text-transform: uppercase; color: var(--dim); }
  .cl__p i { flex: 1; height: 1px; background: var(--rule); transform: translateY(-3px); }
  .cl__p span:last-child { text-align: right; }
  @media (max-width: 620px) { .cl__p { flex-direction: column; gap: 6px; } .cl__p i { display: none; } .cl__p span:last-child { text-align: left; } }

  /* ══ THE STOCK ═════════════════════════════════════════════════════
     One custom property per draft — --fw, the width of the film — and every
     other dimension falls out of it at the real ratios. Nothing here is
     tuned by eye. */
  .st {
    --u: calc(var(--fw) / 35);
    --perf-w: calc(2.794 * var(--u));
    --perf-h: calc(1.981 * var(--u));
    --perf-pitch: calc(4.75 * var(--u));
    --perf-inset: calc(2.006 * var(--u));
    --perf-r: calc(0.51 * var(--u));
    /* motion picture, 4-perf */
    --img-w: calc(24 * var(--u));
    --img-h: calc(18 * var(--u));
    --pitch: calc(19 * var(--u));
    /* 135 still */
    --ap-w: calc(36 * var(--u));
    --ap-h: calc(24 * var(--u));
    --s-pitch: calc(38 * var(--u));
  }

  /* The base of the film. Clear stock is darker than the page, not lighter —
     a developed strip held over a light table is the other way round, but on
     a near-black page the honest reading is the one that lets the frames be
     the brightest thing in the section. */
  .film { background: var(--ground-deep, #000); }
  .perf {
    position: absolute; background: var(--ground);
    border-radius: var(--perf-r);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.07);
  }

  /* ── FS4 · THE SLEEVE ──────────────────────────────────────── */
  /* Four frames at a 38mm pitch make the strip 152mm long, so the film's
     width falls out of the measure rather than being chosen. */
  .st { --w: min(calc(100vw - 2 * var(--margin)), 1180px); --fw: calc(var(--w) * 35 / 152); }
  .sl { width: var(--w); margin-inline: auto; }

  .sl__head {
    display: flex; align-items: baseline; gap: 12px; margin: 0 0 clamp(22px, 3.4vh, 42px);
    font-size: var(--t-micro); letter-spacing: 0.18em; text-transform: uppercase; color: var(--dim);
  }
  .sl__head i { flex: 1; height: 1px; background: var(--rule); transform: translateY(-3px); }

  .sl__row + .sl__row { margin-top: clamp(26px, 4.4vh, 62px); }
  .sl__film { position: relative; height: var(--fw); width: 100%; }
  .sl__cells { display: flex; height: 100%; }
  .sl__cell { position: relative; margin: 0; width: var(--s-pitch); height: 100%; display: grid; place-items: center; }
  .sl__cell img { display: block; height: var(--ap-h); width: calc(var(--ap-h) * 4 / 3); object-fit: cover; }

  .sl__rail { position: absolute; left: 0; right: 0; height: var(--perf-w); }
  .sl__rail--t { top: var(--perf-inset); }
  .sl__rail--b { bottom: var(--perf-inset); }
  .sl__rail .perf {
    top: 0; height: var(--perf-w); width: var(--perf-h);
    left: calc(var(--k) * var(--perf-pitch) + (var(--perf-pitch) - var(--perf-h)) / 2);
  }

  .sl__key {
    position: absolute; left: 50%; transform: translateX(-50%);
    bottom: calc(var(--perf-inset) + var(--perf-w) + 0.4 * var(--u));
    font-size: calc(1.5 * var(--u)); letter-spacing: 0.2em;
    color: color-mix(in srgb, var(--bone) 34%, transparent); font-variant-numeric: tabular-nums;
  }

  .sl__lbl {
    display: flex; align-items: baseline; gap: 14px; margin: 10px 0 0;
    font-size: var(--t-micro); letter-spacing: 0.16em; text-transform: uppercase; color: var(--dim);
  }
  .sl__lbl b { font-weight: 400; color: var(--muted); }
  .sl__lbl em { font-style: normal; margin-left: auto; color: var(--accent); font-variant-numeric: tabular-nums; }

  /* One hairline at the aperture's edge, and the reading at the end of the
     strip where there is already room for it. */
  .sl__cell::after {
    content: ''; position: absolute; top: calc(50% - var(--ap-h) / 2 - 1px); height: calc(var(--ap-h) + 2px);
    left: calc(50% - var(--ap-h) * 2 / 3 - 1px); width: calc(var(--ap-h) * 4 / 3 + 2px);
    border: 1px solid var(--accent); opacity: 0; pointer-events: none;
  }
  .sl__cell:hover::after { opacity: 1; }
  .sl__cell:hover .sl__key { color: var(--accent); }
  @media (prefers-reduced-motion: no-preference) {
    .sl__cell::after { transition: opacity 180ms linear; }
    .sl__key { transition: color 180ms linear; }
  }

  @media (max-width: 760px) {
    /* Four frames across a phone leaves each one about seventy pixels wide,
       so the cut goes to two strips of two and the sleeve reads as four rows
       instead of two. The geometry is unchanged. */
    .st { --fw: calc(var(--w) * 35 / 76); }
    .sl__cells { flex-wrap: wrap; }
    .sl__film { height: auto; }
    .sl__rail { display: none; }
    .sl__cell { width: 50%; height: var(--fw); }
  }
</style>
