---
/**
 * PREVIEW — WORK PAGE VIII · "STRIP".  Aasha.
 *
 * THE WORK RUNS SIDEWAYS. Eight frames on one continuous strip, travelling
 * horizontally while the page scrolls vertically — a reel being pulled past
 * a gate rather than a column of pictures.
 *
 * WHY IT IS WORTH BREAKING THE AXIS FOR. Turning the scroll ninety degrees is
 * usually a gimmick, and it earns its place here for one reason: a film IS a
 * strip, and the only thing on this site that already moves sideways is the
 * catalogue itself. So the gesture is the subject rather than an effect
 * applied to it.
 *
 * THE TRAVEL IS EXACTLY THE OVERHANG. The strip moves by its own width less
 * one screen, so the first frame starts flush at the left edge and the last
 * lands flush at the right — no guessed distance, no dead run at either end,
 * and it stays true when the frame count or the viewport changes.
 *
 * THE TITLE IS HELD STILL OVER IT in difference blend, so it reads against
 * whichever frame happens to be under it without a scrim — the same treatment
 * the homepage gives its works readout.
 *
 * REDUCED MOTION UNROLLS THE STRIP into an ordinary grid on solid ground: no
 * pinning, no horizontal travel, the same eight frames in the same order.
 *
 * NOTHING IS INVENTED: every field comes from src/content/works/aasha.md.
 */
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import OpNav from '../../components/OpNav.astro';
import VideoFacade from '../../components/VideoFacade.astro';
import NextWork from '../../components/NextWork.astro';
import Colophon from '../../components/Colophon.astro';
import { Image } from 'astro:assets';
import { framesFor } from '../../lib/frames';
import { order, numberFor, total } from '../../data/composition';

const works = await getCollection('works');
const bySlug = new Map(works.map((w) => [w.id, w]));
const work = bySlug.get('aasha')!;
const d = work.data;

const seq = order.filter((s) => bySlug.has(s));
const next = bySlug.get(seq[(seq.indexOf('aasha') + 1) % seq.length])!;

const images = framesFor('aasha', d.frames);
const poster = images[0];
const num = numberFor('aasha');
const AR = d.ratio.replace(':', ' / ');

const FACTS: { k: string; v: string }[] = [
  { k: 'Role', v: d.role },
  ...(d.credits.director ? [{ k: 'Director', v: d.credits.director }] : []),
  ...d.meta.map((m) => ({ k: m.label, v: m.value })),
];
---

<Base title={`${d.title} — Ugam Khetani`} description={d.description}>
  <OpNav variant="bracket" />

  <article class="st" data-st style={`--ar:${AR};--n:${images.length}`}>
    {/* ── HEAD ────────────────────────────────────────────────── */}
    <header class="hd">
      <p class="mono hd__folio">{num} / {String(total).padStart(2, '0')}</p>
      <h1 class="hd__t" data-reveal>
        <span class="line"><span class="line__in">{d.title}</span></span>
      </h1>
      {d.quote && <p class="hd__q" data-reveal><em class="serif">{d.quote}</em></p>}
      <p class="mono hd__meta">
        {d.category} · {d.year} · {d.role}
        {d.credits.director && <> · Dir. {d.credits.director}</>}
      </p>
    </header>

    {/* ── THE STRIP ───────────────────────────────────────────── */}
    <section class="reel" data-reel aria-label="Stills">
      <div class="reel__pin">
        <div class="reel__track" data-track>
          {images.map((img, i) => (
            <figure class="fr">
              <span class="fr__win">
                <Image
                  src={img}
                  alt={i === 0 ? d.alt : ''}
                  aria-hidden={i === 0 ? undefined : 'true'}
                  widths={[600, 1000, 1500]}
                  sizes="62vw"
                  loading={i < 3 ? 'eager' : 'lazy'}
                  decoding="async"
                />
              </span>
              <figcaption class="mono fr__no">{String(i + 1).padStart(2, '0')}</figcaption>
            </figure>
          ))}
        </div>

        <p class="mono reel__hold" aria-hidden="true">{d.title}</p>

        <div class="reel__hud" aria-hidden="true">
          <span class="mono reel__no" data-no>01</span>
          <span class="mono reel__of">/ {String(images.length).padStart(2, '0')}</span>
          <span class="reel__rule"><i class="reel__fill" data-fill></i></span>
        </div>
      </div>
    </section>

    {/* ── READING ─────────────────────────────────────────────── */}
    <div class="pg">
      <section class="blk" aria-label="About the score" data-reveal>
        <p class="mono blk__lbl">The score</p>
        <p class="body">{d.description}</p>
        {d.awards.length > 0 && (
          <p class="mono blk__awards">{d.awards.map((a) => a.text).join(' · ')}</p>
        )}
      </section>

      <section class="blk" aria-label="Film" data-reveal>
        <p class="mono blk__lbl">The film</p>
        <VideoFacade youtube={d.media.youtube!} title={d.title} poster={poster} alt={d.alt} />
      </section>

      <section class="blk" aria-label="Credits" data-reveal>
        <p class="mono blk__lbl">Credits</p>
        <dl class="facts">
          {FACTS.map((f) => (
            <div class="facts__row">
              <dt class="mono facts__k">{f.k}</dt>
              <dd class="facts__v">{f.v}</dd>
            </div>
          ))}
        </dl>
        {d.links.length > 0 && (
          <p class="facts__links">
            {d.links.map((l) => (
              <a class="facts__link" href={l.url} target="_blank" rel="noopener">{l.label} &nearr;</a>
            ))}
          </p>
        )}
      </section>
    </div>
  </article>

  <NextWork
    slug={next.id}
    title={next.data.title}
    year={next.data.year}
    category={next.data.category}
    frames={next.data.frames}
    alt={next.data.alt}
  />
  <Colophon />
</Base>

<style is:global>
  .runhead { display: none !important; }
</style>

<style>
  .st { --f: 0; }

  /* ── HEAD ───────────────────────────────────────────────────── */
  .hd {
    min-height: 100vh;
    display: grid; align-content: center; justify-items: center;
    text-align: center;
    padding: clamp(96px, 15vh, 190px) var(--margin) clamp(48px, 8vh, 96px);
  }
  .hd__folio {
    margin: 0 0 clamp(24px, 4vh, 48px);
    font-size: var(--t-micro); letter-spacing: 0.16em;
    text-transform: uppercase; color: var(--dim);
    font-variant-numeric: tabular-nums;
  }
  .hd__t {
    margin: 0;
    font-family: var(--display); font-weight: 500;
    font-size: clamp(2.6rem, 10vw, 8rem);
    line-height: 0.86; letter-spacing: -0.05em;
    text-transform: uppercase; color: var(--bone);
  }
  .hd__q {
    margin: clamp(26px, 4.6vh, 52px) auto 0; max-width: 20ch;
    font-family: var(--display); font-weight: 500;
    font-size: clamp(1.25rem, 2.6vw, 2rem);
    line-height: 1.08; letter-spacing: var(--track-tight);
    color: var(--accent);
  }
  .hd__meta {
    margin: clamp(26px, 4.6vh, 52px) 0 0;
    font-size: var(--t-micro); letter-spacing: 0.16em;
    text-transform: uppercase; color: var(--muted);
  }

  /* ── THE STRIP ──────────────────────────────────────────────── */
  /* Height is the timeline: one screen of scroll per frame. */
  .reel { height: calc(var(--n) * 100vh); }
  .reel__pin {
    position: sticky; top: 0;
    height: 100vh;
    overflow: hidden;
    display: flex; align-items: center;
  }

  /* The track is translated by exactly its own overhang, written by the
     clock as --f. will-change keeps it on its own layer for the whole run. */
  .reel__track {
    display: flex;
    align-items: center;
    gap: clamp(20px, 3vw, 56px);
    padding-inline: var(--margin);
    transform: translate3d(calc(var(--f) * var(--travel, 0px) * -1), 0, 0);
    will-change: transform;
  }
  .fr { margin: 0; flex: 0 0 auto; width: 62vw; max-width: 900px; }
  .fr__win {
    display: block; aspect-ratio: var(--ar);
    overflow: hidden; background: var(--ground-lift);
  }
  .fr__win :global(img) {
    width: 100%; height: 100%; object-fit: cover;
    filter: saturate(0.94) contrast(1.02);
    transform: scale(1.001);
    transition: filter var(--d-micro) var(--ease), transform 1100ms var(--ease);
  }
  .fr:hover .fr__win :global(img) {
    filter: saturate(1) contrast(1.06) brightness(1.04);
    transform: scale(1.035);
  }
  .fr__no {
    display: block; margin-top: 8px;
    font-size: var(--t-micro); letter-spacing: 0.16em;
    color: var(--dim); font-variant-numeric: tabular-nums;
  }

  /* The name, held still over the travelling strip. Difference, so it reads
     against a frame and against the ground without a scrim. */
  .reel__hold {
    position: absolute; inset: 0;
    display: grid; place-items: center;
    margin: 0; pointer-events: none;
    font-family: var(--display); font-weight: 500;
    font-size: clamp(2.5rem, 11vw, 9rem);
    line-height: 1; letter-spacing: -0.05em;
    text-transform: uppercase; color: var(--bone);
    mix-blend-mode: difference;
  }

  .reel__hud {
    position: absolute;
    left: var(--margin); right: var(--margin);
    bottom: clamp(24px, 5vh, 56px);
    display: flex; align-items: center; gap: 12px;
    mix-blend-mode: difference;
  }
  .reel__no { font-size: var(--t-lg); line-height: 1; color: var(--accent); font-variant-numeric: tabular-nums; }
  .reel__of { font-size: var(--t-micro); letter-spacing: 0.16em; color: var(--bone-dim); font-variant-numeric: tabular-nums; }
  .reel__rule { flex: 1; height: 1px; margin-left: 8px; background: var(--rule); overflow: hidden; }
  .reel__fill { display: block; height: 100%; width: calc(var(--f) * 100%); background: var(--accent); }

  /* ── READING ────────────────────────────────────────────────── */
  .pg { background: var(--ground); padding: clamp(64px, 11vh, 150px) var(--margin) 0; }
  .blk { max-width: 1180px; margin: 0 auto clamp(64px, 11vh, 150px); }
  .blk__lbl {
    margin: 0 0 clamp(14px, 2.2vh, 24px);
    padding-bottom: 10px; border-bottom: 1px solid var(--rule);
    font-size: var(--t-micro); letter-spacing: 0.16em;
    text-transform: uppercase; color: var(--bone-dim);
  }
  .body {
    margin: 0; max-width: 60ch;
    font-size: clamp(1.15rem, 1.9vw, 1.6rem);
    line-height: 1.42; letter-spacing: -0.012em;
    color: var(--bone-dim); text-wrap: pretty;
  }
  .blk__awards {
    margin: clamp(24px, 4vh, 44px) 0 0;
    font-size: var(--t-xs); letter-spacing: 0.14em;
    text-transform: uppercase; color: var(--accent);
  }
  .facts { margin: 0; }
  .facts__row {
    display: grid; grid-template-columns: minmax(0, 12rem) minmax(0, 1fr);
    gap: clamp(20px, 2.5vw, 44px); align-items: baseline;
    padding: 14px 0; border-bottom: 1px solid var(--rule-soft);
  }
  .facts__k { margin: 0; font-size: var(--t-micro); letter-spacing: 0.16em; text-transform: uppercase; color: var(--muted); }
  .facts__v { margin: 0; font-size: var(--t-md); line-height: 1.3; color: var(--bone-dim); }
  .facts__links { margin: clamp(24px, 4vh, 40px) 0 0; display: flex; flex-wrap: wrap; gap: 24px; }
  .facts__link {
    font-size: var(--t-sm); letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--bone); text-decoration: none;
    border-bottom: 1px solid var(--rule-accent); padding-bottom: 3px;
    transition: color var(--d-micro) var(--ease), border-color var(--d-micro) var(--ease);
  }
  .facts__link:hover { color: var(--accent); border-color: var(--accent); }

  @media (max-width: 640px) {
    .facts__row { grid-template-columns: 1fr; gap: 4px; }
    .fr { width: 84vw; }
  }

  /* ── REDUCED MOTION UNROLLS THE STRIP ───────────────────────── */
  @media (prefers-reduced-motion: reduce) {
    .reel { height: auto; }
    .reel__pin { position: static; height: auto; display: block; overflow: visible; }
    .reel__track {
      display: grid; grid-template-columns: repeat(2, minmax(0, 1fr));
      transform: none; will-change: auto;
    }
    .fr { width: auto; max-width: none; }
    .reel__hold, .reel__hud { display: none; }
  }
</style>

<script>
  /* ONE CLOCK for the strip. --f is how far through the pinned section the
     scroll has travelled; --travel is the strip's own overhang, measured from
     the track rather than guessed, so the first frame starts flush left and
     the last lands flush right at every viewport and frame count.

     --travel is re-measured on resize and after the images settle, because
     the track's width depends on them. Both a resize listener and a load
     listener, deliberately: this pane never fires ResizeObserver at all
     (measured earlier in this project), so an observer alone would leave the
     travel wrong at the width the page was first laid out at. */
  function initStrip() {
    const root = document.querySelector<HTMLElement>('[data-st]');
    const reel = root?.querySelector<HTMLElement>('[data-reel]');
    const track = root?.querySelector<HTMLElement>('[data-track]');
    const no = root?.querySelector<HTMLElement>('[data-no]');
    if (!root || !reel || !track || !no) return;
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    if (root.dataset.bound) return;
    root.dataset.bound = '1';

    const n = parseFloat(getComputedStyle(root).getPropertyValue('--n')) || 1;
    let raf = 0;

    const measure = () => {
      const over = Math.max(0, track.scrollWidth - innerWidth);
      root.style.setProperty('--travel', `${over}px`);
    };

    const paint = () => {
      raf = 0;
      const r = reel.getBoundingClientRect();
      const span = Math.max(1, r.height - innerHeight);
      const f = Math.min(1, Math.max(0, -r.top / span));
      root.style.setProperty('--f', f.toFixed(4));

      const idx = Math.min(n, Math.max(1, Math.round(f * (n - 1)) + 1));
      const s = String(idx).padStart(2, '0');
      if (no.textContent !== s) no.textContent = s;
    };
    const tick = () => { if (!raf) raf = requestAnimationFrame(paint); };

    measure();
    paint();
    addEventListener('scroll', tick, { passive: true });
    addEventListener('resize', () => { measure(); tick(); }, { passive: true });
    addEventListener('load', () => { measure(); tick(); });
    if (document.fonts && document.fonts.ready) document.fonts.ready.then(() => { measure(); tick(); });
  }
  initStrip();
  document.addEventListener('astro:page-load', initStrip);
</script>
