---
/**
 * PREVIEW — WORK PAGE VII · "APERTURE".  Aasha.
 *
 * THE SITE'S OWN MECHANIC, TURNED ON ONE WORK.
 *
 * The homepage frames every movement in a mat that opens and closes as the
 * movement takes the window. That mat is the strongest idea on this site and
 * no work page has used it. Here it is the whole page: a fixed window that
 * opens from a letterbox to nearly the full frame as you travel through the
 * work, with the eight stills dissolving behind it one into the next.
 *
 * ONE ELEMENT, NO SEAMS. The mat is a single fixed box with a 100vmax spread
 * shadow in the ground colour — so the "frame" is the shadow, there are no
 * four panels to keep in register, and nothing can show a join at any size.
 * Exactly how the homepage draws it.
 *
 * ONE CLOCK, AS ON THE HOMEPAGE. A single scroll pass writes two numbers on
 * the root: --f, how far through the gallery you are, and --i, which still
 * that lands on. Every moving thing on the page — the mat's inset, the
 * crossfade, the counter, the rule — is derived from those two. Nothing here
 * has a timeline of its own, so nothing can drift out of step with anything
 * else, which is the failure mode of a page with six independent animations.
 *
 * THE CROSSFADE IS A REAL DISSOLVE, not a cut: each still's opacity is a
 * triangular function of the distance between the scroll position and that
 * still's own slot, so at any moment two of them are mixed. A film dissolves;
 * it does not cut to black between shots.
 *
 * REDUCED MOTION GETS A COMPLETE PAGE. The mat opens to its full size and
 * stays there, the stills become a plain grid, and the scroll pass never
 * runs — no movement, nothing missing.
 *
 * NOTHING IS INVENTED: every field comes from src/content/works/aasha.md.
 */
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import OpNav from '../../components/OpNav.astro';
import VideoFacade from '../../components/VideoFacade.astro';
import NextWork from '../../components/NextWork.astro';
import Colophon from '../../components/Colophon.astro';
import { Image } from 'astro:assets';
import { framesFor } from '../../lib/frames';
import { order, numberFor, total } from '../../data/composition';

const works = await getCollection('works');
const bySlug = new Map(works.map((w) => [w.id, w]));
const work = bySlug.get('aasha')!;
const d = work.data;

const seq = order.filter((s) => bySlug.has(s));
const next = bySlug.get(seq[(seq.indexOf('aasha') + 1) % seq.length])!;

const images = framesFor('aasha', d.frames);
const poster = images[0];
const num = numberFor('aasha');

const FACTS: { k: string; v: string }[] = [
  { k: 'Role', v: d.role },
  ...(d.credits.director ? [{ k: 'Director', v: d.credits.director }] : []),
  ...d.meta.map((m) => ({ k: m.label, v: m.value })),
];
---

<Base title={`${d.title} — Ugam Khetani`} description={d.description}>
  <OpNav variant="bracket" />

  <article class="ap" data-ap style={`--n:${images.length}`}>
    {/* ── THE FIXED SCENE ─────────────────────────────────────── */}
    <div class="ap__scene" aria-hidden="true">
      <div class="ap__stack">
        {images.map((img, i) => (
          <span class="ap__layer" style={`--k:${i}`}>
            <Image
              src={img}
              alt=""
              widths={[900, 1400, 2000]}
              sizes="100vw"
              loading={i < 2 ? 'eager' : 'lazy'}
              decoding="async"
            />
          </span>
        ))}
      </div>
      <div class="ap__mat"></div>
    </div>

    {/* ── THE TITLE ───────────────────────────────────────────── */}
    <header class="hd">
      <p class="mono hd__folio">{num} / {String(total).padStart(2, '0')}</p>
      <h1 class="hd__t" data-reveal>
        <span class="line"><span class="line__in">{d.title}</span></span>
      </h1>
      {d.quote && <p class="hd__q" data-reveal><em class="serif">{d.quote}</em></p>}
      <p class="mono hd__meta">
        {d.category} · {d.year} · {d.role}
        {d.credits.director && <> · Dir. {d.credits.director}</>}
      </p>
      <p class="mono hd__cue">Scroll &darr;</p>
    </header>

    {/* ── THE GALLERY. Its height IS the timeline. ────────────── */}
    <section class="gal" data-gal aria-label="Stills">
      <div class="gal__hud" aria-hidden="true">
        <span class="mono gal__no" data-no>01</span>
        <span class="mono gal__of">/ {String(images.length).padStart(2, '0')}</span>
        <span class="gal__rule"><i class="gal__fill"></i></span>
      </div>
    </section>

    {/* ── THE READING. Solid ground under it. ─────────────────── */}
    <div class="pg">
      <section class="blk" aria-label="About the score" data-reveal>
        <p class="mono blk__lbl">The score</p>
        <p class="body">{d.description}</p>
        {d.awards.length > 0 && (
          <p class="mono blk__awards">{d.awards.map((a) => a.text).join(' · ')}</p>
        )}
      </section>

      <section class="blk" aria-label="Film" data-reveal>
        <p class="mono blk__lbl">The film</p>
        <VideoFacade youtube={d.media.youtube!} title={d.title} poster={poster} alt={d.alt} />
      </section>

      <section class="blk" aria-label="Credits" data-reveal>
        <p class="mono blk__lbl">Credits</p>
        <dl class="facts">
          {FACTS.map((f) => (
            <div class="facts__row">
              <dt class="mono facts__k">{f.k}</dt>
              <dd class="facts__v">{f.v}</dd>
            </div>
          ))}
        </dl>
        {d.links.length > 0 && (
          <p class="facts__links">
            {d.links.map((l) => (
              <a class="facts__link" href={l.url} target="_blank" rel="noopener">{l.label} &nearr;</a>
            ))}
          </p>
        )}
      </section>
    </div>
  </article>

  <NextWork
    slug={next.id}
    title={next.data.title}
    year={next.data.year}
    category={next.data.category}
    frames={next.data.frames}
    alt={next.data.alt}
  />
  <Colophon />
</Base>

<style is:global>
  .runhead { display: none !important; }
</style>

<style>
  .ap {
    --f: 0;   /* how far through the gallery — written by the one clock */
    --i: 0;   /* which still that lands on */
    position: relative;
  }

  /* ── THE FIXED SCENE ────────────────────────────────────────── */
  .ap__scene {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    /* Only lit while the gallery owns the window; before and after it there
       is nothing behind the page and the ground is plain. */
    opacity: var(--lit, 0);
  }
  .ap__stack { position: absolute; inset: 0; }

  /* Each still's opacity is a triangle around its own slot, so two are always
     mixed and the run reads as a dissolve rather than as eight cuts.
     abs() is not available on a custom property in every engine this has to
     run in, so the distance is squared and clamped instead — same shape, no
     function support required. */
  .ap__layer {
    position: absolute;
    inset: 0;
    --d: calc(var(--i) - var(--k));
    opacity: clamp(0, calc(1 - var(--d) * var(--d)), 1);
  }
  .ap__layer :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.94) contrast(1.02) brightness(0.86);
  }

  /* THE MAT. One element, a 100vmax spread shadow in the ground colour, so
     the frame is the shadow and there is no join anywhere. It opens from a
     letterbox to nearly the full frame as --f runs 0 to 1. */
  .ap__mat {
    position: fixed;
    inset:
      calc(34vh - var(--f) * 28vh)
      calc(24vw - var(--f) * 20vw);
    box-shadow: 0 0 0 100vmax var(--ground);
    pointer-events: none;
  }

  /* ── TITLE ──────────────────────────────────────────────────── */
  .hd {
    position: relative;
    z-index: 2;
    min-height: 100vh;
    display: grid;
    align-content: center;
    justify-items: center;
    text-align: center;
    padding: clamp(96px, 15vh, 190px) var(--margin) clamp(48px, 8vh, 96px);
  }
  .hd__folio {
    margin: 0 0 clamp(24px, 4vh, 48px);
    font-size: var(--t-micro); letter-spacing: 0.16em;
    text-transform: uppercase; color: var(--dim);
    font-variant-numeric: tabular-nums;
  }
  .hd__t {
    margin: 0;
    font-family: var(--display); font-weight: 500;
    font-size: clamp(2.6rem, 10vw, 8rem);
    line-height: 0.86; letter-spacing: -0.05em;
    text-transform: uppercase; color: var(--bone);
  }
  .hd__q {
    margin: clamp(26px, 4.6vh, 52px) auto 0;
    max-width: 20ch;
    font-family: var(--display); font-weight: 500;
    font-size: clamp(1.25rem, 2.6vw, 2rem);
    line-height: 1.08; letter-spacing: var(--track-tight);
    color: var(--accent);
  }
  .hd__meta {
    margin: clamp(26px, 4.6vh, 52px) 0 0;
    font-size: var(--t-micro); letter-spacing: 0.16em;
    text-transform: uppercase; color: var(--muted);
  }
  .hd__cue {
    margin: clamp(36px, 7vh, 84px) 0 0;
    font-size: var(--t-micro); letter-spacing: var(--track-mono);
    text-transform: uppercase; color: var(--dim);
  }

  /* ── THE GALLERY. Height is the timeline; nothing is drawn in
     flow except the readout. ─────────────────────────────────── */
  .gal {
    position: relative;
    z-index: 2;
    /* One screen of travel per still, plus one to open and one to close. */
    height: calc((var(--n) + 1) * 100vh);
  }
  .gal__hud {
    position: sticky;
    top: calc(100vh - clamp(56px, 9vh, 96px));
    display: flex;
    align-items: center;
    gap: 12px;
    padding-inline: var(--margin);
    mix-blend-mode: difference;
  }
  .gal__no {
    font-size: var(--t-lg); line-height: 1;
    color: var(--accent); font-variant-numeric: tabular-nums;
  }
  .gal__of {
    font-size: var(--t-micro); letter-spacing: 0.16em;
    color: var(--bone-dim); font-variant-numeric: tabular-nums;
  }
  .gal__rule {
    flex: 1; height: 1px; margin-left: 8px;
    background: var(--rule); overflow: hidden;
  }
  .gal__fill {
    display: block; height: 100%;
    width: calc(var(--f) * 100%);
    background: var(--accent);
  }

  /* ── THE READING ────────────────────────────────────────────── */
  /* Solid ground, so the writing is never set over a picture. */
  .pg {
    position: relative;
    z-index: 2;
    background: var(--ground);
    padding: clamp(64px, 11vh, 150px) var(--margin) 0;
  }
  .blk { max-width: 1180px; margin: 0 auto clamp(64px, 11vh, 150px); }
  .blk__lbl {
    margin: 0 0 clamp(14px, 2.2vh, 24px);
    padding-bottom: 10px; border-bottom: 1px solid var(--rule);
    font-size: var(--t-micro); letter-spacing: 0.16em;
    text-transform: uppercase; color: var(--bone-dim);
  }
  .body {
    margin: 0; max-width: 60ch;
    font-size: clamp(1.15rem, 1.9vw, 1.6rem);
    line-height: 1.42; letter-spacing: -0.012em;
    color: var(--bone-dim); text-wrap: pretty;
  }
  .blk__awards {
    margin: clamp(24px, 4vh, 44px) 0 0;
    font-size: var(--t-xs); letter-spacing: 0.14em;
    text-transform: uppercase; color: var(--accent);
  }
  .facts { margin: 0; }
  .facts__row {
    display: grid; grid-template-columns: minmax(0, 12rem) minmax(0, 1fr);
    gap: clamp(20px, 2.5vw, 44px); align-items: baseline;
    padding: 14px 0; border-bottom: 1px solid var(--rule-soft);
  }
  .facts__k { margin: 0; font-size: var(--t-micro); letter-spacing: 0.16em; text-transform: uppercase; color: var(--muted); }
  .facts__v { margin: 0; font-size: var(--t-md); line-height: 1.3; color: var(--bone-dim); }
  .facts__links { margin: clamp(24px, 4vh, 40px) 0 0; display: flex; flex-wrap: wrap; gap: 24px; }
  .facts__link {
    font-size: var(--t-sm); letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--bone); text-decoration: none;
    border-bottom: 1px solid var(--rule-accent); padding-bottom: 3px;
    transition: color var(--d-micro) var(--ease), border-color var(--d-micro) var(--ease);
  }
  .facts__link:hover { color: var(--accent); border-color: var(--accent); }

  @media (max-width: 640px) {
    .facts__row { grid-template-columns: 1fr; gap: 4px; }
  }

  /* ── REDUCED MOTION GETS A COMPLETE PAGE ────────────────────── */
  /* The gallery stops being a timeline and becomes a plain grid of stills on
     solid ground; the mat opens fully and stops. Nothing is missing and
     nothing moves. */
  @media (prefers-reduced-motion: reduce) {
    .ap__scene { position: static; opacity: 1; }
    .ap__stack {
      position: static;
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: clamp(16px, 2vw, 32px);
      padding: 0 var(--margin);
    }
    .ap__layer { position: static; opacity: 1; }
    .ap__layer :global(img) { height: auto; filter: saturate(0.94) contrast(1.02); }
    .ap__mat { display: none; }
    .gal { height: auto; }
    .gal__hud { display: none; }
  }
</style>

<script>
  /* ONE CLOCK. A single scroll pass writes --f and --i on the article, and
     --lit on it too; every moving thing on the page is derived from those in
     CSS. Written as one pass rather than three listeners so the mat, the
     dissolve, the counter and the rule can never disagree about where the
     scroll is.

     Throttled through rAF and never inside the handler: Lenis emits scroll
     for over a second after a flick, and a layout read per event would be
     dozens of forced reflows. */
  function initAperture() {
    const root = document.querySelector<HTMLElement>('[data-ap]');
    const gal = root?.querySelector<HTMLElement>('[data-gal]');
    const no = root?.querySelector<HTMLElement>('[data-no]');
    if (!root || !gal || !no) return;
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    if (root.dataset.bound) return;
    root.dataset.bound = '1';

    const n = parseFloat(getComputedStyle(root).getPropertyValue('--n')) || 1;
    let raf = 0;

    const paint = () => {
      raf = 0;
      const r = gal.getBoundingClientRect();
      /* 0 as the gallery's top reaches the top of the window, 1 as its foot
         does — the travel is the section's own height, so the timeline is
         the markup rather than a magic number. */
      const span = Math.max(1, r.height - innerHeight);
      const f = Math.min(1, Math.max(0, -r.top / span));
      /* Lit only while the gallery is anywhere near the window, so the fixed
         scene cannot sit behind the title or the reading. */
      const lit = r.top < innerHeight && r.bottom > 0 ? 1 : 0;

      root.style.setProperty('--f', f.toFixed(4));
      root.style.setProperty('--i', (f * (n - 1)).toFixed(3));
      root.style.setProperty('--lit', String(lit));

      const idx = Math.min(n, Math.max(1, Math.round(f * (n - 1)) + 1));
      const s = String(idx).padStart(2, '0');
      if (no.textContent !== s) no.textContent = s;
    };
    const tick = () => { if (!raf) raf = requestAnimationFrame(paint); };

    addEventListener('scroll', tick, { passive: true });
    addEventListener('resize', tick, { passive: true });
    paint();
  }
  initAperture();
  document.addEventListener('astro:page-load', initAperture);
</script>
