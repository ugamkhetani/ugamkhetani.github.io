---
/**
 * Contact is a page, not an overlay — a form wants a URL you can put in a
 * deck or a signature, and somewhere to come back to. Contents and About
 * stay overlays; they are reading, not doing.
 */
import Base from '../layouts/Base.astro';
import ContactForm from '../components/ContactForm.astro';
---

<Base
  title="Contact — Ugam Khetani"
  description="Original score, sound design, voice direction and final mix for film, series, brand and song. Tell me what you're making."
>
  <div class="contact">
    <ContactForm />
  </div>
</Base>

<style>
  .contact {
    padding-inline: var(--margin);
    /* The same opening interval as the homepage and the overlays, so every
       view in the site begins on one line. */
    padding-top: clamp(160px, 21vh, 240px);
    padding-bottom: 22vh;
    /* No max-width. Every other page in the site runs full-bleed inside
       var(--margin); this one was capped at 1240px and read as narrower than
       the rest of the site. Line lengths are held by each block's own
       max-width instead, which is where that job belongs. */
  }
</style>
