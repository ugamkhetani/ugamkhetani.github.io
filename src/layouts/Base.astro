---
import '../styles/tokens.css';
import '../styles/base.css';
import '@fontsource-variable/inter/wght.css';
import '@fontsource-variable/jetbrains-mono/wght.css';
import '@fontsource-variable/fraunces/wght-italic.css';

import { ClientRouter } from 'astro:transitions';
import { displayFontFace } from '../lib/displayFont';

const fontFace = displayFontFace();

interface Props {
  title: string;
  description: string;
  /** Homepage only: run the opening frame sequence once per session. */
  intro?: boolean;
  /**
   * This page's own link-preview card, as a path under the site root. Omit
   * it and the site's card is used — see the note on og:image below.
   */
  share?: { path: string; alt: string };
}
const { title, description, intro = false, share } = Astro.props;

/* THE SITE'S OWN CARD IS THE FALLBACK, and the homepage is what it is for. */
const SHARE = share ?? {
  path: 'og/share.jpg',
  alt: 'Ugam Khetani — Composer, Producer, Sound Designer',
};


---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0A0908" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Ugam Khetani" />
    {/* ── THE LINK PREVIEW ─────────────────────────────────────────────
        WHAT INSTAGRAM AND WHATSAPP SHOW is og:image, and nothing else on
        the page. Until this existed there was none, so every scraper fell
        back to guessing — it took the first <img> in the document, which is
        tile one of the mosaic, and sent people a random still with no name
        on it.

        THE HOMEPAGE'S CARD IS NOT ONE OF THE SITE'S OWN IMAGES,
        deliberately. public/og/ is served untouched: Astro never optimises
        it, no page references it, and changing it cannot change a single
        pixel of the site. Swap the file, keep the name, and the homepage's
        link preview updates.

        A WORK PAGE SENDS ITS OWN STILL INSTEAD, from 2026-11-25 on Ugam's
        instruction. Sharing /work/kaalakund used to show a portrait of the
        composer rather than the film. Work pages now pass `share`, and the
        card is built from that work's first still at build time —
        scripts/ogCards.mjs has the whole argument, including why it is
        generated rather than committed. Any page that passes nothing still
        gets the photograph, which is what the homepage wants.

        ABSOLUTE OR IT IS IGNORED. Scrapers do not resolve relative paths,
        so this needs `site`, which CI sets from configure-pages. Locally,
        with SITE_URL unset, the tag is simply absent — the same honest
        behaviour the canonical link below already has.

        1200x630 IS THE SIZE EVERY PLATFORM CROPS FROM. Width and height
        are declared so the card reserves the right box before the image
        arrives, which is what stops the preview reflowing as it loads.

        JPEG, NOT PNG OR WEBP. A photograph as PNG is megabytes for no gain,
        and WebP is still read unevenly by scrapers — JPEG is the one format
        every one of them handles. The extension also has to match the bytes:
        Pages sets Content-Type from it, so a JPEG named .png would be served
        as image/png and some scrapers reject the mismatch. */}
    {Astro.site && (
      <>
        <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
        <meta property="og:image" content={new URL(SHARE.path, Astro.site)} />
        <meta property="og:image:type" content="image/jpeg" />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content={SHARE.alt} />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:image" content={new URL(SHARE.path, Astro.site)} />
      </>
    )}
    {/* A canonical URL has to be absolute, so it needs `site` — and `site`
        is deliberately unset until the domain is decided (see
        astro.config.mjs). Emitting it against an undefined base throws at
        build time; emitting a relative one would be worse than none. So it
        appears the moment SITE_URL is set for a build and is absent until
        then, which is the honest state of a site with no address yet. */}
    {Astro.site && <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />}
    {fontFace && <style is:inline set:html={fontFace} />}

    {
      intro && (
        <script is:inline>
          try {
            var seen = sessionStorage.getItem('uk-intro');
            var still = matchMedia('(prefers-reduced-motion: reduce)').matches;
            if (!seen && !still) {
              document.documentElement.classList.add('intro-on');
              sessionStorage.setItem('uk-intro', '1');
              setTimeout(function () {
                document.documentElement.classList.remove('intro-on');
              }, 1560);
            }
          } catch (e) {}
        </script>
      )
    }
    <ClientRouter />
  </head>

  <body>
    <a class="skip" href="#main">Skip to content</a>

    {/* Pointer trail. Sits above the page but below the opening sequence,
        and never intercepts a click. */}
    <canvas class="cursor" data-cursor aria-hidden="true"></canvas>

    <main id="main">
      <slot />
    </main>




    <script>
      import '../scripts/main.ts';
    </script>

    <style>
      .cursor {
        position: fixed;
        inset: 0;
        z-index: 250;
        pointer-events: none;
      }
      @media (prefers-reduced-motion: reduce) { .cursor { display: none; } }
      @media (hover: none), (pointer: coarse) { .cursor { display: none; } }
    </style>
  </body>
</html>
