---
import '../styles/tokens.css';
import '../styles/base.css';
import '@fontsource-variable/inter/wght.css';
import '@fontsource-variable/jetbrains-mono/wght.css';
import '@fontsource-variable/fraunces/wght-italic.css';

import { ClientRouter } from 'astro:transitions';
import { displayFontFace } from '../lib/displayFont';

const fontFace = displayFontFace();

interface Props {
  title: string;
  description: string;
  /** Homepage only: run the opening frame sequence once per session. */
  intro?: boolean;
}
const { title, description, intro = false } = Astro.props;


---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0A0908" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {/* A canonical URL has to be absolute, so it needs `site` — and `site`
        is deliberately unset until the domain is decided (see
        astro.config.mjs). Emitting it against an undefined base throws at
        build time; emitting a relative one would be worse than none. So it
        appears the moment SITE_URL is set for a build and is absent until
        then, which is the honest state of a site with no address yet. */}
    {Astro.site && <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />}
    {fontFace && <style is:inline set:html={fontFace} />}

    {
      intro && (
        <script is:inline>
          try {
            var seen = sessionStorage.getItem('uk-intro');
            var still = matchMedia('(prefers-reduced-motion: reduce)').matches;
            if (!seen && !still) {
              document.documentElement.classList.add('intro-on');
              sessionStorage.setItem('uk-intro', '1');
              setTimeout(function () {
                document.documentElement.classList.remove('intro-on');
              }, 1560);
            }
          } catch (e) {}
        </script>
      )
    }
    <ClientRouter />
  </head>

  <body>
    <a class="skip" href="#main">Skip to content</a>

    {/* Pointer trail. Sits above the page but below the opening sequence,
        and never intercepts a click. */}
    <canvas class="cursor" data-cursor aria-hidden="true"></canvas>

    <main id="main">
      <slot />
    </main>




    <script>
      import '../scripts/main.ts';
    </script>

    <style>
      .cursor {
        position: fixed;
        inset: 0;
        z-index: 250;
        pointer-events: none;
      }
      @media (prefers-reduced-motion: reduce) { .cursor { display: none; } }
      @media (hover: none), (pointer: coarse) { .cursor { display: none; } }
    </style>
  </body>
</html>
